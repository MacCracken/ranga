# ranga — Cyrius port of a Rust image-processing library.
#
# This file is the manifest: what builds, what it depends on. Rationale lives in
# docs/, not here.
#   docs/development/state.md                 live state — versions, counts, deps
#   docs/development/roadmap.md               milestones and their findings
#   docs/development/parity-rust-v-cyrius.md  surface parity against rust-old/
#   docs/development/cyrius-port-plan.md      §3 internalized shims, §4 capabilities

[package]
name = "ranga"
version = "${file:VERSION}"
description = "ranga — core image processing: colour spaces, blend modes, pixel buffers, filters, GPU compute"
license = "GPL-3.0-only"
repository = "https://github.com/MacCracken/ranga"
language = "cyrius"
cyrius = "6.5.33"

[build]
entry = "src/main.cyr"
output = "build/ranga"

# Bundle profiles. `[lib]` is the core — no external deps. Each other profile is
# the core plus the one module that needs a library, matching the optional
# cargo features the Rust line had. Build them all with `cyrius distlib --all`.
[lib]
modules = [
    "src/error.cyr",
    "src/bytevec.cyr",
    "src/simd_u8.cyr",
    "src/pixel.cyr",
    "src/color.cyr",
    "src/composite.cyr",
    "src/histogram.cyr",
    "src/transform.cyr",
    "src/filter_point.cyr",
    "src/filter_kernel.cyr",
    "src/blend.cyr",
    "src/convert.cyr",
    "src/icc.cyr",
]

[lib.spectral]
modules = [
    "src/error.cyr",
    "src/bytevec.cyr",
    "src/simd_u8.cyr",
    "src/pixel.cyr",
    "src/color.cyr",
    "src/composite.cyr",
    "src/histogram.cyr",
    "src/transform.cyr",
    "src/filter_point.cyr",
    "src/filter_kernel.cyr",
    "src/blend.cyr",
    "src/convert.cyr",
    "src/icc.cyr",
    "src/spectral.cyr",
]

[lib.hwaccel]
modules = [
    "src/error.cyr",
    "src/bytevec.cyr",
    "src/simd_u8.cyr",
    "src/pixel.cyr",
    "src/color.cyr",
    "src/composite.cyr",
    "src/histogram.cyr",
    "src/transform.cyr",
    "src/filter_point.cyr",
    "src/filter_kernel.cyr",
    "src/blend.cyr",
    "src/convert.cyr",
    "src/icc.cyr",
    "src/hwaccel.cyr",
]

[lib.gpu]
modules = [
    "src/error.cyr",
    "src/bytevec.cyr",
    "src/simd_u8.cyr",
    "src/pixel.cyr",
    "src/color.cyr",
    "src/composite.cyr",
    "src/histogram.cyr",
    "src/transform.cyr",
    "src/filter_point.cyr",
    "src/filter_kernel.cyr",
    "src/blend.cyr",
    "src/convert.cyr",
    "src/icc.cyr",
    "src/gpu_spirv.cyr",
    "src/gpu_kernels.cyr",
    "src/gpu_shaders.cyr",
    "src/gpu_pipeline.cyr",
    "src/gpu_context.cyr",
    "src/gpu_buffer.cyr",
]

# Features mirror the Rust line's cargo features. `default` is empty: ranga's
# SIMD is unconditional, where Rust gated it. Marking a dep optional keeps it
# inert downstream — transitive feature tables are not parsed.
[features]
default = []
spectral = ["prakash"]
hwaccel = ["ai-hwaccel"]
gpu = ["mabda"]

# The last 13 leaves serve the optional libraries, not any core module. They are
# declared here because that is where the resolver looks — a leaf named only in a
# library's own sidecar is vendored but not auto-included, which surfaces as
# undefined symbols at link time rather than a missing file.
[deps]
stdlib = [
    "syscalls",
    "string",
    "alloc",
    "str",
    "fmt",
    "vec",
    "io",
    "args",
    "assert",
    "math",
    "ganita",
    "slice",
    "freelist",
    "tagged",
    "bench",
    "result",
    "simd",
    "fnptr",
    "callback",
    "bayan",
    "sakshi",
    "fs",
    "process",
    "thread",
    "hashmap",
    "mmap",
    "dynlib",
    "sankoch",
    "thread_local",
]

# Pinned by tag, optional, no `path =` override — a path override resolves
# locally and bypasses the commit-pin verification cyrius.lock records.
[deps.prakash]
git = "https://github.com/MacCracken/prakash.git"
tag = "2.2.8"
modules = ["dist/prakash.cyr"]
optional = true

[deps.ai-hwaccel]
git = "https://github.com/MacCracken/ai-hwaccel.git"
tag = "2.3.18"
modules = ["dist/ai-hwaccel.cyr"]
optional = true

[deps.mabda]
git = "https://github.com/MacCracken/mabda.git"
tag = "4.1.0"
modules = ["dist/mabda.cyr"]
optional = true
