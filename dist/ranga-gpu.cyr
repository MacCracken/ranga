    str_builder_add_cstr(sb, "}\n");
    str_builder_add_cstr(sb, "\n");
    return str_builder_build(sb);
}

#must_use
fn _gs_blur_horizontal(): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "@group(0) @binding(0) var<storage, read> input: array<u32>;\n");
    str_builder_add_cstr(sb, "@group(0) @binding(1) var<storage, read_write> output: array<u32>;\n");
    str_builder_add_cstr(sb, "@group(0) @binding(2) var<storage, read> kernel: array<f32>;\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "struct Params {\n");
    str_builder_add_cstr(sb, "    width: u32,\n");
    str_builder_add_cstr(sb, "    height: u32,\n");
    str_builder_add_cstr(sb, "    radius: u32,\n");
    str_builder_add_cstr(sb, "    _pad: u32,\n");
    str_builder_add_cstr(sb, "}\n");
    str_builder_add_cstr(sb, "@group(0) @binding(3) var<uniform> params: Params;\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "@compute @workgroup_size(16, 16)\n");
    str_builder_add_cstr(sb, "fn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n");
    str_builder_add_cstr(sb, "    let x = gid.x;\n");
    str_builder_add_cstr(sb, "    let y = gid.y;\n");
    str_builder_add_cstr(sb, "    if x >= params.width || y >= params.height { return; }\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "    let r = i32(params.radius);\n");
    str_builder_add_cstr(sb, "    var acc = vec4<f32>(0.0, 0.0, 0.0, 0.0);\n");
    str_builder_add_cstr(sb, "    for (var i = -r; i <= r; i = i + 1) {\n");
    str_builder_add_cstr(sb, "        let sx = clamp(i32(x) + i, 0, i32(params.width) - 1);\n");
    str_builder_add_cstr(sb, "        let idx = u32(sx) + y * params.width;\n");
    str_builder_add_cstr(sb, "        let w = kernel[u32(i + r)];\n");
    str_builder_add_cstr(sb, "        acc = acc + unpack_rgba(input[idx]) * w;\n");
    str_builder_add_cstr(sb, "    }\n");
    str_builder_add_cstr(sb, "    output[x + y * params.width] = pack_rgba(acc);\n");
    str_builder_add_cstr(sb, "}\n");
    str_builder_add_cstr(sb, "\n");
    return str_builder_build(sb);
}

