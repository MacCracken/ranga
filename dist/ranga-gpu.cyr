    str_builder_add_cstr(sb, "    _pad3: u32,\n");
    str_builder_add_cstr(sb, "}\n");
    str_builder_add_cstr(sb, "@group(0) @binding(2) var<uniform> params: Params;\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "@compute @workgroup_size(16, 16)\n");
    str_builder_add_cstr(sb, "fn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n");
    str_builder_add_cstr(sb, "    let gx = gid.x;\n");
    str_builder_add_cstr(sb, "    let gy = gid.y;\n");
    str_builder_add_cstr(sb, "    if gx >= params.dst_width || gy >= params.dst_height { return; }\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "    let src_idx = (params.src_y + gy) * params.src_width + (params.src_x + gx);\n");
    str_builder_add_cstr(sb, "    let dst_idx = gy * params.dst_width + gx;\n");
    str_builder_add_cstr(sb, "    output[dst_idx] = input[src_idx];\n");
    str_builder_add_cstr(sb, "}\n");
    str_builder_add_cstr(sb, "\n");
    return str_builder_build(sb);
}

#must_use
fn _gs_resize_bilinear(): Str {
    var sb = str_builder_new();
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "@group(0) @binding(0) var<storage, read> input: array<u32>;\n");
    str_builder_add_cstr(sb, "@group(0) @binding(1) var<storage, read_write> output: array<u32>;\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "struct Params {\n");
    str_builder_add_cstr(sb, "    src_width: u32,\n");
    str_builder_add_cstr(sb, "    src_height: u32,\n");
    str_builder_add_cstr(sb, "    dst_width: u32,\n");
    str_builder_add_cstr(sb, "    dst_height: u32,\n");
    str_builder_add_cstr(sb, "}\n");
    str_builder_add_cstr(sb, "@group(0) @binding(2) var<uniform> params: Params;\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "@compute @workgroup_size(16, 16)\n");
    str_builder_add_cstr(sb, "fn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n");
    str_builder_add_cstr(sb, "    let gx = gid.x;\n");
    str_builder_add_cstr(sb, "    let gy = gid.y;\n");
    str_builder_add_cstr(sb, "    if gx >= params.dst_width || gy >= params.dst_height { return; }\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "    let sw = f32(params.src_width);\n");
    str_builder_add_cstr(sb, "    let sh = f32(params.src_height);\n");
    str_builder_add_cstr(sb, "    let dw = f32(params.dst_width);\n");
    str_builder_add_cstr(sb, "    let dh = f32(params.dst_height);\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "    var sx: f32;\n");
    str_builder_add_cstr(sb, "    var sy: f32;\n");
    str_builder_add_cstr(sb, "    if params.dst_width > 1u {\n");
    str_builder_add_cstr(sb, "        sx = f32(gx) * (sw - 1.0) / (dw - 1.0);\n");
    str_builder_add_cstr(sb, "    } else {\n");
    str_builder_add_cstr(sb, "        sx = 0.0;\n");
    str_builder_add_cstr(sb, "    }\n");
    str_builder_add_cstr(sb, "    if params.dst_height > 1u {\n");
    str_builder_add_cstr(sb, "        sy = f32(gy) * (sh - 1.0) / (dh - 1.0);\n");
    str_builder_add_cstr(sb, "    } else {\n");
    str_builder_add_cstr(sb, "        sy = 0.0;\n");
    str_builder_add_cstr(sb, "    }\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "    let x0 = u32(floor(sx));\n");
    str_builder_add_cstr(sb, "    let y0 = u32(floor(sy));\n");
    str_builder_add_cstr(sb, "    let x1 = min(x0 + 1u, params.src_width - 1u);\n");
    str_builder_add_cstr(sb, "    let y1 = min(y0 + 1u, params.src_height - 1u);\n");
    str_builder_add_cstr(sb, "    let fx = sx - floor(sx);\n");
    str_builder_add_cstr(sb, "    let fy = sy - floor(sy);\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "    let c00 = unpack_rgba(input[y0 * params.src_width + x0]);\n");
    str_builder_add_cstr(sb, "    let c10 = unpack_rgba(input[y0 * params.src_width + x1]);\n");
    str_builder_add_cstr(sb, "    let c01 = unpack_rgba(input[y1 * params.src_width + x0]);\n");
    str_builder_add_cstr(sb, "    let c11 = unpack_rgba(input[y1 * params.src_width + x1]);\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "    let top = mix(c00, c10, fx);\n");
    str_builder_add_cstr(sb, "    let bot = mix(c01, c11, fx);\n");
    str_builder_add_cstr(sb, "    let result = mix(top, bot, fy);\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "    output[gy * params.dst_width + gx] = pack_rgba(result);\n");
    str_builder_add_cstr(sb, "}\n");
    str_builder_add_cstr(sb, "\n");
    return str_builder_build(sb);
}

