    str_builder_add_cstr(sb, "@group(0) @binding(0) var<storage, read> input: array<u32>;\n");
    str_builder_add_cstr(sb, "@group(0) @binding(1) var<storage, read_write> output: array<u32>;\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "struct Params {\n");
    str_builder_add_cstr(sb, "    src_width: u32,\n");
    str_builder_add_cstr(sb, "    src_height: u32,\n");
    str_builder_add_cstr(sb, "    dst_width: u32,\n");
    str_builder_add_cstr(sb, "    dst_height: u32,\n");
    str_builder_add_cstr(sb, "}\n");
    str_builder_add_cstr(sb, "@group(0) @binding(2) var<uniform> params: Params;\n");
    str_builder_add_cstr(sb, "\n");
    str_builder_add_cstr(sb, "@compute @workgroup_size(16, 16)\n");
    str_builder_add_cstr(sb, "fn main(@builtin(global_invocation_id) gid: vec3<u32>) {\n");
    str_builder_add_cstr(sb, "    let gx = gid.x;\n");
    str_builder_add_cstr(sb, "    let gy = gid.y;\n");
