# Rust's `build_shader`: every body needs unpack_rgba and pack_rgba in scope, so
# the helpers are prepended rather than repeated in each source.
#must_use
fn gpu_shader_build(body: Str): Str {
    return str_cat(_gs_pack_helpers(), body);
}

# --- gpu_pipeline.cyr ---

# gpu_pipeline.cyr -- the fourteen public GPU operations
# Ported from rust-old/src/gpu/pipeline.rs. Private prefix: _gp_
#
# This is the layer a consumer actually calls. Everything beneath it — the
# context, the buffers, the SPIR-V emitter, the kernels and the WGSL — existed
# before this file, and none of it was reachable without hand-assembling a
# dispatch. `gpu_invert(ctx, buf)` is the promise the GPU feature makes.
#
# THE SHAPE, once per operation: validate the format, upload, get the cached
# shader module, write params, build the binding array, dispatch, read back into
# the caller's buffer. `_gp_run_1buf` and `_gp_run_2buf` carry all of it; each
# operation is its parameter block.
#
# ⚠ THREE OF THE FOURTEEN CANNOT RUN ON THE NATIVE BACKEND, and they return
# RG_GPU_ERR_UNSUPPORTED rather than pretending. `gpu_blend` and
# `gpu_noise_gaussian` have no SPIR-V kernel (blend is 13 modes and exceeds the
# register budget; noise needs log/cos/sin, which mabda's lowerer does not
# carry), `gpu_gaussian_blur` needs OpLoopMerge which is rejected outright, and
# `gpu_resize` with a bilinear filter hits the same register ceiling as blend.
# All four have complete WGSL in gpu_shaders.cyr and work on the wgpu path.
# Filed at mabda/docs/development/issues/2026-08-19-native-spirv-compile-limits.md.

# Every per-pixel kernel declares @workgroup_size(256).
var _GP_WG = 256;
# Storage | copy-dst | copy-src, matching Rust's create_storage_buffer usage.
var _GP_USAGE = 0x0080 | 0x0008 | 0x0004;
# The params buffer is eight words for every operation; crop needs six.
var _GP_PARAM_BYTES = 32;

# Kernel selectors for the shader-module cache.
var GP_K_INVERT     = 1;
var GP_K_GRAYSCALE  = 2;
var GP_K_FADE       = 3;
var GP_K_BRIGHTCON  = 4;
var GP_K_SATURATION = 5;
var GP_K_DISSOLVE   = 6;
var GP_K_WIPE       = 7;
var GP_K_CROP       = 8;
var GP_K_FLIP_H     = 9;
var GP_K_FLIP_V     = 10;
var GP_K_RESIZE_N   = 11;

# ── Shader module cache ────────
#
# Distinct from the pipeline cache in gpu_context.cyr: that one holds mabda
# ComputePipeline handles for the wgpu path and frees them with
# compute_pipeline_release. These are NATIVE shader modules from
# gpu_shader_module_create_spirv, freed with gpu_shader_module_release.
#
# ⚠ PER-CONTEXT, NOT PROCESS-GLOBAL, and the distinction is load-bearing.
# `_native_shader_compile_spirv` stages the compiled GFX9 ISA in a GTT buffer
# object created on THAT context's DRM fd, at a VA carved from that context's
# texture region. `_native_dispatch_compiled` reads the handle and VA straight
# out of the module and submits them with whatever context it is handed,
# checking only that they are non-null. So a process-global cache lets a second
# context dispatch the first one's modules against a different fd — and after
# the first context is freed, against a closed one. Rust kept its caches on
# GpuContext for the same reason; this is a flat (selector, module) vec living
# in the context and released with it.

# Build the SPIR-V for one selector. Returns 0 for an unknown selector.
#must_use
fn _gp_build_kernel(s, kind) {
    if (kind == GP_K_INVERT)     { gk_invert(s); return 1; }
    if (kind == GP_K_GRAYSCALE)  { gk_grayscale(s); return 1; }
    if (kind == GP_K_FADE)       { gk_fade(s); return 1; }
    if (kind == GP_K_BRIGHTCON)  { gk_brightness_contrast(s); return 1; }
    if (kind == GP_K_SATURATION) { gk_saturation(s); return 1; }
    if (kind == GP_K_DISSOLVE)   { gk_dissolve(s); return 1; }
    if (kind == GP_K_WIPE)       { gk_wipe(s); return 1; }
    if (kind == GP_K_CROP)       { gk_crop(s); return 1; }
    if (kind == GP_K_FLIP_H)     { gk_flip_horizontal(s); return 1; }
    if (kind == GP_K_FLIP_V)     { gk_flip_vertical(s); return 1; }
    if (kind == GP_K_RESIZE_N)   { gk_resize_nearest(s); return 1; }
    return 0;
}

# Compiled shader module for `kind`, built on first use.
#
# Rust cached compiled PIPELINES here; the native path has no pipeline object,
# so the cache holds the compiled GFX9 module instead. Same purpose: a kernel is
# emitted and lowered once per process, not once per frame.
#must_use
fn _gp_kernel(ctx, kind, err_out) {
    if (ctx == 0) { store64(err_out, RG_GPU_ERR_NO_ADAPTER); return 0; }
    var cache = gpu_context_shader_cache(ctx);
    if (cache == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    var i = 0;
    while (i < vec_len(cache)) {
        if (vec_get(cache, i) == kind) {
            store64(err_out, RG_GPU_ERR_NONE);
            return vec_get(cache, i + 1);
        }
        i = i + 2;
    }
    var s = spv_new();
    if (s == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    if (_gp_build_kernel(s, kind) == 0) {
        spv_free(s);
        store64(err_out, RG_GPU_ERR_UNSUPPORTED);
        return 0;
    }
    var outp = fl_alloc(8);
    if (outp == 0) { spv_free(s); store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    var n = spv_finish(s, outp);
    var spv = load64(outp);
    fl_free(outp);
    spv_free(s);
    if (n == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    var shmod = gpu_shader_module_create_spirv(gpu_context_mabda(ctx), spv, n);
    fl_free(spv);
    if (shmod == 0) {
        # The module was valid SPIR-V — spv_finish would have returned 0
        # otherwise — so this is mabda declining to lower it, not an emitter
        # fault. See the register-pressure note in the module header.
        store64(err_out, RG_GPU_ERR_UNSUPPORTED);
        return 0;
    }
    vec_push(cache, kind);
    vec_push(cache, shmod);
    store64(err_out, RG_GPU_ERR_NONE);
    return shmod;
}

# ── Shared dispatch ────────

#must_use
fn _gp_require_rgba8(buf, err_out) {
    if (buf == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    if (pixel_buffer_format(buf) != PF_RGBA8) {
        store64(err_out, RG_GPU_ERR_FORMAT);
        return 0;
    }
    return 1;
}

# ⚠ BOTH DIMENSIONS, not the pixel count. Rust guards dissolve and wipe with
# `src.width != dst.width || src.height != dst.height`; comparing width*height
# instead accepts an 8x2 source against a 4x4 destination, and wipe then reflows
# the source into a different raster and returns a silently wrong composite
# rather than DimensionMismatch.
#must_use
fn _gp_same_shape(a, b) {
    if (pixel_buffer_width(a) != pixel_buffer_width(b)) { return 0; }
    if (pixel_buffer_height(a) != pixel_buffer_height(b)) { return 0; }
    return 1;
}

# Rust's `pixel_count.div_ceil(256)`.
#must_use
fn _gp_groups(count) {
    if (count <= 0) { return 1; }
    return (count + _GP_WG - 1) / _GP_WG;
}

# An in-place operation over one pixel buffer.
#
# `params` points at _GP_PARAM_BYTES the caller has filled; word 0 must be the
# element count the kernel guards against. The params buffer is bound TWICE —
# once as the u32 view and once as the f32 view — because mabda's supported
# opcode set has no OpBitcast, so a word read as both a count and a float needs
# two differently-typed arrays over the same memory.
fn _gp_run_1buf(ctx, buf, kind, params, groups, err_out) {
    # ctx first: every sibling in the GPU feature treats a null context as a
    # coded RG_GPU_ERR_NO_ADAPTER, and this layer used to dereference it.
    if (ctx == 0) { store64(err_out, RG_GPU_ERR_NO_ADAPTER); return RG_ERR_OTHER; }
    if (_gp_require_rgba8(buf, err_out) == 0) { return gpu_error_to_ranga(load64(err_out)); }
    # ⚠ The two code spaces OVERLAP numerically — RG_GPU_ERR_FORMAT is -4 and so
    # is RG_ERR_UNSUPPORTED_CONVERSION; RG_GPU_ERR_BUFFER_OP is -3 and so is
    # RG_ERR_BUFFER_TOO_SMALL. Returning err_out's value directly from a slot
    # documented as RG_ERR_* would hand callers a code from the wrong space that
    # still looks valid. gpu_error_to_ranga is the only correct bridge.
    var shmod = _gp_kernel(ctx, kind, err_out);
    if (shmod == 0) { return gpu_error_to_ranga(load64(err_out)); }

    var m = gpu_context_mabda(ctx);
    var gb = gpu_buffer_upload(ctx, buf, err_out);
    if (gb == 0) { return gpu_error_to_ranga(load64(err_out)); }

    var pb = gpu_buffer_create(m, _GP_PARAM_BYTES, _GP_USAGE);
    if (pb == 0) {
        gpu_buffer_free(ctx, gb);
        store64(err_out, RG_GPU_ERR_BUFFER_OP);
        return RG_ERR_OTHER;
    }
    gpu_buffer_write(m, pb, 0, params, _GP_PARAM_BYTES);

    var bp[56];
    store64(&bp, 3);
    _gp_bind(&bp + 8, gb);
    native_buf_pair_write(&bp + 24, load64(pb + NATIVE_BUF_FIELD_HANDLE), load64(pb + NATIVE_BUF_FIELD_VA));
    native_buf_pair_write(&bp + 40, load64(pb + NATIVE_BUF_FIELD_HANDLE), load64(pb + NATIVE_BUF_FIELD_VA));
    var rc = gpu_compute_dispatch(m, shmod, groups, 1, 1, &bp);
    gpu_buffer_release(m, pb);
    if (rc != 0) {
        gpu_buffer_free(ctx, gb);
        store64(err_out, RG_GPU_ERR_BUFFER_OP);
        return RG_ERR_OTHER;
    }

    # Read straight back over the caller's bytes. Rust replaced buf.data with
    # the downloaded Vec; here the buffer is already the right size and owned by
    # the caller, so an in-place read avoids an allocation and a copy.
    var back = gpu_buffer_read(m, gpu_buffer_handle(gb), 0,
                               pixel_buffer_data(buf), pixel_buffer_len(buf));
    gpu_buffer_free(ctx, gb);
    if (back != 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return RG_ERR_OTHER; }
    store64(err_out, RG_GPU_ERR_NONE);
    return RG_ERR_NONE;
}

# Write one (handle, VA) binding pair from a ranga GpuBuffer.
#
# ⚠ TWO INDIRECTIONS, AND SKIPPING ONE COSTS NOTHING VISIBLE. `gpu_buffer_handle`
# returns the mabda buffer OBJECT pointer; the native handle and VA are FIELDS
# inside it, at +0 and +8. Passing the object pointer straight through as the
# handle — which is what the first version of this file did — dispatches
# cleanly and writes nothing, because mabda reads a bogus residency entry rather
# than failing. Every operation returned BUFFER_OP with no other symptom.
fn _gp_bind(dst, gb) {
    var obj = gpu_buffer_handle(gb);
    return native_buf_pair_write(dst, load64(obj + NATIVE_BUF_FIELD_HANDLE),
                                      load64(obj + NATIVE_BUF_FIELD_VA));
}

# A two-buffer operation: `src` is read, `dst` is read AND written.
fn _gp_run_2buf(ctx, src, dst, kind, params, groups, err_out) {
    if (ctx == 0) { store64(err_out, RG_GPU_ERR_NO_ADAPTER); return RG_ERR_OTHER; }
    if (_gp_require_rgba8(src, err_out) == 0) { return gpu_error_to_ranga(load64(err_out)); }
    if (_gp_require_rgba8(dst, err_out) == 0) { return gpu_error_to_ranga(load64(err_out)); }
    var shmod = _gp_kernel(ctx, kind, err_out);
    if (shmod == 0) { return gpu_error_to_ranga(load64(err_out)); }

    var m = gpu_context_mabda(ctx);
    var sg = gpu_buffer_upload(ctx, src, err_out);
    if (sg == 0) { return gpu_error_to_ranga(load64(err_out)); }
    var dg = gpu_buffer_upload(ctx, dst, err_out);
    if (dg == 0) { gpu_buffer_free(ctx, sg); return gpu_error_to_ranga(load64(err_out)); }

    var pb = gpu_buffer_create(m, _GP_PARAM_BYTES, _GP_USAGE);
    if (pb == 0) {
        gpu_buffer_free(ctx, dg);
        gpu_buffer_free(ctx, sg);
        store64(err_out, RG_GPU_ERR_BUFFER_OP);
        return RG_ERR_OTHER;
    }
    gpu_buffer_write(m, pb, 0, params, _GP_PARAM_BYTES);

    var bp[72];
    store64(&bp, 4);
    _gp_bind(&bp + 8, sg);
    _gp_bind(&bp + 24, dg);
    native_buf_pair_write(&bp + 40, load64(pb + NATIVE_BUF_FIELD_HANDLE), load64(pb + NATIVE_BUF_FIELD_VA));
    native_buf_pair_write(&bp + 56, load64(pb + NATIVE_BUF_FIELD_HANDLE), load64(pb + NATIVE_BUF_FIELD_VA));
    var rc = gpu_compute_dispatch(m, shmod, groups, 1, 1, &bp);
    gpu_buffer_release(m, pb);
    if (rc != 0) {
        gpu_buffer_free(ctx, dg);
        gpu_buffer_free(ctx, sg);
        store64(err_out, RG_GPU_ERR_BUFFER_OP);
        return RG_ERR_OTHER;
    }
    var back = gpu_buffer_read(m, gpu_buffer_handle(dg), 0,
                               pixel_buffer_data(dst), pixel_buffer_len(dst));
    gpu_buffer_free(ctx, dg);
    gpu_buffer_free(ctx, sg);
    if (back != 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return RG_ERR_OTHER; }
    store64(err_out, RG_GPU_ERR_NONE);
    return RG_ERR_NONE;
}

# Zero a params block and set the count in word 0.
fn _gp_params(p, count) {
    var i = 0;
    while (i < _GP_PARAM_BYTES) { store8(p + i, 0); i = i + 1; }
    store32(p, count);
    return RG_ERR_NONE;
}

# ── The fourteen operations ────────
#
# Each returns RG_ERR_NONE on success or a negative code, and reports the GPU
# code through err_out. In-place ops mutate `buf`; producing ops return a new
# PixelBuffer the caller owns.

# Invert RGB in place, alpha preserved. Rust's `gpu_invert`.
fn gpu_invert(ctx, buf, err_out) {
    var p = fl_alloc(_GP_PARAM_BYTES);
    if (p == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return RG_ERR_ALLOCATION; }
    var n = pixel_buffer_pixel_count(buf);
    _gp_params(p, n);
    var rc = _gp_run_1buf(ctx, buf, GP_K_INVERT, p, _gp_groups(n), err_out);
    fl_free(p);
    return rc;
}

# BT.709 luminance into all three channels, alpha preserved.
#
# ⚠ This does NOT agree with the CPU `grayscale`, and did not in Rust either:
# the CPU path uses BT.601 integer weights (77/150/29 >> 8), this uses BT.709
# floats. On (200, 100, 50) that is 0x7C against 0x76.
fn gpu_grayscale(ctx, buf, err_out) {
    var p = fl_alloc(_GP_PARAM_BYTES);
    if (p == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return RG_ERR_ALLOCATION; }
    var n = pixel_buffer_pixel_count(buf);
    _gp_params(p, n);
    var rc = _gp_run_1buf(ctx, buf, GP_K_GRAYSCALE, p, _gp_groups(n), err_out);
    fl_free(p);
    return rc;
}

# Multiply RGB by `factor`, alpha preserved. `factor` is an f64 bit pattern,
# narrowed to f32 for the shader.
fn gpu_fade(ctx, buf, factor, err_out) {
    var p = fl_alloc(_GP_PARAM_BYTES);
    if (p == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return RG_ERR_ALLOCATION; }
    var n = pixel_buffer_pixel_count(buf);
    _gp_params(p, n);
    store32(p + 4, f64_to_f32(factor) & 0xFFFFFFFF);
    var rc = _gp_run_1buf(ctx, buf, GP_K_FADE, p, _gp_groups(n), err_out);
    fl_free(p);
    return rc;
}

# clamp((c + brightness - 0.5) * contrast + 0.5, 0, 1) per channel.
fn gpu_brightness_contrast(ctx, buf, brightness, contrast, err_out) {
    var p = fl_alloc(_GP_PARAM_BYTES);
    if (p == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return RG_ERR_ALLOCATION; }
    var n = pixel_buffer_pixel_count(buf);
    _gp_params(p, n);
    store32(p + 4, f64_to_f32(brightness) & 0xFFFFFFFF);
    store32(p + 8, f64_to_f32(contrast) & 0xFFFFFFFF);
    var rc = _gp_run_1buf(ctx, buf, GP_K_BRIGHTCON, p, _gp_groups(n), err_out);
    fl_free(p);
    return rc;
}

# lum + factor * (c - lum), clamped, on BT.709 luminance.
fn gpu_saturation(ctx, buf, factor, err_out) {
    var p = fl_alloc(_GP_PARAM_BYTES);
    if (p == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return RG_ERR_ALLOCATION; }
    var n = pixel_buffer_pixel_count(buf);
    _gp_params(p, n);
    store32(p + 4, f64_to_f32(factor) & 0xFFFFFFFF);
    var rc = _gp_run_1buf(ctx, buf, GP_K_SATURATION, p, _gp_groups(n), err_out);
    fl_free(p);
    return rc;
}

# dst = mix(src, dst, factor) on ALL FOUR channels, alpha included.
fn gpu_dissolve(ctx, src, dst, factor, err_out) {
    if (_gp_same_shape(src, dst) == 0) {
        store64(err_out, RG_GPU_ERR_FORMAT);
        return RG_ERR_DIMENSION_MISMATCH;
    }
    var p = fl_alloc(_GP_PARAM_BYTES);
    if (p == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return RG_ERR_ALLOCATION; }
    var n = pixel_buffer_pixel_count(dst);
    _gp_params(p, n);
    store32(p + 4, f64_to_f32(factor) & 0xFFFFFFFF);
    var rc = _gp_run_2buf(ctx, src, dst, GP_K_DISSOLVE, p, _gp_groups(n), err_out);
    fl_free(p);
    return rc;
}

# Horizontal wipe: left of the line keeps dst, right takes src.
fn gpu_wipe(ctx, src, dst, progress, err_out) {
    if (_gp_same_shape(src, dst) == 0) {
        store64(err_out, RG_GPU_ERR_FORMAT);
        return RG_ERR_DIMENSION_MISMATCH;
    }
    var p = fl_alloc(_GP_PARAM_BYTES);
    if (p == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return RG_ERR_ALLOCATION; }
    var n = pixel_buffer_pixel_count(dst);
    _gp_params(p, n);
    store32(p + 4, pixel_buffer_width(dst));
    store32(p + 8, pixel_buffer_height(dst));
    store32(p + 12, f64_to_f32(progress) & 0xFFFFFFFF);
    var rc = _gp_run_2buf(ctx, src, dst, GP_K_WIPE, p, _gp_groups(n), err_out);
    fl_free(p);
    return rc;
}

# Mirror left-to-right into a NEW buffer. Rust's `gpu_flip_horizontal` returned
# a fresh PixelBuffer rather than mutating, because the destination index is not
# the source index and an in-place flip would race.
#must_use
fn gpu_flip_horizontal(ctx, buf, err_out) {
    return _gp_geom(ctx, buf, GP_K_FLIP_H, pixel_buffer_width(buf),
                    pixel_buffer_height(buf), 0, 0, err_out);
}

#must_use
fn gpu_flip_vertical(ctx, buf, err_out) {
    return _gp_geom(ctx, buf, GP_K_FLIP_V, pixel_buffer_width(buf),
                    pixel_buffer_height(buf), 0, 0, err_out);
}

# Copy the rectangle (left, top) .. (right, bottom) into a new buffer.
#
# ⚠ RECTANGLE, NOT OFFSET-AND-SIZE, AND IT CLAMPS. Rust's gpu_crop takes
# `left, top, right, bottom` and clamps each — `l = left.min(width)`,
# `r = right.min(width).max(l)` — returning a 0x0 buffer for a degenerate
# rectangle rather than an error. ranga's own CPU `crop` in transform.cyr takes
# the same four and clamps the same way. An earlier version of this function
# took (sx, sy, dw, dh) and hard-rejected out-of-range input, which diverged
# from BOTH: a consumer moving a call between crop() and gpu_crop() would have
# silently changed what the arguments meant.
#must_use
fn gpu_crop(ctx, buf, left, top, right, bottom, err_out) {
    if (_gp_require_rgba8(buf, err_out) == 0) { return 0; }
    var bw = pixel_buffer_width(buf);
    var bh = pixel_buffer_height(buf);
    var l = left;
    if (l < 0) { l = 0; }
    if (l > bw) { l = bw; }
    var t = top;
    if (t < 0) { t = 0; }
    if (t > bh) { t = bh; }
    var r = right;
    if (r > bw) { r = bw; }
    if (r < l) { r = l; }
    var b = bottom;
    if (b > bh) { b = bh; }
    if (b < t) { b = t; }
    var dw = r - l;
    var dh = b - t;
    # A degenerate rectangle yields an empty buffer, as in Rust. The GPU is not
    # dispatched for it — there is nothing to copy, and a zero-group dispatch is
    # rejected by mabda anyway.
    if (dw == 0 || dh == 0) {
        var ze = fl_alloc(8);
        if (ze == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
        var empty = pixel_buffer_zeroed(dw, dh, PF_RGBA8, ze);
        fl_free(ze);
        store64(err_out, RG_GPU_ERR_NONE);
        return empty;
    }
    return _gp_geom(ctx, buf, GP_K_CROP, dw, dh, l, t, err_out);
}

# Nearest-neighbour resize into a new buffer.
#
# ⚠ `SF_BILINEAR` and `SF_BICUBIC` return RG_GPU_ERR_UNSUPPORTED on the native
# backend. The bilinear SPIR-V exists and is valid but exceeds mabda's register
# budget; bicubic has no GPU shader in the Rust line either. Both have WGSL and
# work on the wgpu path, and both have full CPU implementations in transform.cyr.
#must_use
fn gpu_resize(ctx, buf, new_w, new_h, filter, err_out) {
    if (new_w <= 0 || new_h <= 0) { store64(err_out, RG_GPU_ERR_FORMAT); return 0; }
    if (filter != SF_NEAREST) { store64(err_out, RG_GPU_ERR_UNSUPPORTED); return 0; }
    return _gp_geom(ctx, buf, GP_K_RESIZE_N, new_w, new_h, 0, 0, err_out);
}

# Shared body for the operations that WRITE A DIFFERENT SHAPE than they read:
# crop, both flips, and nearest resize. The output buffer is allocated here and
# returned to the caller.
#
# The params block is the union of what those kernels want:
#   [count, a, b, c, d, e]
# crop reads a=src_w b=dst_w c=dst_h d=src_x e=src_y
# flips read a=width b=height
# resize_nearest reads a=src_w b=src_h c=dst_w d=dst_h
#must_use
fn _gp_geom(ctx, buf, kind, out_w, out_h, sx, sy, err_out) {
    if (_gp_require_rgba8(buf, err_out) == 0) { return 0; }
    var perr = fl_alloc(8);
    if (perr == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    var out = pixel_buffer_zeroed(out_w, out_h, PF_RGBA8, perr);
    var prc = load64(perr);
    fl_free(perr);
    if (out == 0 || prc != RG_ERR_NONE) {
        store64(err_out, RG_GPU_ERR_BUFFER_OP);
        return 0;
    }

    var p = fl_alloc(_GP_PARAM_BYTES);
    if (p == 0) { pixel_buffer_free(out); store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    var n = out_w * out_h;
    _gp_params(p, n);
    if (kind == GP_K_CROP) {
        store32(p + 4, pixel_buffer_width(buf));
        store32(p + 8, out_w);
        store32(p + 12, out_h);
        store32(p + 16, sx);
        store32(p + 20, sy);
    }
    if (kind == GP_K_FLIP_H || kind == GP_K_FLIP_V) {
        store32(p + 4, pixel_buffer_width(buf));
        store32(p + 8, pixel_buffer_height(buf));
    }
    if (kind == GP_K_RESIZE_N) {
        store32(p + 4, pixel_buffer_width(buf));
        store32(p + 8, pixel_buffer_height(buf));
        store32(p + 12, out_w);
        store32(p + 16, out_h);
    }
    var rc = _gp_run_2buf(ctx, buf, out, kind, p, _gp_groups(n), err_out);
    fl_free(p);
    if (rc != RG_ERR_NONE) { pixel_buffer_free(out); return 0; }
    return out;
}

# ── Not available on the native backend ────────
#
# These four have complete WGSL in gpu_shaders.cyr and run on the wgpu path.
# They return RG_GPU_ERR_UNSUPPORTED here rather than silently doing nothing —
# which is what a missing kernel would otherwise produce, since mabda's dispatch
# accepts a null shader module about as quietly as it accepts a bad one.

# 13 blend modes. No SPIR-V kernel: the mode switch alone exceeds the register
# budget that already stops the four-tap bilinear resize.
fn gpu_blend(ctx, src, dst, mode, opacity, err_out) {
    store64(err_out, RG_GPU_ERR_UNSUPPORTED);
    return RG_ERR_OTHER;
}

# Box-Muller over a PCG stream. Needs log, cos and sin; mabda's lowerer carries
# Sqrt, Floor, FAbs, FMin, FMax, FMA, FClamp and Ldexp, and none of the three.
fn gpu_noise_gaussian(ctx, buf, amount, seed, err_out) {
    store64(err_out, RG_GPU_ERR_UNSUPPORTED);
    return RG_ERR_OTHER;
}

# Separable convolution over a dynamic radius. `OpLoopMerge` and `OpPhi` are
# rejected outright by the lowerer, so the loop cannot be expressed at all —
# this is the one blocked on control flow rather than on size.
#
# ⚠ RETURNS 0, NOT AN ERROR CODE. Rust's gpu_gaussian_blur is
# `-> Result<PixelBuffer, RangaError>`; it PRODUCES a buffer, where gpu_blend
# and gpu_noise_gaussian return `Result<(), _>` and mutate in place. So its
# return slot carries the buffer, and failure must be 0 — exactly as gpu_resize
# signals an unsupported filter. Returning RG_ERR_OTHER (-8) here would hand
# back a non-zero value that a caller written to the documented convention
# treats as a buffer, and `pixel_buffer_data(-8)` dereferences it.
#must_use
fn gpu_gaussian_blur(ctx, buf, radius, err_out) {
    store64(err_out, RG_GPU_ERR_UNSUPPORTED);
    return 0;
}

# --- gpu_context.cyr ---

# gpu_context.cyr -- GPU device/queue management over mabda 4.0.9
# Ported from rust-old/src/gpu/context.rs. Private prefix: _gc_
#
# OPTIONAL. Not in the core `[lib]` bundle — this was the `gpu` cargo feature
# in the Rust line, and it stays optional here via the `[lib.gpu]` profile.
#
# BACKENDS. mabda has three behind ONE public API, selected at COMPILE time via
# `-D MABDA_BACKEND_KIND` (default wgpu). ranga does not choose — it calls the
# entry point matching whatever mabda was built with, and mabda's roadmap
# guarantees "the public API does not change across backends; consumer code
# stays byte-identical".
#
#   native AMD     `gpu_context_new_native()`         amdgpu DRM / GFX9
#   native NVIDIA  `gpu_context_new_native_nvidia()`  nouveau DRM / SM75
#   wgpu           `gpu_context_from_preinit(p)`      needs a C launcher
#
# ⚠ THE WGPU PATH IS STRUCTURALLY DIFFERENT, not just a different backend. It
# requires the consumer to compile in `object;` mode and be entered from a C
# launcher that builds a wgpu function table and calls `mabda_main(table,
# preinit)`. A library cannot do that to its callers, so `gpu_context_new`
# takes the preinit pointer the launcher already produced rather than trying to
# initialise wgpu itself. The native paths need no launcher, which is why
# ranga's tests use them. mabda deprecated AMD-on-wgpu at v4.0.1 and recommends
# the native AMD backend for amdgpu hardware.
#
# ⚠ mabda's `compute_pipeline_new` does NOT fit ranga's layouts. It builds a
# fixed bind group layout — read-write storage at binding 0, read-only storage
# at 1..N, and NO UNIFORM BUFFER. All three of ranga's layouts end in a uniform,
# and two of them want read-only FIRST. Rust used `ComputePipeline::with_layout`
# with explicit entries; the Cyrius mabda has no such entry point, so this
# module assembles the pipeline from mabda's public `bglb_*` builder and the
# wgpu primitives instead. See `_gc_pipeline_with_layout`.
#
#   GpuContext 56 bytes
#     +0  mabda ctx   +8  device      +16 queue
#     +24 cache (pipeline cache)      +32 adapter name (cstr)
#     +40 backend name (cstr)         +48 owns_ctx (1 if we must release it)

# The dep bundle. Stripped by `cyrius distlib`, as in spectral.cyr — a consumer
# of dist/ranga-gpu.cyr declares mabda in its own manifest.
include "lib/mabda.cyr"

# ── GpuError ────────
#
# Rust's three-variant `GpuError`. Kept as distinct codes rather than folded
# into RG_ERR_* because the Rust enum is `#[non_exhaustive]` public API and
# callers match on which one they got.
# ⚠ PREFIXED. mabda's bundle already defines GPU_ERR_NONE, GPU_ERR_DEVICE_REQUEST
# and fifteen more in the same flat namespace, and its GPU_ERR_DEVICE_REQUEST is
# +2 where ranga's is -2. Cyrius resolves duplicates as last-definition-wins, so
# an unprefixed name here would silently take mabda's value at every ranga call
# site — a sign flip that every `if (code == ...)` would then get wrong. The
# RG_ prefix is load-bearing, not decoration.
var RG_GPU_ERR_NONE          = 0;
var RG_GPU_ERR_NO_ADAPTER    = 0 - 1;
var RG_GPU_ERR_DEVICE_REQUEST = 0 - 2;
var RG_GPU_ERR_BUFFER_OP     = 0 - 3;
# Beyond Rust's three variants. Rust had no notion of an operation the backend
# cannot run, because wgpu ran all fourteen; mabda's native path cannot lower
# four of them, and reporting that distinctly beats folding it into BufferOp.
var RG_GPU_ERR_FORMAT        = 0 - 4;
var RG_GPU_ERR_UNSUPPORTED   = 0 - 5;

# Rust's `impl std::error::Error` messages, which its own tests assert on.
#must_use
fn gpu_error_message(code) {
    if (code == RG_GPU_ERR_NO_ADAPTER) { return "no suitable GPU adapter found"; }
    if (code == RG_GPU_ERR_DEVICE_REQUEST) { return "failed to request GPU device"; }
    if (code == RG_GPU_ERR_BUFFER_OP) { return "GPU buffer operation failed"; }
    return "no error";
}

# Rust's `impl From<GpuError> for RangaError`, which mapped every variant onto
# the catch-all `RangaError::Other` — so all three collapse to RG_ERR_OTHER,
# and the specific code is only available before the conversion.
#must_use
fn gpu_error_to_ranga(code) {
    if (code == RG_GPU_ERR_NONE) { return RG_ERR_NONE; }
    # Rust folded all three of its variants into RangaError::Other. FORMAT and
    # UNSUPPORTED are ranga additions with no Rust variant, and a caller can act
    # on them, so they map to the nearest meaningful code rather than the
    # catch-all.
    if (code == RG_GPU_ERR_FORMAT) { return RG_ERR_INVALID_FORMAT; }
    if (code == RG_GPU_ERR_UNSUPPORTED) { return RG_ERR_UNSUPPORTED_CONVERSION; }
    return RG_ERR_OTHER;
}

# Rust's `impl From<mabda::GpuError> for GpuError`: AdapterNotFound maps to
# NoAdapter, DeviceRequest to DeviceRequest, and EVERYTHING ELSE collapses to
# BufferOp. That last arm is a catch-all over mabda's whole error enum, so a
# mabda error meaning something quite different still surfaces as "buffer
# operation failed" — preserved because callers may match on it.
#must_use
fn gpu_error_from_mabda(mabda_code) {
    if (mabda_code == 0) { return RG_GPU_ERR_NONE; }
    if (mabda_code == GPU_ERR_ADAPTER_NOT_FOUND) { return RG_GPU_ERR_NO_ADAPTER; }
    if (mabda_code == GPU_ERR_DEVICE_REQUEST) { return RG_GPU_ERR_DEVICE_REQUEST; }
    return RG_GPU_ERR_BUFFER_OP;
}

# ── GpuContext ────────
# 64, not 56: +56 holds the native shader-module cache. See gpu_pipeline.cyr —
# a compiled module is bound to the context whose DRM fd staged it, so caching
# them process-globally lets a second context dispatch the first one's modules.
var _GC_SIZE = 64;

#must_use
fn gpu_context_mabda(c) { return load64(c); }
#must_use
fn gpu_context_device(c) { return load64(c + 8); }
#must_use
fn gpu_context_queue(c) { return load64(c + 16); }
#must_use
fn gpu_context_cache(c) { return load64(c + 24); }
# The native shader-module cache: a vec of (selector, module) pairs, owned by
# this context and released with it.
#must_use
fn gpu_context_shader_cache(c) { return load64(c + 56); }
# ⚠ ALWAYS RETURNS "unknown" TODAY — this is a stub, not an accessor, and the
# M7 parity audit caught it reporting itself as ported.
#
# Rust returned the real adapter string (`info.name`, e.g. "NVIDIA GeForce RTX
# 4090"). There is currently no source for it: mabda's vendored bundle has a
# `gpu_caps` struct with an `adapter_name` slot and a `gpu_caps_set_adapter_name`
# setter, but nothing in the bundle ever populates caps from a live adapter. So
# the field is filled with a literal in `_gc_wrap` and never assigned elsewhere.
#
# Kept rather than deleted so the shape of the Rust API survives and one place
# has to change when mabda grows an adapter query — but a consumer must NOT
# branch on this value. Contrast `gpu_context_backend_name`, which is genuinely
# populated from `backend_kind` and which the test suite asserts is not
# "unknown" precisely because it CAN be.
#must_use
fn gpu_context_adapter_name(c) { return load64(c + 32); }

# Whether the adapter name is a real reading. Always 0 today; exists so callers
# can ask instead of string-comparing against "unknown".
#must_use
fn gpu_context_has_adapter_name(c) {
    if (streq(load64(c + 32), "unknown") == 1) { return 0; }
    return 1;
}
#must_use
fn gpu_context_backend_name(c) { return load64(c + 40); }

# Wrap a mabda context RESULT. `owns` decides whether gpu_context_free releases
# the mabda context too — a context handed in by a launcher belongs to the
# launcher.
#
# ⚠ THE ARGUMENT IS A TAGGED RESULT, NOT A CONTEXT. Every mabda context
# constructor returns `gpu_ok(ctx)` / `gpu_err_result(code)`, and the payload
# must be unwrapped before use. Passing the result straight to `gpu_ctx_device`
# dereferences the Result header as if it were a context: it does not fault
# immediately, it returns plausible garbage — the first version of this module
# reported a context created successfully with `backend=unknown`, then
# segfaulted on the next run. A wrong answer that looks right is the failure
# mode this whole port is built to avoid.
#must_use
fn _gc_wrap(res, owns, err_out) {
    if (res == 0) { store64(err_out, RG_GPU_ERR_NO_ADAPTER); return 0; }
    if (is_err_result(res) == 1) {
        store64(err_out, gpu_error_from_mabda(gpu_err_code(payload(res))));
        return 0;
    }
    var mctx = payload(res);
    if (mctx == 0) { store64(err_out, RG_GPU_ERR_NO_ADAPTER); return 0; }
    var c = fl_calloc(_GC_SIZE);
    if (c == 0) { store64(err_out, RG_GPU_ERR_DEVICE_REQUEST); return 0; }
    store64(c, mctx);
    # ⚠ device/queue are cached ONLY for the wgpu path. On a native context
    # these offsets hold a GEM handle and a fixed VA, not a device and queue —
    # the native backend reuses the same struct with different field meanings.
    # Nothing in ranga may pass them to a wgpu helper; the backend-agnostic
    # gpu_buffer_*/gpu_compute_* entry points take the CONTEXT instead.
    store64(c + 8, gpu_ctx_device(mctx));
    store64(c + 16, gpu_ctx_queue(mctx));
    store64(c + 24, _gc_cache_new());
    # See gpu_context_adapter_name: mabda exposes no live adapter query, so this
    # is a placeholder rather than a reading.
    store64(c + 32, "unknown");
    store64(c + 40, _gc_backend_label(backend_kind(gpu_ctx_backend(mctx))));
    store64(c + 48, owns);
    store64(c + 56, vec_new());
    store64(err_out, RG_GPU_ERR_NONE);
    return c;
}

# Rust formatted `{:?}` on wgpu's Backend enum.
#
# ⚠ `gpu_ctx_backend(ctx)` returns the backend OBJECT, not a kind — the kind is
# a field inside it, read with `backend_kind`. Passing the object straight to
# this function compares a pointer against 1/2/3 and always falls through to
# "unknown", which is exactly what the first version of this module did.
#must_use
fn _gc_backend_label(kind) {
    if (kind == BACKEND_KIND_WGPU) { return "wgpu"; }
    if (kind == BACKEND_KIND_AMD) { return "native-amd"; }
    if (kind == BACKEND_KIND_NVIDIA) { return "native-nvidia"; }
    return "unknown";
}

# Create a context on the native AMD backend (amdgpu DRM / GFX9).
#must_use
fn gpu_context_new_amd(err_out) {
    return _gc_wrap(gpu_context_new_native(), 1, err_out);
}

# Create a context on the native NVIDIA backend (nouveau DRM / SM75).
#must_use
fn gpu_context_new_nvidia(err_out) {
    return _gc_wrap(gpu_context_new_native_nvidia(), 1, err_out);
}

# Adopt the context a C launcher pre-initialised on the wgpu path. The launcher
# owns the underlying mabda context, so this one does not release it.
#must_use
fn gpu_context_from_launcher(preinit_ptr, err_out) {
    if (preinit_ptr == 0) { store64(err_out, RG_GPU_ERR_NO_ADAPTER); return 0; }
    return _gc_wrap(gpu_context_from_preinit(preinit_ptr), 0, err_out);
}

fn gpu_context_free(c) {
    if (c == 0) { return RG_ERR_NONE; }
    # Shader modules die with the device, as Rust's did — its caches lived on
    # GpuContext and were dropped with it.
    var sc = load64(c + 56);
    if (sc != 0) {
        var si = 1;
        while (si < vec_len(sc)) {
            gpu_shader_module_release(load64(c), vec_get(sc, si));
            si = si + 2;
        }
    }
    _gc_cache_free(load64(c + 24));
    if (load64(c + 48) == 1) { gpu_context_release(load64(c)); }
    fl_free(c);
    return RG_ERR_NONE;
}

# ── Pipeline cache ────────
#
# Rust hashed a `&'static str` name with DefaultHasher and keyed a
# `mabda::PipelineCache`. The names are a fixed, small set known at compile
# time, so a linear scan over a vec of (name, pipeline) pairs is both simpler
# and faster than hashing — there are at most fourteen entries and lookup
# happens once per operation, not per pixel. The hash existed in Rust to fit
# mabda's u64-keyed cache API, not because the lookup was hot.
var _GC_CACHE_STRIDE = 16;

#must_use
fn _gc_cache_new() { return vec_new(); }

fn _gc_cache_free(cache) {
    if (cache == 0) { return RG_ERR_NONE; }
    var i = 0;
    while (i < vec_len(cache)) {
        var e = vec_get(cache, i);
        compute_pipeline_release(load64(e + 8));
        fl_free(e);
        i = i + 1;
    }
    return RG_ERR_NONE;
}

#must_use
fn _gc_cache_get(cache, name) {
    var i = 0;
    while (i < vec_len(cache)) {
        var e = vec_get(cache, i);
        if (streq(load64(e), name) == 1) { return load64(e + 8); }
        i = i + 1;
    }
    return 0;
}

fn _gc_cache_put(cache, name, pipeline) {
    var e = fl_alloc(_GC_CACHE_STRIDE);
    if (e == 0) { return RG_ERR_ALLOCATION; }
    store64(e, name);
    store64(e + 8, pipeline);
    vec_push(cache, e);
    return RG_ERR_NONE;
}

# ── Pipeline construction ────────
#
# The `with_layout` that mabda's Cyrius surface does not provide. `layout` is a
# built bind group layout from the bglb_* builder; everything downstream mirrors
# `compute_pipeline_new` so the returned handle is the same 24-byte
# ComputePipeline struct that `compute_dispatch` and `compute_pipeline_release`
# already understand.
#must_use
fn _gc_pipeline_with_layout(device, wgsl, entry, bglb) {
    var entries = bglb_build_entries(bglb);
    var count = bglb_entry_count(bglb);
    var bgl_desc = wgpu_bind_group_layout_descriptor("ranga_bgl", entries, count);
    var bgl = wgpu_device_create_bind_group_layout(device, bgl_desc);
    if (bgl == 0) { return 0; }

    var layouts[8];
    store64(&layouts, bgl);
    var pl_desc = wgpu_pipeline_layout_descriptor("ranga_pl", &layouts, 1);
    var pl = wgpu_device_create_pipeline_layout(device, pl_desc);
    if (pl == 0) {
        wgpu_bind_group_layout_release(bgl);
        return 0;
    }

    var src = wgpu_shader_source_wgsl(wgsl);
    var sm_desc = wgpu_shader_module_descriptor("ranga_shader", src);
    var shader = wgpu_device_create_shader_module(device, sm_desc);
    if (shader == 0) {
        wgpu_pipeline_layout_release(pl);
        wgpu_bind_group_layout_release(bgl);
        return 0;
    }

    var cp_desc = wgpu_compute_pipeline_descriptor("ranga_pipeline", pl, shader, entry);
    var pipeline = wgpu_device_create_compute_pipeline(device, cp_desc);
    wgpu_shader_module_release(shader);
    if (pipeline == 0) {
        wgpu_pipeline_layout_release(pl);
        wgpu_bind_group_layout_release(bgl);
        return 0;
    }

    var cp = fl_alloc(24);
    if (cp == 0) { return 0; }
    store64(cp, pipeline);
    store64(cp + 8, bgl);
    store64(cp + 16, pl);
    return cp;
}

# The three layouts, exactly as Rust declared them. The ORDER of the bglb_*
# calls is the binding order — bglb_ assigns each entry the next index — so
# these must not be reordered for tidiness.

# binding 0: storage read-write, binding 1: uniform.
#must_use
fn _gc_bglb_1buf() {
    var b = bglb_new();
    bglb_storage_buffer(b, WGPU_SHADER_STAGE_COMPUTE);
    bglb_uniform_buffer(b, WGPU_SHADER_STAGE_COMPUTE);
    return b;
}

# binding 0: storage READ-ONLY, 1: storage read-write, 2: uniform.
#must_use
fn _gc_bglb_3buf() {
    var b = bglb_new();
    bglb_storage_buffer_readonly(b, WGPU_SHADER_STAGE_COMPUTE);
    bglb_storage_buffer(b, WGPU_SHADER_STAGE_COMPUTE);
    bglb_uniform_buffer(b, WGPU_SHADER_STAGE_COMPUTE);
    return b;
}

# binding 0: input (ro), 1: output (rw), 2: kernel (ro), 3: params (uniform).
#must_use
fn _gc_bglb_4buf() {
    var b = bglb_new();
    bglb_storage_buffer_readonly(b, WGPU_SHADER_STAGE_COMPUTE);
    bglb_storage_buffer(b, WGPU_SHADER_STAGE_COMPUTE);
    bglb_storage_buffer_readonly(b, WGPU_SHADER_STAGE_COMPUTE);
    bglb_uniform_buffer(b, WGPU_SHADER_STAGE_COMPUTE);
    return b;
}

# Rust's `get_or_create_pipeline_1buf` / `_3buf` / `_4buf`. `name` is the cache
# key and must be a stable string constant, as in Rust.
#must_use
fn gpu_context_pipeline_1buf(c, name, wgsl, err_out) {
    return _gc_get_or_create(c, name, wgsl, 1, err_out);
}
#must_use
fn gpu_context_pipeline_3buf(c, name, wgsl, err_out) {
    return _gc_get_or_create(c, name, wgsl, 3, err_out);
}
#must_use
fn gpu_context_pipeline_4buf(c, name, wgsl, err_out) {
    return _gc_get_or_create(c, name, wgsl, 4, err_out);
}

#must_use
fn _gc_get_or_create(c, name, wgsl, kind, err_out) {
    if (c == 0) { store64(err_out, RG_GPU_ERR_NO_ADAPTER); return 0; }
    var cache = load64(c + 24);
    var hit = _gc_cache_get(cache, name);
    if (hit != 0) { store64(err_out, RG_GPU_ERR_NONE); return hit; }

    var bglb = 0;
    if (kind == 1) { bglb = _gc_bglb_1buf(); }
    if (kind == 3) { bglb = _gc_bglb_3buf(); }
    if (kind == 4) { bglb = _gc_bglb_4buf(); }
    if (bglb == 0) { store64(err_out, RG_GPU_ERR_DEVICE_REQUEST); return 0; }

    var cp = _gc_pipeline_with_layout(load64(c + 8), wgsl, "main", bglb);
    if (cp == 0) { store64(err_out, RG_GPU_ERR_DEVICE_REQUEST); return 0; }
    _gc_cache_put(cache, name, cp);
    store64(err_out, RG_GPU_ERR_NONE);
    return cp;
}

# --- gpu_buffer.cyr ---

# gpu_buffer.cyr -- GPU-side pixel buffers over mabda 4.0.9
# Ported from rust-old/src/gpu/buffer.rs. Private prefix: _gb_
#
# A GpuBuffer is a storage buffer holding one image's pixel bytes, plus the
# dimensions and format needed to rebuild a PixelBuffer on the way back. mabda
# owns the GPU allocation; this struct owns only the handle and the metadata.
#
#   GpuBuffer 40 bytes
#     +0 mabda buffer handle   +8 size (bytes)
#     +16 width   +24 height   +32 format

var _GB_SIZE = 40;

#must_use
fn gpu_buffer_handle(b) { return load64(b); }
#must_use
fn gpu_buffer_size(b) { return load64(b + 8); }
#must_use
fn gpu_buffer_width(b) { return load64(b + 16); }
#must_use
fn gpu_buffer_height(b) { return load64(b + 24); }
#must_use
fn gpu_buffer_format(b) { return load64(b + 32); }

# Storage buffer that a compute shader reads and writes, and that we can copy
# to and from the host. Same three flags Rust's create_storage_buffer set.
var _GB_USAGE = 0x0080 | 0x0008 | 0x0004;

# Upload a PixelBuffer to GPU storage. Rust's `GpuBuffer::upload`.
#
# ⚠ USES THE BACKEND-AGNOSTIC API, not mabda's `create_storage_buffer`. That
# helper takes a `device` and calls `wgpu_device_create_buffer` DIRECTLY, so it
# only works on the wgpu path. On a native context `gpu_ctx_device()` is not a
# device at all — the native context reuses the same struct with different field
# meanings, and offset +16 holds a GEM buffer-object handle where wgpu holds the
# device. Passing that to the wgpu helper calls through an uninitialised
# function table. `gpu_buffer_create`/`_write`/`_read` take the CONTEXT and
# dispatch through the backend's slot table, which is what "the public API does
# not change across backends" actually refers to.
#
# Returns 0 on failure, with a code through err_out.
#must_use
fn gpu_buffer_upload(ctx, pb, err_out) {
    if (ctx == 0) { store64(err_out, RG_GPU_ERR_NO_ADAPTER); return 0; }
    if (pb == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }

    var mctx = gpu_context_mabda(ctx);
    # ⚠ pixel_buffer_data returns the RAW BYTE POINTER (bv_data of the inner
    # vec), not the bytevec — pixel_buffer_len is the length. Treating the
    # return as a bytevec and calling bv_len on it reads a length field out of
    # pixel data and yields 0, which then allocates a zero-byte GPU buffer.
    var src = pixel_buffer_data(pb);
    var size = pixel_buffer_len(pb);
    if (size <= 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    var handle = gpu_buffer_create(mctx, size, _GB_USAGE);
    if (handle == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    if (gpu_buffer_write(mctx, handle, 0, src, size) != 0) {
        gpu_buffer_release(mctx, handle);
        store64(err_out, RG_GPU_ERR_BUFFER_OP);
        return 0;
    }

    var b = fl_alloc(_GB_SIZE);
    if (b == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    store64(b, handle);
    store64(b + 8, size);
    store64(b + 16, pixel_buffer_width(pb));
    store64(b + 24, pixel_buffer_height(pb));
    store64(b + 32, pixel_buffer_format(pb));
    store64(err_out, RG_GPU_ERR_NONE);
    return b;
}

# Read the GPU buffer back into a new PixelBuffer. Rust's `GpuBuffer::download`.
#
# The caller owns the returned PixelBuffer. mabda's `read_buffer` does the
# staging-buffer copy and the synchronous map internally and hands back a
# pointer to `size` bytes.
#must_use
fn gpu_buffer_download(b, ctx, err_out) {
    if (b == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    if (ctx == 0) { store64(err_out, RG_GPU_ERR_NO_ADAPTER); return 0; }

    var size = load64(b + 8);
    # bv_uninit, not bv_zeroed: gpu_buffer_read fills every byte, so the zero
    # fill would be pure waste on a full frame.
    var bv = bv_uninit(size);
    if (bv == 0) { store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    if (gpu_buffer_read(gpu_context_mabda(ctx), load64(b), 0, bv_data(bv), size) != 0) {
        bv_free(bv);
        store64(err_out, RG_GPU_ERR_BUFFER_OP);
        return 0;
    }

    # pixel_buffer_new re-derives the expected byte count from the format and
    # dimensions and REFUSES a mismatch, which is the check that catches a
    # readback of the wrong length. On success it takes ownership of bv; on
    # failure bv is still ours to release.
    var perr = fl_alloc(8);
    if (perr == 0) { bv_free(bv); store64(err_out, RG_GPU_ERR_BUFFER_OP); return 0; }
    var pb = pixel_buffer_new(bv, load64(b + 16), load64(b + 24), load64(b + 32), perr);
    var prc = load64(perr);
    fl_free(perr);
    if (pb == 0) {
        bv_free(bv);
        store64(err_out, RG_GPU_ERR_BUFFER_OP);
        return 0;
    }
    if (prc != RG_ERR_NONE) {
        pixel_buffer_free(pb);
        store64(err_out, RG_GPU_ERR_BUFFER_OP);
        return 0;
    }
    store64(err_out, RG_GPU_ERR_NONE);
    return pb;
}

# Release the GPU allocation and the wrapper.
#
# NOT PORTED: Rust's `download_async`, which spawned a thread, hand-rolled the
# staging buffer and mapped it through an mpsc channel because
# `mabda::PendingReadback::finish()` needs a `&Device` that is not `Send`. That
# constraint is a Rust borrow-checker artifact with no Cyrius analogue, and the
# Cyrius mabda exposes no async readback to build on. The synchronous
# `gpu_buffer_download` is the whole surface until mabda grows one.
# Takes the context because the release goes through the backend slot table.
fn gpu_buffer_free(ctx, b) {
    if (b == 0) { return RG_ERR_NONE; }
    var h = load64(b);
    if (h != 0 && ctx != 0) { gpu_buffer_release(gpu_context_mabda(ctx), h); }
    fl_free(b);
    return RG_ERR_NONE;
}
