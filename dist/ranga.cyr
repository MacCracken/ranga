# --- error.cyr ---

# error.cyr -- ranga error codes and Rust-semantics math shims
# Ported from rust-old/src/error.rs (RangaError).
#
# Replaces Rust's RangaError enum with integer error codes. Functions return
# RG_ERR_NONE (0) on success or a negative RG_ERR_* code on failure. Where a
# function also returns a value, it takes an `err_out` pointer and writes the
# code there. The detailed context Rust carried in the variant payloads
# (expected/actual sizes, format names) is logged at the failure site rather
# than carried in the return value.
#
# Rust variant                          -> code
#   InvalidFormat(String)               -> RG_ERR_INVALID_FORMAT
#   DimensionMismatch{expected,actual}  -> RG_ERR_DIMENSION_MISMATCH
#   BufferTooSmall{need,have}           -> RG_ERR_BUFFER_TOO_SMALL
#   UnsupportedConversion{from,to}      -> RG_ERR_UNSUPPORTED_CONVERSION
#   Other(String)                       -> RG_ERR_OTHER
#
# Pairs with tagged.cyr for Result-like patterns when an Option is needed.

var RG_ERR_NONE                   = 0;

# The pixel format is invalid or unsupported for this operation.
var RG_ERR_INVALID_FORMAT         = (0 - 1);
# Buffer dimensions do not match the expected size.
var RG_ERR_DIMENSION_MISMATCH     = (0 - 2);
# The provided buffer is too small for the operation.
var RG_ERR_BUFFER_TOO_SMALL       = (0 - 3);
# The requested conversion between formats is not supported.
var RG_ERR_UNSUPPORTED_CONVERSION = (0 - 4);
# A parameter is outside the valid range. Covers the cases 1.0.0 hardening
# turned from silent misbehaviour into errors: bilateral sigma = 0 (was a
# -inf coefficient) and levels gamma = 0 (was powf(infinity)).
var RG_ERR_INVALID_PARAMETER      = (0 - 5);
# An allocation was refused — the request exceeds ALLOC_MAX, the size
# computation overflowed, or the heap is exhausted. Distinct from
# RG_ERR_INVALID_PARAMETER: the arguments were sane, the memory was not there.
# This is the code checked_buffer_size() guards against on the Rust side.
var RG_ERR_ALLOCATION             = (0 - 6);
# Malformed input bytes — an ICC profile that fails structural validation, or
# a .cube LUT that is not well-formed.
var RG_ERR_PARSE                  = (0 - 7);
# A generic failure with no more specific code (Rust's Other(String)).
var RG_ERR_OTHER                  = (0 - 8);

# 1 if `code` is an error (negative), else 0.
#must_use
fn ranga_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# 1 if `code` is success (RG_ERR_NONE), else 0.
#must_use
fn ranga_is_ok(code) {
    if (code == 0) { return 1; }
    return 0;
}

# ── Rust-semantics math shims ────────
# The Cyrius math builtins diverge from Rust's f64 methods at the zero and
# infinite boundaries, because `ganita_f64_pow` is implemented as
# exp(n*ln(base)) and the x87 `exp` returns NaN for an infinite argument. Every
# ported call site that can reach those boundaries goes through these shims so
# the port keeps matching `rust-old/`. Same divergence prakash hit and shimmed
# in its own error.cyr — see prakash/src/error.cyr `_prk_pow` / `_prk_exp`.
#
#   expression              Cyrius builtin   Rust           shim
#   ganita_f64_pow(0.0, 2)  NaN              0.0            0.0
#   f64_exp(-inf)           NaN              0.0            0.0
#   f64_exp(+inf)           NaN              +inf           +inf
#
# Finite arguments are delegated unchanged, so no in-range result moves.

var _RG_INF     = 0x7FF0000000000000;
var _RG_NEG_INF = 0xFFF0000000000000;
var _RG_NAN     = 0x7FF8000000000000;

# Rust `f64::exp` semantics. Only the infinite arguments are special-cased;
# NaN in still gives NaN out, matching Rust.
#
# This is load-bearing for the filters, not theoretical: the Gaussian and
# bilateral kernels evaluate exp(-d^2 / 2*sigma^2), and a large spatial or
# range distance drives that argument to -inf. Rust yields a 0.0 weight — the
# sample simply does not contribute; the unshimmed builtin yields NaN, which
# then poisons the whole accumulator for that pixel.
#must_use
fn _rg_exp(x) {
    if (x == _RG_INF) { return _RG_INF; }
    if (x == _RG_NEG_INF) { return 0; }
    return f64_exp(x);
}

# Rust `f64::powf` semantics for a non-negative base. `ganita_f64_pow` computes
# exp(n*ln(base)), so a zero base gives exp(-inf) = NaN where Rust gives 0.0
# (positive exponent), 1.0 (zero exponent) or +inf (negative exponent).
#
# ranga reaches the zero base through the ICC tone curves and the sRGB transfer
# function, which raise a channel value to a gamma — and a fully black channel
# is exactly 0.0, so this is hit by ordinary image data, not an edge case.
#
# A negative base is delegated unchanged: Rust's powf is also NaN there for a
# non-integer exponent, and no ranga call site raises a negative base.
#must_use
fn _rg_pow(base, exp) {
    if (f64_abs(base) == 0) {
        if (f64_gt(exp, 0) == 1) { return 0; }
        if (f64_lt(exp, 0) == 1) { return _RG_INF; }
        return F64_ONE;
    }
    return ganita_f64_pow(base, exp);
}

# Rust `f64::cbrt`. There is NO f64 cbrt anywhere in the Cyrius tree —
# `ganita_f32_cbrt` is the only one, and dropping to single precision would cost
# ~8 significant digits in the CIE Lab transfer, where ranga's Delta-E tests
# assert against tight tolerances.
#
# Built from pow, and the sign split is REQUIRED rather than decorative: pow
# goes through exp(y*ln x), and ln of a negative is undefined, so a bare
# _rg_pow returns garbage for every negative input while looking correct for
# the positives a naive test would use. Same reasoning ganita applies in
# ganita_f32_cbrt.
#must_use
fn _rg_cbrt(x) {
    var third = f64_div(F64_ONE, f64_from(3));
    if (f64_lt(x, 0) == 1) {
        return f64_neg(_rg_pow(f64_abs(x), third));
    }
    return _rg_pow(x, third);
}

# Sine/cosine with an explicit domain guard. The x86 `fsin`/`fcos` instructions
# are undefined for |x| >= 2^63 and return the ARGUMENT UNCHANGED there, so
# `f64_sin(1e300)` yields 1e300. ranga takes a caller-supplied angle in
# hue_rotate and color_balance, so an unclamped user value can reach this.
# Below the limit both delegate unchanged, so no in-range result moves.
var _RG_TRIG_LIMIT = 0x43E0000000000000;   # 2^63

#must_use
fn _rg_sin(x) {
    if (f64_lt(f64_abs(x), _RG_TRIG_LIMIT) == 0) { return _RG_NAN; }
    return f64_sin(x);
}

#must_use
fn _rg_cos(x) {
    if (f64_lt(f64_abs(x), _RG_TRIG_LIMIT) == 0) { return _RG_NAN; }
    return f64_cos(x);
}

# --- bytevec.cyr ---

# bytevec.cyr -- byte-granular growable buffer
#
# Cyrius `lib/vec.cyr` stores i64 SLOTS: every accessor is hardcoded to
# `data + idx * 8`, so a 4-byte RGBA pixel would occupy 32 bytes and `bv_get`
# would read past its neighbours. Image data is bytes, so ranga needs its own.
# This is internalizing item 2 in docs/development/cyrius-port-plan.md §3 —
# a candidate to upstream once a second consumer wants it.
#
# LAYOUT. A 24-byte header, separate from the payload:
#   +0  data     pointer to the byte payload (0 for a zero-capacity vec)
#   +8  len      bytes in use
#   +16 cap      bytes allocated
#
# ALLOCATOR. fl_alloc / fl_free, not the bump allocator. The freelist routes
# anything over 4 KB straight to mmap and gives it back with munmap on free
# (lib/freelist.cyr:268), so a 1080p RGBA8 frame — 8,294,400 bytes — is one
# syscall to acquire and one to release. The bump allocator has no individual
# free at all, which would make BufferPool pointless.

var _BV_HDR = 24;

# Allocate a byte vector with `cap` bytes of capacity and length 0.
# Returns 0 if either allocation fails.
#must_use
fn bv_new(cap) {
    var v = fl_alloc(_BV_HDR);
    if (v == 0) { return 0; }
    var data = 0;
    if (cap > 0) {
        data = fl_alloc(cap);
        if (data == 0) { fl_free(v); return 0; }
    }
    store64(v, data);
    store64(v + 8, 0);
    store64(v + 16, cap);
    return v;
}

# Allocate a byte vector of `n` zeroed bytes, with length ALREADY set to n.
# This is the PixelBuffer::zeroed path — the caller wants n addressable bytes,
# not an empty vec with capacity.
#must_use
fn bv_zeroed(n) {
    var v = fl_alloc(_BV_HDR);
    if (v == 0) { return 0; }
    var data = 0;
    if (n > 0) {
        data = fl_calloc(n);
        if (data == 0) { fl_free(v); return 0; }
    }
    store64(v, data);
    store64(v + 8, n);
    store64(v + 16, n);
    return v;
}

#must_use
fn bv_data(v) { return load64(v); }
#must_use
fn bv_len(v) { return load64(v + 8); }
#must_use
fn bv_cap(v) { return load64(v + 16); }

# Set the length without touching the payload. The caller is asserting that
# `n` bytes are initialised; used after writing through bv_data directly.
# Refuses to grow past capacity — returns RG_ERR_INVALID_PARAMETER rather than
# handing back a vec whose len exceeds its allocation.
fn bv_set_len(v, n) {
    if (n < 0) { return RG_ERR_INVALID_PARAMETER; }
    if (n > load64(v + 16)) { return RG_ERR_INVALID_PARAMETER; }
    store64(v + 8, n);
    return RG_ERR_NONE;
}

# Byte at `idx`, or 0 if out of range. Zero-extends — load8 does not sign-extend,
# so a 0xFF byte reads back as 255, not -1.
#must_use
fn bv_get(v, idx) {
    if (idx < 0) { return 0; }
    if (idx >= load64(v + 8)) { return 0; }
    return load8(load64(v) + idx);
}

# Write a byte at `idx`. Returns 1 on success, 0 if out of range — mirroring
# PixelBuffer::set_rgba's bool rather than trapping, because the Rust original
# reports out-of-bounds to the caller instead of panicking.
fn bv_set(v, idx, val) {
    if (idx < 0) { return 0; }
    if (idx >= load64(v + 8)) { return 0; }
    store8(load64(v) + idx, val & 255);
    return 1;
}

# Unchecked read for hot loops where the caller has already bounds-checked the
# whole row. Mirrors slice_unchecked_get_8.
#must_use
fn bv_get_unchecked(v, idx) {
    return load8(load64(v) + idx);
}

fn bv_set_unchecked(v, idx, val) {
    store8(load64(v) + idx, val & 255);
    return RG_ERR_NONE;
}

# Grow capacity to at least `want`, preserving the first `len` bytes.
# Doubling, so repeated pushes stay amortised O(1).
fn bv_reserve(v, want) {
    var cap = load64(v + 16);
    if (want <= cap) { return RG_ERR_NONE; }
    var ncap = cap;
    if (ncap == 0) { ncap = 16; }
    while (ncap < want) { ncap = ncap * 2; }
    var ndata = fl_alloc(ncap);
    if (ndata == 0) { return RG_ERR_ALLOCATION; }
    var old = load64(v);
    var len = load64(v + 8);
    if (old != 0) {
        if (len > 0) { memcpy(ndata, old, len); }
        fl_free(old);
    }
    store64(v, ndata);
    store64(v + 16, ncap);
    return RG_ERR_NONE;
}

fn bv_push(v, val) {
    var len = load64(v + 8);
    var rc = bv_reserve(v, len + 1);
    if (rc != RG_ERR_NONE) { return rc; }
    store8(load64(v) + len, val & 255);
    store64(v + 8, len + 1);
    return RG_ERR_NONE;
}

# Set every byte in [0, len) to `val`. The memset path, for fill_solid.
fn bv_fill(v, val) {
    var len = load64(v + 8);
    if (len > 0) { memset(load64(v), val & 255, len); }
    return RG_ERR_NONE;
}

# Copy `n` bytes from a raw pointer into the vec at `off`. Bounds-checked
# against len, not cap.
fn bv_write(v, off, src, n) {
    if (off < 0) { return RG_ERR_INVALID_PARAMETER; }
    if (n < 0) { return RG_ERR_INVALID_PARAMETER; }
    if (off + n > load64(v + 8)) { return RG_ERR_BUFFER_TOO_SMALL; }
    if (n > 0) { memcpy(load64(v) + off, src, n); }
    return RG_ERR_NONE;
}

# Deep copy. Length and capacity of the clone are both the source's length —
# a clone is not expected to be pushed to.
#must_use
fn bv_clone(v) {
    var len = load64(v + 8);
    var c = bv_new(len);
    if (c == 0) { return 0; }
    if (len > 0) { memcpy(load64(c), load64(v), len); }
    store64(c + 8, len);
    return c;
}

# Truncate to length 0, keeping the allocation for reuse. This is the
# BufferPool::acquire path — Vec::clear in the Rust original.
fn bv_clear(v) {
    store64(v + 8, 0);
    return RG_ERR_NONE;
}

# Set length to `n`, zeroing any newly exposed bytes. Grows the allocation if
# needed. Rust's Vec::resize(n, 0).
fn bv_resize_zero(v, n) {
    if (n < 0) { return RG_ERR_INVALID_PARAMETER; }
    var rc = bv_reserve(v, n);
    if (rc != RG_ERR_NONE) { return rc; }
    var len = load64(v + 8);
    if (n > len) { memset(load64(v) + len, 0, n - len); }
    store64(v + 8, n);
    return RG_ERR_NONE;
}

# Release the payload and the header. Safe on 0.
fn bv_free(v) {
    if (v == 0) { return RG_ERR_NONE; }
    var data = load64(v);
    if (data != 0) { fl_free(data); }
    fl_free(v);
    return RG_ERR_NONE;
}

# --- pixel.cyr ---

# pixel.cyr -- pixel formats, buffers, views, and the buffer pool
# Ported from rust-old/src/pixel.rs (783 lines).
#
# STRUCT LAYOUT. Cyrius struct FIELDS carry only i8/i16/i32/i64/struct/Str/Vec
# sids — there is no u8, u32, or f32 field type, and `#derive(accessors)` emits
# load64/store64 unconditionally, which is wrong for anything narrower. So these
# are raw byte-offset records with hand-written width-correct accessors. This is
# the pattern every later module follows; see cyrius-port-plan.md §2.
#
# PixelBuffer (32 bytes)          PixelView / PixelViewMut (32 bytes)
#   +0  data    bytevec ptr         +0  data    raw byte pointer (borrowed)
#   +8  width   i64                 +8  width   i64
#   +16 height  i64                 +16 height  i64
#   +24 format  i64                 +24 format  i64
#
# Rust's PixelView<'a> / PixelViewMut<'a> differ only by borrow mutability,
# which Cyrius has no way to express — they share one representation here, and
# the split survives as naming plus the mutating accessors being defined only
# for the Mut form. The lifetime is the caller's responsibility: a view does not
# own its bytes and must not outlive the buffer it came from.

# ── PixelFormat ────────
# Rust's `enum PixelFormat` — discriminants are the declaration order, matching
# the Serialize/Deserialize wire form the Rust version emitted.
var PF_RGBA8   = 0;
var PF_ARGB8   = 1;
var PF_RGB8    = 2;
var PF_YUV420P = 3;
var PF_NV12    = 4;
var PF_RGBAF32 = 5;

# Display impl. Hand-written because #derive(Serialize) on a Cyrius enum
# compiles clean and emits a misnamed, crashing codec — see §3 item 6.
#must_use
fn pixel_format_name(f) {
    if (f == PF_RGBA8) { return "RGBA8"; }
    if (f == PF_ARGB8) { return "ARGB8"; }
    if (f == PF_RGB8) { return "RGB8"; }
    if (f == PF_YUV420P) { return "YUV420p"; }
    if (f == PF_NV12) { return "NV12"; }
    if (f == PF_RGBAF32) { return "RgbaF32"; }
    return "unknown";
}

#must_use
fn pixel_format_is_valid(f) {
    if (f < 0) { return 0; }
    if (f > PF_RGBAF32) { return 0; }
    return 1;
}

# Planar formats have no meaningful interleaved row stride, so rows()/rows_mut()
# reject them — the Rust version debug_asserts here, having previously produced
# silently wrong slices.
#must_use
fn pixel_format_is_planar(f) {
    if (f == PF_YUV420P) { return 1; }
    if (f == PF_NV12) { return 1; }
    return 0;
}

# Ceiling division, for the 4:2:0 chroma planes: an odd dimension still needs a
# full chroma sample. Rust's usize::div_ceil.
#must_use
fn _div_ceil2(n) {
    return (n + 1) / 2;
}

# Buffer size in bytes, or RG_ERR_ALLOCATION if the computation would overflow.
# Rust returns Option<usize>; the error code takes the place of None, which is
# safe because a real size is always >= 0 and every error code is negative.
#
# The overflow guard is not decorative: `Rgba8.checked_buffer_size(u32::MAX,
# u32::MAX)` is None in Rust, and before 1.0.0 the unchecked version silently
# wrapped. i64 is wide enough that u32*u32*16 cannot overflow it, so the guard
# here is a range check against the same limit rather than a carry check.
var _RG_SIZE_MAX = 0x7FFFFFFFFFFFFFF;

#must_use
fn pixel_format_checked_buffer_size(f, width, height) {
    if (width < 0) { return RG_ERR_INVALID_PARAMETER; }
    if (height < 0) { return RG_ERR_INVALID_PARAMETER; }
    if (pixel_format_is_valid(f) == 0) { return RG_ERR_INVALID_FORMAT; }

    var w = width;
    var h = height;
    if (w != 0) {
        if (h > _RG_SIZE_MAX / w) { return RG_ERR_ALLOCATION; }
    }
    var px = w * h;

    if (f == PF_RGBA8) { return px * 4; }
    if (f == PF_ARGB8) { return px * 4; }
    if (f == PF_RGB8) { return px * 3; }
    if (f == PF_RGBAF32) { return px * 16; }
    # Yuv420p and Nv12 share a size: a full Y plane plus two half-resolution
    # chroma planes (Nv12 interleaves them, which does not change the total).
    var chroma = _div_ceil2(w) * _div_ceil2(h) * 2;
    return px + chroma;
}

# Bytes per pixel for the interleaved formats. 0 for the planar ones, which
# have no single per-pixel stride.
#must_use
fn pixel_format_bytes_per_pixel(f) {
    if (f == PF_RGBA8) { return 4; }
    if (f == PF_ARGB8) { return 4; }
    if (f == PF_RGB8) { return 3; }
    if (f == PF_RGBAF32) { return 16; }
    return 0;
}

# ── PixelBuffer ────────
var _PB_SIZE = 32;

# Take ownership of `bv` (a bytevec) as a buffer of the given shape, validating
# that its length matches the format exactly. Writes an error code through
# `err_out` and returns 0 on mismatch. On success the buffer OWNS bv — do not
# free bv separately.
#
# Rust returns Result<Self, RangaError>; the err_out pointer is the Cyrius
# equivalent (cyrius-port-plan.md §7 error model).
#must_use
fn pixel_buffer_new(bv, width, height, format, err_out) {
    var want = pixel_format_checked_buffer_size(format, width, height);
    if (ranga_is_err(want) == 1) { store64(err_out, want); return 0; }
    if (bv_len(bv) != want) {
        store64(err_out, RG_ERR_DIMENSION_MISMATCH);
        return 0;
    }
    var b = fl_alloc(_PB_SIZE);
    if (b == 0) { store64(err_out, RG_ERR_ALLOCATION); return 0; }
    store64(b, bv);
    store64(b + 8, width);
    store64(b + 16, height);
    store64(b + 24, format);
    store64(err_out, RG_ERR_NONE);
    return b;
}

# Allocate a zero-filled buffer of the given shape. Rust's PixelBuffer::zeroed,
# which is infallible there; here an allocation can fail, so it reports through
# err_out like pixel_buffer_new.
#must_use
fn pixel_buffer_zeroed(width, height, format, err_out) {
    var want = pixel_format_checked_buffer_size(format, width, height);
    if (ranga_is_err(want) == 1) { store64(err_out, want); return 0; }
    var bv = bv_zeroed(want);
    if (bv == 0) { store64(err_out, RG_ERR_ALLOCATION); return 0; }
    var b = fl_alloc(_PB_SIZE);
    if (b == 0) { bv_free(bv); store64(err_out, RG_ERR_ALLOCATION); return 0; }
    store64(b, bv);
    store64(b + 8, width);
    store64(b + 16, height);
    store64(b + 24, format);
    store64(err_out, RG_ERR_NONE);
    return b;
}

#must_use
fn pixel_buffer_bv(b) { return load64(b); }
# Raw pointer to the first pixel byte — the hot-loop entry point.
#must_use
fn pixel_buffer_data(b) { return bv_data(load64(b)); }
#must_use
fn pixel_buffer_len(b) { return bv_len(load64(b)); }
#must_use
fn pixel_buffer_width(b) { return load64(b + 8); }
#must_use
fn pixel_buffer_height(b) { return load64(b + 16); }
#must_use
fn pixel_buffer_format(b) { return load64(b + 24); }

#must_use
fn pixel_buffer_pixel_count(b) {
    return load64(b + 8) * load64(b + 16);
}

# Byte offset of row `y`. Returns RG_ERR_INVALID_FORMAT for planar formats,
# matching rows()/rows_mut() rejecting them.
#must_use
fn pixel_buffer_row_offset(b, y) {
    var f = load64(b + 24);
    if (pixel_format_is_planar(f) == 1) { return RG_ERR_INVALID_FORMAT; }
    if (y < 0) { return RG_ERR_INVALID_PARAMETER; }
    if (y >= load64(b + 16)) { return RG_ERR_INVALID_PARAMETER; }
    return y * load64(b + 8) * pixel_format_bytes_per_pixel(f);
}

#must_use
fn pixel_buffer_row_bytes(b) {
    var f = load64(b + 24);
    if (pixel_format_is_planar(f) == 1) { return RG_ERR_INVALID_FORMAT; }
    return load64(b + 8) * pixel_format_bytes_per_pixel(f);
}

# Read the RGBA pixel at (x, y) into the 4 bytes at `out`. Requires Rgba8.
# Returns 1 on success, 0 for a wrong format or out-of-bounds coordinate —
# Rust returns Option<[u8; 4]>, and 0 stands in for None.
fn pixel_buffer_get_rgba(b, x, y, out) {
    if (load64(b + 24) != PF_RGBA8) { return 0; }
    if (x < 0) { return 0; }
    if (y < 0) { return 0; }
    if (x >= load64(b + 8)) { return 0; }
    if (y >= load64(b + 16)) { return 0; }
    var p = bv_data(load64(b)) + (y * load64(b + 8) + x) * 4;
    store8(out, load8(p));
    store8(out + 1, load8(p + 1));
    store8(out + 2, load8(p + 2));
    store8(out + 3, load8(p + 3));
    return 1;
}

# Write the 4 bytes at `px` to the pixel at (x, y). Requires Rgba8.
# Returns 1 on success, 0 for a wrong format or out-of-bounds coordinate.
fn pixel_buffer_set_rgba(b, x, y, px) {
    if (load64(b + 24) != PF_RGBA8) { return 0; }
    if (x < 0) { return 0; }
    if (y < 0) { return 0; }
    if (x >= load64(b + 8)) { return 0; }
    if (y >= load64(b + 16)) { return 0; }
    var p = bv_data(load64(b)) + (y * load64(b + 8) + x) * 4;
    store8(p, load8(px));
    store8(p + 1, load8(px + 1));
    store8(p + 2, load8(px + 2));
    store8(p + 3, load8(px + 3));
    return 1;
}

#must_use
fn pixel_buffer_clone(b) {
    var bv = bv_clone(load64(b));
    if (bv == 0) { return 0; }
    var c = fl_alloc(_PB_SIZE);
    if (c == 0) { bv_free(bv); return 0; }
    store64(c, bv);
    store64(c + 8, load64(b + 8));
    store64(c + 16, load64(b + 16));
    store64(c + 24, load64(b + 24));
    return c;
}

fn pixel_buffer_free(b) {
    if (b == 0) { return RG_ERR_NONE; }
    bv_free(load64(b));
    fl_free(b);
    return RG_ERR_NONE;
}

# ── PixelView / PixelViewMut ────────
# Borrowed, non-owning. `data` is a raw pointer, not a bytevec, so a view can
# wrap memory ranga did not allocate (a consumer's frame buffer).
var _PV_SIZE = 32;

#must_use
fn _pixel_view_make(data, width, height, format, len, err_out) {
    var want = pixel_format_checked_buffer_size(format, width, height);
    if (ranga_is_err(want) == 1) { store64(err_out, want); return 0; }
    if (len < want) { store64(err_out, RG_ERR_BUFFER_TOO_SMALL); return 0; }
    var v = fl_alloc(_PV_SIZE);
    if (v == 0) { store64(err_out, RG_ERR_ALLOCATION); return 0; }
    store64(v, data);
    store64(v + 8, width);
    store64(v + 16, height);
    store64(v + 24, format);
    store64(err_out, RG_ERR_NONE);
    return v;
}

#must_use
fn pixel_view_new(data, len, width, height, format, err_out) {
    return _pixel_view_make(data, width, height, format, len, err_out);
}

#must_use
fn pixel_view_mut_new(data, len, width, height, format, err_out) {
    return _pixel_view_make(data, width, height, format, len, err_out);
}

#must_use
fn pixel_view_data(v) { return load64(v); }
#must_use
fn pixel_view_width(v) { return load64(v + 8); }
#must_use
fn pixel_view_height(v) { return load64(v + 16); }
#must_use
fn pixel_view_format(v) { return load64(v + 24); }
#must_use
fn pixel_view_pixel_count(v) { return load64(v + 8) * load64(v + 16); }

# Borrow a buffer as a view. The view must not outlive `b`.
#must_use
fn pixel_buffer_as_view(b, err_out) {
    return _pixel_view_make(bv_data(load64(b)), load64(b + 8), load64(b + 16),
                            load64(b + 24), bv_len(load64(b)), err_out);
}

#must_use
fn pixel_buffer_as_view_mut(b, err_out) {
    return _pixel_view_make(bv_data(load64(b)), load64(b + 8), load64(b + 16),
                            load64(b + 24), bv_len(load64(b)), err_out);
}

# Copy a view into a new owned buffer. Rust's PixelBuffer::from_view.
#must_use
fn pixel_buffer_from_view(v, err_out) {
    var w = load64(v + 8);
    var h = load64(v + 16);
    var f = load64(v + 24);
    var want = pixel_format_checked_buffer_size(f, w, h);
    if (ranga_is_err(want) == 1) { store64(err_out, want); return 0; }
    var bv = bv_zeroed(want);
    if (bv == 0) { store64(err_out, RG_ERR_ALLOCATION); return 0; }
    if (want > 0) { memcpy(bv_data(bv), load64(v), want); }
    var b = fl_alloc(_PB_SIZE);
    if (b == 0) { bv_free(bv); store64(err_out, RG_ERR_ALLOCATION); return 0; }
    store64(b, bv);
    store64(b + 8, w);
    store64(b + 16, h);
    store64(b + 24, f);
    store64(err_out, RG_ERR_NONE);
    return b;
}

# A view owns nothing but its own 32-byte header.
fn pixel_view_free(v) {
    if (v == 0) { return RG_ERR_NONE; }
    fl_free(v);
    return RG_ERR_NONE;
}

# ── BufferPool ────────
# Recycles pixel-sized allocations across frames. Backed by fl_alloc, so a
# released 1080p buffer is a real munmap rather than a leak.
#
#   +0  slots       pointer to max_buffers i64 bytevec handles (0 = empty slot)
#   +8  count       occupied slots
#   +16 max_buffers capacity
var _BP_SIZE = 24;

#must_use
fn buffer_pool_new(max_buffers) {
    if (max_buffers < 0) { return 0; }
    var p = fl_alloc(_BP_SIZE);
    if (p == 0) { return 0; }
    var slots = 0;
    if (max_buffers > 0) {
        slots = fl_calloc(max_buffers * 8);
        if (slots == 0) { fl_free(p); return 0; }
    }
    store64(p, slots);
    store64(p + 8, 0);
    store64(p + 16, max_buffers);
    return p;
}

#must_use
fn buffer_pool_len(p) { return load64(p + 8); }

#must_use
fn buffer_pool_is_empty(p) {
    if (load64(p + 8) == 0) { return 1; }
    return 0;
}

# Acquire a zeroed buffer of at least `size` bytes.
#
# BEST-FIT, not first-fit: scan every occupied slot and take the SMALLEST one
# that fits. 1.0.0 changed this from first-fit deliberately — first-fit hands a
# 4K-sized buffer to a thumbnail request and then has nothing left for the next
# 4K frame. Falls back to a fresh allocation when nothing fits.
#must_use
fn buffer_pool_acquire(p, size) {
    var slots = load64(p);
    var max = load64(p + 16);
    var best = (0 - 1);
    var best_cap = 0;
    var i = 0;
    while (i < max) {
        var h = load64(slots + i * 8);
        if (h != 0) {
            var cap = bv_cap(h);
            if (cap >= size) {
                if (best < 0) { best = i; best_cap = cap; }
                if (cap < best_cap) { best = i; best_cap = cap; }
            }
        }
        i = i + 1;
    }
    if (best >= 0) {
        var buf = load64(slots + best * 8);
        store64(slots + best * 8, 0);
        store64(p + 8, load64(p + 8) - 1);
        bv_clear(buf);
        bv_resize_zero(buf, size);
        return buf;
    }
    return bv_zeroed(size);
}

# Return a buffer for reuse. If the pool is full the buffer is FREED, not
# leaked — Rust dropped it here, and dropping is what fl_free does.
fn buffer_pool_release(p, buf) {
    if (buf == 0) { return RG_ERR_NONE; }
    var slots = load64(p);
    var max = load64(p + 16);
    var i = 0;
    while (i < max) {
        if (load64(slots + i * 8) == 0) {
            store64(slots + i * 8, buf);
            store64(p + 8, load64(p + 8) + 1);
            return RG_ERR_NONE;
        }
        i = i + 1;
    }
    bv_free(buf);
    return RG_ERR_NONE;
}

fn buffer_pool_clear(p) {
    var slots = load64(p);
    var max = load64(p + 16);
    var i = 0;
    while (i < max) {
        var h = load64(slots + i * 8);
        if (h != 0) { bv_free(h); store64(slots + i * 8, 0); }
        i = i + 1;
    }
    store64(p + 8, 0);
    return RG_ERR_NONE;
}

fn buffer_pool_free(p) {
    if (p == 0) { return RG_ERR_NONE; }
    buffer_pool_clear(p);
    var slots = load64(p);
    if (slots != 0) { fl_free(slots); }
    fl_free(p);
    return RG_ERR_NONE;
}

# --- color.cyr ---

# color.cyr -- colour spaces and conversions
# Ported from rust-old/src/color.rs (1423 lines).
#
# STRUCT LAYOUT. Following the pattern settled in pixel.cyr: raw byte offsets
# with width-correct accessors, because Cyrius struct fields have no f32, f64,
# or u8 type and `#derive(accessors)` would emit load64/store64 for all of them.
# See cyrius-port-plan.md §2.
#
#   Srgba   4 bytes    +0 r  +1 g  +2 b  +3 a          (u8 each, load8/store8)
#   LinRgba 16 bytes   +0 r  +4 g  +8 b  +12 a         (f32 bits, load32/store32)
#   CieXyz  24 bytes   +0 x  +8 y  +16 z               (f64 bits, load64/store64)
#   CieLab  24 bytes   +0 l  +8 a  +16 b               (f64 bits)
#
# PRECISION. Rust carries LinRgba as f32 and XYZ/Lab as f64, and this port keeps
# that split exactly rather than promoting everything to f64 — the sRGB matrices
# and the Lab transfer are f64 in the original, and widening the f32 side would
# move results that the ported Delta-E assertions pin.
#
# FLOAT LITERALS. Cyrius lexes a decimal with a fractional part as an f64, and
# for the 7-8 significant digits the sRGB/P3 matrices and Lab thresholds need
# that is exact and far more readable than a bit pattern.
#
# ⚠ It is NOT safe past ~9 significant digits. Measured on 6.5.27, the lexer is
# exact through `3.14159265`, then goes silently wrong: `3.1415926535` parses as
# 0.95822 and `3.141592653589793` as 0.061575, with no diagnostic. The Oklab
# coefficients carry 10-11 digits and are therefore written as hex bit patterns
# with the decimal in a trailing comment — see `_OK_M1_*` below. This is also
# why the stdlib spells its own constants that way (`F64_PI`). Filed upstream as
# cyrius/docs/development/issues/2026-08-17-decimal-float-literal-silent-precision-loss.md

# ── ColorSpace ────────
var CS_SRGB       = 0;
var CS_LINEAR_RGB = 1;
var CS_DISPLAY_P3 = 2;
var CS_BT2020     = 3;
var CS_CIE_XYZ    = 4;
var CS_CIE_LAB    = 5;
var CS_OKLAB      = 6;

#must_use
fn color_space_name(s) {
    if (s == CS_SRGB) { return "sRGB"; }
    if (s == CS_LINEAR_RGB) { return "Linear RGB"; }
    if (s == CS_DISPLAY_P3) { return "Display P3"; }
    if (s == CS_BT2020) { return "BT.2020"; }
    if (s == CS_CIE_XYZ) { return "CIE XYZ"; }
    if (s == CS_CIE_LAB) { return "CIE L*a*b*"; }
    if (s == CS_OKLAB) { return "Oklab"; }
    return "unknown";
}

# ── Srgba (4 x u8) ────────
var _SRGBA_SIZE = 4;

#must_use
fn srgba_new(r, g, b, a) {
    var c = fl_alloc(_SRGBA_SIZE);
    if (c == 0) { return 0; }
    store8(c, r & 255);
    store8(c + 1, g & 255);
    store8(c + 2, b & 255);
    store8(c + 3, a & 255);
    return c;
}

#must_use
fn srgba_r(c) { return load8(c); }
#must_use
fn srgba_g(c) { return load8(c + 1); }
#must_use
fn srgba_b(c) { return load8(c + 2); }
#must_use
fn srgba_a(c) { return load8(c + 3); }

fn srgba_set(c, r, g, b, a) {
    store8(c, r & 255);
    store8(c + 1, g & 255);
    store8(c + 2, b & 255);
    store8(c + 3, a & 255);
    return RG_ERR_NONE;
}

fn srgba_free(c) { if (c != 0) { fl_free(c); } return RG_ERR_NONE; }

# ── LinRgba (4 x f32) ────────
var _LINRGBA_SIZE = 16;

# Takes and returns f32 BIT PATTERNS, matching the f32_from / f32_to convention.
#must_use
fn lin_rgba_new(r, g, b, a) {
    var c = fl_alloc(_LINRGBA_SIZE);
    if (c == 0) { return 0; }
    store32(c, r);
    store32(c + 4, g);
    store32(c + 8, b);
    store32(c + 12, a);
    return c;
}

#must_use
fn lin_rgba_r(c) { return load32(c); }
#must_use
fn lin_rgba_g(c) { return load32(c + 4); }
#must_use
fn lin_rgba_b(c) { return load32(c + 8); }
#must_use
fn lin_rgba_a(c) { return load32(c + 12); }

fn lin_rgba_free(c) { if (c != 0) { fl_free(c); } return RG_ERR_NONE; }

# ── CieXyz (3 x f64) ────────
var _CIEXYZ_SIZE = 24;

#must_use
fn cie_xyz_new(x, y, z) {
    var c = fl_alloc(_CIEXYZ_SIZE);
    if (c == 0) { return 0; }
    store64(c, x);
    store64(c + 8, y);
    store64(c + 16, z);
    return c;
}

#must_use
fn cie_xyz_x(c) { return load64(c); }
#must_use
fn cie_xyz_y(c) { return load64(c + 8); }
#must_use
fn cie_xyz_z(c) { return load64(c + 16); }
fn cie_xyz_free(c) { if (c != 0) { fl_free(c); } return RG_ERR_NONE; }

# Rust's CieXyz::D65_WHITE / D50_WHITE associated consts. Functions rather than
# globals because each call hands back a fresh heap record the caller owns.
#must_use
fn cie_xyz_d65_white() { return cie_xyz_new(0.95047, 1.00000, 1.08883); }
#must_use
fn cie_xyz_d50_white() { return cie_xyz_new(0.96422, 1.00000, 0.82521); }

# ── CieLab (3 x f64) ────────
var _CIELAB_SIZE = 24;

#must_use
fn cie_lab_new(l, a, b) {
    var c = fl_alloc(_CIELAB_SIZE);
    if (c == 0) { return 0; }
    store64(c, l);
    store64(c + 8, a);
    store64(c + 16, b);
    return c;
}

#must_use
fn cie_lab_l(c) { return load64(c); }
#must_use
fn cie_lab_a(c) { return load64(c + 8); }
#must_use
fn cie_lab_b(c) { return load64(c + 16); }
fn cie_lab_free(c) { if (c != 0) { fl_free(c); } return RG_ERR_NONE; }

# ── sRGB transfer function ────────
# The piecewise sRGB EOTF. Rust takes u8 and returns f32; this takes an integer
# 0-255 and returns an f32 bit pattern.
#
# The f32 result is computed in f64 and narrowed once at the end. That is not a
# shortcut: there is no f64 pow available at f32 width, and rounding at every
# intermediate would drift from the Rust original, which also evaluates
# `((s + 0.055) / 1.055).powf(2.4)` at full width before storing to f32.
#must_use
fn srgb_to_linear(c) {
    var s = f64_div(f64_from(c & 255), 255.0);
    # `<=`, matching Rust's `if s <= 0.04045`. f64_le is stdlib (lib/math.cyr:437);
    # spelling it as a separate f64_lt then f64_eq works but evaluates twice.
    if (f64_le(s, 0.04045) == 1) {
        return f32_from(f64_div(s, 12.92));
    }
    return f32_from(_rg_pow(f64_div(f64_add(s, 0.055), 1.055), 2.4));
}

# Inverse sRGB transfer. Takes an f32 bit pattern, returns an integer 0-255.
#
# The +0.5 before the clamp is round-half-up, matching Rust's
# `(s * 255.0 + 0.5).clamp(0.0, 255.0) as u8` — `as u8` truncates, so the
# explicit +0.5 is what makes it round rather than floor. Dropping it darkens
# every channel by up to one level.
#must_use
fn linear_to_srgb(c) {
    var v = f32_to(c);
    var s = 0;
    if (f64_le(v, 0.0031308) == 1) {
        s = f64_mul(v, 12.92);
    }
    if (f64_le(v, 0.0031308) == 0) {
        var third = f64_div(F64_ONE, 2.4);
        s = f64_sub(f64_mul(1.055, _rg_pow(v, third)), 0.055);
    }
    var scaled = f64_add(f64_mul(s, 255.0), 0.5);
    if (f64_lt(scaled, 0) == 1) { return 0; }
    if (f64_gt(scaled, 255.0) == 1) { return 255; }
    return f64_to(scaled);
}

# ── Srgba <-> LinRgba ────────
#must_use
fn srgba_to_lin_rgba(c) {
    return lin_rgba_new(srgb_to_linear(load8(c)),
                        srgb_to_linear(load8(c + 1)),
                        srgb_to_linear(load8(c + 2)),
                        f32_from(f64_div(f64_from(load8(c + 3)), 255.0)));
}

#must_use
fn lin_rgba_to_srgba(c) {
    # Alpha is linear, not gamma-encoded — it goes through the plain scale,
    # not linear_to_srgb. Running alpha through the transfer function is a
    # classic compositing bug; the Rust original is explicit about it.
    var av = f64_add(f64_mul(f32_to(load32(c + 12)), 255.0), 0.5);
    var a = 0;
    if (f64_gt(av, 255.0) == 1) { a = 255; }
    if (f64_gt(av, 255.0) == 0) {
        if (f64_lt(av, 0) == 1) { a = 0; }
        if (f64_lt(av, 0) == 0) { a = f64_to(av); }
    }
    return srgba_new(linear_to_srgb(load32(c)),
                     linear_to_srgb(load32(c + 4)),
                     linear_to_srgb(load32(c + 8)),
                     a);
}

# ── LinRgba <-> CieXyz (sRGB D65 primaries) ────────
# SRGB_TO_XYZ / XYZ_TO_SRGB from rust-old/src/color.rs:451,458.

# One row of a 3x3 matrix times a colour vector. Every colour-space matrix in
# this file is three of these, and spelling the nested f64_add/f64_mul out at
# each site runs past the 120-column lint and buries which coefficient is which.
#must_use
fn _rg_dot3(m0, m1, m2, x, y, z) {
    return f64_add(f64_add(f64_mul(m0, x), f64_mul(m1, y)), f64_mul(m2, z));
}

#must_use
fn lin_rgba_to_cie_xyz(c) {
    var r = f32_to(load32(c));
    var g = f32_to(load32(c + 4));
    var b = f32_to(load32(c + 8));
    return cie_xyz_new(_rg_dot3(0.4124564, 0.3575761, 0.1804375, r, g, b),
                       _rg_dot3(0.2126729, 0.7151522, 0.0721750, r, g, b),
                       _rg_dot3(0.0193339, 0.1191920, 0.9503041, r, g, b));
}

# Alpha is set to 1.0 (fully opaque) — CieXyz carries no alpha.
#must_use
fn cie_xyz_to_lin_rgba(c) {
    var x = load64(c);
    var y = load64(c + 8);
    var z = load64(c + 16);
    var r = _rg_dot3(3.2404542, f64_neg(1.5371385), f64_neg(0.4985314), x, y, z);
    var g = _rg_dot3(f64_neg(0.9692660), 1.8760108, 0.0415560, x, y, z);
    var b = _rg_dot3(0.0556434, f64_neg(0.2040259), 1.0572252, x, y, z);
    return lin_rgba_new(f32_from(r), f32_from(g), f32_from(b), f32_from(F64_ONE));
}

# ── CieXyz <-> CieLab (D65) ────────
var _LAB_EPSILON = 0.008856;   # (6/29)^3
var _LAB_KAPPA   = 903.3;      # (29/3)^3
var _D65_XN      = 0.95047;
var _D65_YN      = 1.00000;
var _D65_ZN      = 1.08883;

#must_use
fn _lab_f(t) {
    if (f64_gt(t, _LAB_EPSILON) == 1) { return _rg_cbrt(t); }
    return f64_div(f64_add(f64_mul(_LAB_KAPPA, t), 16.0), 116.0);
}

#must_use
fn _lab_f_inv(t) {
    var lim = f64_div(f64_from(6), f64_from(29));
    if (f64_gt(t, lim) == 1) { return f64_mul(f64_mul(t, t), t); }
    var four29 = f64_div(f64_from(4), f64_from(29));
    return f64_mul(f64_mul(f64_mul(3.0, lim), lim), f64_sub(t, four29));
}

#must_use
fn cie_xyz_to_cie_lab(c) {
    var fx = _lab_f(f64_div(load64(c), _D65_XN));
    var fy = _lab_f(f64_div(load64(c + 8), _D65_YN));
    var fz = _lab_f(f64_div(load64(c + 16), _D65_ZN));
    return cie_lab_new(f64_sub(f64_mul(116.0, fy), 16.0),
                       f64_mul(500.0, f64_sub(fx, fy)),
                       f64_mul(200.0, f64_sub(fy, fz)));
}

#must_use
fn cie_lab_to_cie_xyz(c) {
    var fy = f64_div(f64_add(load64(c), 16.0), 116.0);
    var fx = f64_add(f64_div(load64(c + 8), 500.0), fy);
    var fz = f64_sub(fy, f64_div(load64(c + 16), 200.0));
    return cie_xyz_new(f64_mul(_D65_XN, _lab_f_inv(fx)),
                       f64_mul(_D65_YN, _lab_f_inv(fy)),
                       f64_mul(_D65_ZN, _lab_f_inv(fz)));
}

# Convenience: sRGB byte -> Lab in one step. Frees the two intermediates.
#must_use
fn srgba_to_cie_lab(c) {
    var lin = srgba_to_lin_rgba(c);
    if (lin == 0) { return 0; }
    var xyz = lin_rgba_to_cie_xyz(lin);
    lin_rgba_free(lin);
    if (xyz == 0) { return 0; }
    var lab = cie_xyz_to_cie_lab(xyz);
    cie_xyz_free(xyz);
    return lab;
}

# ── Hsl (3 x f32) ────────
var _HSL_SIZE = 12;

#must_use
fn hsl_new(h, s, l) {
    var c = fl_alloc(_HSL_SIZE);
    if (c == 0) { return 0; }
    store32(c, h);
    store32(c + 4, s);
    store32(c + 8, l);
    return c;
}

#must_use
fn hsl_h(c) { return load32(c); }
#must_use
fn hsl_s(c) { return load32(c + 4); }
#must_use
fn hsl_l(c) { return load32(c + 8); }
fn hsl_free(c) { if (c != 0) { fl_free(c); } return RG_ERR_NONE; }

var _RG_EPS6 = 0.000001;   # 1e-6, the achromatic threshold Rust uses

#must_use
fn srgba_to_hsl(c) {
    var r = f64_div(f64_from(load8(c)), 255.0);
    var g = f64_div(f64_from(load8(c + 1)), 255.0);
    var b = f64_div(f64_from(load8(c + 2)), 255.0);

    var max = f64_max(f64_max(r, g), b);
    var min = f64_min(f64_min(r, g), b);
    var d = f64_sub(max, min);
    var l = f64_div(f64_add(max, min), 2.0);

    # Achromatic: hue is undefined, so Rust pins it to 0 rather than dividing
    # by a zero delta.
    if (f64_lt(d, _RG_EPS6) == 1) {
        return hsl_new(f32_from(0), f32_from(0), f32_from(l));
    }

    var s = 0;
    if (f64_gt(l, 0.5) == 1) {
        s = f64_div(d, f64_sub(f64_sub(2.0, max), min));
    }
    if (f64_gt(l, 0.5) == 0) {
        s = f64_div(d, f64_add(max, min));
    }

    var h = 0;
    if (f64_lt(f64_abs(f64_sub(max, r)), _RG_EPS6) == 1) {
        h = f64_div(f64_sub(g, b), d);
        # The +6 wrap keeps hue positive when g < b; without it the red sector
        # comes out negative and *60 lands outside [0, 360).
        if (f64_lt(g, b) == 1) { h = f64_add(h, 6.0); }
    }
    if (f64_lt(f64_abs(f64_sub(max, r)), _RG_EPS6) == 0) {
        if (f64_lt(f64_abs(f64_sub(max, g)), _RG_EPS6) == 1) {
            h = f64_add(f64_div(f64_sub(b, r), d), 2.0);
        }
        if (f64_lt(f64_abs(f64_sub(max, g)), _RG_EPS6) == 0) {
            h = f64_add(f64_div(f64_sub(r, g), d), 4.0);
        }
    }
    return hsl_new(f32_from(f64_mul(h, 60.0)), f32_from(s), f32_from(l));
}

#must_use
fn _hue_to_rgb(p, q, t) {
    var u = t;
    if (f64_lt(u, 0) == 1) { u = f64_add(u, F64_ONE); }
    if (f64_gt(u, F64_ONE) == 1) { u = f64_sub(u, F64_ONE); }
    var sixth = f64_div(F64_ONE, f64_from(6));
    var twothirds = f64_div(f64_from(2), f64_from(3));
    if (f64_lt(u, sixth) == 1) {
        return f64_add(p, f64_mul(f64_mul(f64_sub(q, p), 6.0), u));
    }
    if (f64_lt(u, 0.5) == 1) { return q; }
    if (f64_lt(u, twothirds) == 1) {
        return f64_add(p, f64_mul(f64_mul(f64_sub(q, p), f64_sub(twothirds, u)), 6.0));
    }
    return p;
}

# Round-half-up then clamp to a byte — the same shape as linear_to_srgb.
#must_use
fn _f64_to_u8_round(v) {
    var scaled = f64_add(f64_mul(v, 255.0), 0.5);
    if (f64_lt(scaled, 0) == 1) { return 0; }
    if (f64_gt(scaled, 255.0) == 1) { return 255; }
    return f64_to(scaled);
}

#must_use
fn hsl_to_srgba(c) {
    var h = f32_to(load32(c));
    var s = f32_to(load32(c + 4));
    var l = f32_to(load32(c + 8));

    # Zero saturation is grey; the hue term would otherwise divide meaninglessly.
    if (f64_lt(s, _RG_EPS6) == 1) {
        var v = _f64_to_u8_round(l);
        return srgba_new(v, v, v, 255);
    }
    var q = 0;
    if (f64_lt(l, 0.5) == 1) {
        q = f64_mul(l, f64_add(F64_ONE, s));
    }
    if (f64_lt(l, 0.5) == 0) {
        q = f64_sub(f64_add(l, s), f64_mul(l, s));
    }
    var p = f64_sub(f64_mul(2.0, l), q);
    var hn = f64_div(h, 360.0);
    var third = f64_div(F64_ONE, f64_from(3));
    return srgba_new(_f64_to_u8_round(_hue_to_rgb(p, q, f64_add(hn, third))),
                     _f64_to_u8_round(_hue_to_rgb(p, q, hn)),
                     _f64_to_u8_round(_hue_to_rgb(p, q, f64_sub(hn, third))),
                     255);
}

# ── Cmyk (4 x f32) ────────
var _CMYK_SIZE = 16;

#must_use
fn cmyk_new(c, m, y, k) {
    var v = fl_alloc(_CMYK_SIZE);
    if (v == 0) { return 0; }
    store32(v, c);
    store32(v + 4, m);
    store32(v + 8, y);
    store32(v + 12, k);
    return v;
}

#must_use
fn cmyk_c(v) { return load32(v); }
#must_use
fn cmyk_m(v) { return load32(v + 4); }
#must_use
fn cmyk_y(v) { return load32(v + 8); }
#must_use
fn cmyk_k(v) { return load32(v + 12); }
fn cmyk_free(v) { if (v != 0) { fl_free(v); } return RG_ERR_NONE; }

# Naive CMYK, no ICC profile — for print-accurate conversion use icc.cyr.
#must_use
fn cmyk_to_srgba(v) {
    var k = f32_to(load32(v + 12));
    var ik = f64_sub(F64_ONE, k);
    return srgba_new(_f64_to_u8_round(f64_mul(f64_sub(F64_ONE, f32_to(load32(v))), ik)),
                     _f64_to_u8_round(f64_mul(f64_sub(F64_ONE, f32_to(load32(v + 4))), ik)),
                     _f64_to_u8_round(f64_mul(f64_sub(F64_ONE, f32_to(load32(v + 8))), ik)),
                     255);
}

#must_use
fn srgba_to_cmyk(c) {
    var r = f64_div(f64_from(load8(c)), 255.0);
    var g = f64_div(f64_from(load8(c + 1)), 255.0);
    var b = f64_div(f64_from(load8(c + 2)), 255.0);
    var k = f64_sub(F64_ONE, f64_max(f64_max(r, g), b));
    # Pure black: every chromatic channel is undefined (inv_k would divide by
    # zero), so Rust returns 0,0,0,1 outright.
    if (f64_ge(k, f64_sub(F64_ONE, _RG_EPS6)) == 1) {
        return cmyk_new(f32_from(0), f32_from(0), f32_from(0), f32_from(F64_ONE));
    }
    var inv_k = f64_div(F64_ONE, f64_sub(F64_ONE, k));
    return cmyk_new(f32_from(f64_mul(f64_sub(f64_sub(F64_ONE, r), k), inv_k)),
                    f32_from(f64_mul(f64_sub(f64_sub(F64_ONE, g), k), inv_k)),
                    f32_from(f64_mul(f64_sub(f64_sub(F64_ONE, b), k), inv_k)),
                    f32_from(k));
}

# ── Display P3 ────────
# P3_TO_SRGB / SRGB_TO_P3 from rust-old/src/color.rs:564,571. Both take and
# return f64 triples through out-pointers, since Cyrius has no tuple return.
fn p3_to_linear_srgb(r, g, b, out) {
    store64(out, _rg_dot3(1.2249401, f64_neg(0.2249402), 0.0000001, r, g, b));
    store64(out + 8, _rg_dot3(f64_neg(0.0420569), 1.0420571, f64_neg(0.0000002), r, g, b));
    store64(out + 16, _rg_dot3(f64_neg(0.0196376), f64_neg(0.0786361), 1.0982735, r, g, b));
    return RG_ERR_NONE;
}

fn linear_srgb_to_p3(r, g, b, out) {
    store64(out, _rg_dot3(0.8224622, 0.1775380, f64_neg(0.0000002), r, g, b));
    store64(out + 8, _rg_dot3(0.0331942, 0.9668058, 0, r, g, b));
    store64(out + 16, _rg_dot3(0.0170608, 0.0723740, 0.9105650, r, g, b));
    return RG_ERR_NONE;
}

# ── Oklab / Oklch (Björn Ottosson, 2020) ────────
# Rust computes these in f32 throughout, so this does too — the M1/M2 matrices
# are f32 literals there. Widening to f64 would move results the ported
# assertions pin.
var _OKLAB_SIZE = 12;

#must_use
fn oklab_new(l, a, b) {
    var c = fl_alloc(_OKLAB_SIZE);
    if (c == 0) { return 0; }
    store32(c, l);
    store32(c + 4, a);
    store32(c + 8, b);
    return c;
}

#must_use
fn oklab_l(c) { return load32(c); }
#must_use
fn oklab_a(c) { return load32(c + 4); }
#must_use
fn oklab_b(c) { return load32(c + 8); }
fn oklab_free(c) { if (c != 0) { fl_free(c); } return RG_ERR_NONE; }

var _OKLCH_SIZE = 12;

#must_use
fn oklch_new(l, c, h) {
    var v = fl_alloc(_OKLCH_SIZE);
    if (v == 0) { return 0; }
    store32(v, l);
    store32(v + 4, c);
    store32(v + 8, h);
    return v;
}

#must_use
fn oklch_l(v) { return load32(v); }
#must_use
fn oklch_c(v) { return load32(v + 4); }
#must_use
fn oklch_h(v) { return load32(v + 8); }
fn oklch_free(v) { if (v != 0) { fl_free(v); } return RG_ERR_NONE; }

# One row of a 3x3 matrix, in SINGLE precision.
#
# ⚠ The `: f32` annotations on the parameters are load-bearing, not
# documentation. Cyrius dispatches f32 arithmetic through EMIT_F32_BINOP only
# when the operand carries F32_TYID, which it gets from a typed binding or a
# typed parameter. Written inline as `f32_from(0.41) * r`, the left operand is a
# CALL RESULT — untyped — and the `*` silently becomes an INTEGER multiply of
# the two bit patterns. It compiles clean, lints clean, and returns garbage:
# measured `f32_from(3.0) * r` where r = 2.0 yields 0, not 6. Routing every
# f32 matrix row through this typed helper is what makes the Oklab matrices
# actually single-precision. See port-mechanics.md §3.
#must_use
fn _rg_f32_dot3(m0: f32, m1: f32, m2: f32, x: f32, y: f32, z: f32) {
    return m0 * x + m1 * y + m2 * z;
}

# Ottosson's M1/M2 matrices, as f64 BIT PATTERNS.
#
# ⚠ These must NOT be written as decimal literals. The Cyrius lexer is exact to
# about 9 significant digits and goes SILENTLY WRONG beyond ~11 — measured on
# 6.5.27, `3.1415926535` parses as 0.95822 and `3.141592653589793` as 0.061575,
# with no diagnostic. Every Ottosson coefficient carries 10-11 digits, which is
# squarely in that range: written as decimals they produced an Oklab lightness
# of 6.447 for linear white instead of 1.0. This is why the stdlib itself spells
# its constants in hex (`F64_PI = 0x4009_21FB_5444_2D18`).
#
# Decimal is fine for the 7-8 digit constants elsewhere in this file (the sRGB
# and P3 matrices, the Lab thresholds) and much more readable there.
var _OK_M1_00 = 0x3FDA61D629F2E197;   # 0.4122214708
var _OK_M1_01 = 0x3FE129A2D9E60E32;   # 0.5363325363
var _OK_M1_02 = 0x3FAA572112081026;   # 0.0514459929
var _OK_M1_10 = 0x3FCB1FA76156A7C5;   # 0.2119034982
var _OK_M1_11 = 0x3FE5C84A69936914;   # 0.6806995451
var _OK_M1_12 = 0x3FBB7E5DF0497455;   # 0.1073969566
var _OK_M1_20 = 0x3FB69AFD7A044C17;   # 0.0883024619
var _OK_M1_21 = 0x3FD207AE728A2F45;   # 0.2817188376
var _OK_M1_22 = 0x3FE428C9177A5EDB;   # 0.6299787005

var _OK_M2_00 = 0x3FCAF02A3FE8A4FA;   # 0.2104542553
var _OK_M2_01 = 0x3FE9655120032AAD;   # 0.7936177850
var _OK_M2_02 = 0x3F70ADD9BD572B38;   # 0.0040720468
var _OK_M2_10 = 0x3FFFA5E1BFFFDE12;   # 1.9779984951
var _OK_M2_11 = 0x40036DC1BFFE5D3E;   # 2.4285922050
var _OK_M2_12 = 0x3FDCD686FFF371A5;   # 0.4505937099
var _OK_M2_20 = 0x3F9A869680B729E0;   # 0.0259040371
var _OK_M2_21 = 0x3FE90C776001F502;   # 0.7827717662
var _OK_M2_22 = 0x3FE9E0AC0001353D;   # 0.8086757660

# M1: linear sRGB -> LMS, cube root, M2: LMS' -> Oklab.
#must_use
fn lin_rgba_to_oklab(c) {
    var r = load32(c);
    var g = load32(c + 4);
    var b = load32(c + 8);

    var l = _rg_f32_dot3(f32_from(_OK_M1_00), f32_from(_OK_M1_01), f32_from(_OK_M1_02), r, g, b);
    var m = _rg_f32_dot3(f32_from(_OK_M1_10), f32_from(_OK_M1_11), f32_from(_OK_M1_12), r, g, b);
    var s = _rg_f32_dot3(f32_from(_OK_M1_20), f32_from(_OK_M1_21), f32_from(_OK_M1_22), r, g, b);

    var lc = ganita_f32_cbrt(l);
    var mc = ganita_f32_cbrt(m);
    var sc = ganita_f32_cbrt(s);

    var ol = _rg_f32_dot3(f32_from(_OK_M2_00), f32_from(_OK_M2_01), f32_from(f64_neg(_OK_M2_02)), lc, mc, sc);
    var oa = _rg_f32_dot3(f32_from(_OK_M2_10), f32_from(f64_neg(_OK_M2_11)), f32_from(_OK_M2_12), lc, mc, sc);
    var ob = _rg_f32_dot3(f32_from(_OK_M2_20), f32_from(_OK_M2_21), f32_from(f64_neg(_OK_M2_22)), lc, mc, sc);
    return oklab_new(ol, oa, ob);
}

# Cube a single-precision value. Same typed-parameter requirement as the dot
# product above — `lc * lc * lc` on an untyped local is an integer multiply.
#must_use
fn _rg_f32_cube(x: f32) {
    return x * x * x;
}

# Inverse matrices, same hex-bit-pattern requirement as M1/M2 above.
var _OK_I2_01 = 0x3FD95D9920068C8A;   # 0.3963377774
var _OK_I2_02 = 0x3FCB9F751FFA8CC8;   # 0.2158037573
var _OK_I2_11 = 0x3FBB06117FEEC881;   # 0.1055613458
var _OK_I2_12 = 0x3FB058BF3FE39E34;   # 0.0638541728
var _OK_I2_21 = 0x3FB6E86F5FDF38B5;   # 0.0894841775
var _OK_I2_22 = 0x3FF4A9ECBFFEAA8D;   # 1.2914855480

var _OK_I1_00 = 0x40104E955DC3D73A;   # 4.0767416621
var _OK_I1_01 = 0x400A76317EA9DE73;   # 3.3077115913
var _OK_I1_02 = 0x3FCD906C3222FFEF;   # 0.2309699292
var _OK_I1_10 = 0x3FF44B85A62C2AFF;   # 1.2684380046
var _OK_I1_11 = 0x4004E0C87D01BF65;   # 2.6097574011
var _OK_I1_12 = 0x3FD5D82D4F5D4F2A;   # 0.3413193965
var _OK_I1_20 = 0x3F712FEA56E00671;   # 0.0041960863
var _OK_I1_21 = 0x3FE68267C131178D;   # 0.7034186147
var _OK_I1_22 = 0x3FFB5263CAEF6BCD;   # 1.7076147010

# Inverse M2, cube to recover LMS, inverse M1. Alpha is opaque — Oklab carries none.
#must_use
fn oklab_to_lin_rgba(c) {
    var ol = load32(c);
    var oa = load32(c + 4);
    var ob = load32(c + 8);

    var lc = _rg_f32_dot3(f32_from(F64_ONE), f32_from(_OK_I2_01), f32_from(_OK_I2_02), ol, oa, ob);
    var mc = _rg_f32_dot3(f32_from(F64_ONE), f32_from(f64_neg(_OK_I2_11)), f32_from(f64_neg(_OK_I2_12)), ol, oa, ob);
    var sc = _rg_f32_dot3(f32_from(F64_ONE), f32_from(f64_neg(_OK_I2_21)), f32_from(f64_neg(_OK_I2_22)), ol, oa, ob);

    var l = _rg_f32_cube(lc);
    var m = _rg_f32_cube(mc);
    var s = _rg_f32_cube(sc);

    var r = _rg_f32_dot3(f32_from(_OK_I1_00), f32_from(f64_neg(_OK_I1_01)), f32_from(_OK_I1_02), l, m, s);
    var g = _rg_f32_dot3(f32_from(f64_neg(_OK_I1_10)), f32_from(_OK_I1_11), f32_from(f64_neg(_OK_I1_12)), l, m, s);
    var b = _rg_f32_dot3(f32_from(f64_neg(_OK_I1_20)), f32_from(f64_neg(_OK_I1_21)), f32_from(_OK_I1_22), l, m, s);
    return lin_rgba_new(r, g, b, f32_from(F64_ONE));
}

# Euclidean modulo — Rust's rem_euclid, which unlike `%` always returns a
# non-negative result. Hue angles from atan2 are in (-180, 180]; without this
# the negative half stays negative instead of wrapping into [0, 360).
#must_use
fn _rg_rem_euclid(a, m) {
    var r = f64_sub(a, f64_mul(m, f64_floor(f64_div(a, m))));
    if (f64_lt(r, 0) == 1) { return f64_add(r, m); }
    return r;
}

# F64_PI from lib/math.cyr — a 16-digit decimal literal parses as 0.061575.
var _RG_PI = F64_PI;

#must_use
fn _rg_to_degrees(rad) { return f64_div(f64_mul(rad, 180.0), _RG_PI); }
#must_use
fn _rg_to_radians(deg) { return f64_div(f64_mul(deg, _RG_PI), 180.0); }

# Polar form. Chroma is |(a, b)|; hue is its angle in degrees, wrapped.
#must_use
fn oklab_to_oklch(c) {
    var a = f32_to(load32(c + 4));
    var b = f32_to(load32(c + 8));
    var chroma = f64_sqrt(f64_add(f64_mul(a, a), f64_mul(b, b)));
    var hue = 0;
    # Below the threshold the colour is achromatic and atan2(0, 0) is
    # meaningless, so hue is pinned to 0 rather than left to the libm.
    if (f64_ge(chroma, 0.00000001) == 1) {
        hue = _rg_rem_euclid(_rg_to_degrees(ganita_f64_atan2(b, a)), 360.0);
    }
    return oklch_new(load32(c), f32_from(chroma), f32_from(hue));
}

#must_use
fn oklch_to_oklab(v) {
    var h = _rg_to_radians(f32_to(load32(v + 8)));
    var chroma = f32_to(load32(v + 4));
    return oklab_new(load32(v),
                     f32_from(f64_mul(chroma, _rg_cos(h))),
                     f32_from(f64_mul(chroma, _rg_sin(h))));
}

# Convenience: sRGB byte -> Oklab, through LinRgba.
#must_use
fn srgba_to_oklab(c) {
    var lin = srgba_to_lin_rgba(c);
    if (lin == 0) { return 0; }
    var lab = lin_rgba_to_oklab(lin);
    lin_rgba_free(lin);
    return lab;
}

# ── Colour temperature ────────
# Tanner Helland's blackbody approximation. Writes 3 f32 bit patterns to `out`.
#
# NaN in gives neutral white out rather than propagating: 1.0.0 fixed this,
# where a NaN kelvin previously survived the clamp and poisoned every channel.
fn color_temperature(kelvin, out) {
    var k = f32_to(kelvin);
    # NaN is the one value not equal to itself.
    if (f64_eq(k, k) == 0) {
        store32(out, f32_from(F64_ONE));
        store32(out + 4, f32_from(F64_ONE));
        store32(out + 8, f32_from(F64_ONE));
        return RG_ERR_NONE;
    }
    var temp = f64_div(f64_clamp(k, 1000.0, 40000.0), 100.0);

    var r = F64_ONE;
    if (f64_gt(temp, 66.0) == 1) {
        r = f64_clamp(f64_div(f64_mul(329.699, _rg_pow(f64_sub(temp, 60.0), f64_neg(0.133205))), 255.0), 0, F64_ONE);
    }

    var g = 0;
    if (f64_le(temp, 66.0) == 1) {
        g = f64_clamp(f64_div(f64_sub(f64_mul(99.4708, f64_ln(temp)), 161.1196), 255.0), 0, F64_ONE);
    }
    if (f64_le(temp, 66.0) == 0) {
        g = f64_clamp(f64_div(f64_mul(288.1222, _rg_pow(f64_sub(temp, 60.0), f64_neg(0.075515))), 255.0), 0, F64_ONE);
    }

    var b = 0;
    if (f64_ge(temp, 66.0) == 1) { b = F64_ONE; }
    if (f64_ge(temp, 66.0) == 0) {
        if (f64_le(temp, 19.0) == 0) {
            var bl = f64_sub(f64_mul(138.5177, f64_ln(f64_sub(temp, 10.0))), 305.0448);
            b = f64_clamp(f64_div(bl, 255.0), 0, F64_ONE);
        }
    }

    store32(out, f32_from(r));
    store32(out + 4, f32_from(g));
    store32(out + 8, f32_from(b));
    return RG_ERR_NONE;
}

# ── Delta-E ────────
# CIE76: plain Euclidean distance in Lab.
#must_use
fn delta_e_cie76(a, b) {
    var dl = f64_sub(load64(a), load64(b));
    var da = f64_sub(load64(a + 8), load64(b + 8));
    var db = f64_sub(load64(a + 16), load64(b + 16));
    var sum = f64_add(f64_add(f64_mul(dl, dl), f64_mul(da, da)), f64_mul(db, db));
    return f64_sqrt(sum);
}

# CIE94, graphic-arts weighting.
#must_use
fn delta_e_cie94(a, b) {
    var dl = f64_sub(load64(a), load64(b));
    var da = f64_sub(load64(a + 8), load64(b + 8));
    var db = f64_sub(load64(a + 16), load64(b + 16));
    var c1 = f64_sqrt(f64_add(f64_mul(load64(a + 8), load64(a + 8)), f64_mul(load64(a + 16), load64(a + 16))));
    var c2 = f64_sqrt(f64_add(f64_mul(load64(b + 8), load64(b + 8)), f64_mul(load64(b + 16), load64(b + 16))));
    var dc = f64_sub(c1, c2);
    # dh^2 is a difference of squares that is mathematically non-negative but
    # can go slightly negative through rounding; sqrt of that is NaN, so Rust
    # clamps at 0 and this must too.
    var dh_sq = f64_max(f64_sub(f64_sub(f64_add(f64_mul(da, da), f64_mul(db, db)), f64_mul(dc, dc)), 0), 0);

    var sl = F64_ONE;
    var sc = f64_add(F64_ONE, f64_mul(0.045, c1));
    var sh = f64_add(F64_ONE, f64_mul(0.015, c1));

    var tl = f64_div(dl, sl);
    var tc = f64_div(dc, sc);
    return f64_sqrt(f64_add(f64_add(f64_mul(tl, tl), f64_mul(tc, tc)), f64_div(dh_sq, f64_mul(sh, sh))));
}

# x^7 by repeated multiplication rather than pow. Integer exponents through
# exp(7*ln x) lose precision and hit the zero-base edge case; c_bar is 0 for a
# pair of neutral greys, which is an ordinary input here.
#must_use
fn _rg_pow7(x) {
    var x2 = f64_mul(x, x);
    var x4 = f64_mul(x2, x2);
    return f64_mul(f64_mul(x4, x2), x);
}

# CIEDE2000 — the full Sharma et al. (2005) formulation.
# 25^7. f64_from(int) is exact below 2^53; the decimal form is 10 digits and
# sits in the range where the lexer starts losing precision.
var _RG_25_POW7 = f64_from(6103515625);

#must_use
fn delta_e_ciede2000(lab1, lab2) {
    var l1 = load64(lab1);
    var a1 = load64(lab1 + 8);
    var b1 = load64(lab1 + 16);
    var l2 = load64(lab2);
    var a2 = load64(lab2 + 8);
    var b2 = load64(lab2 + 16);

    var c1_star = f64_sqrt(f64_add(f64_mul(a1, a1), f64_mul(b1, b1)));
    var c2_star = f64_sqrt(f64_add(f64_mul(a2, a2), f64_mul(b2, b2)));
    var c_bar = f64_div(f64_add(c1_star, c2_star), 2.0);

    var c_bar_7 = _rg_pow7(c_bar);
    var g = f64_mul(0.5, f64_sub(F64_ONE, f64_sqrt(f64_div(c_bar_7, f64_add(c_bar_7, _RG_25_POW7)))));

    var a1p = f64_mul(a1, f64_add(F64_ONE, g));
    var a2p = f64_mul(a2, f64_add(F64_ONE, g));

    var c1p = f64_sqrt(f64_add(f64_mul(a1p, a1p), f64_mul(b1, b1)));
    var c2p = f64_sqrt(f64_add(f64_mul(a2p, a2p), f64_mul(b2, b2)));

    var h1p = _rg_rem_euclid(_rg_to_degrees(ganita_f64_atan2(b1, a1p)), 360.0);
    var h2p = _rg_rem_euclid(_rg_to_degrees(ganita_f64_atan2(b2, a2p)), 360.0);

    var dlp = f64_sub(l2, l1);
    var dcp = f64_sub(c2p, c1p);

    # Hue difference takes the short way round the circle. The chroma guard
    # comes first: with either chroma at zero the hue is undefined and the
    # difference must be 0, not whatever atan2 returned for a null vector.
    var dhp_deg = 0;
    var cprod = f64_mul(c1p, c2p);
    if (f64_ge(cprod, 0.0000000001) == 1) {
        var hdiff = f64_sub(h2p, h1p);
        if (f64_le(f64_abs(hdiff), 180.0) == 1) { dhp_deg = hdiff; }
        if (f64_le(f64_abs(hdiff), 180.0) == 0) {
            if (f64_gt(hdiff, 180.0) == 1) { dhp_deg = f64_sub(hdiff, 360.0); }
            if (f64_gt(hdiff, 180.0) == 0) { dhp_deg = f64_add(hdiff, 360.0); }
        }
    }
    var dhp = f64_mul(f64_mul(2.0, f64_sqrt(cprod)), _rg_sin(_rg_to_radians(f64_div(dhp_deg, 2.0))));

    var lbp = f64_div(f64_add(l1, l2), 2.0);
    var cbp = f64_div(f64_add(c1p, c2p), 2.0);

    var hbp = 0;
    if (f64_lt(cprod, 0.0000000001) == 1) {
        hbp = f64_add(h1p, h2p);
    }
    if (f64_lt(cprod, 0.0000000001) == 0) {
        var hsum = f64_add(h1p, h2p);
        if (f64_le(f64_abs(f64_sub(h1p, h2p)), 180.0) == 1) {
            hbp = f64_div(hsum, 2.0);
        }
        if (f64_le(f64_abs(f64_sub(h1p, h2p)), 180.0) == 0) {
            if (f64_lt(hsum, 360.0) == 1) { hbp = f64_div(f64_add(hsum, 360.0), 2.0); }
            if (f64_lt(hsum, 360.0) == 0) { hbp = f64_div(f64_sub(hsum, 360.0), 2.0); }
        }
    }

    var t = f64_sub(f64_add(f64_add(f64_sub(F64_ONE,
                f64_mul(0.17, _rg_cos(_rg_to_radians(f64_sub(hbp, 30.0))))),
                f64_mul(0.24, _rg_cos(_rg_to_radians(f64_mul(2.0, hbp))))),
                f64_mul(0.32, _rg_cos(_rg_to_radians(f64_add(f64_mul(3.0, hbp), 6.0))))),
                f64_mul(0.20, _rg_cos(_rg_to_radians(f64_sub(f64_mul(4.0, hbp), 63.0)))));

    var ldiff = f64_sub(lbp, 50.0);
    var ld2 = f64_mul(ldiff, ldiff);
    var sl = f64_add(F64_ONE, f64_div(f64_mul(0.015, ld2), f64_sqrt(f64_add(20.0, ld2))));
    var sc = f64_add(F64_ONE, f64_mul(0.045, cbp));
    var sh = f64_add(F64_ONE, f64_mul(f64_mul(0.015, cbp), t));

    var hterm = f64_div(f64_sub(hbp, 275.0), 25.0);
    var dtheta = f64_mul(30.0, _rg_exp(f64_neg(f64_mul(hterm, hterm))));
    var cbp7 = _rg_pow7(cbp);
    var rc = f64_mul(2.0, f64_sqrt(f64_div(cbp7, f64_add(cbp7, _RG_25_POW7))));
    var rt = f64_mul(f64_neg(_rg_sin(_rg_to_radians(f64_mul(2.0, dtheta)))), rc);

    var lt = f64_div(dlp, sl);
    var ct = f64_div(dcp, sc);
    var ht = f64_div(dhp, sh);

    var sum = f64_add(f64_add(f64_add(f64_mul(lt, lt), f64_mul(ct, ct)), f64_mul(ht, ht)),
                      f64_mul(f64_mul(rt, ct), ht));
    return f64_sqrt(sum);
}
