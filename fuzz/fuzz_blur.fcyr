# Fuzz: neighbourhood filters.
# Rust 1.0.1 target: rust-old/fuzz/fuzz_targets/fuzz_blur.rs (gaussian_blur, box_blur,
# unsharp_mask, median, bilateral on sizes 1..63 with radius 0..20; no crash).
# Sizes and radii here are smaller, because each iteration runs every filter, but
# the parameters are adversarial: arbitrary sigma and amount f32s.
# Invariants:
#   - Each filter returns a buffer of the input's size and format, or (bilateral
#     only) RG_ERR_OTHER exactly when a sigma is <= 0, as Rust's Other.
#   - Radius 0 is a copy for gaussian_blur, box_blur, median and bilateral.
#   - A uniform image is unchanged by median.
#   - On a uniform image of value v, Rust's own outputs stay in these bounds, which
#     were measured against the Rust 1.0.1 crate over every v and radii 0..10:
#       - gaussian_blur: [v - 2, v]. Rust truncates after each of its two passes,
#         and its weights sum to just under 1, so it darkens a uniform image in
#         979 of 2,816 cases. Its own uniform test passes only because of the
#         value it uses. The port matches Rust exactly.
#       - box_blur: [v - 2, v], from the same two-pass truncation (4,278 of 13,824
#         measured cases change).
#       - bilateral: [v - 1, v].
#       - unsharp_mask: [v, v + 2 * amount + 1], since it adds amount * (v - blur).
#   - bilateral with a NaN sigma is a copy (every weight NaN, so `sum_w > 0`
#     fails and each pixel is copied, as in Rust).

include "src/error.cyr"
include "src/bytevec.cyr"
include "src/simd_u8.cyr"
include "src/pixel.cyr"
include "src/filter_kernel.cyr"
include "fuzz/fz_common.cyr"

var ERR = 0;

fn ok_same_shape(out, src, what) {
    fz_check(out != 0 && load64(ERR) == RG_ERR_NONE, what);
    fz_check(fz_dims(out, pixel_buffer_width(src), pixel_buffer_height(src)), "a filter changed the dimensions");
    fz_check(pixel_buffer_format(out) == PF_RGBA8, "a filter changed the format");
    return 0;
}

# 1 if every byte of `out` is within [src + lo, src + hi], clamped to 0..255.
fn within(out, src, lo, hi) {
    var n = pixel_buffer_len(src);
    var po = pixel_buffer_data(out);
    var ps = pixel_buffer_data(src);
    var i = 0;
    while (i < n) {
        var d = load8(po + i) - load8(ps + i);
        if (d < lo) { return 0; }
        if (d > hi && load8(po + i) != 255) { return 0; }
        i = i + 1;
    }
    return 1;
}

# Runs each filter at `radius` on `src`.
# expect: 0 = shape only, 1 = every output is an exact copy (radius 0),
# 2 = `src` is uniform (Rust's bounds above).
fn run_all(src, radius, expect) {
    var gb = gaussian_blur(src, radius, ERR);
    ok_same_shape(gb, src, "gaussian_blur failed");
    if (expect == 1) { fz_check(fz_same(gb, src), "gaussian_blur radius 0 is not a copy"); }
    if (expect == 2) { fz_check(within(gb, src, 0 - 2, 0), "gaussian_blur left [v - 2, v] on a uniform image"); }
    pixel_buffer_free(gb);

    var bb = box_blur(src, radius, ERR);
    ok_same_shape(bb, src, "box_blur failed");
    if (expect == 1) { fz_check(fz_same(bb, src), "box_blur radius 0 is not a copy"); }
    if (expect == 2) { fz_check(within(bb, src, 0 - 2, 0), "box_blur left [v - 2, v] on a uniform image"); }
    pixel_buffer_free(bb);

    var mr = radius;
    if (mr > 5) { mr = 5; }
    var md = median(src, mr, ERR);
    ok_same_shape(md, src, "median failed");
    if (expect != 0) { fz_check(fz_same(md, src), "median changed a uniform image or a radius-0 copy"); }
    pixel_buffer_free(md);

    var af = fz_unit();
    var amount = f32_from(f64_mul(f32_to(af), 5.0));
    var um = unsharp_mask(src, radius, amount, ERR);
    ok_same_shape(um, src, "unsharp_mask failed");
    if (expect == 2) {
        var top = f64_to(f64_mul(f32_to(amount), 2.0)) + 1;
        fz_check(within(um, src, 0, top), "unsharp_mask left [v, v + 2 * amount + 1] on a uniform image");
    }
    pixel_buffer_free(um);

    var br = radius;
    if (br > 6) { br = 6; }
    var ss = f32_from(f64_add(0.1, f64_mul(f32_to(fz_unit()), 49.9)));
    var sc = f32_from(f64_add(0.1, f64_mul(f32_to(fz_unit()), 49.9)));
    var bl = bilateral(src, br, ss, sc, ERR);
    ok_same_shape(bl, src, "bilateral failed");
    if (expect == 1) { fz_check(fz_same(bl, src), "bilateral radius 0 is not a copy"); }
    if (expect == 2) { fz_check(within(bl, src, 0 - 1, 0), "bilateral left [v - 1, v] on a uniform image"); }
    pixel_buffer_free(bl);
    return 0;
}

fn one(iter) {
    var w = 1 + fz_u(20);
    var h = 1 + fz_u(20);
    var radius = fz_u(9);
    var src = fz_rgba(w, h);
    run_all(src, radius, 0);
    run_all(src, 0, 1);

    var uni = fz_rgba_fill(w, h, fz_byte(), fz_byte(), fz_byte(), fz_byte());
    run_all(uni, radius, 2);
    pixel_buffer_free(uni);

    # Adversarial sigmas.
    var sg = fz_f32_any();
    store64(ERR, 0x7777);
    var bx = bilateral(src, 1 + fz_u(3), sg, f32_from(10.0), ERR);
    var sd = f32_to(sg);
    if (f64_le(sd, 0) == 1) {
        fz_check(bx == 0 && load64(ERR) == RG_ERR_OTHER, "bilateral with sigma <= 0 did not report OTHER");
    } else {
        ok_same_shape(bx, src, "bilateral with sigma > 0 or NaN failed");
        if (f64_eq(sd, sd) == 0) { fz_check(fz_same(bx, src), "bilateral with a NaN sigma is not a copy"); }
        pixel_buffer_free(bx);
    }
    pixel_buffer_free(src);
    return 0;
}

fn main() {
    alloc_init();
    ERR = fl_alloc(8);
    return fz_run("fuzz_blur", 300, &one);
}

var r = main();
sys_exit_group(r);
