# Fuzz: pixel format conversions.
# Rust 1.0.1 target: rust-old/fuzz/fuzz_targets/fuzz_convert.rs (RGBA → YUV420p → RGBA,
# YUV420p from raw bytes, ARGB → NV12; even sizes 2..62; no crash). Here, any
# size 1..62, including odd ones, which the port supports, and all three colour
# standards.
# Invariants:
#   - Every forward conversion succeeds, reports YUV420p / NV12, and is exactly
#     w*h + 2 * ceil(w/2) * ceil(h/2) bytes long.
#   - Every inverse returns a w x h RGBA8 buffer with alpha 255 everywhere,
#     including from arbitrary YUV and NV12 bytes.
#   - A grey pixel in the studio range 16..235 survives an RGBA → YUV → RGBA round
#     trip within 2 counts, for BT.601, BT.709 and BT.2020 (Rust's proptest
#     yuv420p_*_roundtrip_gray uses the same bound).

include "src/error.cyr"
include "src/bytevec.cyr"
include "src/simd_u8.cyr"
include "src/pixel.cyr"
include "src/convert.cyr"
include "fuzz/fz_common.cyr"

var ERR = 0;

fn yuv_size(w, h) { return w * h + 2 * ((w + 1) / 2) * ((h + 1) / 2); }

# fwd: 0 BT.601, 1 BT.709, 2 BT.2020.
fn to_yuv(img, std) {
    if (std == 0) { return rgba_to_yuv420p(img, ERR); }
    if (std == 1) { return rgba_to_yuv420p_bt709(img, ERR); }
    return rgba_to_yuv420p_bt2020(img, ERR);
}
fn from_yuv(yuv, std) {
    if (std == 0) { return yuv420p_to_rgba(yuv, ERR); }
    if (std == 1) { return yuv420p_to_rgba_bt709(yuv, ERR); }
    return yuv420p_to_rgba_bt2020(yuv, ERR);
}

fn check_rgba_opaque(b, w, h, what) {
    fz_check(b != 0, what);
    fz_check(fz_dims(b, w, h), "an inverse changed the dimensions");
    fz_check(pixel_buffer_format(b) == PF_RGBA8, "an inverse did not return RGBA8");
    var d = pixel_buffer_data(b);
    var i = 0;
    while (i < w * h) {
        fz_check(load8(d + i * 4 + 3) == 255, "an inverse produced alpha other than 255");
        i = i + 1;
    }
    return 0;
}

fn raw_planar(w, h, fmt) {
    var b = pixel_buffer_zeroed(w, h, fmt, ERR);
    fz_check(b != 0, "could not allocate a planar buffer");
    var d = pixel_buffer_data(b);
    var n = pixel_buffer_len(b);
    var i = 0;
    while (i < n) { store8(d + i, fz_byte()); i = i + 1; }
    return b;
}

fn one(iter) {
    var w = 1 + fz_u(62);
    var h = 1 + fz_u(62);
    var img = fz_rgba(w, h);
    var std = 0;
    while (std < 3) {
        store64(ERR, 0x7777);
        var yuv = to_yuv(img, std);
        fz_check(yuv != 0 && load64(ERR) == RG_ERR_NONE, "a forward YUV conversion failed");
        fz_check(pixel_buffer_format(yuv) == PF_YUV420P, "a forward conversion did not report YUV420p");
        fz_check(pixel_buffer_len(yuv) == yuv_size(w, h), "a YUV420p buffer has the wrong length");
        var back = from_yuv(yuv, std);
        check_rgba_opaque(back, w, h, "a YUV420p inverse failed");
        pixel_buffer_free(back);
        pixel_buffer_free(yuv);

        # Arbitrary planes decode without fault.
        var raw = raw_planar(w, h, PF_YUV420P);
        var rb = from_yuv(raw, std);
        check_rgba_opaque(rb, w, h, "decoding arbitrary YUV420p failed");
        pixel_buffer_free(rb);
        pixel_buffer_free(raw);

        # Studio-range grey round trip.
        var v = 16 + fz_u(220);
        var grey = fz_rgba_fill(w, h, v, v, v, 255);
        var gy = to_yuv(grey, std);
        var gb = from_yuv(gy, std);
        var gd = pixel_buffer_data(gb);
        var px = fz_u(w * h);
        var c = 0;
        while (c < 3) {
            var got = load8(gd + px * 4 + c);
            var diff = got - v;
            if (diff < 0) { diff = 0 - diff; }
            fz_check(diff < 3, "a studio-range grey did not survive a YUV round trip within 2");
            c = c + 1;
        }
        pixel_buffer_free(gb); pixel_buffer_free(gy); pixel_buffer_free(grey);
        std = std + 1;
    }

    # ARGB → NV12 → RGBA, and NV12 from arbitrary bytes.
    var argb = raw_planar(w, h, PF_ARGB8);
    store64(ERR, 0x7777);
    var nv = argb_to_nv12(argb, ERR);
    fz_check(nv != 0 && load64(ERR) == RG_ERR_NONE, "argb_to_nv12 failed");
    fz_check(pixel_buffer_format(nv) == PF_NV12, "argb_to_nv12 did not report NV12");
    fz_check(pixel_buffer_len(nv) == yuv_size(w, h), "an NV12 buffer has the wrong length");
    var nb = nv12_to_rgba(nv, ERR);
    check_rgba_opaque(nb, w, h, "nv12_to_rgba failed");
    pixel_buffer_free(nb); pixel_buffer_free(nv); pixel_buffer_free(argb);
    var rnv = raw_planar(w, h, PF_NV12);
    var rnb = nv12_to_rgba(rnv, ERR);
    check_rgba_opaque(rnb, w, h, "decoding arbitrary NV12 failed");
    pixel_buffer_free(rnb); pixel_buffer_free(rnv);

    pixel_buffer_free(img);
    return 0;
}

fn main() {
    alloc_init();
    ERR = fl_alloc(8);
    return fz_run("fuzz_convert", 1000, &one);
}

var r = main();
sys_exit_group(r);
