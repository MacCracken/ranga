# --- error.cyr ---

# @public — stable API surface for chitra error handling.
# error.cyr — chitra raster-decode error codes + Result helpers.
#
# ChitraErr is a 16-byte record layout-compatible with mabda's GpuErr
# so a consumer (mabda) can map a decode failure cleanly onto
# GPU_ERR_IMAGE_DECODE. Error codes are integer constants; for errors
# that carry context (a message pointer), use chitra_err_new(code, msg).
#
# ChitraErr struct layout (16 bytes):
#   +0: code    — error code constant (one of the CHITRA_* below)
#   +8: detail  — pointer to detail string (or 0)

# ================================================================
# Error code constants
# ================================================================

enum ChitraErrCode {
    CHITRA_OK              = 0;   # no error
    CHITRA_ERR_SIGNATURE  = 1;   # missing/corrupt PNG 8-byte signature
    CHITRA_ERR_TRUNCATED  = 2;   # input ends before a chunk/field completes
    CHITRA_ERR_BAD_CHUNK  = 3;   # malformed chunk (length/CRC/type/order)
    # "The file is valid; chitra declines it." Deliberately one code covering
    # several situations, enumerated here because the freeze codifies it and a
    # one-line comment describing one of them is how it drifted:
    #   PNG  — an unrecognised CRITICAL chunk (§ 5.4's ancillary bit: such a
    #          chunk changes how the image is to be interpreted, so rendering
    #          anyway means rendering a stream we do not understand);
    #        — a compression or filter method other than 0 (§ 11.2.2);
    #        — an unrecognised colour type.
    #   JPEG — an Adobe APP14 colour transform chitra does not implement (2 is
    #          YCCK) or does not recognise (> 2). Guessing YCbCr for it is the
    #          defect ADR 0009 exists to prevent.
    # It does NOT cover the non-baseline JPEG modes — progressive, arithmetic,
    # 12-bit, hierarchical and CMYK each carry their own code (19..23) — and as
    # of 0.8.0 it no longer covers any JPEG scan geometry, which now decodes.
    CHITRA_ERR_UNSUPPORTED = 4;
    CHITRA_ERR_INFLATE    = 5;   # sankoch zlib_decompress reported failure
    CHITRA_ERR_OOM        = 6;   # allocation failed / decompression-bomb cap hit
    CHITRA_ERR_CRC        = 7;   # chunk CRC-32 mismatch (corruption / tamper)
    CHITRA_ERR_INTERLACE  = 8;   # interlace method not 0 (none) or 1 (Adam7) — both are decoded
    CHITRA_ERR_BIT_DEPTH  = 9;   # bit_depth × color_type not spec-legal (§ 11.2.2 Table 11.1)
    CHITRA_ERR_DIMENSIONS = 10;  # width/height vs data: lying-IHDR / overflow / bomb caps
    CHITRA_ERR_FILTER     = 11;  # per-row filter byte not in {0,1,2,3,4} (spec § 9)
    CHITRA_ERR_NO_IDAT    = 12;  # structurally valid PNG with zero IDAT (no pixel data)
    # ---- JPEG (chitra 0.3.0, JFIF baseline) ----
    CHITRA_ERR_JPEG_MARKER      = 13;  # malformed/misplaced JPEG marker or bad 16-bit segment length
    CHITRA_ERR_JPEG_SOF         = 14;  # invalid SOF0 frame header (precision/components/sampling/dims)
    CHITRA_ERR_JPEG_DQT         = 15;  # malformed DQT quantization table
    CHITRA_ERR_JPEG_DHT         = 16;  # malformed DHT / Huffman-table build failure
    CHITRA_ERR_JPEG_SOS         = 17;  # malformed SOS scan header (selectors / table refs)
    CHITRA_ERR_JPEG_ENTROPY     = 18;  # corrupt entropy stream (undecodable code / bit overrun / bad RSTn)
    CHITRA_ERR_JPEG_PROGRESSIVE = 19;  # deferred: progressive DCT (SOF2) — baseline-only in 0.3.0
    CHITRA_ERR_JPEG_ARITHMETIC  = 20;  # deferred: arithmetic coding (SOF9/10/11, DAC) — Huffman-only
    CHITRA_ERR_JPEG_PRECISION   = 21;  # deferred: sample precision != 8 (12-bit) — 8-bit-only in 0.3.0
    CHITRA_ERR_JPEG_MODE        = 22;  # deferred: hierarchical/lossless/differential SOF modes
    CHITRA_ERR_JPEG_COMPONENTS  = 23;  # deferred: unsupported component count (CMYK/YCCK 4-component)
    # ---- BMP (0.4.0 BI_RGB; + RLE 0.5.1; + BITFIELDS/16 bpp/V4-V5 0.5.2) ----
    CHITRA_ERR_BMP_HEADER       = 24;  # malformed file header or DIB header (size/planes/offsets)
    CHITRA_ERR_BMP_DEPTH        = 25;  # bpp not in {1,4,8,16,24,32}
    CHITRA_ERR_BMP_COMPRESSION  = 26;  # refused permanently: BI_JPEG / BI_PNG (a decoder re-entering itself)
    CHITRA_ERR_BMP_PALETTE      = 27;  # palette missing, short, or an index outside it
    # ---- GIF (chitra 0.5.0, first frame only — see ADR 0005) ----
    CHITRA_ERR_GIF_HEADER       = 28;  # bad signature/version, screen or image descriptor
    CHITRA_ERR_GIF_LZW          = 29;  # corrupt LZW stream (bad code, oversized output, bad chain)
    CHITRA_ERR_GIF_PALETTE      = 30;  # no color table in force, or an index outside it
    CHITRA_ERR_GIF_NO_IMAGE     = 31;  # structurally valid GIF with no image descriptor
    # ---- BMP run-length (chitra 0.5.1) ----
    CHITRA_ERR_BMP_RLE          = 32;  # corrupt RLE stream: run/delta leaves the bitmap, or truncated
    CHITRA_ERR_BMP_MASK         = 33;  # BI_BITFIELDS channel mask non-contiguous, overlapping, or out of range
    # ---- caller policy (chitra 0.6.1) ----
    # Not a validity failure and not an OOM: the FILE is fine and the heap is
    # fine, but the caller asked chitra not to spend this much on it.
    CHITRA_ERR_BUDGET           = 34;  # decode refused by the caller's max_bytes
    # ---- decompressor capability (chitra 1.0.1) ----
    # ⛔⛔ NOT A VALIDITY FAILURE, NOT AN OOM, AND NOT A BOMB. The file is a correct PNG, the heap is
    # fine, and the caller asked for it — but its inflated scanline data is larger than the linked
    # `sankoch` will EMIT. `DECOMPRESS_MAX_OUTPUT` is sankoch's absolute 16 MiB anti-bomb backstop,
    # enforced identically by `zlib_decompress` and the
    # streaming decoder, which are the entry points chitra calls.
    # ⚠ CORRECTED 1.0.3 — this used to say "no sankoch entry point can exceed it and chitra cannot
    # work around it", and the second half stopped being true when sankoch **2.7.13** added
    # `zlib_decompress_capped`, which lets a caller that has independently bounded its own output
    # name its own ceiling. That entry point is vendored and works. chitra still calls plain
    # `zlib_decompress` DELIBERATELY: adopting the capped form retires files that currently answer
    # this code, so it is a release with an entry, not a swap.
    # ⚠ THIS USED TO SURFACE AS `CHITRA_ERR_INFLATE` — "the decompressor reported a failure" — which
    # is true and useless: it does not distinguish a corrupt stream from a perfectly good image that
    # is simply too large for this build. A caller can retry a corrupt file, or ask the user; it can
    # only ever refuse this one. ⇒ Reported by crab 2026-08-31, whose thumbnailer needed to tell the
    # operator WHICH kind of nothing it was showing.
    CHITRA_ERR_INFLATE_LIMIT    = 35;  # inflated size exceeds sankoch's DECOMPRESS_MAX_OUTPUT
    CHITRA_ERR_OTHER      = 99;  # catch-all
}

# ================================================================
# ChitraErr struct
# ================================================================

# BSS-resident fallback ChitraErr (no alloc dependency). The 16-byte alloc
# below fails only under true heap exhaustion, but the unguarded version was
# wrong twice over: it stored through a NULL pointer, and it returned 0 —
# which every caller reads as "no error", inverting the failure contract at
# the exact moment a failure must be reported. Last-writer-wins on a shared
# record is an acceptable trade when the heap is gone; a live, correctly-coded
# ChitraErr beats both a fault and a silent success.
var _chitra_err_fallback[16];

# Create a ChitraErr with code and an optional detail string (0 = none).
# Never returns 0 — see _chitra_err_fallback above.
fn chitra_err_new(code, detail): i64 {
    var e = alloc(16);
    if (e == 0) {
        store64(&_chitra_err_fallback, code);
        store64(&_chitra_err_fallback + 8, detail);
        return &_chitra_err_fallback;
    }
    store64(e, code);
    store64(e + 8, detail);
    return e;
}

# Create a ChitraErr with code only (no detail).
fn chitra_err(code): i64 {
    return chitra_err_new(code, 0);
}

# Get the error code.
fn chitra_err_code(e): i64 {
    return load64(e);
}

# Get the detail string pointer (or 0).
fn chitra_err_detail(e): i64 {
    return load64(e + 8);
}

# ================================================================
# Error name lookup — returns a cstring (never null).
# ================================================================

fn chitra_err_name(code): i64 {
    if (code == CHITRA_OK)              { return "ok"; }
    if (code == CHITRA_ERR_SIGNATURE)  { return "bad PNG signature"; }
    if (code == CHITRA_ERR_TRUNCATED)  { return "truncated input"; }
    if (code == CHITRA_ERR_BAD_CHUNK)  { return "malformed chunk"; }
    if (code == CHITRA_ERR_UNSUPPORTED) { return "unsupported feature"; }
    if (code == CHITRA_ERR_INFLATE)    { return "inflate failed"; }
    if (code == CHITRA_ERR_OOM)        { return "out of memory"; }
    if (code == CHITRA_ERR_CRC)        { return "chunk CRC mismatch"; }
    if (code == CHITRA_ERR_INTERLACE)  { return "illegal interlace method"; }
    if (code == CHITRA_ERR_BIT_DEPTH)  { return "illegal bit depth for color type"; }
    if (code == CHITRA_ERR_DIMENSIONS) { return "bad dimensions"; }
    if (code == CHITRA_ERR_FILTER)     { return "bad filter byte"; }
    if (code == CHITRA_ERR_NO_IDAT)    { return "no IDAT chunks"; }
    if (code == CHITRA_ERR_JPEG_MARKER)      { return "bad JPEG marker"; }
    if (code == CHITRA_ERR_JPEG_SOF)         { return "bad JPEG frame header"; }
    if (code == CHITRA_ERR_JPEG_DQT)         { return "bad JPEG quant table"; }
    if (code == CHITRA_ERR_JPEG_DHT)         { return "bad JPEG Huffman table"; }
    if (code == CHITRA_ERR_JPEG_SOS)         { return "bad JPEG scan header"; }
    if (code == CHITRA_ERR_JPEG_ENTROPY)     { return "corrupt JPEG entropy stream"; }
    if (code == CHITRA_ERR_JPEG_PROGRESSIVE) { return "progressive JPEG unsupported"; }
    if (code == CHITRA_ERR_JPEG_ARITHMETIC)  { return "arithmetic JPEG unsupported"; }
    if (code == CHITRA_ERR_JPEG_PRECISION)   { return "JPEG sample precision unsupported"; }
    if (code == CHITRA_ERR_JPEG_MODE)        { return "JPEG mode unsupported"; }
    if (code == CHITRA_ERR_JPEG_COMPONENTS)  { return "JPEG component count unsupported"; }
    if (code == CHITRA_ERR_BMP_HEADER)       { return "malformed BMP header"; }
    if (code == CHITRA_ERR_BMP_DEPTH)        { return "BMP bit depth unsupported"; }
    if (code == CHITRA_ERR_BMP_COMPRESSION)  { return "BMP compression unsupported"; }
    if (code == CHITRA_ERR_BMP_PALETTE)      { return "BMP palette invalid"; }
    if (code == CHITRA_ERR_GIF_HEADER)       { return "malformed GIF header"; }
    if (code == CHITRA_ERR_GIF_LZW)          { return "corrupt GIF LZW stream"; }
    if (code == CHITRA_ERR_GIF_PALETTE)      { return "GIF color table invalid"; }
    if (code == CHITRA_ERR_GIF_NO_IMAGE)     { return "GIF has no image data"; }
    if (code == CHITRA_ERR_BMP_RLE)          { return "corrupt BMP RLE stream"; }
    if (code == CHITRA_ERR_BMP_MASK)         { return "invalid BMP channel mask"; }
    if (code == CHITRA_ERR_BUDGET)           { return "decode exceeds caller byte budget"; }
    if (code == CHITRA_ERR_INFLATE_LIMIT)    { return "inflated size exceeds decompressor ceiling"; }
    if (code == CHITRA_ERR_OTHER)      { return "other error"; }
    return "unknown error";
}

# Print an error name to stderr (fd 2).
fn chitra_err_print_name(code): i64 {
    var name = chitra_err_name(code);
    syscall(1, 2, name, strlen(name));
    return 0;
}

# --- png_chunks.cyr ---

# @internal — PNG byte-buffer chunk framing + IDAT inflate.
# png_chunks.cyr — turn untrusted PNG bytes into a parsed IHDR + the
# concatenated, inflated IDAT stream. Forked from kii/src/png.cyr's
# proven framing/CRC/security core, re-shaped from path-based io reads
# to a bounds-checked byte-buffer cursor over (src, len).
#
# Every read is validated against `len` BEFORE the access (untrusted
# input — a byte-buffer decoder over network/disk bytes must never read
# out of bounds). Chunk CRC-32 is validated via sankoch's crc32. The
# decompression-bomb / lying-IHDR / dimension caps are ported verbatim
# from kii (audit 2026-05-22 findings 1/2/3).
#
# The handoff to the later color pass is the ChitraPngRaw
# struct produced by chitra_png_parse_raw (see png_filter.cyr for the
# unfilter step that fills the scanline buffer).

# ================================================================
# PNG signature (W3C PNG § 5.2) — bytes 0..7 of every PNG.
#   0x89  high-bit byte (catches 7-bit-stripping gateways)
#   P N G ASCII identifier
#   \r \n CRLF (catches DOS<->Unix mangling)
#   0x1A  DOS EOF marker
#   \n    final LF (catches \r\n -> \r)
# String-literal storage: Cyrius cstrings are NUL-terminated and byte 8
# (the NUL) is never inspected — loops bound on CHITRA_PNG_MAGIC_LEN.
# ================================================================
var CHITRA_PNG_MAGIC     = "\x89PNG\r\n\x1a\n";
var CHITRA_PNG_MAGIC_LEN = 8;

# ================================================================
# Security ceilings (ported from kii — audit 2026-05-22 finding 1).
# Cap attacker-controllable IHDR fields BEFORE any allocation. PNG
# permits width/height up to 2^31-1; chitra's texture-loader use case
# stays far below the i64-overflow boundary. All caps trip
# CHITRA_ERR_DIMENSIONS / CHITRA_ERR_OOM.
# ================================================================
var CHITRA_MAX_PIXELS    = 16777216;   # 4096 x 4096
var CHITRA_MAX_RAW_BYTES = 268435456;  # 256 MB absolute single-buffer ceiling
var CHITRA_MAX_DIM       = 65535;      # per-side cap

# DEFLATE's theoretical maximum ratio is 1032:1 (RFC 1951 § 3.2.5).
# inflated/idat above 1100 is a decompression bomb (kii finding 3).
var CHITRA_MAX_INFLATE_RATIO = 1100;

# ================================================================
# ChitraPngRaw — the parse -> colour-pass handoff record (104 bytes).
# Produced by chitra_png_parse_raw (framing + inflate + unfilter); the
# canonical-RGBA8 colour pass consumes it. PLTE/tRNS spans are
# captured here as (offset-into-src, length) pairs — the bytes are NOT
# processed yet (that is the color pass's job). offset 0 with length 0
# means "chunk absent".
#
#   +0   width        (i64 — pixels)
#   +8   height       (i64 — pixels)
#   +16  bit_depth    (i64 — 1/2/4/8/16; valid combos per color_type, Table 11.1)
#   +24  color_type   (i64 — 0/2/3/4/6)
#   +32  channels     (i64 — samples per pixel: 1/3/1/2/4)
#   +40  scanlines    (ptr — owned unfiltered raw buffer, h*w*bpp bytes)
#   +48  scanlines_len(i64 — byte count of the scanline buffer)
#   +56  plte_off     (i64 — byte offset of PLTE data within src, 0 if none)
#   +64  plte_len     (i64 — PLTE data length, 0 if none)
#   +72  trns_off     (i64 — byte offset of tRNS data within src, 0 if none)
#   +80  trns_len     (i64 — tRNS data length, 0 if none)
#   +88  seen_iend    (i64 — 1 if an IEND chunk closed the stream, else 0;
#                      0 = clean IEND-less end, spec § 5.3 tolerance —
#                      surfaced so consumers can warn while still decoding)
#   +96  interlace    (i64 — 0 = none, 1 = Adam7; chitra 0.2.1)
# ================================================================
var RAW_WIDTH_OFFSET        = 0;
var RAW_HEIGHT_OFFSET       = 8;
var RAW_BIT_DEPTH_OFFSET    = 16;
var RAW_COLOR_TYPE_OFFSET   = 24;
var RAW_CHANNELS_OFFSET     = 32;
var RAW_SCANLINES_OFFSET    = 40;
var RAW_SCANLINES_LEN_OFFSET = 48;
var RAW_PLTE_OFF_OFFSET     = 56;
var RAW_PLTE_LEN_OFFSET     = 64;
var RAW_TRNS_OFF_OFFSET     = 72;
var RAW_TRNS_LEN_OFFSET     = 80;
var RAW_SEEN_IEND_OFFSET    = 88;
var RAW_INTERLACE_OFFSET    = 96;   # 0 = none, 1 = Adam7 (chitra 0.2.1)
var CHITRA_PNG_RAW_SIZE     = 104;

# ---- ChitraPngRaw accessors -------------------------------------
fn chitra_raw_width(raw): i64       { return load64(raw + RAW_WIDTH_OFFSET); }
fn chitra_raw_height(raw): i64      { return load64(raw + RAW_HEIGHT_OFFSET); }
fn chitra_raw_bit_depth(raw): i64   { return load64(raw + RAW_BIT_DEPTH_OFFSET); }
fn chitra_raw_color_type(raw): i64  { return load64(raw + RAW_COLOR_TYPE_OFFSET); }
fn chitra_raw_channels(raw): i64    { return load64(raw + RAW_CHANNELS_OFFSET); }
fn chitra_raw_scanlines(raw): i64   { return load64(raw + RAW_SCANLINES_OFFSET); }
fn chitra_raw_scanlines_len(raw): i64 { return load64(raw + RAW_SCANLINES_LEN_OFFSET); }
fn chitra_raw_plte_off(raw): i64    { return load64(raw + RAW_PLTE_OFF_OFFSET); }
fn chitra_raw_plte_len(raw): i64    { return load64(raw + RAW_PLTE_LEN_OFFSET); }
fn chitra_raw_trns_off(raw): i64    { return load64(raw + RAW_TRNS_OFF_OFFSET); }
fn chitra_raw_trns_len(raw): i64    { return load64(raw + RAW_TRNS_LEN_OFFSET); }
fn chitra_raw_seen_iend(raw): i64   { return load64(raw + RAW_SEEN_IEND_OFFSET); }
fn chitra_raw_interlace(raw): i64   { return load64(raw + RAW_INTERLACE_OFFSET); }

# Release a ChitraPngRaw. The stdlib `alloc` is a bump allocator with no
# per-block free, so this is a no-op kept for API symmetry / a future
# arena-backed allocator; documented so callers don't assume reclaim.
# Safe on a 0 ptr.
fn chitra_raw_free(raw): i64 {
    return 0;
}

# ================================================================
# Byte-buffer cursor — bounds-checked reads over (src, len).
# A 16-byte record:
#   +0  base ptr  (start of the byte buffer)
#   +8  pos       (current read offset; 0 <= pos <= len)
# `len` is carried separately by callers via _cur_remaining(cur, len)
# style? No — to keep every read self-validating we store len too. Use
# a 24-byte cursor instead:
#   +0  base, +8 pos, +16 len.
# ================================================================
var CUR_BASE_OFFSET = 0;
var CUR_POS_OFFSET  = 8;
var CUR_LEN_OFFSET  = 16;

# Init a stack cursor: caller passes a >=24-byte buffer.
fn _cur_init(cur, base, len): i64 {
    store64(cur + CUR_BASE_OFFSET, base);
    store64(cur + CUR_POS_OFFSET, 0);
    store64(cur + CUR_LEN_OFFSET, len);
    return 0;
}

fn _cur_pos(cur): i64       { return load64(cur + CUR_POS_OFFSET); }
fn _cur_len(cur): i64       { return load64(cur + CUR_LEN_OFFSET); }
fn _cur_remaining(cur): i64 {
    return load64(cur + CUR_LEN_OFFSET) - load64(cur + CUR_POS_OFFSET);
}

# True (1) iff `n` bytes can be read from the current position without
# running past len. n must be >= 0 (callers pass chunk_len which is
# masked to 31 bits, so always non-negative).
fn _cur_can_read(cur, n): i64 {
    if (n < 0) { return 0; }
    if (_cur_remaining(cur) < n) { return 0; }
    return 1;
}

# Read one u8 at the cursor and advance. Caller MUST have checked
# _cur_can_read(cur, 1) first; this asserts it returns 0 defensively if
# out of bounds (never an OOB load).
fn _cur_u8(cur): i64 {
    if (_cur_can_read(cur, 1) == 0) { return 0; }
    var p = load64(cur + CUR_BASE_OFFSET) + load64(cur + CUR_POS_OFFSET);
    var v = load8(p);
    store64(cur + CUR_POS_OFFSET, load64(cur + CUR_POS_OFFSET) + 1);
    return v;
}

# Read a big-endian u32 (PNG is big-endian throughout, spec § 7) and
# advance 4 bytes. Returns the value; caller checks _cur_can_read first.
# Masked to 32 bits so a high bit can't sign-extend into a negative i64.
fn _cur_u32_be(cur): i64 {
    if (_cur_can_read(cur, 4) == 0) { return 0; }
    var p = load64(cur + CUR_BASE_OFFSET) + load64(cur + CUR_POS_OFFSET);
    var b0 = load8(p + 0);
    var b1 = load8(p + 1);
    var b2 = load8(p + 2);
    var b3 = load8(p + 3);
    store64(cur + CUR_POS_OFFSET, load64(cur + CUR_POS_OFFSET) + 4);
    return ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 4294967295;
}

# Read a big-endian u16 and advance 2 bytes. JPEG segment lengths are 2-byte
# big-endian (ITU-T T.81 § B.1.1.4). Masked to 16 bits. Caller checks
# _cur_can_read(cur, 2) first; returns 0 defensively on OOB (never an OOB load).
fn _cur_u16_be(cur): i64 {
    if (_cur_can_read(cur, 2) == 0) { return 0; }
    var p = load64(cur + CUR_BASE_OFFSET) + load64(cur + CUR_POS_OFFSET);
    var b0 = load8(p + 0);
    var b1 = load8(p + 1);
    store64(cur + CUR_POS_OFFSET, load64(cur + CUR_POS_OFFSET) + 2);
    return ((b0 << 8) | b1) & 65535;
}

# Absolute pointer at the cursor's current position (for chunk-data
# scanning without copying). Caller validates the span via _cur_can_read.
fn _cur_ptr(cur): i64 {
    return load64(cur + CUR_BASE_OFFSET) + load64(cur + CUR_POS_OFFSET);
}

# Skip `n` bytes forward (no bounds clamp — caller pre-validates).
fn _cur_skip(cur, n): i64 {
    store64(cur + CUR_POS_OFFSET, load64(cur + CUR_POS_OFFSET) + n);
    return 0;
}

# ================================================================
# Signature check — pure in-memory, length-validated.
# ================================================================
# @public
fn chitra_png_check_signature(src, len): i64 {
    if (len < CHITRA_PNG_MAGIC_LEN) { return 0; }
    return memeq(src, CHITRA_PNG_MAGIC, CHITRA_PNG_MAGIC_LEN);
}

# ================================================================
# Chunk-type predicates — 4-byte case-sensitive ASCII (spec § 5.4).
# `p` points at the 4 type bytes.
# ================================================================
fn _chunk_is(p, c0, c1, c2, c3): i64 {
    if (load8(p + 0) == c0 && load8(p + 1) == c1 &&
      load8(p + 2) == c2 && load8(p + 3) == c3) { return 1; }
    return 0;
}
fn _chunk_is_ihdr(p): i64 { return _chunk_is(p, 0x49, 0x48, 0x44, 0x52); }
fn _chunk_is_idat(p): i64 { return _chunk_is(p, 0x49, 0x44, 0x41, 0x54); }
fn _chunk_is_iend(p): i64 { return _chunk_is(p, 0x49, 0x45, 0x4E, 0x44); }
fn _chunk_is_plte(p): i64 { return _chunk_is(p, 0x50, 0x4C, 0x54, 0x45); }
fn _chunk_is_trns(p): i64 { return _chunk_is(p, 0x74, 0x52, 0x4E, 0x53); }

# ================================================================
# Color-type -> channels-per-pixel (spec § 11.2.2 Table 11.1):
#   0 greyscale -> 1   2 RGB -> 3   3 palette -> 1
#   4 grey+alpha -> 2  6 RGBA -> 4
# Returns -1 for an unknown color type.
# ================================================================
fn chitra_png_color_channels(color_type): i64 {
    if (color_type == 0) { return 1; }
    if (color_type == 2) { return 3; }
    if (color_type == 3) { return 1; }
    if (color_type == 4) { return 2; }
    if (color_type == 6) { return 4; }
    return 0 - 1;
}

# ================================================================
# Depth/packing helpers (chitra 0.2.1 — sub-byte depths + Adam7).
# A scanline is `channels * bit_depth` bits per pixel, packed MSB-first,
# each row padded up to a whole byte (spec § 7.2). row_bytes is that
# padded byte count; filter_bpp is bytes-per-pixel for the unfilter
# stride, rounded UP to a minimum of 1 (spec § 9: bpp = ceil(bits/8)).
# ================================================================
fn _chitra_row_bytes_for(width, channels, depth): i64 {
    return (width * channels * depth + 7) / 8;
}
fn _chitra_filter_bpp_for(channels, depth): i64 {
    return (channels * depth + 7) / 8;
}

# Read a sub-byte sample (depth ∈ {1,2,4}) at pixel index x within a
# packed row, MSB-first. Samples never cross a byte boundary at these
# depths (1/2/4 all divide 8).
fn _chitra_get_subbyte(row, x, depth): i64 {
    var bit_index = x * depth;
    var byte_index = bit_index / 8;
    var bit_off = bit_index % 8;          # bits from the MSB of that byte
    var shift = 8 - depth - bit_off;
    var b = load8(row + byte_index);
    var mask = (1 << depth) - 1;
    return (b >> shift) & mask;
}

# Write a sub-byte sample (depth ∈ {1,2,4}) at pixel index x into a
# packed row, MSB-first, leaving the other bits of the byte intact
# (used by the Adam7 deinterlace scatter). `mask ^ 255` is the byte-wide
# complement (avoids relying on a full-width bitwise-not).
fn _chitra_set_subbyte(row, x, depth, val): i64 {
    var bit_index = x * depth;
    var byte_index = bit_index / 8;
    var bit_off = bit_index % 8;
    var shift = 8 - depth - bit_off;
    var mask = ((1 << depth) - 1) << shift;
    var b = load8(row + byte_index);
    b = (b & (mask ^ 255)) | ((val << shift) & mask);
    store8(row + byte_index, b);
    return 0;
}

# Scale a sub-byte grayscale sample to 8-bit: value * 255 / (2^depth - 1)
# — exact integer for depths 1/2/4 (×255, ×85, ×17), matching the PNG
# spec's sample-depth scaling so output equals a reference decoder's.
fn _chitra_gray_scale(depth): i64 {
    if (depth == 1) { return 255; }
    if (depth == 2) { return 85; }
    if (depth == 4) { return 17; }
    return 1;
}

# --- png_filter.cyr ---

# @internal — PNG unfilter predictors + the raw-decode driver.
# png_filter.cyr — the five PNG filter-undo predictors (spec § 9) and
# chitra_png_parse_raw, the top-level byte-buffer framing driver that
# produces a ChitraPngRaw (parsed IHDR + inflated, unfiltered scanlines).
#
# Forked from kii/src/png.cyr's _png_paeth / _png_unfilter_row and
# png_decode_pixels, re-shaped onto the byte-buffer cursor in
# png_chunks.cyr. The canonical-RGBA8 color pass consumes the
# ChitraPngRaw this returns; the public chitra_png_decode wraps
# both. Everything here returns a ChitraErr ptr on any failure path —
# never an OOB access or crash on untrusted input.

# ================================================================
# Paeth predictor (spec § 9.4) — picks whichever of left (a) / above
# (b) / above-left (c) is closest to the linear estimate a+b-c. Ties
# resolve left -> up -> up-left, matching the spec ordering.
# ================================================================
fn _chitra_paeth(a, b, c): i64 {
    var p = a + b - c;
    var pa = p - a;
    if (pa < 0) { pa = 0 - pa; }
    var pb = p - b;
    if (pb < 0) { pb = 0 - pb; }
    var pc = p - c;
    if (pc < 0) { pc = 0 - pc; }
    if (pa <= pb && pa <= pc) { return a; }
    if (pb <= pc) { return b; }
    return c;
}

# ================================================================
# Undo one scanline's filter (spec § 9). `prev_row` is the previous
# RAW (post-undo) row; pass an all-zero row for row 0. `curr_in` points
# at the filtered data (after the filter-type byte). `out_row` receives
# `row_bytes` reconstructed bytes. `bpp` is bytes-per-pixel (the filter
# corresponds left at a `bpp` stride). Returns 0 on success, -1 for a
# filter type not in {0,1,2,3,4}.
# ================================================================
fn _chitra_unfilter_row(prev_row, curr_in, out_row, row_bytes, bpp, filter_type): i64 {
    var i = 0;
    if (filter_type == 0) {
        # None — passthrough.
        while (i < row_bytes) {
            store8(out_row + i, load8(curr_in + i));
            i = i + 1;
        }
        return 0;
    }
    if (filter_type == 1) {
        # Sub — out[i] = in[i] + (i<bpp ? 0 : out[i-bpp])
        while (i < row_bytes) {
            var left = 0;
            if (i >= bpp) { left = load8(out_row + i - bpp); }
            store8(out_row + i, (load8(curr_in + i) + left) & 0xFF);
            i = i + 1;
        }
        return 0;
    }
    if (filter_type == 2) {
        # Up — out[i] = in[i] + prev[i]
        while (i < row_bytes) {
            var up = load8(prev_row + i);
            store8(out_row + i, (load8(curr_in + i) + up) & 0xFF);
            i = i + 1;
        }
        return 0;
    }
    if (filter_type == 3) {
        # Average — out[i] = in[i] + floor((left + up) / 2)
        while (i < row_bytes) {
            var left = 0;
            if (i >= bpp) { left = load8(out_row + i - bpp); }
            var up = load8(prev_row + i);
            store8(out_row + i, (load8(curr_in + i) + ((left + up) / 2)) & 0xFF);
            i = i + 1;
        }
        return 0;
    }
    if (filter_type == 4) {
        # Paeth — out[i] = in[i] + paeth(left, up, up-left)
        while (i < row_bytes) {
            var left = 0;
            var up_left = 0;
            if (i >= bpp) {
                left = load8(out_row + i - bpp);
                up_left = load8(prev_row + i - bpp);
            }
            var up = load8(prev_row + i);
            store8(out_row + i, (load8(curr_in + i) + _chitra_paeth(left, up, up_left)) & 0xFF);
            i = i + 1;
        }
        return 0;
    }
    return 0 - 1;
}

# ================================================================
# Walk the inflated stream applying filter-undo per row -> raw scanline
# bytes. `inflated` holds height*(1+row_bytes) bytes; `pixels` receives
# height*row_bytes reconstructed bytes (caller-allocated, both sized by
# the validated dimension math). Returns 0 on success, -1 on a bad
# filter byte (caller maps to CHITRA_ERR_FILTER).
# ================================================================
fn _chitra_unfilter_image(inflated, pixels, zero_row, height, row_bytes, bpp): i64 {
    var prev = zero_row;
    var r = 0;
    while (r < height) {
        var row_off = r * (1 + row_bytes);
        var filter_byte = load8(inflated + row_off);
        var curr_in = inflated + row_off + 1;
        var out_row = pixels + r * row_bytes;
        var rc = _chitra_unfilter_row(prev, curr_in, out_row, row_bytes, bpp, filter_byte);
        if (rc != 0) { return 0 - 1; }
        prev = out_row;
        r = r + 1;
    }
    return 0;
}

# ================================================================
# IHDR parse helper. `cur` is positioned at the start of the IHDR chunk
# (its 4-byte length field). Validates length==13, type=="IHDR", CRC,
# and the supported-feature gates, then stores width/height/bit_depth/
# color_type/channels into `raw`. Returns a ChitraErr ptr, or 0 on OK.
# Advances the cursor past the whole IHDR chunk (len+type+data+crc).
# ================================================================
fn _chitra_parse_ihdr(cur, raw): i64 {
    # Need at least 4(len)+4(type)+13(data)+4(crc) = 25 bytes.
    if (_cur_can_read(cur, 25) == 0) { return chitra_err(CHITRA_ERR_TRUNCATED); }
    var chunk_len = _cur_u32_be(cur);
    if (chunk_len != 13) { return chitra_err(CHITRA_ERR_BAD_CHUNK); }

    # CRC covers the 4 type bytes + 13 data bytes (spec § 5.3 — length
    # is excluded). Compute over the 17 bytes at the current position
    # before consuming them.
    var crc_ptr = _cur_ptr(cur);
    var type_ptr = crc_ptr;
    if (_chunk_is_ihdr(type_ptr) == 0) { return chitra_err(CHITRA_ERR_BAD_CHUNK); }

    var computed = crc32(crc_ptr, 17);
    _cur_skip(cur, 4);                     # past type
    var data_ptr = _cur_ptr(cur);
    _cur_skip(cur, 13);                    # past 13 data bytes
    var stored = _cur_u32_be(cur);         # 4-byte CRC
    if ((computed & 4294967295) != (stored & 4294967295)) {
        return chitra_err(CHITRA_ERR_CRC);
    }

    # IHDR data layout (13 bytes):
    #   0..3  width (u32 BE)   4..7  height (u32 BE)
    #   8     bit_depth        9     color_type
    #   10    compression      11    filter      12    interlace
    var width = ((load8(data_ptr + 0) << 24) | (load8(data_ptr + 1) << 16) |
      (load8(data_ptr + 2) << 8) | load8(data_ptr + 3)) & 4294967295;
    var height = ((load8(data_ptr + 4) << 24) | (load8(data_ptr + 5) << 16) |
      (load8(data_ptr + 6) << 8) | load8(data_ptr + 7)) & 4294967295;
    var bit_depth = load8(data_ptr + 8);
    var color_type = load8(data_ptr + 9);
    var comp_method = load8(data_ptr + 10);
    var filter_method = load8(data_ptr + 11);
    var interlace = load8(data_ptr + 12);

    # ---- supported-feature gates (fail loud, never half-decode) ----
    var channels = chitra_png_color_channels(color_type);
    if (channels < 0) { return chitra_err(CHITRA_ERR_UNSUPPORTED); }
    # Compression + filter methods: spec § 11.2.2 defines ONLY method 0 for
    # each. Reject any other loud rather than mis-decoding a spoofed header.
    if (comp_method != 0) { return chitra_err(CHITRA_ERR_UNSUPPORTED); }
    if (filter_method != 0) { return chitra_err(CHITRA_ERR_UNSUPPORTED); }
    # Interlace: 0 = none, 1 = Adam7 — both supported as of chitra 0.2.1.
    if (interlace != 0 && interlace != 1) { return chitra_err(CHITRA_ERR_INTERLACE); }
    # bit-depth × color-type validity (spec § 11.2.2 Table 11.1):
    #   ct0 gray   : 1/2/4/8/16     ct2 RGB    : 8/16
    #   ct3 palette: 1/2/4/8        ct4 gray+a : 8/16     ct6 RGBA: 8/16
    var depth_ok = 0;
    if (color_type == 0) {
        if (bit_depth == 1 || bit_depth == 2 || bit_depth == 4 ||
          bit_depth == 8 || bit_depth == 16) { depth_ok = 1; }
    } else { if (color_type == 3) {
            if (bit_depth == 1 || bit_depth == 2 || bit_depth == 4 ||
              bit_depth == 8) { depth_ok = 1; }
        } else {
            if (bit_depth == 8 || bit_depth == 16) { depth_ok = 1; }
        } }
    if (depth_ok == 0) { return chitra_err(CHITRA_ERR_BIT_DEPTH); }

    # ---- dimension caps (kii audit finding 1) ----
    # width/height are attacker-controlled u32 fields. Cap before the
    # width*height*bpp multiply so a lying IHDR can't wrap i64 / demand
    # a multi-GB alloc.
    if (width <= 0 || height <= 0) { return chitra_err(CHITRA_ERR_DIMENSIONS); }
    if (width > CHITRA_MAX_DIM || height > CHITRA_MAX_DIM) {
        return chitra_err(CHITRA_ERR_DIMENSIONS);
    }
    if (width * height > CHITRA_MAX_PIXELS) {
        return chitra_err(CHITRA_ERR_DIMENSIONS);
    }

    store64(raw + RAW_WIDTH_OFFSET, width);
    store64(raw + RAW_HEIGHT_OFFSET, height);
    store64(raw + RAW_BIT_DEPTH_OFFSET, bit_depth);
    store64(raw + RAW_COLOR_TYPE_OFFSET, color_type);
    store64(raw + RAW_CHANNELS_OFFSET, channels);
    store64(raw + RAW_INTERLACE_OFFSET, interlace);
    return 0;
}

# ================================================================
# Adam7 interlace (spec § 8). Seven passes, each a reduced sub-image
# at a fixed (x_start, y_start) offset and (x_step, y_step) stride.
# ================================================================
fn _adam7_xs(p): i64 {
    if (p == 0) { return 0; }   if (p == 1) { return 4; }
    if (p == 2) { return 0; }   if (p == 3) { return 2; }
    if (p == 4) { return 0; }   if (p == 5) { return 1; }
    return 0;
}
fn _adam7_ys(p): i64 {
    if (p == 0) { return 0; }   if (p == 1) { return 0; }
    if (p == 2) { return 4; }   if (p == 3) { return 0; }
    if (p == 4) { return 2; }   if (p == 5) { return 0; }
    return 1;
}
fn _adam7_xstep(p): i64 {
    if (p == 0) { return 8; }   if (p == 1) { return 8; }
    if (p == 2) { return 4; }   if (p == 3) { return 4; }
    if (p == 4) { return 2; }   if (p == 5) { return 2; }
    return 1;
}
fn _adam7_ystep(p): i64 {
    if (p == 0) { return 8; }   if (p == 1) { return 8; }
    if (p == 2) { return 8; }   if (p == 3) { return 4; }
    if (p == 4) { return 4; }   if (p == 5) { return 2; }
    return 2;
}

# Pixels in a pass row / column for an image of (width|height): the count
# of grid points at (start, step) within the dimension. 0 if start>=dim.
fn _adam7_count(dim, start, step): i64 {
    if (dim <= start) { return 0; }
    return (dim - start + step - 1) / step;
}

# Total inflated (post-DEFLATE, pre-unfilter) byte count for an Adam7
# stream: sum over the 7 passes of pass_h * (1 filter byte + pass_row_bytes).
# Empty passes contribute nothing. Must match the deinterlace walk exactly.
fn _chitra_adam7_inflated_size(width, height, channels, depth): i64 {
    var bpp_bits = channels * depth;
    var total = 0;
    var p = 0;
    while (p < 7) {
        var pw = _adam7_count(width, _adam7_xs(p), _adam7_xstep(p));
        var ph = _adam7_count(height, _adam7_ys(p), _adam7_ystep(p));
        if (pw > 0 && ph > 0) {
            var prow = (pw * bpp_bits + 7) / 8;
            total = total + ph * (1 + prow);
        }
        p = p + 1;
    }
    return total;
}

# Deinterlace an Adam7 inflated stream into the dense, byte-padded
# `pixels` buffer (same layout the non-interlaced path produces, so the
# color pass is interlace-agnostic). Each pass is filtered independently
# (fresh zero prev-row), then its pixels are scattered to their full-image
# positions — byte-copied at depth >= 8, bit-set at sub-byte depths.
# Returns 0; on failure sets *err_out and returns -1.
fn _chitra_deinterlace(inflated, pixels, width, height, channels, depth, err_out): i64 {
    var row_bytes_full = _chitra_row_bytes_for(width, channels, depth);
    var bpp_bits = channels * depth;
    var filter_bpp = _chitra_filter_bpp_for(channels, depth);

    # Zero the dense buffer: sub-byte scatter sets individual samples, and
    # row-end padding bits must read as 0.
    var total = height * row_bytes_full;
    var z = 0;
    while (z < total) { store8(pixels + z, 0); z = z + 1; }

    # Two ping-pong pass-row buffers (reconstructed rows) + a zero prev for
    # each pass's first scanline. Sized to the full row (>= any pass row).
    var buf_a = alloc(row_bytes_full);
    var buf_b = alloc(row_bytes_full);
    var zr = alloc(row_bytes_full);
    if (buf_a == 0 || buf_b == 0 || zr == 0) {
        store64(err_out, chitra_err(CHITRA_ERR_OOM));
        return 0 - 1;
    }
    var zi = 0;
    while (zi < row_bytes_full) { store8(zr + zi, 0); zi = zi + 1; }

    var off = 0;
    var pass = 0;
    while (pass < 7) {
        var xs = _adam7_xs(pass);
        var ys = _adam7_ys(pass);
        var xstep = _adam7_xstep(pass);
        var ystep = _adam7_ystep(pass);
        var pass_w = _adam7_count(width, xs, xstep);
        var pass_h = _adam7_count(height, ys, ystep);
        if (pass_w > 0 && pass_h > 0) {
            var prow_bytes = (pass_w * bpp_bits + 7) / 8;
            var prev = zr;
            var cur = buf_a;
            var py = 0;
            while (py < pass_h) {
                var fb = load8(inflated + off);
                var cin = inflated + off + 1;
                off = off + 1 + prow_bytes;
                var rc = _chitra_unfilter_row(prev, cin, cur, prow_bytes, filter_bpp, fb);
                if (rc != 0) {
                    store64(err_out, chitra_err(CHITRA_ERR_FILTER));
                    return 0 - 1;
                }
                var full_y = ys + py * ystep;
                if (bpp_bits >= 8) {
                    var bytes_pp = bpp_bits / 8;
                    var px = 0;
                    while (px < pass_w) {
                        var full_x = xs + px * xstep;
                        var dstp = pixels + full_y * row_bytes_full + full_x * bytes_pp;
                        var srcp = cur + px * bytes_pp;
                        var k = 0;
                        while (k < bytes_pp) { store8(dstp + k, load8(srcp + k)); k = k + 1; }
                        px = px + 1;
                    }
                } else {
                    var dstrow = pixels + full_y * row_bytes_full;
                    var px2 = 0;
                    while (px2 < pass_w) {
                        var full_x2 = xs + px2 * xstep;
                        var val = _chitra_get_subbyte(cur, px2, depth);
                        _chitra_set_subbyte(dstrow, full_x2, depth, val);
                        px2 = px2 + 1;
                    }
                }
                prev = cur;
                if (cur == buf_a) { cur = buf_b; } else { cur = buf_a; }
                py = py + 1;
            }
        }
        pass = pass + 1;
    }
    return 0;
}

# ================================================================
# chitra_png_parse_raw — the parse-stage top-level. Turns (src, len) PNG
# bytes into a ChitraPngRaw (parsed IHDR + inflated, unfiltered raw
# scanlines + captured PLTE/tRNS spans). Returns the ChitraPngRaw ptr
# on success, or 0 on failure with the ChitraErr written through
# `err_out` (a >=8-byte slot holding a ChitraErr ptr). On the success
# path *err_out is left at 0.
#
# Pass 1 walks every chunk: validates each CRC, parses IHDR, sums IDAT
# payload lengths, captures PLTE/tRNS spans, stops at IEND. Pass 2
# concatenates the IDAT payloads, inflates (with the bomb caps), and
# unfilters into the scanline buffer.
# ================================================================
fn chitra_png_parse_raw(src, len, err_out): i64 {
    store64(err_out, 0);

    # crc32() needs its slice-by-8 table built first (it does not lazy-
    # init). Idempotent — cheap to call per decode.
    # ⛔⛔ THE RETURN IS LOAD-BEARING (B-1, 1.0.3). sankoch allocates the 16 KB
    # slice-by-8 table here and returns `-ERR_OOM` when the arena cannot give
    # it. Discarding that left `crc32_table` at 0, and the very next `crc32()`
    # in _chitra_parse_ihdr read through a NULL base — SIGSEGV on a perfectly
    # valid PNG, in place of the documented `(0, *err_out = CHITRA_ERR_OOM)`.
    # ⚠ No hostile file is involved: the trigger is arena state, so the file
    # that dies is the FIRST PNG a memory-pressured process decodes.
    if (crc32_init_table() < 0) {
        store64(err_out, chitra_err(CHITRA_ERR_OOM));
        return 0;
    }

    # ---- signature ----
    if (chitra_png_check_signature(src, len) == 0) {
        store64(err_out, chitra_err(CHITRA_ERR_SIGNATURE));
        return 0;
    }

    var raw = alloc(CHITRA_PNG_RAW_SIZE);
    if (raw == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    var z = 0;
    while (z < CHITRA_PNG_RAW_SIZE) { store8(raw + z, 0); z = z + 1; }

    var cur[24];
    _cur_init(&cur, src, len);
    _cur_skip(&cur, CHITRA_PNG_MAGIC_LEN);    # past the 8-byte signature

    # IHDR must be the first chunk (spec § 11.2.2).
    var ihdr_err = _chitra_parse_ihdr(&cur, raw);
    if (ihdr_err != 0) { store64(err_out, ihdr_err); return 0; }

    # ---- pass 1: chunk walk (CRC every chunk, capture spans) ----
    var idat_total = 0;
    var seen_iend = 0;
    var seen_plte = 0;
    # Ordering state must be tracked as a SEEN FLAG, not inferred from
    # idat_total: a zero-length IDAT is spec-legal and adds 0 to the total,
    # so "idat_total > 0" let a PLTE (or tRNS) slip in after IDAT simply by
    # prefixing an empty IDAT chunk.
    var seen_idat = 0;
    var idat_closed = 0;   # § 5.6: set once a non-IDAT chunk follows the IDAT run
    var seen_trns = 0;
    var walking = 1;
    while (walking == 1) {
        # A chunk header is 8 bytes (4 length + 4 type). Fewer remaining
        # bytes with no IEND yet = truncated stream. Exactly 0 left is a
        # clean (if IEND-less) end; spec § 5.3 tolerates a missing IEND,
        # but we treat truncation conservatively.
        var rem = _cur_remaining(&cur);
        if (rem == 0) { walking = 0; }
        else { if (rem < 8) {
                store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
                return 0;
            } else {

                var chunk_len = _cur_u32_be(&cur);
                var type_ptr = _cur_ptr(&cur);
                # chunk_len must not exceed the remaining data (after the 4 type
                # bytes) plus the 4 CRC bytes. Validate before any scan.
                if (chunk_len > CHITRA_MAX_RAW_BYTES) {
                    store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                    return 0;
                }
                # remaining-after-type must hold chunk_len data + 4 CRC.
                if (_cur_remaining(&cur) < 4 + chunk_len + 4) {
                    store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
                    return 0;
                }

                var is_idat = _chunk_is_idat(type_ptr);
                var is_iend = _chunk_is_iend(type_ptr);
                var is_plte = _chunk_is_plte(type_ptr);
                var is_trns = _chunk_is_trns(type_ptr);

                # CRC covers type(4) + data(chunk_len). Compute over the
                # contiguous span at type_ptr, then compare against the stored
                # CRC after the data.
                var computed = crc32(type_ptr, 4 + chunk_len);
                _cur_skip(&cur, 4);                  # past type
                var data_off = _cur_pos(&cur);       # byte offset of data within src
                var data_ptr = _cur_ptr(&cur);
                _cur_skip(&cur, chunk_len);          # past data
                var stored = _cur_u32_be(&cur);      # 4-byte CRC
                if ((computed & 4294967295) != (stored & 4294967295)) {
                    store64(err_out, chitra_err(CHITRA_ERR_CRC));
                    return 0;
                }

                if (is_idat == 1) {
                    # Spec § 5.6: "there shall not be any other chunks between
                    # the IDAT chunks". chitra fused every IDAT it met through
                    # 0.7.0 regardless of what sat between them, so a stream
                    # with IDAT / tEXt / IDAT decoded as though the two payloads
                    # were adjacent — a different image than the file describes,
                    # with no error. The ordering family this belongs to
                    # (PLTE 0.3.3, tRNS 0.5.3) was enforced; the IDAT half of
                    # the same sentence never was, while CLAUDE.md's hardening
                    # checklist claimed chunk ordering as a PNG guard.
                    if (idat_closed == 1) {
                        store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                        return 0;
                    }
                    seen_idat = 1;
                    idat_total = idat_total + chunk_len;
                    if (idat_total > CHITRA_MAX_RAW_BYTES) {
                        store64(err_out, chitra_err(CHITRA_ERR_OOM));
                        return 0;
                    }
                }
                if (is_plte == 1) {
                    # Spec § 5.5 / 5.6: at most one PLTE, must precede IDAT,
                    # length a multiple of 3, <= 768. Capture the span (bytes
                    # processed by the color pass, not here).
                    if (seen_plte == 1)      { store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK)); return 0; }
                    if (seen_idat == 1)      { store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK)); return 0; }
                    if (chunk_len > 768)     { store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK)); return 0; }
                    if (chunk_len % 3 != 0)  { store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK)); return 0; }
                    # § 11.2.3: PLTE is REQUIRED for colour type 3, OPTIONAL
                    # for 2 and 6 (a suggested palette), and FORBIDDEN for 0
                    # and 4 — a greyscale image has no palette to suggest.
                    # chitra accepted it on every type through 0.7.0, which is
                    # the same leniency it refuses one branch below for tRNS.
                    if (load64(raw + RAW_COLOR_TYPE_OFFSET) == 0) {
                        store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                        return 0;
                    }
                    if (load64(raw + RAW_COLOR_TYPE_OFFSET) == 4) {
                        store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                        return 0;
                    }
                    store64(raw + RAW_PLTE_OFF_OFFSET, data_off);
                    store64(raw + RAW_PLTE_LEN_OFFSET, chunk_len);
                    seen_plte = 1;
                }
                if (is_trns == 1) {
                    # Spec § 5.6 / 11.3.2: at most one tRNS, it must precede
                    # IDAT, and for a palette image it must follow PLTE. The
                    # sibling PLTE branch above has always enforced its
                    # ordering; tRNS had none, so a second tRNS silently
                    # overwrote the first span and a post-IDAT tRNS was honoured
                    # against already-committed pixel data. Length/color-type
                    # validation stays in the color pass, which is where the
                    # color type is known.
                    if (seen_trns == 1) { store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK)); return 0; }
                    if (seen_idat == 1) { store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK)); return 0; }
                    # ...and for a PALETTE image it must FOLLOW PLTE, because
                    # its entries are per-palette-entry alphas and mean nothing
                    # before the palette they index exists. The comment above
                    # has claimed this rule since 0.3.3; the code enforced only
                    # the other two until 0.5.3.
                    if (load64(raw + RAW_COLOR_TYPE_OFFSET) == 3) {
                        if (seen_plte == 0) {
                            store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                            return 0;
                        }
                    }
                    # § 11.3.2: tRNS is FORBIDDEN for colour types 4 and 6 —
                    # they already carry a full alpha channel, so a tRNS would
                    # be a second, contradictory statement about the same
                    # pixels. chitra accepted it and silently ignored it, which
                    # left its posture inverted: it REJECTS tRNS-before-PLTE, an
                    # ordering ImageMagick tolerates, while ACCEPTING a chunk
                    # the spec forbids outright.
                    if (load64(raw + RAW_COLOR_TYPE_OFFSET) == 4) {
                        store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                        return 0;
                    }
                    if (load64(raw + RAW_COLOR_TYPE_OFFSET) == 6) {
                        store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                        return 0;
                    }
                    store64(raw + RAW_TRNS_OFF_OFFSET, data_off);
                    store64(raw + RAW_TRNS_LEN_OFFSET, chunk_len);
                    seen_trns = 1;
                }
                # The IDAT run ends at the first chunk that is not one. Note
                # this is set for ANY other chunk, ancillary or critical — the
                # spec's sentence has no exceptions, and an ancillary chunk is
                # exactly what a naive writer interleaves.
                if (is_idat == 0) {
                    if (seen_idat == 1) { idat_closed = 1; }
                }

                # Spec § 5.4: bit 5 of the first type byte is the ancillary
                # bit — clear (uppercase) means CRITICAL. A decoder that does
                # not recognise a critical chunk MUST abort, because that chunk
                # changes how the image is to be interpreted. Skipping it, as
                # this walk previously did, means happily rendering a stream
                # whose meaning we demonstrably do not understand. Ancillary
                # chunks (gAMA, pHYs, tEXt, ...) stay safely skippable.
                if ((load8(type_ptr) & 0x20) == 0) {
                    var known = 0;
                    if (is_idat == 1) { known = 1; }
                    if (is_iend == 1) { known = 1; }
                    if (is_plte == 1) { known = 1; }
                    if (known == 0) {
                        store64(err_out, chitra_err(CHITRA_ERR_UNSUPPORTED));
                        return 0;
                    }
                }
                if (is_iend == 1) {
                    # IEND carries no data (spec § 11.2.5) — a non-zero
                    # length is a malformed stream, reject loud.
                    if (chunk_len != 0) {
                        store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                        return 0;
                    }
                    seen_iend = 1;
                    walking = 0;
                }

            } }
    }

    # Surface whether an IEND closed the stream (vs a tolerated clean
    # IEND-less end) so the public image can carry it to the caller.
    store64(raw + RAW_SEEN_IEND_OFFSET, seen_iend);

    # ---- derive sizes (validated dims from IHDR) ----
    var width = load64(raw + RAW_WIDTH_OFFSET);
    var height = load64(raw + RAW_HEIGHT_OFFSET);
    var channels = load64(raw + RAW_CHANNELS_OFFSET);
    var bit_depth = load64(raw + RAW_BIT_DEPTH_OFFSET);
    var interlace = load64(raw + RAW_INTERLACE_OFFSET);
    # Dense, byte-padded output scanlines (channels*depth bits/pixel, each
    # row padded to a byte). filter_bpp is the unfilter stride: ceil(bits/8),
    # which is 1 for sub-byte depths and channels*bytes for depth >= 8.
    var row_bytes = _chitra_row_bytes_for(width, channels, bit_depth);
    var filter_bpp = _chitra_filter_bpp_for(channels, bit_depth);
    var pixel_size = height * row_bytes;
    # Inflated (post-DEFLATE) size: one filter byte per scanline. For Adam7
    # that is summed across the 7 reduced passes; otherwise it is height rows.
    var inflated_size = 0;
    if (interlace == 1) {
        inflated_size = _chitra_adam7_inflated_size(width, height, channels, bit_depth);
    } else {
        inflated_size = height * (1 + row_bytes);
    }
    if (inflated_size > CHITRA_MAX_RAW_BYTES) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    if (pixel_size > CHITRA_MAX_RAW_BYTES) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    # No IDAT at all — structurally valid but no pixels. Distinct from a
    # lying-IHDR dimension failure (those trip the caps above) so callers
    # can report "no pixel data" specifically.
    if (idat_total == 0) {
        store64(err_out, chitra_err(CHITRA_ERR_NO_IDAT));
        return 0;
    }
    # Decompression-bomb ratio cap (kii finding 3): inflated/idat above
    # DEFLATE's 1032:1 ceiling is a bomb. idat_total > 0 here, so the
    # divide is safe.
    if ((inflated_size / idat_total) > CHITRA_MAX_INFLATE_RATIO) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    # ⛔ ORDER IS LOAD-BEARING: THIS SITS AFTER THE BOMB CAPS, NOT BEFORE THEM. A tiny IDAT claiming
    # a 3000x3000 image is a decompression BOMB and must keep being reported as one
    # (`CHITRA_ERR_DIMENSIONS`); only a stream whose ratio is plausible — a real photograph — reaches
    # here and earns the "too large for this decompressor" answer. A first draft checked first and
    # silently reclassified every bomb.
    # ⛔⛔ REFUSE BEFORE ALLOCATING WHAT THE DECOMPRESSOR WILL NOT FILL (1.0.1).
    # `CHITRA_MAX_RAW_BYTES` is 256 MB — **sixteen times** what `sankoch` will actually emit. So a
    # 4096x2160 RGB PNG (26.5 MB inflated) passed every check above, chitra allocated the IDAT
    # concatenation AND the 26.5 MB inflate buffer, called `zlib_decompress`, and got
    # `ERR_OUTPUT_LIMIT` back — which was reported as a bare `CHITRA_ERR_INFLATE`.
    # ⚠ MEASURED by crab, 2026-08-31: **26,617,512 bytes spent to return 0.** On a bump allocator
    # with no `free()` — which is what cyrius ships — those bytes never come back. A consumer
    # thumbnailing a photo directory exhausted memory learning nothing.
    # ⭐ THE CEILING IS READ FROM sankoch, NOT COPIED. `DECOMPRESS_MAX_OUTPUT` is the value the
    # decoder itself enforces; hardcoding 16777216 here would be a second number meaning the same
    # thing, free to drift the moment sankoch raises its backstop.
    # ⛔ AND IT IS ITS OWN ERROR CODE. `CHITRA_ERR_INFLATE` cannot distinguish a corrupt stream from
    # a valid image too large for this build, and those two want opposite things from a caller.
    if (inflated_size > DECOMPRESS_MAX_OUTPUT) {
        store64(err_out, chitra_err(CHITRA_ERR_INFLATE_LIMIT));
        return 0;
    }

    # ---- pass 2: concatenate IDAT payloads ----
    var idat_buf = alloc(idat_total);
    if (idat_buf == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    var cur2[24];
    _cur_init(&cur2, src, len);
    _cur_skip(&cur2, CHITRA_PNG_MAGIC_LEN);
    _cur_skip(&cur2, 25);                   # past the validated IHDR chunk
    var copied = 0;
    var walking2 = 1;
    while (walking2 == 1) {
        if (_cur_remaining(&cur2) < 8) { walking2 = 0; }
        else {
            var clen = _cur_u32_be(&cur2);
            var tptr = _cur_ptr(&cur2);
            var is_i = _chunk_is_idat(tptr);
            var is_e = _chunk_is_iend(tptr);
            _cur_skip(&cur2, 4);            # past type
            if (is_i == 1 && clen > 0) {
                memcpy(idat_buf + copied, _cur_ptr(&cur2), clen);
                copied = copied + clen;
            }
            _cur_skip(&cur2, clen);         # past data
            _cur_skip(&cur2, 4);            # past CRC
            if (is_e == 1) { walking2 = 0; }
        }
    }

    # ---- inflate ----
    var inflated = alloc(inflated_size);
    if (inflated == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    var n = zlib_decompress(idat_buf, idat_total, inflated, inflated_size);
    if (n < 0) { store64(err_out, chitra_err(CHITRA_ERR_INFLATE)); return 0; }
    if (n != inflated_size) { store64(err_out, chitra_err(CHITRA_ERR_INFLATE)); return 0; }

    # ---- reconstruct dense packed scanlines: unfilter (non-interlaced)
    # or deinterlace (Adam7). Both produce the same byte-padded layout the
    # color pass consumes, so the color pass is interlace-agnostic. ----
    var pixels = alloc(pixel_size);
    if (pixels == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    if (interlace == 1) {
        var dc = _chitra_deinterlace(inflated, pixels, width, height, channels, bit_depth, err_out);
        if (dc != 0) { return 0; }     # *err_out already set by deinterlace
    } else {
        var zero_row = alloc(row_bytes);
        if (zero_row == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
        var zr = 0;
        while (zr < row_bytes) { store8(zero_row + zr, 0); zr = zr + 1; }
        var fc = _chitra_unfilter_image(inflated, pixels, zero_row, height, row_bytes, filter_bpp);
        if (fc != 0) { store64(err_out, chitra_err(CHITRA_ERR_FILTER)); return 0; }
    }

    store64(raw + RAW_SCANLINES_OFFSET, pixels);
    store64(raw + RAW_SCANLINES_LEN_OFFSET, pixel_size);
    return raw;
}

# --- png_color.cyr ---

# @internal — canonical-RGBA8 color-normalization pass.
# png_color.cyr — turn a ChitraPngRaw (parsed IHDR + unfiltered raw
# scanlines + captured PLTE/tRNS spans) into an owned RGBA8 pixel
# buffer (width*height*4). This is the genuinely new code over kii:
# kii emits native channels / palette indices for the terminal path;
# chitra normalizes every color type to canonical RGBA8 + synthesizes
# alpha from tRNS.
#
# PLTE/tRNS access wiring (documented choice): the ChitraPngRaw captures
# PLTE/tRNS only as (offset-into-original-src, length) spans — the bytes
# themselves are not retained. chitra_png_parse_raw does NOT copy them
# (no struct widening, no extra allocs on the parse path). The public
# decode entry (png.cyr) still holds the original (src, len), so it
# passes src + len into the color pass, which resolves the spans via
# `src + plte_off` / `src + trns_off`. The parse-time bounds checks
# (every span lies within len; PLTE multiple-of-3 + <=768) already
# validated those offsets, but the color pass re-validates defensively
# against (src, len) so it is safe even if called on a hand-built raw.
#
# This pass handles every spec-legal depth. At depth 8 each sample is one byte
# and the scanline is dense channels-per-pixel with no bit unpacking; 1/2/4 are
# unpacked MSB-first and scaled 255/85/17; 16 is rescaled to 8 per PNG § 13.13
# in _png_scale16 (0.7.1 — it was a high-byte truncation through 0.7.0).

# ================================================================
# Color-type sample-byte sizes (bit depth 8 => 1 byte per channel).
# These mirror chitra_png_color_channels but name the per-color-type
# byte strides the color pass walks the scanline with.
# ================================================================

# ================================================================
# chitra_png_color_to_rgba8 — the color pass.
#
# Inputs:
#   raw  — a ChitraPngRaw with scanlines populated (parse_raw output).
#   src  — the ORIGINAL PNG byte buffer (PLTE/tRNS offsets index here).
#   len  — byte length of src (for defensive span re-validation).
#   err_out — >=8-byte slot; on failure receives a ChitraErr ptr.
#
# Returns an owned RGBA8 buffer (width*height*4 bytes) on success, or 0
# with *err_out set. *err_out is left 0 on the success path.
#
# New reject paths over the parse stage:
#   - palette index >= PLTE entry count        -> CHITRA_ERR_BAD_CHUNK
#   - color_type 3 with no/short PLTE          -> CHITRA_ERR_BAD_CHUNK
#   - tRNS span out of (src, len) bounds       -> CHITRA_ERR_BAD_CHUNK
#   - tRNS wrong length for the color type      -> CHITRA_ERR_BAD_CHUNK
#       (gray:2 bytes, RGB:6 bytes, palette:<=entry_count bytes)
# ================================================================
# _png_scale16 — one 16-bit sample, reduced to 8 bits.
#
# It is a RESCALE, not a truncation: PNG § 13.13 gives the conversion between
# sample depths as
# `floor(input * MAXOUT / MAXIN + 0.5)`, and `(v * 255 + 32767) / 65535` is
# that formula in integer arithmetic (65535/2 = 32767 is the round-half-up
# bias). `v * 255` peaks at 16,711,425, nowhere near an i64 edge.
#
# chitra took the HIGH BYTE through 0.7.0, which is libpng's `png_set_strip_16`
# — a function libpng itself documents as the fast, inaccurate option next to
# `png_set_scale_16`. It is wrong by up to 1 per channel, and it is wrong
# exactly where 16-bit precision was the point of the file: measured on a
# depth-16 grayscale fixture, samples 0x00FF and 0x01FF reduced to 0 and 1
# where ImageMagick gives 1 and 2. The tree's own doc called the reduction
# "unchanged rendered output", which was a claim about a reference nobody had
# checked it against.
# ================================================================
fn _png_scale16(v): i64 {
    return (v * 255 + 32767) / 65535;
}

# ================================================================
fn chitra_png_color_to_rgba8(raw, src, len, err_out): i64 {
    store64(err_out, 0);

    var width = chitra_raw_width(raw);
    var height = chitra_raw_height(raw);
    var color_type = chitra_raw_color_type(raw);
    var channels = chitra_raw_channels(raw);
    var scan = chitra_raw_scanlines(raw);
    var scan_len = chitra_raw_scanlines_len(raw);

    # Bytes per sample: 1 at depth 8, 2 at depth 16. At depth 16 each
    # big-endian sample is truncated to its HIGH byte (offset +0 of the
    # 2-byte pair) — the same lossy 16->8 reduction kii's terminal path
    # used, keeping rendered output byte-identical. Sub-byte depths never
    # reach here (parse_raw rejects 1/2/4), so bps is always 1 or 2.
    var bit_depth = chitra_raw_bit_depth(raw);
    var bps = bit_depth / 8;

    # width*height was capped <= CHITRA_MAX_PIXELS in parse_raw, so
    # out_size <= 64 Mi*4 = 256 Mi — within CHITRA_MAX_RAW_BYTES and far
    # below the i64-overflow boundary. Re-derive (don't trust a span).
    # Re-assert the IHDR caps before the width/height multiplies — defense
    # in depth so this @internal pass is safe even on a hand-built raw (the
    # per-side cap first guarantees width*height cannot overflow i64).
    if (width <= 0 || height <= 0) { store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS)); return 0; }
    if (width > CHITRA_MAX_DIM || height > CHITRA_MAX_DIM) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    if (width * height > CHITRA_MAX_PIXELS) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    var npix = width * height;
    var out_size = npix * 4;

    # The scanline buffer must hold the dense, byte-padded rows parse_raw
    # produced — height * ceil(width*channels*depth/8). (At depth >= 8 this
    # equals npix*channels*bps; the row-padded form also covers sub-byte.)
    var row_bytes = _chitra_row_bytes_for(width, channels, bit_depth);
    if (scan_len < height * row_bytes) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    var out = alloc(out_size);
    if (out == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }

    # ---- resolve + validate the tRNS span against (src, len) -------
    var trns_off = chitra_raw_trns_off(raw);
    var trns_len = chitra_raw_trns_len(raw);
    var has_trns = 0;
    var trns_ptr = 0;
    if (trns_len > 0) {
        if (trns_off < 0 || trns_off + trns_len > len) {
            store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
            return 0;
        }
        has_trns = 1;
        trns_ptr = src + trns_off;
    }

    # ---- sub-byte depths 1/2/4 (only color_type 0 grayscale + 3 palette
    # per spec § 11.2.2). Samples are MSB-first packed with rows padded to
    # a byte, so we walk (y, x) and bit-unpack rather than a linear index.
    if (bit_depth < 8) {
        if (color_type == 0) {
            # grayscale: scale the d-bit sample to 8-bit (×255/85/17).
            # tRNS keys on the raw (unscaled) sample value.
            var scale = _chitra_gray_scale(bit_depth);
            var key = 0 - 1;
            if (has_trns == 1) {
                if (trns_len != 2) { store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK)); return 0; }
                # Full-width compare, for the same reason the depth-8/16 paths
                # use one (0.3.3 H-1): the key is a 2-byte big-endian sample and
                # at these depths its value must fit in `bit_depth` bits, so the
                # high byte is 0 for any in-range key. Reading only the low byte
                # made an OUT-OF-RANGE key (high byte set) alias onto a real
                # sample and turn those pixels transparent. Assembling both
                # bytes makes such a key match nothing, which is correct — it
                # names no pixel this image can contain.
                key = load8(trns_ptr + 0) * 256 + load8(trns_ptr + 1);
            }
            var gy = 0;
            while (gy < height) {
                var growp = scan + gy * row_bytes;
                var gx = 0;
                while (gx < width) {
                    var s = _chitra_get_subbyte(growp, gx, bit_depth);
                    var g = s * scale;
                    var ga = 255;
                    if (s == key) { ga = 0; }
                    var go = out + (gy * width + gx) * 4;
                    store8(go + 0, g);
                    store8(go + 1, g);
                    store8(go + 2, g);
                    store8(go + 3, ga);
                    gx = gx + 1;
                }
                gy = gy + 1;
            }
            return out;
        }
        if (color_type == 3) {
            # palette: the d-bit index selects a PLTE entry; per-entry tRNS
            # alpha (same as the depth-8 palette path).
            var plte_off = chitra_raw_plte_off(raw);
            var plte_len = chitra_raw_plte_len(raw);
            var entry_count = plte_len / 3;
            if (entry_count <= 0) { store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK)); return 0; }
            if (plte_off < 0 || plte_off + plte_len > len) {
                store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                return 0;
            }
            var plte_ptr = src + plte_off;
            if (has_trns == 1 && trns_len > entry_count) {
                store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                return 0;
            }
            var py2 = 0;
            while (py2 < height) {
                var prowp = scan + py2 * row_bytes;
                var px3 = 0;
                while (px3 < width) {
                    var idx = _chitra_get_subbyte(prowp, px3, bit_depth);
                    if (idx >= entry_count) { store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK)); return 0; }
                    var pe = plte_ptr + idx * 3;
                    var pa = 255;
                    if (has_trns == 1 && idx < trns_len) { pa = load8(trns_ptr + idx); }
                    var po = out + (py2 * width + px3) * 4;
                    store8(po + 0, load8(pe + 0));
                    store8(po + 1, load8(pe + 1));
                    store8(po + 2, load8(pe + 2));
                    store8(po + 3, pa);
                    px3 = px3 + 1;
                }
                py2 = py2 + 1;
            }
            return out;
        }
        # sub-byte is only valid for ct0/ct3 (parse_raw enforces); guard.
        store64(err_out, chitra_err(CHITRA_ERR_UNSUPPORTED));
        return 0;
    }

    # ---- grayscale (0): g -> (g,g,g,255); tRNS = one gray sample ----
    if (color_type == 0) {
        # tRNS for grayscale is a 2-byte big-endian sample. Compare at FULL
        # sample width, not at the truncated 8-bit output width: at depth 16
        # the pixel reduces to its high byte, so keying on that byte alone
        # made every one of the 256 samples sharing it transparent (0x12FF
        # keyed off a 0x1234 tRNS). The spec keys one exact value (§ 11.3.2).
        # At depth 8 the key's high byte is 0, so the full-width compare is
        # identical there — except that an out-of-range key (high byte != 0)
        # now correctly matches nothing instead of aliasing onto its low byte.
        var key_g = 0 - 1;     # -1 == no key (never equals a sample)
        if (has_trns == 1) {
            if (trns_len != 2) {
                store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                return 0;
            }
            key_g = load8(trns_ptr + 0) * 256 + load8(trns_ptr + 1);
        }
        var i = 0;
        while (i < npix) {
            var so = scan + i * bps;
            var g = load8(so);          # depth 8: the sample IS the byte
            var gfull = g;
            if (bps == 2) {
                gfull = g * 256 + load8(so + 1);
                g = _png_scale16(gfull);
            }
            var a = 255;
            if (gfull == key_g) { a = 0; }
            var o = out + i * 4;
            store8(o + 0, g);
            store8(o + 1, g);
            store8(o + 2, g);
            store8(o + 3, a);
            i = i + 1;
        }
        return out;
    }

    # ---- truecolor RGB (2): (r,g,b) -> (r,g,b,255); tRNS = 1 triple --
    if (color_type == 2) {
        var key_r = 0 - 1;
        var key_g2 = 0;
        var key_b = 0;
        if (has_trns == 1) {
            # tRNS is three 2-byte big-endian samples (R,G,B). Compared at
            # FULL sample width — see the grayscale branch above; keying on
            # the depth-16 high bytes alone made 2^24 colors transparent
            # instead of the one the chunk names.
            if (trns_len != 6) {
                store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                return 0;
            }
            key_r = load8(trns_ptr + 0) * 256 + load8(trns_ptr + 1);
            key_g2 = load8(trns_ptr + 2) * 256 + load8(trns_ptr + 3);
            key_b = load8(trns_ptr + 4) * 256 + load8(trns_ptr + 5);
        }
        var i = 0;
        while (i < npix) {
            var s = scan + i * 3 * bps;
            var r = load8(s + 0);
            var g = load8(s + 1 * bps);
            var b = load8(s + 2 * bps);
            var rf = r;
            var gf = g;
            var bf = b;
            if (bps == 2) {
                # Build the full-width values FIRST — they are what the § 11.3.2
                # key compares against — then reduce. Deriving one from the
                # other in the wrong order is the trap here: through 0.7.0 the
                # reduced value was the untouched high byte, so `rf = r * 256 +
                # ...` happened to work; with a rescale it would key on a
                # different number entirely.
                rf = r * 256 + load8(s + 1);
                gf = g * 256 + load8(s + 3);
                bf = b * 256 + load8(s + 5);
                r = _png_scale16(rf);
                g = _png_scale16(gf);
                b = _png_scale16(bf);
            }
            var a = 255;
            if (rf == key_r && gf == key_g2 && bf == key_b) { a = 0; }
            var o = out + i * 4;
            store8(o + 0, r);
            store8(o + 1, g);
            store8(o + 2, b);
            store8(o + 3, a);
            i = i + 1;
        }
        return out;
    }

    # ---- palette (3): index -> PLTE[index]; alpha from tRNS array ---
    if (color_type == 3) {
        var plte_off = chitra_raw_plte_off(raw);
        var plte_len = chitra_raw_plte_len(raw);
        var entry_count = plte_len / 3;
        # Palette images REQUIRE a PLTE chunk (spec § 11.2.3).
        if (entry_count <= 0) {
            store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
            return 0;
        }
        # Defensive: the PLTE span must lie within (src, len).
        if (plte_off < 0 || plte_off + plte_len > len) {
            store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
            return 0;
        }
        var plte_ptr = src + plte_off;
        # tRNS for palette is a per-entry alpha array (1 byte each),
        # length <= entry_count; entries beyond it default to 255.
        if (has_trns == 1 && trns_len > entry_count) {
            store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
            return 0;
        }
        var i = 0;
        while (i < npix) {
            var idx = load8(scan + i);
            # Every index must be a valid palette entry (reject OOB).
            if (idx >= entry_count) {
                store64(err_out, chitra_err(CHITRA_ERR_BAD_CHUNK));
                return 0;
            }
            var pe = plte_ptr + idx * 3;
            var a = 255;
            if (has_trns == 1 && idx < trns_len) { a = load8(trns_ptr + idx); }
            var o = out + i * 4;
            store8(o + 0, load8(pe + 0));
            store8(o + 1, load8(pe + 1));
            store8(o + 2, load8(pe + 2));
            store8(o + 3, a);
            i = i + 1;
        }
        return out;
    }

    # ---- grayscale+alpha (4): (g,a) -> (g,g,g,a) --------------------
    if (color_type == 4) {
        var i = 0;
        while (i < npix) {
            var s = scan + i * 2 * bps;
            var g = load8(s + 0);
            var a = load8(s + 1 * bps);
            if (bps == 2) {
                g = _png_scale16(g * 256 + load8(s + 1));
                a = _png_scale16(a * 256 + load8(s + 3));
            }
            var o = out + i * 4;
            store8(o + 0, g);
            store8(o + 1, g);
            store8(o + 2, g);
            store8(o + 3, a);
            i = i + 1;
        }
        return out;
    }

    # ---- truecolor+alpha (6): (r,g,b,a) -> high byte per channel ----
    if (color_type == 6) {
        var i = 0;
        while (i < npix) {
            var s = scan + i * 4 * bps;
            var o = out + i * 4;
            # Depth 8 stays a straight byte copy: hoisting the rescale behind
            # one branch per pixel keeps the common path exactly as fast as it
            # was. A per-SAMPLE helper call here cost 13% on png_rgba8_256,
            # which is a real price to pay on every 8-bit image for a change
            # that only concerns 16-bit ones.
            if (bps == 1) {
                store8(o + 0, load8(s + 0));
                store8(o + 1, load8(s + 1));
                store8(o + 2, load8(s + 2));
                store8(o + 3, load8(s + 3));
            }
            if (bps == 2) {
                store8(o + 0, _png_scale16(load8(s + 0) * 256 + load8(s + 1)));
                store8(o + 1, _png_scale16(load8(s + 2) * 256 + load8(s + 3)));
                store8(o + 2, _png_scale16(load8(s + 4) * 256 + load8(s + 5)));
                store8(o + 3, _png_scale16(load8(s + 6) * 256 + load8(s + 7)));
            }
            i = i + 1;
        }
        return out;
    }

    # Unknown color type — parse_raw already rejects these, but guard.
    store64(err_out, chitra_err(CHITRA_ERR_UNSUPPORTED));
    return 0;
}

# --- png.cyr ---

# @public — chitra PNG decoder: PNG bytes -> canonical RGBA8.
#
# png.cyr — the public decode API. Wires the parse driver
# (chitra_png_parse_raw: framing + inflate + unfilter) to the
# color pass (chitra_png_color_to_rgba8: canonical-RGBA8 + tRNS) and
# wraps the result in a ChitraImage.
#
# Scope (feature-complete for PNG as of v0.2.1): signature + chunk parse
# (IHDR / IDAT-concat / IEND / PLTE / tRNS), color types 0/2/3/4/6 at every
# spec-legal bit depth (1/2/4/8/16, validated per color_type — § 11.2.2
# Table 11.1), Adam7 interlace, sankoch IDAT inflate, the five unfilter
# predictors, canonical-RGBA8 output (16-bit rescales per § 13.13 — 0.7.1;
# sub-byte scales 255/85/17), and the kii security guards. JPEG is 0.3+.
#
# PLTE/tRNS wiring: chitra_png_parse_raw captures PLTE/tRNS only as
# (offset-into-src, length) spans (no byte copy). The public decode
# entry holds the original (src, len), so it forwards src + len into the
# color pass, which resolves the spans (see png_color.cyr's header).

# ================================================================
# ChitraImage — the public decode result (56 bytes).
#   +0:  width       (i64 — pixels)
#   +8:  height      (i64 — pixels)
#   +16: pixels      (ptr — owned RGBA8, width*height*4 bytes)
#   +24: channels    (i64 — always 4)
#   +32: seen_iend   (i64 — 1 if the stream ended the way its format says it
#                    should; 0 if chitra decoded it anyway. See the accessor.)
#   +40: src_ctype   (i64 — pre-normalization PNG color_type: 0/2/3/4/6)
#   +48: src_depth   (i64 — bits per sample in the SOURCE, before RGBA8)
#
# The +32/+40/+48 fields are ADDITIVE — width/height/pixels/channels keep
# their 0.1.x offsets, so mabda's accessors are unaffected by the widen.
# ================================================================
var IMAGE_WIDTH_OFFSET       = 0;
var IMAGE_HEIGHT_OFFSET      = 8;
var IMAGE_PIXELS_OFFSET      = 16;
var IMAGE_CHANNELS_OFFSET    = 24;
var IMAGE_SEEN_IEND_OFFSET   = 32;
var IMAGE_SRC_CTYPE_OFFSET   = 40;
var IMAGE_SRC_DEPTH_OFFSET   = 48;
var CHITRA_IMAGE_SIZE        = 56;

# ---- ChitraImage accessors --------------------------------------
fn chitra_image_width(img): i64    { return load64(img + IMAGE_WIDTH_OFFSET); }
fn chitra_image_height(img): i64   { return load64(img + IMAGE_HEIGHT_OFFSET); }
fn chitra_image_pixels(img): i64   { return load64(img + IMAGE_PIXELS_OFFSET); }
fn chitra_image_channels(img): i64 { return load64(img + IMAGE_CHANNELS_OFFSET); }
# Did the encoded stream end the way its format says it should?
#
# 1 = yes. 0 = chitra decoded it ANYWAY, and the caller should decide what a
# partial or unterminated stream is worth. It is never an error on its own —
# every one of these cases returns a usable ChitraImage.
#
# The name is PNG's (0.2.0), and the question generalised in 0.7.0 because
# three formats were answering it with a hardcoded 1:
#   PNG  — 1 if an IEND chunk closed the stream; 0 for the § 5.3 tolerance of
#          a clean IEND-less end.
#   JPEG — 1 if the scan ended at a real EOI AND the entropy decoder never had
#          to fabricate bits. A truncated scan decodes to zero-padded MCUs and
#          reports 0; so does an EOI-stripped file whose pixels are complete.
#   GIF  — 1 if the LZW stream filled the frame. A stream that stops early
#          leaves the tail as palette entry 0 at full alpha, and reports 0.
#          Note this asks about the FRAME, not the file trailer: chitra decodes
#          the first frame only (ADR 0005), so on a multi-frame GIF it never
#          reads far enough for the trailer to mean anything.
#   BMP  — always 1. The format has no terminator, and the whole pixel span is
#          validated against the input length before anything is read, so a
#          decode that returns at all had complete data.
fn chitra_image_seen_iend(img): i64 { return load64(img + IMAGE_SEEN_IEND_OFFSET); }
# The source color type before RGBA8 normalization — lets a consumer report the
# original format even though pixels are canonical. For PNG this is the PNG
# color_type (0/2/3/4/6). Every other format uses an out-of-PNG-range sentinel,
# so a consumer switching on PNG's 0/2/3/4/6 never aliases one (see ADR 0003):
#   JPEG — `0x100 | ncomp`, plus bit 4 when the components are RGB rather than
#          YCbCr: 0x101 grayscale, 0x103 YCbCr, 0x113 RGB (0.6.1, ADR 0009).
#   BMP  — `0x200 | bpp`: 0x201/0x204/0x208 palette, 0x210 16 bpp,
#          0x218 24 bpp, 0x220 32 bpp.
#   GIF  — `0x300 | min_code_size`.
fn chitra_image_source_color_type(img): i64 { return load64(img + IMAGE_SRC_CTYPE_OFFSET); }
# Bits per sample in the SOURCE, before normalization to RGBA8 (0.9.0).
#
# The output is always 8 bits per channel, so a caller had no way to learn that
# precision was discarded — a depth-16 PNG and a depth-8 one were
# indistinguishable in the result, and § 13.13 rescaling is lossy by
# construction. That gap was worth closing before the surface froze: adding a
# field afterwards is an ABI event, and a consumer that wants to warn about
# precision loss, or to choose a higher-precision path, has nothing else to key
# on.
#   PNG  — the IHDR bit depth: 1, 2, 4, 8 or 16.
#   JPEG — 8. Baseline is 8-bit precision by definition; 12-bit rejects.
#   BMP  — bits per CHANNEL as stored: 8 for 24/32 bpp and for palette entries,
#          5 or 6 for the packed 16-bpp layouts (the widest channel's width).
#   GIF  — 8. Palette entries are bytes.
fn chitra_image_source_depth(img): i64 { return load64(img + IMAGE_SRC_DEPTH_OFFSET); }

# ================================================================
# chitra_png_decode — the top-level public decode. Parse (src, len) PNG
# bytes -> an owned RGBA8 ChitraImage.
#
# Returns the ChitraImage ptr on success, or 0 with *err_out set to a
# ChitraErr ptr. *err_out is left 0 on success. err_out is a >=8-byte
# slot the caller owns (mirrors chitra_png_parse_raw's convention so the
# Ok/Err split is a (ptr, err_out) pair rather than a tagged union).
# ================================================================
# @public
fn chitra_png_decode(src, len, err_out): i64 {
    store64(err_out, 0);

    # ---- parse: framing + inflate + unfilter ----
    var raw = chitra_png_parse_raw(src, len, err_out);
    if (raw == 0) { return 0; }      # *err_out already set by parse_raw

    # ---- color pass: canonical RGBA8 + tRNS ----
    var rgba = chitra_png_color_to_rgba8(raw, src, len, err_out);
    if (rgba == 0) { return 0; }     # *err_out already set by the color pass

    var img = alloc(CHITRA_IMAGE_SIZE);
    if (img == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    store64(img + IMAGE_WIDTH_OFFSET, chitra_raw_width(raw));
    store64(img + IMAGE_HEIGHT_OFFSET, chitra_raw_height(raw));
    store64(img + IMAGE_PIXELS_OFFSET, rgba);
    store64(img + IMAGE_CHANNELS_OFFSET, 4);
    store64(img + IMAGE_SEEN_IEND_OFFSET, chitra_raw_seen_iend(raw));
    store64(img + IMAGE_SRC_CTYPE_OFFSET, chitra_raw_color_type(raw));
    store64(img + IMAGE_SRC_DEPTH_OFFSET, chitra_raw_bit_depth(raw));
    return img;
}

# ================================================================
# chitra_png_decode_rgba8 — convenience wrapper. Decode (src, len) and
# return the RGBA8 pixel pointer directly, writing width/height through
# w_out / h_out (>=8-byte slots). Returns 0 on any failure (the detailed
# ChitraErr is not surfaced here — callers needing it use chitra_png_decode).
# On the 0 path w_out/h_out are left at 0.
# ================================================================
# @public
fn chitra_png_decode_rgba8(src, len, w_out, h_out): i64 {
    store64(w_out, 0);
    store64(h_out, 0);
    var err = 0;
    var img = chitra_png_decode(src, len, &err);
    if (img == 0) { return 0; }
    store64(w_out, chitra_image_width(img));
    store64(h_out, chitra_image_height(img));
    return chitra_image_pixels(img);
}

# ================================================================
# chitra_image_free — release a ChitraImage. The stdlib `alloc` is a
# bump allocator with no per-block free, so this is a documented no-op
# kept for API symmetry (matches chitra_raw_free) and a future arena-
# backed allocator. Safe on a 0 ptr.
# ================================================================
# @public
fn chitra_image_free(img): i64 {
    return 0;
}

# ================================================================
# Version probe — packed as major*10000 + minor*100 + patch.
# 0.1.0 -> 100, 0.1.1 -> 101, 0.2.0 -> 200, 0.2.1 -> 201, 0.3.3 -> 303, 0.4.0 -> 400, 0.5.3 -> 503.
# ================================================================
# @public
fn chitra_version(): i64 {
    return 10003;
}

# --- jpeg_huffman.cyr ---

# @internal — JPEG Huffman decode tables (0.3.0, bite 3).
# jpeg_huffman.cyr — the canonical Huffman decode-table representation and its
# construction from a DHT's BITS (code-length counts) + HUFFVAL (symbols). This
# module is frame-independent table machinery, so it is included BEFORE
# jpeg_markers.cyr (whose DHT parser drives the build into frame-owned storage).
# The entropy bit-reader, the DECODE procedure and _jpeg_decode_block all live
# in this module.
#
# Construction follows ITU-T T.81 Annex C (HUFFSIZE/HUFFCODE generation) folded
# into the Annex F figure F.15 decoder-table derivation (MINCODE/MAXCODE/VALPTR).
# The DECODE procedure (Annex F.2.2.3), implemented here as _jpeg_decode:
#   code = nextbit(); L = 1
#   while code > maxcode[L]: L += 1; code = (code << 1) | nextbit()
#   value = huffval[ valptr[L] + code - mincode[L] ]
# maxcode[L] == -1 marks "no codes of length L".

# ================================================================
# HuffTable record (i64 fields). One per table; 8 live in the frame (4 DC,
# 4 AC). Codes are at most 16 bits; symbols at most 256 (T.81 § B.2.4.2).
#   +0    mincode[0..16]   (17 i64) — smallest code of each length L
#   +136  maxcode[0..16]   (17 i64) — largest code of each length L (-1 = none)
#   +272  valptr[0..16]    (17 i64) — huffval index of first symbol of length L
#   +408  count            (1 i64)  — number of symbols (Σ BITS)
#   +416  huffval[0..255]  (256 i64)— symbol values, in DHT order
# ================================================================
var HT_MINCODE = 0;
var HT_MAXCODE = 136;    # 17*8
var HT_VALPTR  = 272;    # 34*8
var HT_COUNT   = 408;    # 51*8
var HT_HUFFVAL = 416;    # 52*8
var HT_SIZE    = 2464;   # (52 + 256) * 8

fn _jpeg_huff_mincode(t, L): i64 { return load64(t + HT_MINCODE + L * 8); }
fn _jpeg_huff_maxcode(t, L): i64 { return load64(t + HT_MAXCODE + L * 8); }
fn _jpeg_huff_valptr(t, L): i64  { return load64(t + HT_VALPTR + L * 8); }
fn _jpeg_huff_count(t): i64      { return load64(t + HT_COUNT); }
fn _jpeg_huff_val(t, i): i64     { return load64(t + HT_HUFFVAL + i * 8); }

# ================================================================
# Build the MINCODE/MAXCODE/VALPTR decode arrays from BITS. `table` already has
# its HUFFVAL[] and COUNT filled by the caller; `bits` is a 17-i64 array with
# bits[L] = number of codes of length L (L in 1..16; index 0 unused).
#
# Canonical codes are consecutive integers per length, the whole space shifting
# left by one bit at each length step. Over-subscription (more codes than the
# length can hold) is rejected — the security-critical check that stops a
# malformed table from producing out-of-range code values. Returns 0 on success
# or CHITRA_ERR_JPEG_DHT.
# ================================================================
fn _jpeg_huff_build(table, bits): i64 {
    var z = 0;
    while (z <= 16) {
        store64(table + HT_MINCODE + z * 8, 0);
        store64(table + HT_MAXCODE + z * 8, 0 - 1);
        store64(table + HT_VALPTR + z * 8, 0);
        z = z + 1;
    }
    var code = 0;
    var j = 0;          # running symbol index into HUFFVAL
    var L = 1;
    var cnt = 0;
    var rc = 0;
    var done = 0;
    while (done == 0) {
        if (L > 16) { done = 1; }
        if (done == 0) {
            cnt = load64(bits + L * 8);
            if (cnt > 0) {
                store64(table + HT_VALPTR + L * 8, j);
                store64(table + HT_MINCODE + L * 8, code);
                code = code + cnt - 1;                    # largest code of length L
                store64(table + HT_MAXCODE + L * 8, code);
                if (code >= (1 << L)) { rc = CHITRA_ERR_JPEG_DHT; done = 1; }
                if (done == 0) {
                    code = code + 1;
                    j = j + cnt;
                }
            }
            if (done == 0) {
                code = code << 1;
                L = L + 1;
            }
        }
    }
    return rc;
}

# ================================================================
# Entropy bit-reader (T.81 § F.2.2 + § B.1.1.5 byte stuffing). MSB-first bit
# pull over the entropy-coded segment after SOS. A 0xFF in the stream is either
# followed by 0x00 (a stuffing byte to discard, the 0xFF is real data) or by a
# marker code (RSTn / EOI / ...), at which point the reader stops and records
# the marker; subsequent bit reads pad with zeros. The 56-byte record:
#   +0 base  +8 pos  +16 end  +24 buf (current byte)  +32 cnt (bits left in buf)
#   +40 marker (the marker byte after a 0xFF, or 0)
#   +48 eod — set when the reader needs a byte its span does not contain, which
#             is what distinguishes "ran out of scan" from a real EOI (0.7.0)
# ================================================================
var BR_BASE   = 0;
var BR_POS    = 8;
var BR_END    = 16;
var BR_BUF    = 24;
var BR_CNT    = 32;
var BR_MARKER = 40;
# +48 eod — set the moment the reader needs a byte the input does not contain.
# It is NOT the same question as BR_MARKER: a scan that ends at a real EOI and
# a scan that simply runs out both leave the reader zero-padding, and only this
# flag tells them apart. That distinction is what lets a caller learn its JPEG
# was truncated (0.7.0), which it previously could not.
var BR_EOD    = 48;
var BR_SIZE   = 56;

fn _jpeg_br_init(reader, base, len): i64 {
    store64(reader + BR_BASE, base);
    store64(reader + BR_POS, 0);
    store64(reader + BR_END, len);
    store64(reader + BR_BUF, 0);
    store64(reader + BR_CNT, 0);
    store64(reader + BR_MARKER, 0);
    store64(reader + BR_EOD, 0);
    return 0;
}

fn _jpeg_br_marker(reader): i64 { return load64(reader + BR_MARKER); }
# 1 once the reader has had to fabricate bits because the input ran out.
fn _jpeg_br_eod(reader): i64    { return load64(reader + BR_EOD); }
fn _jpeg_br_pos(reader): i64    { return load64(reader + BR_POS); }

# Resync at a restart-interval boundary (T.81 § F.2.1.3.1 / E.1.1): discard the
# partial byte (byte-align), then consume the expected RSTn marker (FF D0..D7).
# After decoding `restart_interval` MCUs the stream is byte-aligned at an RSTn;
# BR_POS points at its 0xFF (whether or not the bit-reader auto-detected it).
# Returns 0 on success, -1 if the restart marker is missing/malformed.
fn _jpeg_br_restart(reader): i64 {
    store64(reader + BR_CNT, 0);
    var base = load64(reader + BR_BASE);
    var pos = load64(reader + BR_POS);
    var end = load64(reader + BR_END);
    # Skip 0xFF fill bytes (T.81 § B.1.1.2), leaving pos on the LAST 0xFF so
    # the marker code sits at pos+1.
    var skip = 1;
    while (skip == 1) {
        skip = 0;
        if (pos + 1 < end) {
            if (load8(base + pos) == 0xFF) {
                if (load8(base + pos + 1) == 0xFF) {
                    pos = pos + 1;
                    skip = 1;
                }
            }
        }
    }
    if (pos + 1 >= end) { return 0 - 1; }
    if (load8(base + pos) != 0xFF) { return 0 - 1; }
    var m = load8(base + pos + 1);
    if (m < 0xD0) { return 0 - 1; }
    if (m > 0xD7) { return 0 - 1; }
    store64(reader + BR_POS, pos + 2);
    store64(reader + BR_MARKER, 0);
    return 0;
}

# Load one data byte (8 bits) into the buffer. Only called when CNT == 0. On a
# stuffing pair (FF 00) the 0xFF is loaded and the 0x00 discarded. On a marker
# (FF xx, xx != 0) or end-of-data, the marker is recorded (xx, or EOI for a
# trailing lone FF) and CNT is left 0 so callers pad with zero bits.
fn _jpeg_br_load_byte(reader): i64 {
    if (load64(reader + BR_MARKER) != 0) { return 0; }
    var base = load64(reader + BR_BASE);
    var pos = load64(reader + BR_POS);
    var end = load64(reader + BR_END);
    var b = 0;
    var b2 = 0;
    if (pos >= end) {
        store64(reader + BR_EOD, 1);
        return 0;
    }
    b = load8(base + pos);
    pos = pos + 1;
    if (b == 0xFF) {
        # T.81 § B.1.1.2: a marker may be preceded by ANY number of 0xFF fill
        # bytes. Collapse the run so "FF FF D0" resolves to RST0 instead of a
        # bogus marker 0xFF — which made _jpeg_br_restart reject a perfectly
        # well-formed restart stream. `b` stays 0xFF (every byte in the run is
        # the same value), and pos-1 still points at the LAST 0xFF, which is
        # exactly where the restart resync expects to find it.
        var fill = 1;
        while (fill == 1) {
            fill = 0;
            if (pos < end) {
                if (load8(base + pos) == 0xFF) {
                    pos = pos + 1;
                    fill = 1;
                }
            }
        }
        if (pos >= end) {
            # A trailing 0xFF run with nothing after it. The EOI is synthesized,
            # not read — so this is end-of-data, not a clean close.
            store64(reader + BR_MARKER, 0xD9);
            store64(reader + BR_EOD, 1);
            store64(reader + BR_POS, pos - 1);
            return 0;
        }
        b2 = load8(base + pos);
        if (b2 == 0x00) { pos = pos + 1; }     # stuffing — discard, keep 0xFF
        if (b2 != 0x00) {
            store64(reader + BR_MARKER, b2);
            store64(reader + BR_POS, pos - 1);  # leave pos at the 0xFF for resync
            return 0;
        }
    }
    store64(reader + BR_BUF, b);
    store64(reader + BR_CNT, 8);
    store64(reader + BR_POS, pos);
    return 0;
}

# Read one bit MSB-first. Returns 0 past end / after a marker (zero padding).
fn _jpeg_br_bit(reader): i64 {
    var cnt = load64(reader + BR_CNT);
    if (cnt == 0) {
        _jpeg_br_load_byte(reader);
        cnt = load64(reader + BR_CNT);
    }
    # ⛔⛔ B-5 (1.0.3) — THE FABRICATION POINT, AND THEREFORE THE ONLY HONEST
    # PLACE TO SET BR_EOD. Reaching here means a bit was asked for and the scan
    # could not supply it, so the zero returned below is invented. That is
    # precisely what BR_EOD is defined to mean twenty lines above: "set the
    # moment the reader needs a byte the input does not contain."
    #
    # `_jpeg_br_load_byte` already set it for a span that simply ran out. What
    # it did NOT set it for was a LATCHED MARKER — and the only markers inside
    # a scan's span are RSTn, because _jpeg_entropy_span ends the span at the
    # first marker that is neither stuffing nor a restart. So an RSTn the
    # decoder never asked for (no DRI, DRI=0, or the wrong interval) latched,
    # every subsequent MCU was fabricated from zero bits, and `seen_iend` still
    # came back 1 — a positive assertion of a clean close over an image whose
    # bottom half is invented. Two bytes inserted mid-scan were enough.
    #
    # ⚠ Setting it at the latch instead would be wrong: a LEGITIMATE restart
    # also latches, and `_jpeg_br_restart` then consumes it and clears
    # BR_MARKER. Nothing is fabricated on that path and it must keep reporting
    # a clean close. Fabrication, not latching, is the event worth recording.
    if (cnt == 0) {
        store64(reader + BR_EOD, 1);
        return 0;
    }
    cnt = cnt - 1;
    store64(reader + BR_CNT, cnt);
    return (load64(reader + BR_BUF) >> cnt) & 1;
}

# RECEIVE: read n bits as an unsigned value (T.81 § F.2.2.4).
fn _jpeg_br_bits(reader, n): i64 {
    var v = 0;
    var i = 0;
    while (i < n) {
        v = (v << 1) | _jpeg_br_bit(reader);
        i = i + 1;
    }
    return v;
}

# EXTEND a value received with n bits to its signed coefficient (T.81 § F.2.2.1,
# figure F.12): values below 2^(n-1) are negative.
fn _jpeg_extend(v, n): i64 {
    if (n == 0) { return 0; }
    if (v < (1 << (n - 1))) {
        return v - (1 << n) + 1;
    }
    return v;
}

# DECODE a single Huffman-coded symbol (T.81 § F.2.2.3, figure F.16). Walks the
# maxcode table, extending the code one bit per length until it fits. Returns
# the symbol (0..255), or -1 on an undecodable code (no length matched, or an
# index outside the table's symbol list — incomplete-table defense).
fn _jpeg_decode(reader, table): i64 {
    var code = _jpeg_br_bit(reader);
    var L = 1;
    var maxc = _jpeg_huff_maxcode(table, 1);
    var done = 0;
    var bad = 0;
    while (done == 0) {
        if (code <= maxc) { done = 1; }
        if (done == 0) {
            L = L + 1;
            if (L > 16) { done = 1; bad = 1; }
            if (done == 0) {
                code = (code << 1) | _jpeg_br_bit(reader);
                maxc = _jpeg_huff_maxcode(table, L);
            }
        }
    }
    if (bad == 1) { return 0 - 1; }
    var idx = _jpeg_huff_valptr(table, L) + code - _jpeg_huff_mincode(table, L);
    if (idx < 0) { return 0 - 1; }
    if (idx >= _jpeg_huff_count(table)) { return 0 - 1; }
    return _jpeg_huff_val(table, idx);
}

# Decode one 8x8 block's 64 coefficients in zig-zag order into zz_out (64 i64,
# de-zig-zag deferred to dequant). DC is differential against `pred`; AC uses
# run/size (RRRR/SSSS) coding with ZRL (16-zero run) and EOB (T.81 § F.2.2.2).
# Returns the new DC predictor value; on a corrupt stream sets *err_out to a
# CHITRA_ERR_JPEG_ENTROPY ChitraErr and returns 0.
fn _jpeg_decode_block(reader, dct, act, pred, zz_out, err_out): i64 {
    store64(err_out, 0);
    var i = 0;
    while (i < 64) { store64(zz_out + i * 8, 0); i = i + 1; }

    var t = _jpeg_decode(reader, dct);
    if (t < 0) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY)); return 0; }
    # DC magnitude category: 0..11 for 8-bit baseline (T.81 Table F.1).
    if (t > 11) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY)); return 0; }
    var diff = 0;
    if (t > 0) { diff = _jpeg_extend(_jpeg_br_bits(reader, t), t); }
    var dc = pred + diff;
    store64(zz_out + 0, dc);

    var k = 1;
    var rs = 0;
    var r = 0;
    var s = 0;
    var done = 0;
    while (done == 0) {
        if (k > 63) { done = 1; }
        if (done == 0) {
            rs = _jpeg_decode(reader, act);
            if (rs < 0) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY)); done = 1; }
            if (done == 0) {
                r = (rs >> 4) & 15;
                s = rs & 15;
                # AC magnitude category: 0..10 for 8-bit baseline (T.81 Table F.2);
                # s==0 is EOB (r==0) or ZRL (r==15). s in 11..15 is out of spec.
                if (s > 10) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY)); done = 1; }
            }
            if (done == 0) {
                if (s == 0) {
                    if (r == 15) {
                        # ZRL: a run of 16 zeros, filling k..k+15. Legal only
                        # while that run ends inside the block. Overrunning it
                        # is exactly as corrupt as the r-run overrun rejected
                        # below, and used to slip out of the loop as a CLEAN
                        # decode — a corrupt stream reported as success.
                        k = k + 16;
                        if (k > 64) {
                            store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY));
                            done = 1;
                        }
                    }
                    if (r != 15) { done = 1; }     # EOB: remaining coeffs are zero
                }
                if (s != 0) {
                    k = k + r;
                    if (k > 63) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY)); done = 1; }
                    if (done == 0) {
                        store64(zz_out + k * 8, _jpeg_extend(_jpeg_br_bits(reader, s), s));
                        k = k + 1;
                    }
                }
            }
        }
    }
    if (load64(err_out) != 0) { return 0; }
    return dc;
}

# --- jpeg_idct.cyr ---

# @internal — JPEG dequantization + zig-zag + inverse DCT (0.3.0, bite 5).
# jpeg_idct.cyr — turn a block of 64 zig-zag-order DCT coefficients (from
# jpeg_huffman's _jpeg_decode_block) plus its quantization table into 64
# natural-order 8-bit samples. Frame-independent: operates on caller buffers.
#
# IDCT: the libjpeg `jpeg_idct_islow` integer fixed-point separable algorithm
# (Loeffler-Ligtenberg-Moschytz factorization), committed in
# docs/adr/0004-jpeg-decode-model.md; constants per ITU-T T.81 + libjpeg jidctint.c.
#   Source: Loeffler, C., Ligtenberg, A., Moschytz, G. (1989), "Practical fast
#   1-D DCT algorithms with 11 multiplications," IEEE ICASSP, pp. 988-991.
#   Implementation reference: libjpeg jidctint.c (jpeg_idct_islow). See docs/sources.md.
#
# CONST_BITS = 13 (fixed-point scale of the FIX_* constants). PASS1_BITS = 2.
# Pass 1 (columns) descales by CONST_BITS - PASS1_BITS = 11; pass 2 (rows) by
# CONST_BITS + PASS1_BITS + 3 = 18, where +3 is the IDCT 1/8 normalization.
#
# NOTE (Cyrius): `>>` is a LOGICAL shift here, so it is wrong for the negative
# intermediates the IDCT produces. DESCALE therefore uses signed division with
# round-to-nearest (symmetric about 0) — deterministic, and a valid rounding of
# the same value. The even-part CONST_BITS scaling uses `* 8192` (= 1<<13) rather
# than a left shift so negative coefficients scale correctly.

var FIX_0_298631336 = 2446;
var FIX_0_390180644 = 3196;
var FIX_0_541196100 = 4433;
var FIX_0_765366865 = 6270;
var FIX_0_899976223 = 7373;
var FIX_1_175875602 = 9633;
var FIX_1_501321110 = 12299;
var FIX_1_847759065 = 15137;
var FIX_1_961570560 = 16069;
var FIX_2_053119869 = 16819;
var FIX_2_562915447 = 20995;
var FIX_3_072711026 = 25172;

# ================================================================
# Zig-zag → natural (row-major 8x8) index map (T.81 figure A.6). Lazily built
# once into a 64-i64 table. Coefficients and quant tables arrive in zig-zag
# order; dequant scatters them into natural order via this map.
# ================================================================
# The zig-zag map is constant data, so it lives in BSS rather than the heap:
# the previous alloc(512) was unchecked, and on failure it stored 64 values
# through a NULL pointer. Const data has no business owning a failure mode.
var _jpeg_zz_tbl[512];        # 64 i64 — BSS, no alloc dep
var _jpeg_zz_ready = 0;
fn _jpeg_zigzag_table(): i64 {
    if (_jpeg_zz_ready != 0) { return &_jpeg_zz_tbl; }
    var t = &_jpeg_zz_tbl;
    store64(t + 0 * 8, 0);
    store64(t + 1 * 8, 1);
    store64(t + 2 * 8, 8);
    store64(t + 3 * 8, 16);
    store64(t + 4 * 8, 9);
    store64(t + 5 * 8, 2);
    store64(t + 6 * 8, 3);
    store64(t + 7 * 8, 10);
    store64(t + 8 * 8, 17);
    store64(t + 9 * 8, 24);
    store64(t + 10 * 8, 32);
    store64(t + 11 * 8, 25);
    store64(t + 12 * 8, 18);
    store64(t + 13 * 8, 11);
    store64(t + 14 * 8, 4);
    store64(t + 15 * 8, 5);
    store64(t + 16 * 8, 12);
    store64(t + 17 * 8, 19);
    store64(t + 18 * 8, 26);
    store64(t + 19 * 8, 33);
    store64(t + 20 * 8, 40);
    store64(t + 21 * 8, 48);
    store64(t + 22 * 8, 41);
    store64(t + 23 * 8, 34);
    store64(t + 24 * 8, 27);
    store64(t + 25 * 8, 20);
    store64(t + 26 * 8, 13);
    store64(t + 27 * 8, 6);
    store64(t + 28 * 8, 7);
    store64(t + 29 * 8, 14);
    store64(t + 30 * 8, 21);
    store64(t + 31 * 8, 28);
    store64(t + 32 * 8, 35);
    store64(t + 33 * 8, 42);
    store64(t + 34 * 8, 49);
    store64(t + 35 * 8, 56);
    store64(t + 36 * 8, 57);
    store64(t + 37 * 8, 50);
    store64(t + 38 * 8, 43);
    store64(t + 39 * 8, 36);
    store64(t + 40 * 8, 29);
    store64(t + 41 * 8, 22);
    store64(t + 42 * 8, 15);
    store64(t + 43 * 8, 23);
    store64(t + 44 * 8, 30);
    store64(t + 45 * 8, 37);
    store64(t + 46 * 8, 44);
    store64(t + 47 * 8, 51);
    store64(t + 48 * 8, 58);
    store64(t + 49 * 8, 59);
    store64(t + 50 * 8, 52);
    store64(t + 51 * 8, 45);
    store64(t + 52 * 8, 38);
    store64(t + 53 * 8, 31);
    store64(t + 54 * 8, 39);
    store64(t + 55 * 8, 46);
    store64(t + 56 * 8, 53);
    store64(t + 57 * 8, 60);
    store64(t + 58 * 8, 61);
    store64(t + 59 * 8, 54);
    store64(t + 60 * 8, 47);
    store64(t + 61 * 8, 55);
    store64(t + 62 * 8, 62);
    store64(t + 63 * 8, 63);
    _jpeg_zz_ready = 1;
    return t;
}

# DESCALE: round-to-nearest division by 2^n, symmetric about zero (works for
# negatives despite the logical `>>`). n >= 1.
fn _jpeg_descale(x, n): i64 {
    var half = 1 << (n - 1);
    var div = 1 << n;
    if (x >= 0) { return (x + half) / div; }
    return 0 - ((0 - x + half) / div);
}

# Final per-output store: descale, and (pass 2 only) level-shift +128 + clamp.
fn _jpeg_idct_out(addr, val, shift, do_ls): i64 {
    var d = _jpeg_descale(val, shift);
    if (do_ls == 1) {
        d = d + 128;
        if (d < 0) { d = 0; }
        if (d > 255) { d = 255; }
    }
    store64(addr, d);
    return 0;
}

# One 1-D inverse DCT stage over 8 values at inp + i*istep, writing 8 results to
# outp + j*ostep (steps in bytes). `shift` is the descale; `do_ls` enables the
# pass-2 level-shift + clamp. Identical butterfly for both passes (the islow form).
fn _jpeg_idct_1d(inp, istep, outp, ostep, shift, do_ls): i64 {
    var s0 = load64(inp + 0 * istep);
    var s1 = load64(inp + 1 * istep);
    var s2 = load64(inp + 2 * istep);
    var s3 = load64(inp + 3 * istep);
    var s4 = load64(inp + 4 * istep);
    var s5 = load64(inp + 5 * istep);
    var s6 = load64(inp + 6 * istep);
    var s7 = load64(inp + 7 * istep);

    # even part
    var z1 = (s2 + s6) * FIX_0_541196100;
    var tmp2 = z1 - s6 * FIX_1_847759065;
    var tmp3 = z1 + s2 * FIX_0_765366865;
    var tmp0 = (s0 + s4) * 8192;
    var tmp1 = (s0 - s4) * 8192;
    var tmp10 = tmp0 + tmp3;
    var tmp13 = tmp0 - tmp3;
    var tmp11 = tmp1 + tmp2;
    var tmp12 = tmp1 - tmp2;

    # odd part
    var o0 = s7;
    var o1 = s5;
    var o2 = s3;
    var o3 = s1;
    var oz1 = o0 + o3;
    var oz2 = o1 + o2;
    var oz3 = o0 + o2;
    var oz4 = o1 + o3;
    var oz5 = (oz3 + oz4) * FIX_1_175875602;
    o0 = o0 * FIX_0_298631336;
    o1 = o1 * FIX_2_053119869;
    o2 = o2 * FIX_3_072711026;
    o3 = o3 * FIX_1_501321110;
    oz1 = 0 - (oz1 * FIX_0_899976223);
    oz2 = 0 - (oz2 * FIX_2_562915447);
    oz3 = 0 - (oz3 * FIX_1_961570560);
    oz4 = 0 - (oz4 * FIX_0_390180644);
    oz3 = oz3 + oz5;
    oz4 = oz4 + oz5;
    o0 = o0 + oz1 + oz3;
    o1 = o1 + oz2 + oz4;
    o2 = o2 + oz2 + oz3;
    o3 = o3 + oz1 + oz4;

    _jpeg_idct_out(outp + 0 * ostep, tmp10 + o3, shift, do_ls);
    _jpeg_idct_out(outp + 7 * ostep, tmp10 - o3, shift, do_ls);
    _jpeg_idct_out(outp + 1 * ostep, tmp11 + o2, shift, do_ls);
    _jpeg_idct_out(outp + 6 * ostep, tmp11 - o2, shift, do_ls);
    _jpeg_idct_out(outp + 2 * ostep, tmp12 + o1, shift, do_ls);
    _jpeg_idct_out(outp + 5 * ostep, tmp12 - o1, shift, do_ls);
    _jpeg_idct_out(outp + 3 * ostep, tmp13 + o0, shift, do_ls);
    _jpeg_idct_out(outp + 4 * ostep, tmp13 - o0, shift, do_ls);
    return 0;
}

# ================================================================
# _jpeg_idct_block — dequantize + de-zig-zag `zz` (64 i64, zig-zag order) with
# `quant` (64 i64, zig-zag order) into a natural-order block, run the 2-D IDCT,
# and write 64 level-shifted clamped samples (0..255) to `out` (64 i64,
# row-major). The arrays `zz`/`quant`/`out` are caller-owned.
# ================================================================
fn _jpeg_idct_block(zz, quant, out): i64 {
    var zztab = _jpeg_zigzag_table();
    var coef[512];   # 64 i64, natural order
    var ws[512];     # 64 i64, pass-1 workspace
    var k = 0;
    var nat = 0;
    while (k < 64) {
        nat = load64(zztab + k * 8);
        store64(&coef + nat * 8, load64(zz + k * 8) * load64(quant + k * 8));
        k = k + 1;
    }
    var c = 0;
    while (c < 8) {
        _jpeg_idct_1d(&coef + c * 8, 64, &ws + c * 8, 64, 11, 0);
        c = c + 1;
    }
    var r = 0;
    while (r < 8) {
        _jpeg_idct_1d(&ws + r * 64, 8, out + r * 64, 8, 18, 1);
        r = r + 1;
    }
    return 0;
}

# --- jpeg_markers.cyr ---

# @internal — JPEG (JFIF/EXIF) baseline marker + segment framing (0.3.0).
# jpeg_markers.cyr — turn untrusted JPEG bytes into a validated marker walk and
# a parsed ChitraJpegFrame. This is the JPEG analog of png_chunks.cyr: it reuses
# the bounds-checked byte cursor (_cur_* in png_chunks.cyr, incl. _cur_u16_be for
# JPEG's 2-byte big-endian segment lengths, ITU-T T.81 § B.1). Every read is
# validated against len BEFORE the access.
#
# Scope so far:
#   bite 1 — signature (SOI 0xFFD8), the marker/segment walk up to SOS, reject
#            every non-baseline mode with a distinct error.
#   bite 2 — parse SOF0 component specs (id / H / V / quant-selector, max H/V)
#            and DQT quantization tables, with the sampling-factor security
#            guards (Hi,Vi in 1..4 — reject 0 per CVE-2018-11212; reject
#            duplicate component ids). NOTE: ΣHi·Vi ≤ 10 is NOT enforced here
#            — T.81 § B.2.3 scopes it to an interleaved MCU, so 0.8.0 moved it
#            to _jpeg_parse_sos (jpeg.cyr), conditioned on Ns > 1.
#   bite 3 — parse DHT and build canonical Huffman decode tables (via
#            jpeg_huffman.cyr) into frame storage (4 DC + 4 AC).
# COM / DNL and all APPn except APP14 are skipped here; APP14 is parsed for the
# Adobe colour transform (0.6.1, ADR 0009). DRI sets the restart interval, and
# _jpeg_resume_to_next_scan (0.8.0) walks the markers between scans.
# See docs/adr/0004-jpeg-decode-model.md + docs/proposals/jpeg-baseline-decoder.md.
#
# JPEG marker legend (the byte after a 0xFF; ITU-T T.81 Table B.1):
#   D8 SOI  D9 EOI  DA SOS  DB DQT  DC DNL  DD DRI  FE COM  E0..EF APPn
#   C0 SOF0(baseline)  C1 SOF1(ext-seq)  C2 SOF2(progressive)  C3 SOF3(lossless)
#   C4 DHT  C5..C7 differential  C9..CB arithmetic SOF  CC DAC
#   CD..CF differential arithmetic  D0..D7 RSTn  01 TEM (all standalone)

# ================================================================
# Baseline ceilings (validated before any allocation depends on them).
# ================================================================
var CHITRA_MAX_COMPONENTS     = 4;    # baseline accepts 1 or 3; this caps the field
var CHITRA_MAX_SAMP_FACTOR    = 4;    # Hi, Vi each in 1..4 (T.81 § B.2.2)
# ΣHj·Vj ≤ 10 data units per INTERLEAVED MCU — T.81 § B.2.3, which conditions
# the rule on Ns > 1 (it is not § A.2.2, as this line said through 0.5.3). A
# one-component frame has no interleaved MCU to bound; see _jpeg_parse_sof0.
var CHITRA_MAX_BLOCKS_PER_MCU = 10;
var CHITRA_MAX_QUANT_TABLES   = 4;    # Tq in 0..3
var CHITRA_MAX_HUFF_TABLES    = 4;    # Th in 0..3 (per class)
# Output:input amplification ceiling — the JPEG analogue of the PNG path's
# CHITRA_MAX_INFLATE_RATIO. See the bomb-cap note in jpeg.cyr's decode scan.
var CHITRA_MAX_JPEG_RATIO     = 4096;

# ================================================================
# ChitraJpegFrame — the marker-walk handoff record (internal). Filled by the
# scan; later bites (restart interval, scan selectors) extend it.
# CHITRA_JPEG_FRAME_SIZE reserves room so the alloc size is stable as fields
# are added across the 0.3.0 arc.
#   +0   width            (i64 — pixels)
#   +8   height           (i64 — pixels)
#   +16  precision        (i64 — sample bits; 8 only in 0.3.0)
#   +24  num_components    (i64 — 1 grayscale or 3 YCbCr)
#   +32  seen_sof          (i64 — 1 once a valid SOF0 has been parsed)
#   +40  max_h            (i64 — max horizontal sampling factor across components)
#   +48  max_v            (i64 — max vertical sampling factor)
#   +56  restart_interval (i64 — DRI MCUs between RSTn; 0 = none; bite 7)
#   +64  quant            (ptr — 4*64 i64 quant-table storage, zig-zag order)
#   +72  quant_present    (i64 — bitmask of quant tables seen, bit Tq)
#   +80  sos_offset       (i64 — byte offset of the SOS length field)
#   +88  huff             (ptr — 8 HuffTable records: slots 0..3 DC, 4..7 AC)
#   +96  huff_present     (i64 — bitmask of Huffman tables seen, bit Tc*4+Th)
#   +104 components       (4 × 32-byte specs: +0 id, +8 H, +16 V, +24 Tq.
#                          Td/Ta are NOT here — 0.8.0 moved the Huffman
#                          selectors to the per-scan block; see JF_SCAN)
# ================================================================
var JF_WIDTH            = 0;
var JF_HEIGHT           = 8;
var JF_PRECISION        = 16;
var JF_NCOMP            = 24;
var JF_SEEN_SOF         = 32;
var JF_MAX_H            = 40;
var JF_MAX_V            = 48;
var JF_RESTART_INTERVAL = 56;
var JF_QUANT            = 64;
var JF_QUANT_PRESENT    = 72;
var JF_SOS_OFFSET       = 80;    # byte offset of the SOS length field (set at SOS)
var JF_HUFF             = 88;    # ptr to 8 HuffTable records (slots 0..3 DC, 4..7 AC)
var JF_HUFF_PRESENT     = 96;    # bitmask of Huffman tables seen (bit = class*4 + id)
var JF_COMP             = 104;   # 4 × JF_COMP_STRIDE component specs
var JF_COMP_STRIDE      = 32;
var JF_COMP_ID          = 0;     # SOF fields
var JF_COMP_H           = 8;
var JF_COMP_V           = 16;
var JF_COMP_TQ          = 24;
# JF_COMP_TD / JF_COMP_TA are GONE as of 0.8.0. Huffman selectors are a
# property of the SCAN, not of the component: a component absent from scan 2
# retained scan 1's selectors here, which is a silent wrong-table decode the
# moment more than one scan exists. They live in JF_SCAN now, and deleting them
# shrinks the component stride from 48 to 32.
# +232 adobe_transform — the APP14 Adobe colour-transform code, or -1 when no
# Adobe marker was seen. Sits after the 4 x 32-byte component specs
# (104 + 128 = 232); it was +296 while the stride was 48.
var JF_ADOBE_TRANSFORM  = 232;
# ---- per-SCAN state (0.8.0, multi-scan) ------------------------------------
# A baseline file may carry several scans, each naming a subset of the frame's
# components in ITS OWN ORDER (T.81 § A.2.3 composes an interleaved MCU in scan
# order, not frame order). None of that had anywhere to live: _jpeg_parse_sos
# built a selector list locally and discarded it, and the MCU loop iterated
# frame components.
#
# JF_SCAN is that ordered list — the frame-component index plus the Huffman
# selectors THIS scan chose for it. Selectors live here rather than on the
# component because they are a property of the scan: a component absent from
# scan 2 would otherwise retain scan 1's, which is a silent wrong-table decode.
var JF_SCAN_NS          = 240;   # component count of the scan currently parsed
var JF_SCAN             = 248;   # 4 x 24-byte entries
var JF_SCAN_STRIDE      = 24;
var JF_SCAN_COMP        = 0;     # frame component index (0..3)
var JF_SCAN_TD          = 8;     # DC Huffman selector for THIS scan
var JF_SCAN_TA          = 16;    # AC Huffman selector for THIS scan
# Bitmask of frame components already decoded. It is the loop bound for the
# whole multi-scan driver: every successful scan sets at least one new bit and
# a component may be covered only once, so the driver terminates on the INDEX
# itself rather than on a scan counter that stands in for it. It is also what
# makes an omitted component detectable — Y=Cb=Cr=0 is solid green through the
# BT.601 constants, which decodes cleanly and looks plausible.
var JF_COVERED          = 344;
# 1 once a JFIF APP0 has been seen (B-2, 1.0.3). JFIF § 4.1 defines the sample
# space: one component is greyscale, three are Y/Cb/Cr. So a file that DECLARES
# itself JFIF has already answered the colour question, and nothing weaker may
# override it — see the authority order in _jpeg_build_image.
var JF_SAW_JFIF         = 352;
# Grown 320 -> 384 in 0.6.1 for the field above. This record is @internal and
# heap-allocated per decode, so growing it costs 8 bytes a decode and nothing
# else — but the 0.7.0 multi-scan work needs a per-component coverage bitmask
# and a resume position (ADR 0006), so the slack is left deliberately generous
# rather than shaved to fit.
var CHITRA_JPEG_FRAME_SIZE = 384;   # 360 used, 24 B spare

fn chitra_jpeg_frame_width(f): i64          { return load64(f + JF_WIDTH); }
fn chitra_jpeg_frame_height(f): i64         { return load64(f + JF_HEIGHT); }
fn chitra_jpeg_frame_precision(f): i64      { return load64(f + JF_PRECISION); }
fn chitra_jpeg_frame_num_components(f): i64 { return load64(f + JF_NCOMP); }
fn chitra_jpeg_frame_seen_sof(f): i64       { return load64(f + JF_SEEN_SOF); }
fn chitra_jpeg_frame_max_h(f): i64          { return load64(f + JF_MAX_H); }
fn chitra_jpeg_frame_max_v(f): i64          { return load64(f + JF_MAX_V); }
fn chitra_jpeg_frame_restart_interval(f): i64 { return load64(f + JF_RESTART_INTERVAL); }
fn chitra_jpeg_frame_quant_present(f): i64  { return load64(f + JF_QUANT_PRESENT); }
fn chitra_jpeg_frame_huff_present(f): i64   { return load64(f + JF_HUFF_PRESENT); }

# Per-component accessors. `i` is the component index (0..num_components-1).
fn chitra_jpeg_frame_comp_id(f, i): i64 { return load64(f + JF_COMP + i * JF_COMP_STRIDE + JF_COMP_ID); }
fn chitra_jpeg_frame_comp_h(f, i): i64  { return load64(f + JF_COMP + i * JF_COMP_STRIDE + JF_COMP_H); }
fn chitra_jpeg_frame_comp_v(f, i): i64  { return load64(f + JF_COMP + i * JF_COMP_STRIDE + JF_COMP_V); }
fn chitra_jpeg_frame_comp_tq(f, i): i64 { return load64(f + JF_COMP + i * JF_COMP_STRIDE + JF_COMP_TQ); }
fn chitra_jpeg_frame_sos_offset(f): i64  { return load64(f + JF_SOS_OFFSET); }
# -1 = no Adobe APP14 segment was present; 0 = RGB (or CMYK at 4 components),
# 1 = YCbCr, 2 = YCCK.
fn chitra_jpeg_frame_adobe_transform(f): i64 { return load64(f + JF_ADOBE_TRANSFORM); }
fn chitra_jpeg_frame_scan_ns(f): i64   { return load64(f + JF_SCAN_NS); }
fn chitra_jpeg_frame_covered(f): i64   { return load64(f + JF_COVERED); }
fn chitra_jpeg_frame_saw_jfif(f): i64  { return load64(f + JF_SAW_JFIF); }
fn chitra_jpeg_scan_comp(f, j): i64 { return load64(f + JF_SCAN + j * JF_SCAN_STRIDE + JF_SCAN_COMP); }
fn chitra_jpeg_scan_td(f, j): i64   { return load64(f + JF_SCAN + j * JF_SCAN_STRIDE + JF_SCAN_TD); }
fn chitra_jpeg_scan_ta(f, j): i64   { return load64(f + JF_SCAN + j * JF_SCAN_STRIDE + JF_SCAN_TA); }

# Quant-table entry t (0..3), zig-zag position k (0..63). De-zig-zag happens at
# dequant time (bite 5); this stores the raw spec order.
fn chitra_jpeg_frame_quant(f, t, k): i64 {
    return load64(load64(f + JF_QUANT) + (t * 64 + k) * 8);
}

# HuffTable ptr for class (0=DC, 1=AC) and id (0..3). The HuffTable layout +
# accessors (_jpeg_huff_*) live in jpeg_huffman.cyr.
fn chitra_jpeg_frame_huff(f, class, id): i64 {
    return load64(f + JF_HUFF) + (class * 4 + id) * HT_SIZE;
}

# Bump-allocator no-op (matches chitra_raw_free / chitra_image_free). Safe on 0.
fn chitra_jpeg_frame_free(f): i64 { return 0; }

# ================================================================
# Signature — every JPEG starts with SOI = 0xFF 0xD8 (T.81 § B.2.1).
# ================================================================
# @public
fn chitra_jpeg_check_signature(src, len): i64 {
    if (len < 2) { return 0; }
    if (load8(src) != 0xFF) { return 0; }
    if (load8(src + 1) != 0xD8) { return 0; }
    return 1;
}

# ================================================================
# Marker classifier. Returns an ACTION (1=SOF0/parse, 2=SOS/stop,
# 3=standalone/no-length, 4=length-bearing/skip, 5=DQT/parse, 6=DHT/parse,
# 7=DRI/parse, 8=APP14/parse) or a CHITRA_ERR_* reject code (>=13) for any non-baseline mode.
# Action values 1..8 never collide with the JPEG error codes (13..23).
# ================================================================
fn _jpeg_marker_action(m): i64 {
    if (m == 0xC0) { return 1; }                          # SOF0 baseline — parse
    if (m == 0xDA) { return 2; }                          # SOS — end of header scan
    if (m == 0xDB) { return 5; }                          # DQT — parse
    if (m == 0xC4) { return 6; }                          # DHT — parse
    if (m == 0xDD) { return 7; }                          # DRI — parse restart interval
    if (m == 0xE0) { return 9; }                          # APP0 — may be the JFIF identifier
    if (m == 0xEE) { return 8; }                          # APP14 — may carry the Adobe colour transform
    if (m == 0xC2) { return CHITRA_ERR_JPEG_PROGRESSIVE; }
    if (m == 0xC9) { return CHITRA_ERR_JPEG_ARITHMETIC; } # SOF9 ext-seq arithmetic
    if (m == 0xCA) { return CHITRA_ERR_JPEG_ARITHMETIC; } # SOF10 progressive arithmetic
    if (m == 0xCB) { return CHITRA_ERR_JPEG_ARITHMETIC; } # SOF11 lossless arithmetic
    if (m == 0xCC) { return CHITRA_ERR_JPEG_ARITHMETIC; } # DAC
    if (m == 0xC1) { return CHITRA_ERR_JPEG_MODE; }       # SOF1 extended sequential
    if (m == 0xC3) { return CHITRA_ERR_JPEG_MODE; }       # SOF3 lossless
    if (m == 0xC5) { return CHITRA_ERR_JPEG_MODE; }       # SOF5 differential sequential
    if (m == 0xC6) { return CHITRA_ERR_JPEG_MODE; }       # SOF6 differential progressive
    if (m == 0xC7) { return CHITRA_ERR_JPEG_MODE; }       # SOF7 differential lossless
    if (m == 0xCD) { return CHITRA_ERR_JPEG_MODE; }       # SOF13 differential seq arithmetic
    if (m == 0xCE) { return CHITRA_ERR_JPEG_MODE; }       # SOF14 differential prog arithmetic
    if (m == 0xCF) { return CHITRA_ERR_JPEG_MODE; }       # SOF15 differential lossless arithmetic
    if (m == 0xD9) { return CHITRA_ERR_JPEG_MARKER; }     # EOI before SOS — no scan present
    if (m >= 0xD0 && m <= 0xD7) { return 3; }             # RSTn standalone
    if (m == 0x01) { return 3; }                          # TEM standalone
    # T.81 Table B.1 — everything below is NOT a length-bearing segment, so
    # falling through to action 4 made the walk read the next two stream bytes
    # as a segment length and skip that far: a parser desync steered entirely
    # by attacker bytes (bounds-checked, so not an overread, but it can jump
    # the cursor over a real segment).
    if (m == 0x00) { return CHITRA_ERR_JPEG_MARKER; }     # FF00 is entropy stuffing, not a marker
    if (m == 0xD8) { return CHITRA_ERR_JPEG_MARKER; }     # SOI is standalone; a second one is malformed
    if (m >= 0x02 && m <= 0xBF) { return CHITRA_ERR_JPEG_MARKER; }   # reserved (RES)
    return 4;   # APPn / COM / DNL / ... — length-bearing, skipped (not decoded)
}

# ================================================================
# Lazy table storage (0.6.1).
#
# Through 0.6.0 chitra_jpeg_scan_markers allocated the quantization store
# (2,048 B) and all eight Huffman records (8 x 2,464 = 19,712 B) up front, on
# every call, BEFORE any validation that could refuse the file. So a 15-byte
# JPEG whose SOF0 declares 12-bit precision — refused, correctly, and
# permanently — still cost 22,160 bytes that the bump allocator never reclaims,
# unmemoized, every call. That is ~1,400:1 amplification on the REFUSAL path,
# which is the path a consumer under attack takes most.
#
# Allocating on first use drops that to 400 bytes (the frame record plus the
# ChitraErr), and costs a real file nothing: a JPEG that defines tables pays
# exactly what it paid before, one segment later.
# ================================================================
fn _jpeg_alloc_quant(frame): i64 {
    var quant = alloc(CHITRA_MAX_QUANT_TABLES * 64 * 8);
    if (quant == 0) { return 0; }
    store64(frame + JF_QUANT, quant);
    var z = 0;
    while (z < CHITRA_MAX_QUANT_TABLES * 64) {
        store64(quant + z * 8, 0);
        z = z + 1;
    }
    return quant;
}

fn _jpeg_alloc_huff(frame): i64 {
    var huff = alloc(8 * HT_SIZE);
    if (huff == 0) { return 0; }
    store64(frame + JF_HUFF, huff);
    # Zero the Huffman storage exactly as the quant storage above is zeroed.
    # JF_HUFF_PRESENT already gates every table selector against a table a DHT
    # actually defined, so this is defence in depth rather than a live bug — but
    # an un-zeroed table reached through any future path would decode from
    # whatever the bump allocator last left there. 8 * HT_SIZE bytes is
    # 8 * 2464 = 19712, i.e. HT_SIZE i64 slots.
    var z = 0;
    while (z < HT_SIZE) {
        store64(huff + z * 8, 0);
        z = z + 1;
    }
    return huff;
}

# ================================================================
# Parse a DQT segment (T.81 § B.2.4). Cursor is at the 2-byte length field.
# A DQT may carry multiple tables. Baseline allows 8-bit precision only (Pq=0).
# Values are stored in spec (zig-zag) order; de-zig-zag is deferred to dequant.
# Returns 0 on success, or a CHITRA_ERR_* code.
# ================================================================
fn _jpeg_parse_dqt(cur, frame): i64 {
    if (_cur_can_read(cur, 2) == 0) { return CHITRA_ERR_TRUNCATED; }
    var seglen = _cur_u16_be(cur);
    if (seglen < 2) { return CHITRA_ERR_JPEG_DQT; }
    var remaining = seglen - 2;
    if (_cur_can_read(cur, remaining) == 0) { return CHITRA_ERR_TRUNCATED; }
    # Allocate the quantization store the first time a DQT actually defines
    # something (0.6.1 — see _jpeg_alloc_quant). The `== 0` test is what makes
    # this at-most-once: a file carrying twenty DQT segments allocates one
    # store, not twenty.
    var quant = load64(frame + JF_QUANT);
    if (quant == 0) {
        quant = _jpeg_alloc_quant(frame);
        if (quant == 0) { return CHITRA_ERR_OOM; }
    }
    var rc = 0;
    var done = 0;
    var pqtq = 0;
    var pq = 0;
    var tq = 0;
    var k = 0;
    var v = 0;
    var present = 0;
    while (done == 0) {
        if (remaining <= 0) { done = 1; }
        if (done == 0) {
            pqtq = _cur_u8(cur);
            remaining = remaining - 1;
            pq = (pqtq >> 4) & 15;
            tq = pqtq & 15;
            if (pq != 0) { rc = CHITRA_ERR_JPEG_DQT; done = 1; }     # 8-bit only (baseline)
            if (done == 0) {
                if (tq >= CHITRA_MAX_QUANT_TABLES) { rc = CHITRA_ERR_JPEG_DQT; done = 1; }
            }
            if (done == 0) {
                if (remaining < 64) { rc = CHITRA_ERR_JPEG_DQT; done = 1; }
            }
            if (done == 0) {
                k = 0;
                while (k < 64) {
                    v = _cur_u8(cur);
                    store64(quant + (tq * 64 + k) * 8, v);
                    k = k + 1;
                }
                remaining = remaining - 64;
                present = load64(frame + JF_QUANT_PRESENT);
                present = present | (1 << tq);
                store64(frame + JF_QUANT_PRESENT, present);
            }
        }
    }
    return rc;
}

# ================================================================
# Parse a DHT segment (T.81 § B.2.4.2). Cursor is at the 2-byte length field.
# A DHT may carry multiple tables; each is Tc/Th (class/id) + 16 BITS counts +
# Σcounts symbol bytes. Validates Tc in {0,1}, Th < 4, Σcounts ≤ 256 and
# in-bounds, then builds the canonical decode table (jpeg_huffman.cyr) into the
# frame's storage (slot = Tc*4 + Th). Returns 0 on success or a CHITRA_ERR_* code.
# ================================================================
fn _jpeg_parse_dht(cur, frame): i64 {
    if (_cur_can_read(cur, 2) == 0) { return CHITRA_ERR_TRUNCATED; }
    var seglen = _cur_u16_be(cur);
    if (seglen < 2) { return CHITRA_ERR_JPEG_DHT; }
    var remaining = seglen - 2;
    if (_cur_can_read(cur, remaining) == 0) { return CHITRA_ERR_TRUNCATED; }
    # As in _jpeg_parse_dqt: allocate on first real use, at most once. The
    # at-most-once property is not a tidiness point, it is the whole guard —
    # a single DHT segment may carry up to 3,854 table definitions, and
    # allocating a 2,464-byte record per DEFINITION rather than per FRAME would
    # trade this cut's flat 22 KB refusal cost for one that SCALES with file
    # size (~9.5 MB from a 64 KB segment). Allocating the whole 8-slot block
    # once makes that unreachable by construction rather than by a bound.
    var huff = load64(frame + JF_HUFF);
    if (huff == 0) {
        huff = _jpeg_alloc_huff(frame);
        if (huff == 0) { return CHITRA_ERR_OOM; }
    }
    var bits[136];           # 17 i64 (index 1..16 = BITS counts)
    var rc = 0;
    var done = 0;
    var tcth = 0;
    var tc = 0;
    var th = 0;
    var total = 0;
    var L = 0;
    var cnt = 0;
    var slot = 0;
    var table = 0;
    var i = 0;
    var v = 0;
    var present = 0;
    while (done == 0) {
        if (remaining <= 0) { done = 1; }
        if (done == 0) {
            # each table header is 1 (Tc/Th) + 16 (BITS) bytes minimum
            if (remaining < 17) { rc = CHITRA_ERR_JPEG_DHT; done = 1; }
        }
        if (done == 0) {
            tcth = _cur_u8(cur);
            remaining = remaining - 1;
            tc = (tcth >> 4) & 15;
            th = tcth & 15;
            if (tc > 1) { rc = CHITRA_ERR_JPEG_DHT; done = 1; }      # class 0=DC, 1=AC
            if (done == 0) {
                if (th >= CHITRA_MAX_HUFF_TABLES) { rc = CHITRA_ERR_JPEG_DHT; done = 1; }
            }
        }
        if (done == 0) {
            total = 0;
            L = 1;
            while (L <= 16) {
                cnt = _cur_u8(cur);
                store64(&bits + L * 8, cnt);
                total = total + cnt;
                L = L + 1;
            }
            remaining = remaining - 16;
            if (total > 256) { rc = CHITRA_ERR_JPEG_DHT; done = 1; }
        }
        if (done == 0) {
            if (remaining < total) { rc = CHITRA_ERR_JPEG_DHT; done = 1; }
        }
        if (done == 0) {
            slot = tc * 4 + th;
            table = huff + slot * HT_SIZE;
            store64(table + HT_COUNT, total);
            i = 0;
            while (i < total) {
                v = _cur_u8(cur);
                store64(table + HT_HUFFVAL + i * 8, v);
                i = i + 1;
            }
            remaining = remaining - total;
            rc = _jpeg_huff_build(table, &bits);
            if (rc != 0) { done = 1; }
            if (done == 0) {
                present = load64(frame + JF_HUFF_PRESENT);
                present = present | (1 << slot);
                store64(frame + JF_HUFF_PRESENT, present);
            }
        }
    }
    return rc;
}

# ================================================================
# Parse an APP14 segment (0xFFEE), which is where Adobe records the COLOUR
# TRANSFORM applied to the component data. This is not decoration: for a
# 3-component frame the transform is the difference between YCbCr (apply the
# BT.601 inverse) and RGB (apply nothing), and guessing wrong hue-rotates the
# whole image.
#
# chitra skipped every APPn through 0.6.0, so `cjpeg -rgb` output — a real
# baseline JPEG with SOF0 component ids 'R','G','B', an Adobe APP14 carrying
# transform = 0, and no JFIF APP0 — decoded as YCbCr with NO error raised:
# 1149 of 1536 bytes wrong on a 24x16 fixture, max delta 235. A blue pixel came
# back dark red. That is the silent-wrong-output class this project treats as
# the most serious kind of defect, and a fuzzer cannot see it.
#
# Payload layout (Adobe TN 5116): 'A','d','o','b','e', version (2 bytes),
# flags0 (2), flags1 (2), transform (1) = 12 bytes, so a conforming segment is
# 14 bytes including its own length field. An APP14 that is NOT Adobe's (the
# marker is not reserved to them) is skipped exactly as before.
# Returns 0 on success, or a CHITRA_ERR_* code.
# ================================================================
# ================================================================
# APP0 — is this a JFIF file? (B-2, 1.0.3)
#
# Only the five-byte identifier matters: version, density and the thumbnail are
# metadata chitra has no use for. The segment is skipped whole either way; the
# single bit recorded is whether it said "JFIF\0".
#
# ⛔ WHY IT IS RECORDED AT ALL. Through 1.0.2 APP0 fell through to the generic
# length-skip, so nothing in the tree knew a file was JFIF — and the colour
# decision's second rule, "component ids 'R','G','B' name the space outright",
# then applied to files that had already declared themselves YCbCr. Six edited
# bytes turned an ordinary cjpeg image into a whole-image colour error with no
# error code, while `source_color_type` actively asserted 0x113 (RGB) to the
# consumer. libjpeg does not have this hole because `default_decompress_parms`
# tests `saw_JFIF_marker` FIRST; chitra now does the same.
# ================================================================
fn _jpeg_parse_app0(cur, frame): i64 {
    if (_cur_can_read(cur, 2) == 0) { return CHITRA_ERR_TRUNCATED; }
    var seglen = _cur_u16_be(cur);
    if (seglen < 2) { return CHITRA_ERR_JPEG_MARKER; }
    var remaining = seglen - 2;
    if (_cur_can_read(cur, remaining) == 0) { return CHITRA_ERR_TRUNCATED; }
    # Shorter than the identifier cannot be JFIF; skip it whole.
    if (remaining < 5) {
        _cur_skip(cur, remaining);
        return 0;
    }
    var b0 = _cur_u8(cur);
    var b1 = _cur_u8(cur);
    var b2 = _cur_u8(cur);
    var b3 = _cur_u8(cur);
    var b4 = _cur_u8(cur);
    if (b0 == 0x4A) {
        if (b1 == 0x46) {
            if (b2 == 0x49) {
                if (b3 == 0x46) {
                    if (b4 == 0x00) { store64(frame + JF_SAW_JFIF, 1); }
                }
            }
        }
    }
    _cur_skip(cur, remaining - 5);
    return 0;
}

fn _jpeg_parse_app14(cur, frame): i64 {
    if (_cur_can_read(cur, 2) == 0) { return CHITRA_ERR_TRUNCATED; }
    var seglen = _cur_u16_be(cur);
    if (seglen < 2) { return CHITRA_ERR_JPEG_MARKER; }
    var remaining = seglen - 2;
    if (_cur_can_read(cur, remaining) == 0) { return CHITRA_ERR_TRUNCATED; }
    # Anything shorter than the Adobe payload cannot be one; skip it whole.
    if (remaining < 12) {
        _cur_skip(cur, remaining);
        return 0;
    }
    var b0 = _cur_u8(cur);
    var b1 = _cur_u8(cur);
    var b2 = _cur_u8(cur);
    var b3 = _cur_u8(cur);
    var b4 = _cur_u8(cur);
    var is_adobe = 0;
    if (b0 == 0x41) {
        if (b1 == 0x64) {
            if (b2 == 0x6F) {
                if (b3 == 0x62) {
                    if (b4 == 0x65) { is_adobe = 1; }
                }
            }
        }
    }
    if (is_adobe == 0) {
        _cur_skip(cur, remaining - 5);
        return 0;
    }
    _cur_skip(cur, 6);                  # version (2) + flags0 (2) + flags1 (2)
    var transform = _cur_u8(cur);
    _cur_skip(cur, remaining - 12);     # any trailing bytes in an over-long segment
    # Only 0, 1 and 2 are defined. chitra implements 0 and 1; 2 is YCCK, which
    # only occurs on the 4-component frames it already refuses. An undefined
    # value is declined rather than guessed at — assuming YCbCr is exactly the
    # guess that produced the defect this parser exists to fix.
    if (transform > 1) { return CHITRA_ERR_UNSUPPORTED; }
    store64(frame + JF_ADOBE_TRANSFORM, transform);
    return 0;
}

# ================================================================
# Parse a DRI segment (T.81 § B.2.4.4): Lr(2) Ri(2). Sets the restart interval
# (number of MCUs between RSTn markers; 0 disables). Returns 0 or a CHITRA_ERR_*.
# ================================================================
fn _jpeg_parse_dri(cur, frame): i64 {
    if (_cur_can_read(cur, 2) == 0) { return CHITRA_ERR_TRUNCATED; }
    var seglen = _cur_u16_be(cur);
    if (seglen != 4) { return CHITRA_ERR_JPEG_MARKER; }
    if (_cur_can_read(cur, 2) == 0) { return CHITRA_ERR_TRUNCATED; }
    store64(frame + JF_RESTART_INTERVAL, _cur_u16_be(cur));
    return 0;
}

# ================================================================
# Parse a SOF0 segment (T.81 § B.2.2): Lf(2) P(1) Y(2) X(2) Nf(1) then Nf*3
# component specs (Ci, Hi/Vi packed, Tqi). Cursor is at the 2-byte length.
# Validates precision, component count, dimensions, sampling factors (1..4,
# reject 0 → CVE-2018-11212 div-by-zero) and duplicate component ids. It does
# NOT enforce ΣHi·Vi ≤ 10: that bounds an INTERLEAVED MCU (T.81 § B.2.3), so it
# lives in _jpeg_parse_sos (jpeg.cyr) conditioned on Ns > 1 — applied frame-wide
# it rejects files libjpeg writes, e.g. `cjpeg -sample 4x4,1x1,1x1 -scans`.
# Returns 0 on success (frame filled) or a CHITRA_ERR_* code.
# ================================================================
fn _jpeg_parse_sof0(cur, frame): i64 {
    if (_cur_can_read(cur, 2) == 0) { return CHITRA_ERR_TRUNCATED; }
    var seglen = _cur_u16_be(cur);
    if (seglen < 11) { return CHITRA_ERR_JPEG_SOF; }      # 8 + 3*1 minimum
    if (_cur_can_read(cur, seglen - 2) == 0) { return CHITRA_ERR_TRUNCATED; }
    var precision = _cur_u8(cur);
    var height = _cur_u16_be(cur);
    var width = _cur_u16_be(cur);
    var ncomp = _cur_u8(cur);
    if (precision != 8) { return CHITRA_ERR_JPEG_PRECISION; }
    if (ncomp != 1 && ncomp != 3) { return CHITRA_ERR_JPEG_COMPONENTS; }
    # Y==0 (DNL-deferred height) is rejected, never decoded with a 0-height
    # buffer — see docs/adr/0004 scope.
    if (width == 0 || height == 0) { return CHITRA_ERR_DIMENSIONS; }
    if (width > CHITRA_MAX_DIM || height > CHITRA_MAX_DIM) { return CHITRA_ERR_DIMENSIONS; }
    if (width * height > CHITRA_MAX_PIXELS) { return CHITRA_ERR_DIMENSIONS; }
    if (seglen != 8 + 3 * ncomp) { return CHITRA_ERR_JPEG_SOF; }

    var rc = 0;
    var done = 0;
    var i = 0;
    var cid = 0;
    var hv = 0;
    var ch = 0;
    var cv = 0;
    var ctq = 0;
    var max_h = 1;
    var max_v = 1;
    var blocks = 0;
    var j = 0;
    var dup = 0;
    var base = 0;
    while (done == 0) {
        if (i >= ncomp) { done = 1; }
        if (done == 0) {
            cid = _cur_u8(cur);
            hv = _cur_u8(cur);
            ctq = _cur_u8(cur);
            ch = (hv >> 4) & 15;
            cv = hv & 15;
            if (ch < 1 || ch > CHITRA_MAX_SAMP_FACTOR) { rc = CHITRA_ERR_JPEG_SOF; done = 1; }
            if (done == 0) {
                if (cv < 1 || cv > CHITRA_MAX_SAMP_FACTOR) { rc = CHITRA_ERR_JPEG_SOF; done = 1; }
            }
            if (done == 0) {
                if (ctq >= CHITRA_MAX_QUANT_TABLES) { rc = CHITRA_ERR_JPEG_SOF; done = 1; }
            }
            if (done == 0) {
                # duplicate component id check against prior components
                dup = 0;
                j = 0;
                while (j < i) {
                    if (load64(frame + JF_COMP + j * JF_COMP_STRIDE + JF_COMP_ID) == cid) { dup = 1; }
                    j = j + 1;
                }
                if (dup == 1) { rc = CHITRA_ERR_JPEG_SOF; done = 1; }
            }
            if (done == 0) {
                base = JF_COMP + i * JF_COMP_STRIDE;
                store64(frame + base + JF_COMP_ID, cid);
                store64(frame + base + JF_COMP_H, ch);
                store64(frame + base + JF_COMP_V, cv);
                store64(frame + base + JF_COMP_TQ, ctq);
                if (ch > max_h) { max_h = ch; }
                if (cv > max_v) { max_v = cv; }
                blocks = blocks + ch * cv;
                i = i + 1;
            }
        }
    }
    if (rc != 0) { return rc; }
    # The SigmaHj*Vj <= 10 restriction is NOT applied here. T.81 § B.2.3 places
    # it on "the image components contained in the SCAN", conditioned on Ns > 1
    # — it bounds one interleaved MCU, and a frame does not have one. Applying
    # it frame-wide rejected files libjpeg writes on request: `cjpeg -sample
    # 4x4,1x1,1x1 -scans <script>` produces a valid 692-byte baseline JPEG
    # (SigmaHi*Vi = 18) that djpeg decodes, while cjpeg REFUSES the same factors
    # interleaved ("Sampling factors too large for interleaved scan"). The two
    # facts together are the spec's own reading. The check now lives in
    # _jpeg_parse_sos, over the scan's components, where it can be conditioned
    # on Ns as § B.2.3 conditions it — and still ahead of every allocation,
    # because planes are allocated per scan after the header is parsed.
    store64(frame + JF_WIDTH, width);
    store64(frame + JF_HEIGHT, height);
    store64(frame + JF_PRECISION, precision);
    store64(frame + JF_NCOMP, ncomp);
    store64(frame + JF_MAX_H, max_h);
    store64(frame + JF_MAX_V, max_v);
    store64(frame + JF_SEEN_SOF, 1);
    return 0;
}

# ================================================================
# _jpeg_resume_to_next_scan — continue the marker walk AFTER a scan (0.8.0).
#
# `resume` points at the 0xFF that terminated the previous scan's entropy data,
# which is a BYTE-STRUCTURAL position: the caller computes it as
# `entropy_start + _jpeg_entropy_span(...)`, never from the bit reader's
# position. That distinction retires the first blocker ADR 0006 listed — the
# fear that a resumed walk would be steered by a cursor inside decoded content,
# which a planted FF DA could freeze. Nothing here consults the reader.
#
# This is a SEPARATE function from chitra_jpeg_scan_markers rather than a mode
# flag on it, because that function re-zeroes the whole frame on entry and stops
# unconditionally at the first SOS — and it is on the path of every JPEG in the
# tree. The two share _jpeg_marker_action and the length-skip shape; they share
# no state handling.
#
# It ZEROES NOTHING. Table PRESENCE accumulates across scans and table CONTENT
# is whatever the file last defined, which is not hygiene but a requirement:
# real `cjpeg -scans` output puts DHT segments BETWEEN scans, and its last scan
# often carries none of its own.
#
# Returns the offset of the next SOS length field; or 0 with *err_out clear for
# a clean end (EOI, or the input simply ran out); or 0 with *err_out set.
# ================================================================
fn _jpeg_resume_to_next_scan(frame, src, len, resume, err_out): i64 {
    store64(err_out, 0);
    var cur[24];
    _cur_init(&cur, src, len);
    _cur_skip(&cur, resume);
    var rc = 0;
    var done = 0;
    var found = 0;
    var b = 0;
    var m = 0;
    var act = 0;
    var seglen = 0;
    while (done == 0) {
        if (_cur_can_read(&cur, 2) == 0) { done = 1; }        # clean stop
        if (done == 0) {
            b = _cur_u8(&cur);
            if (b != 0xFF) { rc = CHITRA_ERR_JPEG_MARKER; done = 1; }
        }
        if (done == 0) {
            # Collapse a run of fill bytes (§ B.1.1.2).
            m = _cur_u8(&cur);
            while (m == 0xFF) {
                if (_cur_can_read(&cur, 1) == 0) { m = 0; }
                if (m == 0xFF) { m = _cur_u8(&cur); }
            }
            # EOI is tested BEFORE the classifier. _jpeg_marker_action maps it to
            # CHITRA_ERR_JPEG_MARKER because in the HEADER walk it means "no scan
            # present", and that remains true where it lives — here it simply
            # means the file ended, which is the normal way a multi-scan file
            # stops. Testing it here rather than changing the shared classifier
            # is what keeps both meanings correct.
            if (m == 0xD9) { done = 1; }
        }
        if (done == 0) {
            act = _jpeg_marker_action(m);
            if (act >= 13) { rc = act; done = 1; }
            if (act == 1) {
                # A second SOF0, after geometry has been derived and planes
                # allocated from the first. Refuse rather than redefine.
                rc = CHITRA_ERR_JPEG_SOF;
                done = 1;
            }
            if (act == 5) {
                rc = _jpeg_parse_dqt(&cur, frame);
                if (rc != 0) { done = 1; }
            }
            if (act == 6) {
                rc = _jpeg_parse_dht(&cur, frame);
                if (rc != 0) { done = 1; }
            }
            if (act == 7) {
                # DRI is legal between scans (§ B.2.4.4), so a restart interval
                # can change per scan. Parsing it here is all that is needed —
                # each scan reads the interval from the frame at entry.
                rc = _jpeg_parse_dri(&cur, frame);
                if (rc != 0) { done = 1; }
            }
            if (act == 8) {
                rc = _jpeg_parse_app14(&cur, frame);
                if (rc != 0) { done = 1; }
            }
            if (act == 9) {
                rc = _jpeg_parse_app0(&cur, frame);
                if (rc != 0) { done = 1; }
            }
            if (act == 2) {
                store64(frame + JF_SOS_OFFSET, _cur_pos(&cur));
                found = _cur_pos(&cur);
                done = 1;
            }
            if (act == 4) {
                if (_cur_can_read(&cur, 2) == 0) { rc = CHITRA_ERR_TRUNCATED; done = 1; }
                if (done == 0) {
                    seglen = _cur_u16_be(&cur);
                    if (seglen < 2) { rc = CHITRA_ERR_JPEG_MARKER; done = 1; }
                }
                if (done == 0) {
                    if (_cur_can_read(&cur, seglen - 2) == 0) { rc = CHITRA_ERR_TRUNCATED; done = 1; }
                }
                if (done == 0) { _cur_skip(&cur, seglen - 2); }
            }
            # act == 3 (standalone): nothing to skip, keep walking.
        }
    }
    if (rc != 0) {
        store64(err_out, chitra_err(rc));
        return 0;
    }
    return found;
}

# ================================================================
# chitra_jpeg_scan_markers — validate the JPEG marker structure from SOI up to
# SOS, parsing DQT/DHT tables and the SOF0 frame header and rejecting
# non-baseline modes. Returns a ChitraJpegFrame ptr (caller-owned) on success,
# or 0 with *err_out set to a ChitraErr. Mirrors the (ptr, err_out) split.
#
# The walk always advances >= 2 bytes per iteration (the FF + marker code) or
# terminates on the can_read(2) gate, so it cannot loop forever on bad input.
# ================================================================
fn chitra_jpeg_scan_markers(src, len, err_out): i64 {
    store64(err_out, 0);
    if (chitra_jpeg_check_signature(src, len) == 0) {
        store64(err_out, chitra_err(CHITRA_ERR_SIGNATURE));
        return 0;
    }
    var frame = alloc(CHITRA_JPEG_FRAME_SIZE);
    if (frame == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    store64(frame + JF_WIDTH, 0);
    store64(frame + JF_HEIGHT, 0);
    store64(frame + JF_PRECISION, 0);
    store64(frame + JF_NCOMP, 0);
    store64(frame + JF_SEEN_SOF, 0);
    store64(frame + JF_MAX_H, 0);
    store64(frame + JF_MAX_V, 0);
    store64(frame + JF_RESTART_INTERVAL, 0);
    store64(frame + JF_QUANT_PRESENT, 0);
    store64(frame + JF_HUFF_PRESENT, 0);
    store64(frame + JF_SOS_OFFSET, 0);
    store64(frame + JF_ADOBE_TRANSFORM, 0 - 1);   # -1 = no Adobe APP14 seen
    store64(frame + JF_SCAN_NS, 0);
    store64(frame + JF_COVERED, 0);
    store64(frame + JF_SAW_JFIF, 0);
    # The quantization and Huffman stores are NOT allocated here — see
    # _jpeg_alloc_quant / _jpeg_alloc_huff. A file that never defines a table
    # never pays for one, which is what makes the refusal path cheap.
    store64(frame + JF_QUANT, 0);
    store64(frame + JF_HUFF, 0);

    var cur[24];
    _cur_init(&cur, src, len);
    _cur_skip(&cur, 2);   # past SOI

    var done = 0;
    var rc = 0;
    var b = 0;
    var m = 0;
    var act = 0;
    var seglen = 0;
    var fill_done = 0;

    while (done == 0) {
        if (_cur_can_read(&cur, 2) == 0) { rc = CHITRA_ERR_JPEG_MARKER; done = 1; }
        if (done == 0) {
            b = _cur_u8(&cur);
            if (b != 0xFF) { rc = CHITRA_ERR_JPEG_MARKER; done = 1; }
        }
        if (done == 0) {
            m = _cur_u8(&cur);
            # collapse a run of fill 0xFF bytes before the marker code
            fill_done = 0;
            while (fill_done == 0) {
                if (m != 0xFF) { fill_done = 1; }
                if (m == 0xFF) {
                    if (_cur_can_read(&cur, 1) == 0) { fill_done = 1; }
                    if (_cur_can_read(&cur, 1) == 1) { m = _cur_u8(&cur); }
                }
            }
            if (m == 0xFF) { rc = CHITRA_ERR_JPEG_MARKER; done = 1; }
        }
        if (done == 0) {
            act = _jpeg_marker_action(m);
            if (act >= 13) { rc = act; done = 1; }
            if (act == 1) {
                if (load64(frame + JF_SEEN_SOF) == 1) { rc = CHITRA_ERR_JPEG_SOF; done = 1; }
                if (done == 0) {
                    rc = _jpeg_parse_sof0(&cur, frame);
                    if (rc != 0) { done = 1; }
                }
            }
            if (act == 5) {
                rc = _jpeg_parse_dqt(&cur, frame);
                if (rc != 0) { done = 1; }
            }
            if (act == 6) {
                rc = _jpeg_parse_dht(&cur, frame);
                if (rc != 0) { done = 1; }
            }
            if (act == 7) {
                rc = _jpeg_parse_dri(&cur, frame);
                if (rc != 0) { done = 1; }
            }
            if (act == 8) {
                rc = _jpeg_parse_app14(&cur, frame);
                if (rc != 0) { done = 1; }
            }
            if (act == 9) {
                rc = _jpeg_parse_app0(&cur, frame);
                if (rc != 0) { done = 1; }
            }
            if (act == 2) {
                if (load64(frame + JF_SEEN_SOF) == 0) { rc = CHITRA_ERR_JPEG_SOF; }
                if (rc == 0) { store64(frame + JF_SOS_OFFSET, _cur_pos(&cur)); }
                done = 1;   # SOS reached; entropy data follows (decoded by jpeg.cyr)
            }
            if (act == 4) {
                if (_cur_can_read(&cur, 2) == 0) { rc = CHITRA_ERR_TRUNCATED; done = 1; }
                if (done == 0) {
                    seglen = _cur_u16_be(&cur);
                    if (seglen < 2) { rc = CHITRA_ERR_JPEG_MARKER; done = 1; }
                }
                if (done == 0) {
                    if (_cur_can_read(&cur, seglen - 2) == 0) { rc = CHITRA_ERR_TRUNCATED; done = 1; }
                }
                if (done == 0) { _cur_skip(&cur, seglen - 2); }
            }
            # act == 3 (standalone marker): nothing to skip, loop continues
        }
    }

    if (rc != 0) {
        store64(err_out, chitra_err(rc));
        return 0;
    }
    return frame;
}

# --- jpeg.cyr ---

# @public — chitra JPEG decoder: JPEG bytes -> canonical RGBA8 (0.3.0).
# jpeg.cyr — the public decode entry. Wires the marker scan (jpeg_markers),
# the SOS scan header, the entropy/IDCT block pipeline (jpeg_huffman + jpeg_idct),
# and the color pass into a ChitraImage (the same 56-byte result PNG produces).
#
# Scope: baseline JFIF — grayscale (1 component), YCbCr (3), and RGB (3, via
# the Adobe APP14 transform or 'R','G','B' component ids — 0.6.1, ADR 0009);
# arbitrary chroma subsampling (4:4:4 / 4:2:2 / 4:2:0 / general Hi,Vi) with box
# upsampling; DRI/RSTn restart markers; and the complete T.81 § A.2 scan model
# — interleaved, non-interleaved, partially interleaved, single- and multi-scan
# (0.6.0 for Nf = 1, 0.8.0 for the rest) — every baseline scan geometry decodes.
#
# The result is the shared ChitraImage (offsets from png.cyr); source_color_type
# carries a JPEG sentinel — 0x100 | ncomp, plus bit 4 when the components are
# RGB rather than YCbCr, so 0x101 gray / 0x103 YCbCr / 0x113 RGB — and a
# consumer's PNG 0/2/3/4/6 switch never aliases it (ADR 0003 / review).

# ================================================================
# YCbCr -> RGB color conversion (JFIF full-range, ITU-R BT.601). Fixed-point
# with SCALEBITS=16, the libjpeg jdcolor constants:
#   R = Y                         + 1.40200*(Cr-128)
#   G = Y - 0.34414*(Cb-128)      - 0.71414*(Cr-128)
#   B = Y + 1.77200*(Cb-128)
# Descale uses the IDCT's signed round-to-nearest _jpeg_descale (Cyrius `>>` is
# logical). Source: libjpeg jdcolor.c; ITU-R BT.601. See docs/sources.md.
# ================================================================
var JCC_CR_R = 91881;    # FIX(1.40200)
var JCC_CB_B = 116130;   # FIX(1.77200)
var JCC_CB_G = 22554;    # FIX(0.34414)
var JCC_CR_G = 46802;    # FIX(0.71414)

fn _jpeg_clamp8(v): i64 {
    if (v < 0) { return 0; }
    if (v > 255) { return 255; }
    return v;
}

# Convert one YCbCr triple to RGB, writing 3 bytes (R, G, B) at dst.
fn _jpeg_ycc_to_rgb(y, cb, cr, dst): i64 {
    var crr = cr - 128;
    var cbb = cb - 128;
    var r = y + _jpeg_descale(JCC_CR_R * crr, 16);
    var g = y - _jpeg_descale(JCC_CB_G * cbb + JCC_CR_G * crr, 16);
    var b = y + _jpeg_descale(JCC_CB_B * cbb, 16);
    store8(dst + 0, _jpeg_clamp8(r));
    store8(dst + 1, _jpeg_clamp8(g));
    store8(dst + 2, _jpeg_clamp8(b));
    return 0;
}

# ================================================================
# Parse the SOS scan header (T.81 § B.2.3) at frame.sos_offset (the 2-byte Ls
# field). Validates the scan against the frame, records each component's DC/AC
# Huffman selectors (Td/Ta), and enforces the baseline spectral selection
# (Ss=0, Se=63, Ah=Al=0). Returns the byte offset where the entropy-coded data
# begins, or 0 with *err_out set.
# ================================================================
fn _jpeg_parse_sos(frame, src, len, sos_off, err_out): i64 {
    store64(err_out, 0);
    var cur[24];
    _cur_init(&cur, src, len);
    # The caller names the offset. With multi-scan there is no single "the" SOS
    # position on the frame to read, and passing it removes the need for a
    # resume-position field entirely.
    _cur_skip(&cur, sos_off);
    if (_cur_can_read(&cur, 3) == 0) { store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED)); return 0; }
    var ls = _cur_u16_be(&cur);
    var ns = _cur_u8(&cur);
    var ncomp = chitra_jpeg_frame_num_components(frame);
    # T.81 § B.2.3 bounds Ns as 1 <= Ns <= 4 and requires each Csj to name a
    # DISTINCT component of the frame, so Ns > Nf is malformed by pigeonhole.
    # Both are VALIDITY failures and keep CHITRA_ERR_JPEG_SOS — the point of
    # splitting them out is that the third case below is not one.
    #
    # Ns < 1 is load-bearing: neuter it and an Ns = 0 scan falls into the Ns < Nf
    # branch and is reported as a DEFERRAL (code 4) — chitra would be saying it
    # declines a file that is simply malformed.
    #
    # Ns > Nf changes no error code today: with it removed, such a scan reaches
    # the selector loop below, where the duplicate-Cs guard rejects it with the
    # same 17 (Ns > Nf forces a repeat, since only Nf distinct ids exist). Keep
    # it anyway, and not for tidiness — it is what BOUNDS THE WRITE INDEX of
    # `seencs` below. With it, the loop runs at most ncomp times; without it,
    # the bound on `i` comes indirectly from "distinct SOF ids run out", which is
    # a proxy for the index rather than the index itself. `seencs` holds
    # CHITRA_MAX_COMPONENTS entries and ncomp is today restricted to {1,3}
    # (jpeg_markers.cyr:333), so both forms are in bounds — but only the direct
    # bound stays correct if that restriction is ever widened.
    if (ns < 1) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
    if (ns > ncomp) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
    # Ns < Nf is no longer refused: 0.8.0 decodes it. The bound that replaces
    # the gate is the coverage bitmask — a component may be decoded exactly
    # once, so a file gets at most Nf scans and every one must name something
    # new. See ADR 0006 (amended) and the driver below.
    if (ls != 6 + 2 * ns) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
    if (_cur_can_read(&cur, 2 * ns + 3) == 0) { store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED)); return 0; }

    # Clear the scan list before filling it. A frame outlives its scans, and
    # entries past this scan's `ns` would otherwise be whatever the PREVIOUS
    # scan left — the same "state that is only ever set, never cleared" shape as
    # the 0.5.3 GIF transparent-index defect, one module over.
    store64(frame + JF_SCAN_NS, 0);
    var z = 0;
    while (z < CHITRA_MAX_COMPONENTS) {
        store64(frame + JF_SCAN + z * JF_SCAN_STRIDE + JF_SCAN_COMP, 0 - 1);
        store64(frame + JF_SCAN + z * JF_SCAN_STRIDE + JF_SCAN_TD, 0);
        store64(frame + JF_SCAN + z * JF_SCAN_STRIDE + JF_SCAN_TA, 0);
        z = z + 1;
    }

    var rc = 0;
    var done = 0;
    var i = 0;
    var cs = 0;
    var tdta = 0;
    var td = 0;
    var ta = 0;
    var j = 0;
    var found = 0;
    var dupcs = 0;
    while (done == 0) {
        if (i >= ns) { done = 1; }
        if (done == 0) {
            cs = _cur_u8(&cur);
            tdta = _cur_u8(&cur);
            td = (tdta >> 4) & 15;
            ta = tdta & 15;
            # Bound the WRITE INDEX directly rather than through the two-hop
            # proxy (ns <= ncomp, and ncomp in {1,3}) the old code relied on.
            if (i >= CHITRA_MAX_COMPONENTS) { rc = CHITRA_ERR_JPEG_SOS; done = 1; }
            if (done == 0) {
                if (td >= CHITRA_MAX_HUFF_TABLES) { rc = CHITRA_ERR_JPEG_SOS; done = 1; }
            }
            if (done == 0) {
                if (ta >= CHITRA_MAX_HUFF_TABLES) { rc = CHITRA_ERR_JPEG_SOS; done = 1; }
            }
            if (done == 0) {
                # Resolve Cs to a FRAME COMPONENT INDEX, and record the scan
                # entry in scan order. The old code computed this index and
                # threw it away.
                found = 0 - 1;
                j = 0;
                while (j < ncomp) {
                    if (chitra_jpeg_frame_comp_id(frame, j) == cs) { found = j; }
                    j = j + 1;
                }
                if (found < 0) { rc = CHITRA_ERR_JPEG_SOS; done = 1; }
                if (done == 0) {
                    # Duplicate check on the resolved INDEX, not the raw Cs byte
                    # — strictly stronger, and it replaces the local seencs[].
                    dupcs = 0;
                    j = 0;
                    while (j < i) {
                        if (chitra_jpeg_scan_comp(frame, j) == found) { dupcs = 1; }
                        j = j + 1;
                    }
                    if (dupcs == 1) { rc = CHITRA_ERR_JPEG_SOS; done = 1; }
                }
                if (done == 0) {
                    # COVERAGE. A component may be decoded exactly once across
                    # the whole file: twice is a contradiction about the same
                    # samples, and it is also what bounds the driver's loop.
                    if ((load64(frame + JF_COVERED) & (1 << found)) != 0) {
                        rc = CHITRA_ERR_JPEG_SOS;
                        done = 1;
                    }
                }
                if (done == 0) {
                    store64(frame + JF_COVERED, load64(frame + JF_COVERED) | (1 << found));
                    store64(frame + JF_SCAN + i * JF_SCAN_STRIDE + JF_SCAN_COMP, found);
                    store64(frame + JF_SCAN + i * JF_SCAN_STRIDE + JF_SCAN_TD, td);
                    store64(frame + JF_SCAN + i * JF_SCAN_STRIDE + JF_SCAN_TA, ta);
                }
            }
            if (done == 0) { i = i + 1; }
        }
    }
    if (rc != 0) { store64(err_out, chitra_err(rc)); return 0; }

    var ss = _cur_u8(&cur);
    var se = _cur_u8(&cur);
    var ahal = _cur_u8(&cur);
    # T.81 § B.2.3: "If Ns > 1, ... sum(Hj * Vj) <= 10" over THIS SCAN's
    # components. A one-component scan has no interleaved MCU to bound, which is
    # exactly why a frame whose factors sum to 18 is legal when every scan is
    # non-interleaved. This precedes every allocation: planes are allocated by
    # _jpeg_decode_one_scan, which runs after this returns.
    if (ns > 1) {
        var blocks = 0;
        var bi = 0;
        while (bi < ns) {
            blocks = blocks + chitra_jpeg_frame_comp_h(frame, chitra_jpeg_scan_comp(frame, bi))
            * chitra_jpeg_frame_comp_v(frame, chitra_jpeg_scan_comp(frame, bi));
            bi = bi + 1;
        }
        if (blocks > CHITRA_MAX_BLOCKS_PER_MCU) {
            store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOF));
            return 0;
        }
    }
    store64(frame + JF_SCAN_NS, ns);
    if (ss != 0) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
    if (se != 63) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
    if (ahal != 0) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS)); return 0; }
    return _cur_pos(&cur);
}

# ================================================================
# _jpeg_entropy_span — how many bytes of ENTROPY-CODED DATA the scan actually
# carries, starting at `start`.
#
# This exists to be the denominator of the amplification cap below, and the
# reason it has to be computed rather than taken as `len` is a measured defect:
# through 0.6.0 the cap divided by the WHOLE FILE LENGTH, so an attacker bought
# allowance with bytes the decoder never decodes. A 16,556-byte file whose
# padding was 16,404 bytes of APPn segments — skipped wholesale by the marker
# walk — declared 4096x4096x3 and allocated **117,463,728 bytes**, none of which
# the bump allocator reclaims. That is the wrong-denominator defect the 0.5.3
# BMP-RLE cap had, in the JPEG path: padding is free, so measuring the file
# lets the attacker raise their own allowance. Padding AFTER the scan would
# have worked just as well, which is why this walks to the end of the entropy
# data rather than simply subtracting the header.
#
# *marker_out receives the marker code that ENDED the scan, or 0 if the input
# ran out first. 0.7.0 uses that to tell a stream that closed with EOI from
# one that simply stopped.
#
# The walk is the same rule the entropy bit-reader uses (T.81 § B.1.1.2 and
# § F.1.2.3): inside entropy-coded data a 0xFF is always followed by 0x00
# (byte stuffing) or by an RSTn marker; any other marker ENDS the scan. Fill
# bytes (runs of 0xFF) are collapsed, exactly as the reader collapses them.
# Reads only — nothing is decoded, and every access is bounded by `len`.
# ================================================================
fn _jpeg_entropy_span(src, len, start, marker_out): i64 {
    store64(marker_out, 0);
    var i = start;
    var j = 0;
    var b2 = 0;
    var done = 0;
    var scanning = 0;
    while (done == 0) {
        if (i >= len) { done = 1; }
        if (done == 0) {
            if (load8(src + i) != 0xFF) {
                i = i + 1;
                continue;
            }
            # Collapse a run of 0xFF fill bytes (T.81 § B.1.1.2) to find the
            # marker code they precede.
            # ONE bounds-checked read per iteration. The first draft of this
            # loop tested load8(src + j) again after advancing j, which reads at
            # j == len on a file ending in 0xFF — an out-of-bounds read inside
            # the guard being added to prevent one.
            j = i + 1;
            scanning = 1;
            while (scanning == 1) {
                scanning = 0;
                if (j < len) {
                    if (load8(src + j) == 0xFF) {
                        j = j + 1;
                        scanning = 1;
                    }
                }
            }
            if (j >= len) { done = 1; }
            if (done == 0) {
                b2 = load8(src + j);
                if (b2 == 0x00) {
                    i = j + 1;          # 0xFF00 is stuffed entropy data
                    continue;
                }
                if (b2 >= 0xD0) {
                    if (b2 <= 0xD7) {
                        i = j + 1;      # RSTn belongs to the scan
                        continue;
                    }
                }
                store64(marker_out, b2);
                done = 1;               # any other marker ends the scan
            }
        }
    }
    if (i < start) { return 0; }
    return i - start;
}

# ================================================================
# Decode a baseline scan (1 or 3 components, any chroma subsampling) into a
# ChitraImage. The MCU is max_h x max_v data units wide/tall; each component i
# contributes Hi x Vi 8x8 blocks per MCU at its own (subsampled) plane
# resolution. After decode, each component plane is box-upsampled to full
# resolution and (for 3 components) converted YCbCr -> RGB. DRI/RSTn restart
# intervals reset the DC predictors and byte-align the entropy stream.
# Returns the ChitraImage ptr, or 0 with *err_out set.
# ================================================================
fn _jpeg_decode_one_scan(frame, src, len, entropy_start, espan, planes, comppw,
  zz, out, eod_out, err_out): i64 {
    var ncomp = chitra_jpeg_frame_num_components(frame);
    var w = chitra_jpeg_frame_width(frame);
    var h = chitra_jpeg_frame_height(frame);
    var max_h = chitra_jpeg_frame_max_h(frame);
    var max_v = chitra_jpeg_frame_max_v(frame);
    var mcu_w = 8 * max_h;
    var mcu_h = 8 * max_v;
    var mcu_cols = (w + mcu_w - 1) / mcu_w;
    var mcu_rows = (h + mcu_h - 1) / mcu_h;

    # ---- ONE geometry rule, per T.81 § A.2 --------------------------------
    #
    # A scan is INTERLEAVED (§ A.2.3) when it carries more than one component,
    # and NON-INTERLEAVED (§ A.2.2) when it carries exactly one. The difference
    # is entirely in the grid the MCU loop walks and how many data units an MCU
    # holds, so it is expressed once, here, rather than as two decoders:
    #
    #   interleaved      MCU = max_h x max_v data units
    #                    grid = ceil(w / 8*max_h) x ceil(h / 8*max_v)
    #                    blocks per component per MCU = H_i x V_i
    #   non-interleaved  MCU = ONE data unit, raster order
    #                    grid = ceil(x_i/8) x ceil(y_i/8) over that component's
    #                           OWN sample dimensions (§ A.1.1):
    #                           x_i = ceil(X*H_i/H_max), y_i = ceil(Y*V_i/V_max)
    #                    blocks per MCU = 1
    #
    # This REPLACES 0.6.0's effective-geometry collapse, which forced
    # H = V = max_h = max_v = 1 for a one-component frame. That was correct only
    # because with Nf = 1 the lone component IS the maximum — and the rule above
    # gives the identical answer there (x_1 = ceil(X*H/H) = X, so the grid is
    # ceil(X/8)), while also being right for a one-component SCAN of a
    # THREE-component frame, which the collapse would have got badly wrong.
    # ADR 0006 claimed 0.8.0 could build on the collapse; it could not.
    var ns = chitra_jpeg_frame_scan_ns(frame);
    var s_cols = mcu_cols;
    var s_rows = mcu_rows;
    var sfi = 0;
    var xi = 0;
    var yi = 0;
    if (ns == 1) {
        sfi = chitra_jpeg_scan_comp(frame, 0);
        xi = (w * chitra_jpeg_frame_comp_h(frame, sfi) + max_h - 1) / max_h;
        yi = (h * chitra_jpeg_frame_comp_v(frame, sfi) + max_v - 1) / max_v;
        s_cols = (xi + 7) / 8;
        s_rows = (yi + 7) / 8;
    }

    # Decompression-bomb cap. The PNG path bounds inflate output against IDAT
    # input at CHITRA_MAX_INFLATE_RATIO; the JPEG path had no analogue, and it
    # needs one MORE than PNG does: the entropy bit-reader zero-pads past
    # end-of-data, so a hostile file needs no real scan payload at all. A
    # ~150-byte file declaring SOF0 4096x4096x3 drives ~786k IDCT blocks and
    # ~117 MB of allocation that the bump allocator never reclaims, so a
    # handful of them exhausts a long-running consumer (mabda decodes into
    # textures). Capping the RGBA output against the input length bounds the
    # planes too — they sum to under 1x the RGBA buffer for every supported
    # sampling. A genuinely flat 4096x4096 JPEG still carries ~2 bits per
    # block (~98 KB, ~685:1), so 4096:1 leaves ~6x headroom over the most
    # compressible real image while rejecting the geometry-only bomb by
    # three orders of magnitude.
    # 0.6.1 put the denominator on the ENTROPY SPAN rather than the file length,
    # after a 16,556-byte file padded with 16,404 bytes of skipped APPn segments
    # allocated 117,463,728 bytes. 0.8.0 splits the check in two, because with
    # several scans one whole-image test against one span is wrong in both
    # directions: GATE 1 below bounds each scan's planes against THAT scan's
    # span, and GATE 2 in the driver bounds the RGBA output against the summed
    # spans of the scans actually decoded.

    # per-component arrays (<= 3 components)

    var preds[32];
    var dctabs[32];
    var actabs[32];
    var quants[32];
    var comph[32];
    var compv[32];

    var ci = 0;
    var td = 0;
    var ta = 0;
    var tq = 0;
    var chh = 0;
    var cvv = 0;
    var cpw = 0;
    var cph = 0;
    var pl = 0;
    var scanfi[32];      # scan position -> frame component index
    var rc = 0;
    var done = 0;
    # Iterate THE SCAN, in scan order. T.81 § A.2.3 composes an interleaved MCU
    # from the components in the order the SCAN HEADER lists them, which is not
    # necessarily frame order — a file may name them {Cb, Y, Cr}, and libjpeg
    # writes such scans. Indexing this loop by frame component made that decode
    # to a different image with no error.
    #
    # Per-scan quantities (tables, block counts) are indexed by SCAN POSITION;
    # `planes` and `comppw` are indexed by FRAME COMPONENT, because a plane
    # outlives the scan that fills it.
    var fi = 0;
    while (done == 0) {
        if (ci >= ns) { done = 1; }
        if (done == 0) {
            fi = chitra_jpeg_scan_comp(frame, ci);
            td = chitra_jpeg_scan_td(frame, ci);
            ta = chitra_jpeg_scan_ta(frame, ci);
            tq = chitra_jpeg_frame_comp_tq(frame, fi);
            chh = chitra_jpeg_frame_comp_h(frame, fi);
            cvv = chitra_jpeg_frame_comp_v(frame, fi);
            # Blocks per MCU for THIS scan. One for a non-interleaved scan,
            # whatever H_i/V_i say — § A.2.2 is explicit that the factors do not
            # affect the ordering there.
            if (ns == 1) {
                chh = 1;
                cvv = 1;
            }
            if ((chitra_jpeg_frame_huff_present(frame) & (1 << td)) == 0) { rc = CHITRA_ERR_JPEG_SOS; done = 1; }
            if (done == 0) {
                if ((chitra_jpeg_frame_huff_present(frame) & (1 << (4 + ta))) == 0) {
                    rc = CHITRA_ERR_JPEG_SOS;
                    done = 1;
                }
            }
            if (done == 0) {
                if ((chitra_jpeg_frame_quant_present(frame) & (1 << tq)) == 0) {
                    rc = CHITRA_ERR_JPEG_SOF;
                    done = 1;
                }
            }
            if (done == 0) {
                # plane = the scan's own grid x its blocks-per-MCU x 8. For an
                # interleaved scan that is the familiar mcu_cols*H_i*8; for a
                # non-interleaved one it is ceil(x_i/8)*8 — an EXACT fit over
                # the component's own sample dimensions, with no unwritten
                # margin, which is the property 0.6.0 established and this rule
                # keeps in both layouts.
                cpw = s_cols * chh * 8;
                cph = s_rows * cvv * 8;
                if (cpw * cph > CHITRA_MAX_RAW_BYTES) { rc = CHITRA_ERR_DIMENSIONS; done = 1; }
            }
            if (done == 0) {
                # GATE 1 — amplification, per scan, against THIS scan's entropy
                # span, before this scan's allocations. Measured on a flat
                # 1024x1024 with a chroma-first scan script, per-scan spans run
                # [2050, 12289, 2049] at 2x2 and [514, 12289, 513] at 4x4 — so
                # testing the whole output against the FIRST scan's span would
                # reject files djpeg reads. Each scan's planes against that
                # scan's own bytes is the honest pairing.
                if (cpw * cph > espan * CHITRA_MAX_JPEG_RATIO) {
                    rc = CHITRA_ERR_DIMENSIONS;
                    done = 1;
                }
            }
            if (done == 0) {
                # Lazy, and at most once per component. Coverage-once means a
                # scan names only components no earlier scan decoded, so a plane
                # that already exists belongs to a component this scan cannot
                # name — re-allocating is what would silently discard the
                # previous scan's samples.
                pl = load64(planes + fi * 8);
                if (pl == 0) {
                    pl = alloc(cpw * cph);
                    if (pl == 0) { rc = CHITRA_ERR_OOM; done = 1; }
                }
            }
            if (done == 0) {
                store64(planes + fi * 8, pl);
                store64(&preds + ci * 8, 0);
                store64(&dctabs + ci * 8, chitra_jpeg_frame_huff(frame, 0, td));
                store64(&actabs + ci * 8, chitra_jpeg_frame_huff(frame, 1, ta));
                store64(&quants + ci * 8, load64(frame + JF_QUANT) + tq * 64 * 8);
                store64(&comph + ci * 8, chh);
                store64(&compv + ci * 8, cvv);
                store64(comppw + fi * 8, cpw);
                store64(&scanfi + ci * 8, fi);
                ci = ci + 1;
            }
        }
    }
    if (rc != 0) { store64(err_out, chitra_err(rc)); return 0; }
    done = 0;

    var ri = chitra_jpeg_frame_restart_interval(frame);
    var reader[56];   # BR_SIZE — 56 since 0.7.0's BR_EOD flag
    # Bound the reader to THIS SCAN's entropy span, not to the rest of the file.
    #
    # 0.7.0 gave it `len - entropy_start` and gated `seen_iend` on BR_EOD, which
    # is set when the reader runs out of bytes. But `_jpeg_br_load_byte` returns
    # early on a real marker WITHOUT setting BR_EOD — so a file truncated inside
    # its entropy data with a genuine FF D9 appended stopped at that marker,
    # left BR_EOD clear, and reported a cleanly closed stream. Measured on a
    # 689-byte fixture cut in half mid-scan: sum 232,762 against a correct
    # 223,824, `seen_iend = 1`, where djpeg says "premature end of data
    # segment". The signal 0.7.0 added was defeated by the one shape it most
    # needed to catch.
    #
    # Handing it `espan` — the span _jpeg_entropy_span already computed, which
    # ends at the first marker that is neither stuffing nor RSTn — makes running
    # out of scan data indistinguishable from what it is: end of data. It is
    # also the correct bound on its own terms. An entropy reader has no business
    # reading past the end of its own scan, and that matters far more once
    # multi-scan lands, where the bytes after a scan are the NEXT SCAN'S HEADER.
    _jpeg_br_init(&reader, src + entropy_start, espan);

    var mcu_count = s_cols * s_rows;
    var mi = 0;
    var mcu_x = 0;
    var mcu_y = 0;
    var comp = 0;
    var by = 0;
    var bx = 0;
    var ch2 = 0;
    var cv2 = 0;
    var cpw2 = 0;
    var dctab = 0;
    var actab = 0;
    var quant = 0;
    var plane = 0;
    var pr = 0;
    var berr = 0;
    var px = 0;
    var py = 0;
    var r = 0;
    var c = 0;
    var rrc = 0;
    var k = 0;
    while (done == 0) {
        if (mi >= mcu_count) { done = 1; }
        if (done == 0) {
            if (ri > 0) {
                if (mi > 0) {
                    if ((mi % ri) == 0) {
                        rrc = _jpeg_br_restart(&reader);
                        if (rrc != 0) { store64(err_out, chitra_err(CHITRA_ERR_JPEG_ENTROPY)); done = 1; }
                        if (done == 0) {
                            k = 0;
                            while (k < ns) { store64(&preds + k * 8, 0); k = k + 1; }
                        }
                    }
                }
            }
        }
        if (done == 0) {
            mcu_x = mi % s_cols;
            mcu_y = mi / s_cols;
            comp = 0;
            while (comp < ns) {
                ch2 = load64(&comph + comp * 8);
                cv2 = load64(&compv + comp * 8);
                cpw2 = load64(comppw + load64(&scanfi + comp * 8) * 8);
                dctab = load64(&dctabs + comp * 8);
                actab = load64(&actabs + comp * 8);
                quant = load64(&quants + comp * 8);
                plane = load64(planes + load64(&scanfi + comp * 8) * 8);
                by = 0;
                while (by < cv2) {
                    bx = 0;
                    while (bx < ch2) {
                        pr = load64(&preds + comp * 8);
                        pr = _jpeg_decode_block(&reader, dctab, actab, pr, zz, &berr);
                        store64(&preds + comp * 8, pr);
                        if (load64(&berr) != 0) {
                            store64(err_out, load64(&berr));
                            done = 1;
                            bx = ch2;
                            by = cv2;
                            comp = ns;
                            mi = mcu_count;
                        }
                        if (done == 0) {
                            _jpeg_idct_block(zz, quant, out);
                            px = (mcu_x * ch2 + bx) * 8;
                            py = (mcu_y * cv2 + by) * 8;
                            r = 0;
                            while (r < 8) {
                                c = 0;
                                while (c < 8) {
                                    store8(plane + (py + r) * cpw2 + (px + c), load64(out + (r * 8 + c) * 8));
                                    c = c + 1;
                                }
                                r = r + 1;
                            }
                            bx = bx + 1;
                        }
                    }
                    if (done == 0) { by = by + 1; }
                }
                if (done == 0) { comp = comp + 1; }
            }
            if (done == 0) { mi = mi + 1; }
        }
    }
    store64(eod_out, _jpeg_br_eod(&reader));
    if (load64(err_out) != 0) { return 0; }
    return 1;
}

fn _jpeg_build_image(frame, planes, comppw, closed, err_out): i64 {
    var ncomp = chitra_jpeg_frame_num_components(frame);
    var w = chitra_jpeg_frame_width(frame);
    var h = chitra_jpeg_frame_height(frame);
    var max_h = chitra_jpeg_frame_max_h(frame);
    var max_v = chitra_jpeg_frame_max_v(frame);

    # ---- box upsample + color convert -> RGBA8 ----
    if (w * h * 4 > CHITRA_MAX_RAW_BYTES) { store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS)); return 0; }
    var rgba = alloc(w * h * 4);
    if (rgba == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    # Upsample ratios come from the FRAME. comph/compv hold blocks-per-MCU for
    # the scan just decoded — a different quantity that merely coincides for a
    # single interleaved scan. H_i/H_max is what the box upsampler needs.
    var p0 = load64(planes + 0);
    var h0 = chitra_jpeg_frame_comp_h(frame, 0);
    var v0 = chitra_jpeg_frame_comp_v(frame, 0);
    var pw0 = load64(comppw + 0);
    var p1 = 0;
    var p2 = 0;
    var h1 = 0;
    var v1 = 0;
    var pw1 = 0;
    var h2 = 0;
    var v2 = 0;
    var pw2 = 0;
    var y = 0;
    var x = 0;
    var o = 0;
    var yy = 0;
    var cb = 0;
    var cr = 0;
    if (ncomp == 1) {
        while (y < h) {
            x = 0;
            while (x < w) {
                yy = load8(p0 + (y * v0 / max_v) * pw0 + (x * h0 / max_h));
                o = (y * w + x) * 4;
                store8(rgba + o + 0, yy);
                store8(rgba + o + 1, yy);
                store8(rgba + o + 2, yy);
                store8(rgba + o + 3, 255);
                x = x + 1;
            }
            y = y + 1;
        }
    }
    # ---- which colour space are these three components in? ----------------
    # A 3-component baseline JPEG is USUALLY YCbCr, and chitra assumed so
    # unconditionally through 0.6.0. It is not always: `cjpeg -rgb` emits RGB
    # components, and applying the BT.601 inverse to them hue-rotates the whole
    # image with no error raised (measured: 1149 of 1536 bytes wrong, max delta
    # 235 — a blue pixel returned dark red).
    #
    # The decision order matches libjpeg's, most authoritative first:
    #   1. An Adobe APP14 transform, if the file carries one. It is an explicit
    #      statement by the encoder, so nothing overrides it.
    #   2. Otherwise the SOF0 component ids: 'R','G','B' (0x52/0x47/0x42) names
    #      the space outright. This is the fallback libjpeg uses, and it is what
    #      catches an RGB file whose APP14 was stripped by a metadata tool.
    #   3. Otherwise YCbCr — the JFIF default, and what component ids 1,2,3 mean.
    #   0. BEFORE ALL OF THEM (B-2, 1.0.3): a JFIF APP0. JFIF § 4.1 DEFINES the
    #      sample space — three components are Y/Cb/Cr — so a file that declares
    #      itself JFIF has already answered this, and neither of the weaker
    #      rules below may overturn it.
    #      ⛔ Rule 2 used to apply to JFIF files, and six edited bytes
    #      (component ids 1,2,3 -> 'R','G','B') therefore turned an ordinary
    #      cjpeg image into a whole-image colour error with NO error code, while
    #      `source_color_type` reported 0x113 and actively told the consumer the
    #      samples were RGB. Every colour byte of a 64x64 fixture came back
    #      wrong; djpeg and ImageMagick both decode the same bytes correctly.
    #      libjpeg has never had the hole: `default_decompress_parms` tests
    #      `saw_JFIF_marker` first, then the Adobe marker, then the ids. This is
    #      that order.
    var is_rgb = 0;
    var adobe = chitra_jpeg_frame_adobe_transform(frame);
    if (ncomp == 3) {
        if (chitra_jpeg_frame_saw_jfif(frame) == 0) {
            if (adobe == 0) { is_rgb = 1; }
            if (adobe < 0) {
                if (chitra_jpeg_frame_comp_id(frame, 0) == 0x52) {
                    if (chitra_jpeg_frame_comp_id(frame, 1) == 0x47) {
                        if (chitra_jpeg_frame_comp_id(frame, 2) == 0x42) { is_rgb = 1; }
                    }
                }
            }
        }
    }

    if (ncomp == 3) {
        p1 = load64(planes + 8);
        p2 = load64(planes + 16);
        h1 = chitra_jpeg_frame_comp_h(frame, 1);
        v1 = chitra_jpeg_frame_comp_v(frame, 1);
        pw1 = load64(comppw + 8);
        h2 = chitra_jpeg_frame_comp_h(frame, 2);
        v2 = chitra_jpeg_frame_comp_v(frame, 2);
        pw2 = load64(comppw + 16);
        y = 0;
        while (y < h) {
            x = 0;
            while (x < w) {
                yy = load8(p0 + (y * v0 / max_v) * pw0 + (x * h0 / max_h));
                cb = load8(p1 + (y * v1 / max_v) * pw1 + (x * h1 / max_h));
                cr = load8(p2 + (y * v2 / max_v) * pw2 + (x * h2 / max_h));
                o = (y * w + x) * 4;
                # For RGB components the samples ARE the output — the transform
                # to apply is the identity, not BT.601.
                if (is_rgb == 1) {
                    store8(rgba + o + 0, yy);
                    store8(rgba + o + 1, cb);
                    store8(rgba + o + 2, cr);
                }
                if (is_rgb == 0) { _jpeg_ycc_to_rgb(yy, cb, cr, rgba + o); }
                store8(rgba + o + 3, 255);
                x = x + 1;
            }
            y = y + 1;
        }
    }

    var img = alloc(CHITRA_IMAGE_SIZE);
    if (img == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    store64(img + IMAGE_WIDTH_OFFSET, w);
    store64(img + IMAGE_HEIGHT_OFFSET, h);
    store64(img + IMAGE_PIXELS_OFFSET, rgba);
    store64(img + IMAGE_CHANNELS_OFFSET, 4);
    # 0.7.0 — say whether the stream actually closed, instead of claiming it
    # always did.
    #
    # Through 0.6.1 this field was hardcoded to 1 on the JPEG path, so the one
    # accessor that exists to report "the stream ended the way the format says
    # it should" was a constant. A JPEG truncated inside its entropy stream
    # decoded to fabricated zero-padded MCUs, returned success, and reported a
    # clean close — measured on a 689-byte file, chopping 8 to 60 bytes gave
    # byte sums of 215,484 / 229,896 / 143,178 against a correct 223,824, with
    # no signal of any kind.
    #
    # Two independent things have to hold, and neither alone is sufficient:
    #   - the entropy decoder never had to fabricate bits (BR_EOD), which is
    #     what catches data removed from the middle or the end of the scan; and
    #   - the scan was terminated by a real EOI marker, which is what catches an
    #     EOI-stripped file whose pixels happen to be complete.
    # This mirrors PNG, where 0 means "tolerated IEND-less clean end" rather
    # than "corrupt" — chitra still returns the image either way, as libjpeg
    # does. The caller decides what a partial decode is worth.
    # `closed` is decided by the DRIVER, which is the only place that can see
    # every scan: any scan that ran out of data, or a file whose last scan did
    # not end at a real EOI, means the stream did not close cleanly.
    store64(img + IMAGE_SEEN_IEND_OFFSET, closed);
    # JPEG sentinel: 0x100 | ncomp, with bit 4 set when the components are RGB
    # rather than YCbCr — so 0x101 gray, 0x103 YCbCr, 0x113 RGB. Without the
    # distinction an Adobe transform=0 file reports 0x103 and a consumer has no
    # way to learn that chitra applied no colour transform to it, which is
    # exactly the fact the 0.6.1 repair exists to establish.
    var sentinel = 256 + ncomp;
    if (is_rgb == 1) { sentinel = sentinel + 16; }
    store64(img + IMAGE_SRC_CTYPE_OFFSET, sentinel);
    # Baseline is 8-bit by definition; 12-bit precision rejects at the SOF0 parse.
    store64(img + IMAGE_SRC_DEPTH_OFFSET, 8);
    return img;
}

# ================================================================
# _jpeg_decode_scans — the multi-scan driver (0.8.0).
#
# Owns everything that outlives a scan: the component planes and their strides,
# the IDCT scratch, the running entropy total, and the decision about whether
# the stream closed. Each iteration parses one scan header, measures that scan's
# entropy span, decodes it, and stops the moment every frame component is
# covered.
#
# TERMINATION IS THE COVERAGE BITMASK, not a scan counter. _jpeg_parse_sos
# refuses a component that is already covered and requires Ns >= 1, so every
# successful iteration sets at least one new bit and at most Nf (<= 3) can
# succeed. That bounds the index itself rather than a proxy for it, which is why
# there is no scan limit and no resume-monotonicity tripwire — neither could
# fire before coverage does.
#
# The loop EXITS on full coverage before walking any further, so an ordinary
# single-scan JPEG never enters the resume walk at all. That is deliberate: it
# means no byte after a single scan's entropy data is newly parsed, and no file
# that decoded before this release can newly reject on trailing junk.
# ================================================================
fn _jpeg_decode_scans(frame, src, len, err_out): i64 {
    store64(err_out, 0);
    var ncomp = chitra_jpeg_frame_num_components(frame);
    var w = chitra_jpeg_frame_width(frame);
    var h = chitra_jpeg_frame_height(frame);

    # ⛔⛔ GATE 0 (B-3, 1.0.3) — REFUSE BEFORE THE PLANES, NOT AFTER THEM.
    # GATE 2 below is the honest whole-image bound, but it can only run once
    # every scan has been decoded — which means every plane has already been
    # allocated. A 4,250-byte file declaring 4096x4096 Nf=3 therefore spent
    # 50,354,832 bytes to return CHITRA_ERR_DIMENSIONS, 11,848:1 on the REFUSAL
    # path, and the bump allocator never gives it back: ~40 such files exhaust
    # the stdlib's 2 GiB ALLOC_MAX.
    #
    # ⚠ STRICTLY WEAKER THAN GATE 2, WHICH IS WHY IT IS SAFE HERE.
    # `total_espan` is a sum of spans inside the file, so it can never exceed
    # `len`. Anything this refuses, GATE 2 would refuse too — no accept/reject
    # outcome moves, and the code returned is the same. It just costs ~400
    # bytes instead of 50 MB.
    # ⇒ It does NOT replace GATE 2. `len` counts bytes no scan ever reads
    # (skipped APPn padding is the 0.6.1 lesson), so only the summed entropy
    # spans can see through a padded file.
    if (w * h * 4 > len * CHITRA_MAX_JPEG_RATIO) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    var planes[32];      # by FRAME component index; CHITRA_MAX_COMPONENTS is 4
    var comppw[32];
    var i = 0;
    while (i < CHITRA_MAX_COMPONENTS) {
        store64(&planes + i * 8, 0);
        store64(&comppw + i * 8, 0);
        i = i + 1;
    }
    # Per-decode scratch, hoisted out of the per-scan worker so a file with
    # three scans allocates it once rather than three times.
    var zz = alloc(512);
    if (zz == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    var out = alloc(512);
    if (out == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }

    var sos_off = chitra_jpeg_frame_sos_offset(frame);
    var entropy_start = 0;
    var espan = 0;
    var endmark = 0;
    var total_espan = 0;
    var last_marker = 0;
    var any_eod = 0;
    var eod = 0;
    var full = (1 << ncomp) - 1;
    var done = 0;
    while (done == 0) {
        entropy_start = _jpeg_parse_sos(frame, src, len, sos_off, err_out);
        if (load64(err_out) != 0) { return 0; }
        espan = _jpeg_entropy_span(src, len, entropy_start, &endmark);
        total_espan = total_espan + espan;
        last_marker = endmark;
        eod = 0;
        if (_jpeg_decode_one_scan(frame, src, len, entropy_start, espan,
            &planes, &comppw, zz, out, &eod, err_out) == 0) {
            return 0;
        }
        if (eod == 1) { any_eod = 1; }
        if (chitra_jpeg_frame_covered(frame) == full) { done = 1; }
        if (done == 0) {
            sos_off = _jpeg_resume_to_next_scan(frame, src, len, entropy_start + espan, err_out);
            if (load64(err_out) != 0) { return 0; }
            if (sos_off == 0) {
                # The file ended with components still undecoded. An omitted
                # component is NOT neutral: Y = Cb = Cr = 0 through the BT.601
                # constants is RGB(0, 135, 0) — solid green, which decodes
                # cleanly and looks plausible. Refuse instead.
                store64(err_out, chitra_err(CHITRA_ERR_JPEG_SOS));
                return 0;
            }
        }
    }

    # GATE 2 — the whole-image amplification bound, against the summed spans of
    # the scans ACTUALLY decoded. Nothing here is a pre-pass an attacker could
    # pad: every byte counted is a byte some scan's entropy decoder read.
    if (w * h * 4 > total_espan * CHITRA_MAX_JPEG_RATIO) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    var closed = 1;
    if (any_eod == 1) { closed = 0; }
    if (last_marker != 0xD9) { closed = 0; }
    return _jpeg_build_image(frame, &planes, &comppw, closed, err_out);
}

# ================================================================
# chitra_jpeg_decode — the top-level public decode. Parse (src, len) JPEG bytes
# -> an owned RGBA8 ChitraImage. Returns the ChitraImage ptr on success, or 0
# with *err_out set to a ChitraErr (left 0 on success). Mirrors chitra_png_decode.
# ================================================================
# @public
fn chitra_jpeg_decode(src, len, err_out): i64 {
    store64(err_out, 0);
    var frame = chitra_jpeg_scan_markers(src, len, err_out);
    if (frame == 0) { return 0; }
    return _jpeg_decode_scans(frame, src, len, err_out);
}

# ================================================================
# chitra_jpeg_decode_rgba8 — convenience wrapper. Decode (src, len) and return
# the RGBA8 pixel pointer directly, writing width/height through w_out / h_out
# (>=8-byte slots). Returns 0 on any failure. Mirrors chitra_png_decode_rgba8.
# ================================================================
# @public
fn chitra_jpeg_decode_rgba8(src, len, w_out, h_out): i64 {
    store64(w_out, 0);
    store64(h_out, 0);
    var err = 0;
    var img = chitra_jpeg_decode(src, len, &err);
    if (img == 0) { return 0; }
    store64(w_out, chitra_image_width(img));
    store64(h_out, chitra_image_height(img));
    return chitra_image_pixels(img);
}

# ================================================================
# _jpeg_declared_dims — the dimensions SOF0 declares, without decoding or
# allocating anything.
#
# This walks segments structurally, exactly as chitra_jpeg_scan_markers does —
# by length, honouring standalone markers and § B.1.1.2 fill bytes — but it
# parses nothing and stores nothing. It is not a second header parser: it
# validates no field, builds no table, and its only output is (w, h). Anything
# it does not understand returns 0, and the real parser then has the final say
# on the same bytes.
#
# The reason it exists rather than reusing chitra_jpeg_scan_markers: that
# function allocates the quantization and Huffman stores as it meets DQT and
# DHT segments, so using it to answer "how big is this image?" costs ~22 KB for
# any real JPEG — on a budget REFUSAL, which is the path this API exists to
# make cheap. Reading the geometry alone costs nothing.
# Returns 1 with *w_out / *h_out set, or 0.
# ================================================================
fn _jpeg_declared_dims(src, len, w_out, h_out): i64 {
    store64(w_out, 0);
    store64(h_out, 0);
    var cur[24];
    _cur_init(&cur, src, len);
    _cur_skip(&cur, 2);                     # SOI, already checked by the caller
    var done = 0;
    var found = 0;
    var b = 0;
    var m = 0;
    var seglen = 0;
    while (done == 0) {
        if (_cur_can_read(&cur, 2) == 0) { done = 1; }
        if (done == 0) {
            b = _cur_u8(&cur);
            if (b != 0xFF) { done = 1; }
        }
        if (done == 0) {
            # Collapse a run of fill bytes (T.81 § B.1.1.2).
            m = _cur_u8(&cur);
            while (m == 0xFF) {
                if (_cur_can_read(&cur, 1) == 0) { m = 0; }
                if (m == 0xFF) { m = _cur_u8(&cur); }
            }
            if (m == 0xC0) {
                # SOF0: length(2) precision(1) height(2) width(2)
                if (_cur_can_read(&cur, 7) == 0) { done = 1; }
                if (done == 0) {
                    seglen = _cur_u16_be(&cur);
                    _cur_skip(&cur, 1);
                    store64(h_out, _cur_u16_be(&cur));
                    store64(w_out, _cur_u16_be(&cur));
                    found = 1;
                    done = 1;
                }
            }
            if (done == 0) {
                if (m == 0xD9) { done = 1; }        # EOI before any SOF0
                if (m == 0xDA) { done = 1; }        # SOS before any SOF0
            }
            if (done == 0) {
                # Standalone markers carry no length.
                if (m == 0x01) { continue; }
                if (m >= 0xD0) {
                    if (m <= 0xD7) { continue; }
                }
                if (_cur_can_read(&cur, 2) == 0) { done = 1; }
                if (done == 0) {
                    seglen = _cur_u16_be(&cur);
                    if (seglen < 2) { done = 1; }
                }
                if (done == 0) {
                    if (_cur_can_read(&cur, seglen - 2) == 0) { done = 1; }
                }
                if (done == 0) { _cur_skip(&cur, seglen - 2); }
            }
        }
    }
    return found;
}

# ================================================================
# _chitra_declared_rgba_bytes — the size of the RGBA8 buffer the file SAYS it
# will decode to, or 0 if that cannot be read from the header.
#
# Every format states its own dimensions in its header, and the output contract
# is always `w * h * 4`. Nothing here validates and nothing here allocates —
# the decoder still does all of that, so an unreadable or hostile header simply
# returns 0 and the caller's decode reports the real error. That asymmetry is
# what keeps this from being "a probe that accepts what the decoder refuses":
# it can only be consulted, never obeyed.
# ================================================================
fn _chitra_declared_rgba_bytes(src, len): i64 {
    var cur[24];
    var w = 0;
    var h = 0;
    if (chitra_png_check_signature(src, len) == 1) {
        # IHDR is the first chunk: 8-byte signature, 4-byte length, 4-byte type,
        # then width and height as big-endian u32 (PNG § 11.2.2).
        _cur_init(&cur, src, len);
        _cur_skip(&cur, 16);
        if (_cur_can_read(&cur, 8) == 0) { return 0; }
        w = _cur_u32_be(&cur);
        h = _cur_u32_be(&cur);
    }
    if (chitra_jpeg_check_signature(src, len) == 1) {
        if (_jpeg_declared_dims(src, len, &w, &h) == 0) { return 0; }
    }
    if (chitra_bmp_check_signature(src, len) == 1) {
        var berr = 0;
        var hdr = _bmp_parse_header(src, len, &berr);
        if (hdr == 0) { return 0; }
        w = chitra_bmp_hdr_width(hdr);
        h = chitra_bmp_hdr_height(hdr);
        if (h < 0) { h = 0 - h; }        # negative height = top-down rows
    }
    if (chitra_gif_check_signature(src, len) == 1) {
        # The Logical Screen Descriptor follows the 6-byte signature, and the
        # canvas — not the first frame's rect — is what chitra returns.
        if (len < 10) { return 0; }
        w = _gif_u16_le(src + 6);
        h = _gif_u16_le(src + 8);
    }
    if (w <= 0 || h <= 0) { return 0; }
    if (w > CHITRA_MAX_DIM || h > CHITRA_MAX_DIM) { return 0; }
    return w * h * 4;
}

# ================================================================
# chitra_image_decode_budget — decode, unless the image is bigger than the
# caller is willing to spend on it.
#
# THE CONTRACT, stated in full because a memory guarantee that is not exact is
# not a guarantee:
#
#   chitra will not BEGIN a decode whose RGBA8 output would exceed `max_bytes`.
#   A refusal returns 0 with *err_out = CHITRA_ERR_BUDGET, having allocated
#   16 bytes — the ChitraErr itself — for PNG, JPEG and GIF, and 144 for BMP.
#   MEASURED, not estimated. BMP is the outlier because its dimension read goes
#   through _bmp_parse_header, the real parser, rather than through a private
#   copy of the header layout; 128 bytes is the right price for having no
#   second opinion about what a BMP header says.
#
# What the budget does NOT cover, named rather than glossed:
#   - Working buffers during a decode that IS begun. These are bounded by the
#     format's own caps (CHITRA_MAX_PIXELS, CHITRA_MAX_RAW_BYTES and the four
#     amplification ratios), not by `max_bytes`. Budgeting N bounds the OUTPUT
#     at N; peak working set is a small multiple of it.
#   - sankoch's allocations, which chitra does not route: ~41 KB of one-time
#     table setup on the process's first PNG decode, plus 32 bytes per
#     zlib_decompress call thereafter. Neither is chitra's to predict.
#   - The cumulative total across calls. The bump allocator never frees
#     (architecture/003), so this bounds ONE decode, not a process. A caller
#     decoding untrusted input in a loop still needs its own accounting.
#
# A file whose header cannot be read is NOT refused here — it is handed to the
# router, which reports the real reason. Refusing it would make this function
# a second opinion on validity, which is exactly what it must never be.
#
# `max_bytes <= 0` is a refusal, not "unlimited" — a budget of zero means zero.
# Callers who want no ceiling call chitra_image_decode.
# ================================================================
# @public
fn chitra_image_decode_budget(src, len, max_bytes, err_out): i64 {
    store64(err_out, 0);
    if (max_bytes <= 0) {
        store64(err_out, chitra_err(CHITRA_ERR_BUDGET));
        return 0;
    }
    if (_chitra_declared_rgba_bytes(src, len) > max_bytes) {
        store64(err_out, chitra_err(CHITRA_ERR_BUDGET));
        return 0;
    }
    return chitra_image_decode(src, len, err_out);
}

# ================================================================
# chitra_image_decode — format-sniffing top-level decode. Routes by signature,
# in order: the 8-byte PNG magic, then JPEG SOI (0xFFD8), then BMP 'BM', then
# GIF 'GIF87a'/'GIF89a' — the format-agnostic entry the "chitra" name was
# chosen for. Unrecognised bytes are REJECTED here; there is deliberately no
# fall-through to a default decoder. Returns a ChitraImage ptr, or 0 with
# *err_out set (CHITRA_ERR_SIGNATURE for an unrecognized format).
# ================================================================
# @public
fn chitra_image_decode(src, len, err_out): i64 {
    store64(err_out, 0);
    if (chitra_png_check_signature(src, len) == 1) {
        return chitra_png_decode(src, len, err_out);
    }
    if (chitra_jpeg_check_signature(src, len) == 1) {
        return chitra_jpeg_decode(src, len, err_out);
    }
    if (chitra_bmp_check_signature(src, len) == 1) {
        return chitra_bmp_decode(src, len, err_out);
    }
    if (chitra_gif_check_signature(src, len) == 1) {
        return chitra_gif_decode(src, len, err_out);
    }
    store64(err_out, chitra_err(CHITRA_ERR_SIGNATURE));
    return 0;
}

# --- bmp.cyr ---

# @public — chitra BMP decoder: Windows BMP bytes -> canonical RGBA8.
#
# bmp.cyr — the third format, and the simplest of the three: no entropy
# coding, no DEFLATE, no DCT. A 14-byte file header, a DIB header, an optional
# palette, and rows of samples. What makes BMP fiddly is not the compression
# (there is none on the supported path) but four framing quirks a reader cannot
# guess from "it's a bitmap":
#
#   1. Rows are stored BOTTOM-UP by default. A positive header height means the
#      first row in the file is the BOTTOM row of the image. A NEGATIVE height
#      means top-down — and the absolute value is the height.
#   2. Every row is padded to a 4-byte boundary. The stride is therefore
#      ((width * bpp + 31) / 32) * 4, not width * bytes-per-pixel.
#   3. Channels are B,G,R — not R,G,B — and the palette is B,G,R,reserved.
#   4. The pixel data does NOT necessarily follow the palette. Its offset is a
#      field in the file header, and it is authoritative; there can be a gap.
#
# Scope: BI_RGB uncompressed at 1 / 4 / 8 bpp (palette-indexed), 16, 24 and
# 32 bpp (0.4.0); BI_RLE8 / BI_RLE4 run-length (0.5.1); and BI_BITFIELDS
# channel masks with the V4/V5 headers (0.5.2). Accepted DIB header sizes are
# an ALLOW-LIST — 12 (BITMAPCOREHEADER), 40 (BITMAPINFOHEADER), 52 (V2), 56
# (V3), 64 (OS/2 2.x BITMAPCOREHEADER2, 0.7.2), 108 (V4), 124 (V5) — not a
# lower bound. Both row orders. The deferral list is EMPTY as of 0.5.2.
#
# Only the BI_JPEG / BI_PNG embedded streams are REJECTED, and permanently
# rather than as a deferral: they would have a decoder re-enter itself through
# attacker-controlled data, which is a recursion surface, not a feature.
#
# The `(src, len)` cursor and the security ceilings are the ones png_chunks.cyr
# already defines — BMP gets the same bounds discipline for free.

# ================================================================
# Header layout constants.
#
# BITMAPFILEHEADER (14 bytes):
#   +0  'B','M'      +2  file size u32   +6  reserved u16   +8  reserved u16
#   +10 pixel-data offset u32
# DIB header starts at +14; its first u32 is its own size, which is how the
# variant is identified.
# ================================================================
var BMP_FILE_HEADER_SIZE = 14;
var BMP_CORE_HEADER_SIZE = 12;    # BITMAPCOREHEADER (OS/2 1.x)
var BMP_INFO_HEADER_SIZE = 40;    # BITMAPINFOHEADER (the common case)
var BMP_V2_HEADER_SIZE   = 52;    # INFO + RGB masks
var BMP_V3_HEADER_SIZE   = 56;    # INFO + RGBA masks
var BMP_V4_HEADER_SIZE   = 108;   # BITMAPV4HEADER  (masks + color space + gamma)
var BMP_V5_HEADER_SIZE   = 124;   # BITMAPV5HEADER  (V4 + intent + ICC profile)
# OS/2 2.x BITMAPCOREHEADER2. Its first 40 bytes are laid out EXACTLY like
# BITMAPINFOHEADER — 32-bit width/height, unlike the 12-byte OS/2 1.x header —
# and the remaining 24 are OS/2-only fields (units, recording, rendering,
# halftone sizes, colour encoding, identifier) chitra has no use for. So it
# parses on the INFO path and only needs admitting to the allow-list.
#
# The OS/2 2.x spec permits any size from 16 to 64, the trailing fields being
# optional. chitra accepts ONLY the canonical 64: below 40 the compression and
# clrused fields are absent and would have to be defaulted, and there is no
# reference to check those defaults against — ImageMagick reads a 64-byte
# header and refuses a 16-byte one ("improper image header"). Inventing
# behaviour for a size nothing writes and nothing else reads is the guess this
# decoder is built to avoid.
var BMP_OS22X_HEADER_SIZE = 64;

# Compression values (BITMAPINFOHEADER +16).
var BMP_BI_RGB       = 0;
var BMP_BI_RLE8      = 1;
var BMP_BI_RLE4      = 2;
var BMP_BI_BITFIELDS = 3;
var BMP_BI_JPEG      = 4;
var BMP_BI_PNG       = 5;
var BMP_BI_ALPHABITFIELDS = 6;    # RGBA masks following a 40-byte header

# Output:input amplification ceiling for the RUN-LENGTH modes only.
#
# BI_RGB needs no such cap: its pixel span is exactly stride*height and the
# header check `data_off + stride*h > len` already forces the file to carry the
# bytes it claims. An RLE stream has no computable length — that is the point
# of it — so nothing bounded a ~1 KB file declaring 4096x4096 from allocating
# ~84 MB that the bump allocator never reclaims.
#
# 4096:1 is sized against the format's own best case rather than picked round.
# An RLE opcode is two bytes and encodes at most 255 pixels, so a SOLID
# 4096x4096 image still needs ~137 KB of stream (480:1). The cap admits
# anything down to 16 KB, leaving ~8x headroom over that floor while rejecting
# the observed 1082-byte bomb by a factor of sixteen.
var CHITRA_MAX_BMP_RLE_RATIO = 4096;

# ================================================================
# Little-endian readers. BMP is little-endian throughout, which is the
# opposite of PNG (big-endian) and JPEG (big-endian) — hence local helpers
# rather than reusing the cursor's u32_be. Each is bounds-checked by its
# caller before use.
# ================================================================
fn _bmp_u16_le(p): i64 {
    return load8(p) | (load8(p + 1) << 8);
}

fn _bmp_u32_le(p): i64 {
    return load8(p) | (load8(p + 1) << 8) | (load8(p + 2) << 16) | (load8(p + 3) << 24);
}

# A DIB header's width/height are SIGNED 32-bit. Height < 0 selects top-down
# row order, so the sign has to survive the read: reinterpret the two's
# complement rather than masking it away.
fn _bmp_i32_le(p): i64 {
    var v = _bmp_u32_le(p);
    if (v >= 2147483648) { return v - 4294967296; }
    return v;
}

# ================================================================
# Channel masks (BI_BITFIELDS).
#
# A mask selects one channel's bits out of the pixel word — e.g. 0x7C00 is the
# red channel of a 5-5-5 16-bit pixel. To turn a masked field into an 8-bit
# sample you need its SHIFT (how far right to move it) and its WIDTH (how many
# bits it spans), and then a scale from that width up to 8 bits.
#
# The masks are attacker-controlled, so all three of these are validated rather
# than assumed:
#
#   - A mask must be CONTIGUOUS. `0b10100000` names no channel any hardware or
#     file format produces; accepting it would mean inventing a meaning for a
#     field the spec does not define.
#   - Masks must not OVERLAP. Two channels claiming the same bit is a
#     contradiction, not a blend.
#   - A mask must fit inside the pixel width. A 32-bit mask on a 16-bpp image
#     reads bits that are not there.
#
# A zero mask is legal and means "this channel is absent" — that is how a
# 16-bit 5-5-5 pixel declares it has no alpha.
# ================================================================
fn _bmp_mask_shift(m): i64 {
    if (m == 0) { return 0; }
    var sh = 0;
    var v = m;
    while ((v & 1) == 0) {
        v = v / 2;
        sh = sh + 1;
    }
    return sh;
}

fn _bmp_mask_width(m): i64 {
    if (m == 0) { return 0; }
    var v = m / (1 << _bmp_mask_shift(m));
    var w = 0;
    while ((v & 1) == 1) {
        v = v / 2;
        w = w + 1;
    }
    return w;
}

# 1 if the mask is a single contiguous run of set bits (or zero).
fn _bmp_mask_contiguous(m): i64 {
    if (m == 0) { return 1; }
    var sh = _bmp_mask_shift(m);
    var w = _bmp_mask_width(m);
    var rebuilt = ((1 << w) - 1) << sh;
    if (rebuilt == m) { return 1; }
    return 0;
}

# Scale a `width`-bit field to a full 8-bit sample, by BIT REPLICATION: shift
# the field left and fill the vacated low bits with copies of its own high
# bits, until eight bits are covered.
#
# The obvious alternative — `v * 255 / max` — is wrong, and wrong in a way that
# only a reference decoder catches. A plain left-shift is worse still: it tops
# out at 248 for a 5-bit channel, making white impossible. Round-to-nearest
# division gets closer but still disagrees: a 6-bit value of 48 is 194.3/255,
# which rounding makes 194 while replication gives 195 — and 195 is what every
# reference decoder produces, because replication is what the hardware mapping
# actually is. Checked against ImageMagick across 5- and 6-bit channels at
# several values; replication matches all of them, division does not.
#
# The loop form handles any width: widths below 4 need the field repeated more
# than twice to cover eight bits.
fn _bmp_scale_to_8(v, width): i64 {
    if (width == 0) { return 0; }
    if (width == 8) { return v; }
    var r = 0;
    var bits = 0;
    while (bits < 8) {
        r = (r << width) | v;
        bits = bits + width;
    }
    return (r >> (bits - 8)) & 255;
}

# ================================================================
# chitra_bmp_check_signature — 1 if the bytes open with the BMP magic 'BM'.
# Length-validated first, so a 0- or 1-byte buffer is a clean 0, never a read.
# ================================================================
# @public
fn chitra_bmp_check_signature(src, len): i64 {
    if (len < 2) { return 0; }
    if (load8(src + 0) != 0x42) { return 0; }     # 'B'
    if (load8(src + 1) != 0x4D) { return 0; }     # 'M'
    return 1;
}

# ================================================================
# ChitraBmpHdr — the parsed header handoff (all fields i64, 8-byte slots).
# ================================================================
var BH_WIDTH       = 0;
var BH_HEIGHT      = 8;     # absolute height (always positive)
var BH_TOP_DOWN    = 16;    # 1 = first file row is the TOP image row
var BH_BPP         = 24;
var BH_PALETTE_OFF = 32;    # byte offset of the palette within src (0 = none)
var BH_PALETTE_N   = 40;    # palette entry count
var BH_PALETTE_STR = 48;    # palette entry stride: 4 (INFO) or 3 (CORE)
var BH_DATA_OFF    = 56;    # byte offset of the pixel data within src
var BH_STRIDE      = 64;    # row stride in bytes (4-byte aligned; BI_RGB only)
var BH_COMPRESSION = 72;    # BMP_BI_RGB / BMP_BI_RLE8 / BMP_BI_RLE4 / BI_BITFIELDS
var BH_MASK_R      = 80;    # BI_BITFIELDS channel masks (0 = channel absent)
var BH_MASK_G      = 88;
var BH_MASK_B      = 96;
var BH_MASK_A      = 104;
var BMP_HDR_SIZE   = 112;

fn chitra_bmp_hdr_width(h): i64  { return load64(h + BH_WIDTH); }
fn chitra_bmp_hdr_height(h): i64 { return load64(h + BH_HEIGHT); }
fn chitra_bmp_hdr_bpp(h): i64    { return load64(h + BH_BPP); }

# ================================================================
# _bmp_parse_header — validate the file header + DIB header and fill a
# ChitraBmpHdr. Returns the header ptr, or 0 with *err_out set.
#
# Order matters here: every field is validated BEFORE it is used to derive
# another, and the derived sizes are capped before anything is allocated.
# ================================================================
fn _bmp_parse_header(src, len, err_out): i64 {
    if (chitra_bmp_check_signature(src, len) == 0) {
        store64(err_out, chitra_err(CHITRA_ERR_SIGNATURE));
        return 0;
    }
    # File header + the DIB header's own size field must be present.
    if (len < BMP_FILE_HEADER_SIZE + 4) {
        store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
        return 0;
    }

    var data_off = _bmp_u32_le(src + 10);
    var dib_size = _bmp_u32_le(src + BMP_FILE_HEADER_SIZE);

    # Header variants. All of V2/V3/V4/V5 are BITMAPINFOHEADER with fields
    # APPENDED — the first 40 bytes mean the same thing in every one — so the
    # extended sizes are accepted by reading the common prefix and then only
    # those extra fields chitra actually uses (the channel masks at +40..+55).
    # The color-space, gamma, rendering-intent and ICC-profile fields beyond
    # them are skipped, not guessed at: chitra emits raw sRGB-ordered samples
    # and does not do color management, so honouring a color space would mean
    # claiming a transform it does not perform.
    var is_core = 0;
    if (dib_size == BMP_CORE_HEADER_SIZE) { is_core = 1; }
    # In-header channel masks exist in the V2..V5 headers only. This cannot be
    # a `>= 52` test: the 64-byte OS/2 header is larger than V2 and has no masks
    # at all — its +40 is `units`/`recording`/`rendering`, so reading masks
    # there would decode by a layout built from unrelated OS/2 fields.
    var has_mask_fields = 0;
    if (dib_size == BMP_V2_HEADER_SIZE) { has_mask_fields = 1; }
    if (dib_size == BMP_V3_HEADER_SIZE) { has_mask_fields = 1; }
    if (dib_size == BMP_V4_HEADER_SIZE) { has_mask_fields = 1; }
    if (dib_size == BMP_V5_HEADER_SIZE) { has_mask_fields = 1; }
    if (is_core == 0) {
        var known = 0;
        if (dib_size == BMP_INFO_HEADER_SIZE) { known = 1; }
        if (dib_size == BMP_V2_HEADER_SIZE) { known = 1; }
        if (dib_size == BMP_V3_HEADER_SIZE) { known = 1; }
        if (dib_size == BMP_V4_HEADER_SIZE) { known = 1; }
        if (dib_size == BMP_V5_HEADER_SIZE) { known = 1; }
        if (dib_size == BMP_OS22X_HEADER_SIZE) { known = 1; }
        if (known == 0) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_HEADER));
            return 0;
        }
    }
    if (len < BMP_FILE_HEADER_SIZE + dib_size) {
        store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
        return 0;
    }

    var dib = src + BMP_FILE_HEADER_SIZE;
    var w = 0;
    var h_signed = 0;
    var planes = 0;
    var bpp = 0;
    var compression = BMP_BI_RGB;
    var clr_used = 0;
    var pal_stride = 4;

    if (is_core == 1) {
        # BITMAPCOREHEADER: 16-bit dimensions, 3-byte palette entries.
        w = _bmp_u16_le(dib + 4);
        h_signed = _bmp_u16_le(dib + 6);
        planes = _bmp_u16_le(dib + 8);
        bpp = _bmp_u16_le(dib + 10);
        pal_stride = 3;
    } else {
        w = _bmp_i32_le(dib + 4);
        h_signed = _bmp_i32_le(dib + 8);
        planes = _bmp_u16_le(dib + 12);
        bpp = _bmp_u16_le(dib + 14);
        compression = _bmp_u32_le(dib + 16);
        clr_used = _bmp_u32_le(dib + 32);
        pal_stride = 4;
    }

    # planes is defined as 1; anything else is a malformed header, not a
    # feature (there has never been a multi-plane BMP in the wild).
    if (planes != 1) {
        store64(err_out, chitra_err(CHITRA_ERR_BMP_HEADER));
        return 0;
    }

    # Compression. BI_RGB, the two run-length modes and the two bitfield modes
    # decode; everything else rejects with its own code, so the caller can tell
    # "chitra won't" from "this file is broken".
    var is_rle = 0;
    if (compression == BMP_BI_RLE8) { is_rle = 1; }
    if (compression == BMP_BI_RLE4) { is_rle = 1; }
    var is_bitfields = 0;
    if (compression == BMP_BI_BITFIELDS) { is_bitfields = 1; }
    if (compression == BMP_BI_ALPHABITFIELDS) { is_bitfields = 1; }
    if (is_rle == 0) {
        if (is_bitfields == 0) {
            if (compression != BMP_BI_RGB) {
                store64(err_out, chitra_err(CHITRA_ERR_BMP_COMPRESSION));
                return 0;
            }
        }
    }
    # The RLE modes are bit-depth specific: RLE8 encodes 8-bpp indices, RLE4
    # encodes 4-bpp nibbles. A mismatch is a malformed header, not a variant —
    # the run/absolute payloads mean different things at different depths, so
    # decoding one as the other would silently produce a different image.
    if (compression == BMP_BI_RLE8) {
        if (bpp != 8) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_HEADER));
            return 0;
        }
    }
    if (compression == BMP_BI_RLE4) {
        if (bpp != 4) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_HEADER));
            return 0;
        }
    }
    # A BITMAPCOREHEADER has no compression field at all, so RLE cannot be
    # declared alongside one — `compression` stays BI_RGB there by construction.

    # Row order. A negative height means top-down; the magnitude is the height.
    # Guard the negation against the i32 floor before taking it.
    var top_down = 0;
    var h = h_signed;
    if (h_signed < 0) {
        # A top-down DIB cannot be compressed (MS: "Top-down DIBs cannot be
        # compressed"). The RLE stream's end-of-line escape counts rows from the
        # bottom, so the two conventions have no consistent meaning together.
        if (is_rle == 1) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_HEADER));
            return 0;
        }
        if (h_signed == (0 - 2147483648)) {
            store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
            return 0;
        }
        top_down = 1;
        h = 0 - h_signed;
    }

    if (w <= 0 || h <= 0) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    if (w > CHITRA_MAX_DIM || h > CHITRA_MAX_DIM) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    if (w * h > CHITRA_MAX_PIXELS) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    # Bit depth. 16 bpp joins in 0.5.2 now that the mask machinery exists: with
    # BI_BITFIELDS the layout is declared, and with BI_RGB the 5-5-5 default is
    # DOCUMENTED by Microsoft rather than merely conventional, so applying it is
    # reading the spec, not guessing.
    var indexed = 0;
    if (bpp == 1 || bpp == 4 || bpp == 8) { indexed = 1; }
    if (indexed == 0) {
        if (bpp != 16 && bpp != 24 && bpp != 32) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_DEPTH));
            return 0;
        }
    }
    # Bitfields only mean anything for the packed-pixel depths.
    if (is_bitfields == 1) {
        if (bpp != 16 && bpp != 32) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_HEADER));
            return 0;
        }
    }

    # Row stride: each row padded up to a 4-byte boundary.
    var stride = ((w * bpp + 31) / 32) * 4;
    if (stride <= 0) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    if (stride * h > CHITRA_MAX_RAW_BYTES) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    # Palette. Present for indexed depths; its count is clr_used when set, else
    # the full 2^bpp. It sits immediately after the DIB header.
    var pal_off = 0;
    var pal_n = 0;
    if (indexed == 1) {
        pal_n = clr_used;
        if (pal_n == 0) { pal_n = 1 << bpp; }
        if (pal_n > (1 << bpp)) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_PALETTE));
            return 0;
        }
        pal_off = BMP_FILE_HEADER_SIZE + dib_size;
        if (pal_off + pal_n * pal_stride > len) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_PALETTE));
            return 0;
        }
    }

    # ---- channel masks -------------------------------------------------
    # Where they live depends on the header, and this is the one place the
    # variants genuinely differ rather than merely extending:
    #   * V2 and later carry them INSIDE the header at +40 (R), +44 (G),
    #     +48 (B), and +52 (A) for V3 and later.
    #   * A 40-byte INFO header with BI_BITFIELDS carries them AFTER the
    #     header, in the space a palette would otherwise occupy — three DWORDs,
    #     or four for BI_ALPHABITFIELDS.
    var mask_r = 0;
    var mask_g = 0;
    var mask_b = 0;
    var mask_a = 0;
    #
    # CRITICAL: the mask fields are read ONLY under BI_BITFIELDS. Microsoft is
    # explicit that bV4RedMask and friends are "valid only if bV4V4Compression
    # is set to BI_BITFIELDS", and real writers emit a V4/V5 header with those
    # fields populated even for BI_RGB. Honouring them there is not a harmless
    # extra: a stale alpha mask over pixels whose fourth byte is padding
    # renders the ENTIRE IMAGE transparent. Under BI_RGB the documented
    # defaults below are the only correct source of layout.
    # BI_ALPHABITFIELDS names FOUR masks. A 52-byte BITMAPV2INFOHEADER ends at
    # the blue mask (+40 R, +44 G, +48 B = 52), so it has room for three — the
    # file declares a channel it provides no location for, and that is a
    # contradiction rather than an omission.
    #
    # chitra REJECTS it instead of reading the fourth mask from just past the
    # header. That would be inventing a layout the format does not document:
    # ImageMagick refuses BI_ALPHABITFIELDS outright ("unrecognized
    # compression"), so there is no reference decoder to agree with, and
    # "guess where the field probably lives" is the same move as injecting
    # BI_RGB defaults into a bitfields file — the 0.5.3 defect this whole mask
    # path was rewritten to stop making.
    #
    # Through 0.7.1 such a file DECODED, silently opaque: mask_a stayed 0
    # because the in-header alpha read is gated on V3-or-later, so every
    # per-pixel alpha the file declared was discarded with no error.
    if (compression == BMP_BI_ALPHABITFIELDS) {
        if (has_mask_fields == 1) {
            if (dib_size < BMP_V3_HEADER_SIZE) {
                store64(err_out, chitra_err(CHITRA_ERR_BMP_MASK));
                return 0;
            }
        }
    }
    if (is_bitfields == 1) {
        if (has_mask_fields == 1) {
            mask_r = _bmp_u32_le(dib + 40);
            mask_g = _bmp_u32_le(dib + 44);
            mask_b = _bmp_u32_le(dib + 48);
            if (dib_size >= BMP_V3_HEADER_SIZE) { mask_a = _bmp_u32_le(dib + 52); }
        } else {
            if (is_bitfields == 1) {
                var nmask = 3;
                if (compression == BMP_BI_ALPHABITFIELDS) { nmask = 4; }
                if (BMP_FILE_HEADER_SIZE + dib_size + nmask * 4 > len) {
                    store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
                    return 0;
                }
                mask_r = _bmp_u32_le(dib + dib_size + 0);
                mask_g = _bmp_u32_le(dib + dib_size + 4);
                mask_b = _bmp_u32_le(dib + dib_size + 8);
                if (nmask == 4) { mask_a = _bmp_u32_le(dib + dib_size + 12); }
            }
        }
    }

    # Defaults for the packed depths when no usable mask was declared. Both are
    # documented layouts, not inventions: 16 bpp BI_RGB is X1R5G5B5, and 32 bpp
    # BI_RGB is X8R8G8B8 with the top byte undefined (see the alpha note in
    # chitra_bmp_decode).
    # Gated on is_bitfields: these defaults exist for BI_RGB, which declares no
    # masks at all. Applying them to a BI_BITFIELDS file that declared all-zero
    # colour masks would invent a layout the file never stated — and, worse,
    # would make the "at least one colour channel" guard below UNREACHABLE,
    # since it tests exactly the condition these defaults have just erased. A
    # guard that cannot fire is not a guard; it is a claim in the CHANGELOG
    # with nothing behind it.
    if (is_bitfields == 0) {
        if (mask_r == 0) {
            if (mask_g == 0) {
                if (mask_b == 0) {
                    if (bpp == 16) {
                        mask_r = 31744;      # 0x7C00
                        mask_g = 992;        # 0x03E0
                        mask_b = 31;         # 0x001F
                    }
                    if (bpp == 32) {
                        mask_r = 16711680;   # 0x00FF0000
                        mask_g = 65280;      # 0x0000FF00
                        mask_b = 255;        # 0x000000FF
                    }
                }
            }
        }
    }

    # Validate whatever we ended up with, for the depths that use masks.
    if (bpp == 16 || bpp == 32) {
        if (_bmp_mask_contiguous(mask_r) == 0) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_MASK)); return 0;
        }
        if (_bmp_mask_contiguous(mask_g) == 0) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_MASK)); return 0;
        }
        if (_bmp_mask_contiguous(mask_b) == 0) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_MASK)); return 0;
        }
        if (_bmp_mask_contiguous(mask_a) == 0) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_MASK)); return 0;
        }
        # Overlap is a contradiction, not a blend.
        if ((mask_r & mask_g) != 0) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_MASK)); return 0;
        }
        if ((mask_r & mask_b) != 0) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_MASK)); return 0;
        }
        if ((mask_g & mask_b) != 0) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_MASK)); return 0;
        }
        if ((mask_a & (mask_r | mask_g | mask_b)) != 0) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_MASK)); return 0;
        }
        # A mask must fit inside the pixel word it indexes.
        var pixel_mask = 4294967295;
        if (bpp == 16) { pixel_mask = 65535; }
        if (((mask_r | mask_g | mask_b | mask_a) & (0 - 1 - pixel_mask)) != 0) {
            store64(err_out, chitra_err(CHITRA_ERR_BMP_MASK)); return 0;
        }
        # At least one color channel must be present, or the pixel names nothing.
        if (mask_r == 0) {
            if (mask_g == 0) {
                if (mask_b == 0) {
                    store64(err_out, chitra_err(CHITRA_ERR_BMP_MASK)); return 0;
                }
            }
        }
    }

    # Pixel-data offset. The file-header field is authoritative; a 0 means
    # "immediately after the headers and palette". Either way the whole span
    # must lie inside the buffer — this is the check that turns a lying header
    # into a clean rejection instead of an overread.
    if (data_off == 0) {
        data_off = BMP_FILE_HEADER_SIZE + dib_size + pal_n * pal_stride;
        # A 40-byte header with BI_BITFIELDS keeps its masks in the space a
        # palette would occupy, so they push the implicit data start along too.
        if (has_mask_fields == 0) {
            if (is_bitfields == 1) {
                if (compression == BMP_BI_ALPHABITFIELDS) {
                    data_off = data_off + 16;
                } else {
                    data_off = data_off + 12;
                }
            }
        }
    }
    if (data_off < BMP_FILE_HEADER_SIZE + dib_size) {
        store64(err_out, chitra_err(CHITRA_ERR_BMP_HEADER));
        return 0;
    }
    # For BI_RGB the pixel span is exactly stride*height and must fit. An RLE
    # stream has no computable length — that is the point of it — so only its
    # START is validated here; the decode loop bounds every read it makes, and
    # terminates because every iteration consumes at least two bytes.
    if (is_rle == 0) {
        if (data_off + stride * h > len) {
            store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
            return 0;
        }
    } else {
        if (data_off >= len) {
            store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
            return 0;
        }
    }

    var hdr = alloc(BMP_HDR_SIZE);
    if (hdr == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    store64(hdr + BH_WIDTH, w);
    store64(hdr + BH_HEIGHT, h);
    store64(hdr + BH_TOP_DOWN, top_down);
    store64(hdr + BH_BPP, bpp);
    store64(hdr + BH_PALETTE_OFF, pal_off);
    store64(hdr + BH_PALETTE_N, pal_n);
    store64(hdr + BH_PALETTE_STR, pal_stride);
    store64(hdr + BH_DATA_OFF, data_off);
    store64(hdr + BH_STRIDE, stride);
    store64(hdr + BH_COMPRESSION, compression);
    store64(hdr + BH_MASK_R, mask_r);
    store64(hdr + BH_MASK_G, mask_g);
    store64(hdr + BH_MASK_B, mask_b);
    store64(hdr + BH_MASK_A, mask_a);
    return hdr;
}

# ================================================================
# Extract the `bpp`-wide sample at column x from a row, MSB-first within each
# byte (BMP packs indexed pixels high-order-first, same convention as PNG's
# sub-byte depths).
# ================================================================
fn _bmp_index_at(row, x, bpp): i64 {
    if (bpp == 8) { return load8(row + x); }
    if (bpp == 4) {
        var b4 = load8(row + (x / 2));
        if ((x & 1) == 0) { return (b4 >> 4) & 15; }
        return b4 & 15;
    }
    # bpp == 1
    var b1 = load8(row + (x / 8));
    return (b1 >> (7 - (x & 7))) & 1;
}

# ================================================================
# Run-length decode (BI_RLE8 / BI_RLE4) into `idx`, w*h palette indices in
# IMAGE order. Returns 0, or -1 with *err_out set.
#
# THE SHAPE OF THE FORMAT, and why the guards outweigh the codec:
#
# An RLE stream is a flat sequence of 2-byte opcodes. A non-zero first byte is
# an encoded run (count, value). A zero first byte is an escape, and the second
# byte says which: 0 = end of line, 1 = end of bitmap, 2 = DELTA (two more
# bytes: dx, dy), and >= 3 = absolute mode (that many literal pixels follow,
# padded to a word boundary).
#
# Three properties do the safety work:
#
#   1. **Termination is structural.** Every iteration consumes at least two
#      bytes of input and `p` only advances, so the loop cannot spin — there is
#      no opcode that leaves the cursor where it was.
#   2. **Every write is bounds-checked individually**, not per-run. A run whose
#      count would carry it off the end of a row is REJECTED, not clipped:
#      clipping would silently decode a different image than the file encodes.
#   3. **Delta is the sharp one.** It moves the write cursor by attacker-chosen
#      (dx, dy) with no relation to what has been written, so it is checked
#      against BOTH dimensions at the jump — not merely left to the per-write
#      check, because a delta far past the end followed by no writes should
#      still be recognised as malformed rather than silently accepted.
#
# Rows run BOTTOM-UP (a top-down RLE DIB is rejected in the header, since the
# end-of-line escape counts from the bottom), so RLE row `y` is image row
# `h-1-y`. Pixels no opcode ever reaches keep index 0 — the stream is allowed
# to leave gaps, and inventing a value for them would assert something the file
# does not say.
# ================================================================
fn _bmp_rle_put(idx, w, h, x, y, v): i64 {
    store8(idx + (h - 1 - y) * w + x, v);
    return 0;
}

fn _bmp_decode_rle(src, len, data_off, w, h, is_rle4, idx, err_out, consumed_out): i64 {
    store64(err_out, 0);
    # ⛔⛔ A ROW IS `w` PIXELS OF IMAGE INSIDE A DWORD-ALIGNED ROW (B-6, 1.0.3).
    # Real encoders — ImageMagick among them — emit runs covering the padded
    # row, not the image row: a 9-pixel-wide RLE8 row comes out as nine 1-pixel
    # runs followed by a 3-pixel run of index 0, then end-of-line, because the
    # uncompressed row would be 12 bytes. Rejecting at `x >= w` refused EVERY
    # RLE BMP whose width is not a multiple of 4 — measured, 30 of 30 files
    # written by `magick -compress RLE`, all of which ffmpeg and ImageMagick
    # itself read without complaint.
    # ⚠ THE PADDING IS NOT IMAGE DATA AND IS NOT CLIPPED IMAGE DATA. Samples in
    # [w, row_cap) are DISCARDED, not stored and not clamped into the row — so
    # this does not decode a different image than the file encodes, which is the
    # thing the per-write bound exists to prevent. Past `row_cap` the stream is
    # describing pixels the padded row does not have, and that is still refused.
    var row_cap = ((w + 3) / 4) * 4;               # RLE8: 1 byte per pixel
    if (is_rle4 == 1) { row_cap = ((w + 7) / 8) * 8; }   # RLE4: 2 pixels per byte
    var p = data_off;
    var x = 0;
    var y = 0;
    var done = 0;
    var rc = 0;

    var b0 = 0;
    var b1 = 0;
    var i = 0;
    var need = 0;
    var dx = 0;
    var dy = 0;
    var v = 0;

    while (done == 0) {
        # Every opcode is at least two bytes; running out mid-opcode is a
        # truncated stream, not a clean end (that is what escape 1 is for).
        if (p + 1 >= len) { rc = CHITRA_ERR_TRUNCATED; done = 1; }
        if (done == 0) {
            b0 = load8(src + p);
            b1 = load8(src + p + 1);
            p = p + 2;

            if (b0 == 0) {
                # ---- escape ------------------------------------------------
                if (b1 == 0) {
                    x = 0;
                    y = y + 1;
                    # Same threshold and same reasoning as the delta escape
                    # below: landing outside the bitmap is malformed even if the
                    # stream then writes nothing. `y == h` is fine — a single
                    # trailing end-of-line after the last row is ordinary
                    # encoder output — but past that the stream is describing
                    # rows the bitmap does not have.
                    #
                    # Through 0.7.1 only the DELTA path checked, so the two
                    # overshoot routes in this one function disagreed. No write
                    # was ever at risk (every store is bounds-checked
                    # individually), and ImageMagick accepts such a file: this
                    # is a consistency guard, not a repair for a known defect.
                    if (y > h) {
                        rc = CHITRA_ERR_BMP_RLE;
                        done = 1;
                    }
                }
                if (b1 == 1) {
                    done = 1;                       # end of bitmap
                }
                if (b1 == 2) {
                    if (p + 1 >= len) { rc = CHITRA_ERR_TRUNCATED; done = 1; }
                    if (done == 0) {
                        dx = load8(src + p);
                        dy = load8(src + p + 1);
                        p = p + 2;
                        x = x + dx;
                        y = y + dy;
                        # Checked at the jump, not merely at the next write:
                        # landing outside the bitmap is malformed even if the
                        # stream then writes nothing. dx/dy are unsigned, so
                        # the cursor only ever moves forward — no wrap to guard.
                        if (x > w || y > h) {
                            rc = CHITRA_ERR_BMP_RLE;
                            done = 1;
                        }
                    }
                }
                if (b1 >= 3) {
                    # ---- absolute mode: b1 literal pixels ------------------
                    need = b1;
                    if (is_rle4 == 1) { need = (b1 + 1) / 2; }
                    if (p + need > len) { rc = CHITRA_ERR_TRUNCATED; done = 1; }
                    if (done == 0) {
                        i = 0;
                        while (i < b1) {
                            if (x >= row_cap || y >= h) {
                                rc = CHITRA_ERR_BMP_RLE;
                                i = b1;
                                done = 1;
                            }
                            if (done == 0) {
                                if (is_rle4 == 1) {
                                    v = load8(src + p + (i / 2));
                                    if ((i & 1) == 0) { v = (v >> 4) & 15; }
                                    if ((i & 1) == 1) { v = v & 15; }
                                } else {
                                    v = load8(src + p + i);
                                }
                                # Inside the image, store. In the row's DWORD
                                # padding, consume and discard.
                                if (x < w) { _bmp_rle_put(idx, w, h, x, y, v); }
                                x = x + 1;
                                i = i + 1;
                            }
                        }
                    }
                    if (done == 0) {
                        p = p + need;
                        # Each absolute run is padded to a word boundary.
                        if ((need & 1) != 0) { p = p + 1; }
                    }
                }
            } else {
                # ---- encoded run: b0 pixels of b1 --------------------------
                # RLE4 alternates the two nibbles of b1, high first.
                i = 0;
                while (i < b0) {
                    if (x >= row_cap || y >= h) {
                        rc = CHITRA_ERR_BMP_RLE;
                        i = b0;
                        done = 1;
                    }
                    if (done == 0) {
                        v = b1;
                        if (is_rle4 == 1) {
                            if ((i & 1) == 0) { v = (b1 >> 4) & 15; }
                            if ((i & 1) == 1) { v = b1 & 15; }
                        }
                        # Inside the image, store. In the row's DWORD padding,
                        # consume and discard.
                        if (x < w) { _bmp_rle_put(idx, w, h, x, y, v); }
                        x = x + 1;
                        i = i + 1;
                    }
                }
            }
        }
    }

    if (rc != 0) {
        store64(err_out, chitra_err(rc));
        return 0 - 1;
    }
    # Report the bytes actually consumed. The amplification cap needs this
    # rather than the available span: trailing junk after the stream sits
    # inside `len - data_off` and would otherwise inflate the allowance, which
    # is exactly how a padded bomb defeated the first version of the cap.
    if (consumed_out != 0) { store64(consumed_out, p - data_off); }
    return 0;
}

# ================================================================
# chitra_bmp_decode — parse (src, len) BMP bytes -> an owned RGBA8
# ChitraImage. Returns the ChitraImage ptr, or 0 with *err_out set.
# Mirrors chitra_png_decode / chitra_jpeg_decode exactly.
# ================================================================
# @public
fn chitra_bmp_decode(src, len, err_out): i64 {
    store64(err_out, 0);
    var hdr = _bmp_parse_header(src, len, err_out);
    if (hdr == 0) { return 0; }

    var w = load64(hdr + BH_WIDTH);
    var h = load64(hdr + BH_HEIGHT);
    var top_down = load64(hdr + BH_TOP_DOWN);
    var bpp = load64(hdr + BH_BPP);
    var pal_off = load64(hdr + BH_PALETTE_OFF);
    var pal_n = load64(hdr + BH_PALETTE_N);
    var pal_str = load64(hdr + BH_PALETTE_STR);
    var mask_r = load64(hdr + BH_MASK_R);
    var mask_g = load64(hdr + BH_MASK_G);
    var mask_b = load64(hdr + BH_MASK_B);
    var mask_a = load64(hdr + BH_MASK_A);
    var data_off = load64(hdr + BH_DATA_OFF);
    var stride = load64(hdr + BH_STRIDE);
    var compression = load64(hdr + BH_COMPRESSION);

    var out_size = w * h * 4;
    if (out_size > CHITRA_MAX_RAW_BYTES) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    var pal = src + pal_off;
    var data = src + data_off;

    # ---- run-length modes decode to an index plane first ------------------
    # RLE output is indices, so it rejoins the shared palette path below by
    # standing in for the packed rows the BI_RGB path reads directly. The plane
    # is zeroed because an RLE stream may legally leave gaps (a delta jump
    # skips pixels), and index 0 is the honest filler — inventing anything else
    # would assert a value the file never encodes.
    var rle_idx = 0;
    var is_rle = 0;
    if (compression == BMP_BI_RLE8) { is_rle = 1; }
    if (compression == BMP_BI_RLE4) { is_rle = 1; }
    if (is_rle == 1) {
        # ⛔⛔ PRE-GATE (B-4, 1.0.3) — REFUSE BEFORE ALLOCATING, NOT AFTER.
        # The exact cap below can only run after the decode, because the only
        # honest denominator is the bytes actually CONSUMED. But that left a
        # 60-byte file — 4096x4096, BI_RLE8, payload `00 01` (end-of-bitmap) —
        # allocating and zeroing a 16,777,216-byte index plane before the cap
        # it exists to trip could see anything. On a bump allocator that never
        # frees that is 16,777,344 bytes per refusal, 279,622:1 on the REFUSAL
        # path, and cumulative: 200 decodes of the same 60 bytes reach 3.36 GB.
        #
        # ⚠ THE PRE-GATE IS STRICTLY WEAKER, WHICH IS WHAT MAKES IT SAFE.
        # `consumed` can never exceed the bytes available after `data_off` (the
        # cursor only advances and never leaves the buffer), so this refuses
        # only files the exact check already refuses — no accept/reject outcome
        # moves, and the same error code is returned, only ~144 bytes in.
        # ⇒ It does NOT replace the exact check. Padding a file still raises
        # this bound, which is precisely the attack the 0.5.3 cut was written
        # for, and only the `consumed` denominator below sees through it.
        if (out_size > (len - data_off) * CHITRA_MAX_BMP_RLE_RATIO) {
            store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
            return 0;
        }
        rle_idx = alloc(w * h);
        if (rle_idx == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
        var zz = 0;
        while (zz < w * h) { store8(rle_idx + zz, 0); zz = zz + 1; }
        var is4 = 0;
        if (compression == BMP_BI_RLE4) { is4 = 1; }
        var consumed = 0;
        if (_bmp_decode_rle(src, len, data_off, w, h, is4, rle_idx, err_out, &consumed) != 0) {
            return 0;
        }
        # Amplification cap — the RLE analogue of PNG's inflate ratio and
        # JPEG's output:input ceiling. See CHITRA_MAX_BMP_RLE_RATIO. It is
        # applied HERE, after the decode, because the only honest denominator
        # is the bytes the stream actually CONSUMED: an RLE stream's length is
        # not computable in advance, and measuring against the available span
        # lets an attacker pad the file to raise their own allowance.
        # The index plane allocated above is bounded by CHITRA_MAX_PIXELS; this
        # protects the 4x-larger RGBA buffer, which is not yet allocated.
        if (out_size > consumed * CHITRA_MAX_BMP_RLE_RATIO) {
            store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
            return 0;
        }
    }

    var rgba = alloc(out_size);
    if (rgba == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }

    # 32-bpp alpha. When the header DECLARES an alpha mask (V3+ or
    # BI_ALPHABITFIELDS), chitra reads it — 0.5.2 retires the heuristic below
    # for exactly those files, which is the point of implementing masks.
    #
    # For 32-bpp BI_RGB the fourth byte remains formally UNDEFINED, and no mask
    # says otherwise, so the heuristic still governs there: writers disagree,
    # some storing real alpha and others leaving padding zeros. Trusting it
    # blindly renders the padding-zero files fully transparent; ignoring it
    # discards real alpha. So: look first. If EVERY fourth byte is zero the
    # field is padding and the image is opaque; otherwise it is alpha.
    # ImageMagick resolves it the same way.
    var sh_r = _bmp_mask_shift(mask_r);
    var sh_g = _bmp_mask_shift(mask_g);
    var sh_b = _bmp_mask_shift(mask_b);
    var sh_a = _bmp_mask_shift(mask_a);
    var wd_r = _bmp_mask_width(mask_r);
    var wd_g = _bmp_mask_width(mask_g);
    var wd_b = _bmp_mask_width(mask_b);
    var wd_a = _bmp_mask_width(mask_a);

    # Masks govern BOTH packed depths, always. This used to key off `mask_a`
    # alone, which meant a 32-bpp BI_BITFIELDS file declaring R/G/B masks but
    # NO alpha mask fell through to a fixed B,G,R byte read and silently
    # ignored its own masks — a file whose red mask is the low byte decoded
    # with red and blue swapped. The masks are the file's statement about its
    # layout; whether it also declares alpha is a separate question, answered
    # just below. For BI_RGB the header filled in the documented default masks,
    # and those reproduce the byte-order read exactly (0x00FF0000 >> 16 is the
    # same byte as `srow + x*4 + 2`), so this is a unification rather than a
    # behaviour change for anything except the bug above.
    var use_alpha = 0;
    if (mask_a != 0) {
        use_alpha = 2;                          # declared: read the alpha mask
    }
    if (use_alpha == 0) {
        # No alpha mask. At 32 bpp BI_RGB the fourth byte is formally
        # UNDEFINED, so the padding heuristic governs there and only there.
        if (bpp == 32) {
            var ay = 0;
            var probe = 0;
            while (ay < h) {
                var arow = data + ay * stride;
                var ax = 0;
                while (ax < w) {
                    if (load8(arow + ax * 4 + 3) != 0) { probe = 1; ax = w; }
                    ax = ax + 1;
                }
                if (probe == 1) { ay = h; }
                ay = ay + 1;
            }
            use_alpha = probe;
        }
    }
    # A bitfields file that declared no alpha mask is opaque BY DECLARATION,
    # not by inspection — the padding heuristic must not speak for it.
    if (compression == BMP_BI_BITFIELDS) {
        if (mask_a == 0) { use_alpha = 0; }
    }
    if (compression == BMP_BI_ALPHABITFIELDS) {
        if (mask_a == 0) { use_alpha = 0; }
    }

    var y = 0;
    var x = 0;
    var srow = 0;
    var orow = 0;
    var oy = 0;
    var idx = 0;
    var pe = 0;
    var o = 0;
    var pix = 0;
    while (y < h) {
        # `y` walks the FILE's rows; `oy` is the image row it lands on.
        # Bottom-up (the default) means file row 0 is image row h-1. The RLE
        # decoder already resolved row order into its index plane, so for those
        # modes `y` IS the image row.
        oy = y;
        if (top_down == 0) { oy = h - 1 - y; }
        if (is_rle == 1) { oy = y; }
        # `stride` describes the packed rows of a BI_RGB image and means nothing
        # for a run-length stream, whose rows are not fixed-width. Computing
        # `data + y*stride` on the RLE path produced a pointer far past the
        # input buffer — never dereferenced, because the RLE branch reads
        # `rle_idx` instead, but a wild pointer that survives only by never
        # being used is a latent hazard, not a safe one.
        srow = data;
        if (is_rle == 0) { srow = data + y * stride; }
        orow = rgba + oy * w * 4;
        x = 0;
        while (x < w) {
            o = orow + x * 4;
            if (bpp == 24) {
                store8(o + 0, load8(srow + x * 3 + 2));   # B,G,R in the file
                store8(o + 1, load8(srow + x * 3 + 1));
                store8(o + 2, load8(srow + x * 3 + 0));
                store8(o + 3, 255);
            }
            if (bpp == 16) {
                # Little-endian 16-bit word, channels carved out by mask.
                pix = load8(srow + x * 2) | (load8(srow + x * 2 + 1) << 8);
                store8(o + 0, _bmp_scale_to_8((pix & mask_r) >> sh_r, wd_r));
                store8(o + 1, _bmp_scale_to_8((pix & mask_g) >> sh_g, wd_g));
                store8(o + 2, _bmp_scale_to_8((pix & mask_b) >> sh_b, wd_b));
                if (mask_a != 0) {
                    store8(o + 3, _bmp_scale_to_8((pix & mask_a) >> sh_a, wd_a));
                } else {
                    store8(o + 3, 255);
                }
            }
            if (bpp == 32) {
                # Little-endian 32-bit word, channels carved out by mask — the
                # same path BI_RGB takes via its default masks.
                pix = load8(srow + x * 4) | (load8(srow + x * 4 + 1) << 8)
                | (load8(srow + x * 4 + 2) << 16) | (load8(srow + x * 4 + 3) << 24);
                store8(o + 0, _bmp_scale_to_8((pix & mask_r) >> sh_r, wd_r));
                store8(o + 1, _bmp_scale_to_8((pix & mask_g) >> sh_g, wd_g));
                store8(o + 2, _bmp_scale_to_8((pix & mask_b) >> sh_b, wd_b));
                if (use_alpha == 2) {
                    store8(o + 3, _bmp_scale_to_8((pix & mask_a) >> sh_a, wd_a));
                }
                if (use_alpha == 1) {
                    store8(o + 3, load8(srow + x * 4 + 3));
                }
                if (use_alpha == 0) {
                    store8(o + 3, 255);
                }
            }
            # Indexed depths only. 16 bpp is packed-pixel, not palette-indexed,
            # so it must NOT fall into this branch — `bpp < 24` used to be a
            # safe shorthand for "indexed" and stopped being one the moment
            # 16 bpp was supported.
            if (bpp < 16) {
                if (is_rle == 1) {
                    idx = load8(rle_idx + y * w + x);
                } else {
                    idx = _bmp_index_at(srow, x, bpp);
                }
                # An index outside the palette is a hard reject, never a read
                # past it — the same posture as the PNG palette path.
                if (idx >= pal_n) {
                    store64(err_out, chitra_err(CHITRA_ERR_BMP_PALETTE));
                    return 0;
                }
                pe = pal + idx * pal_str;
                store8(o + 0, load8(pe + 2));             # palette is B,G,R[,x]
                store8(o + 1, load8(pe + 1));
                store8(o + 2, load8(pe + 0));
                store8(o + 3, 255);
            }
            x = x + 1;
        }
        y = y + 1;
    }

    var img = alloc(CHITRA_IMAGE_SIZE);
    if (img == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    store64(img + IMAGE_WIDTH_OFFSET, w);
    store64(img + IMAGE_HEIGHT_OFFSET, h);
    store64(img + IMAGE_PIXELS_OFFSET, rgba);
    store64(img + IMAGE_CHANNELS_OFFSET, 4);
    # BMP has no stream terminator to have seen — no IEND, no EOI, no trailer.
    # The whole `data_off + stride * height` span is validated against the input
    # length before a single pixel is read, so if the decode got this far the
    # pixel data was entirely present. 1 is therefore the honest answer here,
    # not a placeholder: unlike the JPEG and GIF paths before 0.7.0, there is no
    # incomplete-but-decoded state for this field to be hiding.
    store64(img + IMAGE_SEEN_IEND_OFFSET, 1);
    # src_ctype sentinel: 0x200 | bpp — so 0x201/0x204/0x208 indexed,
    # 0x218 for 24 bpp, 0x220 for 32 bpp. Distinct from PNG's raw color_type
    # (0/2/3/4/6) and JPEG's 0x100 | ncomp.
    store64(img + IMAGE_SRC_CTYPE_OFFSET, 512 + bpp);
    # Bits per CHANNEL as stored, not bits per pixel. 8 for 24/32 bpp and for
    # palette entries (which are BGRA bytes whatever the index width); for the
    # packed 16-bpp layouts it is the widest declared channel, so 5-5-5 reports
    # 5 and 5-6-5 reports 6. That is the number a caller needs to know how much
    # precision the RGBA8 output was widened FROM — bit replication (0.5.2)
    # cannot invent detail that was never stored.
    # Keyed on the mask WIDTHS rather than on `is_bitfields`, which lives in
    # _bmp_parse_header and is not in scope here. They say the same thing and
    # the widths say it more directly: a declared mask means packed channels,
    # and the 16-bpp BI_RGB path already carries the documented X1R5G5B5
    # defaults, so it reports 5 without a special case.
    var src_depth = 8;
    if (wd_r > 0) {
        src_depth = wd_r;
        if (wd_g > src_depth) { src_depth = wd_g; }
        if (wd_b > src_depth) { src_depth = wd_b; }
    }
    store64(img + IMAGE_SRC_DEPTH_OFFSET, src_depth);
    return img;
}

# ================================================================
# chitra_bmp_decode_rgba8 — convenience wrapper mirroring the PNG/JPEG pair.
# Returns the RGBA8 pointer, writing width/height through w_out/h_out.
# Returns 0 on any failure (the detailed ChitraErr is not surfaced here).
# ================================================================
# @public
fn chitra_bmp_decode_rgba8(src, len, w_out, h_out): i64 {
    store64(w_out, 0);
    store64(h_out, 0);
    var err = 0;
    var img = chitra_bmp_decode(src, len, &err);
    if (img == 0) { return 0; }
    store64(w_out, chitra_image_width(img));
    store64(h_out, chitra_image_height(img));
    return chitra_image_pixels(img);
}

# --- gif_lzw.cyr ---

# gif_lzw.cyr — GIF's LZW decompressor (variable-width, LSB-first).
#
# This is the one piece of chitra that is a decompressor written from scratch.
# PNG delegates DEFLATE to sankoch; JPEG's entropy decode is chitra's own but
# is Huffman, not dictionary-based. GIF's LZW has no stdlib to delegate to —
# `sankoch` supplies DEFLATE, not LZW — so this module is new attack surface in
# exactly the sense the JPEG entropy decoder was, and is written accordingly.
#
# THE THREE WAYS A HOSTILE LZW STREAM ATTACKS, and what stops each:
#
#   1. Unbounded output. LZW is a compressor: a few hundred bytes can expand
#      without limit. The decode is capped at `out_cap` — the caller passes
#      the frame's exact pixel count, so expansion beyond one screenful is a
#      rejection, not an allocation.
#   2. A cyclic prefix chain. Emitting a code means walking its prefix chain
#      backwards, and a corrupt dictionary whose entry points forward (or at
#      itself) turns that walk into an infinite loop. Entries are only ever
#      added with `prefix < the index being written`, so chains strictly
#      decrease and cannot cycle — and the walk is *additionally* bounded by
#      the dictionary size, because a guard you can reason about is worth less
#      than one you cannot get past.
#   3. An out-of-range code. A code above `next_code` has no dictionary entry.
#      The single legal exception is `code == next_code`, the KwKwK case, which
#      is handled explicitly; anything beyond it is rejected rather than read.
#
# GIF packs codes **LSB-first** — the opposite of JPEG's MSB-first bit reader —
# and the code width GROWS as the dictionary fills, from `min_code_size + 1` up
# to 12 bits. A Clear code resets both the dictionary and the width mid-stream.

var GIF_LZW_MAX_CODES = 4096;    # 12-bit ceiling; the dictionary never exceeds this
var GIF_LZW_MAX_WIDTH = 12;

# ================================================================
# Bit reader over the FLATTENED sub-block payload (see _gif_walk_blocks in
# gif.cyr — the sub-block chain is concatenated before decode rather than
# streamed across, so this reader never has to straddle a block boundary).
#
# State (32 bytes): +0 base, +8 len, +16 bit position, +24 (unused).
# ================================================================
var LZ_BASE = 0;
var LZ_LEN  = 8;
var LZ_BIT  = 16;
var LZ_SIZE = 32;

fn _gif_br_init(st, base, len): i64 {
    store64(st + LZ_BASE, base);
    store64(st + LZ_LEN, len);
    store64(st + LZ_BIT, 0);
    return 0;
}

# Read `n` bits LSB-first. Returns -1 when the stream is exhausted.
#
# The DECODER treats that as a clean end rather than an error, because real
# encoders in the wild omit the End code — but note what it does NOT do: it
# never zero-pads. JPEG zero-pads past end-of-data because a truncated scan
# still has a well-defined block to finish; LZW has no such notion, and padding
# would fabricate dictionary entries out of nothing.
#
# The consequence is that a stream can legitimately produce FEWER pixels than
# the frame holds, and gif.cyr zero-fills the remainder. What stops that being
# an amplification vector — a two-byte stream claiming a 4096x4096 frame — is
# the output:input cap in gif.cyr, not this function.
fn _gif_br_bits(st, n): i64 {
    var base = load64(st + LZ_BASE);
    var len = load64(st + LZ_LEN);
    var bit = load64(st + LZ_BIT);
    if (bit + n > len * 8) { return 0 - 1; }
    var v = 0;
    var i = 0;
    var byte_idx = 0;
    var bit_idx = 0;
    while (i < n) {
        byte_idx = (bit + i) / 8;
        bit_idx = (bit + i) & 7;
        v = v | (((load8(base + byte_idx) >> bit_idx) & 1) << i);
        i = i + 1;
    }
    store64(st + LZ_BIT, bit + n);
    return v;
}

# ================================================================
# _gif_lzw_decode — decompress into `out`, at most `out_cap` bytes.
#
# Returns the byte count written, or -1 with *err_out set. A short result is
# NOT an error: a stream that hits its End code before filling the frame is
# well-formed, and the caller decides what an under-filled frame means.
# ================================================================
fn _gif_lzw_decode(data, data_len, min_code_size, out, out_cap, err_out): i64 {
    store64(err_out, 0);
    # Spec § 22: the LZW minimum code size is 2..8. Below 2 there are not
    # enough codes for Clear + End; above 8 exceeds a byte of palette index.
    if (min_code_size < 2 || min_code_size > 8) {
        store64(err_out, chitra_err(CHITRA_ERR_GIF_LZW));
        return 0 - 1;
    }

    var clear_code = 1 << min_code_size;
    var end_code = clear_code + 1;

    # ⛔⛔ SIZE THE DICTIONARY TO WHAT THIS STREAM CAN ACTUALLY REACH (B-7, 1.0.3).
    # These three arrays were a FLAT 69,632 bytes on every call — 32,768 +
    # 32,768 + 4,096 — allocated before a single code was read, never memoized,
    # on an allocator that never frees. A 45-byte GIF paid all of it, and so did
    # a file the LZW decoder then rejected on its first code.
    #
    # ⚠ THE BOUND IS ARITHMETIC, NOT A HEURISTIC. Every code costs at least
    # `min_code_size + 1` bits (the width never starts smaller and only grows),
    # and each code adds at most ONE dictionary entry. So a stream of `data_len`
    # bytes can add at most `data_len * 8 / (min_code_size + 1)` entries beyond
    # the initial table plus Clear and End. Nothing a legitimate stream can do
    # is refused by this that GIF_LZW_MAX_CODES would have allowed — the cap is
    # an upper bound on reachable codes, not a policy.
    # ⇒ `table_cap` therefore replaces GIF_LZW_MAX_CODES at EVERY bound below,
    # not just at the allocations: the `next_code` ceiling and both chain-walk
    # bounds must agree with the buffer they protect, or the guard is one
    # looser than the array — the exact defect the 0.5.3 sweep found here.
    var max_new = (data_len * 8) / (min_code_size + 1);
    var table_cap = clear_code + 2 + max_new;
    if (table_cap > GIF_LZW_MAX_CODES) { table_cap = GIF_LZW_MAX_CODES; }

    var prefix = alloc(table_cap * 8);
    if (prefix == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0 - 1; }
    var suffix = alloc(table_cap * 8);
    if (suffix == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0 - 1; }
    # Expansion scratch: a chain can be at most one entry per dictionary slot.
    var chain = alloc(table_cap);
    if (chain == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0 - 1; }

    var i = 0;
    while (i < clear_code) {
        store64(prefix + i * 8, 0 - 1);
        store64(suffix + i * 8, i);
        i = i + 1;
    }

    var br[32];
    _gif_br_init(&br, data, data_len);

    var code_size = min_code_size + 1;
    var next_code = clear_code + 2;
    var prev = 0 - 1;
    var written = 0;
    var done = 0;
    var rc = 0;

    var code = 0;
    var cur = 0;
    var sp = 0;
    var first = 0;
    var guard = 0;

    while (done == 0) {
        code = _gif_br_bits(&br, code_size);
        if (code < 0) {
            # Ran out of bits without an End code. Tolerated as a clean end:
            # real encoders in the wild omit the terminator, and the frame is
            # already bounded by out_cap.
            done = 1;
        }
        if (done == 0) {
            if (code == clear_code) {
                code_size = min_code_size + 1;
                next_code = clear_code + 2;
                prev = 0 - 1;
            } else {
                if (code == end_code) {
                    done = 1;
                } else {
                    # ---- resolve the code to a byte string -----------------
                    sp = 0;
                    if (code > next_code) {
                        rc = CHITRA_ERR_GIF_LZW;      # no such dictionary entry
                        done = 1;
                    }
                    if (done == 0) {
                        if (code == next_code) {
                            # KwKwK: the entry being defined by this very code.
                            # Only legal with a previous code to extend.
                            if (prev < 0) {
                                rc = CHITRA_ERR_GIF_LZW;
                                done = 1;
                            }
                            if (done == 0) {
                                # KwKwK emits string(prev) + first_char(prev).
                                # `chain` is a REVERSE stack — the emit loop
                                # below walks it from the top down — so the
                                # trailing byte must sit at the BOTTOM, index 0.
                                # It is not known until the chain walk finds the
                                # root, so index 0 is reserved and filled after.
                                sp = 1;
                                cur = prev;
                                guard = 0;
                                while (cur >= clear_code) {
                                    if (guard >= table_cap) {
                                        rc = CHITRA_ERR_GIF_LZW;
                                        cur = 0 - 1;
                                    }
                                    if (cur >= clear_code) {
                                        # Bound on `sp` itself, not merely on
                                        # the walk length: sp is what indexes
                                        # `chain`, and the guard counter was
                                        # one looser than the buffer it was
                                        # protecting.
                                        if (sp >= table_cap) {
                                            rc = CHITRA_ERR_GIF_LZW;
                                            cur = 0 - 1;
                                        }
                                        if (cur >= clear_code) {
                                            store8(chain + sp, load64(suffix + cur * 8));
                                            sp = sp + 1;
                                            cur = load64(prefix + cur * 8);
                                            guard = guard + 1;
                                        }
                                    }
                                }
                                if (rc != 0) { done = 1; }
                                if (done == 0) {
                                    if (cur < 0) { rc = CHITRA_ERR_GIF_LZW; done = 1; }
                                }
                                if (done == 0) {
                                    first = load64(suffix + cur * 8);
                                    store8(chain + sp, first);   # root: emitted FIRST
                                    sp = sp + 1;
                                    store8(chain + 0, first);    # repeat: emitted LAST
                                }
                            }
                        } else {
                            cur = code;
                            guard = 0;
                            while (cur >= clear_code) {
                                if (guard >= table_cap) {
                                    rc = CHITRA_ERR_GIF_LZW;
                                    cur = 0 - 1;
                                }
                                if (cur >= clear_code) {
                                    if (sp >= table_cap) {
                                        rc = CHITRA_ERR_GIF_LZW;
                                        cur = 0 - 1;
                                    }
                                    if (cur >= clear_code) {
                                        store8(chain + sp, load64(suffix + cur * 8));
                                        sp = sp + 1;
                                        cur = load64(prefix + cur * 8);
                                        guard = guard + 1;
                                    }
                                }
                            }
                            if (rc != 0) { done = 1; }
                            if (done == 0) {
                                if (cur < 0) { rc = CHITRA_ERR_GIF_LZW; done = 1; }
                            }
                            if (done == 0) {
                                first = load64(suffix + cur * 8);
                                store8(chain + sp, first);
                                sp = sp + 1;
                            }
                        }
                    }

                    # ---- emit (the chain was pushed in reverse) ------------
                    if (done == 0) {
                        if (written + sp > out_cap) {
                            # Decompression bomb: more pixels than the frame has.
                            rc = CHITRA_ERR_GIF_LZW;
                            done = 1;
                        }
                    }
                    if (done == 0) {
                        i = sp - 1;
                        while (i >= 0) {
                            store8(out + written, load8(chain + i));
                            written = written + 1;
                            i = i - 1;
                        }

                        # ---- extend the dictionary ------------------------
                        # The new entry's prefix is always the PREVIOUS code,
                        # which is strictly less than the index being written —
                        # that ordering is what makes a cyclic chain impossible.
                        if (prev >= 0) {
                            if (next_code < table_cap) {
                                store64(prefix + next_code * 8, prev);
                                store64(suffix + next_code * 8, first);
                                next_code = next_code + 1;
                                if (next_code == (1 << code_size)) {
                                    if (code_size < GIF_LZW_MAX_WIDTH) {
                                        code_size = code_size + 1;
                                    }
                                }
                            }
                        }
                        prev = code;
                    }
                }
            }
        }
    }

    if (rc != 0) {
        store64(err_out, chitra_err(rc));
        return 0 - 1;
    }
    return written;
}

# --- gif.cyr ---

# @public — chitra GIF decoder: GIF bytes -> canonical RGBA8 (first frame).
#
# gif.cyr — the block walk, the frame geometry, and the palette pass. LZW lives
# next door in gif_lzw.cyr.
#
# **This decodes the FIRST frame only.** GIF is the one format chitra handles
# that describes a *sequence* rather than an image, and `ChitraImage` has one
# `pixels` pointer, no frame count, and no delay. The reasoning, the cost, and
# the shape a future multi-frame surface would take are all in
# ADR 0005 (docs/adr/0005-gif-first-frame-only.md). The cost worth repeating
# here, because it is the one place this is visibly lossy: an *optimised*
# animation whose first frame is a background plate will decode to that plate,
# not to what a viewer shows.
#
# Four things about GIF framing that the LZW layer cannot tell you:
#
#   1. There are TWO geometries. The Logical Screen Descriptor gives the
#      canvas; each image descriptor gives a rect *within* it, at an (left,top)
#      offset. They are frequently equal and occasionally not.
#   2. There are TWO palettes. A Global Color Table applies unless an image
#      carries its own Local Color Table, which wins for that image only.
#   3. Transparency is not in the image — it is in a Graphic Control Extension
#      that PRECEDES the image descriptor, and it names a palette index.
#   4. Rows may be INTERLACED in four passes, on a different schedule from
#      PNG's Adam7 (GIF interlaces rows only; Adam7 interlaces both axes).
#
# Uncovered canvas — the area outside the first frame's rect — is emitted as
# **transparent** (alpha 0) rather than filled with the background color.
# chitra did not decode those pixels; alpha 0 says exactly that, where a
# background fill would assert a color the frame never specified.

var GIF_MAX_COLORS = 256;

# Output:input amplification ceiling, the GIF analogue of PNG's inflate ratio
# and JPEG's output:input cap. Without it a ~800-byte file declaring a
# 4096x4096 logical screen allocated ~67 MB of canvas that the bump allocator
# never reclaims.
#
# This one is DELIBERATELY looser than PNG's 1100:1, and the reason is worth
# stating rather than hiding in a round number: LZW's legitimate compression of
# degenerate content is close to the bomb ratio. One full dictionary cycle
# (codes 258..4095) encodes ~7.4 M identical pixels in ~5.8 KB, so a SOLID
# 4096x4096 GIF is a real ~13 KB file — about 5100:1. A PNG-tight cap would
# reject it. 16384:1 admits anything down to 4 KB, keeping ~3x headroom over
# that floor while still rejecting the observed 797-byte bomb by two orders of
# magnitude. The honest summary: this bounds the extreme case, not the merely
# aggressive one, because for LZW those are nearer together than for DEFLATE.
var CHITRA_MAX_GIF_RATIO = 16384;

# Block introducers (spec § 15-27).
var GIF_BLOCK_IMAGE     = 0x2C;   # Image Descriptor
var GIF_BLOCK_EXTENSION = 0x21;   # Extension Introducer
var GIF_BLOCK_TRAILER   = 0x3B;   # end of stream
var GIF_EXT_GRAPHIC_CTL = 0xF9;   # Graphic Control Extension (carries transparency)
# Spec § 25. Skipped like any other extension — chitra renders no text — but it
# is a GRAPHIC-RENDERING block, and that distinction is not cosmetic: a Graphic
# Control Extension governs the graphic-rendering block that FOLLOWS it, so a
# Plain Text block consumes the pending GCE rather than letting it fall through
# to the next image descriptor.
var GIF_EXT_PLAINTEXT   = 0x01;
#
# EXAMINED IN 0.7.2 AND DELIBERATELY NOT ACTED ON. By § 23 a GCE's scope is
# "the first Graphic-Rendering Block to follow", and § 25 makes Plain Text one
# — so on the reading of the spec alone, a GCE / PlainText / Image sequence
# means the GCE governs the TEXT, and chitra carrying its transparent index
# forward to the image keys pixels the file never asked for.
#
# ImageMagick disagrees, measured: on a hand-built GIF with exactly that
# sequence it renders the image transparent, identically to the same file with
# the Plain Text block removed. So the reference decoder carries the GCE
# forward too.
#
# chitra follows the reference here rather than the spec reading. Plain Text
# blocks are essentially unused in the wild, no file exists to check the
# claim against, and being the only decoder that renders such a file opaque is
# a visible divergence bought with a conformance argument nothing can confirm.
# This project diverges from ImageMagick where the spec is prohibitive and the
# consequence is a wrong image (PNG § 5.6 in 0.7.1); that is not this case.

fn _gif_u16_le(p): i64 {
    return load8(p) | (load8(p + 1) << 8);
}

# ================================================================
# chitra_gif_check_signature — 1 if the bytes open with "GIF87a" or "GIF89a".
# ================================================================
# @public
fn chitra_gif_check_signature(src, len): i64 {
    if (len < 6) { return 0; }
    if (load8(src + 0) != 0x47) { return 0; }    # 'G'
    if (load8(src + 1) != 0x49) { return 0; }    # 'I'
    if (load8(src + 2) != 0x46) { return 0; }    # 'F'
    if (load8(src + 3) != 0x38) { return 0; }    # '8'
    # '7' or '9' — GIF87a and GIF89a differ in features, not in framing, and
    # chitra reads only framing the two share.
    if (load8(src + 4) != 0x37) {
        if (load8(src + 4) != 0x39) { return 0; }
    }
    if (load8(src + 5) != 0x61) { return 0; }    # 'a'
    return 1;
}

# ================================================================
# Walk a sub-block chain (length byte + payload, terminated by a 0 length),
# copying the payload into `out` when it is non-zero. Returns the byte offset
# JUST PAST the terminator, or -1 if the chain runs off the end of the input.
#
# Every GIF payload of unbounded size — LZW data, comments, application data —
# is carried this way, so this one walk is both the skip path and the gather
# path. `out_cap` bounds the gather; the caller passes the input length, so a
# chain cannot make chitra hold more than the file itself.
# ================================================================
fn _gif_walk_blocks(src, len, pos, out, out_cap, written_out): i64 {
    var written = 0;
    var p = pos;
    var n = 0;
    var i = 0;
    var done = 0;
    var rc = 0;
    while (done == 0) {
        if (p >= len) { rc = 0 - 1; done = 1; }
        if (done == 0) {
            n = load8(src + p);
            p = p + 1;
            if (n == 0) {
                done = 1;                      # terminator
            } else {
                if (p + n > len) { rc = 0 - 1; done = 1; }
                if (done == 0) {
                    if (out != 0) {
                        if (written + n > out_cap) { rc = 0 - 1; done = 1; }
                        if (done == 0) {
                            i = 0;
                            while (i < n) {
                                store8(out + written + i, load8(src + p + i));
                                i = i + 1;
                            }
                            written = written + n;
                        }
                    }
                    if (done == 0) { p = p + n; }
                }
            }
        }
    }
    if (rc != 0) { return 0 - 1; }
    if (written_out != 0) { store64(written_out, written); }
    return p;
}

# GIF interlace: four passes over ROWS only (unlike PNG's Adam7, which
# subsamples both axes). Pass starts 0/4/2/1 with steps 8/8/4/2.
fn _gif_pass_start(p): i64 {
    if (p == 0) { return 0; }
    if (p == 1) { return 4; }
    if (p == 2) { return 2; }
    return 1;
}

fn _gif_pass_step(p): i64 {
    if (p == 0) { return 8; }
    if (p == 1) { return 8; }
    if (p == 2) { return 4; }
    return 2;
}

# ================================================================
# chitra_gif_decode — decode the FIRST frame of (src, len) into an owned RGBA8
# ChitraImage sized to the LOGICAL SCREEN. Returns the ChitraImage ptr, or 0
# with *err_out set. See ADR 0005 for the first-frame decision.
# ================================================================
# @public
fn chitra_gif_decode(src, len, err_out): i64 {
    store64(err_out, 0);
    if (chitra_gif_check_signature(src, len) == 0) {
        store64(err_out, chitra_err(CHITRA_ERR_SIGNATURE));
        return 0;
    }
    # 6-byte signature + 7-byte Logical Screen Descriptor.
    if (len < 13) {
        store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
        return 0;
    }

    var screen_w = _gif_u16_le(src + 6);
    var screen_h = _gif_u16_le(src + 8);
    var packed = load8(src + 10);

    if (screen_w <= 0 || screen_h <= 0) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    if (screen_w > CHITRA_MAX_DIM || screen_h > CHITRA_MAX_DIM) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    if (screen_w * screen_h > CHITRA_MAX_PIXELS) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    var pos = 13;
    var gct_off = 0;
    var gct_n = 0;
    if ((packed & 0x80) != 0) {
        gct_n = 1 << ((packed & 7) + 1);
        gct_off = pos;
        if (pos + gct_n * 3 > len) {
            store64(err_out, chitra_err(CHITRA_ERR_GIF_PALETTE));
            return 0;
        }
        pos = pos + gct_n * 3;
    }

    # ---- block walk to the first image descriptor -----------------------
    # Extensions before it are skipped by their sub-block chain — which is
    # what makes an UNKNOWN extension harmless rather than a parse failure.
    # Only the Graphic Control Extension is read, for its transparent index.
    var transparent = 0 - 1;
    var found = 0;
    var walking = 1;
    var b = 0;
    var label = 0;
    var gce_packed = 0;
    var next = 0;
    var rcode = 0;

    while (walking == 1) {
        if (pos >= len) { rcode = CHITRA_ERR_GIF_NO_IMAGE; walking = 0; }
        if (walking == 1) {
            b = load8(src + pos);
            if (b == GIF_BLOCK_TRAILER) {
                rcode = CHITRA_ERR_GIF_NO_IMAGE;
                walking = 0;
            }
            if (walking == 1) {
                if (b == GIF_BLOCK_EXTENSION) {
                    if (pos + 2 > len) { rcode = CHITRA_ERR_TRUNCATED; walking = 0; }
                    if (walking == 1) {
                        label = load8(src + pos + 1);
                        if (label == GIF_EXT_GRAPHIC_CTL) {
                            # GCE layout (spec § 23): block size, packed,
                            # delay(2), transparent index, terminator. The
                            # block size is fixed at 4 and IS CHECKED — every
                            # field after it is addressed by a fixed offset, so
                            # a GCE declaring any other size would have chitra
                            # read the packed byte and the transparent index
                            # from bytes that are not those fields.
                            if (pos + 7 > len) { rcode = CHITRA_ERR_TRUNCATED; walking = 0; }
                            if (walking == 1) {
                                if (load8(src + pos + 2) != 4) {
                                    rcode = CHITRA_ERR_GIF_HEADER;
                                    walking = 0;
                                }
                            }
                            if (walking == 1) {
                                gce_packed = load8(src + pos + 3);
                                # A GCE applies to the graphic that FOLLOWS it,
                                # so the last one before the image descriptor
                                # governs — including one that turns
                                # transparency OFF. `transparent` is
                                # function-scoped, so it must be cleared
                                # explicitly; leaving it set let an earlier
                                # GCE's index survive a later GCE that revoked
                                # it, keying pixels the file said were opaque.
                                if ((gce_packed & 1) != 0) {
                                    transparent = load8(src + pos + 6);
                                } else {
                                    transparent = 0 - 1;
                                }
                            }
                        }
                        if (walking == 1) {
                            next = _gif_walk_blocks(src, len, pos + 2, 0, 0, 0);
                            if (next < 0) { rcode = CHITRA_ERR_TRUNCATED; walking = 0; }
                            if (walking == 1) { pos = next; }
                        }
                    }
                } else {
                    if (b == GIF_BLOCK_IMAGE) {
                        found = 1;
                        walking = 0;
                    } else {
                        # Not a legal block introducer at this position.
                        rcode = CHITRA_ERR_GIF_HEADER;
                        walking = 0;
                    }
                }
            }
        }
    }
    if (rcode != 0) { store64(err_out, chitra_err(rcode)); return 0; }
    if (found == 0) { store64(err_out, chitra_err(CHITRA_ERR_GIF_NO_IMAGE)); return 0; }

    # ---- image descriptor (10 bytes) ------------------------------------
    if (pos + 10 > len) {
        store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
        return 0;
    }
    var fx = _gif_u16_le(src + pos + 1);
    var fy = _gif_u16_le(src + pos + 3);
    var fw = _gif_u16_le(src + pos + 5);
    var fh = _gif_u16_le(src + pos + 7);
    var ipacked = load8(src + pos + 9);
    pos = pos + 10;

    if (fw <= 0 || fh <= 0) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    # The frame rect must lie inside the canvas it claims to paint. A frame
    # hanging off the edge is malformed, not something to clamp — clamping
    # would silently decode a different image than the file describes.
    if (fx + fw > screen_w || fy + fh > screen_h) {
        store64(err_out, chitra_err(CHITRA_ERR_GIF_HEADER));
        return 0;
    }

    # Local color table wins over the global one, for this image only.
    var pal_off = gct_off;
    var pal_n = gct_n;
    if ((ipacked & 0x80) != 0) {
        pal_n = 1 << ((ipacked & 7) + 1);
        pal_off = pos;
        if (pos + pal_n * 3 > len) {
            store64(err_out, chitra_err(CHITRA_ERR_GIF_PALETTE));
            return 0;
        }
        pos = pos + pal_n * 3;
    }
    if (pal_n <= 0) {
        # Neither table present: the indices name nothing.
        store64(err_out, chitra_err(CHITRA_ERR_GIF_PALETTE));
        return 0;
    }
    # The transparent index is a palette index like any other, and chitra's rule
    # for those is to reject rather than tolerate — it is checked here, against
    # the table in force for THIS image, because a local table changes what "in
    # range" means. Out of range it would simply never match a pixel, so this
    # is a validation gap rather than a wrong-output one; it is closed for the
    # same reason the pixel-index check exists, and because a field that names
    # nothing is a statement the file cannot mean.
    if (transparent >= 0) {
        if (transparent >= pal_n) {
            store64(err_out, chitra_err(CHITRA_ERR_GIF_PALETTE));
            return 0;
        }
    }

    var interlaced = 0;
    if ((ipacked & 0x40) != 0) { interlaced = 1; }

    # ---- LZW data: min code size byte, then the sub-block chain ----------
    if (pos >= len) {
        store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
        return 0;
    }
    var min_code_size = load8(src + pos);
    pos = pos + 1;

    # Gather the sub-blocks. Bounded by the input length, so the compressed
    # side can never exceed the file.
    var comp = alloc(len);
    if (comp == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    var comp_len = 0;
    next = _gif_walk_blocks(src, len, pos, comp, len, &comp_len);
    if (next < 0) {
        store64(err_out, chitra_err(CHITRA_ERR_TRUNCATED));
        return 0;
    }

    # ---- amplification cap ----------------------------------------------
    # Measured against `comp_len`, the LZW bytes actually gathered, NOT the
    # file length: appending ignored trailing junk after the trailer would
    # otherwise inflate the allowance and defeat the cap. Checked HERE, before
    # the index plane and the canvas are allocated — a cap that fires after the
    # allocation it is meant to prevent is decoration.
    #
    # The ratio bounds THE FRAME, which is what the LZW stream actually
    # expands into. It deliberately does NOT bound the logical screen.
    #
    # 0.5.3 shipped a second check that did — `screen_w * screen_h * 4` against
    # the same allowance — and it rejected valid files. An optimised animation
    # names a large canvas and paints a small first frame into it; that is the
    # normal shape of the format, not an attack. Measured: an 81-byte GIF with a
    # 1920x1080 logical screen, which ImageMagick reads without complaint, was
    # refused with CHITRA_ERR_DIMENSIONS, because the canvas needs 506 bytes of
    # allowance at 16384:1 and the whole file is 81.
    #
    # The canvas and the frame are different quantities and need different
    # bounds. A large canvas is not amplification — the file DECLARED those
    # dimensions, exactly as a PNG's IHDR declares its own, and the honest bound
    # is the same one PNG uses: CHITRA_MAX_DIM and CHITRA_MAX_PIXELS at the
    # screen-descriptor parse above, plus CHITRA_MAX_RAW_BYTES on the output
    # buffer below. A hostile GIF naming a 4096x4096 canvas and a 1x1 frame is
    # therefore capped at 64 MB rather than rejected, and it is the same
    # accepted risk PNG carries and SECURITY.md records: the bomb and the
    # legitimate image are the same file shape, so a ratio cannot separate them
    # and rejecting on one refuses real files.
    if (fw * fh > comp_len * CHITRA_MAX_GIF_RATIO) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }

    # ---- decompress to palette indices ----------------------------------
    var npix = fw * fh;
    var idx = alloc(npix);
    if (idx == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    var got = _gif_lzw_decode(comp, comp_len, min_code_size, idx, npix, err_out);
    if (got < 0) { return 0; }
    # A stream that ends early is well-formed (see gif_lzw.cyr); the tail stays
    # at whatever the allocator gave us, so zero it rather than emit whatever
    # was there. Index 0 is a real palette entry, which is the honest choice:
    # the alternative is inventing a transparency the file never declared.
    var z = got;
    while (z < npix) { store8(idx + z, 0); z = z + 1; }
    # 0.7.0: remember whether the frame was actually filled. Zero-filling the
    # tail is the right DECODE, but returning it with no signal meant a caller
    # could not tell a complete frame from a prefix followed by palette entry 0
    # at full alpha — which is what a GIF truncated inside its sub-block chain
    # produces.
    var frame_complete = 1;
    if (got < npix) { frame_complete = 0; }

    # ---- canvas: logical screen, transparent where this frame paints nothing
    var out_size = screen_w * screen_h * 4;
    if (out_size > CHITRA_MAX_RAW_BYTES) {
        store64(err_out, chitra_err(CHITRA_ERR_DIMENSIONS));
        return 0;
    }
    var rgba = alloc(out_size);
    if (rgba == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    var q = 0;
    while (q < out_size) { store8(rgba + q, 0); q = q + 1; }

    var pal = src + pal_off;
    var row = 0;
    var col = 0;
    var pass = 0;
    var src_row = 0;
    var dst_y = 0;
    var pi = 0;
    var pe = 0;
    var o = 0;

    if (interlaced == 0) {
        row = 0;
        while (row < fh) {
            col = 0;
            while (col < fw) {
                pi = load8(idx + row * fw + col);
                if (pi >= pal_n) {
                    store64(err_out, chitra_err(CHITRA_ERR_GIF_PALETTE));
                    return 0;
                }
                o = rgba + ((fy + row) * screen_w + (fx + col)) * 4;
                pe = pal + pi * 3;
                store8(o + 0, load8(pe + 0));
                store8(o + 1, load8(pe + 1));
                store8(o + 2, load8(pe + 2));
                if (pi == transparent) { store8(o + 3, 0); } else { store8(o + 3, 255); }
                col = col + 1;
            }
            row = row + 1;
        }
    } else {
        # Interlaced: consecutive decoded rows belong to the four passes in
        # turn, so the source row counter advances linearly while the
        # destination row jumps by the pass step.
        src_row = 0;
        pass = 0;
        while (pass < 4) {
            dst_y = _gif_pass_start(pass);
            while (dst_y < fh) {
                col = 0;
                while (col < fw) {
                    pi = load8(idx + src_row * fw + col);
                    if (pi >= pal_n) {
                        store64(err_out, chitra_err(CHITRA_ERR_GIF_PALETTE));
                        return 0;
                    }
                    o = rgba + ((fy + dst_y) * screen_w + (fx + col)) * 4;
                    pe = pal + pi * 3;
                    store8(o + 0, load8(pe + 0));
                    store8(o + 1, load8(pe + 1));
                    store8(o + 2, load8(pe + 2));
                    if (pi == transparent) { store8(o + 3, 0); } else { store8(o + 3, 255); }
                    col = col + 1;
                }
                src_row = src_row + 1;
                dst_y = dst_y + _gif_pass_step(pass);
            }
            pass = pass + 1;
        }
    }

    var img = alloc(CHITRA_IMAGE_SIZE);
    if (img == 0) { store64(err_out, chitra_err(CHITRA_ERR_OOM)); return 0; }
    store64(img + IMAGE_WIDTH_OFFSET, screen_w);
    store64(img + IMAGE_HEIGHT_OFFSET, screen_h);
    store64(img + IMAGE_PIXELS_OFFSET, rgba);
    store64(img + IMAGE_CHANNELS_OFFSET, 4);
    # 0.7.0 — the GIF analogue of PNG's IEND question: did the stream deliver
    # the frame it promised? Hardcoded to 1 through 0.6.1, so a truncated GIF
    # reported a clean end while handing back a prefix. chitra still returns
    # the partial image (ADR 0005's posture: decode what is there), but the
    # caller can now tell.
    store64(img + IMAGE_SEEN_IEND_OFFSET, frame_complete);
    # src_ctype sentinel: 0x300 | (bits per palette index). Distinct from PNG's
    # raw color_type, JPEG's 0x100 | ncomp, and BMP's 0x200 | bpp.
    store64(img + IMAGE_SRC_CTYPE_OFFSET, 768 + min_code_size);
    store64(img + IMAGE_SRC_DEPTH_OFFSET, 8);   # palette entries are bytes
    return img;
}

# ================================================================
# chitra_gif_decode_rgba8 — convenience wrapper, mirroring the other formats.
# ================================================================
# @public
fn chitra_gif_decode_rgba8(src, len, w_out, h_out): i64 {
    store64(w_out, 0);
    store64(h_out, 0);
    var err = 0;
    var img = chitra_gif_decode(src, len, &err);
    if (img == 0) { return 0; }
    store64(w_out, chitra_image_width(img));
    store64(h_out, chitra_image_height(img));
    return chitra_image_pixels(img);
}
