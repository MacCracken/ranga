    store64(t + 608, 0x3E9C8571C4687A3D);   # 760 nm = 4.25e-07
    store64(t + 616, 0x3E9572AFAA3A164A);   # 765 nm = 3.196e-07
    store64(t + 624, 0x3E9031809F856876);   # 770 nm = 2.413e-07
    store64(t + 632, 0x3E888C6569EC4BD1);   # 775 nm = 1.829e-07
    store64(t + 640, 0x3E82A800EE1A2D05);   # 780 nm = 1.39e-07
    _vlambda_scotopic_p = t;
    return t;
}

# Maximum luminous efficacy at 555nm (683 lm/W).
#must_use
fn photometry_k_m() { return f64_from(683); }

# Photopic luminous flux: K_m * sum(spd.at(wl) * V(wl)) * 5nm step.
# NaN for a V(lambda) table that could not be allocated (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn luminous_flux(spd) {
    var t = _vlambda_photopic();
    # ⛔ 2.3.8: the lazy table builders now return 0 when their one-time
    # allocation fails (they used to store through it and SIGSEGV). A 0 here
    # must not be indexed — report the same degenerate answer this function
    # already gives for an out-of-domain input, rather than faulting.
    if (t == 0) { return _PRK_NAN; }
    var sum = f64_from(0);
    var i = 0;
    while (i < 81) {
        sum = f64_add(sum, f64_mul(spd_at(spd, f64_from(380 + i * 5)), _vl(t, i)));
        i = i + 1;
    }
    return f64_mul(f64_mul(f64_from(683), sum), f64_from(5));
}

# Luminous efficacy (lm/W): K_m * luminous_sum / radiant_sum (0 if no radiant power).
# NaN for a V(lambda) table that could not be allocated (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn luminous_efficacy(spd) {
    var t = _vlambda_photopic();
    # ⛔ 2.4.8: the 2.3.8 sweep that added these guards missed THIS function —
    # its two siblings, luminous_flux above and luminous_flux_scotopic below,
    # both carry one. The lazy table builders return 0 when their one-time
    # allocation fails, and a 0 indexed here is the SIGSEGV that sweep existed
    # to remove. 0 lm/W is already this function's sentinel for no radiant power.
    if (t == 0) { return _PRK_NAN; }
    var radiant_sum = f64_from(0);
    var luminous_sum = f64_from(0);
    var i = 0;
    while (i < 81) {
        var power = spd_at(spd, f64_from(380 + i * 5));
        radiant_sum = f64_add(radiant_sum, power);
        luminous_sum = f64_add(luminous_sum, f64_mul(power, _vl(t, i)));
        i = i + 1;
    }
    if (f64_lt(radiant_sum, _phot_eps15()) == 1) {
        return f64_from(0);
    }
    return f64_div(f64_mul(f64_from(683), luminous_sum), radiant_sum);
}

# Scotopic (night-vision) luminous flux: K'_m (1700 lm/W) * sum(spd.at * V') * 5nm.
# NaN for a V'(lambda) table that could not be allocated (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn luminous_flux_scotopic(spd) {
    var t = _vlambda_scotopic();
    # ⛔ 2.3.8: the lazy table builders now return 0 when their one-time
    # allocation fails (they used to store through it and SIGSEGV). A 0 here
    # must not be indexed — report the same degenerate answer this function
    # already gives for an out-of-domain input, rather than faulting.
    if (t == 0) { return _PRK_NAN; }
    var sum = f64_from(0);
    var i = 0;
    while (i < 81) {
        sum = f64_add(sum, f64_mul(spd_at(spd, f64_from(380 + i * 5)), _vl(t, i)));
        i = i + 1;
    }
    return f64_mul(f64_mul(f64_from(1700), sum), f64_from(5));
}

# Drop every lazily-built table in prakash so the next call rebuilds it.
#
# ⛔ Call this IMMEDIATELY AFTER the stdlib's `alloc_reset()`, or prakash returns
# silent zeros. See `_cie_reset_caches` for the reproduction: the photopic peak
# reads 1.0 before a reset and 0.0 after, with no error reported.
#
# ⚠ Placement is forced by bundle order, not by taste. All 21 cached tables live
# in spectral_cie (19) and this module (2), and `cyrius distlib` concatenates
# spectral_cie BEFORE spectral_photometry — so this is the earliest module that
# can see both sets.
# ⛔ 2.5.1: A LATER MODULE'S CACHE CANNOT BE REACHED FROM HERE, AND ONE WAS MISSED.
# This comment used to say "if a third module ever caches a table, give it its
# own _*_reset_caches and call it from here". 2.3.8 then gave wave_pattern six
# grow-only scratch pointers, and nothing cleared them: after alloc_reset() +
# this function, the next diffraction_pattern_circular(64, 10) wrote into a block
# the allocator had already handed back out — 12,416 of a fresh 16,384-word
# consumer buffer overwritten, with no error. Calling forward into wave_pattern
# is not an option (a spectral-only build would not link), so modules after this
# one watch `_prk_cache_epoch` (error.cyr) instead: bumping it here makes every
# such cache drop itself on its next use. A new cache in a LATER module must do
# the same; one in an EARLIER module can be cleared directly, as above.
#
# This is a forget, not a free: prakash's allocator cannot free, and that is the
# whole reason a consumer reaches for `alloc_reset()` in the first place.
fn prakash_reset_caches() {
    var _c = _cie_reset_caches();
    _vlambda_photopic_p = 0;
    _vlambda_scotopic_p = 0;
    _prk_cache_epoch = _prk_cache_epoch + 1;
    return 0;
}

# --- spectral_fluor.cyr ---

# spectral_fluor.cyr -- fluorescence: excitation and emission spectra, Stokes shift, quantum
# yield, the Donaldson re-radiation matrix, and Forster resonance energy transfer
# Usage: include "lib/spectral_fluor.cyr"
#   (requires error.cyr, spectral_core.cyr, spectral_cie.cyr for Spd + spd_at)
#
# New in 2.15.0, and NOT a port: the Rust 1.x crate had no luminescence. A fluorescent material
# absorbs light at one wavelength and re-emits part of it at longer ones, so a surface's response
# is no longer one reflectance per wavelength but a matrix from incident wavelength to emitted
# wavelength (Donaldson, Br. J. Appl. Phys. 5, 210 (1954)). This module builds that matrix from
# an absorption band, an emission band and a quantum yield, finds the bands' peaks and the Stokes
# shift between them, measures quantum yields by the comparative method, and gives Forster's
# theory of energy transfer between two fluorophores.
#
# CONVENTIONS — read these before comparing a value against another source:
# - A spectrum is an Spd: point samples per unit wavelength (nm), as everywhere in prakash. An
#   integral over one is the sum of its samples times its step, the rule spd_to_xyz uses.
# - An Spd is spectral POWER unless a function says photons. A spectrofluorometer's corrected
#   spectrum counts photons; spd_energy_to_photons and spd_photons_to_energy convert, exactly,
#   with the CODATA h and c. Forster's overlap integral needs the donor's emission in photons.
# - TWO KINDS OF SPECTRUM. An emission spectrum is a DENSITY: power (or photons) per nm, which
#   per cm^-1 is lambda^2/1e7 times as much, so per wavenumber it peaks elsewhere. An excitation
#   or absorption spectrum (absorptance, absorbance, eps, a corrected excitation scan) is a
#   FUNCTION of wavelength, a response per photon at lambda: it has no per-nm unit, and per
#   wavenumber it peaks at the same point. 2.15.0's review caught the first cut converting an
#   excitation spectrum as a density, which put an eps band Gaussian in wavenumber 111 cm^-1 off
#   its centre and the Stokes shift 11% low.
# - A peak is the maximum of the samples, found between them by the parabola through the
#   logarithms of the largest sample and its two neighbours, against wavenumber: exact for a band
#   Gaussian in energy. It is a local fit and smooths nothing, so noise on those three samples
#   moves it: fit or smooth noisy data first. It is NaN when the maximum is on the first or last
#   sample (the band may peak outside the data), shared by two samples (a saturated top, or two
#   equal peaks), or not positive.
# - The Stokes shift is the emission peak less the excitation peak. In nm it uses both peaks per
#   nm, as the spectra are recorded. In cm^-1 and eV it takes the excitation's peak as it stands
#   and the emission's per cm^-1 (fluor_peak_cm1). The two scales do not convert into each other,
#   because the emission peaks are different points. The emission per cm^-1 peaks about
#   sigma^2/nu0 apart as photons and as power (37 cm^-1 for a 515 nm band 2000 cm^-1 wide):
#   spectroscopy states Stokes shifts from photon spectra, as a spectrofluorometer records them.
# - A quantum yield is photons emitted per photon absorbed.
#
# THE DONALDSON MATRIX on a grid lambda_k = start + k step, k = 0 .. n - 1, maps a sampled
# spectral radiance in to one out: out(lambda_o) = sum_i M[o][i] in(lambda_i). With R the
# surface's own (non-fluorescent) reflectance, a its absorptance in the fluorescent band, Phi
# the quantum yield and E the emission spectrum (power, any scale),
#   M[o][i] = R(lambda_i) [o = i] + Phi a(lambda_i) lambda_i E(lambda_o) step / W,
#   W = sum_k E_k lambda_k step_E   over the emission Spd's own samples.
# Each absorbed photon at lambda_i becomes Phi photons spread as E lambda (the emission counted
# in photons), and each carries hc/lambda_o. So a column returns Phi a photons per photon in,
# and Phi a lambda_i/<lambda> of the energy in, <lambda> = sum E lambda/sum E: less than Phi a
# by the Stokes loss.
# - FLUOR_ALL keeps the whole emission band at every excitation wavelength: Kasha and Vavilov's
#   rules, the band's shape and yield independent of where it was excited. Excited on the red
#   edge of its absorption, a fluorophore then emits some photons bluer than the ones it took
#   in. That is anti-Stokes emission, real, paid for in heat, and a column can then return more
#   energy than the light it absorbed.
# - FLUOR_DOWN keeps only emission at or beyond the excitation wavelength (o >= i), so energy
#   is never gained. The photons the band would put bluer are dropped, not moved, so the
#   quantum yield is met only where excitation lies blue of the whole band.
#
# FORSTER TRANSFER between a donor D and an acceptor A at distance r (Forster, Ann. Phys. 437,
# 55 (1948); Lakowicz, Principles of Fluorescence Spectroscopy, 3rd ed., ch. 13):
#   E = 1/(1 + (r/R0)^6),   k_T = (1/tau_D)(R0/r)^6,
#   R0^6 = 9000 ln(10) kappa^2 Phi_D J/(128 pi^5 N_A n^4),
#   J = integral F_D(lambda) eps_A(lambda) lambda^4 dlambda / integral F_D(lambda) dlambda,
# with F_D the donor's emission IN PHOTONS (the nu^-4 in J is the donor's photon spectrum over
# nu^3 times the acceptor's eps over nu, so an energy spectrum would weight it wrongly), eps_A the
# acceptor's molar decadic absorption coefficient in M^-1 cm^-1 and lambda in nm. Then J is in
# M^-1 cm^-1 nm^4 and R0 = 0.021084 (kappa^2 Phi_D J/n^4)^(1/6) nm: the constant is
# (9000 ln 10/(128 pi^5 N_A) 1e14)^(1/6), from the exact N_A, and Lakowicz's 0.211 Angstrom.

var FLUOR_ALL  = 0;
var FLUOR_DOWN = 1;

# fluor_gaussian_band's kind: an emission spectrum, a density per nm with unit area, or an
# excitation or absorption spectrum, a profile with 1 at its peak.
var FLUOR_BAND_DENSITY = 0;
var FLUOR_BAND_PROFILE = 1;

# A re-radiation matrix on the grid start_nm + k step_nm, k = 0 .. n - 1: m holds n * n f64, row
# o (emitted wavelength) by column i (incident), M[o][i] at m + (o n + i) 8.
#derive(accessors)
struct Donaldson { start_nm; step_nm; n; m; }

var _FLU_MAX_N   = 2048;                  # a matrix side: 2048^2 f64 is 32 MiB
var _FLU_MAX_LEN = 268435456;             # an Spd's samples: 2^31 bytes of f64, as spectral_cie
var _FLU_PH_NM   = 0x4331E28099C42BB5;    # 1e-9/(h c): photons per joule per nm of wavelength
var _FLU_EV_CM1  = 0x3F20403827ACF2E4;    # h c 100/e: eV per cm^-1 (1/8065.5439...)
var _FLU_FORSTER = 0x3DD825FB7D851F47;    # 9000 ln 10/(128 pi^5 N_A) 1e14: nm^6 per M^-1 cm^-1 nm^4
var _FLU_FWHM    = 0x4002D6ABE44AFC43;    # 2 sqrt(2 ln 2): a Gaussian's FWHM over its sigma
var _FLU_RT2PI   = 0x3FD9884533D43651;    # 1/sqrt(2 pi)
var _FLU_LN10    = 0x40026BB1BBB55516;    # ln 10
var _FLU_SUM_TOL = 0x3E112E0BE826D695;    # 1e-9: how far R + a may exceed 1 in a Donaldson input

# 1 if x is finite (not NaN, not +-inf).
fn _flu_finite(x) {
    if ((x & _PRK_ABS) >= _PRK_INF) { return 0; }
    return 1;
}

# 1 if x is finite and strictly positive. f64_gt is false for NaN.
fn _flu_pos(x) {
    if (f64_gt(x, 0) == 0) { return 0; }
    if (x == _PRK_INF) { return 0; }
    return 1;
}

# 1 if x is finite and in [lo, hi].
fn _flu_in(x, lo, hi) {
    if (_flu_finite(x) == 0) { return 0; }
    if (f64_lt(x, lo) == 1) { return 0; }
    if (f64_gt(x, hi) == 1) { return 0; }
    return 1;
}

# Wavelength of sample k of s.
fn _flu_wl(s, k) { return f64_add(Spd_start_nm(s), f64_mul(f64_from(k), Spd_step_nm(s))); }

# 1 if s is a usable spectrum: non-null with a values buffer, 1 to 2^28 samples, and every sample
# wavelength finite and positive (a finite positive first wavelength and step, and a finite
# last one). spd_at reads through the values buffer, so an Spd without one is refused here
# rather than dereferenced.
fn _flu_spd_ok(s) {
    if (s == 0) { return 0; }
    if ((Spd_len(s) < 1) | (Spd_len(s) > _FLU_MAX_LEN)) { return 0; }
    if (Spd_values(s) == 0) { return 0; }
    if ((_flu_pos(Spd_start_nm(s)) & _flu_pos(Spd_step_nm(s))) == 0) { return 0; }
    return _flu_finite(_flu_wl(s, Spd_len(s) - 1));
}

# x, with -0 made +0: a zero is reported as +0, whatever sign the arithmetic gave it.
fn _flu_pz(x) {
    if ((x & _PRK_ABS) == 0) { return 0; }
    return x;
}

# ── Photons and energy ────────

# A copy of s with every sample multiplied by f(lambda) = lambda k, or divided by it when inv is
# 1. 0 with an error code on an unusable spectrum or failed allocation.
fn _flu_scale(s, k, inv, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_flu_spd_ok(s) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var len = Spd_len(s);
    var v = alloc(len * 8);
    if (v == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    var src = Spd_values(s);
    for (var i = 0; i < len; i = i + 1) {
        var f = f64_mul(_flu_wl(s, i), k);
        var x = load64(src + i * 8);
        if (inv == 1) { store64(v + i * 8, f64_div(x, f)); } else { store64(v + i * 8, f64_mul(x, f)); }
    }
    var out = spd_new(Spd_start_nm(s), Spd_step_nm(s), v, len);
    if (out == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return out;
}

# The spectrum s, in watts per nm, as photons per second per nm: each sample times
# lambda 1e-9/(h c), with the CODATA 2018 h and c, which are exact. A new Spd on the same grid.
# Writes PK_ERR_INVALID_PARAMETER for a null or empty Spd, more than 2^28 samples, or a first
# wavelength or step that is not finite and positive; PK_ERR_ALLOCATION if memory runs out.
# Returns 0 on any of them.
#must_use
fn spd_energy_to_photons(s, err_out) { return _flu_scale(s, _FLU_PH_NM, 0, err_out); }

# The inverse of spd_energy_to_photons: photons per second per nm to watts per nm.
#must_use
fn spd_photons_to_energy(s, err_out) { return _flu_scale(s, _FLU_PH_NM, 1, err_out); }

# ── Bands and peaks ────────

# A band Gaussian in wavenumber, centred on 1e7/center_nm cm^-1 with a full width at half maximum
# of fwhm_cm1 cm^-1, sampled at n wavelengths from start_nm every step_nm. Electronic bands are
# near-Gaussian in energy, not in wavelength. kind is
# - FLUOR_BAND_DENSITY, an emission spectrum: a density per nm with unit area. Per nm it has its
#   long tail to the red and peaks BLUE of center_nm, since the density per nm is the one per
#   cm^-1 times 1e7/lambda^2 (a 490 nm band 2500 cm^-1 wide peaks at 487.38 nm per nm);
# - FLUOR_BAND_PROFILE, an excitation or absorption spectrum: exp(-(nu - nu0)^2/(2 sigma^2)), 1
#   at its peak, which is center_nm on either scale. Scale it to eps or absorptance.
# Writes PK_ERR_INVALID_PARAMETER unless center_nm, fwhm_cm1, start_nm and step_nm are finite
# and positive, the last wavelength is finite, n is in [2, 2^28] and kind is one of the two, or
# if the band's height overflows (a width of 1e-320); PK_ERR_ALLOCATION if memory runs out.
# Returns 0 on any of them.
#must_use
fn fluor_gaussian_band(center_nm, fwhm_cm1, start_nm, step_nm, n, kind, err_out) {
    store64(err_out, PK_ERR_NONE);
    _prk_trace("fluor_gaussian_band");
    var ok = _flu_pos(center_nm) & _flu_pos(fwhm_cm1) & _flu_pos(start_nm) & _flu_pos(step_nm);
    if ((ok == 0) | (n < 2) | (n > _FLU_MAX_LEN)) { ok = 0; }
    if ((kind != FLUOR_BAND_DENSITY) & (kind != FLUOR_BAND_PROFILE)) { ok = 0; }
    var nu0 = 0;
    var sigma = 0;
    var amp = F64_ONE;
    if (ok == 1) {
        if (_flu_finite(f64_add(start_nm, f64_mul(f64_from(n - 1), step_nm))) == 0) { ok = 0; }
        nu0 = f64_div(f64_from(10000000), center_nm);
        sigma = f64_div(fwhm_cm1, _FLU_FWHM);
        if (kind == FLUOR_BAND_DENSITY) { amp = f64_div(_FLU_RT2PI, sigma); }
        if ((_flu_pos(nu0) & _flu_pos(sigma) & _flu_pos(amp)) == 0) { ok = 0; }
    }
    if (ok == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var v = alloc(n * 8);
    if (v == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    for (var i = 0; i < n; i = i + 1) {
        var wl = f64_add(start_nm, f64_mul(f64_from(i), step_nm));
        var nu = f64_div(f64_from(10000000), wl);
        var z = f64_div(f64_sub(nu, nu0), sigma);
        var g = f64_mul(amp, _prk_exp(f64_mul(f64_neg(F64_HALF), f64_mul(z, z))));
        # a density per nm: |d nu/d lambda| = 1e7/lambda^2 = nu/lambda
        if (kind == FLUOR_BAND_DENSITY) { g = f64_mul(g, f64_div(nu, wl)); }
        store64(v + i * 8, g);
    }
    var s = spd_new(start_nm, step_nm, v, n);
    if (s == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return s;
}

# The vertex of the parabola through (x1, y1), (x2, y2), (x3, y3): the three points need not be
# evenly spaced. x2 if they are collinear.
fn _flu_vertex(x1, y1, x2, y2, x3, y3) {
    var a = f64_mul(f64_sub(x2, x1), f64_sub(y2, y3));
    var b = f64_mul(f64_sub(x2, x3), f64_sub(y2, y1));
    var den = f64_sub(a, b);
    if ((den & _PRK_ABS) == 0) { return x2; }
    var num = f64_sub(f64_mul(f64_sub(x2, x1), a), f64_mul(f64_sub(x2, x3), b));
    return f64_sub(x2, f64_mul(F64_HALF, f64_div(num, den)));
}

# Sample k of s as a density per nm (per_cm1 = 0) or per cm^-1 (1, times lambda^2/1e7).
fn _flu_density(s, k, per_cm1) {
    var y = load64(Spd_values(s) + k * 8);
    if (per_cm1 == 0) { return y; }
    var wl = _flu_wl(s, k);
    return f64_mul(y, f64_div(f64_mul(wl, wl), f64_from(10000000)));
}

# The wavenumber, 1e7/lambda in cm^-1, of sample k of s.
fn _flu_nu(s, k) { return f64_div(f64_from(10000000), _flu_wl(s, k)); }

# The wavenumber (cm^-1) of the peak of s as given (per_cm1 = 0) or as a density per cm^-1 (1).
# NaN for an unusable spectrum, fewer than 3 samples, a sample that is not finite, no positive
# sample, a maximum on the first or last sample, a maximum that two samples share, or a largest
# sample equal to a neighbour: a flat top, as a saturated detector gives, has no vertex to fit,
# and 2.15.0's review found the first cut returning the plateau's blue end per nm and its red
# end per cm^-1, 21 nm apart. The peak is the vertex of the parabola through the logarithms of
# the largest sample and its two neighbours, against wavenumber (unevenly spaced): exact for a
# band Gaussian in wavenumber, the shape electronic bands approach, where a parabola in
# wavelength misplaced it by 0.3 to 0.7% of a 5 nm step. Through the samples themselves when a
# neighbour is not positive. The vertex never leaves the two neighbours' interval.
fn _flu_peak(s, per_cm1) {
    if (_flu_spd_ok(s) == 0) { return _PRK_NAN; }
    var len = Spd_len(s);
    if (len < 3) { return _PRK_NAN; }
    var best = 0 - 1;
    var top = 0;
    var tie = 0;
    for (var k = 0; k < len; k = k + 1) {
        var y = _flu_density(s, k, per_cm1);
        if (_flu_finite(y) == 0) { return _PRK_NAN; }
        if (f64_gt(y, 0) == 1) {
            if ((best < 0) | (f64_gt(y, top) == 1)) {
                best = k;
                top = y;
                tie = 0;
            } else {
                if (f64_eq(y, top) == 1) { tie = 1; }
            }
        }
    }
    if ((best <= 0) | (best >= len - 1) | (tie == 1)) { return _PRK_NAN; }
    # A flat top, judged on the samples as recorded: per cm^-1 the weighting lambda^2 would
    # otherwise break a saturated plateau's tie toward its red end.
    var raw = Spd_values(s);
    var mid = load64(raw + best * 8);
    if ((f64_eq(load64(raw + (best - 1) * 8), mid) | f64_eq(load64(raw + (best + 1) * 8), mid)) == 1) {
        return _PRK_NAN;
    }
    var x1 = _flu_nu(s, best - 1);
    var x2 = _flu_nu(s, best);
    var x3 = _flu_nu(s, best + 1);
    var y1 = _flu_density(s, best - 1, per_cm1);
    var y2 = _flu_density(s, best, per_cm1);
    var y3 = _flu_density(s, best + 1, per_cm1);
    if ((f64_gt(y1, 0) & f64_gt(y3, 0)) == 1) {
        return _flu_vertex(x1, f64_ln(y1), x2, f64_ln(y2), x3, f64_ln(y3));
    }
    return _flu_vertex(x1, y1, x2, y2, x3, y3);
}

# Wavelength (nm) of the maximum of s as recorded, per nm, placed between samples as _flu_peak
# describes. For a profile Gaussian in wavenumber (an absorption band) it is exact. For a density
# Gaussian in wavenumber (an emission band) it is within 4e-4 of a step of the true maximum, over
# centres of 250 to 1200 nm, widths of 1000 to 6000 cm^-1 and steps of 0.5 to 10 nm with at least
# three samples per width (0.004 nm at 10 nm steps): the logarithm of that density is the
# Gaussian plus 2 ln(nu), whose curvature the parabola cannot see. NaN for an Spd that is not
# usable (as spd_energy_to_photons), fewer than 3 samples, a sample that is not finite, no
# positive sample, or a maximum on the first or last sample, shared by two samples, or equal to a
# neighbour.
#must_use
fn fluor_peak_nm(s) { return f64_div(f64_from(10000000), _flu_peak(s, 0)); }

# Wavenumber (cm^-1) of the maximum of s as a DENSITY per cm^-1, lambda^2/1e7 times the density
# per nm, located as fluor_peak_nm locates its peak: for an emission spectrum. For a density
# Gaussian in wavenumber this is its centre, to rounding. An excitation or absorption spectrum is
# not a density: its peak in cm^-1 is 1e7/fluor_peak_nm. NaN as fluor_peak_nm.
#must_use
fn fluor_peak_cm1(s) { return _flu_peak(s, 1); }

# ── Stokes shift ────────

# The Stokes shift in nm: fluor_peak_nm(emission) - fluor_peak_nm(excitation). NaN when either
# peak is.
#must_use
fn fluor_stokes_shift_nm(excitation, emission) {
    return f64_sub(fluor_peak_nm(emission), fluor_peak_nm(excitation));
}

# The Stokes shift in cm^-1, the energy the molecule loses between absorbing and emitting:
# 1e7/fluor_peak_nm(excitation) - fluor_peak_cm1(emission). The excitation spectrum is a response
# per photon and peaks at one point on either scale; the emission is a density and is taken per
# cm^-1, best in photons (see the section header). NaN when either peak is.
#must_use
fn fluor_stokes_shift_cm1(excitation, emission) {
    return f64_sub(f64_div(f64_from(10000000), fluor_peak_nm(excitation)), fluor_peak_cm1(emission));
}

# The Stokes shift in eV: fluor_stokes_shift_cm1 times h c 100/e (1 eV = 8065.544 cm^-1).
#must_use
fn fluor_stokes_shift_ev(excitation, emission) {
    return f64_mul(fluor_stokes_shift_cm1(excitation, emission), _FLU_EV_CM1);
}

# ── Quantum yield ────────

# 1 - e^-x for finite x >= 0, without the cancellation 1 - exp(-x) suffers at small x: its Taylor
# series below 1, where the first omitted of 20 terms is under 1e-19 of the sum. (2.15.0's review
# found the first cut, switching at 2^-5, 7 ulp out just above the switch: 1 - exp(-x) loses
# about 1/x ulp there.)
fn _flu_one_minus_exp(x) {
    if (f64_lt(x, F64_ONE) == 1) {
        var term = x;
        var sum = x;
        for (var k = 2; k < 22; k = k + 1) {
            term = f64_div(f64_mul(term, f64_neg(x)), f64_from(k));
            sum = f64_add(sum, term);
        }
        return _flu_pz(sum);
    }
    return f64_sub(F64_ONE, _prk_exp(f64_neg(x)));
}

# The fraction of light absorbed by a sample of decadic absorbance `absorbance`: 1 - 10^-A,
# accurate to the last digits at small A, where it tends to A ln 10. NaN unless A is finite and
# non-negative.
#must_use
fn fluor_absorptance(absorbance) {
    if (_flu_finite(absorbance) == 0) { return _PRK_NAN; }
    if (f64_lt(absorbance, 0) == 1) { return _PRK_NAN; }
    return _flu_one_minus_exp(f64_mul(absorbance, _FLU_LN10));
}

# Quantum yield from the radiative and non-radiative decay rates: k_r/(k_r + k_nr), also the
# lifetime over the radiative lifetime. NaN unless both are finite and non-negative with a
# positive sum.
#must_use
fn fluor_quantum_yield_rates(k_r, k_nr) {
    if ((_flu_finite(k_r) & _flu_finite(k_nr)) == 0) { return _PRK_NAN; }
    if ((f64_lt(k_r, 0) | f64_lt(k_nr, 0)) == 1) { return _PRK_NAN; }
    var sum = f64_add(k_r, k_nr);
    if (_flu_pos(sum) == 0) { return _PRK_NAN; }
    return _flu_pz(f64_div(k_r, sum));
}

# Quantum yield by the comparative method against a standard of known yield phi_ref (IUPAC,
# Brouwer, Pure Appl. Chem. 83, 2213 (2011)):
#   Phi = phi_ref (F/F_ref) (f_ref/f) (n/n_ref)^2,   f = 1 - 10^-A,
# with F the integrated emission in photons, A the decadic absorbance at the excitation
# wavelength and n the solvent's refractive index, which sets how much of the emission leaves
# the cuvette toward the detector. f is the fraction absorbed; the usual A_ref/A is its limit for
# dilute samples. ⚠ f corrects the absorbed fraction and nothing else: the method still needs
# dilute solutions, A < 0.1, since denser ones reabsorb their emission and are excited unevenly
# (inner-filter effects), which no formula here undoes. (The first cut said f made it hold at any
# absorbance; the review checked Brouwer's text.) A result above 1 is returned as computed: it
# says the measurements disagree. NaN unless phi_ref is in (0, 1], both F are finite and
# non-negative with F_ref > 0, both A finite and positive, and both n finite and positive.
#must_use
fn fluor_quantum_yield_relative(phi_ref, f_sample, f_ref, a_sample, a_ref, n_sample, n_ref) {
    if (_flu_in(phi_ref, 0, F64_ONE) == 0) { return _PRK_NAN; }
    if ((phi_ref & _PRK_ABS) == 0) { return _PRK_NAN; }
    if (_flu_in(f_sample, 0, _PRK_INF) == 0) { return _PRK_NAN; }
    if ((_flu_pos(f_ref) & _flu_pos(a_sample) & _flu_pos(a_ref) & _flu_pos(n_sample) & _flu_pos(n_ref)) == 0) {
        return _PRK_NAN;
    }
    var ratio_n = f64_div(n_sample, n_ref);
    var absorbed = f64_div(fluor_absorptance(a_ref), fluor_absorptance(a_sample));
    var phi = f64_mul(f64_mul(phi_ref, f64_div(f_sample, f_ref)), f64_mul(absorbed, f64_mul(ratio_n, ratio_n)));
    if (_flu_finite(phi) == 0) { return _PRK_NAN; }
    return _flu_pz(phi);
}

# ── The Donaldson matrix ────────

# The re-radiation (Donaldson) matrix of a fluorescent surface on the grid start_nm + k step_nm,
# k = 0 .. n - 1 (see the section header): reflectance is the surface's own reflectance R and
# absorptance the fraction a absorbed into the fluorescent band, both in [0, 1] with
# R + a <= 1; emission is the emission spectrum as power, any scale; quantum_yield is Phi;
# mode is FLUOR_ALL or FLUOR_DOWN. R and a are read on the grid with spd_at, so outside their
# own range they read 0; the emission is read the same way and normalised over its own samples.
# Writes PK_ERR_INVALID_PARAMETER for a reflectance, absorptance or emission Spd that is not
# usable (as spd_energy_to_photons: a null handle or values buffer, no samples, a wavelength
# that is not finite and positive), a reflectance or absorptance outside [0, 1] or summing past
# 1 (by more than 1e-9) at a grid point, an emission sample that is negative or not finite, an
# emission that sums to 0, quantum_yield outside [0, 1], start_nm or step_nm not finite and
# positive or a last wavelength that is not finite, n outside [1, 2048], another mode, or an
# entry that would overflow; PK_ERR_ALLOCATION if memory runs out. Returns 0 on any of them.
# Every input is checked before the n^2 matrix is allocated, so a refusal costs no memory.
#must_use
fn fluor_donaldson(reflectance, absorptance, emission, quantum_yield, start_nm, step_nm, n, mode, err_out) {
    store64(err_out, PK_ERR_NONE);
    _prk_trace("fluor_donaldson");
    var ok = _flu_spd_ok(reflectance) & _flu_spd_ok(absorptance) & _flu_spd_ok(emission);
    if ((_flu_in(quantum_yield, 0, F64_ONE) & _flu_pos(start_nm) & _flu_pos(step_nm)) == 0) { ok = 0; }
    if ((n < 1) | (n > _FLU_MAX_N) | ((mode != FLUOR_ALL) & (mode != FLUOR_DOWN))) { ok = 0; }
    if (ok == 1) {
        if (_flu_finite(f64_add(start_nm, f64_mul(f64_from(n - 1), step_nm))) == 0) { ok = 0; }
    }
    if (ok == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # W = sum E_k lambda_k step over the emission's own samples: its photon count, to a constant.
    var w = 0;
    var ev = Spd_values(emission);
    for (var k = 0; k < Spd_len(emission); k = k + 1) {
        var e = load64(ev + k * 8);
        if (_flu_in(e, 0, _PRK_INF) == 0) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        w = f64_add(w, f64_mul(e, _flu_wl(emission, k)));
    }
    w = f64_mul(w, Spd_step_nm(emission));
    if (_flu_pos(w) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # R and a on the grid, and the largest emission sample there: all before any allocation.
    var emax = 0;
    for (var i = 0; i < n; i = i + 1) {
        var wi = f64_add(start_nm, f64_mul(f64_from(i), step_nm));
        var r = spd_at(reflectance, wi);
        var a = spd_at(absorptance, wi);
        ok = _flu_in(r, 0, F64_ONE) & _flu_in(a, 0, F64_ONE);
        if (ok == 1) {
            if (f64_gt(f64_add(r, a), f64_add(F64_ONE, _FLU_SUM_TOL)) == 1) { ok = 0; }
        }
        if (ok == 0) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        var eo = spd_at(emission, wi);
        if (f64_gt(eo, emax) == 1) { emax = eo; }
    }
    # The largest entry is at most Phi lambda_max emax step/W, plus 1.
    var lmax = f64_add(start_nm, f64_mul(f64_from(n - 1), step_nm));
    if (_flu_finite(f64_mul(f64_mul(quantum_yield, lmax), f64_div(f64_mul(emax, step_nm), w))) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var m = alloc(n * n * 8);
    if (m == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    # Column 0 holds the emission on the grid, E(lambda_o) step/W, until column 0 itself is
    # written last: no scratch buffer, which the bump allocator would never give back.
    for (var o = 0; o < n; o = o + 1) {
        var wo = f64_add(start_nm, f64_mul(f64_from(o), step_nm));
        store64(m + o * n * 8, f64_div(f64_mul(spd_at(emission, wo), step_nm), w));
    }
    for (var i2 = n - 1; i2 >= 0; i2 = i2 - 1) {
        var wi2 = f64_add(start_nm, f64_mul(f64_from(i2), step_nm));
        var ci = f64_mul(f64_mul(quantum_yield, spd_at(absorptance, wi2)), wi2);
        for (var o2 = 0; o2 < n; o2 = o2 + 1) {
            var lum = f64_mul(ci, load64(m + o2 * n * 8));
            if ((mode == FLUOR_DOWN) & (o2 < i2)) { lum = 0; }
            if (o2 == i2) { lum = f64_add(lum, spd_at(reflectance, wi2)); }
            store64(m + (o2 * n + i2) * 8, lum);
        }
    }
    var d = alloc(sizeof(Donaldson));
    if (d == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    Donaldson_set_start_nm(d, start_nm);
    Donaldson_set_step_nm(d, step_nm);
    Donaldson_set_n(d, n);
    Donaldson_set_m(d, m);
    return d;
}

# M[out_index][in_index] of a Donaldson matrix: radiance emitted at the out_index'th grid
# wavelength per unit radiance incident at the in_index'th. NaN for a null matrix or an index
# outside [0, n).
#must_use
fn fluor_donaldson_at(d, out_index, in_index) {
    if (d == 0) { return _PRK_NAN; }
    var n = Donaldson_n(d);
    if ((out_index < 0) | (out_index >= n) | (in_index < 0) | (in_index >= n)) { return _PRK_NAN; }
    return load64(Donaldson_m(d) + (out_index * n + in_index) * 8);
}

# The radiance a surface with re-radiation matrix d returns under the incident spectrum
# `incident`, read on d's grid with spd_at: out(lambda_o) = sum_i M[o][i] in(lambda_i). A new
# Spd on d's grid, reflected and fluorescent light together. Writes PK_ERR_INVALID_PARAMETER
# for a null matrix, an incident Spd that is not usable (as spd_energy_to_photons), or a result
# that overflows; PK_ERR_ALLOCATION if memory runs out. Returns 0 on any of them.
#must_use
fn fluor_donaldson_apply(d, incident, err_out) {
    store64(err_out, PK_ERR_NONE);
    if ((d == 0) | (_flu_spd_ok(incident) == 0)) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var n = Donaldson_n(d);
    var start = Donaldson_start_nm(d);
    var step = Donaldson_step_nm(d);
    var m = Donaldson_m(d);
    var v = alloc(n * 8);
    if (v == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    for (var o = 0; o < n; o = o + 1) { store64(v + o * 8, 0); }
    # Column by column, each incident sample read once and no scratch buffer kept; every output
    # still sums over i in increasing order.
    for (var i = 0; i < n; i = i + 1) {
        var x = spd_at(incident, f64_add(start, f64_mul(f64_from(i), step)));
        for (var o2 = 0; o2 < n; o2 = o2 + 1) {
            store64(v + o2 * 8, f64_add(load64(v + o2 * 8), f64_mul(load64(m + (o2 * n + i) * 8), x)));
        }
    }
    for (var o3 = 0; o3 < n; o3 = o3 + 1) {
        if (_flu_finite(load64(v + o3 * 8)) == 0) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
    }
    var s = spd_new(start, step, v, n);
    if (s == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return s;
}

# ── Forster resonance energy transfer ────────

# x^(1/6) for x >= 0.
fn _flu_root6(x) { return f64_sqrt(ganita_f64_cbrt(x)); }

# FRET efficiency at donor-acceptor distance r for a Forster radius r0 (any one unit):
# 1/(1 + (r/r0)^6), 1/2 at r = r0. NaN unless r is finite and non-negative and r0 finite and
# positive.
#must_use
fn fret_efficiency(r, r0) {
    if ((_flu_in(r, 0, _PRK_INF) & _flu_pos(r0)) == 0) { return _PRK_NAN; }
    var x = f64_div(r, r0);
    var x2 = f64_mul(x, x);
    return _flu_pz(f64_div(F64_ONE, f64_add(F64_ONE, f64_mul(x2, f64_mul(x2, x2)))));
}

# The distance at which transfer is `efficiency` efficient: r0 ((1 - E)/E)^(1/6), the inverse
# of fret_efficiency; 0 at E = 1. NaN unless E is in (0, 1] and r0 finite and positive, or if the
# distance overflows (E = 5e-324 puts it past 1e53 r0, and 1/E is infinite).
#must_use
fn fret_distance(efficiency, r0) {
    if ((_flu_in(efficiency, 0, F64_ONE) & _flu_pos(r0)) == 0) { return _PRK_NAN; }
    # E = 0 lands here too: 1/E is infinite.
    var r = f64_mul(r0, _flu_root6(f64_div(f64_sub(F64_ONE, efficiency), efficiency)));
    if (_flu_finite(r) == 0) { return _PRK_NAN; }
    return _flu_pz(r);
}

# FRET efficiency from the donor's lifetime with the acceptor, tau_da, and without, tau_d:
# 1 - tau_da/tau_d. NaN unless tau_d is finite and positive and tau_da in [0, tau_d]: a donor
# that lives longer beside the acceptor has no transfer to measure.
#must_use
fn fret_efficiency_lifetimes(tau_da, tau_d) {
    if (_flu_pos(tau_d) == 0) { return _PRK_NAN; }
    if (_flu_in(tau_da, 0, tau_d) == 0) { return _PRK_NAN; }
    return f64_sub(F64_ONE, f64_div(tau_da, tau_d));
}

# The transfer rate k_T = (1/tau_d)(r0/r)^6, in the inverse of tau_d's unit. NaN unless r, r0 and
# tau_d are finite and positive, or if the rate overflows.
#must_use
fn fret_rate(r, r0, tau_d) {
    if ((_flu_pos(r) & _flu_pos(r0) & _flu_pos(tau_d)) == 0) { return _PRK_NAN; }
    var x = f64_div(r0, r);
    var x2 = f64_mul(x, x);
    # x^2 (x^2 (x^2/tau)): dividing first keeps (1e60)^6/1e300 = 1e60 from overflowing on the way.
    var k = f64_mul(x2, f64_mul(x2, f64_div(x2, tau_d)));
    if (_flu_finite(k) == 0) { return _PRK_NAN; }
    return _flu_pz(k);
}

# The Forster radius in nm: (C kappa^2 Phi_D J/n^4)^(1/6), C = 9000 ln 10/(128 pi^5 N_A) 1e14
# = 8.7851e-11 (see the section header), for orientation factor kappa2 (2/3 for freely rotating
# dipoles), donor quantum yield phi_d, refractive index n of the medium between them and overlap
# integral J in M^-1 cm^-1 nm^4 (fret_overlap_integral). NaN unless kappa2 is in [0, 4], phi_d in
# [0, 1], n finite and positive and J finite and non-negative.
#must_use
fn fret_forster_radius(kappa2, phi_d, n, overlap) {
    if ((_flu_in(kappa2, 0, f64_from(4)) & _flu_in(phi_d, 0, F64_ONE)) == 0) { return _PRK_NAN; }
    if ((_flu_pos(n) & _flu_in(overlap, 0, _PRK_INF)) == 0) { return _PRK_NAN; }
    var n2 = f64_mul(n, n);
    var r6 = f64_div(f64_mul(f64_mul(_FLU_FORSTER, kappa2), f64_mul(phi_d, overlap)), f64_mul(n2, n2));
    if (_flu_finite(r6) == 0) { return _PRK_NAN; }
    return _flu_pz(_flu_root6(r6));
}

# The spectral overlap integral J = sum F_k eps(lambda_k) lambda_k^4 / sum F_k over the donor's
# samples, in M^-1 cm^-1 nm^4: donor_photons is the donor's emission IN PHOTONS per nm (any scale;
# spd_energy_to_photons converts a power spectrum), acceptor_epsilon the acceptor's molar decadic
# absorption coefficient in M^-1 cm^-1, read at the donor's wavelengths with spd_at (0 outside
# its range). NaN for a donor or acceptor Spd that is not usable (as spd_energy_to_photons), a
# donor sample or an acceptor value that is negative or not finite, or a donor that sums to 0.
#must_use
fn fret_overlap_integral(donor_photons, acceptor_epsilon) {
    if ((_flu_spd_ok(donor_photons) & _flu_spd_ok(acceptor_epsilon)) == 0) { return _PRK_NAN; }
    var num = 0;
    var den = 0;
    var v = Spd_values(donor_photons);
    for (var k = 0; k < Spd_len(donor_photons); k = k + 1) {
        var f = load64(v + k * 8);
        var wl = _flu_wl(donor_photons, k);
        var eps = spd_at(acceptor_epsilon, wl);
        if ((_flu_in(f, 0, _PRK_INF) & _flu_in(eps, 0, _PRK_INF)) == 0) { return _PRK_NAN; }
        var w2 = f64_mul(wl, wl);
        num = f64_add(num, f64_mul(f64_mul(f, eps), f64_mul(w2, w2)));
        den = f64_add(den, f);
    }
    if (_flu_pos(den) == 0) { return _PRK_NAN; }
    var j = f64_div(num, den);
    if (_flu_finite(j) == 0) { return _PRK_NAN; }
    return _flu_pz(j);
}

# --- wave_core.cyr ---

# wave_core.cyr -- wave optics core: interference, diffraction, polarization
# Usage: include "lib/wave_core.cyr"  (requires error.cyr)
#
# Ported from the Rust `wave/mod.rs`. StokesVector (defined in the Rust
# `wave/polarization.rs`) is placed here because the Jones->Stokes conversion and
# its tests live in mod.rs; wave_polarization.cyr adds the Mueller/Jones matrices
# on top of this struct. Rust `.round()` is half-away-from-zero (Cyrius f64_round
# is banker's), so _wave_round is used for the interference conditions.

fn _wave_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }
# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(10000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3DDB7CDFD9D7BDBB is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _wave_eps10() { return 0x3DDB7CDFD9D7BDBB; }

# Round half away from zero (matches Rust f64::round).
fn _wave_round(x) {
    if (f64_ge(x, f64_from(0)) == 1) {
        return f64_floor(f64_add(x, F64_HALF));
    }
    return f64_ceil(f64_sub(x, F64_HALF));
}

# ── Interference ────────

# Two-wave interference intensity: A1^2 + A2^2 + 2*A1*A2*cos(delta).
#must_use
fn interference_intensity(a1, a2, phase_diff) {
    return f64_add(f64_add(f64_mul(a1, a1), f64_mul(a2, a2)),
      f64_mul(f64_mul(f64_mul(F64_TWO, a1), a2), _prk_cos(phase_diff)));
}

# 1 if constructive (path difference is ~ an integer multiple of wavelength).
#must_use
fn is_constructive(path_diff, wavelength) {
    var m = f64_div(path_diff, wavelength);
    return f64_lt(f64_abs(f64_sub(m, _wave_round(m))), _wave_r(1, 100));
}

# 1 if destructive (path difference is ~ a half-integer multiple of wavelength).
#must_use
fn is_destructive(path_diff, wavelength) {
    var m = f64_sub(f64_div(path_diff, wavelength), F64_HALF);
    return f64_lt(f64_abs(f64_sub(m, _wave_round(m))), _wave_r(1, 100));
}

# Phase difference from path difference: delta = 2*pi*path/lambda.
#must_use
fn path_to_phase(wavelength, path_diff) {
    return f64_div(f64_mul(F64_TAU, path_diff), wavelength);
}

# ── Thin film interference ────────

# Normalised reflected intensity of a thin film in a medium of lower index (a soap film or an oil
# film in air) near normal incidence: two equal beams, the one from the top face shifted by pi,
# so sin^2(2 pi n d/lambda). 0 for a vanishing film (black), 1 at a quarter wave (Hecht 9.4.1).
# ⛔ 2.15.1: this added the pi to the phase and then took sin^2 of half of it, counting the pi
# twice. It returned cos^2(2 pi n d/lambda), 1 minus the answer: a vanishing film was at its
# brightest. A film with a pi shift at both faces (an AR coating) is coating_reflectance's case.
#must_use
fn thin_film_reflectance(wavelength_nm, thickness_nm, n_film) {
    var s = _prk_sin(f64_div(f64_mul(F64_TAU, f64_mul(n_film, thickness_nm)), wavelength_nm));
    return f64_mul(s, s);
}

# ── Diffraction ────────

# Single-slit diffraction: I0 * (sin(beta)/beta)^2, beta = pi*a*sin(theta)/lambda.
#must_use
fn single_slit_intensity(wavelength, slit_width, angle, i0) {
    var beta = f64_div(f64_mul(f64_mul(F64_PI, slit_width), _prk_sin(angle)), wavelength);
    if (f64_lt(f64_abs(beta), _wave_eps10()) == 1) {
        return i0;
    }
    var sinc = f64_div(_prk_sin(beta), beta);
    return f64_mul(f64_mul(i0, sinc), sinc);
}

# Double-slit diffraction: single-slit envelope * two-slit interference * 4.
#must_use
fn double_slit_intensity(wavelength, slit_width, slit_spacing, angle, i0) {
    var sin_angle = _prk_sin(angle);
    var beta = f64_div(f64_mul(f64_mul(F64_PI, slit_width), sin_angle), wavelength);
    var envelope = F64_ONE;
    if (f64_lt(f64_abs(beta), _wave_eps10()) == 0) {
        var sinc = f64_div(_prk_sin(beta), beta);
        envelope = f64_mul(sinc, sinc);
    }
    var delta = f64_div(f64_mul(f64_mul(F64_PI, slit_spacing), sin_angle), wavelength);
    var cos_delta = _prk_cos(delta);
    var interference = f64_mul(cos_delta, cos_delta);
    return f64_mul(f64_mul(f64_mul(i0, envelope), interference), f64_from(4));
}

# Diffraction-grating maxima angles (m = 0, +-1, ... up to max_order) as a `vec`; 0 if the vec
# cannot be allocated. |m lambda/d| only grows with m, so the search stops at the first order
# that does not propagate: 2.15.1 found it running every order to max_order, hours for 2^40.
#must_use
fn grating_maxima(wavelength, grating_spacing, max_order) {
    var angles = vec_new();
    if (angles == 0) { return 0; }
    var m = 0;
    while (m <= max_order) {
        var sin_theta = f64_div(f64_mul(f64_from(m), wavelength), grating_spacing);
        if (f64_le(f64_abs(sin_theta), F64_ONE) == 0) { return angles; }
        var angle = ganita_f64_asin(sin_theta);
        vec_push(angles, angle);
        if (m != 0) {
            vec_push(angles, f64_neg(angle));
        }
        m = m + 1;
    }
    return angles;
}

# ── Polarization ────────

# Jones-style polarization state: horizontal/vertical amplitudes + phase.
#derive(accessors)
struct Polarization { ex; ey; phase; }

# Polarization {ex, ey: field amplitudes; phase: ey relative to ex, radians};
# 0 on allocation failure. The Jones vector is (e_x, e_y e^(i phase)), so
#   S1 = e_x^2 - e_y^2,  S2 = 2 e_x e_y cos(phase),  S3 = 2 e_x e_y sin(phase),
# and phase = +pi/2 with e_x = e_y is S3 = +1, right-circular in the Stokes convention
# wave_polarization uses. polarization_through_polarizer reads the phase the same way.
#must_use
fn polarization_new(ex, ey, phase) {
    var p = alloc(sizeof(Polarization));
    if (p == 0) { return 0; }
    Polarization_set_ex(p, ex);
    Polarization_set_ey(p, ey);
    Polarization_set_phase(p, phase);
    return p;
}

# Linear horizontal: ex = 1, ey = 0.
#must_use
fn polarization_horizontal() { return polarization_new(F64_ONE, f64_from(0), f64_from(0)); }
# Linear vertical: ex = 0, ey = 1.
#must_use
fn polarization_vertical() { return polarization_new(f64_from(0), F64_ONE, f64_from(0)); }
# ⛔ 2.4.8 — BREAKING, AND IT IS A REPAIR OF A CONTRADICTION, NOT A CHANGE OF MIND.
# These two phases were the wrong way round, so prakash exported TWO public
# "right circular" constructors that disagreed about the same named state on the
# same StokesVector type. Measured before:
#   polarization_to_stokes(polarization_circular_right())  ->  S3 = -1
#   stokes_circular_right(1)                               ->  S3 = +1
# and left-circular was the mirror pair. `wave_polarization` is the one that was
# right: the Stokes convention is universally **S3 > 0 = right-circular**, and this
# library's own Mueller machinery agrees with it — mueller_quarter_wave_horizontal()
# applied to stokes_diagonal_plus(1) yields S3 = -1, the state that convention calls
# LEFT, which is what stokes_circular_left reports. So the Jones constructors here
# were the outlier and they move, not the Stokes ones.
# ⚠ NEITHER SUITE COULD SEE IT: tests/wave_core.tcyr pinned S3 = -1 for "right" and
# tests/wave_polarization.tcyr pinned S3 = +1 for "right", each self-consistent, and
# all 31 suites were green. The cross-module assertion that now binds them is in
# tests/wave_core.tcyr. A consumer reading circular handedness from wave_core gets
# the opposite sign from 2.4.8 on.
# Right-circular: ex = ey = 1/sqrt(2), phase = +pi/2 (S3 = +1).
#must_use
fn polarization_circular_right() {
    return polarization_new(F64_FRAC_1_SQRT2, F64_FRAC_1_SQRT2, F64_PI_2);
}
# Left-circular: ex = ey = 1/sqrt(2), phase = -pi/2 (S3 = -1).
#must_use
fn polarization_circular_left() {
    return polarization_new(F64_FRAC_1_SQRT2, F64_FRAC_1_SQRT2, f64_neg(F64_PI_2));
}

# Intensity after a linear polarizer at angle theta from x (Jones):
#   |e_x cos(theta) + e_y e^(i phase) sin(theta)|^2
#     = e_x^2 cos^2(theta) + e_y^2 sin^2(theta) + 2 e_x e_y sin(theta) cos(theta) cos(phase),
# Malus's law for linear light (phase 0). ⛔ 2.15.1: this applied Malus to the angle
# atan2(e_y, e_x) and ignored the phase, so circular light passed whole at 45 degrees (1, not
# 1/2) and linear light at -45 degrees (phase pi) passed whole through a polarizer at +45.
# NaN for a null state (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn polarization_through_polarizer(p, polarizer_angle) {
    if (p == 0) { return _PRK_NAN; }
    var ex = Polarization_ex(p);
    var ey = Polarization_ey(p);
    var c = _prk_cos(polarizer_angle);
    var s = _prk_sin(polarizer_angle);
    var direct = f64_add(f64_mul(f64_mul(ex, ex), f64_mul(c, c)), f64_mul(f64_mul(ey, ey), f64_mul(s, s)));
    var cross = f64_mul(f64_mul(f64_mul(F64_TWO, ex), ey), f64_mul(f64_mul(s, c), _prk_cos(Polarization_phase(p))));
    return f64_add(direct, cross);
}

# Total intensity: ex^2 + ey^2.
# NaN for a null state (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn polarization_intensity(p) {
    if (p == 0) { return _PRK_NAN; }
    return f64_add(f64_mul(Polarization_ex(p), Polarization_ex(p)),
      f64_mul(Polarization_ey(p), Polarization_ey(p)));
}

# ── Stokes vector (shared with wave_polarization) ────────

#derive(accessors)
struct StokesVector { s0; s1; s2; s3; }

# Heap StokesVector {s0 = I, s1 = Q, s2 = U, s3 = V}; 0 on allocation failure.
#must_use
fn stokes_new(s0, s1, s2, s3) {
    var s = alloc(sizeof(StokesVector));
    if (s == 0) { return 0; }
    StokesVector_set_s0(s, s0);
    StokesVector_set_s1(s, s1);
    StokesVector_set_s2(s, s2);
    StokesVector_set_s3(s, s3);
    return s;
}

# Degree of polarization: sqrt(s1^2 + s2^2 + s3^2) / s0; 0 for zero intensity. A ratio, so the
# same at every scale: 2.15.1 found a 1e-15 threshold on s0 answering 0 for a fully polarized
# vector of intensity 1e-16.
# NaN for a null vector (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn stokes_degree_of_polarization(s) {
    if (s == 0) { return _PRK_NAN; }
    if ((StokesVector_s0(s) & _PRK_ABS) == 0) {
        return f64_from(0);
    }
    var pol = f64_sqrt(f64_add(f64_add(
          f64_mul(StokesVector_s1(s), StokesVector_s1(s)),
          f64_mul(StokesVector_s2(s), StokesVector_s2(s))),
        f64_mul(StokesVector_s3(s), StokesVector_s3(s))));
    return f64_div(pol, StokesVector_s0(s));
}

# Jones polarization -> Stokes vector.
#must_use
fn polarization_to_stokes(p) {
    if (p == 0) { return 0; }
    var ex = Polarization_ex(p);
    var ey = Polarization_ey(p);
    var phase = Polarization_phase(p);
    var ex2 = f64_mul(ex, ex);
    var ey2 = f64_mul(ey, ey);
    return stokes_new(
      f64_add(ex2, ey2),
      f64_sub(ex2, ey2),
      f64_mul(f64_mul(f64_mul(F64_TWO, ex), ey), _prk_cos(phase)),
      f64_mul(f64_mul(f64_mul(F64_TWO, ex), ey), _prk_sin(phase)));
}

# ── Malus's law ────────

# Intensity after a polarizer at angle theta: I0 * cos^2(theta).
#must_use
fn malus_law(intensity, angle) {
    var c = _prk_cos(angle);
    return f64_mul(intensity, f64_mul(c, c));
}

# --- wave_polarization.cyr ---

# wave_polarization.cyr -- Stokes constructors, Mueller matrices, birefringence
# Usage: include "lib/wave_polarization.cyr"  (requires error.cyr, wave_core.cyr)
#
# Ported from the Rust `wave/polarization.rs`. StokesVector (struct + new +
# degree_of_polarization) lives in wave_core.cyr; this module adds its
# constructors and angle helpers, plus MuellerMatrix and BirefringentMaterial.
# A Mueller matrix is a 128-byte buffer of 16 f64 in row-major order: element
# (i, j) at byte offset (i*4 + j)*8.

fn _wp_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }
# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _wp_eps15() { return 0x3CD203AF9EE75616; }

# ── Stokes vector constructors & angles ────────

# Unpolarised light of intensity I: (I, 0, 0, 0).
#must_use
fn stokes_unpolarized(intensity) { return stokes_new(intensity, f64_from(0), f64_from(0), f64_from(0)); }
# Horizontal linear polarisation: (I, I, 0, 0).
#must_use
fn stokes_horizontal(intensity) { return stokes_new(intensity, intensity, f64_from(0), f64_from(0)); }
# Vertical linear polarisation: (I, -I, 0, 0).
#must_use
fn stokes_vertical(intensity) { return stokes_new(intensity, f64_neg(intensity), f64_from(0), f64_from(0)); }
# +45 degree linear polarisation: (I, 0, I, 0).
#must_use
fn stokes_diagonal_plus(intensity) { return stokes_new(intensity, f64_from(0), intensity, f64_from(0)); }
# -45 degree linear polarisation: (I, 0, -I, 0).
#must_use
fn stokes_diagonal_minus(intensity) { return stokes_new(intensity, f64_from(0), f64_neg(intensity), f64_from(0)); }
# Right-circular polarisation: (I, 0, 0, I).
#must_use
fn stokes_circular_right(intensity) { return stokes_new(intensity, f64_from(0), f64_from(0), intensity); }
# Left-circular polarisation: (I, 0, 0, -I).
#must_use
fn stokes_circular_left(intensity) { return stokes_new(intensity, f64_from(0), f64_from(0), f64_neg(intensity)); }

# Total intensity (S0).
# NaN for a null vector (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn stokes_intensity(s) {
    if (s == 0) { return _PRK_NAN; }
    return StokesVector_s0(s);
}

# Ellipticity angle chi: 0.5 * atan2(S3, sqrt(S1^2 + S2^2)); 0 for a vector with no polarized
# part. An angle, so the same at every scale: 2.15.1 found a 1e-15 threshold answering 0 for a
# circular vector of intensity 1e-16.
# NaN for a null vector (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn stokes_ellipticity_angle(s) {
    if (s == 0) { return _PRK_NAN; }
    var s1 = StokesVector_s1(s);
    var s2 = StokesVector_s2(s);
    var s3 = StokesVector_s3(s);
    var linear_part = f64_sqrt(f64_add(f64_mul(s1, s1), f64_mul(s2, s2)));
    if (((linear_part | s3) & _PRK_ABS) == 0) {
        return f64_from(0);
    }
    return f64_mul(F64_HALF, ganita_f64_atan2(s3, linear_part));
}

# Orientation angle psi: 0.5 * atan2(S2, S1).
# NaN for a null vector (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn stokes_orientation_angle(s) {
    if (s == 0) { return _PRK_NAN; }
    return f64_mul(F64_HALF, ganita_f64_atan2(StokesVector_s2(s), StokesVector_s1(s)));
}

# ── Mueller matrices (4x4, row-major flat 16-f64 buffer) ────────

# Element accessors: (i, j) at offset (i*4 + j)*8. The buffer is exactly 128
# bytes (4x4 f64), so an index past 3 would read or write outside it — the Rust
# original used a checked [[f64; 4]; 4]. Out-of-range reads, and any read of a null matrix,
# return NaN (2.15.1: 0.0, which is also a legitimate element); out-of-range writes are refused
# with PK_ERR_INVALID_PARAMETER.
#must_use
fn mueller_get(m, i, j) {
    if (m == 0) { return _PRK_NAN; }
    if (i < 0) { return _PRK_NAN; }
    if (j < 0) { return _PRK_NAN; }
    if (i > 3) { return _PRK_NAN; }
    if (j > 3) { return _PRK_NAN; }
    return load64(m + (i * 4 + j) * 8);
}

# Write element (i, j). Returns PK_ERR_NONE on success, or
# PK_ERR_INVALID_PARAMETER for a null handle or an index outside 0..=3 — the
# write is refused rather than clamped, so a caller that ignores the code
# corrupts nothing. Not `#must_use`: this mutates and the return is a status,
# not a value the caller is expected to consume.
fn mueller_set(m, i, j, v) {
    if (m == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (i < 0) { return PK_ERR_INVALID_PARAMETER; }
    if (j < 0) { return PK_ERR_INVALID_PARAMETER; }
    if (i > 3) { return PK_ERR_INVALID_PARAMETER; }
    if (j > 3) { return PK_ERR_INVALID_PARAMETER; }
    store64(m + (i * 4 + j) * 8, v);
    return 0;
}

# Build a Mueller matrix from 16 row-major elements.
fn _mm(m00, m01, m02, m03, m10, m11, m12, m13, m20, m21, m22, m23, m30, m31, m32, m33) {
    var m = alloc(128);
    if (m == 0) { return 0; }
    store64(m + 0, m00);
    store64(m + 8, m01);
    store64(m + 16, m02);
    store64(m + 24, m03);
    store64(m + 32, m10);
    store64(m + 40, m11);
    store64(m + 48, m12);
    store64(m + 56, m13);
    store64(m + 64, m20);
    store64(m + 72, m21);
    store64(m + 80, m22);
    store64(m + 88, m23);
    store64(m + 96, m30);
    store64(m + 104, m31);
    store64(m + 112, m32);
    store64(m + 120, m33);
    return m;
}

# 4x4 identity Mueller matrix (no element).
#must_use
fn mueller_identity() {
    return _mm(
      F64_ONE, f64_from(0), f64_from(0), f64_from(0),
      f64_from(0), F64_ONE, f64_from(0), f64_from(0),
      f64_from(0), f64_from(0), F64_ONE, f64_from(0),
      f64_from(0), f64_from(0), f64_from(0), F64_ONE);
}

# Ideal linear polarizer, transmission axis horizontal (mueller_polarizer(0)).
#must_use
fn mueller_polarizer_horizontal() {
    return _mm(
      F64_HALF, F64_HALF, f64_from(0), f64_from(0),
      F64_HALF, F64_HALF, f64_from(0), f64_from(0),
      f64_from(0), f64_from(0), f64_from(0), f64_from(0),
      f64_from(0), f64_from(0), f64_from(0), f64_from(0));
}

# Ideal linear polarizer, transmission axis vertical (mueller_polarizer(pi/2)).
#must_use
fn mueller_polarizer_vertical() {
    return _mm(
      F64_HALF, f64_neg(F64_HALF), f64_from(0), f64_from(0),
      f64_neg(F64_HALF), F64_HALF, f64_from(0), f64_from(0),
      f64_from(0), f64_from(0), f64_from(0), f64_from(0),
      f64_from(0), f64_from(0), f64_from(0), f64_from(0));
}

# Linear polarizer at angle theta.
#must_use
fn mueller_polarizer(angle) {
    var two_a = f64_mul(F64_TWO, angle);
    var s2 = _prk_sin(two_a);
    var c2 = _prk_cos(two_a);
    var cs = f64_mul(c2, s2);
    return _mm(
      F64_HALF, f64_mul(F64_HALF, c2), f64_mul(F64_HALF, s2), f64_from(0),
      f64_mul(F64_HALF, c2), f64_mul(f64_mul(F64_HALF, c2), c2), f64_mul(F64_HALF, cs), f64_from(0),
      f64_mul(F64_HALF, s2), f64_mul(F64_HALF, cs), f64_mul(f64_mul(F64_HALF, s2), s2), f64_from(0),
      f64_from(0), f64_from(0), f64_from(0), f64_from(0));
}

# Quarter-wave plate, fast axis horizontal (mueller_retarder(pi/2)).
#must_use
fn mueller_quarter_wave_horizontal() {
    return _mm(
      F64_ONE, f64_from(0), f64_from(0), f64_from(0),
      f64_from(0), F64_ONE, f64_from(0), f64_from(0),
      f64_from(0), f64_from(0), f64_from(0), F64_ONE,
      f64_from(0), f64_from(0), f64_neg(F64_ONE), f64_from(0));
}

# Half-wave plate, fast axis horizontal (mueller_retarder(pi)): diag(1, 1, -1, -1).
#must_use
fn mueller_half_wave_horizontal() {
    return _mm(
      F64_ONE, f64_from(0), f64_from(0), f64_from(0),
      f64_from(0), F64_ONE, f64_from(0), f64_from(0),
      f64_from(0), f64_from(0), f64_neg(F64_ONE), f64_from(0),
      f64_from(0), f64_from(0), f64_from(0), f64_neg(F64_ONE));
}

# General linear retarder, fast axis horizontal, retardance delta.
#must_use
fn mueller_retarder(retardance) {
    var c = _prk_cos(retardance);
    var s = _prk_sin(retardance);
    return _mm(
      F64_ONE, f64_from(0), f64_from(0), f64_from(0),
      f64_from(0), F64_ONE, f64_from(0), f64_from(0),
      f64_from(0), f64_from(0), c, s,
      f64_from(0), f64_from(0), f64_neg(s), c);
}

# Reference-frame rotation by angle.
#must_use
fn mueller_rotation(angle) {
    var two_a = f64_mul(F64_TWO, angle);
    var s2 = _prk_sin(two_a);
    var c2 = _prk_cos(two_a);
    return _mm(
      F64_ONE, f64_from(0), f64_from(0), f64_from(0),
      f64_from(0), c2, s2, f64_from(0),
      f64_from(0), f64_neg(s2), c2, f64_from(0),
      f64_from(0), f64_from(0), f64_from(0), F64_ONE);
}

# Row i of m dotted with the 4-vector [v0,v1,v2,v3].
fn _mm_row_dot(m, i, v0, v1, v2, v3) {
    return f64_add(f64_add(f64_add(
          f64_mul(mueller_get(m, i, 0), v0),
          f64_mul(mueller_get(m, i, 1), v1)),
        f64_mul(mueller_get(m, i, 2), v2)),
      f64_mul(mueller_get(m, i, 3), v3));
}

# Apply a Mueller matrix to a Stokes vector.
#must_use
fn mueller_apply(m, s) {
    # 2.2.6: mueller_get returns 0.0 for a null handle (its documented
    # out-of-range value), so a null matrix produced the all-zero Stokes vector
    # — indistinguishable from a real, computed total extinction. Returning 0
    # makes the failure a sentinel the caller can actually test, matching
    # mueller_set, which already refuses a null handle.
    if (m == 0) { return 0; }
    if (s == 0) { return 0; }
    var s0 = StokesVector_s0(s);
    var s1 = StokesVector_s1(s);
    var s2 = StokesVector_s2(s);
    var s3 = StokesVector_s3(s);
    return stokes_new(
      _mm_row_dot(m, 0, s0, s1, s2, s3),
      _mm_row_dot(m, 1, s0, s1, s2, s3),
      _mm_row_dot(m, 2, s0, s1, s2, s3),
      _mm_row_dot(m, 3, s0, s1, s2, s3));
}

# Multiply two Mueller matrices: a * b (apply b first, then a).
#must_use
fn mueller_multiply(a, b) {
    # 2.2.6: same class as mueller_apply — a null operand silently produced an
    # all-zero (perfect absorber) matrix rather than reporting failure.
    if (a == 0) { return 0; }
    if (b == 0) { return 0; }
    var r = alloc(128);
    if (r == 0) { return 0; }
    var i = 0;
    while (i < 4) {
        var j = 0;
        while (j < 4) {
            var sum = f64_add(f64_add(f64_add(
                  f64_mul(mueller_get(a, i, 0), mueller_get(b, 0, j)),
                  f64_mul(mueller_get(a, i, 1), mueller_get(b, 1, j))),
                f64_mul(mueller_get(a, i, 2), mueller_get(b, 2, j))),
              f64_mul(mueller_get(a, i, 3), mueller_get(b, 3, j)));
            mueller_set(r, i, j, sum);
            j = j + 1;
        }
        i = i + 1;
    }
    return r;
}

# Apply a `vec` of Mueller matrices to a Stokes vector, first to last.
#must_use
fn mueller_chain(stokes, elements) {
    # 2.2.6: propagates the null sentinel from mueller_apply rather than
    # continuing to chain against a zeroed vector.
    if (stokes == 0) { return 0; }
    if (elements == 0) { return 0; }
    var s = stokes;
    var i = 0;
    while (i < vec_len(elements)) {
        s = mueller_apply(vec_get(elements, i), s);
        # A null element anywhere in the chain now aborts the whole chain
        # instead of silently continuing against a zeroed vector.
        if (s == 0) { return 0; }
        i = i + 1;
    }
    return s;
}

# ── Birefringence ────────

# { n_o (ordinary), n_e (extraordinary), name }.
#derive(accessors)
struct BirefringentMaterial { n_o; n_e; name; }

fn _biref_mk(n_o, n_e, name) {
    var b = alloc(sizeof(BirefringentMaterial));
    if (b == 0) { return 0; }
    BirefringentMaterial_set_n_o(b, n_o);
    BirefringentMaterial_set_n_e(b, n_e);
    BirefringentMaterial_set_name(b, name);
    return b;
}

# Calcite (negative uniaxial): n_o = 1.6584, n_e = 1.4864.
#must_use
fn biref_calcite() { return _biref_mk(_wp_r(16584, 10000), _wp_r(14864, 10000), "calcite"); }
# Crystalline quartz (positive uniaxial): n_o = 1.5443, n_e = 1.5534.
#must_use
fn biref_quartz() { return _biref_mk(_wp_r(15443, 10000), _wp_r(15534, 10000), "quartz"); }
# Rutile (positive uniaxial): n_o = 2.616, n_e = 2.903.
#must_use
fn biref_rutile() { return _biref_mk(_wp_r(2616, 1000), _wp_r(2903, 1000), "rutile"); }
# Mica (muscovite, biaxial, here the pair a cleaved sheet sees at normal incidence): n_beta =
# 1.5936 and n_gamma = 1.5977, so delta n = 0.0041 and a quarter wave at 589 nm is 35.9 um, as
# mica retarders are. ⛔ 2.15.1: n_alpha = 1.5601 and n_beta = 1.5936, which a cleaved sheet
# never sees: delta n 0.0335, every retardation 8.2x too large (Hecht's muscovite indices).
#must_use
fn biref_mica() { return _biref_mk(_wp_r(15936, 10000), _wp_r(15977, 10000), "mica"); }

# Birefringence: delta_n = n_e - n_o.
# NaN for a null material (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn biref_birefringence(mat) {
    if (mat == 0) { return _PRK_NAN; }
    return f64_sub(BirefringentMaterial_n_e(mat), BirefringentMaterial_n_o(mat));
}

# Phase retardation: 2*pi * d * |delta_n| / lambda.
# NaN for a null material (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn biref_retardation(mat, thickness, wavelength) {
    if (mat == 0) { return _PRK_NAN; }
    return f64_div(f64_mul(f64_mul(F64_TAU, thickness), f64_abs(biref_birefringence(mat))), wavelength);
}

# Quarter-wave-plate thickness: lambda / (4*|delta_n|).
# NaN for a null material (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn biref_quarter_wave_thickness(mat, wavelength) {
    if (mat == 0) { return _PRK_NAN; }
    return f64_div(wavelength, f64_mul(f64_from(4), f64_abs(biref_birefringence(mat))));
}

# Half-wave-plate thickness: lambda / (2*|delta_n|).
# NaN for a null material (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn biref_half_wave_thickness(mat, wavelength) {
    if (mat == 0) { return _PRK_NAN; }
    return f64_div(wavelength, f64_mul(F64_TWO, f64_abs(biref_birefringence(mat))));
}

# Mueller matrix for this material at a thickness and wavelength (fast axis horizontal).
#must_use
fn biref_to_mueller(mat, thickness, wavelength) {
    if (mat == 0) { return 0; }
    return mueller_retarder(biref_retardation(mat, thickness, wavelength));
}

# --- wave_coherence.cyr ---

# wave_coherence.cyr -- temporal and spatial coherence
# Usage: include "lib/wave_coherence.cyr"
#
# Ported from the Rust `wave/coherence.rs`. Self-contained (no prakash deps).

# Temporal coherence length: l_c = lambda^2 / delta_lambda.
#must_use
fn coherence_length(center_wavelength, bandwidth) {
    return f64_div(f64_mul(center_wavelength, center_wavelength), bandwidth);
}

# Temporal coherence time (seconds): tau_c = l_c / c.
#must_use
fn coherence_time(center_wavelength_m, bandwidth_m) {
    return f64_div(coherence_length(center_wavelength_m, bandwidth_m), f64_from(299792458));
}

# Spatial coherence angle (van Cittert-Zernike): theta_c = lambda / d.
#must_use
fn spatial_coherence_angle(wavelength, source_diameter) {
    return f64_div(wavelength, source_diameter);
}

# Spatial coherence area at distance R: A_c = (lambda * R / d)^2.
#must_use
fn coherence_area(wavelength, distance, source_diameter) {
    var l = f64_div(f64_mul(wavelength, distance), source_diameter);
    return f64_mul(l, l);
}

# Number of coherence lengths in a path difference (visibility metric).
#must_use
fn coherence_ratio(path_difference, center_wavelength, bandwidth) {
    return f64_div(path_difference, coherence_length(center_wavelength, bandwidth));
}

# --- wave_airy.cyr ---

# wave_airy.cyr -- circular-aperture diffraction: Bessel J1, Airy, Rayleigh
# Usage: include "lib/wave_airy.cyr"
#
# Ported from the Rust `wave/airy.rs`. bessel_j1 uses the Abramowitz & Stegun
# rational approximation (|x| < 8) and the asymptotic expansion (|x| >= 8);
# all coefficients are exact ratios of the Rust literals. FRAC_2_PI (2/pi) is the
# exact IEEE-754 hex bit pattern.

fn _ar(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# First-order Bessel function J1(x), accurate to ~1e-7.
#must_use
fn bessel_j1(x) {
    var ax = f64_abs(x);
    if (f64_lt(ax, f64_from(8)) == 1) {
        var y = f64_mul(x, x);
        # num = x * (N0 + y*(N1 + y*(N2 + y*(N3 + y*(N4 + y*N5)))))
        var t = f64_neg(_ar(3016036606, 100000000));                # -30.16036606
        t = f64_add(_ar(1570448260, 100000), f64_mul(y, t));        # 15704.48260
        t = f64_add(f64_neg(_ar(2972611439, 1000)), f64_mul(y, t)); # -2972611.439
        t = f64_add(_ar(2423968531, 10), f64_mul(y, t));            # 242396853.1
        t = f64_add(f64_neg(f64_from(7895059235)), f64_mul(y, t));  # -7895059235
        t = f64_add(f64_from(72362614232), f64_mul(y, t));          # 72362614232
        var num = f64_mul(x, t);
        # den = D0 + y*(D1 + y*(D2 + y*(D3 + y*(D4 + y))))
        var u = f64_add(_ar(3769991397, 10000000), y);              # 376.9991397 + y
        u = f64_add(_ar(9944743394, 100000), f64_mul(y, u));        # 99447.43394
        u = f64_add(_ar(1858330474, 100), f64_mul(y, u));           # 18583304.74
        u = f64_add(f64_from(2300535178), f64_mul(y, u));           # 2300535178
        var den = f64_add(f64_from(144725228442), f64_mul(y, u));   # 144725228442
        return f64_div(num, den);
    }
    var z = f64_div(f64_from(8), ax);
    var z2 = f64_mul(z, z);
    var theta = f64_sub(ax, _ar(23561944902, 10000000000));         # ax - 3*pi/4
    # p1 = 1 + z2*(P0 + z2*(P1 + z2*(P2 + z2*P3)))
    var p = f64_neg(_ar(240337019, 1000000000000000));              # -0.240337019e-6
    p = f64_add(_ar(2457520174, 1000000000000000), f64_mul(z2, p)); # 0.2457520174e-5
    p = f64_add(f64_neg(_ar(3516396496, 100000000000000)), f64_mul(z2, p)); # -0.3516396496e-4
    p = f64_add(_ar(183105, 100000000), f64_mul(z2, p));            # 0.183105e-2
    var p1 = f64_add(F64_ONE, f64_mul(z2, p));
    # q1 = Q0 + z2*(Q1 + z2*(Q2 + z2*(Q3 + z2*Q4)))
    var q = _ar(105787412, 1000000000000000);                       # 0.105787412e-6
    q = f64_add(f64_neg(_ar(88228987, 100000000000000)), f64_mul(z2, q)); # -0.88228987e-6
    q = f64_add(_ar(8449199096, 1000000000000000), f64_mul(z2, q)); # 0.8449199096e-5
    q = f64_add(f64_neg(_ar(2002690873, 10000000000000)), f64_mul(z2, q)); # -0.2002690873e-3
    var q1 = f64_add(_ar(4687499995, 100000000000), f64_mul(z2, q)); # 0.04687499995
    var term1 = f64_mul(_prk_cos(theta), p1);
    var term2 = f64_mul(f64_mul(z, _prk_sin(theta)), q1);
    var result = f64_mul(f64_sqrt(f64_div(0x3FE45F306DC9C883, ax)), f64_sub(term1, term2));
    if (f64_lt(x, f64_from(0)) == 1) {
        return f64_neg(result);
    }
    return result;
}

# Airy diffraction intensity: I0 * (2*J1(x)/x)^2, x = pi*D*sin(theta)/lambda.
#must_use
fn airy_pattern(wavelength, aperture_diameter, angle, i0) {
    var x = f64_div(f64_mul(f64_mul(F64_PI, aperture_diameter), _prk_sin(angle)), wavelength);
    if (f64_lt(f64_abs(x), _ar(1, 10000000000)) == 1) {
        return i0;
    }
    var jinc = f64_div(f64_mul(F64_TWO, bessel_j1(x)), x);
    return f64_mul(f64_mul(i0, jinc), jinc);
}

# Angular radius of the first Airy dark ring: (j_1,1/pi) lambda/D, j_1,1 = 3.8317059702075 the
# first zero of J1 (A&S Table 9.5), so 1.2196698913 lambda/D. ⛔ 2.15.1: the constant was
# 1.2196705, 5e-7 off, and called exact.
#must_use
fn airy_first_zero(wavelength, aperture_diameter) {
    return f64_div(f64_mul(0x3FF383C4936E7CFB, wavelength), aperture_diameter);
}

# Rayleigh resolution criterion: 1.22 * lambda / D.
#must_use
fn rayleigh_criterion(wavelength, aperture_diameter) {
    return f64_div(f64_mul(_ar(122, 100), wavelength), aperture_diameter);
}

# --- wave_fabry_perot.cyr ---

# wave_fabry_perot.cyr -- Fabry-Perot interferometer
# Usage: include "lib/wave_fabry_perot.cyr"
#
# Ported from the Rust `wave/fabry_perot.rs`. Self-contained (no prakash deps).

# 1 if R is a mirror reflectance this module can use: finite and in [0, 1). R = 1 is a lossless
# limit with no finite finesse, and outside [0, 1] there is no mirror at all: 2.15.1 found R = -0.5
# giving T = 9 at a half order.
#must_use
fn _fp_r_ok(r) {
    if ((r & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000) { return 0; }
    if (f64_lt(r, 0) == 1) { return 0; }
    return f64_lt(r, F64_ONE);
}

# Coefficient of finesse: F = 4R / (1-R)^2. NaN unless R is in [0, 1).
#must_use
fn fabry_perot_finesse_coefficient(reflectance) {
    if (_fp_r_ok(reflectance) == 0) { return 0x7FF8000000000000; }
    var one_minus = f64_sub(F64_ONE, reflectance);
    return f64_div(f64_mul(f64_from(4), reflectance), f64_mul(one_minus, one_minus));
}

# Finesse (fringe sharpness): F = pi*sqrt(R) / (1-R). NaN unless R is in [0, 1).
#must_use
fn fabry_perot_finesse(reflectance) {
    if (_fp_r_ok(reflectance) == 0) { return 0x7FF8000000000000; }
    return f64_div(f64_mul(F64_PI, f64_sqrt(reflectance)), f64_sub(F64_ONE, reflectance));
}

# Transmittance (Airy function): T = 1 / (1 + F*sin^2(delta/2)),
# delta = 4*pi*n*d*cos(theta)/lambda. delta/2 = pi*m in the order m =
# 2*n*d*cos(theta)/lambda, and sin^2 has period 1 in m, so the whole orders go first:
# a cavity of optical length 0.14 m at 550 nm is past where sin takes full reduction. NaN unless
# R is in [0, 1).
#must_use
fn fabry_perot_transmittance(wavelength, thickness, n, angle, reflectance) {
    if (_fp_r_ok(reflectance) == 0) { return 0x7FF8000000000000; }
    var m = f64_div(f64_mul(f64_mul(f64_mul(F64_TWO, n), thickness), _prk_cos(angle)), wavelength);
    var f_coeff = fabry_perot_finesse_coefficient(reflectance);
    var s = _prk_sin(f64_mul(F64_HALF, _prk_cycles_phase(m)));
    return f64_div(F64_ONE, f64_add(F64_ONE, f64_mul(f_coeff, f64_mul(s, s))));
}

# Free spectral range: FSR = c / (2*n*d)  (Hz).
#must_use
fn fabry_perot_fsr(thickness_m, n) {
    return f64_div(f64_from(299792458), f64_mul(f64_mul(F64_TWO, n), thickness_m));
}

# Free spectral range in wavelength units: delta_lambda = lambda^2 / (2*n*d).
#must_use
fn fabry_perot_fsr_wavelength(wavelength, thickness, n) {
    return f64_div(f64_mul(wavelength, wavelength), f64_mul(f64_mul(F64_TWO, n), thickness));
}

# Resolving power: R = m*F, m = 2*n*d/lambda (order), F = finesse.
#must_use
fn fabry_perot_resolving_power(wavelength, thickness, n, reflectance) {
    var order = f64_div(f64_mul(f64_mul(F64_TWO, n), thickness), wavelength);
    return f64_mul(order, fabry_perot_finesse(reflectance));
}

# --- wave_diffraction.cyr ---

# wave_diffraction.cyr -- Fraunhofer / Fresnel / Huygens-Fresnel diffraction
# Usage: include "lib/wave_diffraction.cyr"  (requires wave_core.cyr for
# single_slit_intensity; ganita for hypot)
#
# Ported from the Rust `wave/diffraction.rs`. Two sections: (1) diffraction
# patterns (Fraunhofer, Fresnel integrals, Huygens-Fresnel); (2) anti-reflection
# coatings and the multilayer transfer-matrix method (single- and multi-layer,
# plus the full oblique-incidence s/p-split TMM `multilayer_rt`, and 2.10.0's
# complex-index `multilayer_rta` for absorbing layers and substrates).
#
# Aperture slices `&[(pos, amplitude)]` and layer slices `&[(n, thickness)]` are
# passed as interleaved buffers: element i has field-0 at offset i*16, field-1 at
# i*16+8, plus a count. The Fresnel integrals are Moshier's Cephes rational fits (2.15.1),
# their coefficients as hex bit patterns.

fn _diff_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# Fraunhofer diffraction for a rectangular aperture:
# I = single_slit(wl,w,ax) * single_slit(wl,h,ay) * i0.
#must_use
fn fraunhofer_rect(wavelength, width, height, angle_x, angle_y, i0) {
    var sx = single_slit_intensity(wavelength, width, angle_x, F64_ONE);
    var sy = single_slit_intensity(wavelength, height, angle_y, F64_ONE);
    return f64_mul(f64_mul(sx, sy), i0);
}

# Fraunhofer diffraction for a 1D aperture (interleaved pos/amplitude buffer):
# k = TAU*sin(angle)/wl; accumulate E; return |E|^2. NaN for a null aperture with pairs > 0
# (2.15.1: it was read through).
#must_use
fn fraunhofer_1d(aperture, pairs, wavelength, angle) {
    if ((aperture == 0) & (pairs > 0)) { return _PRK_NAN; }
    var k_sin = f64_div(f64_mul(F64_TAU, _prk_sin(angle)), wavelength);
    var real = f64_from(0);
    var imag = f64_from(0);
    for (var i = 0; i < pairs; i = i + 1) {
        var x = load64(aperture + i * 16);
        var amplitude = load64(aperture + i * 16 + 8);
        var phase = f64_mul(k_sin, x);
        real = f64_add(real, f64_mul(amplitude, _prk_cos(phase)));
        imag = f64_add(imag, f64_mul(amplitude, _prk_sin(phase)));
    }
    return f64_add(f64_mul(real, real), f64_mul(imag, imag));
}

# Fresnel number: N_F = a^2 / (wl*z).
#must_use
fn fresnel_number(wavelength, aperture_radius, distance) {
    return f64_div(
      f64_mul(aperture_radius, aperture_radius),
      f64_mul(wavelength, distance));
}

# One Horner step, acc*x + c.
#must_use
fn _fr_h(acc, x, c) { return f64_add(f64_mul(acc, x), c); }

# C(x) and S(x) for x >= 0 into out[0], out[1], by Moshier's Cephes `fresnl` (Cephes Math Library
# 2.1, 1989): rational fits in x^4 below x^2 = 2.5625, and above it the auxiliary functions
#   C = 1/2 + (f sin(pi x^2/2) - g cos(pi x^2/2))/(pi x),  S = 1/2 - (f cos + g sin)/(pi x),
# with f and g rational in 1/(pi x^2)^2. Coefficients are the Cephes decimals, correctly rounded
# to the hex below. The phase is reduced in cycles, x^2/4, from x^2 split exactly into a
# head and a tail (Dekker), so it does not lose the bits a rounded x^2 drops: past x = 2^53
# every x^2/4 is a whole number of cycles and the limit is written directly.
# Measured against a 120-digit reference (the Maclaurin series to x = 6, the asymptotic expansion
# truncated at its smallest term beyond): within 2.6e-16 absolute and 5.0e-16 relative at 4786
# points over [0, 40), and at x = 1e2 ... 1e15.
fn _fresnel_core(x, out) {
    if ((x & _PRK_ABS) > 0x7FF0000000000000) {
        store64(out, x);
        store64(out + 8, x);
        return 0;
    }
    if (f64_lt(x, 0x4340000000000000) == 0) {     # 2^53, and +inf
        store64(out, F64_HALF);
        store64(out + 8, f64_sub(F64_HALF, f64_div(F64_ONE, f64_mul(F64_PI, x))));
        return 0;
    }
    var x2 = f64_mul(x, x);
    if (f64_lt(x2, 0x4004800000000000) == 1) {     # x^2 < 2.5625
        var t = f64_mul(x2, x2);
        var sn = 0xC0A75FA36D65B5C3;    # -2.99181919401019853726E3
        sn = _fr_h(sn, t, 0x4125A1D0172C05B6);    # 7.08840045257738576863E5
        sn = _fr_h(sn, t, 0xC18E074624F6F5ED);    # -6.29741486205862506537E7
        sn = _fr_h(sn, t, 0x41E2FDA860B77AFE);    # 2.54890880573376359104E9
        sn = _fr_h(sn, t, 0xC224A0BA347BF087);    # -4.42979518059697779103E10
        sn = _fr_h(sn, t, 0x425282CFE6E52457);    # 3.18016297876567817986E11
        var sd = f64_add(t, 0x4071960532871072);    # 2.81376268889994315696E2
        sd = _fr_h(sd, t, 0x40E64218FE9CDAA9);    # 4.55847810806532581675E4
        sd = _fr_h(sd, t, 0x4153BC2FB8D017B4);    # 5.17343888770096400730E6
        sd = _fr_h(sd, t, 0x41B8FE51B5E5EA9E);    # 4.19320245898111231129E8
        sd = _fr_h(sd, t, 0x4214E664E6B222E9);    # 2.24411795645340920940E10
        sd = _fr_h(sd, t, 0x4261AD3B73DE42B5);    # 6.07366389490084639049E11
        var cn = 0xBE6AC80C2CFB62D3;    # -4.98843114573573548651E-8
        cn = _fr_h(cn, t, 0x3EE3EE9262100F74);    # 9.50428062829859605134E-6
        cn = _fr_h(cn, t, 0xBF4524420ED68786);    # -6.45191435683965050962E-4
        cn = _fr_h(cn, t, 0x3F93566A1059CC13);    # 1.88843319396703850064E-2
        cn = _fr_h(cn, t, 0xBFCA4EAC378A9690);    # -2.05525900955013891793E-1
        cn = _fr_h(cn, t, 0x3FF0000000000000);    # 9.99999999999999998822E-1
        var cd = 0x3D9197686A7FC6B3;    # 3.99982968972495980367E-12
        cd = _fr_h(cd, t, 0x3E0F7449DB0375B9);    # 9.15439215774657478799E-10
        cd = _fr_h(cd, t, 0x3E80C70802A45191);    # 1.25001862479598821474E-7
        cd = _fr_h(cd, t, 0x3EE9A3EEFA2A1D32);    # 1.22262789024179030997E-5
        cd = _fr_h(cd, t, 0x3F4C718F3FDBD99D);    # 8.68029542941784300606E-4
        cd = _fr_h(cd, t, 0x3FA51A076030FE74);    # 4.12142090722199792936E-2
        cd = _fr_h(cd, t, 0x3FF0000000000000);    # 1.00000000000000000118E0
        store64(out, f64_div(f64_mul(x, cn), cd));
        store64(out + 8, f64_div(f64_mul(f64_mul(x, x2), sn), sd));
        return 0;
    }
    var pt = f64_mul(F64_PI, x2);
    var u = f64_div(F64_ONE, f64_mul(pt, pt));
    var fn_ = 0x3FDAFA91D1B02391;    # 4.21543555043677546506E-1
    fn_ = _fr_h(fn_, u, 0x3FC25B30D2B90E5E);    # 1.43407919780758885261E-1
    fn_ = _fr_h(fn_, u, 0x3F8798E57B157DAD);    # 1.15220955073585758835E-2
    fn_ = _fr_h(fn_, u, 0x3F369C70C4950EFC);    # 3.45017939782574027900E-4
    fn_ = _fr_h(fn_, u, 0x3ED37203C5357795);    # 4.63613749287867322088E-6
    fn_ = _fr_h(fn_, u, 0x3E6067B5484E87A1);    # 3.05568983790257605827E-8
    fn_ = _fr_h(fn_, u, 0x3DDC1F0A4998A7BB);    # 1.02304514164907233465E-10
    fn_ = _fr_h(fn_, u, 0x3D4835571459FDF7);    # 1.72010743268161828879E-13
    fn_ = _fr_h(fn_, u, 0x3CA35A2DAF8FA9E4);    # 1.34283276233062758925E-16
    fn_ = _fr_h(fn_, u, 0x3BE636EF0E0B05F6);    # 3.76329711269987889006E-20
    var fd = f64_add(u, 0x3FE80CFEEB217A65);    # 7.51586398353378947175E-1
    fd = _fr_h(fd, u, 0x3FBDEC6EC1D46D7D);    # 1.16888925859191382142E-1
    fd = _fr_h(fd, u, 0x3F7A615EA6ED56F3);    # 6.44051526508858611005E-3
    fd = _fr_h(fd, u, 0x3F24704A6017BD60);    # 1.55934409164153020873E-4
    fd = _fr_h(fd, u, 0x3EBEF9B1923264F5);    # 1.84627567348930545870E-6
    fd = _fr_h(fd, u, 0x3E4833B495525916);    # 1.12699224763999035261E-8
    fd = _fr_h(fd, u, 0x3DC3CC8533D3A061);    # 3.60140029589371370404E-11
    fd = _fr_h(fd, u, 0x3D30926C6B9F0790);    # 5.88754533621578410010E-14
    fd = _fr_h(fd, u, 0x3C8A0E5D2352F48D);    # 4.52001434074129701496E-17
    fd = _fr_h(fd, u, 0x3BCD9E9412B96141);    # 1.25443237090011264384E-20
    var gn = 0x3FE02463B420CACA;    # 5.04442073643383265887E-1
    gn = _fr_h(gn, u, 0x3FC93AAA67F87481);    # 1.97102833525523411709E-1
    gn = _fr_h(gn, u, 0x3F93371854BA3214);    # 1.87648584092575249293E-2
    gn = _fr_h(gn, u, 0x3F466A7948D1B33B);    # 6.84079380915393090172E-4
    gn = _fr_h(gn, u, 0x3EE82577F9FAABF3);    # 1.15138826111884280931E-5
    gn = _fr_h(gn, u, 0x3E7A621C4DEA6091);    # 9.82852443688422223854E-8
    gn = _fr_h(gn, u, 0x3DFE9A94F200EB09);    # 4.45344415861750144738E-10
    gn = _fr_h(gn, u, 0x3D730BF5876689CB);    # 1.08268041139020870318E-12
    gn = _fr_h(gn, u, 0x3CD8C7A03DF8A964);    # 1.37555460633261799868E-15
    gn = _fr_h(gn, u, 0x3C2EDB24F17358A6);    # 8.36354435630677421531E-19
    gn = _fr_h(gn, u, 0x3B6C409D624FBE2B);    # 1.86958710162783235106E-22
    var gd = f64_add(u, 0x3FF7996D23BC55C1);    # 1.47495759925128324529E0
    gd = _fr_h(gd, u, 0x3FD59DADEFA1C34F);    # 3.37748989120019970451E-1
    gd = _fr_h(gd, u, 0x3F99F811E637AA09);    # 2.53603741420338795122E-2
    gd = _fr_h(gd, u, 0x3F4AB2060FA0AE28);    # 8.14679107184306179049E-4
    gd = _fr_h(gd, u, 0x3EEABF862C0A067B);    # 1.27545075667729118702E-5
    gd = _fr_h(gd, u, 0x3E7C0071AB1C7428);    # 1.04314589657571990585E-7
    gd = _fr_h(gd, u, 0x3DFFA8618E3CF1C6);    # 4.60680728146520428211E-10
    gd = _fr_h(gd, u, 0x3D7366439C3DEF2B);    # 1.10273215066240270757E-12
    gd = _fr_h(gd, u, 0x3CD900DC37C81936);    # 1.38796531259578871258E-15
    gd = _fr_h(gd, u, 0x3C2EF5A184FF8364);    # 8.39158816283118707363E-19
    gd = _fr_h(gd, u, 0x3B6C409D624FBE2B);    # 1.86958710162783236342E-22
    var f = f64_sub(F64_ONE, f64_div(f64_mul(u, fn_), fd));
    var g = f64_div(f64_div(gn, gd), pt);
    # x^2 = hi + lo exactly: Dekker's split of x into 26-bit halves.
    var sp = f64_mul(0x41A0000002000000, x);     # 2^27 + 1
    var xh = f64_sub(sp, f64_sub(sp, x));
    var xl = f64_sub(x, xh);
    var hh = f64_sub(f64_mul(xh, xh), x2);
    var lo = f64_add(f64_add(hh, f64_mul(f64_mul(F64_TWO, xh), xl)), f64_mul(xl, xl));
    var q = f64_mul(x2, 0x3FD0000000000000);     # x^2/4 cycles, exact
    var ph = f64_mul(F64_TAU, f64_add(f64_sub(q, f64_floor(q)), f64_mul(lo, 0x3FD0000000000000)));
    var sn2 = _prk_sin(ph);
    var cs2 = _prk_cos(ph);
    var px = f64_mul(F64_PI, x);
    store64(out, f64_add(F64_HALF, f64_div(f64_sub(f64_mul(f, sn2), f64_mul(g, cs2)), px)));
    store64(out + 8, f64_sub(F64_HALF, f64_div(f64_add(f64_mul(f, cs2), f64_mul(g, sn2)), px)));
    return 0;
}

# ⛔ 2.15.1 replaced Abramowitz & Stegun 7.3.32/7.3.33 (|eps| <= 2e-3) and a three-term series below
# x = 1. Against the same reference that pair was 2.2e-3 off (S(2.08)) and 6.2e-3 relative (C(1.81)),
# jumped 1.6e-3 at the x = 1 seam (C was not continuous at its own first maximum), and returned NaN
# from x = 1e10, where pi x^2/2 passed the sine's range. 2.2.6 and 2.4.7 had already repaired the
# fit's coefficients, which the Rust applied to x^2 and x^4 instead of x.

# Fresnel cosine integral C(x) = integral_0^x cos(pi*t^2/2) dt; odd in x, 1/2 at +infinity.
#must_use
fn fresnel_integral_c(x) {
    var o[16];
    _fresnel_core(f64_abs(x), &o);
    if (f64_lt(x, f64_from(0)) == 1) { return f64_neg(load64(&o)); }
    return load64(&o);
}

# Fresnel sine integral S(x) = integral_0^x sin(pi*t^2/2) dt; odd in x, 1/2 at +infinity.
#must_use
fn fresnel_integral_s(x) {
    var o[16];
    _fresnel_core(f64_abs(x), &o);
    if (f64_lt(x, f64_from(0)) == 1) { return f64_neg(load64(&o + 8)); }
    return load64(&o + 8);
}

# Both Fresnel integrals together, sharing work; writes C(x), S(x) to c_out, s_out. Returns
# PK_ERR_NONE, or PK_ERR_INVALID_PARAMETER and writes nothing if either is null (2.15.1: they
# were written through).
fn fresnel_integral_cs(x, c_out, s_out) {
    if ((c_out == 0) | (s_out == 0)) { return PK_ERR_INVALID_PARAMETER; }
    var o[16];
    _fresnel_core(f64_abs(x), &o);
    if (f64_lt(x, f64_from(0)) == 1) {
        store64(c_out, f64_neg(load64(&o)));
        store64(s_out, f64_neg(load64(&o + 8)));
        return 0;
    }
    store64(c_out, load64(&o));
    store64(s_out, load64(&o + 8));
    return 0;
}

# Fresnel straight-edge intensity: I/I0 = [(C(u)+0.5)^2 + (S(u)+0.5)^2] / 2.
#must_use
fn fresnel_edge_intensity(u) {
    # Stack locals, not `alloc(16)` — see fresnel_integral_c.
    var cv = 0;
    var sv = 0;
    fresnel_integral_cs(u, &cv, &sv);
    var c = f64_add(cv, F64_HALF);
    var s = f64_add(sv, F64_HALF);
    return f64_div(f64_add(f64_mul(c, c), f64_mul(s, s)), F64_TWO);
}

# Fresnel parameter: u = x * sqrt(2 / (wl*z)).
#must_use
fn fresnel_parameter(wavelength, x, distance) {
    return f64_mul(x, f64_sqrt(f64_div(F64_TWO, f64_mul(wavelength, distance))));
}

# Huygens-Fresnel 1D integral: complex field at x_obs from secondary wavelets;
# returns |E|^2. Aperture is an interleaved pos/amplitude buffer. NaN for a null aperture with
# pairs > 0 (2.15.1: it was read through).
#must_use
fn huygens_fresnel_1d(aperture, pairs, wavelength, z, x_obs) {
    if ((aperture == 0) & (pairs > 0)) { return _PRK_NAN; }
    var k = f64_div(F64_TAU, wavelength);
    var real = f64_from(0);
    var imag = f64_from(0);
    for (var i = 0; i < pairs; i = i + 1) {
        var x_ap = load64(aperture + i * 16);
        var amplitude = load64(aperture + i * 16 + 8);
        var dx = f64_sub(x_obs, x_ap);
        var r = ganita_f64_hypot(z, dx);
        var phase = f64_mul(k, r);
        var weight = f64_div(f64_mul(amplitude, z), f64_mul(r, r));
        real = f64_add(real, f64_mul(weight, _prk_cos(phase)));
        imag = f64_add(imag, f64_mul(weight, _prk_sin(phase)));
    }
    return f64_add(f64_mul(real, real), f64_mul(imag, imag));
}

# ── Anti-Reflection Coatings ────────

# Ideal quarter-wave AR coating index: n = sqrt(n1*n2).
#must_use
fn ar_ideal_index(n1, n2) {
    return f64_sqrt(f64_mul(n1, n2));
}

# Quarter-wave coating thickness for a design wavelength: d = wl / (4*n_coating).
#must_use
fn ar_quarter_wave_thickness(wavelength, n_coating) {
    return f64_div(wavelength, f64_mul(f64_from(4), n_coating));
}

# Single-layer thin-film reflectance at normal incidence (exact Airy formula):
# R = (a^2*sin^2 d + p^2*cos^2 d) / (b^2*sin^2 d + c^2*cos^2 d), delta = TAU*nc*d/wl,
# a = ni*ns - nc^2, b = ni*ns + nc^2, c = nc*(ni+ns), p = nc*(ni-ns).
# ⛔ 2.4.8: THE p^2*cos^2 d NUMERATOR TERM WAS MISSING ENTIRELY. The denominator
# carried both of its terms and the numerator only one, so R collapsed to 0
# wherever cos d != 0 dominated — most visibly at **thickness = 0, which returned
# 0.0 where the bare substrate reflects 0.04258**: a coating of no thickness made
# the glass perfectly non-reflecting, and so did every half-wave (absentee)
# thickness. Measured against this file's own 1-layer TMM (`multilayer_reflectance`),
# MgF2 nc=1.38 quarter-wave on ns=1.52 designed at 550 nm:
#   400 nm  0.0086281 vs 0.0220525  (-60.9%)    550 nm  0.0126008 vs 0.0126008 (exact)
#   450 nm  0.0110862 vs 0.0162043  (-31.6%)    650 nm  0.0118579 vs 0.0143684 (-17.5%)
#   500 nm  0.0122830 vs 0.0133568  ( -8.0%)    700 nm  0.0111880 vs 0.0159620 (-29.9%)
# ⚠ 550 nm is exact because a quarter-wave film has delta = pi/2 there, so
# cos d = 0 and the missing term vanishes. The suite compared this function to
# `multilayer_reflectance` at **550 nm only** — the single wavelength in the band
# where the defect is invisible — and its 400-700 nm sweep asserted only
# 0 <= R <= 1, which the truncated formula satisfies everywhere. Same shape as the
# 2.4.2 diamond and 2.4.6 LSA defects: the right instrument, aimed at the one point
# that could not see it.
#must_use
fn coating_reflectance(wavelength, n_incident, n_coating, n_substrate, thickness) {
    var delta = f64_div(
      f64_mul(f64_mul(F64_TAU, n_coating), thickness),
      wavelength);
    var sin_d = _prk_sin(delta);
    var cos_d = _prk_cos(delta);
    var nc2 = f64_mul(n_coating, n_coating);
    var ni_ns = f64_mul(n_incident, n_substrate);
    var a = f64_sub(ni_ns, nc2);
    var b = f64_add(ni_ns, nc2);
    var c = f64_mul(n_coating, f64_add(n_incident, n_substrate));
    # p mirrors c with a MINUS: c = nc*(ni+ns) carries the denominator's cos^2
    # term, p = nc*(ni-ns) carries the numerator's. Losing one and keeping the
    # other is what made a zero-thickness film non-reflecting.
    var p = f64_mul(n_coating, f64_sub(n_incident, n_substrate));
    var num = f64_add(
      f64_mul(f64_mul(f64_mul(a, a), sin_d), sin_d),
      f64_mul(f64_mul(f64_mul(p, p), cos_d), cos_d));
    var den = f64_add(
      f64_mul(f64_mul(f64_mul(b, b), sin_d), sin_d),
      f64_mul(f64_mul(f64_mul(c, c), cos_d), cos_d));
    return f64_div(num, den);
}

# V-coat (quarter-wave) reflectance at the design wavelength:
# R = [(n1*n3 - n2^2) / (n1*n3 + n2^2)]^2.
#must_use
fn vcoat_reflectance(n1, n2, n3) {
    var n2sq = f64_mul(n2, n2);
    var n1n3 = f64_mul(n1, n3);
    var frac = f64_div(f64_sub(n1n3, n2sq), f64_add(n1n3, n2sq));
    return f64_mul(frac, frac);
}

# Multilayer reflectance (transfer matrix, normal incidence). Layers are an
# interleaved (n, thickness) buffer. Matrix M = product of layer matrices, with
# M12/M21 purely imaginary (tracked as *_i), M11/M22 purely real (*_r).
#must_use
fn multilayer_reflectance(wavelength, n_incident, n_substrate, layers, num_layers) {
    _prk_trace("multilayer_reflectance");
    # 2.2.8: a null buffer with num_layers > 0 read straight off address 0.
    # NaN rather than 0.0 because 0.0 is a legitimate reflectance.
    if (num_layers < 0) { return _PRK_NAN; }
    if (num_layers > 0) { if (layers == 0) { return _PRK_NAN; } }
    var m11_r = F64_ONE;
    var m12_i = f64_from(0);
    var m21_i = f64_from(0);
    var m22_r = F64_ONE;
    for (var i = 0; i < num_layers; i = i + 1) {
        var n = load64(layers + i * 16);
        var d = load64(layers + i * 16 + 8);
        var delta = f64_div(f64_mul(f64_mul(F64_TAU, n), d), wavelength);
        var sin_d = _prk_sin(delta);
        var cos_d = _prk_cos(delta);
        # ⚠ 2.2.7 DELIBERATELY DIVERGES FROM THE RUST ORIGINAL. The M12 and M21
        # cross terms carried the wrong sign (Rust `rust-old/src/wave/
        # diffraction.rs:308-309`, identical). With
        # M = [[m11_r, i*m12_i], [i*m21_i, m22_r]] and a layer
        # L = [[cos d, i sin d / eta], [i eta sin d, cos d]], the product M*L is
        #   M11' = m11_r cos d - m12_i eta sin d      (was correct)
        #   M12' = + m11_r sin d / eta + m12_i cos d  (had a leading minus)
        #   M21' = m21_i cos d + m22_r eta sin d      (had a minus on the 2nd term)
        #   M22' = -m21_i sin d / eta + m22_r cos d   (was correct)
        # ⚠ WHY EVERY TEST PASSED: both wrong signs flip m12_i and m21_i
        # TOGETHER, and the reflectance uses them only inside num_i^2 / den_i^2,
        # so a SINGLE layer is bit-identical either way. At the design
        # wavelength cos d = 0, which kills the mixing term, so quarter-wave
        # stacks also agree. The error needs 2+ layers AND a wavelength off
        # design. Measured against an independent complex-arithmetic TMM,
        # n_i = 1.0, substrate 1.52, quarter-wave 1.38/2.30 stack at 550 nm:
        #   450 nm, 2 layers: 0.077175 -> 0.130025
        #   450 nm, 3 layers: 0.039460 -> 0.187549   (4.75x low)
        #   650 nm, 3 layers: 0.066815 -> 0.168553
        #   550 nm (design), any depth: unchanged, as is any single layer
        var n11 = f64_sub(f64_mul(m11_r, cos_d), f64_mul(f64_mul(m12_i, n), sin_d));
        var n12 = f64_add(f64_div(f64_mul(m11_r, sin_d), n), f64_mul(m12_i, cos_d));
        var n21 = f64_add(f64_mul(m21_i, cos_d), f64_mul(f64_mul(m22_r, n), sin_d));
        var n22 = f64_add(f64_div(f64_mul(f64_neg(m21_i), sin_d), n), f64_mul(m22_r, cos_d));
        m11_r = n11;
        m12_i = n12;
        m21_i = n21;
        m22_r = n22;
    }
    var ni = n_incident;
    var ns = n_substrate;
    var num_r = f64_sub(f64_mul(ni, m11_r), f64_mul(ns, m22_r));
    var num_i = f64_sub(f64_mul(f64_mul(ni, ns), m12_i), m21_i);
    var den_r = f64_add(f64_mul(ni, m11_r), f64_mul(ns, m22_r));
    var den_i = f64_add(f64_mul(f64_mul(ni, ns), m12_i), m21_i);
    return f64_div(
      f64_add(f64_mul(num_r, num_r), f64_mul(num_i, num_i)),
      f64_add(f64_mul(den_r, den_r), f64_mul(den_i, den_i)));
}

# ── Full Transfer Matrix Method (oblique incidence, s/p split) ────────

#derive(accessors)
struct ThinFilmResult { r_s; r_p; t_s; t_p; r_avg; t_avg; }

# cos(theta) in a medium of index n via Snell's law (ni_sin_i is the invariant);
# returns 0 on total internal reflection (evanescent).
fn _diff_cos_in_medium(n, ni_sin_i) {
    var sin_t = f64_div(ni_sin_i, n);
    if (f64_gt(f64_abs(sin_t), F64_ONE) == 1) {
        return f64_from(0);
    }
    return f64_sqrt(f64_sub(F64_ONE, f64_mul(sin_t, sin_t)));
}

# Optical admittance eta: s-pol eta = n*cos; p-pol eta = n/cos (guarded).
fn _diff_eta(n, cos_t, is_p) {
    if (is_p == 0) {
        return f64_mul(n, cos_t);
    }
    if (f64_lt(f64_abs(cos_t), f64_div(F64_ONE, f64_from(1000000000000000))) == 1) {
        return f64_mul(n, f64_from(1000000000000000));
    }
    return f64_div(n, cos_t);
}

# cosh/sinh from the exp shim, with the argument clamped. An evanescent layer
# thick enough to push beta past ~350 is opaque to any precision that matters,
# and exp would overflow to +inf and turn the whole matrix into NaN.
#must_use
fn _diff_cosh(x) {
    var b = x;
    if (f64_gt(b, f64_from(350)) == 1) { b = f64_from(350); }
    var e = _prk_exp(b);
    return f64_div(f64_add(e, f64_div(F64_ONE, e)), F64_TWO);
}
#must_use
fn _diff_sinh(x) {
    var b = x;
    if (f64_gt(b, f64_from(350)) == 1) { b = f64_from(350); }
    var e = _prk_exp(b);
    return f64_div(f64_sub(e, f64_div(F64_ONE, e)), F64_TWO);
}

# |sin(theta_t)| in a medium of index n — the value _diff_cos_in_medium tests
# against 1 to decide whether the layer is propagating or evanescent.
#must_use
fn _diff_sin_in_medium(n, ni_sin_i) { return f64_abs(f64_div(ni_sin_i, n)); }

# One TMM stack for a single polarization (is_p: 0=s, 1=p). Writes reflectance to
# rt_out and transmittance (1-R, lossless) to rt_out+8.
fn _diff_tmm_stack(wavelength, ni, ns, layers, num_layers, cos_i, cos_sub, ni_sin_i, is_p, rt_out) {
    var m11_r = F64_ONE;
    var m12_i = f64_from(0);
    var m21_i = f64_from(0);
    var m22_r = F64_ONE;
    for (var i = 0; i < num_layers; i = i + 1) {
        var n = load64(layers + i * 16);
        var d = load64(layers + i * 16 + 8);
        var cos_l = _diff_cos_in_medium(n, ni_sin_i);
        var delta = f64_div(
          f64_mul(f64_mul(f64_mul(F64_TAU, n), d), cos_l),
          wavelength);
        # The layer matrix is L = [[A, i*Bi], [i*Ci, A]] in both regimes, which
        # is why the accumulator's real/imaginary split survives evanescence.
        #   propagating: A = cos d,  Bi = sin d / eta,   Ci = eta * sin d
        # ⚠ 2.2.8: THE EVANESCENT BRANCH DID NOT EXIST and the results were
        # garbage. _diff_cos_in_medium returns 0.0 as its TIR sentinel and this
        # loop consumed it as a real cosine: for s-polarisation eta = n*0 = 0 and
        # delta = 0, so `sin_d / eta` evaluated 0/0 = NaN on the first iteration
        # and NaN reached r_s, t_s, r_avg and t_avg with no error signal. For
        # p-polarisation the eta guard avoided the NaN but delta = 0 collapsed
        # the layer matrix to the identity — the evanescent layer was simply
        # DELETED from the stack, which is why r_p came out bit-identical for
        # d = 50, 100 and 300 nm.
        # Past the critical angle cos_l = i*kappa with kappa = sqrt(sin_t^2 - 1),
        # so delta = i*beta is pure imaginary and eta = i*eta_i is too. Then
        # cos(delta) = cosh(beta), sin(delta) = i*sinh(beta), and the same
        # algebra gives A = cosh b, Bi = sinh b / eta_i, Ci = -eta_i * sinh b —
        # finite, non-identity and thickness-dependent, which is what produces
        # frustrated-TIR tunnelling.
        var sin_t = _diff_sin_in_medium(n, ni_sin_i);
        var a_r = f64_from(0);
        var b_i = f64_from(0);
        var c_i = f64_from(0);
        if (f64_gt(sin_t, F64_ONE) == 1) {
            var kappa = f64_sqrt(f64_sub(f64_mul(sin_t, sin_t), F64_ONE));
            var beta = f64_div(f64_mul(f64_mul(f64_mul(F64_TAU, n), d), kappa), wavelength);
            # eta = i*eta_i: s-pol eta_i = n*kappa, p-pol eta_i = -n/kappa.
            var eta_i2 = f64_mul(n, kappa);
            if (is_p == 1) {
                if (f64_lt(kappa, _diff_r(1, 1000000000000000)) == 1) {
                    eta_i2 = f64_neg(f64_mul(n, f64_from(1000000000000000)));
                } else {
                    eta_i2 = f64_neg(f64_div(n, kappa));
                }
            }
            var sh = _diff_sinh(beta);
            a_r = _diff_cosh(beta);
            b_i = f64_div(sh, eta_i2);
            c_i = f64_neg(f64_mul(eta_i2, sh));
        } else {
            if ((cos_l & _PRK_ABS) == 0) {
                # EXACTLY at the layer's critical angle delta = 0 and eta is 0 (s) or infinite
                # (p); the matrix is the limit as cos -> 0 of sin(delta)/eta and eta sin(delta):
                # s: [[1, i k d], [0, 1]], p: [[1, 0], [i k n^2 d, 1]], k = 2 pi/lambda.
                # ⛔ 2.15.1: s evaluated 0/0 = NaN and p dropped the layer (identity).
                var kd = f64_div(f64_mul(F64_TAU, d), wavelength);
                a_r = F64_ONE;
                if (is_p == 0) {
                    b_i = kd;
                } else {
                    c_i = f64_mul(kd, f64_mul(n, n));
                }
            } else {
                var eta = _diff_eta(n, cos_l, is_p);
                var sin_d = _prk_sin(delta);
                a_r = _prk_cos(delta);
                b_i = f64_div(sin_d, eta);
                c_i = f64_mul(eta, sin_d);
            }
        }
        # 2.2.7 fixed two sign errors in this product; see multilayer_reflectance
        # for the derivation of M' = M*L.
        var n11 = f64_sub(f64_mul(m11_r, a_r), f64_mul(m12_i, c_i));
        var n12 = f64_add(f64_mul(m11_r, b_i), f64_mul(m12_i, a_r));
        var n21 = f64_add(f64_mul(m21_i, a_r), f64_mul(m22_r, c_i));
        var n22 = f64_add(f64_mul(f64_neg(m21_i), b_i), f64_mul(m22_r, a_r));
        m11_r = n11;
        m12_i = n12;
        m21_i = n21;
        m22_r = n22;
    }
    var eta_i = _diff_eta(ni, cos_i, is_p);
    var eta_s = _diff_eta(ns, cos_sub, is_p);
    var num_r = f64_sub(f64_mul(eta_i, m11_r), f64_mul(eta_s, m22_r));
    var num_i = f64_sub(f64_mul(f64_mul(eta_i, eta_s), m12_i), m21_i);
    var den_r = f64_add(f64_mul(eta_i, m11_r), f64_mul(eta_s, m22_r));
    var den_i = f64_add(f64_mul(f64_mul(eta_i, eta_s), m12_i), m21_i);
    var r = f64_div(
      f64_add(f64_mul(num_r, num_r), f64_mul(num_i, num_i)),
      f64_add(f64_mul(den_r, den_r), f64_mul(den_i, den_i)));
    store64(rt_out, r);
    store64(rt_out + 8, f64_sub(F64_ONE, r));
}

# Full multilayer TMM at oblique incidence; returns a ThinFilmResult with the
# s/p reflectances/transmittances and their unpolarized averages, or 0 for |angle| >= pi/2 or a
# NaN angle (as multilayer_rta refuses them). ⛔ 2.15.1: past grazing the incident admittance went
# negative and R_s > 1, T_s < 0 came back as a result.
#must_use
fn multilayer_rt(wavelength, angle, n_incident, n_substrate, layers, num_layers) {
    _prk_trace("multilayer_rt");
    # 2.2.8: same class as multilayer_reflectance. Returns a pointer, so 0 is
    # the sentinel, matching diffraction_pattern_2d and psf_from_wavefront.
    if (num_layers < 0) { return 0; }
    if (num_layers > 0) { if (layers == 0) { return 0; } }
    if (f64_lt(f64_abs(angle), F64_PI_2) == 0) { return 0; }
    var cos_i = _prk_cos(angle);
    var sin_i = _prk_sin(angle);
    var ni_sin_i = f64_mul(n_incident, sin_i);
    var cos_sub = _diff_cos_in_medium(n_substrate, ni_sin_i);
    # 2.3.7: the two 16-byte s/p scratch slots are stack locals. They never
    # escape — _diff_tmm_stack writes them, the four loads below read them, and
    # the values are copied into the returned ThinFilmResult — so there is nothing
    # for a caller to retain. 16 bytes each against a measured 122,880-byte
    # per-function budget, far below cycc's "oversized array local" threshold.
    # Measured same-binary, interleaved, 3/3 reproductions: **480 -> 448 ns
    # (-6.8%)** at a 1-layer stack, and 80 -> 48 bytes per call.
    #
    # ⚠ This is the ONLY one of the small fixed-size scratch sites that moves the
    # clock. alloc(16) costs 6.4-7.5 ns here, so removing one or two can only
    # register on a row whose baseline is a few hundred ns — which multilayer_rt's
    # is and the others' are not. The rest are left alone deliberately; see the
    # roadmap row.
    var rt_s[16];
    _diff_tmm_stack(wavelength, n_incident, n_substrate, layers, num_layers,
      cos_i, cos_sub, ni_sin_i, 0, &rt_s);
    var rt_p[16];
    _diff_tmm_stack(wavelength, n_incident, n_substrate, layers, num_layers,
      cos_i, cos_sub, ni_sin_i, 1, &rt_p);
    var r_s = load64(&rt_s);
    var t_s = load64(&rt_s + 8);
    var r_p = load64(&rt_p);
    var t_p = load64(&rt_p + 8);
    var res = alloc(sizeof(ThinFilmResult));
    if (res == 0) { return 0; }
    ThinFilmResult_set_r_s(res, r_s);
    ThinFilmResult_set_r_p(res, r_p);
    ThinFilmResult_set_t_s(res, t_s);
    ThinFilmResult_set_t_p(res, t_p);
    ThinFilmResult_set_r_avg(res, f64_mul(F64_HALF, f64_add(r_s, r_p)));
    ThinFilmResult_set_t_avg(res, f64_mul(F64_HALF, f64_add(t_s, t_p)));
    return res;
}

# ── Absorbing multilayers: complex-index TMM (2.10.0) ────────
#
# multilayer_rt above takes REAL indices at a 16-byte (n, d) stride; admitting an
# extinction coefficient k is a new layout, so it is a new entry point rather than
# a change to that one. Convention: n~ = n + ik with k >= 0 absorbing and fields
# ~ exp(i(kz - wt)) — the sign ray_fresnel's ComplexMedium uses.
#
# Method: Abeles characteristic matrices (Macleod, Thin-Film Optical Filters ch. 2)
# applied to the substrate's admittance vector from the back of the stack forward,
#   [B; C] = M_1 M_2 ... M_q [1; eta_sub],   M_j = [[cos d, -i sin d/eta],
#                                                    [-i eta sin d, cos d]],
# delta_j = 2 pi q_j d_j/lambda, q_j = n~_j cos(theta_j) = sqrt(n~_j^2 - beta^2),
# beta = n_0 sin(theta_0), and tilted admittances eta = q (s) or n~^2/q (p). Then
#   R = |(eta_0 B - C)/(eta_0 B + C)|^2,   T = 4 eta_0 Re(eta_sub)/|eta_0 B + C|^2,
#   A = 4 eta_0 Re(B C* - eta_sub)/|eta_0 B + C|^2,
# which is R + T + A = 1 with A the power the LAYERS absorb and T the power that
# crosses into the substrate (for an absorbing substrate, the flux just inside
# it — Macleod's and Byrnes' convention). A is not formed as that difference: it is
# summed from the flux each ABSORBING layer (Im n~^2 = 2nk != 0) removes, so a
# stack whose layers are all lossless returns A = 0 exactly and T's error does not
# land on A (round 2 of the review: through 1600 lossless layers the difference
# came back as -9e-14).
#
# ⚠ ACCURACY, measured against 50-digit references:
#   - Each absorbing layer's share of A is a difference of the fluxes entering and
#     leaving it, so A is accurate to a few 1e-16 of the INCIDENT power per
#     absorbing layer, not relative to itself: k = 1e-9 gives A = 1.1e-8 with
#     2e-8 relative error. Resolving ppb absorption relatively needs the per-layer
#     field integral, which this does not compute.
#   - R and T carry a few ulps per layer, and through a strongly attenuating stack
#     T is conditioned by its own exponent: up to ~8e-16 sum Im delta relative
#     (3e-14 through 200 metal/dielectric periods, sum Im delta = 182; 2e-13
#     through 800 periods, sum Im delta = 640).
#
# Three things make it robust where the real-index TMM needed special branches:
#   - cos(delta) and sin(delta)/q are EVEN in q, and q^2 is known without a root,
#     so the layer matrix does not depend on which square root is taken — there
#     is no propagating/evanescent branch and no grazing (q = 0) singularity.
#     sin(delta)/q is formed as (2 pi d/lambda) sinc(delta) near delta = 0.
#   - Each layer matrix is scaled by exp(-|Im delta|), and the substrate flux and
#     the absorbed flux are multiplied by the same rounded exp(-2|Im delta|) (see
#     _diff_rta_apply). The vector is rescaled by exact powers of two when it
#     leaves [2^-256, 2^256], the substrate flux by 2^512 steps kept in an integer
#     exponent. An opaque layer's T underflows to 0 instead of the matrix
#     overflowing to NaN, which is what the real-index code's cosh/sinh clamp at
#     350 is for.
#   - Only the SUBSTRATE needs a branch: the principal root, Im q >= 0 (decaying
#     or, lossless, outgoing).
#   - q^2 is formed against the incident medium, q^2 = (n - n0)(n + n0) +
#     (n0 cos theta0)^2 - k^2 + 2ink: algebraically n~^2 - beta^2, but exact for a
#     medium index-matched to the incident one. Formed from beta, a matched
#     substrate near grazing lost q^2 to rounding and returned R = 1, T = 0 as
#     success (round 2).
# Validated against an independent 50-digit implementation of the interface /
# propagation formalism (Byrnes, arXiv:1603.02720) and Byrnes' own `tmm` package.

#derive(accessors)
struct AbsorbingFilmResult { r_s; r_p; t_s; t_p; a_s; a_p; r_avg; t_avg; a_avg; }

fn _diff_finite(x) {
    if ((x & _PRK_ABS) >= _PRK_INF) { return 0; }
    return 1;
}

# A complex index n + ik is admissible: both finite, >= 0 and <= 2^100, with
# max(n, k) >= 2^-100 — so every |n~| lies in [2^-100, 2^101] and no square,
# admittance or |eta_0 B + C|^2 leaves the double range. (Past those bounds the
# squares overflowed or underflowed into results returned as success: n0 = 1e-161
# on 1.3e-161 gave R_s 9.9% high.) 2^100 ~ 1.3e30, 2^-100 ~ 7.9e-31.
fn _diff_medium_ok(n, k) {
    if ((_diff_finite(n) & _diff_finite(k)) == 0) { return 0; }
    if ((f64_ge(n, 0) & f64_ge(k, 0)) == 0) { return 0; }
    if ((f64_le(n, 0x4630000000000000) & f64_le(k, 0x4630000000000000)) == 0) { return 0; }
    if ((f64_ge(n, 0x39B0000000000000) | f64_ge(k, 0x39B0000000000000)) == 0) { return 0; }
    return 1;
}

# exp(y) - 1 accurate for small y, given u = exp(y) already computed (Kahan: the
# same rounded exp in both halves, so its error cancels).
fn _diff_expm1(y, u) {
    if (u == F64_ONE) { return y; }
    var um1 = f64_sub(u, F64_ONE);
    if (f64_gt(f64_abs(y), F64_HALF) == 1) { return um1; }
    return f64_div(f64_mul(um1, y), f64_ln(u));
}

# Principal square root of x + iy into out[0], out[1]: Re >= 0, and Im carries
# y's sign (a zero y counts as positive, so a lossless evanescent root is +i|q|).
fn _diff_csqrt(x, y, out) {
    var r = f64_hypot(x, y);
    if (f64_ge(x, 0) == 1) {
        var t = f64_sqrt(f64_mul(F64_HALF, f64_add(r, x)));
        store64(out, t);
        if (t == 0) {
            store64(out + 8, 0);
            return 0;
        }
        store64(out + 8, f64_div(y, f64_add(t, t)));
        return 0;
    }
    var u = f64_sqrt(f64_mul(F64_HALF, f64_sub(r, x)));
    store64(out, f64_div(f64_abs(y), f64_add(u, u)));
    if (f64_lt(y, 0) == 1) { u = f64_neg(u); }
    store64(out + 8, u);
    return 0;
}

# (ar + i ai)/(br + i bi) into out[0], out[1] (Smith's algorithm: no squared
# magnitude, so no overflow a quotient does not itself have).
fn _diff_cdiv(ar, ai, br, bi, out) {
    if (f64_ge(f64_abs(br), f64_abs(bi)) == 1) {
        var r = f64_div(bi, br);
        var d = f64_add(br, f64_mul(bi, r));
        store64(out, f64_div(f64_add(ar, f64_mul(ai, r)), d));
        store64(out + 8, f64_div(f64_sub(ai, f64_mul(ar, r)), d));
        return 0;
    }
    var r2 = f64_div(br, bi);
    var d2 = f64_add(bi, f64_mul(br, r2));
    store64(out, f64_div(f64_add(f64_mul(ar, r2), ai), d2));
    store64(out + 8, f64_div(f64_sub(f64_mul(ai, r2), ar), d2));
    return 0;
}

# One layer applied to a polarization's state
#   st = [B_re, B_im, C_re, C_im, fe, fm, am],
# where fm 2^(512 fe) is the substrate flux Re(u w*) and am the flux absorbed so
# far, both carried in the SAME frame as the scaled vector:
# [B; C] <- [[cd, m12], [m21, cd]] [B; C] is the true layer times e^-b, so both
# are multiplied by e2 = e^-2b — the same rounded exponential the layer's
# cosh/sinh were built from, so the frames agree to rounding with no large exp at
# the end. A lossy layer (lossy = 1) then adds what it absorbed: the flux
# entering its front, Re(B C*) of the new vector, minus the flux leaving its back,
# the old Re(B C*) carried into the new frame by e2. The vector is rescaled by
# 2^-+256 while its largest component is outside [2^-256, 2^256] — fm by moving
# whole 2^512 steps into fe, am by multiplying (am <= Re(B C*) <= |v|^2, so it
# cannot overflow, and what underflows is below 2^-500 of the incident power) —
# and fm is kept in [2^-512, 2^512] by further steps into fe.
# (Round 1 of the review: the first cut summed Im delta into one exponent and
# applied e^(-2 sum) at the end; the sum's rounding landed on T and A, 1.3e-12
# relative through 200 absorbing layers.)
fn _diff_rta_apply(st, cdr, cdi, m12r, m12i, m21r, m21i, e2, lossy) {
    var br = load64(st);
    var bi = load64(st + 8);
    var cr = load64(st + 16);
    var ci = load64(st + 24);
    var nbr = f64_add(f64_sub(f64_mul(cdr, br), f64_mul(cdi, bi)),
      f64_sub(f64_mul(m12r, cr), f64_mul(m12i, ci)));
    var nbi = f64_add(f64_add(f64_mul(cdr, bi), f64_mul(cdi, br)),
      f64_add(f64_mul(m12r, ci), f64_mul(m12i, cr)));
    var ncr = f64_add(f64_sub(f64_mul(m21r, br), f64_mul(m21i, bi)),
      f64_sub(f64_mul(cdr, cr), f64_mul(cdi, ci)));
    var nci = f64_add(f64_add(f64_mul(m21r, bi), f64_mul(m21i, br)),
      f64_add(f64_mul(cdr, ci), f64_mul(cdi, cr)));
    var m = f64_max(f64_max(f64_abs(nbr), f64_abs(nbi)), f64_max(f64_abs(ncr), f64_abs(nci)));
    var fe = load64(st + 32);
    var fm = f64_mul(load64(st + 40), e2);
    var am = f64_mul(load64(st + 48), e2);
    if (lossy == 1) {
        var pre = f64_mul(f64_add(f64_mul(br, cr), f64_mul(bi, ci)), e2);
        var post = f64_add(f64_mul(nbr, ncr), f64_mul(nbi, nci));
        am = f64_add(am, f64_sub(post, pre));
    }
    # 2^256 = 0x4FF0000000000000, 2^-256 = 0x2FF0000000000000,
    # 2^512 = 0x5FF0000000000000, 2^-512 = 0x1FF0000000000000: exact rescalings.
    while ((f64_gt(m, 0x4FF0000000000000) & _diff_finite(m)) == 1) {
        nbr = f64_mul(nbr, 0x2FF0000000000000);
        nbi = f64_mul(nbi, 0x2FF0000000000000);
        ncr = f64_mul(ncr, 0x2FF0000000000000);
        nci = f64_mul(nci, 0x2FF0000000000000);
        m = f64_mul(m, 0x2FF0000000000000);
        am = f64_mul(am, 0x1FF0000000000000);
        fe = fe - 1;
    }
    while ((f64_lt(m, 0x2FF0000000000000) & f64_gt(m, 0)) == 1) {
        nbr = f64_mul(nbr, 0x4FF0000000000000);
        nbi = f64_mul(nbi, 0x4FF0000000000000);
        ncr = f64_mul(ncr, 0x4FF0000000000000);
        nci = f64_mul(nci, 0x4FF0000000000000);
        m = f64_mul(m, 0x4FF0000000000000);
        am = f64_mul(am, 0x5FF0000000000000);
        fe = fe + 1;
    }
    while ((f64_gt(fm, 0) & f64_lt(fm, 0x1FF0000000000000)) == 1) {
        fm = f64_mul(fm, 0x5FF0000000000000);
        fe = fe - 1;
    }
    while ((f64_gt(fm, 0x5FF0000000000000) & _diff_finite(fm)) == 1) {
        fm = f64_mul(fm, 0x1FF0000000000000);
        fe = fe + 1;
    }
    store64(st, nbr);
    store64(st + 8, nbi);
    store64(st + 16, ncr);
    store64(st + 24, nci);
    store64(st + 32, fe);
    store64(st + 40, fm);
    store64(st + 48, am);
    return 0;
}

# R, T, A of one polarization from its final state, with incident weights a0, b0
# (s: n0 cos0 and 1; p: n0 and cos0 — eta_0 = a0/b0 without dividing by a
# grazing cosine). T = w fm 2^(512 fe) with w = 4 a0 b0/|a0 B + b0 C|^2, the power
# of two applied in exact steps after the product so nothing underflows early;
# A = w am. Writes out[0..2].
fn _diff_rta_finish(st, a0, b0, out) {
    var br = load64(st);
    var bi = load64(st + 8);
    var cr = load64(st + 16);
    var ci = load64(st + 24);
    var fe = load64(st + 32);
    var denr = f64_add(f64_mul(a0, br), f64_mul(b0, cr));
    var deni = f64_add(f64_mul(a0, bi), f64_mul(b0, ci));
    var numr = f64_sub(f64_mul(a0, br), f64_mul(b0, cr));
    var numi = f64_sub(f64_mul(a0, bi), f64_mul(b0, ci));
    var dd = f64_add(f64_mul(denr, denr), f64_mul(deni, deni));
    var r = f64_div(f64_add(f64_mul(numr, numr), f64_mul(numi, numi)), dd);
    var w = f64_div(f64_mul(f64_mul(f64_from(4), a0), b0), dd);
    var t = f64_mul(w, load64(st + 40));
    while ((fe > 0) & _diff_finite(t)) {
        t = f64_mul(t, 0x5FF0000000000000);
        fe = fe - 1;
    }
    while ((fe < 0) & ((t & _PRK_ABS) != 0)) {
        t = f64_mul(t, 0x1FF0000000000000);
        fe = fe + 1;
    }
    store64(out, r);
    store64(out + 8, t);
    store64(out + 16, f64_mul(w, load64(st + 48)));
    return 0;
}

# Reflectance, transmittance and absorptance of an ABSORBING multilayer at
# oblique incidence, for s and p. `layers` holds num_layers (n, k, thickness)
# triples at a 24-byte stride, listed from the incident side; thickness and
# wavelength share a unit. The incident medium is lossless (n_incident real —
# R, T and the angle are not well defined in an absorbing one); the substrate is
# n_substrate + i k_substrate. Every n, k finite, >= 0 and <= 2^100 (~1.3e30),
# with max(n, k) >= 2^-100 (n_incident itself in [2^-100, 2^100]); every
# thickness finite and >= 0; |angle| < pi/2.
#
# Writes the result into `out`, an AbsorbingFilmResult the caller owns — one
# alloc(sizeof(AbsorbingFilmResult)) reused across a spectral sweep, rather than
# a fresh block per wavelength from an allocator that never frees. Returns
# PK_ERR_NONE, PK_ERR_INVALID_ANGLE for the angle, or PK_ERR_INVALID_PARAMETER
# (out untouched) for anything else, including a layer whose phase exceeds 2^42
# radians — past that an input's last bit moves the phase by more than 5e-4 rad,
# so the coherent answer is rounding noise, not optics.
fn multilayer_rta(wavelength, angle, n_incident, n_substrate, k_substrate, layers, num_layers, out) {
    _prk_trace("multilayer_rta");
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (num_layers < 0) { return PK_ERR_INVALID_PARAMETER; }
    if (num_layers > 0) { if (layers == 0) { return PK_ERR_INVALID_PARAMETER; } }
    if ((f64_gt(wavelength, 0) & _diff_finite(wavelength)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((f64_gt(n_incident, 0) & _diff_medium_ok(n_incident, 0)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_diff_medium_ok(n_substrate, k_substrate) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (f64_lt(f64_abs(angle), F64_PI_2) == 0) { return PK_ERR_INVALID_ANGLE; }
    # cos theta_0 near grazing as sin(pi/2 - |theta|), pi/2 split into its double
    # and the 6.1e-17 remainder: the subtraction is exact (Sterbenz) past pi/4, and
    # x87 fcos's ~2e-21 absolute error near pi/2 (f64_cos below cyrius 6.6.9, which
    # a consumer may still pin) would otherwise be the whole of a grazing cosine's
    # last digits — 7e-6 relative at pi/2 - 1 ulp, carried into eta_0 (R_p 2.7e-6
    # off on a 1e15 substrate; round 1 of the review).
    var c0 = _prk_cos(angle);
    if (f64_gt(f64_abs(angle), F64_PI_4) == 1) {
        c0 = _prk_sin(f64_add(f64_sub(F64_PI_2, f64_abs(angle)), 0x3C91A62633145C07));
    }
    # (n0 cos theta0)^2 = n0^2 - beta^2: q^2 is formed against it below.
    var n0c0 = f64_mul(n_incident, c0);
    var n0c02 = f64_mul(n0c0, n0c0);
    var tmp[16];
    # Substrate: q_s = principal sqrt(n~^2 - beta^2), eps_s = n~^2, with
    # n~^2 - beta^2 = (n - n0)(n + n0) + (n0 cos0)^2 - k^2 + 2ink.
    var esr = f64_mul(f64_sub(n_substrate, k_substrate), f64_add(n_substrate, k_substrate));
    var esi = f64_mul(f64_add(n_substrate, n_substrate), k_substrate);
    var nsd = f64_mul(f64_sub(n_substrate, n_incident), f64_add(n_substrate, n_incident));
    var qs2r = f64_sub(f64_add(nsd, n0c02), f64_mul(k_substrate, k_substrate));
    _diff_csqrt(qs2r, esi, &tmp);
    var qsr = load64(&tmp);
    var qsi = load64(&tmp + 8);
    # s starts at [1; eta_s] = [1; q_s]; p at [1/eta_s; 1] = [q_s/eps_s; 1], the p
    # vector divided through by eta_s so a substrate at exactly its critical angle
    # (q_s = 0, eta_p infinite) needs no special case. The flux Re(u w*) is
    # Re(eta_s) and Re(1/eta_s) respectively.
    var sts[56];
    var stp[56];
    store64(&sts, F64_ONE);
    store64(&sts + 8, 0);
    store64(&sts + 16, qsr);
    store64(&sts + 24, qsi);
    store64(&sts + 32, 0);
    store64(&sts + 40, qsr);
    store64(&sts + 48, 0);
    _diff_cdiv(qsr, qsi, esr, esi, &tmp);
    store64(&stp, load64(&tmp));
    store64(&stp + 8, load64(&tmp + 8));
    store64(&stp + 16, F64_ONE);
    store64(&stp + 24, 0);
    store64(&stp + 32, 0);
    store64(&stp + 40, load64(&tmp));
    store64(&stp + 48, 0);
    var kap0 = f64_div(F64_TAU, wavelength);
    var j = num_layers - 1;
    while (j >= 0) {
        var base = layers + j * 24;
        var n = load64(base);
        var k = load64(base + 8);
        var d = load64(base + 16);
        if (_diff_medium_ok(n, k) == 0) { return PK_ERR_INVALID_PARAMETER; }
        if ((f64_ge(d, 0) & _diff_finite(d)) == 0) { return PK_ERR_INVALID_PARAMETER; }
        var epr = f64_mul(f64_sub(n, k), f64_add(n, k));
        var epi = f64_mul(f64_add(n, n), k);
        var nd = f64_mul(f64_sub(n, n_incident), f64_add(n, n_incident));
        var q2r = f64_sub(f64_add(nd, n0c02), f64_mul(k, k));
        _diff_csqrt(q2r, epi, &tmp);
        var qr = load64(&tmp);
        var qi = load64(&tmp + 8);
        var kap = f64_mul(kap0, d);
        var a = f64_mul(kap, qr);
        var b = f64_mul(kap, qi);
        # 2^42 = 0x4290000000000000; the comparison is false for NaN too.
        if (f64_le(f64_abs(a), 0x4290000000000000) == 0) { return PK_ERR_INVALID_PARAMETER; }
        if (f64_ge(b, 0) == 0) { return PK_ERR_INVALID_PARAMETER; }
        # cos(delta), sin(delta) scaled by e^-b: cosh b -> (1 + e^-2b)/2,
        # sinh b -> (1 - e^-2b)/2, the latter through expm1 so the imaginary
        # parts keep their relative precision when b is small.
        var mb2 = f64_mul(f64_from(-2), b);
        var e2 = _prk_exp(mb2);
        var em = _diff_expm1(mb2, e2);
        var ch = f64_add(F64_ONE, f64_mul(F64_HALF, em));
        var sh = f64_neg(f64_mul(F64_HALF, em));
        var ca = _prk_cos(a);
        var sa = _prk_sin(a);
        var cdr = f64_mul(ca, ch);
        var cdi = f64_neg(f64_mul(sa, sh));
        # S = sin(delta)/q, scaled. Near delta = 0 it is kap * sinc(delta), by the
        # series through delta^8 (truncation below 2^-60 relative at |delta| < 2^-5).
        var sr = 0;
        var si = 0;
        if (f64_lt(f64_add(f64_mul(a, a), f64_mul(b, b)), 0x3F50000000000000) == 1) {
            var zr = f64_mul(f64_sub(a, b), f64_add(a, b));
            var zi = f64_mul(f64_add(a, a), b);
            # Horner in z: 1 + z(-1/6 + z(1/120 + z(-1/5040 + z/362880))).
            var pr = f64_div(F64_ONE, f64_from(362880));
            var pim = 0;
            var cf = f64_neg(f64_div(F64_ONE, f64_from(5040)));
            var tr = f64_add(f64_sub(f64_mul(pr, zr), f64_mul(pim, zi)), cf);
            var ti = f64_add(f64_mul(pr, zi), f64_mul(pim, zr));
            cf = f64_div(F64_ONE, f64_from(120));
            pr = f64_add(f64_sub(f64_mul(tr, zr), f64_mul(ti, zi)), cf);
            pim = f64_add(f64_mul(tr, zi), f64_mul(ti, zr));
            cf = f64_neg(f64_div(F64_ONE, f64_from(6)));
            tr = f64_add(f64_sub(f64_mul(pr, zr), f64_mul(pim, zi)), cf);
            ti = f64_add(f64_mul(pr, zi), f64_mul(pim, zr));
            pr = f64_add(f64_sub(f64_mul(tr, zr), f64_mul(ti, zi)), F64_ONE);
            pim = f64_add(f64_mul(tr, zi), f64_mul(ti, zr));
            var sc = f64_mul(kap, f64_sqrt(e2));
            sr = f64_mul(pr, sc);
            si = f64_mul(pim, sc);
        } else {
            _diff_cdiv(f64_mul(sa, ch), f64_mul(ca, sh), qr, qi, &tmp);
            sr = load64(&tmp);
            si = load64(&tmp + 8);
        }
        # P = q^2 S. s: m12 = -iS, m21 = -iP. p: m12 = -iP/eps, m21 = -i eps S.
        var pvr = f64_sub(f64_mul(q2r, sr), f64_mul(epi, si));
        var pvi = f64_add(f64_mul(q2r, si), f64_mul(epi, sr));
        # Lossy iff Im n~^2 = 2nk != 0 (n = 0 with k > 0 is a lossless Drude metal).
        var lossy = 0;
        if ((epi & _PRK_ABS) != 0) { lossy = 1; }
        _diff_rta_apply(&sts, cdr, cdi, si, f64_neg(sr), pvi, f64_neg(pvr), e2, lossy);
        _diff_cdiv(pvr, pvi, epr, epi, &tmp);
        var esr2 = f64_sub(f64_mul(epr, sr), f64_mul(epi, si));
        var esi2 = f64_add(f64_mul(epr, si), f64_mul(epi, sr));
        _diff_rta_apply(&stp, cdr, cdi, load64(&tmp + 8), f64_neg(load64(&tmp)), esi2, f64_neg(esr2), e2, lossy);
        j = j - 1;
    }
    var rs[24];
    var rp[24];
    _diff_rta_finish(&sts, f64_mul(n_incident, c0), F64_ONE, &rs);
    _diff_rta_finish(&stp, n_incident, c0, &rp);
    var i = 0;
    while (i < 3) {
        if ((_diff_finite(load64(&rs + i * 8)) & _diff_finite(load64(&rp + i * 8))) == 0) {
            return PK_ERR_INVALID_PARAMETER;
        }
        i = i + 1;
    }
    AbsorbingFilmResult_set_r_s(out, load64(&rs));
    AbsorbingFilmResult_set_t_s(out, load64(&rs + 8));
    AbsorbingFilmResult_set_a_s(out, load64(&rs + 16));
    AbsorbingFilmResult_set_r_p(out, load64(&rp));
    AbsorbingFilmResult_set_t_p(out, load64(&rp + 8));
    AbsorbingFilmResult_set_a_p(out, load64(&rp + 16));
    AbsorbingFilmResult_set_r_avg(out, f64_mul(F64_HALF, f64_add(load64(&rs), load64(&rp))));
    AbsorbingFilmResult_set_t_avg(out, f64_mul(F64_HALF, f64_add(load64(&rs + 8), load64(&rp + 8))));
    AbsorbingFilmResult_set_a_avg(out, f64_mul(F64_HALF, f64_add(load64(&rs + 16), load64(&rp + 16))));
    return PK_ERR_NONE;
}

# --- wave_doe.cyr ---

# wave_doe.cyr -- diffractive optics: the grating equation, scalar efficiencies of
# blazed, multilevel, binary and Dammann gratings, the diffractive lens, and volume
# holograms by Kogelnik's coupled-wave theory
# Usage: include "lib/wave_doe.cyr"  (requires error.cyr; ganita for asin/acos)
#
# New in 2.9.0, and NOT a port: the Rust crate had none of it, so every formula is
# checked against the literature and an independent evaluation, never against
# itself — Swanson, "Binary optics technology: the theory and design of multi-level
# diffractive optical elements", MIT Lincoln Lab TR-854 (1989); Dammann & Gortler,
# Opt. Commun. 3, 312 (1971); Stone & George, Appl. Opt. 27, 2960 (1988) for the
# diffractive Abbe number and hybrid achromats; Kogelnik, "Coupled wave theory for
# thick hologram gratings", Bell Syst. Tech. J. 48, 2909 (1969).
#
# CONVENTIONS. Time dependence e^(-i w t) (Goodman's, as ray_fresnel, ray_prt and wave_focus), so a
# converging lens SUBTRACTS phase: doe_lens_phase(r, f > 0) = -k r^2/(2f) paraxially. wave_beam
# follows Siegman's e^(+i w t), where the same lens adds +k r^2/(2f): conjugate one phase before
# comparing it with the other. (2.15.1: no convention was stated here, and the two signs read as
# a contradiction.) Lengths in any ONE unit; `wavelength` is the VACUUM wavelength.
# Angles in radians from the surface normal, positive toward +x. A phase depth is
# in WAVES (1 = a 2*pi step). The efficiency functions are SCALAR and THIN-element
# results: the fraction of transmitted power in each order of a periodic phase (or
# amplitude) profile, valid while the period is many wavelengths — they are the
# Fourier coefficients of the profile, not a rigorous (RCWA) solution. Kogelnik's
# theory is the THICK-grating limit (Klein Q = 2 pi lambda d/(n Lambda^2) >> 1),
# two waves, lossless, n1 << n.

# 1 if x is finite (not NaN, not +-inf).
fn _doe_finite(x) {
    if ((x & _PRK_ABS) >= _PRK_INF) { return 0; }
    return 1;
}

# 1 if x is finite and strictly positive. f64_gt is false for NaN.
fn _doe_pos(x) {
    if (f64_gt(x, 0) == 0) { return 0; }
    if (x == _PRK_INF) { return 0; }
    return 1;
}

# sin(pi x) with the argument reduced EXACTLY first: x = n + f, |f| <= 1/2, so an
# integer x gives exactly 0 (sin(pi * 3.0) through a rounded pi*x does not) and a
# half-integer exactly +-1. From 2^52 up every double is an integer: 0 (x + 1/2
# would tie to an even n there and leave f = -+1). NaN for a non-finite x.
fn _doe_sinpi(x) {
    if (_doe_finite(x) == 0) { return _PRK_NAN; }
    if (f64_ge(f64_abs(x), 0x4330000000000000) == 1) { return 0; }
    var n = f64_floor(f64_add(x, F64_HALF));
    var f = f64_sub(x, n);
    var s = f64_sin(f64_mul(F64_PI, f));
    # n odd flips the sign; past 2^53 every double is even.
    if (f64_sub(n, f64_mul(F64_TWO, f64_floor(f64_mul(F64_HALF, n)))) != 0) { s = f64_neg(s); }
    return s;
}

# cos(pi x), reduced as _doe_sinpi: cos(pi f) = sin(pi (1/2 - |f|)), 1/2 - |f|
# exact, so a half-integer gives exactly 0. From 2^52 up, +-1 by parity.
fn _doe_cospi(x) {
    if (_doe_finite(x) == 0) { return _PRK_NAN; }
    var ax = f64_abs(x);
    if (f64_ge(ax, 0x4340000000000000) == 1) { return F64_ONE; }
    var n = ax;
    if (f64_lt(ax, 0x4330000000000000) == 1) { n = f64_floor(f64_add(ax, F64_HALF)); }
    # fl(ax + 1/2) rounds to 1 just below 1/2 (round 2): n is 0 there, exactly.
    if (f64_lt(ax, F64_HALF) == 1) { n = 0; }
    var c = f64_sin(f64_mul(F64_PI, f64_sub(F64_HALF, f64_abs(f64_sub(ax, n)))));
    if (f64_sub(n, f64_mul(F64_TWO, f64_floor(f64_mul(F64_HALF, n)))) != 0) { c = f64_neg(c); }
    return c;
}

# expm1(y) accurate for small |y| (Kahan: (e^y - 1) y / ln(e^y) cancels the
# rounding of e^y).
fn _doe_expm1(y) {
    var w = f64_exp(y);
    if (w == F64_ONE) { return y; }
    var wm = f64_sub(w, F64_ONE);
    if (f64_gt(f64_abs(y), F64_HALF) == 1) { return wm; }
    return f64_div(f64_mul(wm, y), f64_ln(w));
}

# The normalised sinc(x) = sin(pi x)/(pi x), 1 at 0.
fn _doe_sinc(x) {
    if ((x & _PRK_ABS) == 0) { return F64_ONE; }
    return f64_div(_doe_sinpi(x), f64_mul(F64_PI, x));
}

# |sum_{j<N} e^{2 pi i x j/N}|^2 / N^2 = [sin(pi x)/(N sin(pi x/N))]^2 at
# x = alpha - m, formed so it keeps its bits where both sines vanish (x near kN):
# the numerator is sin(pi alpha) (= +-sin(pi x), m an integer), and the
# denominator's x is carried as fl(alpha - m) plus its exact rounding error
# (TwoSum), reduced by the multiple of N. (2.9.0 review: fl(alpha - m) alone lost
# alpha's low bits — a weak grating's orders came back 5e-11 off, and near x = kN
# up to 78%.) Clamped to the kernel's bound 1, which two rounded sines can pass.
fn _doe_dirichlet2(alpha, m, nlev) {
    var fl = f64_from(nlev);
    # The squared kernel is N-periodic in x: m mod N, in integers, keeps N k exact
    # whatever m is (round 2).
    var fm = f64_neg(f64_from(m % nlev));
    var hi = f64_add(alpha, fm);
    var bb = f64_sub(hi, alpha);
    var lo = f64_add(f64_sub(alpha, f64_sub(hi, bb)), f64_sub(fm, bb));
    var k = f64_floor(f64_add(f64_div(hi, fl), F64_HALF));
    var d = f64_add(f64_sub(hi, f64_mul(fl, k)), lo);
    var s2 = _doe_sinpi(f64_div(d, fl));
    if ((s2 & _PRK_ABS) == 0) { return F64_ONE; }
    var r = f64_div(_doe_sinpi(alpha), f64_mul(fl, s2));
    if (f64_gt(f64_abs(r), F64_ONE) == 1) { return F64_ONE; }
    return f64_mul(r, r);
}

# ── The grating equation ────────

# The direction of transmitted order m of a grating of period `period` between
# media n_in and n_out, for incidence theta_in:
#   n_out sin(theta_m) = n_in sin(theta_in) + m lambda / period.
# (A reflected order: n_out = n_in, theta_m measured on the incidence side.)
# Returns theta_m in [-pi/2, pi/2] and writes PK_ERR_NONE; for an evanescent
# order (|sin| > 1, including one whose m lambda/period is past the double range) PK_ERR_TIR and
# 0 — for order 0 that IS total internal reflection, as ray_snell reports it;
# PK_ERR_INVALID_PARAMETER and 0 for indices, wavelength or period not finite and
# positive, or a non-finite angle.
#must_use
fn grating_order_angle(n_in, n_out, theta_in, order, wavelength, period, err_out) {
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    if ((_doe_pos(n_in) & _doe_pos(n_out) & _doe_pos(wavelength) & _doe_pos(period)) == 0) { return 0; }
    var si = _prk_sin(theta_in);
    if (_doe_finite(si) == 0) { return 0; }
    var ml = f64_mul(f64_from(order), wavelength);
    var mt = f64_div(ml, period);
    # m lambda can overflow where m lambda/period does not (round 2): then m (lambda/period).
    if (_doe_finite(ml) == 0) { mt = f64_mul(f64_from(order), f64_div(wavelength, period)); }
    var s = f64_div(f64_add(f64_mul(n_in, si), mt), n_out);
    if (f64_le(f64_abs(s), F64_ONE) == 0) {
        # |s| > 1, or +-inf from an order term past the double range (NaN cannot arise).
        store64(err_out, PK_ERR_TIR);
        return 0;
    }
    store64(err_out, PK_ERR_NONE);
    return ganita_f64_asin(s);
}

# The propagating transmitted orders of the grating above: writes the lowest and
# highest m that grating_order_angle accepts (|sin theta_m| <= 1, grazing orders
# included) to range_out[0], range_out[1] (i64) and returns how many there are —
# 0 when none propagates (then range_out[1] < range_out[0]). Returns -1
# (range_out untouched) for arguments grating_order_angle refuses, a null
# range_out, or an order index beyond +-(2^31 - 1).
#must_use
fn grating_order_count(n_in, n_out, theta_in, wavelength, period, range_out) {
    if (range_out == 0) { return 0 - 1; }
    if ((_doe_pos(n_in) & _doe_pos(n_out) & _doe_pos(wavelength) & _doe_pos(period)) == 0) { return 0 - 1; }
    var si = _prk_sin(theta_in);
    if (_doe_finite(si) == 0) { return 0 - 1; }
    # m in [(-n_out - n_in sin) L/lambda, (n_out - n_in sin) L/lambda]
    var q = f64_div(period, wavelength);
    var a = f64_mul(f64_neg(f64_add(n_out, f64_mul(n_in, si))), q);
    var b = f64_mul(f64_sub(n_out, f64_mul(n_in, si)), q);
    var lim = f64_from(2147483647);
    if ((f64_lt(f64_abs(a), lim) & f64_lt(f64_abs(b), lim)) == 0) { return 0 - 1; }
    var lo = f64_to(f64_ceil(a));
    var hi = f64_to(f64_floor(b));
    # The bounds are the exact |sin| = 1 orders only to rounding: settle each with
    # the grating equation itself.
    var e = 0;
    var t = grating_order_angle(n_in, n_out, theta_in, lo - 1, wavelength, period, &e);
    if (e == PK_ERR_NONE) { lo = lo - 1; }
    t = grating_order_angle(n_in, n_out, theta_in, lo, wavelength, period, &e);
    if (e != PK_ERR_NONE) { lo = lo + 1; }
    t = grating_order_angle(n_in, n_out, theta_in, hi + 1, wavelength, period, &e);
    if (e == PK_ERR_NONE) { hi = hi + 1; }
    t = grating_order_angle(n_in, n_out, theta_in, hi, wavelength, period, &e);
    if (e != PK_ERR_NONE) { hi = hi - 1; }
    store64(range_out, lo);
    store64(range_out + 8, hi);
    if (hi < lo) { return 0; }
    return hi - lo + 1;
}

# ── Scalar efficiencies of thin gratings ────────

# 1 if alpha - m is exact and meaningful: alpha finite with |alpha| < 2^52 and
# |m| <= 2^52 (2.9.0 review: past them the staircase's N-periodic factor came back
# O(1) wrong — Parseval x4 at alpha = 1e300).
fn _doe_exact(order, alpha) {
    if (_doe_finite(alpha) == 0) { return 0; }
    if (f64_lt(f64_abs(alpha), 0x4330000000000000) == 0) { return 0; }
    if ((order > 4503599627370496) | (order < 0 - 4503599627370496)) { return 0; }
    return 1;
}

# Blazed (sawtooth) phase grating of peak phase 2 pi alpha (phase_depth = alpha,
# in waves): the fraction of power in order m is sinc^2(alpha - m) — 1 in order m
# when alpha = m, and summing to 1 over all m (Parseval). NaN for a non-finite
# phase depth, or |alpha| >= 2^52 or |m| > 2^52 (past those alpha - m is not
# exact, and the answer would be made up).
#must_use
fn doe_blazed_efficiency(order, phase_depth) {
    if (_doe_exact(order, phase_depth) == 0) { return _PRK_NAN; }
    # sin(pi (alpha - m)) = +-sin(pi alpha): the numerator from alpha itself keeps
    # the bits fl(alpha - m) drops (a weak blaze's orders).
    var x = f64_sub(phase_depth, f64_from(order));
    if ((x & _PRK_ABS) == 0) { return F64_ONE; }
    var s = f64_div(_doe_sinpi(phase_depth), f64_mul(F64_PI, x));
    return f64_mul(s, s);
}

# The phase depth, in waves, at `wavelength` of a surface-relief blaze in a
# material in air made for order design_order at design_wavelength:
#   alpha = M (lambda0/lambda) (n(lambda) - 1)/(n(lambda0) - 1),
# n_design = n(lambda0), n_at_wavelength = n(lambda) — the material dispersion is
# the caller's. Off design the blazed efficiency is then sinc^2(alpha - m). NaN
# for wavelengths not finite and positive, a non-finite index, n_design = 1, or a
# non-finite result.
#must_use
fn doe_phase_depth(design_order, design_wavelength, wavelength, n_design, n_at_wavelength) {
    if ((_doe_pos(design_wavelength) & _doe_pos(wavelength)) == 0) { return _PRK_NAN; }
    if ((_doe_finite(n_design) & _doe_finite(n_at_wavelength)) == 0) { return _PRK_NAN; }
    var den = f64_mul(wavelength, f64_sub(n_design, F64_ONE));
    var num = f64_mul(f64_mul(f64_from(design_order), design_wavelength), f64_sub(n_at_wavelength, F64_ONE));
    var a = f64_div(num, den);
    if (_doe_finite(a) == 0) { return _PRK_NAN; }
    return a;
}

# An N-level staircase approximation of a blaze of phase depth alpha (levels at
# 2 pi alpha j/N, j = 0..N-1, each 1/N of the period) — a multilevel kinoform:
#   eta_m = sinc^2(m/N) [sin(pi (alpha - m)) / (N sin(pi (alpha - m)/N))]^2
# (Swanson 1989). At alpha = 1 the first order carries sinc^2(1/N): 40.5% for
# N = 2, 81.1% for 4, 95.0% for 8; the rest goes to orders m = 1 + kN. N = 1 is
# a flat plate (all in order 0). NaN for levels outside 1..2^30, or alpha and m
# as doe_blazed_efficiency refuses them.
#must_use
fn doe_multilevel_efficiency(order, levels, phase_depth) {
    if ((levels < 1) | (levels > 1073741824)) { return _PRK_NAN; }
    if (_doe_exact(order, phase_depth) == 0) { return _PRK_NAN; }
    # sinc(m/N): sin^2(pi m/N) = sin^2(pi (m mod N)/N), reduced in integers so a
    # large order keeps its bits (round 2: fl(m/N) put m ~ 1e6 at 1e-10 relative).
    var s = F64_ONE;
    if (order != 0) {
        var fv = f64_from(levels);
        s = f64_div(_doe_sinpi(f64_div(f64_from(order % levels), fv)), f64_mul(F64_PI, f64_div(f64_from(order), fv)));
    }
    return f64_mul(f64_mul(s, s), _doe_dirichlet2(phase_depth, order, levels));
}

# A binary PHASE grating: phase 2 pi depth (depth in waves) over a fraction `duty`
# of the period, 0 elsewhere:
#   eta_0 = 1 - 4 D(1 - D) sin^2(pi depth) = cos^2(pi depth) + (1 - 2D)^2 sin^2(pi depth),
#   eta_m = [2 sin(pi depth) sin(pi m D) / (pi m)]^2   (m != 0),
# so a 50% 0/pi grating puts 4/pi^2 = 40.5% in each first order and nothing in
# the even ones. NaN for duty outside [0, 1] or a non-finite depth.
#must_use
fn doe_binary_phase_efficiency(order, duty, depth) {
    if ((f64_ge(duty, 0) & f64_le(duty, F64_ONE)) == 0) { return _PRK_NAN; }
    if (_doe_finite(depth) == 0) { return _PRK_NAN; }
    var sp = _doe_sinpi(depth);
    if (order == 0) {
        # cos^2(pi depth) + (1 - 2D)^2 sin^2(pi depth): the same number as
        # 1 - 4 D(1 - D) sin^2(pi depth) without the cancellation near a dark
        # zero order — the figure of merit of a 0/pi splitter (2.9.0 review).
        # Where 4 D(1 - D) <= 1/2 the plain form subtracts at most 1/2 — no
        # cancellation, never above 1, exactly 1 at D = 0 or 1 (round 2: the
        # cos^2 + sin^2 form gave 1 + 2 ulp there).
        var q4 = f64_mul(f64_from(4), f64_mul(duty, f64_sub(F64_ONE, duty)));
        var e0 = 0;
        if (f64_le(q4, F64_HALF) == 1) {
            e0 = f64_sub(F64_ONE, f64_mul(q4, f64_mul(sp, sp)));
        } else {
            var cp = _doe_cospi(depth);
            var od = f64_sub(F64_ONE, f64_mul(F64_TWO, duty));
            e0 = f64_add(f64_mul(cp, cp), f64_mul(f64_mul(od, od), f64_mul(sp, sp)));
        }
        if (f64_gt(e0, F64_ONE) == 1) { return F64_ONE; }
        return e0;
    }
    var fm = f64_from(order);
    var c = f64_div(f64_mul(f64_mul(F64_TWO, sp), _doe_sinpi(f64_mul(fm, duty))), f64_mul(F64_PI, fm));
    return f64_mul(c, c);
}

# A binary AMPLITUDE grating: transmission 1 over a fraction `duty` of the period,
# 0 elsewhere: eta_0 = D^2, eta_m = [sin(pi m D)/(pi m)]^2 — summing to D, the
# power it lets through. NaN for duty outside [0, 1].
#must_use
fn doe_binary_amplitude_efficiency(order, duty) {
    if ((f64_ge(duty, 0) & f64_le(duty, F64_ONE)) == 0) { return _PRK_NAN; }
    if (order == 0) { return f64_mul(duty, duty); }
    var fm = f64_from(order);
    var c = f64_div(_doe_sinpi(f64_mul(fm, duty)), f64_mul(F64_PI, fm));
    return f64_mul(c, c);
}

# A Dammann grating: a binary 0/pi phase grating, even about x = 0, whose phase
# flips at the `count` transition points x_1 < ... < x_J in (0, 1/2) of a period
# (Dammann & Gortler 1971). The order amplitudes are
#   c_0 = (-1)^J + 4 sum_k (-1)^(k+1) x_k,
#   c_m = (2/(pi m)) sum_k (-1)^(k+1) sin(2 pi m x_k),
# and eta_m = c_m^2 (eta_-m = eta_m; the eta sum to 1). A design chooses the x_k
# so that orders -K..K are equal. `transitions` is a buffer of `count` f64.
# Writes PK_ERR_NONE, or PK_ERR_INVALID_PARAMETER (returning 0) for a null buffer,
# count < 1, or transitions not finite, not strictly increasing, or outside
# (0, 1/2).
#must_use
fn doe_dammann_efficiency(transitions, count, order, err_out) {
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    if (transitions == 0) { return 0; }
    if (count < 1) { return 0; }
    var prev = 0;
    for (var k = 0; k < count; k = k + 1) {
        var x = load64(transitions + k * 8);
        if (f64_gt(x, prev) == 0) { return 0; }
        if (f64_lt(x, F64_HALF) == 0) { return 0; }
        prev = x;
    }
    var c = 0;
    var sg = F64_ONE;
    if (order == 0) {
        for (var j = 0; j < count; j = j + 1) {
            c = f64_add(c, f64_mul(sg, load64(transitions + j * 8)));
            sg = f64_neg(sg);
        }
        c = f64_mul(f64_from(4), c);
        if ((count % 2) == 1) { c = f64_sub(c, F64_ONE); } else { c = f64_add(c, F64_ONE); }
    } else {
        var tm = f64_mul(F64_TWO, f64_from(order));
        for (var i = 0; i < count; i = i + 1) {
            c = f64_add(c, f64_mul(sg, _doe_sinpi(f64_mul(tm, load64(transitions + i * 8)))));
            sg = f64_neg(sg);
        }
        c = f64_div(f64_mul(F64_TWO, c), f64_mul(F64_PI, f64_from(order)));
    }
    store64(err_out, PK_ERR_NONE);
    return f64_mul(c, c);
}

# ── The diffractive lens ────────

# The phase, in radians, a diffractive lens of focal length f (f < 0 diverging)
# must add at radius r to focus its design wavelength lambda0 — the optical-path
# difference to the focus, EXACT (not the paraxial -pi r^2/(lambda0 f)):
#   phi(r) = -sign(f) (2 pi/lambda0) (sqrt(f^2 + r^2) - |f|),
# formed as r^2/(sqrt(f^2 + r^2) + |f|), which keeps its bits at small r. The
# kinoform's surface wraps this modulo 2 pi. NaN for f zero or non-finite, lambda0
# not finite and positive, or a non-finite r.
#must_use
fn doe_lens_phase(r, focal_length, design_wavelength) {
    if (_doe_pos(design_wavelength) == 0) { return _PRK_NAN; }
    if ((_doe_finite(focal_length) == 0) | ((focal_length & _PRK_ABS) == 0)) { return _PRK_NAN; }
    if (_doe_finite(r) == 0) { return _PRK_NAN; }
    var af = f64_abs(focal_length);
    # r (r/(hypot(f, r) + |f|)): no r^2 to overflow, and r/(...) <= 1.
    var sag = f64_mul(f64_abs(r), f64_div(f64_abs(r), f64_add(f64_hypot(af, r), af)));
    var ph = f64_div(f64_mul(F64_TAU, sag), design_wavelength);
    if (f64_gt(focal_length, 0) == 1) { return f64_neg(ph); }
    return ph;
}

# The radius of the j-th zone boundary of that lens, where |phi| = 2 pi j:
#   r_j = sqrt(2 j lambda0 |f| + (j lambda0)^2)  (~ sqrt(2 j lambda0 f) paraxially).
# NaN for j < 0 or the arguments doe_lens_phase refuses.
#must_use
fn doe_lens_zone_radius(zone, focal_length, design_wavelength) {
    if (zone < 0) { return _PRK_NAN; }
    if (_doe_pos(design_wavelength) == 0) { return _PRK_NAN; }
    if ((_doe_finite(focal_length) == 0) | ((focal_length & _PRK_ABS) == 0)) { return _PRK_NAN; }
    var jl = f64_mul(f64_from(zone), design_wavelength);
    # sqrt(j lambda0) sqrt(2 |f| + j lambda0): the product is never formed.
    return f64_mul(f64_sqrt(jl), f64_sqrt(f64_add(f64_mul(F64_TWO, f64_abs(focal_length)), jl)));
}

# The focal length of diffraction order m of a diffractive lens made with focal
# length f0 at lambda0, at wavelength lambda: f = f0 lambda0/(m lambda) — the
# power grows with wavelength, the opposite of glass. NaN for m = 0 (order 0 does
# not focus), f0 zero or non-finite, or wavelengths not finite and positive.
#must_use
fn doe_lens_focal_length(f0, design_wavelength, wavelength, order) {
    if (order == 0) { return _PRK_NAN; }
    if ((_doe_pos(design_wavelength) & _doe_pos(wavelength)) == 0) { return _PRK_NAN; }
    if ((_doe_finite(f0) == 0) | ((f0 & _PRK_ABS) == 0)) { return _PRK_NAN; }
    var ml = f64_mul(f64_from(order), wavelength);
    if (_doe_finite(ml) == 0) { return _PRK_NAN; }
    var f = f64_div(f64_mul(f0, design_wavelength), ml);
    if (_doe_finite(f) == 0) { return _PRK_NAN; }
    return f;
}

# The Abbe number of a diffractive surface, V = lambda_d / (lambda_F - lambda_C):
# a property of the wavelengths alone — about -3.45 for the Fraunhofer d, F and C
# lines, negative and small where glasses are +20..+90 (Stone & George 1988). NaN
# for wavelengths not finite and positive or lambda_F = lambda_C.
#must_use
fn doe_abbe_number(lambda_d, lambda_f, lambda_c) {
    if ((_doe_pos(lambda_d) & _doe_pos(lambda_f) & _doe_pos(lambda_c)) == 0) { return _PRK_NAN; }
    var den = f64_sub(lambda_f, lambda_c);
    if ((den & _PRK_ABS) == 0) { return _PRK_NAN; }
    return f64_div(lambda_d, den);
}

# The power split of a thin hybrid ACHROMAT — a refractive lens of Abbe number
# v_refractive with a diffractive surface of Abbe number v_diffractive — of total
# power P: phi_r/V_r + phi_d/V_d = 0 and phi_r + phi_d = P give
#   phi_r = P V_r/(V_r - V_d),   phi_d = -P V_d/(V_r - V_d),
# so with a crown (V_r ~ 64) the diffractive surface carries only ~5% of the
# power. Writes phi_r, phi_d to out[0], out[1]. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER (out untouched) for a null out, non-finite arguments,
# V_r = V_d, V_r - V_d or a power overflowing.
fn doe_hybrid_achromat(total_power, v_refractive, v_diffractive, out) {
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((_doe_finite(total_power) & _doe_finite(v_refractive) & _doe_finite(v_diffractive)) == 0) {
        return PK_ERR_INVALID_PARAMETER;
    }
    var dv = f64_sub(v_refractive, v_diffractive);
    if ((dv & _PRK_ABS) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_doe_finite(dv) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var pr = f64_div(f64_mul(total_power, v_refractive), dv);
    var pd = f64_neg(f64_div(f64_mul(total_power, v_diffractive), dv));
    if ((_doe_finite(pr) & _doe_finite(pd)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    store64(out, pr);
    store64(out + 8, pd);
    return PK_ERR_NONE;
}

# ── Volume holograms (Kogelnik 1969) ────────

# A lossless volume phase grating: mean index n, index modulation n1
# (n(x) = n + n1 cos(K.x)), thickness d, period Lambda, and slant phi — the angle
# of the grating vector K from the surface normal z (pi/2: an unslanted
# TRANSMISSION grating, fringes normal to the surface; 0: an unslanted REFLECTION
# grating, fringes parallel to it). K and -K (phi and phi + pi) are the SAME
# fringes: the functions below take whichever first order the light meets.
#derive(accessors)
struct VolumeGrating { n; n1; thickness; period; slant; }

# A VolumeGrating; n, thickness and period finite and positive, n1 finite and
# >= 0 (0: a blank plate), |slant| <= 2 pi — an angle; past that it is a unit
# error, and past 2^52 it would have no phase at all. PK_ERR_INVALID_PARAMETER /
# PK_ERR_ALLOCATION and 0 otherwise.
#must_use
fn volume_grating_new(n, n1, thickness, period, slant, err_out) {
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    if ((_doe_pos(n) & _doe_pos(thickness) & _doe_pos(period)) == 0) { return 0; }
    if ((f64_ge(n1, 0) & _doe_finite(n1)) == 0) { return 0; }
    if (f64_le(f64_abs(slant), F64_TAU) == 0) { return 0; }
    var g = alloc(sizeof(VolumeGrating));
    if (g == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    VolumeGrating_set_n(g, n);
    VolumeGrating_set_n1(g, n1);
    VolumeGrating_set_thickness(g, thickness);
    VolumeGrating_set_period(g, period);
    VolumeGrating_set_slant(g, slant);
    store64(err_out, PK_ERR_NONE);
    return g;
}

# Klein's Q = 2 pi lambda d / (n Lambda^2): Kogelnik's two-wave theory is the
# Q >> 1 (thick, Bragg) regime — Q > 10 by the usual rule; Q < 1 is a thin
# (Raman-Nath) grating with many orders. NaN for a null grating or a wavelength
# not finite and positive.
#must_use
fn hologram_q_factor(g, wavelength) {
    if (g == 0) { return _PRK_NAN; }
    if (_doe_pos(wavelength) == 0) { return _PRK_NAN; }
    var p = VolumeGrating_period(g);
    var num = f64_mul(f64_mul(F64_TAU, wavelength), VolumeGrating_thickness(g));
    return f64_div(num, f64_mul(VolumeGrating_n(g), f64_mul(p, p)));
}

# t reduced into (-pi, pi] (t within a few 2 pi of it: the slant is bounded).
fn _doe_wrap(t) {
    var r = t;
    var k = 0;
    while (k < 4) {
        if (f64_gt(r, F64_PI) == 1) { r = f64_sub(r, F64_TAU); }
        if (f64_le(r, f64_neg(F64_PI)) == 1) { r = f64_add(r, F64_TAU); }
        k = k + 1;
    }
    return r;
}

# The Bragg angle inside the medium: a theta with |cos(phi - theta)| =
# lambda/(2 n Lambda) — Kogelnik's cos(phi - theta) = K/(2 beta) for K or for -K
# — at which a wave ENTERS (cos theta > 0). Of the roots phi - a, phi + a,
# phi + pi - a, phi + pi + a (a = acos(lambda/(2 n Lambda)), each reduced into
# (-pi, pi]) the one that enters nearest the normal is returned — on a tie (to
# 2^-40 rad) the one on the side of sin(phi), where K points: asin(lambda/(2 n
# Lambda)) for an unslanted transmission grating, +-acos(...) by the sign of phi
# for an unslanted reflection grating (0 at lambda = 2 n Lambda), and always
# theta_B(-phi) = -theta_B(phi). (2.9.0 review: phi - a alone came back pointing
# OUT of the slab for a negative slant, as success.) The other entering roots are
# the mirror incidence and the grating's other first order. A theta_B of +-pi/2
# grazes: hologram_efficiency has no answer there.
# PK_ERR_INVALID_ANGLE and 0 when lambda > 2 n Lambda or no root enters;
# PK_ERR_INVALID_PARAMETER and 0 for a null grating or a wavelength not finite and
# positive.
#must_use
fn hologram_bragg_angle(g, wavelength, err_out) {
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    if (g == 0) { return 0; }
    if (_doe_pos(wavelength) == 0) { return 0; }
    var r = f64_div(wavelength, f64_mul(F64_TWO, f64_mul(VolumeGrating_n(g), VolumeGrating_period(g))));
    if (f64_gt(r, F64_ONE) == 1) {
        store64(err_out, PK_ERR_INVALID_ANGLE);
        return 0;
    }
    var phi = VolumeGrating_slant(g);
    var a = ganita_f64_acos(r);
    # A tie is broken toward the sign of sin(phi) — the side K points to — which is
    # odd in phi and the same for phi and phi +- 2 pi (round 2).
    var sphi = _prk_sin(phi) & 0x8000000000000000;
    var best = 0;
    var found = 0;
    var k = 0;
    while (k < 4) {
        var t = f64_sub(phi, a);
        if (k == 1) { t = f64_add(phi, a); }
        if (k == 2) { t = f64_sub(f64_add(phi, F64_PI), a); }
        if (k == 3) { t = f64_add(f64_add(phi, F64_PI), a); }
        # A root already in (-pi, pi] is used unreduced: an in-range slant keeps
        # every bit.
        if ((f64_gt(t, F64_PI) | f64_le(t, f64_neg(F64_PI))) == 1) { t = _doe_wrap(t); }
        if (f64_gt(_prk_cos(t), 0) == 1) {
            # Strictly nearer, by more than the wrap's rounding: +-theta_B of an
            # unslanted grating tie, and the earlier root keeps them.
            var tol = f64_mul(0x3D70000000000000, f64_add(F64_ONE, f64_abs(best)));
            if ((found == 0) | f64_lt(f64_abs(t), f64_sub(f64_abs(best), tol))) {
                best = t;
                found = 1;
            } else {
                if (f64_le(f64_abs(t), f64_add(f64_abs(best), tol)) == 1) {
                    if (((t & 0x8000000000000000) == sphi) & ((best & 0x8000000000000000) != sphi)) { best = t; }
                }
            }
        }
        k = k + 1;
    }
    if (found == 0) {
        store64(err_out, PK_ERR_INVALID_ANGLE);
        return 0;
    }
    store64(err_out, PK_ERR_NONE);
    return best;
}

# The diffraction efficiency of the grating for a plane wave at angle theta INSIDE
# the medium (radians from z; refracting the wave in at the surface,
# n_outside sin theta_out = n sin theta, is the caller's), vacuum wavelength lambda,
# polarization 0 (TE, E normal to the plane of incidence) or 1 (TM) — Kogelnik's
# coupled-wave result for the FIRST ORDER NEAREST BRAGG, sigma = rho -+ K (the
# grating n1 cos(K.x) has both; the one with the smaller dephasing is taken, so
# slant phi and phi + pi, and the mirror incidence -theta_B, behave as the physics
# says — 2.9.0 review). With beta = 2 pi n/lambda, K = 2 pi/Lambda and K taken
# along the chosen sign,
#   c_R = cos theta,  c_S = cos theta - (K/beta) cos phi,
#   dephasing  theta_d = K cos(phi - theta) - K^2/(2 beta),
#   kappa = pi n1/lambda, times |r.s| for TM: rho.sigma/(|rho||sigma|) =
#     |beta - K cos(phi - theta)| / sqrt(beta^2 - 2 beta K cos(phi - theta) + K^2)
#     (Kogelnik eqs. 78-90; -cos 2(theta_B - phi) at Bragg).
# The diffracted wave's c_S decides the geometry:
#   TRANSMISSION (c_S > 0): nu = kappa d/sqrt(c_R c_S), xi = theta_d d/(2 c_S),
#     eta = [(nu/w) sin w]^2, w = sqrt(nu^2 + xi^2)  (sin^2 nu at Bragg; nu/w <= 1
#     keeps eta <= 1 in rounding too);
#   REFLECTION (c_S < 0): nu = kappa d/sqrt(c_R |c_S|), xi = theta_d d/(2 |c_S|),
#     eta = nu^2/(nu^2 + F), F = (s/sinh s)^2, s^2 = nu^2 - xi^2 (tanh^2 nu at
#     Bragg; past |xi| = nu, (q/sin q)^2 with q^2 = -s^2).
# Returns eta in [0, 1] and writes PK_ERR_NONE. PK_ERR_INVALID_ANGLE and 0 when
# c_R <= 2^-50 (the wave does not enter, or grazes) or c_S = 0 (the diffracted wave
# grazes: the theory has no answer there; sigma = 0 alike), and whenever the doubles
# do not resolve the answer: the sine's argument w or q to 2^-11 rad (against
# max(w, 1)), or, inside a reflection band, eta to 2^-11 relative or the band edge
# at all — a grazing c_S at rounding level, or a grating so strong or thick that
# the phase carries no fraction (2.9.0 review: those returned rounding noise, or
# 1.0, as success). PK_ERR_INVALID_PARAMETER and 0 for a null grating, a
# wavelength not finite and positive, an angle not finite or past 2 pi, or a
# polarization other than 0/1.
#must_use
fn hologram_efficiency(g, theta, wavelength, polarization, err_out) {
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    if (g == 0) { return 0; }
    if (_doe_pos(wavelength) == 0) { return 0; }
    if ((polarization != 0) & (polarization != 1)) { return 0; }
    # An angle past 2 pi is a unit error, as for the slant (round 2: an unwrapped
    # theta of 1e10 slipped phase past the resolution guard).
    if (f64_le(f64_abs(theta), F64_TAU) == 0) { return 0; }
    var cr = _prk_cos(theta);
    if (_doe_finite(cr) == 0) { return 0; }
    var cpt = _prk_cos(f64_sub(VolumeGrating_slant(g), theta));
    if (_doe_finite(cpt) == 0) { return 0; }
    store64(err_out, PK_ERR_INVALID_ANGLE);
    if (f64_gt(cr, 0x3CD0000000000000) == 0) { return 0; }
    var n = VolumeGrating_n(g);
    var d = VolumeGrating_thickness(g);
    var beta = f64_div(f64_mul(F64_TAU, n), wavelength);
    var kk = f64_div(F64_TAU, VolumeGrating_period(g));
    # The order nearer Bragg: -K when cos(phi - theta) < 0 (K^2/(2 beta) > 0 makes
    # K cos(phi - theta) - K^2/(2 beta) the smaller in magnitude for the sign that
    # makes K cos(phi - theta) >= 0).
    var kz = f64_mul(f64_div(kk, beta), _prk_cos(VolumeGrating_slant(g)));
    if (f64_lt(cpt, 0) == 1) {
        cpt = f64_neg(cpt);
        kz = f64_neg(kz);
    }
    var cs = f64_sub(cr, kz);
    if ((cs & _PRK_ABS) == 0) { return 0; }
    var kcos = f64_mul(kk, cpt);
    var k2b = f64_div(f64_mul(kk, kk), f64_mul(F64_TWO, beta));
    var deph = f64_sub(kcos, k2b);
    var kappa = f64_div(f64_mul(F64_PI, VolumeGrating_n1(g)), wavelength);
    if (polarization == 1) {
        var sg2 = f64_add(f64_sub(f64_mul(beta, beta), f64_mul(F64_TWO, f64_mul(beta, kcos))), f64_mul(kk, kk));
        # sigma = 0 is the degenerate c_S = 0 geometry.
        if (f64_gt(sg2, 0) == 0) { return 0; }
        var sg = f64_sqrt(sg2);
        kappa = f64_mul(kappa, f64_div(f64_abs(f64_sub(beta, kcos)), sg));
    }
    var acs = f64_abs(cs);
    var nu = f64_div(f64_mul(kappa, d), f64_sqrt(f64_mul(cr, acs)));
    var xi = f64_div(f64_mul(deph, d), f64_mul(F64_TWO, acs));
    var nu2 = f64_mul(nu, nu);
    var xi2 = f64_mul(xi, xi);
    # How well the doubles resolve the sine's argument: the rounding of c_R (x87
    # fcos near pi/2 is good to ~2^-68 absolute; f64_cos is 1 ulp from cyrius
    # 6.6.9, inside this bound), of c_S (which cancels near grazing)
    # and of the dephasing, carried into w^2 = nu^2 + xi^2 (or q^2 = xi^2 - nu^2).
    var ecr = f64_add(0x3BD0000000000000, f64_mul(0x3CB0000000000000, cr));
    var ecs = f64_add(f64_mul(0x3CB0000000000000, f64_add(cr, f64_abs(kz))), ecr);
    var rnu = f64_add(f64_mul(F64_HALF, f64_add(f64_div(ecr, cr), f64_div(ecs, acs))), 0x3CD0000000000000);
    var edp = f64_add(f64_mul(0x3CB0000000000000, f64_add(kk, k2b)), f64_mul(kk, 0x3BD0000000000000));
    var exi = f64_add(f64_mul(f64_abs(xi), f64_add(f64_div(ecs, acs), 0x3CD0000000000000)),
      f64_div(f64_mul(edp, d), f64_mul(F64_TWO, acs)));
    # Half the uncertainty of w^2 = nu^2 + xi^2 (and of s^2): (|xi| + exi) exi, not
    # the linear |xi| exi — a computed xi near 0 can hide an unresolved one (round 2).
    var earg2 = f64_add(f64_mul(nu2, rnu), f64_mul(f64_add(f64_abs(xi), exi), exi));
    # Past the double range (or NaN) no fraction of the phase survives.
    if ((_doe_finite(f64_add(nu2, xi2)) & _doe_finite(earg2)) == 0) { return 0; }
    var eta = 0;
    if (f64_gt(cs, 0) == 1) {
        var w = f64_sqrt(f64_add(nu2, xi2));
        var tw = 0;
        if ((w & _PRK_ABS) != 0) {
            # sinc^2 is flat below 1 rad: the argument's error counts against max(w, 1).
            if (f64_le(f64_div(earg2, f64_max(w, F64_ONE)), 0x3F40000000000000) == 0) { return 0; }
            # w >= |nu| in rounding too (fl(sqrt(fl(nu^2))) = |nu|), so nu/w <= 1.
            tw = f64_mul(f64_div(nu, w), _prk_sin(w));
        }
        eta = f64_mul(tw, tw);
    } else {
        var s2 = f64_sub(nu2, xi2);
        var ff = F64_ONE;
        if (f64_ge(s2, 0) == 1) {
            # Inside the band. The band edge within the uncertainty of s^2 is no
            # answer; nor is an eta whose propagated error passes 2^-11 (round 2:
            # this branch had no guard, and a grazing c_S gave tanh^2 nu, 4e4 x off).
            if (f64_le(f64_mul(F64_TWO, earg2), f64_add(s2, F64_ONE)) == 0) { return 0; }
            var s = f64_sqrt(s2);
            if (f64_gt(s2, 0) == 1) {
                # (s/sinh s)^2 = (2 s e^-s / (1 - e^-2s))^2: no overflow for large s,
                # and 1 - e^-2s through expm1 keeps its bits for small s.
                var den = f64_neg(_doe_expm1(f64_mul(f64_from(0 - 2), s)));
                var r = f64_div(f64_mul(F64_TWO, f64_mul(s, f64_exp(f64_neg(s)))), den);
                ff = f64_mul(r, r);
            }
            var rel = f64_mul(f64_div(ff, f64_add(nu2, ff)), f64_div(f64_mul(F64_TWO, earg2), f64_max(s, F64_ONE)));
            if (f64_le(rel, 0x3F40000000000000) == 0) { return 0; }
        }
        if (f64_lt(s2, 0) == 1) {
            var qq = f64_sqrt(f64_neg(s2));
            if (f64_le(f64_div(earg2, f64_max(qq, F64_ONE)), 0x3F40000000000000) == 0) { return 0; }
            var sq = _prk_sin(qq);
            if ((sq & _PRK_ABS) == 0) {
                store64(err_out, PK_ERR_NONE);
                return 0;
            }
            var rr = f64_div(qq, sq);
            ff = f64_mul(rr, rr);
        }
        eta = f64_div(nu2, f64_add(nu2, ff));
    }
    if (_doe_finite(eta) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    store64(err_out, PK_ERR_NONE);
    return eta;
}

# --- wave_zernike.cyr ---

# wave_zernike.cyr -- Zernike polynomials for wavefront / aberration analysis
# Usage: include "lib/wave_zernike.cyr"  (requires ganita for atan2)
#
# Ported from the Rust `wave/zernike.rs`. Noll sequential ordering. A
# ZernikeWavefront is a coefficient buffer (Noll order, index 0 = j=1 = piston)
# plus a length. `_zern_powi` replicates Rust `f64::powi` (square-and-multiply,
# __powidf2) so integer powers are bit-identical, not naive repeated multiply.

# Integer power of an f64 base via square-and-multiply (matches Rust powi).
fn _zern_powi(base, exp) {
    var r = F64_ONE;
    var a = base;
    var b = exp;
    var go = 1;
    while (go == 1) {
        if (b % 2 == 1) {
            r = f64_mul(r, a);
        }
        b = b / 2;
        if (b == 0) {
            go = 0;
        } else {
            a = f64_mul(a, a);
        }
    }
    return r;
}

# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _zern_eps15() { return 0x3CD203AF9EE75616; }
fn _zern_is_finite(x) { return f64_lt(f64_abs(x), 0x7FF0000000000000); }

# Radial Zernike polynomial R_n^|m|(rho). Returns 0 when |m| < 0, n<|m| or (n-|m|) is odd.
# Through the Jacobi polynomial it is (A&S 22.2.1; Born & Wolf 9.2, eq. 22),
#   R_n^m(rho) = (-1)^k rho^m P_k^(m,0)(1 - 2 rho^2),   k = (n - m)/2,
# and P_k comes from the three-term recurrence (A&S 22.7.1) with beta = 0, c = 2j + m:
#   2j(j + m)(c - 2) P_j = (c - 1)[c(c - 2)x + m^2] P_(j-1) - 2(j + m - 1)(j - 1)c P_(j-2),
# P_0 = 1, P_1 = (m + 1) - (m + 2) rho^2. Stable on [-1, 1]: within 1.4e-15 of exact rational
# arithmetic at 84 samples through n = 60, and R_n^m(1) = 1 exactly through n = 200.
# ⛔ 2.15.1: this summed the explicit series with i64 factorials. (n - s)! passes 2^63 at
# n = 21, so from there every value was garbage (R_22^0(1) = -1.2e3), and below it the alternating
# terms cancelled: R_20^0 lost 6 of its digits near rho = 1.
#must_use
fn zernike_radial(n, m_abs, rho) {
    if (m_abs < 0) { return f64_from(0); }
    if (n < m_abs) {
        return f64_from(0);
    }
    if ((n - m_abs) % 2 == 1) {
        return f64_from(0);
    }
    var k = (n - m_abs) / 2;
    var a = m_abs;
    var r2 = f64_mul(rho, rho);
    var p = F64_ONE;
    if (k >= 1) {
        var x = f64_sub(F64_ONE, f64_mul(F64_TWO, r2));
        var pm2 = F64_ONE;
        var pm1 = f64_sub(f64_from(a + 1), f64_mul(f64_from(a + 2), r2));
        for (var j = 2; j <= k; j = j + 1) {
            var c = 2 * j + a;
            var inner = f64_add(f64_mul(f64_from(c * (c - 2)), x), f64_from(a * a));
            var t1 = f64_mul(f64_mul(f64_from(c - 1), inner), pm1);
            var t2 = f64_mul(f64_from(2 * (j + a - 1) * (j - 1) * c), pm2);
            var pj = f64_div(f64_sub(t1, t2), f64_from(2 * j * (j + a) * (c - 2)));
            pm2 = pm1;
            pm1 = pj;
        }
        p = pm1;
    }
    var r = f64_mul(_zern_powi(rho, a), p);
    if (k % 2 == 1) { return f64_neg(r); }
    return r;
}

# Single Zernike polynomial Z_n^m(rho, theta). Norm = sqrt(n+1) for m=0,
# sqrt(2(n+1)) otherwise; angular = cos(|m|θ) (m>0), sin(|m|θ) (m<0), 1 (m=0).
# Returns 0 outside the unit disk (rho>1).
#must_use
fn zernike_poly(n, m, rho, theta) {
    if (f64_gt(rho, F64_ONE) == 1) {
        return f64_from(0);
    }
    var m_abs = m;
    if (m < 0) {
        m_abs = 0 - m;
    }
    var r = zernike_radial(n, m_abs, rho);
    var norm = f64_sqrt(f64_from(n + 1));
    if (m == 0) {
        norm = f64_sqrt(f64_from(n + 1));
    } else {
        norm = f64_sqrt(f64_mul(F64_TWO, f64_from(n + 1)));
    }
    var angular = F64_ONE;
    if (m > 0) {
        angular = _prk_cos(f64_mul(f64_from(m_abs), theta));
    } else {
        if (m < 0) {
            angular = _prk_sin(f64_mul(f64_from(m_abs), theta));
        }
    }
    return f64_mul(f64_mul(norm, r), angular);
}

# Noll sequential index j (1-based) -> (n, m). Writes n to n_out, m to m_out and returns
# PK_ERR_NONE. Returns PK_ERR_INVALID_PARAMETER and writes nothing for a null n_out or m_out,
# or a j outside [1, 2^31 - 1]. ⛔ 2.15.1: j = 0 used to write piston's (0, 0) and a negative j
# garbage, both as success, and the outputs were written through when null. The cap keeps the
# search below, O(sqrt(j)), short and its products in range.
fn zernike_noll_to_nm(j, n_out, m_out) {
    if ((n_out == 0) | (m_out == 0) | (j < 1) | (j > 2147483647)) { return PK_ERR_INVALID_PARAMETER; }
    var n = 0;
    while ((n + 1) * (n + 2) / 2 < j) {
        n = n + 1;
    }
    var k = j - n * (n + 1) / 2 - 1;
    var m_abs = 0;
    if (n % 2 == 0) {
        if (k == 0) {
            m_abs = 0;
        } else {
            m_abs = ((k + 1) / 2) * 2;
        }
    } else {
        m_abs = (k / 2) * 2 + 1;
    }
    var m = 0;
    if (m_abs == 0) {
        m = 0;
    } else {
        if (j % 2 == 0) {
            m = m_abs;
        } else {
            m = 0 - m_abs;
        }
    }
    store64(n_out, n);
    store64(m_out, m);
    return 0;
}

# (n, m) -> Noll sequential index j (1-based); 0 for a pair that is not a Zernike polynomial:
# n < 0, |m| > n, or n - |m| odd (2.15.1: those mapped onto real indices, (2, 1) onto j = 5,
# astigmatism, and (1, 0) onto j = 2, tilt).
#must_use
fn zernike_nm_to_noll(n, m) {
    var m_abs = m;
    if (m < 0) {
        m_abs = 0 - m;
    }
    if ((n < 0) | (m_abs > n) | ((n - m_abs) % 2 == 1)) { return 0; }
    var base = n * (n + 1) / 2 + 1;
    var slot_start = 0;
    if (n % 2 == 0) {
        if (m_abs == 0) {
            slot_start = 0;
        } else {
            slot_start = 2 * (m_abs / 2) - 1;
        }
    } else {
        slot_start = 2 * ((m_abs - 1) / 2);
    }
    if (m_abs == 0) {
        return base;
    }
    var j_first = base + slot_start;
    if (m > 0) {
        if (j_first % 2 == 0) {
            return j_first;
        }
        return j_first + 1;
    }
    if (j_first % 2 == 1) {
        return j_first;
    }
    return j_first + 1;
}

# ── Zernike wavefront (coefficient buffer in Noll order) ────────

#derive(accessors)
struct ZernikeWavefront { coeffs; len; }

# New wavefront from a Noll-ordered coefficient buffer (coeffs = ptr, len count).
#must_use
fn zernike_wf_new(coeffs, len) {
    var wf = alloc(sizeof(ZernikeWavefront));
    if (wf == 0) { return 0; }
    ZernikeWavefront_set_coeffs(wf, coeffs);
    ZernikeWavefront_set_len(wf, len);
    return wf;
}

# Flat (zero-aberration) wavefront.
#must_use
fn zernike_wf_flat() {
    return zernike_wf_new(0, 0);
}

# Evaluate the wavefront W(rho,theta) = sum_j c_j Z_j. Returns 0 outside pupil. Every nonzero
# coefficient counts: 2.15.1 found terms below 1e-15 dropped, which in metres is a wavefront of
# 1e-15 m whatever the aberration, and in waves of nothing at all.
# NaN for a null wavefront (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn zernike_wf_evaluate(wf, rho, theta) {
    if (wf == 0) { return _PRK_NAN; }
    if (f64_gt(rho, F64_ONE) == 1) {
        return f64_from(0);
    }
    var coeffs = ZernikeWavefront_coeffs(wf);
    var len = ZernikeWavefront_len(wf);
    var w = f64_from(0);
    # Stack locals, not `alloc(16)`: this runs once per grid cell from
    # zernike_wf_to_grid, and the bump allocator never frees, so a per-call
    # scratch buffer leaked 16 bytes per sample — more than the grid itself.
    var n = 0;
    var m = 0;
    for (var idx = 0; idx < len; idx = idx + 1) {
        var coeff = load64(coeffs + idx * 8);
        if ((coeff & 0x7FFFFFFFFFFFFFFF) != 0) {
            zernike_noll_to_nm(idx + 1, &n, &m);
            w = f64_add(w, f64_mul(coeff, zernike_poly(n, m, rho, theta)));
        }
    }
    return w;
}

# Sample the wavefront on a grid_size x grid_size grid (row-major); points
# outside the unit disk are 0. Returns a freshly allocated f64 buffer. A 1 x 1 grid is the pupil
# centre (2.15.1: its coordinate was 0/0, NaN, and the one cell stayed 0).
#must_use
fn zernike_wf_to_grid(wf, grid_size) {
    # `alloc` returns 0 past ALLOC_MAX (2 GiB) and on heap exhaustion; grid_size
    # is caller-supplied, so screen it before storing through the result.
    if (grid_size <= 0) { return 0; }
    if (grid_size > 16384) { return 0; }
    var total = grid_size * grid_size;
    var grid = alloc(total * 8);
    if (grid == 0) { return 0; }
    for (var z = 0; z < total; z = z + 1) {
        store64(grid + z * 8, f64_from(0));
    }
    if (grid_size == 1) {
        store64(grid, zernike_wf_evaluate(wf, f64_from(0), f64_from(0)));
        return grid;
    }
    var center = f64_div(f64_sub(f64_from(grid_size), F64_ONE), F64_TWO);
    for (var iy = 0; iy < grid_size; iy = iy + 1) {
        for (var ix = 0; ix < grid_size; ix = ix + 1) {
            var x = f64_div(f64_sub(f64_from(ix), center), center);
            var y = f64_div(f64_sub(f64_from(iy), center), center);
            var rho = f64_sqrt(f64_add(f64_mul(x, x), f64_mul(y, y)));
            if (f64_le(rho, F64_ONE) == 1) {
                var theta = ganita_f64_atan2(y, x);
                store64(grid + (iy * grid_size + ix) * 8, zernike_wf_evaluate(wf, rho, theta));
            }
        }
    }
    return grid;
}

# RMS wavefront error (excludes piston j=1, tilt X j=2, tilt Y j=3: Noll's even j is the cosine,
# so j = 2 is 2 rho cos(theta), x; 2.15.1 corrected the labels, which were swapped):
# RMS = sqrt(sum_{j>3} c_j^2).
# NaN for a null wavefront (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn zernike_wf_rms_error(wf) {
    if (wf == 0) { return _PRK_NAN; }
    var coeffs = ZernikeWavefront_coeffs(wf);
    var len = ZernikeWavefront_len(wf);
    var sum = f64_from(0);
    for (var idx = 3; idx < len; idx = idx + 1) {
        var c = load64(coeffs + idx * 8);
        sum = f64_add(sum, f64_mul(c, c));
    }
    return f64_sqrt(sum);
}

# Peak-to-valley wavefront error, grid-sampled over the unit pupil; one sample is the centre, so
# 0. NaN for samples < 1, where nothing is sampled (2.15.1: 0, a perfect wavefront, was
# reported for no measurement at all, and samples = 1 sampled 0/0).
#must_use
fn zernike_wf_peak_to_valley(wf, samples) {
    if (samples < 1) { return _PRK_NAN; }
    if (samples == 1) { return f64_from(0); }
    var minv = 0x7FF0000000000000;
    var maxv = 0xFFF0000000000000;
    var center = f64_div(f64_sub(f64_from(samples), F64_ONE), F64_TWO);
    for (var iy = 0; iy < samples; iy = iy + 1) {
        for (var ix = 0; ix < samples; ix = ix + 1) {
            var x = f64_div(f64_sub(f64_from(ix), center), center);
            var y = f64_div(f64_sub(f64_from(iy), center), center);
            var rho = f64_sqrt(f64_add(f64_mul(x, x), f64_mul(y, y)));
            if (f64_le(rho, F64_ONE) == 1) {
                var w = zernike_wf_evaluate(wf, rho, ganita_f64_atan2(y, x));
                if (f64_lt(w, minv) == 1) {
                    minv = w;
                }
                if (f64_gt(w, maxv) == 1) {
                    maxv = w;
                }
            }
        }
    }
    if (_zern_is_finite(minv) == 1) {
        if (_zern_is_finite(maxv) == 1) {
            return f64_sub(maxv, minv);
        }
    }
    return f64_from(0);
}

# Strehl ratio (Marechal): S = exp(-(2*pi*sigma)^2), sigma = RMS/wavelength. NaN unless the
# wavelength is finite and > 0 (2.15.1: lambda = 0 answered 0 and a negative one a number).
# NaN for a null wavefront (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn zernike_wf_strehl_ratio(wf, wavelength) {
    if (wf == 0) { return _PRK_NAN; }
    if ((f64_gt(wavelength, f64_from(0)) & f64_lt(wavelength, 0x7FF0000000000000)) == 0) { return _PRK_NAN; }
    var sigma = f64_div(zernike_wf_rms_error(wf), wavelength);
    var x = f64_mul(f64_mul(F64_TWO, F64_PI), sigma);
    return _prk_exp(f64_neg(f64_mul(x, x)));
}

# ── Named aberrations ────────

fn _zern_single(len, idx, amount) {
    if (len <= 0) { return 0; }
    var c = alloc(len * 8);
    if (c == 0) { return 0; }
    for (var i = 0; i < len; i = i + 1) {
        store64(c + i * 8, f64_from(0));
    }
    store64(c + idx * 8, amount);
    return zernike_wf_new(c, len);
}

# Defocus (Noll j=4).
#must_use
fn zernike_defocus(amount) { return _zern_single(4, 3, amount); }

# Primary spherical aberration (Noll j=11).
#must_use
fn zernike_spherical(amount) { return _zern_single(11, 10, amount); }

# Primary coma X (Noll j=8).
#must_use
fn zernike_coma_x(amount) { return _zern_single(8, 7, amount); }

# Primary coma Y (Noll j=7).
#must_use
fn zernike_coma_y(amount) { return _zern_single(7, 6, amount); }

# Astigmatism 0 degrees (Noll j=6).
#must_use
fn zernike_astigmatism_0(amount) { return _zern_single(6, 5, amount); }

# Astigmatism 45 degrees (Noll j=5).
#must_use
fn zernike_astigmatism_45(amount) { return _zern_single(5, 4, amount); }

# --- wave_pattern.cyr ---

# wave_pattern.cyr -- 2D diffraction / interference / SPD strip / PSF patterns
# Usage: include "lib/wave_pattern.cyr"  (requires hisab for num_fft)
#
# Ported from the Rust `wave/pattern.rs`. Uses hisab's FFT (num_fft) on packed
# complex buffers: element i has re at byte i*16, im at i*16+8 (matching hisab
# HComplex layout). Pattern2D.data is a row-major f64 buffer.

fn _pat_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# Next power of two >= n, clamped. Returns 0 for n <= 0 or for an n large
# enough that the doubling would overflow — callers treat 0 as "unusable size"
# and bail, rather than looping into a negative p.
fn _pat_npot(n) {
    if (n <= 0) { return 0; }
    if (n > 1073741824) { return 0; }
    var p = 1;
    while (p < n) {
        p = p * 2;
    }
    return p;
}

# |grid[idx]|^2 = re^2 + im^2 from a packed complex buffer.
fn _pat_norm_sq(grid, idx) {
    var re = load64(grid + idx * 16);
    var im = load64(grid + idx * 16 + 8);
    return f64_add(f64_mul(re, re), f64_mul(im, im));
}

# ── Pattern2D ────────

#derive(accessors)
struct Pattern2D { data; width; height; }

# 1 if a `width` x `height` buffer of `elem_bytes`-sized cells cannot be
# allocated: non-positive dimensions, a multiplication that overflows i64, or a
# request past what `alloc` will serve. `alloc` returns 0 above ALLOC_MAX
# (0x80000000 = 2 GiB) and on heap exhaustion, so the size has to be screened
# BEFORE the product is formed — `width * height * elem_bytes` can wrap to a
# small positive number, which would allocate a tiny buffer and then be written
# far past its end.
#must_use
fn _pat_dims_bad(width, height, elem_bytes) {
    if (width <= 0) { return 1; }
    if (height <= 0) { return 1; }
    var total = width * height;
    if (total / width != height) { return 1; }
    if (total > 2147483648 / elem_bytes) { return 1; }
    return 0;
}

# Allocate a Pattern2D and its buffer WITHOUT initialising the cells.
#
# ⚠ Every cell is garbage on return. This exists only for callers that write all
# `width * height` cells before anything reads one, and it is private for exactly
# that reason — `pattern2d_new` is public API and keeps its zero-fill, because a
# consumer may rely on a fresh pattern reading as zero. (No current consumer calls
# it: ranga uses only the spectral surface, and the Rust 1.x consumers cannot
# reach the bundle. It is still public API; this used to name all three.)
# Dropping the fill from the public constructor would be a silent contract
# change, not an optimisation.
#
# The fill is not free: it is `width * height` stores, 4096 of them for the 64x64
# pattern the suite benchmarks. Measured same-binary with interleaved arms on
# `pattern2d_normalized`, which overwrites every cell either way:
# **15.32 us -> 11.13 us (-27.4%)**, all 4096 cells bit-identical.
#
# ⚠ Hoisting `f64_from(0)` out of the loop was tried first and is NOT the win —
# it measured slightly SLOWER (6.26 us vs 6.02 us). `f64_from(0)` already costs
# nothing; the stores are the cost. Recorded so it is not retried.
#must_use
fn _pattern2d_new_uninit(width, height) {
    if (_pat_dims_bad(width, height, 8) == 1) { return 0; }
    var p = alloc(sizeof(Pattern2D));
    if (p == 0) { return 0; }
    var total = width * height;
    var data = alloc(total * 8);
    if (data == 0) { return 0; }
    Pattern2D_set_data(p, data);
    Pattern2D_set_width(p, width);
    Pattern2D_set_height(p, height);
    return p;
}

# New zero-filled pattern (width x height, row-major). Returns 0 if the
# dimensions are unusable or the allocation fails.
#
# Public: a fresh pattern reads as zero and consumers may depend on that. Internal
# callers that overwrite every cell should use `_pattern2d_new_uninit` instead —
# see its header.
#
# ⚠ This function's `#must_use` was silently lost in 2.3.3, when
# `_pattern2d_new_uninit` was inserted above it and took this doc block and the
# attribute with it. It went unnoticed for six releases because
# `scripts/check-must-use.sh` did not exist until 2.3.6 and baselines against the
# previous commit — a loss that PREDATES the gate is invisible to it. Restored in
# 2.4.0, found by reconciling the gate's count against a raw grep.
#must_use
fn pattern2d_new(width, height) {
    var p = _pattern2d_new_uninit(width, height);
    if (p == 0) { return 0; }
    var data = Pattern2D_data(p);
    var total = width * height;
    for (var i = 0; i < total; i = i + 1) {
        store64(data + i * 8, 0);
    }
    return p;
}

# Intensity at (col, row). NaN for a null pattern or an out-of-range index, rather than reading
# outside the buffer (2.15.1: 0.0, which is also a legitimate intensity).
#must_use
fn pattern2d_get(p, col, row) {
    if (p == 0) { return _PRK_NAN; }
    if (col < 0) { return _PRK_NAN; }
    if (row < 0) { return _PRK_NAN; }
    if (col >= Pattern2D_width(p)) { return _PRK_NAN; }
    if (row >= Pattern2D_height(p)) { return _PRK_NAN; }
    return load64(Pattern2D_data(p) + (row * Pattern2D_width(p) + col) * 8);
}

# Store an intensity at (col, row). Returns PK_ERR_NONE on success, or
# PK_ERR_INVALID_PARAMETER if the pattern is null or the index is out of range
# (previously it wrote past the buffer).
fn pattern2d_set(p, col, row, value) {
    if (p == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (col < 0) { return PK_ERR_INVALID_PARAMETER; }
    if (row < 0) { return PK_ERR_INVALID_PARAMETER; }
    if (col >= Pattern2D_width(p)) { return PK_ERR_INVALID_PARAMETER; }
    if (row >= Pattern2D_height(p)) { return PK_ERR_INVALID_PARAMETER; }
    store64(Pattern2D_data(p) + (row * Pattern2D_width(p) + col) * 8, value);
    return 0;
}

# Maximum intensity (fold from 0.0).
# NaN for a null pattern (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn pattern2d_max_intensity(p) {
    # 0 is a routine return from pattern2d_new, diffraction_pattern_2d,
    # diffraction_pattern_circular, psf_from_wavefront, psf_diffraction_limited
    # and interference_pattern, and every sibling accessor already tolerates it.
    # Without this the first statement is load64(0). 0.0 is also the fold's own
    # identity, so an absent pattern degrades to "empty, max 0.0".
    if (p == 0) { return _PRK_NAN; }
    var data = Pattern2D_data(p);
    var total = Pattern2D_width(p) * Pattern2D_height(p);
    var m = f64_from(0);
    for (var i = 0; i < total; i = i + 1) {
        var v = load64(data + i * 8);
        if (f64_gt(v, m) == 1) {
            m = v;
        }
    }
    return m;
}

# Normalize to [0,1] relative to the maximum; clone unchanged if max < 1e-30.
#must_use
fn pattern2d_normalized(p) {
    if (p == 0) { return 0; }
    var maxv = pattern2d_max_intensity(p);
    var width = Pattern2D_width(p);
    var height = Pattern2D_height(p);
    # Uninitialised: both branches below write all `total` cells before any
    # read — the scalar clone loop, or f64v_scale plus the odd-count tail.
    var out = _pattern2d_new_uninit(width, height);
    if (out == 0) { return 0; }
    var total = width * height;
    var data = Pattern2D_data(p);
    var odata = Pattern2D_data(out);
    if (f64_lt(maxv, 0x39B4484BFEEBC2A0) == 1) {
        # An 8-byte scalar loop, NOT memcpy: lib/string.cyr's memcpy is
        # byte-at-a-time (store8 in a while loop) and measured 7.6x SLOWER than
        # this (48.8us vs 6.4us per 4096 f64). Nor f64v_scale by 1.0 — this
        # branch is meant to clone values through untouched, and multiplying
        # would not preserve a NaN payload.
        for (var i = 0; i < total; i = i + 1) {
            store64(odata + i * 8, load64(data + i * 8));
        }
        return out;
    }
    var inv = f64_div(F64_ONE, maxv);
    # SIMD (2.2.0): one bulk `f64v_scale` over the whole grid replaces the
    # per-element scalar loop. Measured on a 64x64 pattern, whole function:
    # 35.2us -> 26.0us (-26%); the scale step itself goes 9.15us -> 1.05us per
    # 4096 elements (8.7x). The rest of the function is pattern2d_max_intensity
    # and pattern2d_new's zero-fill, neither of which has a SIMD form here
    # (no f64v_max, no f64v_fill).
    #
    # BIT-IDENTICAL: a lane-wise IEEE-754 multiply rounds exactly as the scalar
    # one does, so no value moves — asserted in tests/simd.tcyr.
    #
    # It must be ONE call spanning the range, not chunks: per-4-element calls
    # measured 2.83us/4096 against 1.05us for the single call, and the typed
    # f64v2/f64v4 wrappers are SLOWER than scalar (23.0us / 20.3us per 4096) —
    # their ABI plus per-lane extraction costs more than the arithmetic saves.
    #
    # ⚠ `f64v_scale` PROCESSES IN PAIRS AND ROUNDS THE COUNT UP: given an odd
    # count it writes one f64 PAST the end (measured for every odd n in 1..12).
    # `total` is width*height, which is odd for e.g. 3x5 or 7x7, so the even
    # prefix is vectorised and the final element done scalar. Without this the
    # call corrupts the 8 bytes after the grid.
    var vec_n = total - (total % 2);
    if (vec_n > 0) {
        f64v_scale(odata, data, inv, vec_n);
    }
    if (total % 2 == 1) {
        store64(odata + vec_n * 8, f64_mul(load64(data + vec_n * 8), inv));
    }
    return out;
}

# ── Grow-only scratch caches ────────
#
# prakash's allocator never frees, so a per-call scratch buffer is permanent
# consumption. These three hold the working buffers of the 2D diffraction path,
# which is where the volume is: diffraction_pattern_2d(64x64) allocated 99,352
# bytes per call, 66,560 of it scratch.
#
# ⛔ THREE SEPARATE CACHES, NOT ONE POOL. All three buffers are SIMULTANEOUSLY
# LIVE at the bottom of psf_diffraction_limited -> diffraction_pattern_circular
# -> diffraction_pattern_2d -> _pat_fft2d. Sharing one pool was measured to
# corrupt silently: col_buf landing on grid gave 993 of 1024 wrong cells,
# aperture on grid gave 1024 of 1024, and both calls returned PK_ERR_NONE. Never
# collapse these into a generic _pat_scratch_get(n).
#
# ⚠ The two `grid` sites CAN share _pat_grid_c: diffraction_pattern_2d and
# psf_from_wavefront never have a grid live at the same time (verified across a
# cache grow with a retained result, 0 diffs). Nothing beyond that may share.
#
# ⚠ Grow-only, never shrink: a later smaller call reuses the larger block.
#
# ⛔ NOT THREAD-SAFE, and that is a real narrowing. A per-call alloc() was safe
# for concurrent callers because _threads_active arms alloc()'s lock the moment a
# CONSUMER spawns a thread. These caches are not. prakash makes no thread-safety
# claim and never spawns a thread itself; a threaded consumer must serialise
# calls into the 2D diffraction path. Stated in docs/guides/allocation.md.
var _pat_grid_c = 0;
var _pat_grid_n = 0;
var _pat_apert_c = 0;
var _pat_apert_n = 0;
var _pat_col_c = 0;
var _pat_col_n = 0;
# The _prk_cache_epoch these six blocks were allocated under. When
# prakash_reset_caches() moves it on, all six belong to a heap alloc_reset()
# already reclaimed, and they are dropped before any is reused (2.5.1).
var _pat_epoch = 0;

# Return a scratch block of at least `want` bytes from the cache at `cache_p` /
# `size_p`, growing it if needed. Returns 0 if the allocation fails, leaving the
# previous block intact.
#must_use
fn _pat_scratch(cache_p, size_p, want) {
    if (_pat_epoch != _prk_cache_epoch) {
        _pat_grid_c = 0;
        _pat_grid_n = 0;
        _pat_apert_c = 0;
        _pat_apert_n = 0;
        _pat_col_c = 0;
        _pat_col_n = 0;
        _pat_epoch = _prk_cache_epoch;
    }
    if (load64(size_p) >= want) { return load64(cache_p); }
    var b = alloc(want);
    if (b == 0) { return 0; }
    store64(cache_p, b);
    store64(size_p, want);
    return b;
}

# ── 2D FFT plumbing (row FFTs then column FFTs, hisab num_fft) ────────

# Returns PK_ERR_NONE on success, PK_ERR_ALLOCATION if the column scratch
# buffer cannot be allocated, PK_ERR_INVALID_PARAMETER if hisab's FFT rejects a
# dimension.
#
# hisab 3.0.0 moved num_fft onto the stdlib Result: it is Ok(0) on success and
# Err(HSB_ERR_INVALID_INPUT) for any n that is not a power of two, and it
# carries #must_use. Both callers size nw/nh through _pat_next_pow2, so the Err
# path is defensive rather than reachable — it is propagated anyway because a
# discarded Err hands back a HALF-TRANSFORMED grid that _pat_fftshift_to_pattern
# would then square into a plausible-looking diffraction pattern. Reporting beats
# fabricating; a wrong intensity map is worse than a returned error code.
fn _pat_fft2d(grid, nw, nh) {
    for (var row = 0; row < nh; row = row + 1) {
        var rt, rv = num_fft(grid + row * nw * 16, nw);
        if (is_err_result(rt) == 1) { return PK_ERR_INVALID_PARAMETER; }
    }
    var col_buf = _pat_scratch(&_pat_col_c, &_pat_col_n, nh * 16);
    if (col_buf == 0) { return PK_ERR_ALLOCATION; }
    for (var col = 0; col < nw; col = col + 1) {
        for (var rr = 0; rr < nh; rr = rr + 1) {
            store64(col_buf + rr * 16, load64(grid + (rr * nw + col) * 16));
            store64(col_buf + rr * 16 + 8, load64(grid + (rr * nw + col) * 16 + 8));
        }
        var ct, cv = num_fft(col_buf, nh);
        if (is_err_result(ct) == 1) { return PK_ERR_INVALID_PARAMETER; }
        for (var rw = 0; rw < nh; rw = rw + 1) {
            store64(grid + (rw * nw + col) * 16, load64(col_buf + rw * 16));
            store64(grid + (rw * nw + col) * 16 + 8, load64(col_buf + rw * 16 + 8));
        }
    }
    return PK_ERR_NONE;
}

# |E|^2 with fftshift (DC to center) into a fresh Pattern2D.
fn _pat_fftshift_to_pattern(grid, nw, nh) {
    # Uninitialised: the nested loop below sets every (col, row) of the nw*nh
    # grid via pattern2d_set before anything reads it.
    var pattern = _pattern2d_new_uninit(nw, nh);
    if (pattern == 0) { return 0; }
    for (var row = 0; row < nh; row = row + 1) {
        for (var col = 0; col < nw; col = col + 1) {
            var sr = (row + nh / 2) % nh;
            var sc = (col + nw / 2) % nw;
            pattern2d_set(pattern, col, row, _pat_norm_sq(grid, sr * nw + sc));
        }
    }
    return pattern;
}

# ── 2D Diffraction ────────

# 2D Fraunhofer diffraction from an arbitrary aperture (row-major f64 grid,
# 0=opaque..1=clear). Dimensions padded to the next power of 2. Returns |E|^2.
# Returns 0 if the padded dimensions are unusable or the complex grid cannot be
# allocated. Note the power-of-two padding: a width of 8193 pads to 16384, so
# the 16-byte-per-cell grid is 4 GiB and `alloc` refuses it.
#must_use
fn diffraction_pattern_2d(aperture, width, height) {
    _prk_trace("diffraction_pattern_2d");
    if (aperture == 0) { return 0; }
    var nw = _pat_npot(width);
    var nh = _pat_npot(height);
    if (nw == 0) { return 0; }
    if (nh == 0) { return 0; }
    if (_pat_dims_bad(nw, nh, 16) == 1) { return 0; }
    var grid = _pat_scratch(&_pat_grid_c, &_pat_grid_n, nw * nh * 16);
    if (grid == 0) { return 0; }
    var total = nw * nh;
    for (var z = 0; z < total; z = z + 1) {
        store64(grid + z * 16, f64_from(0));
        store64(grid + z * 16 + 8, f64_from(0));
    }
    for (var row = 0; row < height; row = row + 1) {
        for (var col = 0; col < width; col = col + 1) {
            store64(grid + (row * nw + col) * 16, load64(aperture + (row * width + col) * 8));
            store64(grid + (row * nw + col) * 16 + 8, f64_from(0));
        }
    }
    if (_pat_fft2d(grid, nw, nh) != 0) { return 0; }
    return _pat_fftshift_to_pattern(grid, nw, nh);
}

# 2D diffraction pattern of a circular aperture (radius in grid pixels) -> Airy. 0 unless the
# radius is >= 0 (2.15.1: NaN gave an all-dark pattern and a negative radius |radius|'s).
#must_use
fn diffraction_pattern_circular(grid_size, radius) {
    _prk_trace("diffraction_pattern_circular");
    if (f64_ge(radius, f64_from(0)) == 0) { return 0; }
    var n = _pat_npot(grid_size);
    if (n == 0) { return 0; }
    if (_pat_dims_bad(n, n, 8) == 1) { return 0; }
    # The FFT grid this feeds is 16 bytes per cell, so screen that budget too —
    # an n*n*8 aperture can succeed while the n*n*16 grid cannot.
    if (_pat_dims_bad(n, n, 16) == 1) { return 0; }
    var cx = f64_div(f64_from(n), F64_TWO);
    var cy = f64_div(f64_from(n), F64_TWO);
    var r2 = f64_mul(radius, radius);
    var aperture = _pat_scratch(&_pat_apert_c, &_pat_apert_n, n * n * 8);
    if (aperture == 0) { return 0; }
    for (var row = 0; row < n; row = row + 1) {
        for (var col = 0; col < n; col = col + 1) {
            var dx = f64_sub(f64_from(col), cx);
            var dy = f64_sub(f64_from(row), cy);
            var v = f64_from(0);
            if (f64_le(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), r2) == 1) {
                v = F64_ONE;
            }
            store64(aperture + (row * n + col) * 8, v);
        }
    }
    return diffraction_pattern_2d(aperture, n, n);
}

# ── Interference pattern ────────

#derive(accessors)
struct PointSource { x; y; amplitude; phase; }

# Allocate a contiguous array of `n` zeroed PointSources, laid out exactly as
# `interference_pattern` reads them (element i at `arr + i*sizeof(PointSource)`).
# Returns 0 if `n` is non-positive or the allocation fails.
#
# `point_source_new` allocates ONE source and returns its own pointer, so a
# sequence of those calls is not contiguous and cannot be indexed by
# `interference_pattern` — use this plus `point_source_set` to build its input.
#must_use
fn point_source_array_new(n) {
    if (_pat_dims_bad(n, 1, sizeof(PointSource)) == 1) { return 0; }
    # ⚠ 2.2.8: an 8-byte length header now precedes the elements. Without it
    # there was no length to check, so point_source_set accepted ANY i >= 0 and
    # wrote 32 bytes past the end of the buffer while returning PK_ERR_NONE —
    # a silent heap corruption reported as success. The returned pointer still
    # addresses element i at ret + i*sizeof(PointSource), so interference_pattern
    # and every existing caller are unaffected by the layout change.
    var base = alloc(8 + n * sizeof(PointSource));
    if (base == 0) { return 0; }
    store64(base, n);
    var arr = base + 8;
    for (var i = 0; i < n * 4; i = i + 1) {
        store64(arr + i * 8, f64_from(0));
    }
    return arr;
}

# Write element `i` of a PointSource array. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER for a null array or a negative index.
fn point_source_set(arr, i, x, y, amplitude, phase) {
    if (arr == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (i < 0) { return PK_ERR_INVALID_PARAMETER; }
    # 2.2.8: the upper bound, which did not exist before the length header.
    if (i >= load64(arr - 8)) { return PK_ERR_INVALID_PARAMETER; }
    var s = arr + i * sizeof(PointSource);
    PointSource_set_x(s, x);
    PointSource_set_y(s, y);
    PointSource_set_amplitude(s, amplitude);
    PointSource_set_phase(s, phase);
    return PK_ERR_NONE;
}

# Element `i` of a PointSource array (a pointer into the array, not a copy).
# Returns 0 for a null array or a negative index.
#must_use
fn point_source_at(arr, i) {
    if (arr == 0) { return 0; }
    if (i < 0) { return 0; }
    if (i >= load64(arr - 8)) { return 0; }
    return arr + i * sizeof(PointSource);
}

# A single PointSource: a one-element array, with the same length header as
# `point_source_array_new`'s, so point_source_set / point_source_at accept index 0 only and it
# can be passed to `interference_pattern` with num_sources = 1.
# ⛔ 2.15.1: it had no header, so point_source_set read whatever word preceded it on the heap as
# the length and wrote past the 32-byte source for any index under it, as success.
#must_use
fn point_source_new(x, y, amplitude, phase) {
    var base = alloc(8 + sizeof(PointSource));
    if (base == 0) { return 0; }
    store64(base, 1);
    var s = base + 8;
    PointSource_set_x(s, x);
    PointSource_set_y(s, y);
    PointSource_set_amplitude(s, amplitude);
    PointSource_set_phase(s, phase);
    return s;
}

# Interference of N point sources on a 2D grid: |sum E|^2 with 1/r falloff.
# grid_x = (gx0, gx1), grid_y = (gy0, gy1) flattened. sources = contiguous
# PointSource array (element i at sources + i*sizeof(PointSource)). 0 unless the wavelength is
# finite and > 0 (2.15.1: lambda = 0 gave a NaN grid, a negative one a mirrored phase).
#must_use
fn interference_pattern(sources, num_sources, wavelength, distance, gx0, gx1, gy0, gy1, nx, ny) {
    _prk_trace("interference_pattern");
    if (_pat_wl_ok(wavelength) == 0) { return 0; }
    # 2.2.6: the one grid entry point the 2.0.2 null-guard sweep missed.
    # diffraction_pattern_2d and psf_from_wavefront both guard their buffer;
    # this read PointSource fields straight off address 0.
    if (sources == 0) { return 0; }
    if (num_sources < 1) { return 0; }
    var dx = f64_from(0);
    if (nx > 1) {
        dx = f64_div(f64_sub(gx1, gx0), f64_sub(f64_from(nx), F64_ONE));
    }
    var dy = f64_from(0);
    if (ny > 1) {
        dy = f64_div(f64_sub(gy1, gy0), f64_sub(f64_from(ny), F64_ONE));
    }
    # Uninitialised: the row/col loop below writes every cell of the nx*ny grid.
    var pattern = _pattern2d_new_uninit(nx, ny);
    if (pattern == 0) { return 0; }
    for (var row = 0; row < ny; row = row + 1) {
        var obs_y = f64_add(gy0, f64_mul(f64_from(row), dy));
        for (var col = 0; col < nx; col = col + 1) {
            var obs_x = f64_add(gx0, f64_mul(f64_from(col), dx));
            var e_re = f64_from(0);
            var e_im = f64_from(0);
            for (var si = 0; si < num_sources; si = si + 1) {
                var src = sources + si * sizeof(PointSource);
                var sx = f64_sub(obs_x, PointSource_x(src));
                var sy = f64_sub(obs_y, PointSource_y(src));
                var r = f64_sqrt(f64_add(
                    f64_add(f64_mul(sx, sx), f64_mul(sy, sy)),
                    f64_mul(distance, distance)));
                # r/lambda cycles, not k*r: at visible wavelengths that phase is ~1e7
                # rad, where sin/cos are 10x slower and k*r has rounded twice.
                var phase = f64_add(_prk_cycles_phase(f64_div(r, wavelength)), PointSource_phase(src));
                var amp = f64_div(PointSource_amplitude(src), r);
                e_re = f64_add(e_re, f64_mul(amp, _prk_cos(phase)));
                e_im = f64_add(e_im, f64_mul(amp, _prk_sin(phase)));
            }
            pattern2d_set(pattern, col, row, f64_add(f64_mul(e_re, e_re), f64_mul(e_im, e_im)));
        }
    }
    return pattern;
}

# ── SPD -> RGB strip ────────

#derive(accessors)
struct StripColor { r; g; b; }

# 1 if a wavelength is finite and > 0.
#must_use
fn _pat_wl_ok(wl) {
    if (f64_gt(wl, f64_from(0)) == 0) { return 0; }
    return f64_lt(wl, 0x7FF0000000000000);
}

# Piecewise wavelength(nm) -> linear RGB (approx CIE 1931). Writes r,g,b to
# out+0/+8/+16. Black outside 380..780 nm, and for NaN (2.15.1: NaN fell through every
# comparison to the last branch and was painted red).
fn _pat_wl_to_rgb(nm, out) {
    if (f64_ge(nm, f64_from(380)) == 0) {
        store64(out, f64_from(0));
        store64(out + 8, f64_from(0));
        store64(out + 16, f64_from(0));
        return 0;
    }
    if (f64_gt(nm, f64_from(780)) == 1) {
        store64(out, f64_from(0));
        store64(out + 8, f64_from(0));
        store64(out + 16, f64_from(0));
        return 0;
    }
    var rr = f64_from(0);
    var gg = f64_from(0);
    var bb = f64_from(0);
    if (f64_lt(nm, f64_from(440)) == 1) {
        rr = f64_div(f64_neg(f64_sub(nm, f64_from(440))), f64_from(60));
        bb = F64_ONE;
    } elif (f64_lt(nm, f64_from(490)) == 1) {
        gg = f64_div(f64_sub(nm, f64_from(440)), f64_from(50));
        bb = F64_ONE;
    } elif (f64_lt(nm, f64_from(510)) == 1) {
        gg = F64_ONE;
        bb = f64_div(f64_neg(f64_sub(nm, f64_from(510))), f64_from(20));
    } elif (f64_lt(nm, f64_from(580)) == 1) {
        rr = f64_div(f64_sub(nm, f64_from(510)), f64_from(70));
        gg = F64_ONE;
    } elif (f64_lt(nm, f64_from(645)) == 1) {
        rr = F64_ONE;
        gg = f64_div(f64_neg(f64_sub(nm, f64_from(645))), f64_from(65));
    } else {
        rr = F64_ONE;
    }
    var factor = F64_ONE;
    if (f64_lt(nm, f64_from(420)) == 1) {
        factor = f64_add(_pat_r(3, 10),
          f64_div(f64_mul(_pat_r(7, 10), f64_sub(nm, f64_from(380))), f64_from(40)));
    } elif (f64_gt(nm, f64_from(700)) == 1) {
        factor = f64_add(_pat_r(3, 10),
          f64_div(f64_mul(_pat_r(7, 10), f64_sub(f64_from(780), nm)), f64_from(80)));
    }
    store64(out, f64_mul(rr, factor));
    store64(out + 8, f64_mul(gg, factor));
    store64(out + 16, f64_mul(bb, factor));
    return 0;
}

# Visible-spectrum strip (380-780 nm) as num_samples StripColors (contiguous).
#must_use
fn spectrum_strip(num_samples) {
    _prk_trace("spectrum_strip");
    if (_pat_dims_bad(num_samples, 1, sizeof(StripColor)) == 1) { return 0; }
    var colors = alloc(num_samples * sizeof(StripColor));
    if (colors == 0) { return 0; }
    # A stack local: 2.15.1 found a 24-byte alloc here, leaked on every call.
    var rgb[24];
    for (var i = 0; i < num_samples; i = i + 1) {
        var denom = f64_sub(f64_from(num_samples), F64_ONE);
        if (f64_lt(denom, F64_ONE) == 1) {
            denom = F64_ONE;
        }
        var t = f64_div(f64_from(i), denom);
        _pat_wl_to_rgb(f64_add(f64_from(380), f64_mul(t, f64_from(400))), &rgb);
        var c = colors + i * sizeof(StripColor);
        StripColor_set_r(c, load64(&rgb));
        StripColor_set_g(c, load64(&rgb + 8));
        StripColor_set_b(c, load64(&rgb + 16));
    }
    return colors;
}

# Spectrum strip for a custom [start_nm, end_nm] range. 0 unless both ends are finite (2.15.1:
# a NaN end painted the strip red).
#must_use
fn spectrum_strip_range(start_nm, end_nm, num_samples) {
    _prk_trace("spectrum_strip_range");
    if (f64_lt(f64_abs(start_nm), 0x7FF0000000000000) == 0) { return 0; }
    if (f64_lt(f64_abs(end_nm), 0x7FF0000000000000) == 0) { return 0; }
    if (_pat_dims_bad(num_samples, 1, sizeof(StripColor)) == 1) { return 0; }
    var colors = alloc(num_samples * sizeof(StripColor));
    if (colors == 0) { return 0; }
    var rgb[24];
    for (var i = 0; i < num_samples; i = i + 1) {
        var denom = f64_sub(f64_from(num_samples), F64_ONE);
        if (f64_lt(denom, F64_ONE) == 1) {
            denom = F64_ONE;
        }
        var t = f64_div(f64_from(i), denom);
        _pat_wl_to_rgb(f64_add(start_nm, f64_mul(t, f64_sub(end_nm, start_nm))), &rgb);
        var c = colors + i * sizeof(StripColor);
        StripColor_set_r(c, load64(&rgb));
        StripColor_set_g(c, load64(&rgb + 8));
        StripColor_set_b(c, load64(&rgb + 16));
    }
    return colors;
}

# ── PSF ────────

# Point Spread Function from wavefront error: PSF = |FT{P * exp(i*k*W)}|^2.
# pupil/wavefront_error are row-major f64 grids (width x height); k = TAU/wl. 0 unless the
# wavelength is finite and > 0 (2.15.1: lambda = 0 made k infinite and the PSF NaN).
#must_use
fn psf_from_wavefront(pupil, wavefront_error, width, height, wavelength) {
    _prk_trace("psf_from_wavefront");
    if (_pat_wl_ok(wavelength) == 0) { return 0; }
    if (pupil == 0) { return 0; }
    if (wavefront_error == 0) { return 0; }
    var nw = _pat_npot(width);
    var nh = _pat_npot(height);
    if (nw == 0) { return 0; }
    if (nh == 0) { return 0; }
    if (_pat_dims_bad(nw, nh, 16) == 1) { return 0; }
    var k = f64_div(F64_TAU, wavelength);
    var grid = _pat_scratch(&_pat_grid_c, &_pat_grid_n, nw * nh * 16);
    if (grid == 0) { return 0; }
    var total = nw * nh;
    for (var z = 0; z < total; z = z + 1) {
        store64(grid + z * 16, f64_from(0));
        store64(grid + z * 16 + 8, f64_from(0));
    }
    for (var row = 0; row < height; row = row + 1) {
        for (var col = 0; col < width; col = col + 1) {
            var idx = row * width + col;
            var pp = load64(pupil + idx * 8);
            if (f64_gt(pp, f64_from(0)) == 1) {
                var phase = f64_mul(k, load64(wavefront_error + idx * 8));
                store64(grid + (row * nw + col) * 16, f64_mul(pp, _prk_cos(phase)));
                store64(grid + (row * nw + col) * 16 + 8, f64_mul(pp, _prk_sin(phase)));
            }
        }
    }
    if (_pat_fft2d(grid, nw, nh) != 0) { return 0; }
    return _pat_fftshift_to_pattern(grid, nw, nh);
}

# Diffraction-limited PSF (perfect wavefront) = circular-aperture Airy pattern.
#must_use
fn psf_diffraction_limited(grid_size, radius) {
    _prk_trace("psf_diffraction_limited");
    return diffraction_pattern_circular(grid_size, radius);
}

# --- wave_beam.cyr ---

# wave_beam.cyr -- Gaussian beam optics: TEM00 parameters, q-parameter ABCD
# propagation, Hermite-Gaussian and Laguerre-Gaussian modes, M^2, and the orbital
# angular momentum of LG beams
# Usage: include "lib/wave_beam.cyr"  (requires error.cyr; ganita for atan2)
#
# New in 2.6.0, and NOT a port. The Rust 1.x crate re-exported bijli's Gaussian
# beam and ABCD types until 1.2.0 removed them, so there is no fidelity reference
# for anything here: every formula is checked against the literature instead —
# Siegman, "Lasers" (1986) ch. 16-21; Saleh & Teich, "Fundamentals of Photonics"
# ch. 3; ISO 11146-1 for second-moment widths and M^2; Allen, Beijersbergen,
# Spreeuw & Woerdman, Phys. Rev. A 45, 8185 (1992) for OAM.
#
# CONVENTIONS — read these before comparing a value against another source:
# - Lengths are in any ONE unit (the tests use metres). `wavelength` is the
#   wavelength IN THE MEDIUM the beam travels through, lambda0/n.
# - w is the 1/e^2 INTENSITY radius, which is also the ISO 11146 second-moment
#   radius of a TEM00 beam — not the 1/e field radius.
# - Time dependence e^{+i*omega*t} (Siegman; Saleh & Teich), so the carrier is
#   e^{-ikz}. It is common to every mode at a given plane and is omitted from the
#   fields below.
# - q = z + i*z_R, with z measured from the waist and positive downstream, so
#   1/q = 1/R - i*lambda/(pi*w^2) and R > 0 past the waist (a diverging beam).
# - An LG field carries e^{-i*l*phi}. In this time convention that is +l*hbar of
#   orbital angular momentum per photon; the physics convention writes the same
#   real field as e^{+i*l*phi} e^{-i*omega*t}.

fn _bm_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# 1 if x is finite and strictly positive. f64_gt is false for NaN, so NaN fails.
fn _bm_pos(x) {
    if (f64_gt(x, 0) == 0) { return 0; }
    if (x == _PRK_INF) { return 0; }
    return 1;
}

# 1 if x is finite (not NaN, not +-inf).
fn _bm_finite(x) {
    if ((x & _PRK_ABS) >= _PRK_INF) { return 0; }
    return 1;
}

# Validate a waist radius and wavelength: both finite and positive. On failure
# writes PK_ERR_INVALID_PARAMETER and returns 0.
fn _bm_check(w0, wavelength, err_out) {
    if (_bm_pos(w0) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_pos(wavelength) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return 1;
}

# A result is returned only if it is finite: otherwise writes PK_ERR_INVALID_PARAMETER and
# returns 0. 2.15.1 found beam_m2, beam_parameter_product, oam_flux and spiral_phase_plate_step
# overflowing to +inf from finite inputs and returning it with PK_ERR_NONE.
fn _bm_out(v, err_out) {
    if (_bm_finite(v) == 1) { return v; }
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return 0;
}

# 1 if x is finite and >= 0 (-0.0 included). f64_ge is false for NaN.
fn _bm_nonneg(x) {
    if (f64_ge(x, 0) == 0) { return 0; }
    if (x == _PRK_INF) { return 0; }
    return 1;
}

# 1 if x is finite, positive and NORMAL (>= 2^-1022). A subnormal Rayleigh range
# or Im q carries only a few bits, and everything built on it (the Gouy step, w,
# 1/R) silently lost precision — round 2 measured 1e-4 errors and a Gouy
# increment of exactly 0 — so results must be normal, not merely positive.
fn _bm_normal(x) {
    if (_bm_pos(x) == 0) { return 0; }
    if ((x & 0x7FF0000000000000) == 0) { return 0; }
    return 1;
}

# max(|x|, |y|) rounded DOWN to a power of two, for scaling before squaring
# (2^-1022 when both are zero or subnormal). Dividing by a power of two is exact,
# so a formula evaluated on x/h, y/h and rescaled gives the SAME BITS as the
# unscaled one wherever that one does not over- or underflow — and a finite
# answer where it would have. For non-negative finite doubles the bit patterns
# order like the values, so the max is an integer compare.
# ⚠ KEEP IN STEP: this and _bm_inv2 are written out inline, for speed (2.6.1), in
# EIGHT places — gaussian_curvature, gaussian_radius_of_curvature, _bm_abcd_ihd,
# _bm_abcd_dpsi, _bm_scaled_wcd, beam_radius, beam_waist_radius and beam_curvature
# (gaussian_intensity calls it). A change here must be made at every one. The
# edges where they differ are pinned in tests/wave_beam.tcyr — through the public
# API, or at the helper where no beam reaches (_bm_abcd_dpsi's floor): the 2^-1022
# floor, the non-finite max (a reciprocal of 0 in the queries, a refusal in
# _bm_abcd_ihd), and the h = 2^1023 branch at every site. Exception:
# _bm_scaled_wcd's floor and non-finite edges can no longer reach an output (its 0
# sentinel hands those beams to beam_radius), so only its 2^1023 branch is pinned.
fn _bm_scale2(x, y) {
    var ax = x & _PRK_ABS;
    var ay = y & _PRK_ABS;
    var m = ax;
    if (ay > ax) { m = ay; }
    var e = m & 0x7FF0000000000000;
    if (e == 0) { return 0x0010000000000000; }
    return e;
}

# 1/h, exactly, for h a power of two in [2^-1022, 2^1023] (every value _bm_scale2
# returns), without a division: biased exponent e maps to 2046 - e, and 2^1023's
# reciprocal 2^-1023 is the subnormal 0x0008000000000000. Multiplying by it gives
# the same bits as dividing by h: both round the same real number once (with
# denormals on, the x86 default: nothing in prakash or its deps sets MXCSR's
# DAZ/FTZ, under which x*2^-1023 would flush to 0).
# This is the REFERENCE definition, and nothing in the library calls it: the hot
# paths (the eight sites listed at _bm_scale2) write it out inline because a call
# measured 1-3 ns there (2.6.1) — keep them in step with it and with _bm_scale2.
# It is kept as the tested reference: tests/wave_beam.tcyr pins it on all 2046
# powers of two and checks _bm_abcd_ihd against it on every exponent.
fn _bm_inv2(h) {
    var e = (h >> 52) & 0x7FF;
    if (e >= 2046) { return 0x0008000000000000; }
    return (2046 - e) << 52;
}

# x = m*2^e for a finite nonzero x: returns m, with |m| in [1, 2) and x's sign, and
# writes the integer e through e_out (a subnormal x is first scaled by 2^52, which
# is exact). For the cold paths that apply a binary exponent last, where a product
# of the doubles themselves would over- or underflow.
fn _bm_frexp(x, e_out) {
    var a = x & _PRK_ABS;
    var k = 0 - 1023;
    if (a < 0x0010000000000000) {                           # subnormal
        a = f64_mul(a, 0x4330000000000000);                 # 2^52
        k = k - 52;
    }
    store64(e_out, k + (a >> 52));
    return (a & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000 | (x & 0x8000000000000000);
}

# a^2 + b^2 = s*4^e for finite a and b, not both 0: returns s in [1, 8) and writes
# the integer e through e_out. The larger magnitude's mantissa (_bm_frexp) is
# squared and the smaller one's square added at its relative scale: the roundings
# of a*a + b*b, as a power of two commutes with them, wherever that sum and its
# terms are normal doubles — and no over- or underflow where they are not. A term
# more than 2^1020 below the other is below its rounding and is dropped.
fn _bm_sq2(a, b, e_out) {
    var ma = a & _PRK_ABS;
    var mb = b & _PRK_ABS;
    if (mb > ma) {
        ma = b & _PRK_ABS;
        mb = a & _PRK_ABS;
    }
    var ea = 0;
    var fa = _bm_frexp(ma, &ea);
    var s = f64_mul(fa, fa);
    if (mb != 0) {
        var eb = 0;
        var fb = _bm_frexp(mb, &eb);
        if (eb - ea >= 0 - 511) { s = f64_add(s, f64_mul(f64_mul(fb, fb), (2 * (eb - ea) + 1023) << 52)); }
    }
    store64(e_out, ea);
    return s;
}

# 1 - e^(-x) for x >= 0 without cancellation at small x. Kahan's expm1 identity:
# with u = e^(-x), (1-u)/(-ln u) corrects the rounding in u and in 1-u together.
# The same construction as spectral_core's `_expm1`, INCLUDING its saturation
# guard — repeated rather than shared because no module reaches into another's
# private helpers.
# ⛔ 2.6.0 review: the first version dropped that guard and kept only `u == 0`,
# which fires after FULL underflow (x > 745.13). Between x ~ 708 and 745 u is
# subnormal, carries a few bits, and ln(u) misses -x by up to 0.7, so the ratio
# wandered either side of 1: gaussian_power_fraction(w, 19.3w) returned 1.00073,
# a "fraction" above 1, non-monotone in a. Once 1 - u rounds to 1 there is nothing
# left to correct, so it returns exactly 1.
fn _bm_one_minus_exp_neg(x) {
    var u = _prk_exp(f64_neg(x));
    if (u == F64_ONE) { return x; }
    var om = f64_sub(F64_ONE, u);
    if (om == F64_ONE) { return F64_ONE; }
    return f64_div(f64_mul(om, x), f64_neg(f64_ln(u)));
}

# ── TEM00: the fundamental Gaussian beam ────────

# Rayleigh range z_R = pi*w0^2/lambda, the distance from the waist at which the
# beam area has doubled. Writes PK_ERR_INVALID_PARAMETER (returns 0) unless w0
# and wavelength are finite and positive and z_R itself is a finite, NORMAL
# double (>= 2^-1022) — every closed form below except gaussian_divergence and
# gaussian_power_fraction (which take w0 or w directly and do not form z_R), and
# gaussian_beam_new, inherit that, so none of them builds
# on a z_R that has overflowed or underflowed.
#must_use
fn gaussian_rayleigh_range(w0, wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_check(w0, wavelength, err_out) == 0) { return 0; }
    # w0*(w0/lambda), not w0^2/lambda: the square cannot overflow or underflow
    # while the answer is representable.
    var zr = f64_mul(F64_PI, f64_mul(w0, f64_div(w0, wavelength)));
    if (_bm_normal(zr) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return zr;
}

# Beam radius at distance z from the waist: w(z) = w0*sqrt(1 + (z/z_R)^2).
# Writes PK_ERR_INVALID_PARAMETER (returns 0) for a bad w0/wavelength, a
# non-finite z, or a w beyond the double range (near the waist or far from it).
#must_use
fn gaussian_beam_radius(w0, wavelength, z, err_out) {
    var zr = gaussian_rayleigh_range(w0, wavelength, err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    if (_bm_finite(z) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var t = f64_div(z, zr);
    # Past |t| = 2^27, sqrt(1 + t^2) rounds to |t| exactly; returning it there keeps
    # the same bits and cannot overflow through t^2.
    if ((t & _PRK_ABS) > 0x41A0000000000000) {
        var wf = f64_mul(w0, f64_abs(t));
        # ⛔ 2.6.1: t itself can overflow while w = w0*|z|/z_R is representable
        # (w0 = 1e-150, lambda = 1e-10, z = 1e100: t ~ 3e389, w ~ 3e239), and 2.6.0
        # returned +inf as success there — which gaussian_intensity turned into NaN.
        # Formed instead as |z|*(w0/z_R), the far-field |z|*theta. A w that is
        # itself beyond the double range is refused, as z_R is. The refusal sits
        # inside the retry, so the common path makes one compare. Same-binary A/B
        # (2.6.1 review): 2.6.0 32 ns, with the refusal after the retry 34, nested
        # 33 — the check itself costs ~1 ns, which nesting does not remove.
        if (wf == _PRK_INF) {
            wf = f64_mul(f64_abs(z), f64_div(w0, zr));
            if (wf == _PRK_INF) {
                store64(err_out, PK_ERR_INVALID_PARAMETER);
                return 0;
            }
        }
        return wf;
    }
    # |t| <= 2^27 here, so t^2 <= 2^54 and 1 + t^2 and its sqrt stay finite: only a
    # true overflow of w (w0 near the top of the range) gives inf, refused as the
    # far-field branch refuses it (2.6.1 review: 2.6.0 and the first 2.6.1 cut
    # returned +inf as success here, and gaussian_intensity a NaN). The check costs
    # ~1 ns (same-binary: 45.2 vs 44.3 without it).
    var w = f64_mul(w0, f64_sqrt(f64_add(F64_ONE, f64_mul(t, t))));
    if (w == _PRK_INF) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return w;
}

# Wavefront curvature 1/R(z) = z/(z^2 + z_R^2). It is 0 at the waist, where the
# wavefront is plane, and largest in magnitude at z = +-z_R. Errors as
# gaussian_rayleigh_range, and for a non-finite z. It does not form w(z), so it
# does not share gaussian_beam_radius's refusal of a w beyond the double range.
#must_use
fn gaussian_curvature(w0, wavelength, z, err_out) {
    var zr = gaussian_rayleigh_range(w0, wavelength, err_out);
    # 0 is exactly its error return (a z_R it accepts is a normal positive double),
    # so the value is tested and the code not re-read through prakash_is_err.
    if (zr == 0) { return 0; }
    # _bm_finite(z) on the bits: a NaN's lie above +inf's.
    var az = z & _PRK_ABS;
    if (az >= _PRK_INF) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # Scaled by a power of two before squaring (see _bm_scale2): same bits in range.
    # _bm_scale2(z, zr) and _bm_inv2 are written out (a copy: keep in step, see
    # _bm_scale2), and every /h is a multiply by ih = 1/h — the same bits, as both
    # round the same real once. z_R is normal, so
    # the max's exponent field is never 0; both are finite, so h <= 2^1023 and ih
    # is 0x7FE0000000000000 - h (biased exponent 2046 - e), or the subnormal 2^-1023
    # at h = 2^1023. 2.6.1, same-binary A/B: 50 -> 40 ns, 25 of it z_R; calling
    # _bm_scale2 or _bm_inv2 here instead measured 1-3 ns slower each (layout-
    # dependent).
    var h = zr;
    if (az > h) { h = az; }
    h = h & 0x7FF0000000000000;
    var ih = 0x0008000000000000;
    if (h < 0x7FE0000000000000) { ih = 0x7FE0000000000000 - h; }
    var zs = f64_mul(z, ih);
    var rs = f64_mul(zr, ih);
    return f64_mul(f64_div(zs, f64_add(f64_mul(zs, zs), f64_mul(rs, rs))), ih);
}

# Wavefront radius of curvature R(z) = z*(1 + (z_R/z)^2). The wavefront is plane
# at the waist, so z = 0 returns +inf (0x7FF0000000000000) — a real answer, not
# an error. Prefer gaussian_curvature, which is finite everywhere. Errors as
# gaussian_rayleigh_range, and for a non-finite z. It does not form w(z), so it
# does not share gaussian_beam_radius's refusal of a w beyond the double range.
#must_use
fn gaussian_radius_of_curvature(w0, wavelength, z, err_out) {
    var zr = gaussian_rayleigh_range(w0, wavelength, err_out);
    if (zr == 0) { return 0; }
    var az = z & _PRK_ABS;
    if (az >= _PRK_INF) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (az == 0) { return _PRK_INF; }
    # Scaled as gaussian_curvature is (a copy of _bm_scale2 and _bm_inv2: keep in
    # step); R multiplies by h itself. 2.6.1, same-binary A/B: 50 -> 41 ns.
    var h = zr;
    if (az > h) { h = az; }
    h = h & 0x7FF0000000000000;
    var ih = 0x0008000000000000;
    if (h < 0x7FE0000000000000) { ih = 0x7FE0000000000000 - h; }
    var zs = f64_mul(z, ih);
    var rs = f64_mul(zr, ih);
    return f64_mul(f64_div(f64_add(f64_mul(zs, zs), f64_mul(rs, rs)), zs), h);
}

# Gouy phase psi(z) = atan(z/z_R): the extra phase a focused beam gains over a
# plane wave, -pi/2 -> +pi/2 through the focus. Errors as gaussian_rayleigh_range,
# and for a non-finite z.
#must_use
fn gaussian_gouy_phase(w0, wavelength, z, err_out) {
    var zr = gaussian_rayleigh_range(w0, wavelength, err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    if (_bm_finite(z) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return ganita_f64_atan2(z, zr);
}

# Far-field half-angle divergence theta = lambda/(pi*w0) (radians), the
# asymptote of w(z)/z. Writes PK_ERR_INVALID_PARAMETER (returns 0) unless w0 and
# wavelength are finite and positive. It does not form z_R, so it does not refuse
# where z_R under- or overflows; it does refuse a theta that underflows to 0 or overflows,
# which is not the angle of any beam (2.15.1: 0 came back as success).
#must_use
fn gaussian_divergence(w0, wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_check(w0, wavelength, err_out) == 0) { return 0; }
    var th = f64_div(wavelength, f64_mul(F64_PI, w0));
    if (_bm_pos(th) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return th;
}

# Intensity of a TEM00 beam of total power P at radius r and distance z:
# I = (2P/(pi*w^2))*exp(-2r^2/w^2). The 2/(pi*w^2) makes the integral over the
# plane equal P. Errors as gaussian_beam_radius, and for a power that is
# negative or not finite, an r that is not finite (a power carries no sign:
# a negative one would come back as a plausible negative intensity), or an
# intensity beyond the double range.
#must_use
fn gaussian_intensity(power, w0, wavelength, r, z, err_out) {
    var w = gaussian_beam_radius(w0, wavelength, z, err_out);
    # 0 is exactly its error return (a w it computes is >= w0 > 0), so the value
    # is tested and the code not re-read through prakash_is_err.
    if (w == 0) { return 0; }
    # _bm_nonneg(power) and _bm_finite(r) on the bits: a NaN's lie above +inf's,
    # and a set sign bit is negative except on -0, which f64_ge(-0, 0) accepts.
    # With the line above, four calls fewer: measured 5 ns.
    var ok = 1;
    if ((r & _PRK_ABS) >= _PRK_INF) { ok = 0; }
    if ((power & _PRK_ABS) >= _PRK_INF) { ok = 0; }
    if (power < 0) {
        if (power != _PRK_NZERO) { ok = 0; }
    }
    if (ok == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # pi*w^2 on w scaled by a power of two: same bits in range, and w^2 alone
    # over- or underflowing no longer matters (round 2). Left as divisions:
    # written out as in gaussian_curvature it measured 1 ns (within noise), the
    # critical path here being w and the exponential. 2.6.1, same-binary A/B:
    # 106 -> 100 ns, from the checks above.
    var h = _bm_scale2(w, w);
    var ws = f64_div(w, h);
    var q = f64_div(f64_mul(F64_TWO, power), f64_mul(F64_PI, f64_mul(ws, ws)));
    var peak = f64_div(f64_div(q, h), h);
    var t = f64_div(r, w);
    var eh = f64_neg(f64_mul(F64_TWO, f64_mul(t, t)));
    var g = _prk_exp(eh);
    # q, peak and g normal (non-negative doubles order as integers): peak*g, the
    # 2.6.0 expression and bits. ⛔ 2.6.1 review: otherwise the peak had overflowed
    # (w < ~1e-154*sqrt(P), or 2P > DBL_MAX), q or the peak had underflowed (a
    # subnormal P loses bits in q), or g had lost bits below 2^-1022 (2t^2 > 708.4),
    # and peak*g was +inf, inf*0 = NaN, a false 0 or a product short of bits — all
    # as success. There the same quotient is formed on P's mantissa, and P's and
    # h's exponents and e^(-2t^2) are applied last by _bm_lga_gen (x/w * e^E * 2^z,
    # the LG amplitude's exact-exponent tail), so the result over- or underflows
    # only where the true intensity does; an overflow is refused. Within 3.25 ulps
    # of mpmath at the module's own w and 2t^2 (26k such values, 3 fuzz seeds).
    # Where g is 0 and eh < -(e + 1077)*ln2, e the binary exponent of the peak (<
    # 2^(e+1)), the intensity is below 2^-1076: the tail would round it to 0, and
    # 2.6.0's peak*0 = +0 is returned without it. The tail costs time where it runs,
    # and the range tests cost the common path a little. Same-binary A/B (2.6.1
    # review; w0 = 1 mm, 1064 nm, z = 0.7 m, 2.6.0's expression -> this): r = w/2 95
    # -> 98 ns; r = 19w, g subnormal and I ~ 1.6e-308 still normal, 112 -> 292; r =
    # 19.5w and beyond, where I rounds to 0, 95 -> 99 (without the early-out, 200 at
    # 19.5w and 114 past it).
    if (q >= 0x0010000000000000) {
        if (peak >= 0x0010000000000000) {
            if (peak < _PRK_INF) {
                if (g >= 0x0010000000000000) { return f64_mul(peak, g); }
                if (g == 0) {
                    # eh < -(e + 1077)*ln2, e = (peak >> 52) - 1023
                    if (f64_lt(eh, f64_mul(f64_from(0 - 54 - (peak >> 52)), F64_LN2)) == 1) {
                        return f64_mul(peak, g);
                    }
                }
            }
        }
    }
    if ((power & _PRK_ABS) == 0) { return f64_mul(peak, g); }   # a +-0 power: +-0, as before
    var kp = 0;
    var pm = _bm_frexp(power, &kp);
    var kh = (h >> 52) - 1023;
    var v = _bm_lga_gen(f64_mul(F64_TWO, pm), f64_mul(F64_PI, f64_mul(ws, ws)), eh, 0, F64_ONE, kp - kh - kh);
    if (v == _PRK_INF) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return v;
}

# Fraction of a TEM00 beam's power inside a centred circle of radius a, at a
# plane where the beam radius is w: 1 - exp(-2a^2/w^2). a = w gives 86.47%.
# Writes PK_ERR_INVALID_PARAMETER (returns 0) unless w is finite and positive
# and a is finite.
#must_use
fn gaussian_power_fraction(w, a, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_pos(w) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_finite(a) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # Square the RATIO: a^2 and w^2 formed separately overflow (or underflow) to
    # inf/inf = NaN for large (small) lengths, though the answer depends on a/w only.
    var t = f64_div(a, w);
    return _bm_one_minus_exp_neg(f64_mul(F64_TWO, f64_mul(t, t)));
}

# Beam radius of a real beam with quality factor M^2 >= 1 (ISO 11146):
# W(z) = W0*sqrt(1 + (z*M^2*lambda/(pi*W0^2))^2). Its Rayleigh range is
# z_R/M^2 and its divergence M^2 times a TEM00 beam's of the same waist. Errors
# as gaussian_beam_radius, and for M^2 < 1 (no beam beats a TEM00).
#must_use
fn gaussian_beam_radius_m2(w0, wavelength, m2, z, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_finite(m2) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (f64_lt(m2, F64_ONE) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return gaussian_beam_radius(w0, f64_mul(wavelength, m2), z, err_out);
}

# ── The q parameter: a beam carried through ABCD optics ────────
#
# A GaussianBeam is the state of one TEM00 beam (or the embedded Gaussian of a
# mode family) at one plane: q = q_re + i*q_im, the local wavelength, and the
# accumulated Gouy phase. The element functions below update it IN PLACE — the
# bump allocator never frees, so a builder that returned a fresh struct per
# element would leak one per call.
#
# ABCD matrices act on (height, REAL slope), so a lossless element has
# det = AD - BC = n_in/n_out. The local wavelength is updated by that same
# determinant, which makes every element change the medium consistently without
# being told the indices: free space, lenses and mirrors have det = 1, an
# interface n1 -> n2 has det = n1/n2 and lambda2 = lambda1*n1/n2.
#
# Gouy phase through an element is -arg(A + B/q) (Siegman §20.2): atan(z/z_R)
# for free space from a waist; 0 for an element with B = 0 and A > 0 (a lens,
# mirror or interface); pi for B = 0 and A < 0 — an inverting relay such as a 4f
# telescope or 2f-2f imaging, whose output is the input field inverted and scaled
# by 1/A. The field of a mode of order N carries (N+1) times it, so only its value
# modulo 2*pi matters to a field and each element contributes its principal value.
# Checked in the 2.6.0 review against FFT angular-spectrum propagation (lens +
# free space, diverging lenses, virtual waists, A < 0, curved interfaces into
# glass): phase, amplitude 1/|A + B/q| and q agree to 1e-12.

#derive(accessors)
struct GaussianBeam { q_re; q_im; wavelength; gouy; }

fn _bm_new(q_re, q_im, wavelength, gouy) {
    var b = alloc(sizeof(GaussianBeam));
    if (b == 0) { return 0; }
    GaussianBeam_set_q_re(b, q_re);
    GaussianBeam_set_q_im(b, q_im);
    GaussianBeam_set_wavelength(b, wavelength);
    GaussianBeam_set_gouy(b, gouy);
    return b;
}

# New beam at its waist (q = i*z_R, Gouy phase 0). Writes
# PK_ERR_INVALID_PARAMETER for a bad w0/wavelength and PK_ERR_ALLOCATION if the
# struct cannot be allocated; returns 0 on either.
#must_use
fn gaussian_beam_new(w0, wavelength, err_out) {
    var zr = gaussian_rayleigh_range(w0, wavelength, err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var b = _bm_new(0, zr, wavelength, 0);
    if (b == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return b;
}

# New beam from a q parameter at the current plane: q_re is the distance past
# the waist (negative before it), q_im the Rayleigh range. The Gouy phase starts
# at the local atan(q_re/q_im), so free propagation continues the TEM00 law.
# Writes PK_ERR_INVALID_PARAMETER unless q_re is finite, q_im is finite, positive
# and normal (>= 2^-1022), and wavelength is finite and positive;
# PK_ERR_ALLOCATION on allocation failure.
#must_use
fn gaussian_beam_from_q(q_re, q_im, wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_finite(q_re) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_check(q_im, wavelength, err_out) == 0) { return 0; }
    if (_bm_normal(q_im) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var b = _bm_new(q_re, q_im, wavelength, ganita_f64_atan2(q_re, q_im));
    if (b == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return b;
}

# _bm_inv2(_bm_scale2(x, y)) in one call, or 0 — never a reciprocal — when x or
# y is not finite (the all-ones exponent for which _bm_scale2 returns +inf). A
# copy of both: keep in step (see _bm_scale2); the tests check it against them on
# every exponent.
fn _bm_abcd_ihd(x, y) {
    var m = x & _PRK_ABS;
    var my = y & _PRK_ABS;
    if (my > m) { m = my; }
    var e = (m >> 52) & 0x7FF;
    if (e == 2047) { return 0; }
    if (e == 0) { e = 1; }
    if (e >= 2046) { return 0x0008000000000000; }
    return (2046 - e) << 52;
}

# -arg(a + b/q) for the PRE-element q, whose qr and qi every caller has already
# shown finite: atan2(b*qi, a*|q|^2 + b*qr) with both parts divided by the power
# of two hq (atan2 is unchanged, the bits are the same in range), so |q|^2 can
# neither overflow into a 0*inf = NaN for an a = 0 element nor underflow. The
# division is a multiply by the exact reciprocal, and 1*hq = hq. hq and 1/hq are
# _bm_scale2 and _bm_inv2 written inline (a copy: keep in step, see _bm_scale2):
# their two calls cost beam/propagate ~6 ns (same-binary A/B, 2.6.1). The e == 0
# clamp cannot be reached through the API — Im q is always normal there — and is
# kept as a guard for a struct whose public fields were written directly.
fn _bm_abcd_dpsi(qr, qi, a, b) {
    var m = qr & _PRK_ABS;
    var mi = qi & _PRK_ABS;
    if (mi > m) { m = mi; }
    var e = (m >> 52) & 0x7FF;
    if (e == 0) { e = 1; }
    var hq = e << 52;
    var ihq = 0x0008000000000000;
    if (e < 2046) { ihq = (2046 - e) << 52; }
    var qrs = f64_mul(qr, ihq);
    var qis = f64_mul(qi, ihq);
    var q2s = f64_add(f64_mul(qrs, qrs), f64_mul(qis, qis));
    var ahq = hq;
    if (a != F64_ONE) { ahq = f64_mul(a, hq); }
    return ganita_f64_atan2(f64_mul(b, qis), f64_add(f64_mul(ahq, q2s), f64_mul(b, qrs)));
}

# beam_abcd for B = +-0 and A > 0 — every lens, mirror and interface — with the
# entries already checked finite and the beam non-null. The general path bit for
# bit, minus the work that cannot change a bit:
# - det = a*d - b*c is a*d: b*c is a zero, and subtracting a zero leaves a
#   nonzero a*d as it is; a zero or overflowed a*d is refused either way.
# - a*qr + b is a*qr, except that +0 added to -0 gives +0: for a zero a*qr the
#   sum is the AND of the two sign bits.
# - The Gouy step atan2(b*qis, a*hq*|q/hq|^2 + b*qrs) has a zero numerator and a
#   denominator >= +0 that is not NaN, so it is a zero, and adding a zero changes
#   the accumulated phase only when that is -0 or NaN — the one case computed.
#   Skipping the atan2 is most of the 2.6.1 saving: beam/thin_lens 123 -> 44 ns,
#   a mirror 123 -> 45 (same-binary A/B, 8 interleaved runs).
# - 1*x = x for every x reaching a store, so a = 1 and det = 1 skip multiplies.
fn _bm_abcd_b0(beam, a, b, c, d) {
    var det = d;
    if (a != F64_ONE) { det = f64_mul(a, d); }
    if (det <= 0) { return PK_ERR_INVALID_PARAMETER; }
    if (det >= _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    var qr = GaussianBeam_q_re(beam);
    var qi = GaussianBeam_q_im(beam);
    var dr = f64_add(f64_mul(c, qr), d);
    var di = f64_mul(c, qi);
    if (((dr | di) & _PRK_ABS) == 0) { return PK_ERR_DIVISION_BY_ZERO; }
    var ihd = _bm_abcd_ihd(dr, di);
    if (ihd == 0) { return PK_ERR_INVALID_PARAMETER; }
    var drs = f64_mul(dr, ihd);
    var dis = f64_mul(di, ihd);
    var dens = f64_add(f64_mul(drs, drs), f64_mul(dis, dis));
    # qr and qi are finite from here: either one not finite made dr or di so.
    var nr = qr;
    var ni = qi;
    if (a != F64_ONE) {
        nr = f64_mul(a, qr);
        ni = f64_mul(a, qi);
    }
    if ((nr & _PRK_ABS) == 0) { nr = nr & b; }
    var new_qr = f64_mul(f64_div(f64_add(f64_mul(nr, drs), f64_mul(ni, dis)), dens), ihd);
    var ti = qi;
    if (det != F64_ONE) { ti = f64_mul(det, qi); }
    var new_qi = f64_mul(f64_mul(f64_div(ti, dens), ihd), ihd);
    if (new_qi < 0x0010000000000000) { return PK_ERR_INVALID_PARAMETER; }
    if (new_qi >= _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    if ((new_qr & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    var new_wl = GaussianBeam_wavelength(beam);
    if (det != F64_ONE) { new_wl = f64_mul(new_wl, det); }
    if (new_wl < 0x0010000000000000) { return PK_ERR_INVALID_PARAMETER; }
    if (new_wl >= _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    var g = GaussianBeam_gouy(beam);
    if ((g == 0x8000000000000000) | ((g & _PRK_ABS) > _PRK_INF)) {
        GaussianBeam_set_gouy(beam, f64_add(g, _bm_abcd_dpsi(qr, qi, a, b)));
    }
    GaussianBeam_set_q_re(beam, new_qr);
    GaussianBeam_set_q_im(beam, new_qi);
    GaussianBeam_set_wavelength(beam, new_wl);
    return PK_ERR_NONE;
}

# beam_abcd for free space [[1, b], [+-0, 1]], b finite and the beam non-null.
# For a finite q, c*q + d is exactly 1 + (+-0)i, so the general path's scale and
# |cq + d|^2 are 1, Im q' = Im q, the wavelength is kept, and Re q' = qr + b plus
# qi*(c*qi): a zero with c's sign, which turns a -0 sum into +0 when c = +0
# (beam_propagate by -0) and would keep it -0 when c = -0 — which no caller
# reaches: a -0 sum needs b = -0, and beam_abcd sends every zero b with a = 1 to
# _bm_abcd_b0. A q that is not finite gave that path a NaN Im q'; here qi must be
# normal and qr + b finite — the same refusals.
fn _bm_abcd_free(beam, b, c) {
    var qr = GaussianBeam_q_re(beam);
    var qi = GaussianBeam_q_im(beam);
    if (qi < 0x0010000000000000) { return PK_ERR_INVALID_PARAMETER; }
    if (qi >= _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    var new_qr = f64_add(qr, b);
    if ((new_qr & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    if (new_qr == 0x8000000000000000) { new_qr = c; }
    var wl = GaussianBeam_wavelength(beam);
    if (wl < 0x0010000000000000) { return PK_ERR_INVALID_PARAMETER; }
    if (wl >= _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    GaussianBeam_set_q_re(beam, new_qr);
    GaussianBeam_set_gouy(beam, f64_add(GaussianBeam_gouy(beam), _bm_abcd_dpsi(qr, qi, F64_ONE, b)));
    return PK_ERR_NONE;
}

# Apply a general ray-transfer matrix [[a, b], [c, d]] (height, real slope):
# q' = (a*q + b)/(c*q + d), wavelength' = wavelength*(ad - bc), Gouy phase
# advanced by -arg(a + b/q). Returns PK_ERR_NONE; PK_ERR_INVALID_PARAMETER for a
# null beam, a non-finite entry, ad - bc <= 0 (no lossless element has one), or a
# result that is not representable — q' not finite with Im q' a normal positive
# double, or a wavelength that over- or underflows (the entries must then be
# ~1e150 or beyond); PK_ERR_DIVISION_BY_ZERO if c*q + d rounds to exactly 0 —
# not only c = d = 0 (refused as det = 0): c*Im q and c*Re q + d can UNDERFLOW,
# e.g. q = 2^100 + i*2^-1000 through a thin lens of f = 2^100 (2.6.1 review; the
# 2.6.0 text said this was unreachable). Every check precedes every store: the
# beam is untouched on error.
# 2.6.1: the same bits and codes as 2.6.0 for every input, faster. Finite /
# positive / normal are integer range tests on the bits (a positive finite double
# is a pattern in (0, +inf) as a signed integer; -0, negatives and sign-set NaNs
# are negative integers, a sign-clear NaN lies above +inf — all refused; normal
# starts at 0x0010000000000000), every division by a
# power-of-two scale is a multiply by its exact reciprocal, and B = +-0 with
# A > 0, and free space, take the exact shortcuts _bm_abcd_b0 and _bm_abcd_free.
# Same-binary A/B: a general element (b*c != 0) 146 -> 118 ns, beam/propagate
# 149 -> 90 ns, of which ~58 is the atan2 no rewrite can remove.
fn beam_abcd(beam, a, b, c, d) {
    if (beam == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((a & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    if ((b & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    if ((c & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    if ((d & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    if ((b & _PRK_ABS) == 0) {
        if (a > 0) { return _bm_abcd_b0(beam, a, b, c, d); }
    }
    if ((c & _PRK_ABS) == 0) {
        if ((a == F64_ONE) & (d == F64_ONE)) { return _bm_abcd_free(beam, b, c); }
    }
    var det = f64_sub(f64_mul(a, d), f64_mul(b, c));
    if (det <= 0) { return PK_ERR_INVALID_PARAMETER; }
    if (det >= _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    var qr = GaussianBeam_q_re(beam);
    var qi = GaussianBeam_q_im(beam);
    var dr = f64_add(f64_mul(c, qr), d);
    var di = f64_mul(c, qi);
    if (((dr | di) & _PRK_ABS) == 0) { return PK_ERR_DIVISION_BY_ZERO; }
    # |cq + d|^2 is formed on (dr, di) scaled by a power of two hd (_bm_scale2):
    # the same bits wherever the plain square is representable, and no spurious
    # overflow or underflow where it is not. Scaling by hd, or multiplying by its
    # exact reciprocal ihd, is exact.
    # dr or di not finite (a q that is not finite, or c*qr, c*qi or c*qr + d
    # overflowing) made 2.6.0's hd +inf and its Im q' NaN, refused below; it is
    # refused here, with the same code.
    var ihd = _bm_abcd_ihd(dr, di);
    if (ihd == 0) { return PK_ERR_INVALID_PARAMETER; }
    var drs = f64_mul(dr, ihd);
    var dis = f64_mul(di, ihd);
    var dens = f64_add(f64_mul(drs, drs), f64_mul(dis, dis));
    var nr = f64_add(f64_mul(a, qr), b);
    var ni = f64_mul(a, qi);
    var new_qr = f64_mul(f64_div(f64_add(f64_mul(nr, drs), f64_mul(ni, dis)), dens), ihd);
    # Im q' = det*Im(q)/|cq + d|^2 exactly; written that way rather than as
    # ni*dr - nr*di, whose two a*c*qr*qi terms cancel only to rounding.
    var new_qi = f64_mul(f64_mul(f64_div(f64_mul(det, qi), dens), ihd), ihd);
    # With det > 0, "Im q' normal" and "Re q' finite" cannot fail in exact
    # arithmetic; they catch q' over- or underflowing when the entries are ~1e150
    # or beyond.
    if (new_qi < 0x0010000000000000) { return PK_ERR_INVALID_PARAMETER; }
    if (new_qi >= _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    if ((new_qr & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    var new_wl = f64_mul(GaussianBeam_wavelength(beam), det);
    if (new_wl < 0x0010000000000000) { return PK_ERR_INVALID_PARAMETER; }
    if (new_wl >= _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    var dpsi = _bm_abcd_dpsi(qr, qi, a, b);
    GaussianBeam_set_q_re(beam, new_qr);
    GaussianBeam_set_q_im(beam, new_qi);
    GaussianBeam_set_wavelength(beam, new_wl);
    GaussianBeam_set_gouy(beam, f64_add(GaussianBeam_gouy(beam), dpsi));
    return PK_ERR_NONE;
}

# Propagate a distance d through a uniform medium: q' = q + d (exact). Negative
# d propagates backwards. Errors as beam_abcd, whose free-space path it enters
# directly.
fn beam_propagate(beam, d) {
    if (beam == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((d & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    return _bm_abcd_free(beam, d, 0);
}

# Thin lens of focal length f (> 0 converging): 1/q' = 1/q - 1/f. Returns
# PK_ERR_DIVISION_BY_ZERO for f = 0; otherwise errors as beam_abcd.
fn beam_thin_lens(beam, f) {
    if (beam == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((f & _PRK_ABS) == 0) { return PK_ERR_DIVISION_BY_ZERO; }
    var c = f64_div(f64_neg(F64_ONE), f);
    if ((c & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    return _bm_abcd_b0(beam, F64_ONE, 0, c, F64_ONE);
}

# Reflection from a mirror of radius R, unfolded so the beam keeps travelling
# in +z: C = -2/R, R > 0 for a concave (focusing) mirror. A flat mirror is
# R = +inf. Returns PK_ERR_DIVISION_BY_ZERO for R = 0; otherwise errors as
# beam_abcd.
fn beam_mirror(beam, radius) {
    if (beam == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((radius & _PRK_ABS) == 0) { return PK_ERR_DIVISION_BY_ZERO; }
    if ((radius & _PRK_ABS) > _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    var c = f64_div(f64_neg(F64_TWO), radius);
    if ((c & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    return _bm_abcd_b0(beam, F64_ONE, 0, c, F64_ONE);
}

# Refraction at a spherical interface from index n1 into n2, radius R > 0 when
# the centre of curvature lies downstream (a convex face toward the beam):
# [[1, 0], [(n1 - n2)/(n2*R), n1/n2]]. A flat interface is R = +inf. Returns
# PK_ERR_INVALID_PARAMETER unless n1, n2 are finite and positive (checked before
# R), PK_ERR_DIVISION_BY_ZERO for R = 0; otherwise errors as beam_abcd. B = 0, so it
# takes _bm_abcd_b0: 2.6.1, same-binary A/B 132 -> 54 ns.
fn beam_curved_interface(beam, n1, n2, radius) {
    if (beam == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((n1 <= 0) | (n1 >= _PRK_INF)) { return PK_ERR_INVALID_PARAMETER; }
    if ((n2 <= 0) | (n2 >= _PRK_INF)) { return PK_ERR_INVALID_PARAMETER; }
    if ((radius & _PRK_ABS) == 0) { return PK_ERR_DIVISION_BY_ZERO; }
    if ((radius & _PRK_ABS) > _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    var c = f64_div(f64_sub(n1, n2), f64_mul(n2, radius));
    var d = f64_div(n1, n2);
    if ((c & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    if ((d & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    return _bm_abcd_b0(beam, F64_ONE, 0, c, d);
}

# Refraction at a flat interface from index n1 into n2: q' = q*n2/n1, and the
# wavelength becomes wavelength*n1/n2. The beam radius is continuous. Errors as
# beam_curved_interface with R = +inf, whose C = (n1 - n2)/(n2*inf) is a zero
# with the sign of n1 - n2 — negative exactly when n1 < n2, since a difference of
# doubles is zero only when they are equal — so it is set, not computed (the sign
# of that zero reaches no output; it is kept faithful). 2.6.1, same-binary A/B:
# 131 -> 46 ns.
fn beam_interface(beam, n1, n2) {
    if (beam == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((n1 <= 0) | (n1 >= _PRK_INF)) { return PK_ERR_INVALID_PARAMETER; }
    if ((n2 <= 0) | (n2 >= _PRK_INF)) { return PK_ERR_INVALID_PARAMETER; }
    var c = 0;
    if (n1 < n2) { c = 0x8000000000000000; }
    var d = f64_div(n1, n2);
    if ((d & _PRK_INF) == _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
    return _bm_abcd_b0(beam, F64_ONE, 0, c, d);
}

# ── Queries (NaN for a null beam: 0 is a legitimate value for most) ────────
#
# q is scaled as in gaussian_curvature (_bm_scale2 and _bm_inv2 written out in
# _bm_scaled_wcd, beam_radius, beam_waist_radius and beam_curvature — copies: keep
# them in step, see _bm_scale2 — every /h a multiply by ih = 1/h). The struct's
# fields are public, so nothing bounds them: for an infinite or NaN q, h is +inf
# and ih = 1/h = 0, and x*0 has x/inf's bits for EVERY x (a signed 0; the default
# NaN for x = inf, as inf/inf gives; x's own NaN) — the divisions' bits on every
# input. 2.6.1, same-binary A/B: beam_radius 28 -> 20 ns (the old one ran at 21 in
# some code layouts, the new one at 20 in all), beam_curvature 20 -> 14,
# beam_waist_radius 18 -> 15 (15-16 with the review's range tests below).
# ⛔ 2.6.1 review: the radius as h*sqrt(lambda*q2s/(pi*Im q)) left lambda and Im q
# unscaled, and the constructors accept beams where that ratio, or lambda*q2s,
# leaves the normal range while w itself is an ordinary double: pi*Im q overflows
# for Im q > DBL_MAX/pi (gaussian_beam_from_q(0, 1e308, 1): w = 0 where it is
# 5.6e153), the ratio underflows (a false 0 — gaussian_beam_new(1, 1e-300): w = 0
# where the closed form gives 1, the ratio being ~1e-601 — and before it a band of
# silently wrong values: 15% at w0 = 1.23, lambda = 1e-161) or overflows (a false
# +inf), and a subnormal lambda*q2s drops bits. 2.6.0 had the same bits. The three
# radius bodies now keep that expression, and its bits, wherever lambda*q2s and the
# ratio are normal doubles, and hand every other case to _bm_w_split.

# 1 if the beam's fields are ones the constructors and elements make: Im q a normal
# positive double, Re q finite, the wavelength finite and positive. The struct's
# fields are public; the cold paths that re-form a result from q — the fields'
# curvature phase and the coupling's q form, and _bm_w_split by the same tests on
# its arguments — leave any other beam 2.6.0's expression.
fn _bm_q_valid(beam) {
    var qi = GaussianBeam_q_im(beam);
    if (qi < 0x0010000000000000) { return 0; }              # a set sign bit reads negative
    if (qi >= _PRK_INF) { return 0; }
    var wl = GaussianBeam_wavelength(beam);
    if (wl <= 0) { return 0; }
    if (wl >= _PRK_INF) { return 0; }
    return _bm_finite(GaussianBeam_q_re(beam));
}

# w = h*sqrt(lambda*q2s/(pi*Im q)) with lambda and Im q split into a power of two
# and a mantissa, for the cases the direct form cannot evaluate. fast is the direct
# form's result, returned unchanged for a beam whose fields no constructor or
# element makes (Im q not a normal positive double, lambda not finite and
# positive, or Re q not finite: h = +inf): those keep their 2.6.0 bits. Otherwise
# lambda = 2^L*lm and Im q = 2^I*im with lm, im in [1, 2) (_bm_frexp), q2s is in
# [1, 8), and core = lm*q2s/(pi*im) is in (0.15, 5.1): the direct form's ratio is
# core*2^(L-I) with the SAME roundings, since scaling by a power of two commutes
# with them. With L - I made even (core doubled, exactly), w = sqrt(core) *
# 2^(H + (L-I)/2), the exponent applied in two steps of which only the second can
# round, so the result is the direct form's evaluated with an unbounded exponent,
# rounded once: within 2.09 ulps of mpmath over 360k such radii (3 fuzz seeds). A
# w beyond the double range comes back +inf (every query here returns a double and
# has no error channel). With valid fields n >= -1048: H >= I, I >= -1022 and L >=
# -1074 (the smallest w is 2^-1048/sqrt(pi), ~2^-1048.8, at Re q = 0, Im q =
# 2^-1022, lambda = 2^-1074), so the 0 below is a guard.
fn _bm_w_split(h, wl, q2s, qi, fast) {
    if (qi < 0x0010000000000000) { return fast; }           # not normal and positive
    if (qi >= _PRK_INF) { return fast; }
    if (wl <= 0) { return fast; }
    if (wl >= _PRK_INF) { return fast; }
    if (h >= _PRK_INF) { return fast; }                      # Re q not finite
    var kl = 0;
    var ki = 0;
    var lm = _bm_frexp(wl, &kl);
    var im = _bm_frexp(qi, &ki);
    var core = f64_div(f64_mul(lm, q2s), f64_mul(F64_PI, im));
    var k = kl - ki;
    if ((k & 1) == 1) {
        core = f64_add(core, core);
        k = k - 1;
    }
    var n = (h >> 52) - 1023 + k / 2;
    if (n > 1100) { return _PRK_INF; }                      # sqrt(core) > 0.39
    if (n < 0 - 1200) { return 0; }                         # sqrt(core) < 3.2
    var n1 = n / 2;
    var n2 = n - n1;
    return f64_mul(f64_mul(f64_sqrt(core), (n1 + 1023) << 52), (n2 + 1023) << 52);
}

# 1/R written through curv_out, and beam_radius's direct form h*sqrt(lambda*q2s/(pi*
# Im q)) — 2.6.0's bits — where lambda*q2s and the ratio are normal doubles, from
# ONE read and scaling of q: the same operations as beam_radius and beam_curvature,
# so the same bits. Where they are not it returns 0, which the direct form never
# gives (w^2 = h^2*ratio, and lambda*q2s >= 2^-1022 with Im q < 2h keeps the
# ratio above 2^-1022/(2*pi*h), so w above 2^-1024). _bm_scaled_wc hands a 0 to
# beam_radius, whose slow path is _bm_w_split; in beam_coupling_efficiency a 0
# makes the sum non-finite, which takes its cold path.
fn _bm_scaled_wcd(beam, curv_out) {
    var qr = GaussianBeam_q_re(beam);
    var qi = GaussianBeam_q_im(beam);
    # h = _bm_scale2(qr, qi), ih = _bm_inv2(h) or 0 past the range: a copy, keep in step.
    var m = qr & _PRK_ABS;
    var ai = qi & _PRK_ABS;
    if (ai > m) { m = ai; }
    var h = m & 0x7FF0000000000000;
    if (h == 0) { h = 0x0010000000000000; }
    var ih = 0;
    if (h < 0x7FE0000000000000) { ih = 0x7FE0000000000000 - h; }
    if (h == 0x7FE0000000000000) { ih = 0x0008000000000000; }
    var qrs = f64_mul(qr, ih);
    var qis = f64_mul(qi, ih);
    var q2s = f64_add(f64_mul(qrs, qrs), f64_mul(qis, qis));
    store64(curv_out, f64_mul(f64_div(qrs, q2s), ih));
    # As beam_radius: the direct form while lambda*q2s and the ratio are normal.
    var num = f64_mul(GaussianBeam_wavelength(beam), q2s);
    var rat = f64_div(num, f64_mul(F64_PI, qi));
    if (num >= 0x0010000000000000) {
        if (rat >= 0x0010000000000000) {
            if (rat < _PRK_INF) { return f64_mul(h, f64_sqrt(rat)); }
        }
    }
    return 0;
}

# beam_radius (returned) and beam_curvature (written through curv_out) of a
# non-null beam from ONE read and scaling of q: the same operations as those two
# functions, so the same bits. For hg_mode_field, which needs both. beam_radius and
# beam_curvature keep their own bodies: routing them through this measured 5 and
# 11 ns slower. The rare beam whose direct form is out of range is handed to
# beam_radius, whose slow path is _bm_w_split.
fn _bm_scaled_wc(beam, curv_out) {
    var w = _bm_scaled_wcd(beam, curv_out);
    if (w != 0) { return w; }
    return beam_radius(beam);
}

# Beam radius w at the current plane: w^2 = lambda*|q|^2/(pi*Im q).
#must_use
fn beam_radius(beam) {
    if (beam == 0) { return _PRK_NAN; }
    var qr = GaussianBeam_q_re(beam);
    var qi = GaussianBeam_q_im(beam);
    # w = h*sqrt(lambda*|q/h|^2/(pi*Im q)) for the power of two h: h^2 = 4^k, so
    # the sqrt takes it out exactly and the bits match the unscaled form in range.
    # h = _bm_scale2(qr, qi), ih = _bm_inv2(h) or 0 past the range: a copy, keep in step.
    var m = qr & _PRK_ABS;
    var ai = qi & _PRK_ABS;
    if (ai > m) { m = ai; }
    var h = m & 0x7FF0000000000000;
    if (h == 0) { h = 0x0010000000000000; }
    var ih = 0;
    if (h < 0x7FE0000000000000) { ih = 0x7FE0000000000000 - h; }
    if (h == 0x7FE0000000000000) { ih = 0x0008000000000000; }
    var qrs = f64_mul(qr, ih);
    var qis = f64_mul(qi, ih);
    var q2s = f64_add(f64_mul(qrs, qrs), f64_mul(qis, qis));
    # The direct form while lambda*q2s and the ratio are normal doubles (2.6.0's
    # bits: non-negative doubles order as integers, and a NaN or a negative fails);
    # _bm_w_split otherwise (see the section header). Nested tests, lambda re-read on
    # the cold path: same-binary A/B, 20 ns as before, where the three tests
    # combined with | measured 4 ns slower and lambda held in a local 1-3 ns (2.6.1
    # review).
    var num = f64_mul(GaussianBeam_wavelength(beam), q2s);
    var rat = f64_div(num, f64_mul(F64_PI, qi));
    if (num >= 0x0010000000000000) {
        if (rat >= 0x0010000000000000) {
            if (rat < _PRK_INF) { return f64_mul(h, f64_sqrt(rat)); }
        }
    }
    return _bm_w_split(h, GaussianBeam_wavelength(beam), q2s, qi, f64_mul(h, f64_sqrt(rat)));
}

# Waist radius w0 of the beam's current Gaussian: sqrt(lambda*z_R/pi).
#must_use
fn beam_waist_radius(beam) {
    if (beam == 0) { return _PRK_NAN; }
    # beam_radius at Re q = 0, in the same scaled form: w0 = h*sqrt(lambda*(qi/h)^2/(pi*qi)).
    # _bm_scale2(0, qi) is qi's exponent field, or 2^-1022 when that is 0.
    var qi = GaussianBeam_q_im(beam);
    # h = _bm_scale2(0, qi), ih = _bm_inv2(h) or 0 past the range: a copy, keep in step.
    var h = qi & 0x7FF0000000000000;
    if (h == 0) { h = 0x0010000000000000; }
    var ih = 0;
    if (h < 0x7FE0000000000000) { ih = 0x7FE0000000000000 - h; }
    if (h == 0x7FE0000000000000) { ih = 0x0008000000000000; }
    var qis = f64_mul(qi, ih);
    # As beam_radius: the direct form while lambda*q2s and the ratio are normal. Its
    # h = 2^1023 branch (Im q >= 2^1023) always takes _bm_w_split, as pi*Im q
    # overflows there.
    var q2s = f64_mul(qis, qis);
    var num = f64_mul(GaussianBeam_wavelength(beam), q2s);
    var rat = f64_div(num, f64_mul(F64_PI, qi));
    if (num >= 0x0010000000000000) {
        if (rat >= 0x0010000000000000) {
            if (rat < _PRK_INF) { return f64_mul(h, f64_sqrt(rat)); }
        }
    }
    return _bm_w_split(h, GaussianBeam_wavelength(beam), q2s, qi, f64_mul(h, f64_sqrt(rat)));
}

# Distance from the current plane to the waist, positive when the waist lies
# ahead (downstream) and negative when it is behind: -Re q.
#must_use
fn beam_waist_distance(beam) {
    if (beam == 0) { return _PRK_NAN; }
    return f64_neg(GaussianBeam_q_re(beam));
}

# Wavefront curvature 1/R = Re q/|q|^2 at the current plane: > 0 diverging,
# < 0 converging, 0 at a waist.
#must_use
fn beam_curvature(beam) {
    if (beam == 0) { return _PRK_NAN; }
    var qr = GaussianBeam_q_re(beam);
    var qi = GaussianBeam_q_im(beam);
    # h = _bm_scale2(qr, qi), ih = _bm_inv2(h) or 0 past the range: a copy, keep in step.
    var m = qr & _PRK_ABS;
    var ai = qi & _PRK_ABS;
    if (ai > m) { m = ai; }
    var h = m & 0x7FF0000000000000;
    if (h == 0) { h = 0x0010000000000000; }
    var ih = 0;
    if (h < 0x7FE0000000000000) { ih = 0x7FE0000000000000 - h; }
    if (h == 0x7FE0000000000000) { ih = 0x0008000000000000; }
    var qrs = f64_mul(qr, ih);
    var qis = f64_mul(qi, ih);
    return f64_mul(f64_div(qrs, f64_add(f64_mul(qrs, qrs), f64_mul(qis, qis))), ih);
}

# Rayleigh range of the beam's current Gaussian: Im q.
#must_use
fn beam_rayleigh_range(beam) {
    if (beam == 0) { return _PRK_NAN; }
    return GaussianBeam_q_im(beam);
}

# The beam's Gouy phase (radians), for TEM00: its starting value — 0 from
# gaussian_beam_new, the local atan(Re q/Im q) from gaussian_beam_from_q and
# beam_resonator_mode — plus every element's increment. A mode of order N (m+n
# for HG, 2p+|l| for LG) carries (N+1) times it. From a waist through free space
# alone this is atan(z/z_R).
#must_use
fn beam_gouy_phase(beam) {
    if (beam == 0) { return _PRK_NAN; }
    return GaussianBeam_gouy(beam);
}

# ── Resonators and mode matching ────────

# The self-consistent TEM00 mode of a resonator whose ROUND-TRIP matrix, taken
# from the reference plane, is [[a, b], [c, d]]: the q that the round trip maps
# to itself, 1/q = (d - a)/(2b) - i*sqrt(4 - (a + d)^2)/(2|b|) (Kogelnik & Li,
# Appl. Opt. 5, 1550, 1966). Returns a new beam at the reference plane, or 0
# with PK_ERR_INVALID_PARAMETER if the resonator is unstable or on a stability
# edge (see below), b = 0, an entry is not finite, or ad - bc is not within 1e-9
# of 1 (a round trip starts and ends in the same medium); PK_ERR_ALLOCATION on
# allocation failure. Its Gouy phase starts at the local atan(Re q/Im q).
# ⚠ STABILITY EDGES ARE REFUSED, with a margin. At |a + d| = 2 — the confocal,
# concentric and planar/hemispherical edges — the round trip does not select a
# mode: a symmetric confocal cavity's is exactly -I, so every q reproduces itself.
# Built in floating point it comes out as -I plus ~1e-16 of noise, and a bare
# `s > 0` test then returned a q made of rounding error, as success (2.6.0
# review). So (ad - bc) - ((a + d)/2)^2 must exceed 1e-12*(|a| + |d|): cavities within
# g ~ 5e-7 of an edge are refused. The textbook confocal spot sqrt(lambda*L/pi)
# is the g -> 0 limit of a nearby cavity, not a property of the matrix.
#must_use
fn beam_resonator_mode(a, b, c, d, wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    var ok = _bm_finite(a) & _bm_finite(b) & _bm_finite(c) & _bm_finite(d);
    if (ok == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # A divide guard only: with b = 0 and det = 1, |a + d| >= 2 already refuses it.
    if ((b & _PRK_ABS) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # f64_le, not "f64_gt(...) == 1 refuses": a NaN determinant (a*d and b*c
    # overflowing to like infinities) compares false both ways and must fail.
    var det = f64_sub(f64_mul(a, d), f64_mul(b, c));
    if (f64_le(f64_abs(f64_sub(det, F64_ONE)), _bm_r(1, 1000000000)) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var half_tr = f64_div(f64_add(a, d), F64_TWO);
    # (ad - bc) - ((a+d)/2)^2, NOT 1 - ((a+d)/2)^2: the det check above admits
    # |det - 1| up to 1e-9, 500x the stability margin, so assuming det = 1 judged a
    # DIFFERENT matrix and returned modes for unstable input (round 2). With the
    # real det, dd = (d-a)^2 + 4s = -4bc exactly and q is the true fixed point.
    var s = f64_sub(det, f64_mul(half_tr, half_tr));
    var s_tol = f64_mul(_bm_r(1, 1000000000000), f64_add(f64_abs(a), f64_abs(d)));
    if (f64_gt(s, s_tol) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # q directly, not as the reciprocal of 1/q (which went subnormal for |b| >~
    # 1e155): with D = d - a and dd = D^2 + 4s = -4bc > 0,
    #   Re q = 2b*D/dd,  Im q = 4|b|*sqrt(s)/dd.
    var dma = f64_sub(d, a);
    var dd = f64_add(f64_mul(dma, dma), f64_mul(f64_from(4), s));
    var q_re = f64_div(f64_mul(f64_mul(F64_TWO, b), dma), dd);
    var q_im = f64_div(f64_mul(f64_mul(f64_from(4), f64_abs(b)), f64_sqrt(s)), dd);
    return gaussian_beam_from_q(q_re, q_im, wavelength, err_out);
}

# eta from q alone, for beam_coupling_efficiency where its (w, 1/R) form fails. With
# 1/q = 1/R - i*lambda/(pi*w^2) the overlap is 4*Im q1*Im q2/|q1 - conj(q2)|^2 =
# 4*Im q1*Im q2/((Re q1 - Re q2)^2 + (Im q1 + Im q2)^2): lambda cancels (for equal
# wavelengths; within the 1e-9 the caller allows, the lambda1 form moves by ~1e-9
# of eta at most), no w, no 1/R, and no difference of two rounded curvatures — Re q1
# - Re q2 is one rounding, exact where Sterbenz applies. Two identical beams give
# exactly 1. The Im q are split into mantissa and exponent (normal: valid beams
# only) and the denominator is _bm_sq2's; a difference or sum past DBL_MAX is formed
# on the halves. The exponent is applied last in two steps, of which only the
# second rounds: eta is 0 only where it rounds to 0. Within 4.1 ulps of mpmath
# (400k random valid pairs and 3 fuzz seeds; 1.2 subnormal ulps below 2^-1022).
fn _bm_couple_q(beam1, beam2) {
    var qr1 = GaussianBeam_q_re(beam1);
    var qi1 = GaussianBeam_q_im(beam1);
    var qr2 = GaussianBeam_q_re(beam2);
    var qi2 = GaussianBeam_q_im(beam2);
    var d = f64_sub(qr1, qr2);
    var s = f64_add(qi1, qi2);
    var eh = 0;
    if (s >= _PRK_INF) { eh = 1; }
    if ((d & _PRK_ABS) >= _PRK_INF) { eh = 1; }
    if (eh == 1) {
        d = f64_sub(f64_mul(qr1, F64_HALF), f64_mul(qr2, F64_HALF));
        s = f64_add(f64_mul(qi1, F64_HALF), f64_mul(qi2, F64_HALF));
    }
    var es = 0;
    var den = _bm_sq2(d, s, &es);                           # in [1, 8)
    var m1 = (qi1 & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var m2 = (qi2 & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var core = f64_div(f64_mul(f64_mul(0x4010000000000000, m1), m2), den);  # in (0.5, 16)
    var n = (qi1 >> 52) + (qi2 >> 52) - 2046 - 2 * (es + eh);
    if (n < 0 - 1200) { return 0; }                         # eta < 2^-1196
    var n1 = n / 2;
    var n2 = n - n1;
    var v = f64_mul(f64_mul(core, (n1 + 1023) << 52), (n2 + 1023) << 52);
    # eta <= 1 (4ab <= (a + b)^2); near two equal Im q the roundings can put the
    # quotient an ulp or two above it, and the bound is returned instead.
    if (v > F64_ONE) { v = F64_ONE; }
    return v;
}

# beam_coupling_efficiency where its direct form's ratio^2 + t^2 is not finite, with
# each radius now in full (_bm_scaled_wc). That sum is +inf or NaN where a radius
# left _bm_scaled_wcd's direct form (its 0 makes the ratio +inf or 0/0), and where
# 2.6.0 returned 4/inf, a false 0 as success wherever eta is representable, or a
# NaN as success (inf*0: two beams with equal rounded curvatures while
# pi*w1*w2/lambda overflows — 1 for identical beams, anything down to 0 for merely
# similar ones) — and, since 2.6.2, where that factor UNDERflows with the
# curvatures different. A radius that is not a finite double is refused: a true
# overflow (_bm_w_split), or fields written out of range (a NaN or infinite q or
# wavelength set through the accessors). A pair of
# beams a constructor or element made then takes the q form; any other keeps
# 2.6.0's 4/den on its radii.
fn _bm_couple_cold(beam1, beam2, err_out) {
    var c1 = 0;
    var c2 = 0;
    var w1 = _bm_scaled_wc(beam1, &c1);
    var w2 = _bm_scaled_wc(beam2, &c2);
    if ((w1 & _PRK_ABS) >= _PRK_INF) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if ((w2 & _PRK_ABS) >= _PRK_INF) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_q_valid(beam1) == 1) {
        if (_bm_q_valid(beam2) == 1) { return _bm_couple_q(beam1, beam2); }
    }
    var ratio = f64_add(f64_div(w1, w2), f64_div(w2, w1));
    var t = f64_mul(f64_div(f64_mul(F64_PI, f64_mul(w1, w2)), GaussianBeam_wavelength(beam1)), f64_sub(c1, c2));
    return f64_div(0x4010000000000000, f64_add(f64_mul(ratio, ratio), f64_mul(t, t)));
}

# Power coupling efficiency between two TEM00 beams at the same plane — the
# squared overlap of their normalised fields:
# eta = 4 / ((w1/w2 + w2/w1)^2 + (pi*w1*w2/lambda)^2*(1/R1 - 1/R2)^2).
# Axes are taken as coincident and parallel. At two waists it reduces to
# ray_fiber's coupling_efficiency_gaussian. Writes PK_ERR_INVALID_PARAMETER
# (returns 0) for a null beam, wavelengths that differ by more than 1e-9
# relative (different media: no single overlap exists), or a beam whose radius is
# not a finite double (beyond the double range, or fields written out of range).
#must_use
fn beam_coupling_efficiency(beam1, beam2, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (beam1 == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (beam2 == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var wl = GaussianBeam_wavelength(beam1);
    var dwl = f64_abs(f64_sub(wl, GaussianBeam_wavelength(beam2)));
    # 0x3E112E0BE826D695 is 1e-9 rounded to nearest, the bits of _bm_r(1, 1000000000),
    # which this computed per call until 2.6.1. 0x4010000000000000 below is 4.0.
    if (f64_gt(dwl, f64_mul(wl, 0x3E112E0BE826D695)) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # w and 1/R of each beam from one scaling of its q (_bm_scaled_wcd), not
    # beam_radius + beam_curvature re-reading and re-scaling it: the same bits.
    var c1 = 0;
    var c2 = 0;
    var w1 = _bm_scaled_wcd(beam1, &c1);
    var w2 = _bm_scaled_wcd(beam2, &c2);
    var ratio = f64_add(f64_div(w1, w2), f64_div(w2, w1));
    var a = f64_div(f64_mul(F64_PI, f64_mul(w1, w2)), wl);
    var dc = f64_sub(c1, c2);
    var t = f64_mul(a, dc);
    var den = f64_add(f64_mul(ratio, ratio), f64_mul(t, t));
    # 2.6.0's expression and bits wherever the sum is finite (the 0 that
    # _bm_scaled_wcd returns for a radius outside its direct form makes it +inf or
    # NaN); _bm_couple_cold otherwise (2.6.1 review). & ABS: inf*0 is x86's default
    # NaN, whose sign bit is set. 2.6.1, same-binary A/B: 103 -> 66 ns (the review's
    # test is within noise: 65 -> 66).
    if ((den & _PRK_ABS) < _PRK_INF) {
        # ⛔ 2.6.2: a = pi*w1*w2/lambda below the normal range (w1*w2 underflowing,
        # or a huge lambda) drops t's bits — to 0 when the product flushes — and
        # 2.6.0 returned 4/ratio^2 as success whatever the curvatures (0.8667 where
        # the true eta is 8.8e-33). Where the curvatures differ, the cold path's
        # q form answers instead; everywhere else these are 2.6.0's bits.
        if (a >= 0x0010000000000000) { return f64_div(0x4010000000000000, den); }
        if ((dc & _PRK_ABS) == 0) { return f64_div(0x4010000000000000, den); }
    }
    return _bm_couple_cold(beam1, beam2, err_out);
}

# ── Orthogonal polynomials ────────

# Physicists' Hermite polynomial H_n(x), by the recurrence
# H_{k+1} = 2x*H_k - 2k*H_{k-1}, H_0 = 1, H_1 = 2x (Abramowitz & Stegun
# 22.7.13). |H_n(x)| grows like (2n/e)^(n/2) for bounded x (DLMF 18.15.26) and
# like (2x)^n for |x| >> sqrt(n), so it overflows for n >~ 250 at EVERY x — even
# x = 0 for even n. The mode fields below use the normalised Hermite functions,
# which do not. NaN for n < 0 (0 is a legitimate value).
# x = 0 is evaluated in closed form, H_odd(0) = 0 and H_2m(0) = (-1)^m (2m)!/m!:
# the recurrence there forms 0*inf once the even iterates overflow (n ~ 270) and
# returned NaN for an exact zero (2.6.0 review).
#must_use
fn hermite_poly(n, x) {
    if (n < 0) { return _PRK_NAN; }
    if (n == 0) { return F64_ONE; }
    if ((x & _PRK_ABS) == 0) {
        if ((n & 1) == 1) { return 0; }
        # H_2m = -2(2m-1)*H_{2m-2} at x = 0 — the recurrence's own step, exactly.
        var h0 = F64_ONE;
        for (var j = 2; j <= n; j = j + 2) { h0 = f64_mul(h0, f64_from(0 - 2 * (j - 1))); }
        return h0;
    }
    var two_x = f64_mul(F64_TWO, x);
    var hm1 = F64_ONE;
    var h = two_x;
    for (var k = 1; k < n; k = k + 1) {
        var hp1 = f64_sub(f64_mul(two_x, h), f64_mul(f64_from(2 * k), hm1));
        hm1 = h;
        h = hp1;
    }
    return h;
}

# Generalised Laguerre polynomial L_p^alpha(x) for integers p >= 0, alpha >= 0,
# by the recurrence (k+1)*L_{k+1} = (2k+1+alpha-x)*L_k - (k+alpha)*L_{k-1},
# L_0 = 1, L_1 = 1 + alpha - x (A&S 22.7.12). L_p^alpha(0) = C(p+alpha, p).
# NaN for p < 0 or alpha < 0.
#must_use
fn laguerre_poly(p, alpha, x) {
    if (p < 0) { return _PRK_NAN; }
    if (alpha < 0) { return _PRK_NAN; }
    if (p == 0) { return F64_ONE; }
    var al = f64_from(alpha);
    var lm1 = F64_ONE;
    var l = f64_sub(f64_add(F64_ONE, al), x);
    for (var k = 1; k < p; k = k + 1) {
        var a = f64_mul(f64_sub(f64_add(f64_from(2 * k + 1), al), x), l);
        var b = f64_mul(f64_add(f64_from(k), al), lm1);
        var lp1 = f64_div(f64_sub(a, b), f64_from(k + 1));
        lm1 = l;
        l = lp1;
    }
    return l;
}

# Normalised Hermite function phi_n(t) = H_n(t)*e^(-t^2/2)/sqrt(2^n*n!*sqrt(pi)),
# which has integral phi_n^2 dt = 1 and |phi_n| <= pi^(-1/4) (Cramer). Evaluated
# by its own three-term recurrence
#   phi_{k+1} = sqrt(2/(k+1))*t*phi_k - sqrt(k/(k+1))*phi_{k-1},
# which never forms H_n or n!.
# ⛔ 2.6.0 review: seeding it with phi_0 = pi^(-1/4)*e^(-t^2/2) UNDERFLOWS for
# |t| > ~37.6, and every later iterate is a multiple of the seed — so HG_m with
# m >~ 745, whose outer (brightest) lobes lie past that, came back as exact
# zeros, a plausible "node", with no error. Two paths now:
#   |t| < 36   — the seeded recurrence as before: the seed keeps full precision,
#                every iterate is bounded by Cramer, the result is unchanged.
#   |t| >= 36  — the same recurrence on h_k = phi_k*e^(t^2/2) (seed pi^(-1/4)),
#                rescaled by 2^-512 whenever |h| passes 2^512, and the Gaussian
#                applied once at the end in log form. Accurate to ~t^2*ulp
#                (~1e-13 at t = 40), the condition number of e^(-t^2/2) itself.
#   |t| > 2^100 — 0: e^(-t^2/2) is below every double long before the order can
#                matter, and a recurrence step there could overflow.
fn _bm_hermite_fn(n, t) {
    var at = t & _PRK_ABS;
    if (at > 0x4630000000000000) { return 0; }
    if (f64_lt(at, f64_from(36)) == 1) {
        # Divided, not multiplied by 1/pi^(1/4): the pre-review expression exactly,
        # so this path IS unchanged bit for bit (round 2 measured 1-ulp moves when
        # it multiplied by the reciprocal while this comment said "unchanged").
        var p0 = f64_div(_prk_exp(f64_neg(f64_div(f64_mul(t, t), F64_TWO))), f64_sqrt(f64_sqrt(F64_PI)));
        if (n == 0) { return p0; }
        var pm1 = p0;
        var p = f64_mul(f64_mul(f64_sqrt(F64_TWO), t), p0);
        for (var k = 1; k < n; k = k + 1) {
            var kf = f64_from(k);
            var k1 = f64_from(k + 1);
            var a = f64_mul(f64_mul(f64_sqrt(f64_div(F64_TWO, k1)), t), p);
            var pp1 = f64_sub(a, f64_mul(f64_sqrt(f64_div(kf, k1)), pm1));
            pm1 = p;
            p = pp1;
        }
        return p;
    }
    var c = f64_div(F64_ONE, f64_sqrt(f64_sqrt(F64_PI)));
    var hm1 = c;
    var h = c;
    if (n > 0) { h = f64_mul(f64_mul(f64_sqrt(F64_TWO), t), c); }
    var cnt = 0;
    for (var j = 1; j < n; j = j + 1) {
        var jf = f64_from(j);
        var j1 = f64_from(j + 1);
        var aj = f64_mul(f64_mul(f64_sqrt(f64_div(F64_TWO, j1)), t), h);
        var hp1 = f64_sub(aj, f64_mul(f64_sqrt(f64_div(jf, j1)), hm1));
        hm1 = h;
        h = hp1;
        if ((h & _PRK_ABS) > 0x5FF0000000000000) {
            h = f64_mul(h, 0x1FF0000000000000);
            hm1 = f64_mul(hm1, 0x1FF0000000000000);
            cnt = cnt + 1;
        }
    }
    if ((h & _PRK_ABS) == 0) { return 0; }
    # ln|phi| = ln|h| + 512*cnt*ln2 - t^2/2, with ln2 split (Cody-Waite) so the
    # count term is exact.
    var k512 = f64_from(512 * cnt);
    var lg = f64_sub(f64_ln(f64_abs(h)), f64_div(f64_mul(t, t), F64_TWO));
    lg = f64_add(f64_add(lg, f64_mul(k512, 0x3FE62E42FEE00000)), f64_mul(k512, 0x3DEA39EF35793C76));
    var v = _prk_exp(lg);
    if (f64_lt(h, 0) == 1) { return f64_neg(v); }
    return v;
}

# ── Hermite-Gaussian and Laguerre-Gaussian modes ────────
#
# Both families are evaluated on the CURRENT plane of a GaussianBeam, whose q
# supplies w and R and whose accumulated Gouy phase Psi supplies the mode's
# (N+1)*Psi. Each is normalised to unit power: the integral of |u|^2 over the
# plane is 1. The phase follows the header's conventions: curvature
# e^(-i*k*r^2/(2R)) with k = 2*pi/wavelength, Gouy e^(+i*(N+1)*Psi), and for LG
# e^(-i*l*phi), which carries +l*hbar per photon.

# Writes re/im and returns the status; on error writes 0 to both. A zero
# amplitude is a zero field whatever the phase: far off axis the Gaussian has
# underflowed while the curvature phase k*r^2/(2R) is past _prk_cos's 2^63 guard
# (or is inf*0 at a waist), and 0*NaN came back as a NaN field (2.6.0 review).
fn _bm_field_out(amp, phase, re_out, im_out) {
    if ((amp & _PRK_ABS) == 0) {
        store64(re_out, 0);
        store64(im_out, 0);
        return PK_ERR_NONE;
    }
    store64(re_out, f64_mul(amp, _prk_cos(phase)));
    store64(im_out, f64_mul(amp, _prk_sin(phase)));
    return PK_ERR_NONE;
}

fn _bm_field_fail(re_out, im_out) {
    store64(re_out, 0);
    store64(im_out, 0);
    return PK_ERR_INVALID_PARAMETER;
}

# The curvature phase -k*(x^2 + y^2)/(2R) re-formed as -pi*(x^2 + y^2)*Re q/(lambda*
# |q|^2) (k/2 = pi/lambda, 1/R = Re q/|q|^2), for the fields where the direct form
# came out inf or NaN (curv). x^2 + y^2 and |q|^2 (_bm_sq2), Re q and lambda
# (_bm_frexp) are split into mantissas and binary exponents, the quotient is formed
# on the mantissas (|core| in (0.19, 51)), and the exponent sum applied last in two
# steps, of which only the second rounds: the phase is finite wherever it is below
# DBL_MAX, and 0 only where it rounds to 0 — so no k, r^2 or 1/R to overflow or
# underflow, and no w (a subnormal w's coarse grid). Within 4 ulps of mpmath (3.96
# at worst over 400k valid beams and points from 2^-1074 to DBL_MAX; 98% within 2),
# 1.4 subnormal ulps where the phase is subnormal. A phase of 2^63 or more still
# reaches _prk_cos's NaN. On the axis, or at Re q = +-0, it is f64_neg(0*Re q), the
# zero the direct form gives there where it is finite, sign included (from cyrius
# 6.6.8 f64_neg flips a zero's sign, so it is -0 for Re q >= +0; below that it was
# 0 - x, and every zero phase +0). A beam whose fields no constructor or element makes
# (_bm_q_valid) keeps curv, the 2.6.0 inf or NaN.
fn _bm_curv_scaled(beam, x, y, curv) {
    if (_bm_q_valid(beam) == 0) { return curv; }
    var qr = GaussianBeam_q_re(beam);
    if (((x | y) & _PRK_ABS) == 0) { return f64_neg(f64_mul(0, qr)); }
    if ((qr & _PRK_ABS) == 0) { return f64_neg(f64_mul(0, qr)); }
    var er = 0;
    var eq = 0;
    var ek = 0;
    var el = 0;
    var r2 = _bm_sq2(x, y, &er);
    var q2 = _bm_sq2(qr, GaussianBeam_q_im(beam), &eq);
    var qm = _bm_frexp(qr, &ek);
    var lm = _bm_frexp(GaussianBeam_wavelength(beam), &el);
    var core = f64_div(f64_mul(f64_mul(F64_PI, r2), qm), f64_mul(lm, q2));
    var n = 2 * er + ek - el - 2 * eq;
    if (n > 1100) { return f64_neg(f64_mul(core, _PRK_INF)); }   # |phase| > 2^1097
    if (n < 0 - 1200) { return f64_neg(f64_mul(core, 0)); }      # |phase| < 2^-1194
    var n1 = n / 2;
    var n2 = n - n1;
    return f64_neg(f64_mul(f64_mul(core, (n1 + 1023) << 52), (n2 + 1023) << 52));
}

# Real amplitude of HG_mn at (x, y) for a beam of radius w:
# (sqrt2/w)*phi_m(sqrt2*x/w)*phi_n(sqrt2*y/w). Takes w, not the beam, so
# hg_mode_field can compute it together with 1/R (_bm_scaled_wc). F64_SQRT2 has
# the bits of f64_sqrt(F64_TWO), which this computed per call until 2.6.1.
fn _bm_hg_amp(w, m, n, x, y) {
    var s = f64_div(F64_SQRT2, w);
    return f64_mul(s, f64_mul(_bm_hermite_fn(m, f64_mul(s, x)), _bm_hermite_fn(n, f64_mul(s, y))));
}

# T(a) = sqrt(2^(a+1)/(pi*a!)) for a = 0..9, correctly rounded (mpmath, 60 digits;
# every entry pinned bit for bit in the tests), so that LG_0,a = T(a)/w * t^a *
# e^(-t^2) with t = r/w. T(0) is sqrt(2/pi), the TEM00 constant.
fn _bm_lga_t(a) {
    if (a == 0) { return 0x3FE9884533D43651; }   # 0.7978845608028653558798921 = sqrt(2/pi)
    if (a < 3) { return 0x3FF20DD750429B6D; }    # 1.128379167095512573896159
    if (a == 3) { return 0x3FED7B6F52FAC55A; }   # 0.9213177319235612780406524
    if (a == 4) { return 0x3FE4D8D7A58FA311; }   # 0.6514700158705598954485128
    if (a == 5) { return 0x3FDA5EA186A92BDF; }   # 0.4120258154914022190316723
    if (a == 6) { return 0x3FCE72F50B645EBB; }   # 0.2378832154870361486051955
    if (a == 7) { return 0x3FC0469473723218; }   # 0.1271539272023722940112539
    if (a == 8) { return 0x3FB0469473723218; }   # 0.06357696360118614700562697
    return 0x3F9EB09410A66866;                   # 0.02997046805976601957311036
}

# T(a)^2 = 2^(a+1)/(pi*a!) for a = 1..9, correctly rounded (mpmath; every entry
# pinned bit for bit in the tests). Both sqrt(T(a)^2 * C) and T(a) * sqrt(C) round
# three times, but in the first the two roundings under the root count half, so its
# error bound is one rounding smaller: about 1 ulp against 1.5.
fn _bm_lga_t2(a) {
    if (a < 3) { return 0x3FF45F306DC9C883; }    # 1.27323954473516268615107
    if (a == 3) { return 0x3FEB2995E7B7B604; }   # 0.8488263631567751241007134
    if (a == 4) { return 0x3FDB2995E7B7B604; }   # 0.4244131815783875620503567
    if (a == 5) { return 0x3FC5BADE52F95E69; }   # 0.1697652726313550248201427
    if (a == 6) { return 0x3FACF9286EA1D337; }   # 0.05658842421045167494004756
    if (a == 7) { return 0x3F908E603F37E669; }   # 0.01616812120298619284001359
    if (a == 8) { return 0x3F708E603F37E669; }   # 0.004042030300746548210003397
    return 0x3F4D6EE3FE9C4448;                   # 0.0008982289557214551577785327
}

# Stirling's series for ln a! - (a ln a - a + ln(2 pi a)/2), less its factor 1/a, as a
# polynomial in x = 1/a^2 cut after hi terms (hi = 2..7), by Horner: sum_{k=1..hi}
# (-x)^(k-1) * |B_2k|/(2k(2k-1)). The coefficients are 1/12, 1/360, 1/1260, 1/1680,
# 1/1188 and 691/360360 for k = 1..6, each fl(num/den), the rational correctly
# rounded, and 1/156 for k = 7, applied as x/156. Each is written ONCE, the top one
# entering as K - x*0 = K, so the tests can read every literal back bit for bit: at
# x = 2^e with e*(hi - 1) near 1000 every lower coefficient is absorbed and the powers
# of x are exact, so the value is (-x)^(hi-1) times the top one; at x = 0 it is 1/12.
fn _bm_lga_ser(hi, x) {
    var c = 0;
    if (hi > 2) {
        if (hi > 3) {
            if (hi > 4) {
                if (hi > 5) {
                    if (hi > 6) { c = f64_div(x, f64_from(156)); }
                    c = f64_sub(0x3F5F6AB0D9993C7D, c);                           # 691/360360
                }
                c = f64_sub(0x3F4B951E2B18FF23, f64_mul(x, c));                   # 1/1188
            }
            c = f64_sub(0x3F43813813813814, f64_mul(x, c));                       # 1/1680
        }
        c = f64_sub(0x3F4A01A01A01A01A, f64_mul(x, c));                           # 1/1260
    }
    c = f64_sub(0x3F66C16C16C16C17, f64_mul(x, c));                               # 1/360
    return f64_sub(0x3FB5555555555555, f64_mul(x, c));                            # 1/12
}

# 2/pi^3 = 0.06450306886639897836884411 correctly rounded (mpmath; pinned bit for bit
# in the tests, which also show that 2/pi/pi/pi in f64 gives the same bits and
# 2/(pi*pi*pi) one ulp more).
fn _bm_lga_k2pi3() { return 0x3FB08345EB45D77E; }

# ln2 - F64_LN2 = 2.319046813846299615494855e-17 correctly rounded (mpmath; pinned bit
# for bit in the tests): the part of ln 2 that the double F64_LN2 leaves out, below
# half an ulp of it.
fn _bm_lga_ln2lo() { return 0x3C7ABC9E3B39803F; }

# u*v - p exactly, for p = fl(u*v): Dekker's product with Veltkamp's split by
# 2^27 + 1 (F64_DD_SPLIT). Exact while the operands are below 2^995 (the split
# cannot overflow) and the error term is not subnormal — true at every call here
# whose answer can be nonzero.
fn _bm_lga_tpe(u, v, p) {
    var cu = f64_mul(F64_DD_SPLIT, u);
    var uh = f64_sub(cu, f64_sub(cu, u));
    var ul = f64_sub(u, uh);
    var cv = f64_mul(F64_DD_SPLIT, v);
    var vh = f64_sub(cv, f64_sub(cv, v));
    var vl = f64_sub(v, vh);
    var e = f64_add(f64_sub(f64_mul(uh, vh), p), f64_mul(uh, vl));
    return f64_add(f64_add(e, f64_mul(ul, vh)), f64_mul(ul, vl));
}

# _bm_lga_wide's subnormal case: x/wn * gn * en * 2^k (wn, gn, en in [1, 2), x
# in [2^-15, 2^283]) correctly rounded, where the plain product's three roundings,
# each up to 2^-53 relative, would add up to ~1.5 of the coarser subnormal ulp.
# The product is carried to ~2^-100 as a double-double (the division's remainder
# and each multiply's low half by _bm_lga_tpe), its high part is rounded onto the
# subnormal grid, and the rounding is then corrected by one step if the residual
# (high part minus the rounded value, which is exact, plus the low part, a sum that
# itself rounds) passes half a step. That is correctly rounded for these inputs (g
# and el bring their own errors in) except when the high part lies exactly on a
# half-step and the low part is below 2^-53 of a half-step, where the correction
# can be missed by one subnormal ulp — about 2^-52 of the calls. And a true value
# closer to a half-step than the rounding of t = r/w moves it (~1e-13 relative in
# these far tails) can come back on either side: one subnormal ulp again, 0 or
# 2^-1074 at the bottom (2.6.0 does the same).
# Here k is in [-1359, -1007] (the caller's result exponent is in [-1075, -1023]).
fn _bm_lga_subn(x, wn, gn, en, k) {
    var q = f64_div(x, wn);
    var qp = f64_mul(q, wn);
    var ql = f64_div(f64_sub(f64_sub(x, qp), _bm_lga_tpe(q, wn, qp)), wn);
    var mh = f64_mul(q, gn);
    var ml = f64_add(_bm_lga_tpe(q, gn, mh), f64_mul(ql, gn));
    var vh = f64_mul(mh, en);
    var vl = f64_add(_bm_lga_tpe(mh, en, vh), f64_mul(ml, en));
    var sh = f64_add(vh, vl);
    var sl = f64_sub(vl, f64_sub(sh, vh));
    # (e + 1023) << 52 is the double 2^e. sh*2^(k+1000) is exact, the step by
    # 2^-1000 rounds once onto the subnormal grid.
    var r = f64_mul(f64_mul(sh, (k + 1000 + 1023) << 52), (1023 - 1000) << 52);
    # sh - r*2^-k (formed as r*2^1000*2^(-k-1000), exact) is exact too: both lie on
    # the grid of ulp(sh) and within half a subnormal step, 2^(-1075-k), of each other.
    var d = f64_sub(sh, f64_mul(f64_mul(r, (1000 + 1023) << 52), (1023 - 1000 - k) << 52));
    var res = f64_add(d, sl);
    var half = (1023 - 1075 - k) << 52;
    if (f64_gt(res, half) == 1) { return r + 1; }
    if (f64_lt(res, f64_neg(half)) == 1) { return r - 1; }
    return r;
}

# x/w * g * el * 2^z in the range the plain product cannot reach: x > 0 in
# [2^-15, 2^283] (the form's constant times sqrt(cf), cf < 2^565), w > 0 (subnormal
# allowed), g a normal double, el != 0 and z an integer. w, g and |el| are split
# into a mantissa in [1, 2) and an integer exponent (a subnormal first scaled by
# 2^64, exactly). The three products are taken on the mantissas, where they round
# exactly as the plain product would with an unbounded exponent (scaling by a
# power of two commutes with rounding), and the exponent is applied last in at
# most two steps, of which only the second can round. A result below 2^-1022 goes
# to _bm_lga_subn instead, and one that over- or underflows does so only because
# the true amplitude does.
fn _bm_lga_wide(x, w, g, el, z) {
    var kw = 0 - 1023;
    var wn = w;
    if (wn < 0x0010000000000000) {                          # subnormal w
        wn = f64_mul(wn, 0x43F0000000000000);    # 2^64
        kw = kw - 64;
    }
    kw = kw + (wn >> 52);
    wn = (wn & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var gn = (g & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var sg = el & 0x8000000000000000;
    var en = el & _PRK_ABS;
    var ke = 0 - 1023;
    if (en < 0x0010000000000000) {                          # subnormal |el|
        en = f64_mul(en, 0x43F0000000000000);    # 2^64
        ke = ke - 64;
    }
    ke = ke + (en >> 52);
    en = (en & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
    var mp = f64_mul(f64_mul(f64_div(x, wn), gn), en);
    # mp is in (2^-16, 2^285); 2^k is the double ((k + 1023) << 52) for k in
    # [-1022, 1023]. Past 1100 the answer is inf and below -1400 it is 0 whatever
    # the mantissa, so k is clamped (z can be large).
    var k = (g >> 52) - 1023 + ke - kw + z;
    if (k > 1100) { k = 1100; }
    if (k < 0 - 1400) { k = 0 - 1400; }
    var km = k + (mp >> 52) - 1023;
    if (km < 0 - 1022) {
        if (km < 0 - 1075) { return sg; }        # below 2^-1075: rounds to 0
        return _bm_lga_subn(x, wn, gn, en, k) | sg;
    }
    if (k > 1000) {
        mp = f64_mul(mp, (k + 23) << 52);        # 2^(k-1000): mp <= 2^385, exact
        k = 1000;
    }
    if (k < 0 - 1000) {
        mp = f64_mul(mp, (k + 2023) << 52);      # 2^(k+1000): mp > 2^-416, exact
        k = 0 - 1000;
    }
    return f64_mul(mp, (k + 1023) << 52) | sg;
}

# x/w * g * el, the last step of every direct form: x > 0 the form's constant
# times sqrt(C), w > 0 the beam radius, g = e^E a normal double, el = P_p != 0.
# The plain product while x/w, x/w * g and the result are normal doubles (an inf
# result is a true overflow); _bm_lga_wide past either end — a w near 2^-1022 or
# 2^1024, a subnormal result, E near -700, or a large C.
fn _bm_lga_out(x, w, g, el) {
    var xw = f64_div(x, w);
    var m = f64_mul(xw, g);
    # xw and m are non-negative, and non-negative doubles order as integers.
    if (xw >= 0x0010000000000000) {                         # 2^-1022
        if (m >= 0x0010000000000000) {                      # 2^-1022
            if (m < 0x7FF0000000000000) {                   # +inf
                var v = f64_mul(m, el);
                if ((v & _PRK_ABS) >= 0x0010000000000000) { return v; }  # 2^-1022
            }
        }
    }
    return _bm_lga_wide(x, w, g, el, 0);
}

# x/w * e^E * el * 2^z with E = eh + elo (|elo| <= ulp(eh)), for the forms where P
# or C carry a binary exponent z or E may be below -700 (where 2.6.0 took its log
# form, exp(ln pref + E + ln|P| + z*ln2), and each ln's rounding, ~700 * 2^-53,
# came out as ~1e-13 of relative error). Such an E is first brought into
# (-512 ln2, 0] by m multiples of 512 ln2, and 512m is taken out of z: m * 512 ln2 =
# m*l1 + 512m*(ln2 - F64_LN2) with l1 = F64_LN2 * 512 (exact); m*l1 is formed exactly
# (_bm_lga_tpe) and added with Knuth's two-sum, and the small second term
# (_bm_lga_ln2lo) goes into the low part, so the reduction rounds nothing that the
# low part does not keep. Before that, an upper bound on log2|V| from the
# exponent fields: below -1080 the answer is 0 (this also keeps m, and 512m, far
# from i64 overflow). e^(eh + elo) = e^eh * (1 + elo).
fn _bm_lga_gen(x, w, eh, elo, el, z) {
    if (f64_lt(eh, 0xC085E00000000000) == 1) {       # E < -700
        var ew = (w >> 52) - 1023;
        if (w < 0x0010000000000000) { ew = 0 - 1074; }      # subnormal w
        var ub = f64_mul(eh, F64_LOG2E);
        ub = f64_add(ub, f64_from((x >> 52) - 1023 - ew + ((el & _PRK_ABS) >> 52) - 1023 + z + 2));
        if (f64_lt(ub, 0xC090E00000000000) == 1) { return el & 0x8000000000000000; }    # -1080
        var l1 = f64_mul(F64_LN2, 0x4080000000000000);                                  # 512 * F64_LN2
        var m = f64_to(f64_div(f64_neg(eh), l1));
        var mf = f64_from(m);
        var ph = f64_mul(mf, l1);
        var sh = f64_add(eh, ph);
        var bb = f64_sub(sh, eh);
        var sl = f64_add(f64_sub(eh, f64_sub(sh, bb)), f64_sub(ph, bb));
        var lo = f64_add(sl, _bm_lga_tpe(mf, l1, ph));
        lo = f64_add(lo, f64_add(f64_mul(f64_from(512 * m), _bm_lga_ln2lo()), elo));
        eh = f64_add(sh, lo);
        elo = f64_sub(lo, f64_sub(eh, sh));
        z = z - 512 * m;
    }
    var g = f64_exp(eh);
    g = f64_add(g, f64_mul(g, elo));
    if (z == 0) { return _bm_lga_out(x, w, g, el); }
    return _bm_lga_wide(x, w, g, el, z);
}

# Real amplitude of LG_pl at radius r, with t = r/w, s = 2t^2 and a = |l|:
#   sqrt(2/pi)/w * s^(a/2) * e^(-s/2) * sqrt(p!/(p+a)!) * L_p^a(s)
#   = sqrt(2/pi)/w * exp(E) * sqrt(C) * P_p,   E = (a*ln s - s - ln a!)/2,
# with C = C(p+a, p) and P_k = L_k^a(s)/C(k+a, k), which is 1 at s = 0 and at
# most e^(s/2). The callers bound p + a by 2^52 (_bm_lg_ok).
# ⛔ The first version multiplied a running product by the RAW L_p^a(s): it
# overflowed for a >~ 3850, L_p^a overflowed on the outer rings once 4p + 2a >~
# 1420, and 0*inf came back as NaN inside the mode, as success, under a comment
# claiming the opposite. The second (review round 1) fixed that and was itself
# measured in round 2 — every point below is the result of a measurement:
#   - P_k by the DIFFERENCE form of A&S 22.7.12 that scipy's eval_genlaguerre
#     uses, D_{k+1} = (k*D_k - s*P_k)/(k+1+a), P_{k+1} = P_k + D_{k+1}. The plain
#     three-term form cancels near the axis: ~3e-12 of peak for LG_400,0 at its
#     brightest point, where this is at rounding level.
#   - P and D rescaled together by 2^-+512 when they leave [2^-512, 2^512].
#   - ln a! NOT summed and subtracted: a*ln s, s and ln a! are each ~1e4 at
#     |l| = 1500 and a naive sum left 2.5e-12 there (18x worse than the pre-review
#     code, 1e-11 at |l| = 4000). For a >= 10, E uses Stirling's ratio,
#     a*ln(s/a) - (s - a) - (ln a! - a*ln a + a), whose last term is the series
#     ln(2*pi*a)/2 + sum_k B_2k/(2k(2k-1)*a^(2k-1)), k = 1..7 (tail < 3e-17 at a = 10).
#   - ln C(p+a, p) as the SHORTER of its two products, prod_{j<=min} (max+j)/j:
#     0 terms whenever p = 0 or l = 0.
#   - ln s taken from t when s = 2t^2 is subnormal, so LG_0,1 does not drop to 0
#     for r/w < 1.6e-162 while its true value is still a normal double.
#   - s > 2^200 returns 0 at once: e^(-s/2) is below every double for any order,
#     and a recurrence step multiplies by ~s (s > 2^512 gave NaN/inf as success).
#   - one multiply by exp(E) where nothing was rescaled and exp(E) is a normal
#     double, the log form otherwise.
# 2.6.1 keeps the recurrence and its rescaling bit for bit, the s cap, the Stirling
# ratio, the SHORTER product (now of exact integers, not of logs: 0 terms still
# whenever p = 0 or l = 0) and LG_0,1's reach below r/w = 1.6e-162 (from t, now
# for every a < 10), and replaces the rest to cut the transcendental calls (f64_ln
# ~35 ns, f64_exp ~20 ns on the bench host). Its first cut was rejected: it divided
# a multiplier carrying sqrt(C) by w BEFORE the small e^E and returned +-inf as
# success where 2.6.0 was finite and right, below w ~ 2^-773 for orders with C
# just under 2^512 (LG_256,256; LG_200,300 from 2^-787). What it does now:
#   - C is ONE double, cf * 2^(512*cexp), multiplied from chunks N/D of exact
#     integers below 2^53 (one chunk is the exact binomial), and enters as sqrt(C).
#   - a < 10: T(a)/w * t^a * e^(-t^2) * sqrt(C) * P, T(a) = sqrt(2^(a+1)/(pi*a!))
#     from a table (no ln a!), with one exp and NO ln while nothing is rescaled and
#     t^2 < 708. t^a = t^(a mod 2) * (t^2)^(a div 2) on the SAME rounded t^2 that s
#     and P use (at a ring d(amp)/ds = 0, so a consistent s cancels its own
#     rounding; t^a from t alone measured 2x worse at |l| = 9); below t = 2^-100,
#     where e^(-t^2) is exactly 1, t^a comes from t while it is >= 2^-1000.
#     Otherwise e^E with E = a*ln t - t^2 as a double-double on the same rounded
#     t^2: the roundings of the product and the sum are kept, ln t's own is not
#     (up to a*|ln t|*2^-53 relative).
#   - a >= 10: 2E = a*ln(s/a) - (s - a) - ser as a double-double (below), and one
#     multiplier (2/pi)^(1/2) * (2*pi*a)^(-1/4) * sqrt(C) = (2/(pi^3*a))^(1/4) *
#     sqrt(C) in place of ln(2*pi*a).
#   - NO log form: every result is x/w * e^E * P * 2^z with the binary exponent z
#     applied exactly (_bm_lga_out, _bm_lga_gen, _bm_lga_wide), so it over- or
#     underflows only where the true amplitude does. 2.6.0's pref*exp(E) returned
#     +-inf as success for a large C at w <~ 2^-520 and 0, or lost bits into a
#     subnormal, at w >~ 2^60 (its relative error reached 1 in the fuzzes below).
#   - all three exp sites call f64_exp directly: -t^2 (t^2 < 2^199), E > -700 and
#     the reduced E in (-512 ln2, 0] are finite by construction, and _prk_exp only
#     screens +-inf.
#   - every literal other than a power of two that enters a value is written ONCE,
#     in a helper the tests read it back through bit for bit (_bm_lga_t, _bm_lga_t2,
#     _bm_lga_ser, _bm_lga_k2pi3, _bm_lga_ln2lo); the Stirling helper is called next
#     to f64_ln(qm): a same-binary A/B found that placement free and an inlined
#     Horner no faster (2.6.1 review). The other literals
#     are powers of two (exact scale factors such as 2^-512, 2^512 and 2^64, some
#     written at more than one site), exponent arithmetic, bit masks, and the
#     thresholds and term counts that pick a path; F64_LN2, F64_LOG2E and
#     F64_DD_SPLIT are the stdlib's (lib/math.cyr).
# Measured against mpmath (60-80 digits; code that shares nothing with this), 2.6.0
# and 2.6.1 compiled into ONE binary, err = |v - V| / (peak of the mode). Every figure
# is one sample's: a pair's worst err is a sample maximum, and where the two versions
# are within an ulp of each other it can fall on either side from sample to sample.
#   - the 32-case sweep (~102,000 radii, w = 1): worst err <= 2.6.0's in every
#     case — LG_0,5 8.7e-16 -> 2.9e-16, LG_60,60 1.1e-14 -> 2.2e-15, LG_200,200
#     3.5e-14 -> 6.9e-15, LG_0,4000 2.2e-13 -> 2.4e-15; LG_p,0 unchanged, where the
#     recurrence, identical in both, sets the worst.
#   - 240 (p, a) pairs (p <= 400, a <= 4000) at w = 1, ~2,100 distinct radii each:
#     max, RMS and 99.9th percentile <= 2.6.0's in all 240.
#   - the same pairs at w = 2^k, k = -1000..1000 (822,312 radii where all versions
#     are finite): 0 NaN, inf or false zero (2.6.0: 7,817 false zeros, 1,579 false
#     infs); the max above 2.6.0's in 3 pairs (LG_9,15, LG_8,3, LG_5,1; at most 0.58
#     ulp of peak), the RMS in 2 (LG_2,2, LG_4,1; 1% or less).
#   - a review sweep (580,428 radii, 67 w in 2^[-1070, 1023] with random mantissas,
#     but ~20 bright radii per pair reused at every w): 0 NaN, inf or false zero
#     (2.6.0: 3,551 false zeros, 8,756 false infs); the max above 2.6.0's in 15 pairs,
#     all with p <= 9 and |l| <= 60, by at most 1.30 ulp of peak, the RMS in 3 (LG_4,2
#     +11%, LG_6,7 +6%, LG_3,6 +0.3%), which the dense sample puts 39-53% BELOW
#     2.6.0's: the rounding of a few radii, not a trend.
#   - at the worst points of 11 of those pairs (the 3 above, the 8 largest here) most
#     of the error is shared — the rounding of t = r/w and s (up to 1e-14) and the
#     recurrence, the same bits in both — and 2.6.1's own prefactor error is at most
#     3.6e-16 relative, below 2.6.0's at 8 of the 11: at those, 2.6.0's larger one
#     happened to cancel part of the shared error.
#   - two random fuzzes (110,507 in-contract cases, w = 2^-1070..2^1023, |l| to 2^52):
#     0 NaN, inf or false zero (2.6.0: 793 false zeros, 3,103 false infs), and max
#     |err|*w <= 2.6.0's in every order class of both.
#   - LG_0,1 is the one pair 2.6.0 already evaluated well (ln s ~ 0 at its ring): on
#     two 20,000-point random-t samples RMS is 14% and 19% lower and the max 5% and 1%
#     higher (+0.06 ulp of peak at most); 38% lower on the dense sample.
# Same-binary A/B (16 interleaved repeats, avg ns, 2.6.0 -> 2.6.1): lg_mode_field
# LG_2,3 424 -> 273; this function LG_2,3 254 -> 128, LG_0,1 140 -> 89, LG_20,15
# 845 -> 488, LG_0,300 203 -> 159, LG_60,60 2602 -> 1122, LG_200,200 8228 -> 3239;
# LG_100,0 and LG_400,0 within noise (their cost is the recurrence, ~13 ns a step).
# Faster at every point measured EXCEPT one shell of the far tail, below e^-700 of
# the peak: r/w in [sqrt(708), ~27.45) for LG_0,1 (the shell moves with the order).
# There the exact E reduction and the correctly rounded subnormal (_bm_lga_subn)
# cost up to 1.8x (2.6.1 review, 2.6.0 -> 2.6.1: LG_0,1 at r = 27w 162 -> 294 ns,
# at 26.65w, still a normal value, 171 -> 204); past it ~30% faster (at 28w and 30w
# 162 -> 115), and a radial sweep across it faster net (0 to 29.9w in 0.1w steps:
# 138 -> 90 ns a point). The review moved the fast form's gate from t^2 < 700 to
# 708, which took [700, 708) off the slow side: LG_0,1 at t = 26.5 and 26.6
# 140 -> 82 and 172 -> 82 ns (166 and 206 with the old gate).
fn _bm_lg_amp(beam, p, al, r) {
    var w = beam_radius(beam);
    var t = f64_div(r, w);
    if ((t & _PRK_ABS) == 0) {
        if (al == 0) { return f64_div(_bm_lga_t(0), w); }
        return 0;
    }
    var tt = f64_mul(t, t);
    var s = f64_mul(F64_TWO, tt);
    # |s| as an integer: +inf and every NaN compare above the cap (2^200) and go to 0.
    if ((s & _PRK_ABS) > 0x4C70000000000000) { return 0; }  # 2^200
    var dk = 0;
    var el = F64_ONE;
    var cnt = 0;
    for (var k = 0; k < p; k = k + 1) {
        dk = f64_div(f64_sub(f64_mul(f64_from(k), dk), f64_mul(s, el)), f64_from(k + 1 + al));
        el = f64_add(el, dk);
        var mx = el & _PRK_ABS;
        if ((dk & _PRK_ABS) > mx) { mx = dk & _PRK_ABS; }
        if (mx > 0x5FF0000000000000) {                      # 2^512
            el = f64_mul(el, 0x1FF0000000000000);           # 2^-512
            dk = f64_mul(dk, 0x1FF0000000000000);           # 2^-512
            cnt = cnt + 1;
        }
        if (mx < 0x1FF0000000000000) {                      # 2^-512
            if (mx != 0) {
                el = f64_mul(el, 0x5FF0000000000000);       # 2^512
                dk = f64_mul(dk, 0x5FF0000000000000);       # 2^512
                cnt = cnt - 1;
            }
        }
    }
    if ((el & _PRK_ABS) == 0) { return 0; }
    # C = C(mhi + mlo, mlo) = prod_{j<=mlo} (mhi+j)/j in chunks N/D: N <= lim before
    # a step keeps N*(mhi+j) <= 2^53, and D <= N, so both are exact integers; lim >=
    # 2 because the callers bound p + a by 2^52 (_bm_lg_ok). C = cf * 2^(512*cexp):
    # a running cf past 2^512 is scaled by 2^-512 (exactly) at the next chunk
    # boundary, so cf < 2^565.
    var mlo = p;
    var mhi = al;
    if (al < p) {
        mlo = al;
        mhi = p;
    }
    var cf = F64_ONE;
    var cexp = 0;
    if (mlo > 0) {
        var lim = 0x20000000000000 / (mhi + mlo);           # 2^53
        var nn = 1;
        var dd = 1;
        for (var jb = 1; jb <= mlo; jb = jb + 1) {
            if (nn > lim) {
                cf = f64_mul(cf, f64_div(f64_from(nn), f64_from(dd)));
                if (cf > 0x5FF0000000000000) {              # 2^512
                    cf = f64_mul(cf, 0x1FF0000000000000);   # 2^-512
                    cexp = cexp + 1;
                }
                nn = 1;
                dd = 1;
            }
            nn = nn * (mhi + jb);
            dd = dd * jb;
        }
        cf = f64_mul(cf, f64_div(f64_from(nn), f64_from(dd)));
    }
    if (al < 10) {
        # T(a)/w * t^a * e^(-t^2) * sqrt(C) * P, sqrt(C) folded into T.
        var q0 = 0;
        if (cf == F64_ONE) {
            q0 = _bm_lga_t(al);
        } else {
            q0 = f64_sqrt(f64_mul(_bm_lga_t2(al), cf));
        }
        if (cnt == 0) {
            if (cexp == 0) {
                # t^2 < 708: e^(-t^2) is still a normal double (2^-1022 = e^-708.396),
                # the g that _bm_lga_out requires.
                if (tt < 0x4086200000000000) {           # t^2 < 708
                    var g = 0;
                    if (t >= 0x39B0000000000000) {       # t >= 2^-100
                        g = f64_exp(f64_neg(tt));
                        if (al > 0) {
                            var ta = F64_ONE;
                            if ((al & 1) == 1) { ta = t; }
                            if (al > 1) {
                                var tb = tt;
                                for (var kt = 3; kt < al; kt = kt + 2) { tb = f64_mul(tb, tt); }
                                ta = f64_mul(ta, tb);
                            }
                            g = f64_mul(ta, g);
                        }
                    } else {
                        # t < 2^-100: e^(-t^2) is exactly 1, and t^2 may be subnormal,
                        # so t^a comes from t while it stays >= 2^-1000.
                        var tz = F64_ONE;
                        for (var kz = 0; kz < al; kz = kz + 1) { tz = f64_mul(tz, t); }
                        if (tz >= 0x0170000000000000) { g = tz; }        # 2^-1000
                    }
                    if (g != 0) { return _bm_lga_out(q0, w, g, el); }
                }
            }
        }
        # Otherwise t^a * e^(-t^2) as e^E, E = a*lt - tt with lt = fl(ln t) and tt the
        # rounded t^2 above, as a double-double that keeps the rounding of the product
        # and the sum but not of ln t itself: that one adds up to a*|ln t|*2^-53 of
        # relative error, the same order as 2.6.0's here. a <= 9 has 4 bits, so a*lth
        # and a*(lt - lth) are exact for lt's low 4 bits masked off, and x1 - tt is a
        # two-sum.
        var eh = f64_neg(tt);
        var elo = 0;
        if (al > 0) {
            var lt = f64_ln(t);
            var lth = lt & 0xFFFFFFFFFFFFFFF0;
            var af0 = f64_from(al);
            var x1 = f64_mul(af0, lth);
            eh = f64_add(x1, f64_neg(tt));
            var b0 = f64_sub(eh, x1);
            elo = f64_add(f64_sub(x1, f64_sub(eh, b0)), f64_sub(f64_neg(tt), b0));
            elo = f64_add(elo, f64_mul(af0, f64_sub(lt, lth)));
            var e1 = f64_add(eh, elo);
            elo = f64_sub(elo, f64_sub(e1, eh));
            eh = e1;
        }
        return _bm_lga_gen(q0, w, eh, elo, el, 512 * cnt + 256 * cexp);
    }
    # a >= 10 and s subnormal: 1/w <= 2^1074, T(a)*sqrt(C) <= 2^(26.5a + 0.5)/a!
    # for p + a <= 2^52, t^a < 2^(-511.5a) and P <= 1, so |V| < 2^(1075 - 485a) <
    # 2^-3775: the answer is 0 at every w and order the callers allow.
    if ((s & _PRK_ABS) < 0x0010000000000000) { return 0; }  # s subnormal
    # 2E = a*ln(s/a) - (s - a) - ser, Stirling's ratio: ln a! = a ln a - a +
    # ln(2 pi a)/2 + ser, with ln(2 pi a)/2 folded into the multiplier below.
    # ln(s/a) = ln q + (s - q*a)/s with q = fl(s/a) and the remainder s - q*a exact
    # (Dekker's product): the rounding of q, times a, WAS the error at |l| = 1500.
    # ln q = ln qm + j ln2 with qm = q*2^-j in [0.75, 1.5): |ln qm| <= 0.41, so its
    # rounding, which a multiplies, is small (ln q taken whole measured worst err
    # 2.6e-15 vs 2.2e-15 for LG_7,60 and 3.9e-15 vs 3.4e-15 for LG_60,60 over the
    # bright rings); a*ln qm is formed exactly as x1 + x2, (a*j)*ln2 as a
    # double-double, and every subtraction keeps its error (a - s exactly while
    # s < 2^53; past that the recurrence would need ~1e15 steps to be non-zero), so
    # what is left in E is ln qm's own rounding times a and terms below 2^-60 —
    # a*ln(s/a) and s - a are
    # each ~1e4 at |l| = 1500, and fl(u - ser) put a fixed offset of up to ulp(u)/2
    # into every E of a binade of u (2.6.1 review).
    var af = f64_from(al);
    var q = f64_div(s, af);
    var ph = f64_mul(q, af);
    var qm = q;
    var j = 0;
    if (q >= 0x0010000000000000) {                          # q normal
        j = (q >> 52) - 1023;
        qm = (q & 0x000FFFFFFFFFFFFF) | 0x3FF0000000000000;
        if (qm >= 0x3FF8000000000000) {                  # 1.5
            qm = f64_mul(qm, F64_HALF);
            j = j + 1;
        }
    }
    var ia = f64_div(F64_ONE, af);
    var ia2 = f64_mul(ia, ia);
    # ser = sum_k B_2k/(2k(2k-1) a^(2k-1)) = (1/a) * _bm_lga_ser(ks, 1/a^2), from k = 1
    # to the last term ks still >= 1e-19 (a = 20, 31, 59, 180, 1514 drop one more
    # each); below a = 20 all seven (tail < 3e-17 at a = 10). Taken here, before
    # f64_ln(qm), the call costs nothing measurable (after the ln it cost 5-10 ns).
    var ks = 2;
    if (al < 1514) { ks = 3; }
    if (al < 180) { ks = 4; }
    if (al < 59) { ks = 5; }
    if (al < 31) { ks = 6; }
    if (al < 20) { ks = 7; }
    var ser = f64_mul(ia, _bm_lga_ser(ks, ia2));
    var lq = f64_ln(qm);
    var pl = 0;
    var x1 = 0;
    var x2 = 0;
    if (al < 0x4000000) {                                   # 2^26
        # a < 2^26 has at most 26 significant bits, q or lq with its low 26 bits
        # masked off at most 27, and the part masked off at most 26: qh*a, (q-qh)*a,
        # lh*a and (lq-lh)*a are all exact.
        var qh = q & 0xFFFFFFFFFC000000;
        pl = f64_add(f64_sub(f64_mul(qh, af), ph), f64_mul(f64_sub(q, qh), af));
        var lh = lq & 0xFFFFFFFFFC000000;
        x1 = f64_mul(af, lh);
        x2 = f64_mul(af, f64_sub(lq, lh));
    } else {
        pl = _bm_lga_tpe(q, af, ph);
        x1 = f64_mul(af, lq);
        x2 = _bm_lga_tpe(af, lq, x1);
    }
    var lo = x2;
    if (j != 0) {
        # (a*j)*ln2 = y1 + ye. |a*j| < 2^27: y1 = (a*j)*lnh with lnh = F64_LN2 to 26
        # significant bits (its low 27 bits masked off), exact, and ye = (a*j)*(ln2 -
        # lnh), where ln2 - lnh = (F64_LN2 - lnh) + (ln2 - F64_LN2), the first term
        # exact and the sum rounded once, comes out correctly rounded (checked in the
        # tests), so ye's error is ~2^-80*a*j. Past 2^27 (e^E is then below 2^-10^6
        # unless p is ~10^7): y1 = fl((a*j)*F64_LN2), and ye is its low half
        # (_bm_lga_tpe) plus (a*j)*(ln2 - F64_LN2). |a*j| < 2^63; f64_from(a*j) rounds
        # only past 2^53, which takes |j| >= 3 and a >~ 2^43 (a <= 2^52): e^E is then
        # below e^(-10^12), and only a p of order 10^14 — as many recurrence steps —
        # could bring the amplitude back into range.
        var ajf = f64_from(al * j);
        var y1 = 0;
        var ye = 0;
        if ((ajf & _PRK_ABS) < 0x41A0000000000000) {                                  # 2^27
            var lnh = F64_LN2 & 0xFFFFFFFFF8000000;
            y1 = f64_mul(ajf, lnh);
            ye = f64_mul(ajf, f64_add(f64_sub(F64_LN2, lnh), _bm_lga_ln2lo()));
        } else {
            y1 = f64_mul(ajf, F64_LN2);
            ye = f64_add(_bm_lga_tpe(ajf, F64_LN2, y1), f64_mul(ajf, _bm_lga_ln2lo()));
        }
        var h0 = f64_add(x1, y1);
        var b0 = f64_sub(h0, x1);
        lo = f64_add(lo, f64_add(f64_add(f64_sub(x1, f64_sub(h0, b0)), f64_sub(y1, b0)), ye));
        x1 = h0;
    }
    # x1 ~ a ln q and nd = a - s have opposite signs and |x1| <= |nd| exactly when
    # s >= a (ln q <= q - 1); where the two are within a factor 2 the sum is exact
    # (Sterbenz). So Fast2Sum with the larger first is exact: h1 + (its error) = x1 +
    # nd. The last sum is Fast2Sum too: where |lo| > |h1|, E is within 0.01 of 0 and
    # the error it could miss is below 2^-60.
    var nd = f64_sub(af, s);
    var h1 = f64_add(x1, nd);
    if (s >= af) {
        lo = f64_add(lo, f64_sub(x1, f64_sub(h1, nd)));
    } else {
        # and nd itself rounds when s < a/2: (a - nd) - s is that rounding error,
        # exactly (a - nd by Sterbenz, and a rounded difference's error is a
        # double), and 0 for s in [a/2, a), where nd is exact.
        lo = f64_add(lo, f64_add(f64_sub(nd, f64_sub(h1, x1)), f64_sub(f64_sub(af, nd), s)));
    }
    lo = f64_sub(f64_add(lo, f64_mul(af, f64_div(f64_sub(f64_sub(s, ph), pl), s))), ser);
    var e2 = f64_add(h1, lo);
    var eh2 = f64_mul(e2, F64_HALF);
    var elo2 = f64_mul(f64_sub(lo, f64_sub(e2, h1)), F64_HALF);
    # (2/pi)^(1/2) * (2*pi*a)^(-1/4) * sqrt(C) = (2/(pi^3*a) * C^2)^(1/4), with 2/pi^3
    # correctly rounded (_bm_lga_k2pi3).
    var mq = f64_sqrt(f64_div(_bm_lga_k2pi3(), af));
    if (cf != F64_ONE) { mq = f64_mul(mq, cf); }
    var xm = f64_sqrt(mq);
    if (cnt == 0) {
        if (cexp == 0) {
            if (f64_gt(eh2, 0xC085E00000000000) == 1) {    # E > -700
                var g2 = f64_exp(eh2);
                return _bm_lga_out(xm, w, f64_add(g2, f64_mul(g2, elo2)), el);
            }
        }
    }
    return _bm_lga_gen(xm, w, eh2, elo2, el, 512 * cnt + 256 * cexp);
}

# 1 if the HG arguments are usable: beam non-null, m, n >= 0, x, y finite.
fn _bm_hg_ok(beam, m, n, x, y) {
    if (beam == 0) { return 0; }
    if (m < 0) { return 0; }
    if (n < 0) { return 0; }
    return _bm_finite(x) & _bm_finite(y);
}

# Complex field of the Hermite-Gaussian mode HG_mn at (x, y) on the beam's
# current plane:
#   u = (sqrt2/w)*phi_m(sqrt2*x/w)*phi_n(sqrt2*y/w)
#       * exp(-i*k*(x^2+y^2)/(2R)) * exp(i*(m+n+1)*Psi),
# phi_k the normalised Hermite function. Writes Re u / Im u through re_out /
# im_out. Returns PK_ERR_NONE, or PK_ERR_INVALID_PARAMETER (writing 0, 0) for a
# null beam, a negative order or a non-finite coordinate. A nonzero amplitude
# whose phase is 2^63 radians or more comes back as a NaN field: no double
# resolves such a phase (_prk_cos, error.cyr). For a beam a constructor or
# element made, the curvature term of the phase is finite wherever its true value
# is below DBL_MAX.
fn hg_mode_field(beam, m, n, x, y, re_out, im_out) {
    if (_bm_hg_ok(beam, m, n, x, y) == 0) { return _bm_field_fail(re_out, im_out); }
    # w and 1/R from one scaling of q (_bm_scaled_wc), not beam_radius +
    # beam_curvature: the same bits. F64_TAU has the bits of F64_TWO*F64_PI (doubling
    # is exact), and x/2 and x*0.5 round the same real, so /2 is a multiply.
    var cv = 0;
    var amp = _bm_hg_amp(_bm_scaled_wc(beam, &cv), m, n, x, y);
    var k = f64_div(F64_TAU, GaussianBeam_wavelength(beam));
    var r2 = f64_add(f64_mul(x, x), f64_mul(y, y));
    var curv = f64_neg(f64_mul(f64_mul(f64_mul(k, r2), cv), F64_HALF));
    # ⛔ 2.6.1 review: k = 2*pi/lambda overflows for lambda < 3.5e-308 (normal
    # lambdas included), x^2 + y^2 past 1.3e154, and k*r^2 — or its product with
    # 1/R — wherever it passes DBL_MAX, which a small lambda brings to ordinary
    # lengths (Re q = 1e300, Im q = 1e290, lambda = 1e-300: w = 5.6e4, k*w^2/4 =
    # 5e309). The phase was then inf*0 = NaN on the axis or where 1/R is 0 (a waist,
    # or a 1/R that underflowed), or +-inf elsewhere (the sign of -Re q), and the
    # field a NaN returned as success, at any true phase (2.6.0 did the same). Only
    # then is it re-formed, from q and lambda (_bm_curv_scaled).
    if ((curv & _PRK_INF) == _PRK_INF) { curv = _bm_curv_scaled(beam, x, y, curv); }
    var gouy = f64_mul(f64_from(m + n + 1), GaussianBeam_gouy(beam));
    # 2.6.1, same-binary A/B: 296 -> 261 ns (the cos/sin pair is ~80 of it).
    return _bm_field_out(amp, f64_add(curv, gouy), re_out, im_out);
}

# Intensity |u|^2 of HG_mn at (x, y) (power per unit area for a 1 W beam). NaN
# for a null beam, a negative order or a non-finite coordinate.
#must_use
fn hg_mode_intensity(beam, m, n, x, y) {
    if (_bm_hg_ok(beam, m, n, x, y) == 0) { return _PRK_NAN; }
    var amp = _bm_hg_amp(beam_radius(beam), m, n, x, y);
    return f64_mul(amp, amp);
}

# 1 if the LG arguments are usable: beam non-null, p >= 0, |l| representable
# (l = INT64_MIN has no positive counterpart), p + |l| <= 2^52, r finite and >= 0.
# The order bound keeps the integers the amplitude builds from the orders far from
# i64 overflow: k + 1 + |l| and mhi + j (both <= p + |l| <= 2^52, so also exact as
# doubles) and the binomial chunks N*(mhi + j) <= 2^53. The Gouy factor 2p + |l| + 1
# is at most 2^53 + 1: no wrap, and f64_from rounds it by at most one part in 2^53.
# Without the bound, |l| near INT64_MAX with p >= 1 wrapped k + 1 + |l| and mhi + j
# negative and returned NaN as success (2.6.1 review). The bound is far above any
# practical order; past it the order is refused, not wrapped.
fn _bm_lg_ok(beam, p, l, r) {
    if (beam == 0) { return 0; }
    if (p < 0) { return 0; }
    if (l == 0x8000000000000000) { return 0; }
    if (p > 0x10000000000000) { return 0; }                 # 2^52
    if (_bm_iabs(l) > 0x10000000000000 - p) { return 0; }   # 2^52 - p
    if (_bm_finite(r) == 0) { return 0; }
    if (f64_lt(r, 0) == 1) { return 0; }
    return 1;
}

fn _bm_iabs(l) {
    if (l < 0) { return 0 - l; }
    return l;
}

# Complex field of the Laguerre-Gaussian mode LG_pl at polar (r, phi) on the
# beam's current plane:
#   u = sqrt(2*p!/(pi*(p+|l|)!))/w * s^(|l|/2) * L_p^|l|(s) * e^(-s/2)
#       * exp(-i*k*r^2/(2R)) * exp(-i*l*phi) * exp(i*(2p+|l|+1)*Psi),
# s = 2r^2/w^2. l > 0 carries +l*hbar of orbital angular momentum per photon (see
# the header). LG_0,+-1 = (HG_10 -+ i*HG_01)/sqrt2. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER (writing 0, 0) for a null beam, p < 0, l = INT64_MIN,
# p + |l| > 2^52 (see _bm_lg_ok), r < 0, or a non-finite r or phi. A phase of 2^63
# radians or more gives a NaN field, and the curvature term is formed, as in
# hg_mode_field.
fn lg_mode_field(beam, p, l, r, phi, re_out, im_out) {
    if (_bm_lg_ok(beam, p, l, r) == 0) { return _bm_field_fail(re_out, im_out); }
    if (_bm_finite(phi) == 0) { return _bm_field_fail(re_out, im_out); }
    var al = _bm_iabs(l);
    var amp = _bm_lg_amp(beam, p, al, r);
    # k and the /2 as in hg_mode_field: the same bits, 4.5-22 ns faster depending
    # on code layout (2.6.1, same-binary A/B); _bm_lg_amp and the cos/sin pair are
    # most of this row's cost.
    var k = f64_div(F64_TAU, GaussianBeam_wavelength(beam));
    var curv = f64_neg(f64_mul(f64_mul(f64_mul(k, f64_mul(r, r)), beam_curvature(beam)), F64_HALF));
    # As in hg_mode_field: re-formed from q and lambda only where it came out inf or NaN.
    if ((curv & _PRK_INF) == _PRK_INF) { curv = _bm_curv_scaled(beam, r, 0, curv); }
    var gouy = f64_mul(f64_from(2 * p + al + 1), GaussianBeam_gouy(beam));
    var helix = f64_neg(f64_mul(f64_from(l), phi));
    return _bm_field_out(amp, f64_add(f64_add(curv, helix), gouy), re_out, im_out);
}

# Intensity |u|^2 of LG_pl at radius r (independent of phi and of the sign of
# l). NaN for a null beam, p < 0, l = INT64_MIN, p + |l| > 2^52 (see _bm_lg_ok),
# or r negative or non-finite.
#must_use
fn lg_mode_intensity(beam, p, l, r) {
    if (_bm_lg_ok(beam, p, l, r) == 0) { return _PRK_NAN; }
    var amp = _bm_lg_amp(beam, p, _bm_iabs(l), r);
    return f64_mul(amp, amp);
}

# Radius of the bright ring of LG_0l: w*sqrt(|l|/2), where s^|l|*e^(-s) peaks.
# 0 for l = 0 (the peak is on axis); NaN for a null beam or l = INT64_MIN.
#must_use
fn lg_mode_peak_radius(beam, l) {
    if (beam == 0) { return _PRK_NAN; }
    if (l == 0x8000000000000000) { return _PRK_NAN; }
    return f64_mul(beam_radius(beam), f64_sqrt(f64_div(f64_from(_bm_iabs(l)), F64_TWO)));
}

# ── Beam quality: M^2 and second moments (ISO 11146) ────────

# M^2 of HG_mn along the axis of order m: 2m+1 (so HG_mn has M^2_x = 2m+1,
# M^2_y = 2n+1). NaN for m < 0.
#must_use
fn hg_mode_m2(m) {
    if (m < 0) { return _PRK_NAN; }
    # In f64: 2*m + 1 in i64 wraps negative for m >= 2^62 (2.6.0 review).
    return f64_add(f64_mul(F64_TWO, f64_from(m)), F64_ONE);
}

# M^2 of LG_pl, the same on every transverse axis: 2p + |l| + 1. NaN for p < 0.
#must_use
fn lg_mode_m2(p, l) {
    if (p < 0) { return _PRK_NAN; }
    # In f64, where |l| of INT64_MIN is exactly 2^63 and nothing wraps.
    return f64_add(f64_add(f64_mul(F64_TWO, f64_from(p)), f64_abs(f64_from(l))), F64_ONE);
}

# Beam quality factor from a second-moment waist radius W0 and far-field
# half-angle divergence theta: M^2 = pi*W0*theta/lambda (ISO 11146-1). A TEM00
# beam gives exactly 1. Writes PK_ERR_INVALID_PARAMETER (returns 0) unless all
# three are finite and positive.
#must_use
fn beam_m2(w0, theta, wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_check(w0, wavelength, err_out) == 0) { return 0; }
    if (_bm_pos(theta) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return _bm_out(f64_div(f64_mul(F64_PI, f64_mul(w0, theta)), wavelength), err_out);
}

# Beam parameter product W0*theta = M^2*lambda/pi, invariant through any
# lossless paraxial system in one medium. Writes PK_ERR_INVALID_PARAMETER
# (returns 0) for M^2 < 1 or non-finite, or a bad wavelength.
#must_use
fn beam_parameter_product(m2, wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_finite(m2) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (f64_lt(m2, F64_ONE) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_pos(wavelength) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return _bm_out(f64_div(f64_mul(m2, wavelength), F64_PI), err_out);
}

# Second-moment ("D4-sigma") beam radius W = 2*sigma of a sampled 1D intensity
# profile, samples[i] at x0 + i*dx (ISO 11146-1). The centroid is removed first
# (two passes), so the profile need not be centred. For a TEM00 beam W is its
# 1/e^2 radius w; for HG_m it is w*sqrt(2m+1). For a 2D beam pass the marginal
# (the profile summed across the other axis). Samples may be negative after
# background subtraction, but must be finite. Writes PK_ERR_INVALID_PARAMETER
# (returns 0) for a null buffer, count < 3, dx not finite and positive, x0 not
# finite, a non-finite sample, a total or variance that is not positive, or a W beyond the double
# range. The moments are taken in units of the sample spacing and W scaled by dx once at the end
# (2.15.1: in metres, dx = 1e200 squared the offsets past the double range and returned W = inf
# with PK_ERR_NONE).
#must_use
fn beam_second_moment_radius(samples, count, x0, dx, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (samples == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (count < 3) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if ((_bm_pos(dx) & _bm_finite(x0)) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var s0 = 0;
    var s1 = 0;
    for (var i = 0; i < count; i = i + 1) {
        var v = load64(samples + i * 8);
        if (_bm_finite(v) == 0) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        s0 = f64_add(s0, v);
        s1 = f64_add(s1, f64_mul(v, f64_from(i)));
    }
    if (f64_gt(s0, 0) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # Offsets are measured from x0, in samples, so x0 cancels out of the variance exactly.
    var mean = f64_div(s1, s0);
    var s2 = 0;
    for (var j = 0; j < count; j = j + 1) {
        var d = f64_sub(f64_from(j), mean);
        s2 = f64_add(s2, f64_mul(load64(samples + j * 8), f64_mul(d, d)));
    }
    var var_ = f64_div(s2, s0);
    if (f64_gt(var_, 0) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return _bm_out(f64_mul(f64_mul(F64_TWO, dx), f64_sqrt(var_)), err_out);
}

# ── Orbital angular momentum ────────

# Speed of light in vacuum, m/s (exact by the SI definition of the metre).
fn _bm_c() { return f64_from(299792458); }

# Orbital angular momentum carried per unit time by a beam of power P whose
# photons each carry l*hbar: l*P/omega = l*P*lambda0/(2*pi*c), in N*m for SI
# inputs — the torque it exerts on anything that absorbs it fully. lambda0 is the
# VACUUM wavelength in metres (omega does not change between media). The sign of
# l carries the handedness; a power has none. Writes PK_ERR_INVALID_PARAMETER
# (returns 0) for a power that is negative or not finite — oam_flux(l, -P) would
# otherwise be indistinguishable from oam_flux(-l, P) — or a bad wavelength.
#must_use
fn oam_flux(l, power, vacuum_wavelength, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_nonneg(power) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_pos(vacuum_wavelength) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var omega_inv = f64_div(vacuum_wavelength, f64_mul(F64_TWO, f64_mul(F64_PI, _bm_c())));
    return _bm_out(f64_mul(f64_mul(f64_from(l), power), omega_inv), err_out);
}

# Total step height of a spiral phase plate that gives a TEM00 beam topological
# charge l: h = l*lambda/(n_rel - 1), with the thickness rising as h*phi/(2*pi).
# lambda is the wavelength in the surrounding medium and n_rel the plate's index
# relative to it. In this module's convention a thickness that rises with phi
# (from +x toward +y) adds e^(-i*l*phi), i.e. charge +l. Writes
# PK_ERR_INVALID_PARAMETER (returns 0) for n_rel <= 1 or not finite, or a bad
# wavelength.
#must_use
fn spiral_phase_plate_step(l, wavelength, n_rel, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (_bm_pos(wavelength) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (_bm_finite(n_rel) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (f64_gt(n_rel, F64_ONE) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return _bm_out(f64_div(f64_mul(f64_from(l), wavelength), f64_sub(n_rel, F64_ONE)), err_out);
}

# --- wave_focus.cyr ---

# wave_focus.cyr -- vectorial focusing by an aplanatic lens: the Richards-Wolf integrals for
# linear, elliptical, radial and azimuthal polarization
# Usage: include "lib/wave_focus.cyr"  (requires error.cyr, ray_prt.cyr, wave_beam.cyr)
#
# New in 2.13.0, and NOT a port: the Rust 1.x crate had only the scalar Airy pattern. Near the
# focus of a lens of high numerical aperture that pattern is wrong in kind, not only in size.
# The lens tilts the field of every ray it bends, so a linearly polarized beam focuses to an
# elongated spot with a field along the axis, and a radially polarized one to a spot whose
# axial field is the strongest part of it. This is the Debye-Wolf integral for an aplanatic
# lens (Richards & Wolf, Proc. R. Soc. A 253, 358 (1959)) as Novotny & Hecht write it,
# "Principles of Nano-Optics" (2nd ed., 2012) section 3.6, with the cylindrical vector beams
# of Youngworth & Brown, Opt. Express 7, 77 (2000).
#
# THE INTEGRALS. theta runs from 0 to the aperture angle alpha, sin(alpha) = NA/n2. With
# k = 2 pi n2/lambda0, g(theta) the pupil amplitude at the height h = f sin(theta), and
#   W = g sqrt(cos) sin e^(i k z cos) dtheta,   J_n = J_n(k rho sin),
#   I00 = int W (1 + cos) J0      I01 = int W sin J1      I02 = int W (1 - cos) J2
#   Irho = int W cos J1           Iz = int W sin J0       Iphi = int W J1
# THE FIELDS at (rho, phi, z) from the geometric focus, with A = (k f/2) sqrt(n1/n2) E0:
#   x-polarized input        E = -i A (I00 + I02 cos 2phi,  I02 sin 2phi,  -2i I01 cos phi)
#   y-polarized input        E = -i A (I02 sin 2phi,  I00 - I02 cos 2phi,  -2i I01 sin phi)
#   radial, E0 g rho-hat     E = -2A Irho rho-hat - 2i A Iz z-hat
#   azimuthal, E0 g phi-hat  E = -2A Iphi phi-hat
# A Jones vector (a, b) gives a times the first plus b times the second, so circular light is
# (1, +-i)/sqrt(2). The radial and azimuthal forms are the lens rotating rho-hat into
# cos(theta) rho-hat + sin(theta) z-hat and leaving phi-hat alone, ray by ray.
#
# CONVENTIONS — read these before comparing a value against another source:
# - Time dependence e^(-i w t), as ray_prt and ray_fresnel: a wave moving to +z is e^(+i k z).
#   wave_beam is e^(+i w t), so a field there is the complex conjugate of one here.
# - z is positive downstream, from the geometric focus. A field carries the phase e^(i k (f + z))
#   of the path from the lens; the common e^(i k f) is dropped and e^(i k z) kept.
# - ⚠ THE OVERALL SIGN is fixed by Kirchhoff's integral, not copied from a text. In this time
#   convention its kernel is e^(i k d)/(i lambda d) (Goodman), which puts
#   -i e^(i k f) pi a^2 E0/(lambda f) at the focus of a thin lens, and before the focus, outside
#   its depth, the converging wave +E0 (f/|z|) e^(i k (f + z)). 2.13.0's review caught the first
#   cut returning the negative of both, with +i A where -i A belongs. The tests pin both, and
#   the fields relative to one another were right either way.
# - n1 is the medium in front of the lens, n2 the one the focus is in, lambda0 the vacuum
#   wavelength, f the focal length, all lengths in any one unit. sqrt(n1/n2) conserves power.
# - The pupil field is E0 g(h), and the fields are in units of E0. At low NA E_x(0) tends to
#   -i pi n2 a^2 sqrt(n1/n2)/(lambda0 f) E0, a = f NA/n2: in air, Fraunhofer's A/(lambda f) for
#   a uniformly lit aperture of area A.
# - The pupil is uniform (g = 1), Gaussian, g = exp(-h^2/w^2), or a doughnut,
#   g = (h/w) exp(-h^2/w^2): the radial profile radial and azimuthal beams carry, the
#   Laguerre-Gaussian (0, 1) mode's (sqrt(2) h/w) exp(-h^2/w^2) without its sqrt(2). w is the
#   1/e^2 intensity radius, as in wave_beam. A Gaussian is cut where h/w = 7 (e^-49); there is
#   nothing past it to a double.
#
# ⚠ THE DEBYE APPROXIMATION. The integral sums the plane waves leaving the lens, which holds
# where the Fresnel number a^2/(lambda f) is large and |z| is small next to f. A point at
# |z| >= f or rho >= f is refused: it is at or behind the lens, or as far off the axis as the
# lens is from the focus, and no field there is this one. Inside that the Fresnel number is not
# checked: a 50 um aperture with a 1 m focal length gets an answer, and it is not that lens's
# field.
#
# NUMERICS. theta = theta_top - psi^2 makes sqrt(cos theta) smooth even at NA = n2, and each
# integral is composite 16-point Gauss-Legendre in psi. The panel count follows the phase the
# integrand turns through, 2 theta_top (k rho + k |z| sin theta_top), at 12 rad a panel:
# against four times the panels, 24 rad still agreed to 6e-15 and 32 rad lost four digits. Add
# one panel, which is all the focus needs, and beta theta_top more for a Gaussian or doughnut,
# whose width in psi is 1/(2 beta sqrt(theta_top)): half that many still converge, a quarter
# lose five digits. (The first cut added beta sin(theta_top)/2, which left 3e-12 at NA = n2.)
# Where cos(alpha) is small, sqrt(cos theta) has a branch point near the real axis, so the panel
# at psi = 0 is halved until it is no wider than that distance. The phase e^(i k z) is taken out
# of the sum, where it would round at k z for every node. J0, J1 and J2 are this module's own,
# _focus_bessel012, to 5.5e-16 absolute: wave_airy's bessel_j1 is a 1e-7 fit.
#   Measured against the 60-digit integrals at 32 points over ten lenses: within 1.3e-15 of
# |I00(0, 0)| near the focus, plus 4e-16 of it per wavelength of defocus. That second part comes
# from forming n2 z/lambda0 in doubles, two roundings, the same at every node; any double
# implementation pays at least one.

var FOCUS_PUPIL_UNIFORM  = 0;
var FOCUS_PUPIL_GAUSSIAN = 1;
var FOCUS_PUPIL_DOUGHNUT = 2;

# focus_integrals writes I00, I01, I02, Irho, Iz, Iphi as (re, im) pairs: 12 f64.
var FOCUS_INTEGRALS_BYTES = 96;

# A lens and its pupil. na, n1, n2, lambda0, focal, fill and pupil are as given (fill is 0 for
# a uniform pupil). The rest are derived: s_top and c_top are the sine and cosine of theta_top,
# where the integral stops (alpha, or where a Gaussian is cut), root = sqrt(theta_top),
# beta = focal/fill, cyc = n2/lambda0, qc the pupil's wavefront in cycles per sin^2(theta)
# (focus_from_beam's curvature, 0 otherwise), and pref = (k f/2) sqrt(n1/n2).
#derive(accessors)
struct FocusLens { na; n1; n2; lambda0; focal; fill; pupil; s_top; c_top; theta; root; beta; cyc; qc; pref; }

var _FO_UCUT       = 0x401C000000000000;    # 7: a Gaussian is cut at h/w = 7, e^-49
var _FO_PANEL      = 0x4028000000000000;    # 12 rad of phase a panel
var _FO_MAX_PANELS = 0x40A0000000000000;    # 2048
var _FO_TINY       = 0x3370000000000000;    # 2^-200: the floor on sin(theta_top) and A

# 1 if x is finite and strictly positive. f64_gt is false for NaN.
fn _fo_pos(x) {
    if (f64_gt(x, 0) == 0) { return 0; }
    if (x == _PRK_INF) { return 0; }
    return 1;
}

# 1 if x is finite (not NaN, not +-inf).
fn _fo_finite(x) {
    if ((x & _PRK_ABS) >= _PRK_INF) { return 0; }
    return 1;
}

# Writes NaN to n f64 at p.
fn _fo_nan(p, n) {
    for (var i = 0; i < n; i = i + 1) { store64(p + i * 8, _PRK_NAN); }
    return 0;
}

# 1 if phi's sine and cosine resolve: finite and under 2^63 in size, where _prk_sin turns NaN.
fn _fo_phi_ok(phi) { return f64_lt(f64_abs(phi), _PRK_TRIG_LIMIT); }

# PK_ERR_NONE if the six components of the field e are finite. Otherwise all six become NaN and
# this is PK_ERR_INVALID_PARAMETER: a field that overflowed is refused, not handed back.
fn _fo_done(e) {
    for (var i = 0; i < 6; i = i + 1) {
        if (_fo_finite(load64(e + i * 8)) == 0) {
            _fo_nan(e, 6);
            return PK_ERR_INVALID_PARAMETER;
        }
    }
    return PK_ERR_NONE;
}

# ── Bessel functions ────────
# J0, J1 and J2 together, to 5.5e-16 absolute. Below x = 2, each is its power series in
# x^2/4, which keeps J1 and J2 relatively accurate down to 0. From 2 to 8, J0 and J1/x are
# Chebyshev series in x^2, and J2 = 2 J1/x - J0, which is stable there. From 8, Hankel's form
# J_n = sqrt(2/(pi x)) (P_n cos chi - Q_n sin chi), chi = x - (n/2 + 1/4) pi, with P_n and Q_n x/8
# Chebyshev series in 64/x^2. The Chebyshev series were fitted in 50-digit arithmetic, the
# small-x ones to the power series of J_n, the large-x ones to Hankel's integral (Watson 6.12),
# which agrees with the power series to 1e-49; the next term of each is under 2e-17.
# ⛔ 2.13.0 review: the first cut used the Chebyshev J0 down to 0, where Clenshaw's sum at t = -1
# rounds to 1.1e-15. The power series has 1.1e-16 there.

# One step of Clenshaw's recurrence: 2t b1 - b2 + c.
fn _fb_cl(t2, b1, b2, c) { return f64_add(f64_sub(f64_mul(t2, b1), b2), c); }

# J0(x) for x < 8, t = x^2/32 - 1: Chebyshev series, 17 terms, by Clenshaw's recurrence. t is the mapped
# variable and t2 = 2t.
fn _fb_j0(t, t2) {
    var u = 0x3C6C2C89EA282AAA;                       # c16 = 1.2218515873961411e-17
    var v = f64_add(f64_mul(t2, u), 0xBCCB5729D242ACAE);  # c15
    u = _fb_cl(t2, v, u, 0x3D273936AA3D0207);    # c14 = 4.1253205956343741e-14
    v = _fb_cl(t2, u, v, 0xBD81192067E71726);    # c13 = -1.9438346867370164e-12
    u = _fb_cl(t2, v, u, 0x3DD593076E904D04);    # c12 = 7.8486963144794648e-11
    v = _fb_cl(t2, u, v, 0xBE2703BDA6758F6F);    # c11 = -2.6792535305576728e-09
    u = _fb_cl(t2, v, u, 0x3E746C4A4B32AA3B);    # c10 = 7.6081635924187821e-08
    v = _fb_cl(t2, u, v, 0xBEBD8F811CD3E853);    # c9 = -1.7619469077621507e-06
    u = _fb_cl(t2, v, u, 0x3F0104C067D74D17);    # c8 = 3.2460328821005083e-05
    v = _fb_cl(t2, u, v, 0xBF3E300651CD3AE3);    # c7 = -0.00046062616620627504
    u = _fb_cl(t2, v, u, 0x3F73BD46CCAB9DA0);    # c6 = 0.0048191800694676046
    v = _fb_cl(t2, u, v, 0xBFA1DD989CE98EA2);    # c5 = -0.034893769411408884
    u = _fb_cl(t2, v, u, 0x3FC43B8AF58B7FFA);    # c4 = 0.15806710233209725
    v = _fb_cl(t2, u, v, 0xBFD7AFA2E9C62A9E);    # c3 = -0.37009499387264977
    u = _fb_cl(t2, v, u, 0x3FD0F8AFB7D3A552);    # c2 = 0.2651786132033368
    v = _fb_cl(t2, u, v, 0xBF81DD989CE98EA2);    # c1 = -0.0087234423528522211
    return f64_add(f64_sub(f64_mul(t, v), u), 0x3FC4306E1F9314DB);    # c0 = 0.15772797147489012
}

# J1(x)/x for x < 8, t = x^2/32 - 1: Chebyshev series, 17 terms, by Clenshaw's recurrence. t is the mapped
# variable and t2 = 2t.
fn _fb_j1x(t, t2) {
    var u = 0x3C1B3C9BD267E611;                       # c16 = 3.6912682997929334e-19
    var v = f64_add(f64_mul(t2, u), 0xBC7C2DFF424052F8);  # c15
    u = _fb_cl(t2, v, u, 0x3CD9A36AFEDBA862);    # c14 = 1.4232144003513942e-15
    v = _fb_cl(t2, u, v, 0xBD3453D2B4E985CB);    # c13 = -7.2217552396517734e-14
    u = _fb_cl(t2, v, u, 0x3D8BCC0916376113);    # c12 = 3.1601545803480032e-12
    v = _fb_cl(t2, u, v, 0xBDE030D00D42D6F4);    # c11 = -1.178026622695885e-10
    u = _fb_cl(t2, v, u, 0x3E2FAC17C7273311);    # c10 = 3.6871337590971481e-09
    v = _fb_cl(t2, u, v, 0xBE798F754605F635);    # c9 = -9.5219847567504361e-08
    u = _fb_cl(t2, v, u, 0x3EC0A8A3A628FC7B);    # c8 = 1.9858774049915165e-06
    v = _fb_cl(t2, u, v, 0xBF011188227A5012);    # c7 = -3.2555548668572587e-05
    u = _fb_cl(t2, v, u, 0x3F3A8B56CEDFE580);    # c6 = 0.0004050337728354822
    v = _fb_cl(t2, u, v, 0xBF6DE030538B55B0);    # c5 = -0.0036469406007692759
    u = _fb_cl(t2, v, u, 0x3F96BF2C1F5F71E1);    # c4 = 0.022213639654966037
    v = _fb_cl(t2, u, v, 0xBFB52A8C7827DAA8);    # c3 = -0.08268049176681791
    u = _fb_cl(t2, v, u, 0x3FC49B9FB3408E33);    # c2 = 0.16099926235720971
    v = _fb_cl(t2, u, v, 0xBFC3119E17FDBFFD);    # c1 = -0.14897514506765211
    return f64_add(f64_sub(f64_mul(t, v), u), 0x3FB4BF5AE47A6150);    # c0 = 0.081044846325658115
}

# P0(x) for x >= 8, t = 128/x^2 - 1: Chebyshev series, 13 terms, by Clenshaw's recurrence. t is the mapped
# variable and t2 = 2t.
fn _fb_p0(t, t2) {
    var u = 0x3C72CCA86C6338D9;                       # c12 = 1.6305919233744186e-17
    var v = f64_add(f64_mul(t2, u), 0xBC9CDB3179595BBD);  # c11
    u = _fb_cl(t2, v, u, 0x3CC84FFF80B613C2);    # c10 = 6.7480722157338734e-16
    v = _fb_cl(t2, u, v, 0xBCF6D432CB7153FE);    # c9 = -5.0690340959352359e-15
    u = _fb_cl(t2, v, u, 0x3D285B481672B1EE);    # c8 = 4.3265957431549404e-14
    v = _fb_cl(t2, u, v, 0xBD5E4A709E74825B);    # c7 = -4.3045788699253914e-13
    u = _fb_cl(t2, v, u, 0x3D96BAF23642C655);    # c6 = 5.1682623873491928e-12
    v = _fb_cl(t2, u, v, 0xBDD59DDCC28538A8);    # c5 = -7.8640913772370698e-11
    u = _fb_cl(t2, v, u, 0x3E1C03A8B38CA73C);    # c4 = 1.6306464635151382e-09
    v = _fb_cl(t2, u, v, 0xBE6BC26938A82CE2);    # c3 = -5.1705945376060975e-08
    u = _fb_cl(t2, v, u, 0x3EC9CBE8B7395851);    # c2 = 3.0751847875194745e-06
    v = _fb_cl(t2, u, v, 0xBF4194AC5283C04A);    # c1 = -0.00053652204681321172
    return f64_add(f64_sub(f64_mul(t, v), u), 0x3FEFFB944543151E);    # c0 = 0.99946034934751871
}

# Q0(x) x/8 for x >= 8, t = 128/x^2 - 1: Chebyshev series, 13 terms, by Clenshaw's recurrence. t is the mapped
# variable and t2 = 2t.
fn _fb_q0(t, t2) {
    var u = 0xBC733CDB710C05D6;                       # c12 = -1.6686065214378146e-17
    var v = f64_add(f64_mul(t2, u), 0x3C9BD9648F62C6B8);  # c11
    u = _fb_cl(t2, v, u, 0xBCC5FA3147B301C9);    # c10 = -6.0999301316400496e-16
    v = _fb_cl(t2, u, v, 0x3CF329F0C1B6C666);    # c9 = 4.2552250402454608e-15
    u = _fb_cl(t2, v, u, 0xBD22C827D7F6E2D5);    # c8 = -3.3363281853224267e-14
    v = _fb_cl(t2, u, v, 0x3D552763BE90A889);    # c7 = 3.0061451253517062e-13
    u = _fb_cl(t2, v, u, 0xBD8C34F407DF8BA4);    # c6 = -3.2067474209966348e-12
    v = _fb_cl(t2, u, v, 0x3DC7334B27AD2886);    # c5 = 4.2201219046687385e-11
    u = _fb_cl(t2, v, u, 0xBE08FC71E52A5280);    # c4 = -7.2719159368663201e-10
    v = _fb_cl(t2, u, v, 0x3E534C3B3F0F3E19);    # c3 = 1.7972457247968992e-08
    u = _fb_cl(t2, v, u, 0xBEA8E1017183D060);    # c2 = -7.4144984110606469e-07
    v = _fb_cl(t2, u, v, 0x3F11ED40C7BF4761);    # c1 = 6.8385199426116493e-05
    return f64_add(f64_sub(f64_mul(t, v), u), 0xBF8FDBBF76547CAF);    # c0 = -0.015555854605337009
}

# P1(x) for x >= 8, t = 128/x^2 - 1: Chebyshev series, 13 terms, by Clenshaw's recurrence. t is the mapped
# variable and t2 = 2t.
fn _fb_p1(t, t2) {
    var u = 0xBC73F5B1671B84FB;                       # c12 = -1.7312313216116335e-17
    var v = f64_add(f64_mul(t2, u), 0x3C9EBF5D803CD896);  # c11
    u = _fb_cl(t2, v, u, 0xBCCA045D1E6AA4E8);    # c10 = -7.2211808422740179e-16
    v = _fb_cl(t2, u, v, 0x3CF88E8192BCB004);    # c9 = 5.4526748960447171e-15
    u = _fb_cl(t2, v, u, 0xBD2A5EAD8BEA617F);    # c8 = -4.6842237839904895e-14
    v = _fb_cl(t2, u, v, 0x3D6088A8B6783E50);    # c7 = 4.699195515230542e-13
    u = _fb_cl(t2, v, u, 0xBD99171AFE32FC02);    # c6 = -5.7048636403956448e-12
    v = _fb_cl(t2, u, v, 0x3DD83C5742BE2CC3);    # c5 = 8.8168986595823391e-11
    u = _fb_cl(t2, v, u, 0xBE201454CF5D6AC0);    # c4 = -1.8718907491063067e-09
    v = _fb_cl(t2, u, v, 0x3E70953CDC0829EF);    # c3 = 6.1776339606442988e-08
    u = _fb_cl(t2, v, u, 0xBED0B9505CE79BBA);    # c2 = -3.9872843004889084e-06
    v = _fb_cl(t2, u, v, 0x3F4D7545F75D7DA9);    # c1 = 0.00089898983308594083
    return f64_add(f64_sub(f64_mul(t, v), u), 0x3FF003B2E82F5F12);    # c0 = 1.0009030408600137
}

# Q1(x) x/8 for x >= 8, t = 128/x^2 - 1: Chebyshev series, 13 terms, by Clenshaw's recurrence. t is the mapped
# variable and t2 = 2t.
fn _fb_q1(t, t2) {
    var u = 0x3C746123A8BBC898;                       # c12 = 1.7676355487764791e-17
    var v = f64_add(f64_mul(t2, u), 0xBC9D994B1FDDB9F0);  # c11
    u = _fb_cl(t2, v, u, 0x3CC772D4DD737BF2);    # c10 = 6.5082829577833837e-16
    v = _fb_cl(t2, u, v, 0xBCF48AC416E30219);    # c9 = -4.5612523950772974e-15
    u = _fb_cl(t2, v, u, 0x3D243F8057A1761F);    # c8 = 3.5967765829165294e-14
    v = _fb_cl(t2, u, v, 0xBD56F877E53FB185);    # c7 = -3.2643156743279e-13
    u = _fb_cl(t2, v, u, 0x3D8EEB91ABCA8164);    # c6 = 3.5152187949686082e-12
    v = _fb_cl(t2, u, v, 0xBDC9C37875F5EBC0);    # c5 = -4.6863636881769453e-11
    u = _fb_cl(t2, v, u, 0x3E0C467999A69933);    # c4 = 8.2291933276505541e-10
    v = _fb_cl(t2, u, v, 0xBE5681617E8645AD);    # c3 = -2.0959781384083424e-08
    u = _fb_cl(t2, v, u, 0x3EAEAA02BF61504B);    # c2 = 9.1386152579554545e-07
    v = _fb_cl(t2, u, v, 0xBF193D0E4FA70662);    # c1 = -9.6277235491570797e-05
    return f64_add(f64_sub(f64_mul(t, v), u), 0x3FA7F34213492AF6);    # c0 = 0.046777787069535323
}

# J0(x) for y = x^2/4 < 1: its power series, k = 0..12, each coefficient the double
# nearest the exact rational. The first term left out is under 1e-17 of the sum.
fn _fb_j0s(y) {
    var s = 0x3C54197A7F5154BC;                       # +1/(12!)^2
    s = f64_add(f64_mul(s, y), 0xBCC69CA9CF3B7F54);    # -1/(11!)^2
    s = f64_add(f64_mul(s, y), 0x3D35601885E63E5D);    # +1/(10!)^2
    s = f64_add(f64_mul(s, y), 0xBDA0B313289BE0B9);    # -1/(9!)^2
    s = f64_add(f64_mul(s, y), 0x3E0522A43F65486A);    # +1/(8!)^2
    s = f64_add(f64_mul(s, y), 0xBE6522A43F65486A);    # -1/(7!)^2
    s = f64_add(f64_mul(s, y), 0x3EC02E85C0898B71);    # +1/(6!)^2
    s = f64_add(f64_mul(s, y), 0xBF123456789ABCDF);    # -1/(5!)^2
    s = f64_add(f64_mul(s, y), 0x3F5C71C71C71C71C);    # +1/(4!)^2
    s = f64_add(f64_mul(s, y), 0xBF9C71C71C71C71C);    # -1/(3!)^2
    s = f64_add(f64_mul(s, y), 0x3FD0000000000000);    # +1/(2!)^2
    s = f64_add(f64_mul(s, y), 0xBFF0000000000000);    # -1/(1!)^2
    s = f64_add(f64_mul(s, y), 0x3FF0000000000000);    # +1/(0!)^2
    return s;
}

# J1(x)/x for y = x^2/4 < 1: its power series, k = 0..12, each coefficient the double
# nearest the exact rational. The first term left out is under 1e-17 of the sum.
fn _fb_j1s(y) {
    var s = 0x3C08BCE58901A35E;                       # +1/(2 12! 13!)
    s = f64_add(f64_mul(s, y), 0xBC7E2637BEF9FF1A);    # -1/(2 11! 12!)
    s = f64_add(f64_mul(s, y), 0x3CEF17697CF1CF13);    # +1/(2 10! 11!)
    s = f64_add(f64_mul(s, y), 0xBD5AB81EA75FCDF4);    # -1/(2 9! 10!)
    s = f64_add(f64_mul(s, y), 0x3DC2C9758DAF5CD0);    # +1/(2 8! 9!)
    s = f64_add(f64_mul(s, y), 0xBE2522A43F65486A);    # -1/(2 7! 8!)
    s = f64_add(f64_mul(s, y), 0x3E827E4FB7789F5C);    # +1/(2 6! 7!)
    s = f64_add(f64_mul(s, y), 0xBED845C8A0CE5129);    # -1/(2 5! 6!)
    s = f64_add(f64_mul(s, y), 0x3F26C16C16C16C17);    # +1/(2 4! 5!)
    s = f64_add(f64_mul(s, y), 0xBF6C71C71C71C71C);    # -1/(2 3! 4!)
    s = f64_add(f64_mul(s, y), 0x3FA5555555555555);    # +1/(2 2! 3!)
    s = f64_add(f64_mul(s, y), 0xBFD0000000000000);    # -1/(2 1! 2!)
    s = f64_add(f64_mul(s, y), 0x3FE0000000000000);    # +1/(2 0! 1!)
    return s;
}

# J2(x)/x^2 for y = x^2/4 < 1: its power series, k = 0..11, each coefficient the double
# nearest the exact rational. The first term left out is under 1e-17 of the sum.
fn _fb_j2s(y) {
    var s = 0xBC328DAC26C13A86;                       # -1/(4 11! 13!)
    s = f64_add(f64_mul(s, y), 0x3CA4BA46534BDF62);    # +1/(4 10! 12!)
    s = f64_add(f64_mul(s, y), 0xBD136EA1EE17216C);    # -1/(4 9! 11!)
    s = f64_add(f64_mul(s, y), 0x3D7E0F227C4BC7B3);    # +1/(4 8! 10!)
    s = f64_add(f64_mul(s, y), 0xBDE2C9758DAF5CD0);    # -1/(4 7! 9!)
    s = f64_add(f64_mul(s, y), 0x3E427E4FB7789F5C);    # +1/(4 6! 8!)
    s = f64_add(f64_mul(s, y), 0xBE9BBD779334EF0B);    # -1/(4 5! 7!)
    s = f64_add(f64_mul(s, y), 0x3EEE573AC901E574);    # +1/(4 4! 6!)
    s = f64_add(f64_mul(s, y), 0xBF36C16C16C16C17);    # -1/(4 3! 5!)
    s = f64_add(f64_mul(s, y), 0x3F75555555555555);    # +1/(4 2! 4!)
    s = f64_add(f64_mul(s, y), 0xBFA5555555555555);    # -1/(4 1! 3!)
    s = f64_add(f64_mul(s, y), 0x3FC0000000000000);    # +1/(4 0! 2!)
    return s;
}

# J0(x), J1(x) and J2(x) for x >= 0, written to out[0..2]. cos(x - pi/4) and cos(x - 3 pi/4)
# come from sin x and cos x, which keeps the reduction exact.
fn _focus_bessel012(x, out) {
    if (f64_lt(x, F64_TWO) == 1) {
        var xx = f64_mul(x, x);
        var yy = f64_mul(xx, 0x3FD0000000000000);                               # x^2/4
        store64(out, _fb_j0s(yy));
        store64(out + 8, f64_mul(x, _fb_j1s(yy)));
        store64(out + 16, f64_mul(xx, _fb_j2s(yy)));
        return 0;
    }
    if (f64_lt(x, 0x4020000000000000) == 1) {                                   # 8
        var t = f64_sub(f64_mul(f64_mul(x, x), 0x3FA0000000000000), F64_ONE);   # x^2/32 - 1
        var t2 = f64_add(t, t);
        var j0 = _fb_j0(t, t2);
        var j1 = f64_mul(x, _fb_j1x(t, t2));
        store64(out, j0);
        store64(out + 8, j1);
        store64(out + 16, f64_sub(f64_div(f64_add(j1, j1), x), j0));
        return 0;
    }
    var y = f64_div(0x4050000000000000, f64_mul(x, x));                         # 64/x^2
    var ty = f64_sub(f64_add(y, y), F64_ONE);
    var ty2 = f64_add(ty, ty);
    var q8 = f64_div(0x4020000000000000, x);
    var p0 = _fb_p0(ty, ty2);
    var q0 = f64_mul(_fb_q0(ty, ty2), q8);
    var p1 = _fb_p1(ty, ty2);
    var q1 = f64_mul(_fb_q1(ty, ty2), q8);
    var s = f64_sin(x);
    var c = f64_cos(x);
    var r = f64_div(F64_ONE, f64_sqrt(f64_mul(F64_PI, x)));
    # sqrt(2/(pi x)) cos(x - pi/4) = (c + s)/sqrt(pi x), and so on for the other three.
    var b0 = f64_mul(r, f64_sub(f64_mul(p0, f64_add(c, s)), f64_mul(q0, f64_sub(s, c))));
    var b1 = f64_mul(r, f64_add(f64_mul(p1, f64_sub(s, c)), f64_mul(q1, f64_add(s, c))));
    store64(out, b0);
    store64(out + 8, b1);
    store64(out + 16, f64_sub(f64_div(f64_add(b1, b1), x), b0));
    return 0;
}

# ── The integrals ────────
# cx, the context one call of focus_integrals shares with its nodes (152 bytes): s_top 0,
# c_top 8, beta 16, pupil 24, qc 32, cyc*z 40, k*rho 48, then the six integrals as (re, im)
# pairs from 56.

# acc += v (er, ei).
fn _fo_acc(acc, v, er, ei) {
    store64(acc, f64_add(load64(acc), f64_mul(v, er)));
    store64(acc + 8, f64_add(load64(acc + 8), f64_mul(v, ei)));
    return 0;
}

# One node: psi, and its weight wt in psi. theta = theta_top - psi^2, so dtheta = 2 psi dpsi,
# and sin and cos of theta come from the angle-difference formulas: both terms of cos are
# positive, so it keeps its relative accuracy at alpha = 90 degrees, and 1 - cos is formed as
# sin^2/(1 + cos), which has no cancellation.
fn _focus_node(cx, psi, wt) {
    var t = f64_mul(psi, psi);
    var st = f64_sin(t);
    var ct = f64_cos(t);
    var s_top = load64(cx);
    var c_top = load64(cx + 8);
    var s = f64_sub(f64_mul(s_top, ct), f64_mul(c_top, st));
    if (f64_lt(s, 0) == 1) { s = 0; }
    var c = f64_add(f64_mul(c_top, ct), f64_mul(s_top, st));
    if (f64_lt(c, 0) == 1) { c = 0; }
    var s2 = f64_mul(s, s);
    var omc = f64_div(s2, f64_add(F64_ONE, c));
    var a = f64_mul(f64_mul(f64_sqrt(c), f64_add(psi, psi)), wt);
    var pupil = load64(cx + 24);
    if (pupil != FOCUS_PUPIL_UNIFORM) {
        var u = f64_mul(load64(cx + 16), s);
        var g = f64_exp(f64_neg(f64_mul(u, u)));
        if (pupil == FOCUS_PUPIL_DOUGHNUT) { g = f64_mul(g, u); }
        a = f64_mul(a, g);
    }
    var jb[24];
    _focus_bessel012(f64_mul(load64(cx + 48), s), &jb);
    # The phase less e^(i k z): k z (cos - 1), plus the pupil's own.
    var ph = _prk_cycles_phase(f64_sub(f64_mul(load64(cx + 32), s2), f64_mul(load64(cx + 40), omc)));
    var aw = f64_mul(a, s);
    var er = f64_mul(aw, f64_cos(ph));
    var ei = f64_mul(aw, f64_sin(ph));
    var j0 = load64(&jb);
    var j1 = load64(&jb + 8);
    _fo_acc(cx + 56, f64_mul(f64_add(F64_ONE, c), j0), er, ei);
    _fo_acc(cx + 72, f64_mul(s, j1), er, ei);
    _fo_acc(cx + 88, f64_mul(omc, load64(&jb + 16)), er, ei);
    _fo_acc(cx + 104, f64_mul(c, j1), er, ei);
    _fo_acc(cx + 120, f64_mul(s, j0), er, ei);
    _fo_acc(cx + 136, j1, er, ei);
    return 0;
}

# The two nodes mid -+ hw x of a panel, each of weight hw w.
fn _focus_pair(cx, mid, hw, x, w) {
    var d = f64_mul(hw, x);
    var ww = f64_mul(hw, w);
    _focus_node(cx, f64_sub(mid, d), ww);
    _focus_node(cx, f64_add(mid, d), ww);
    return 0;
}

# One panel, centre mid and half-width hw in psi: 16-point Gauss-Legendre, the nodes +-x_j
# and weights w_j to the double nearest (Newton on P16 in 50 digits; tests pin them).
fn _focus_panel(cx, mid, hw) {
    _focus_pair(cx, mid, hw, 0x3FB852BD6676A9F9, 0x3FC83FEAE80E4DFC);    # 0.095012
    _focus_pair(cx, mid, hw, 0x3FD205CAE642337C, 0x3FC75F8C77E0C00F);    # 0.281603
    _focus_pair(cx, mid, hw, 0x3FDD50259A43A772, 0x3FC5A6EBBB5A75FC);    # 0.458016
    _focus_pair(cx, mid, hw, 0x3FE3C5A466D5E8B8, 0x3FC325F61BCA3CBF);    # 0.617876
    _focus_pair(cx, mid, hw, 0x3FE82C45DDA4726B, 0x3FBFE7AF2BAD386A);    # 0.755404
    _focus_pair(cx, mid, hw, 0x3FEBB3403514E483, 0x3FB85C4EE79CC258);    # 0.865631
    _focus_pair(cx, mid, hw, 0x3FEE39F56616F9B0, 0x3FAFDFB1A2C1265D);    # 0.944575
    _focus_pair(cx, mid, hw, 0x3FEFA92C264D787E, 0x3F9BCDDAB4B7C211);    # 0.989400
    return 0;
}

# ── API ────────

# A lens of numerical aperture na, focusing from a medium of index n1 into n2 at vacuum
# wavelength lambda0, with focal length focal and a pupil of kind pupil (FOCUS_PUPIL_*). fill
# is the Gaussian's or doughnut's w, its 1/e^2 intensity radius at the lens; a uniform pupil
# ignores it. NA = n2, a 90-degree half-angle, is allowed. Writes PK_ERR_INVALID_PARAMETER
# unless na is in (0, n2], n1, n2, lambda0 and focal are finite and positive, pupil is one of
# the three and fill, where it is read, is finite and positive; if a derived constant
# overflows; or if sin(theta_top) or A is under 2^-200, where the integrands' fifth powers of
# sin(theta) underflow and a field would come back zero or short of digits instead of refused.
# PK_ERR_ALLOCATION if the struct cannot be allocated. Returns 0 on any of them.
#must_use
fn focus_new(na, n1, n2, lambda0, focal, pupil, fill, err_out) {
    store64(err_out, PK_ERR_NONE);
    _prk_trace("focus_new");
    var ok = _fo_pos(na) & _fo_pos(n1) & _fo_pos(n2) & _fo_pos(lambda0) & _fo_pos(focal);
    if ((pupil < FOCUS_PUPIL_UNIFORM) | (pupil > FOCUS_PUPIL_DOUGHNUT)) { ok = 0; }
    if (ok == 1) {
        if (f64_gt(na, n2) == 1) { ok = 0; }
    }
    var w = 0;
    var beta = 0;
    if (pupil != FOCUS_PUPIL_UNIFORM) {
        w = fill;
        if (_fo_pos(w) == 0) { ok = 0; }
        if (ok == 1) { beta = f64_div(focal, w); }
    }
    if (ok == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var s_top = f64_div(na, n2);
    var cyc = f64_div(n2, lambda0);
    var pref = f64_mul(f64_mul(f64_mul(F64_PI, cyc), focal), f64_sqrt(f64_div(n1, n2)));
    if ((_fo_pos(cyc) & _fo_pos(pref) & _fo_finite(beta)) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (pupil != FOCUS_PUPIL_UNIFORM) {
        if (f64_gt(f64_mul(beta, s_top), _FO_UCUT) == 1) { s_top = f64_div(_FO_UCUT, beta); }
    }
    if ((f64_ge(s_top, _FO_TINY) & f64_ge(pref, _FO_TINY)) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var c_top = f64_sqrt(f64_mul(f64_sub(F64_ONE, s_top), f64_add(F64_ONE, s_top)));
    var theta = ganita_f64_atan2(s_top, c_top);
    var l = alloc(sizeof(FocusLens));
    if (l == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    FocusLens_set_na(l, na);
    FocusLens_set_n1(l, n1);
    FocusLens_set_n2(l, n2);
    FocusLens_set_lambda0(l, lambda0);
    FocusLens_set_focal(l, focal);
    FocusLens_set_fill(l, w);
    FocusLens_set_pupil(l, pupil);
    FocusLens_set_s_top(l, s_top);
    FocusLens_set_c_top(l, c_top);
    FocusLens_set_theta(l, theta);
    FocusLens_set_root(l, f64_sqrt(theta));
    FocusLens_set_beta(l, beta);
    FocusLens_set_cyc(l, cyc);
    FocusLens_set_qc(l, 0);
    FocusLens_set_pref(l, pref);
    return l;
}

# A lens fed by a Gaussian beam at the beam's current plane. The pupil is pupil
# (FOCUS_PUPIL_GAUSSIAN or FOCUS_PUPIL_DOUGHNUT) with w = beam_radius(beam); lambda0 is n1 times
# the beam's wavelength, which wave_beam gives in the medium; and the beam's wavefront
# curvature 1/R becomes a phase across the pupil, k1 h^2/(2R) in this module's e^(-i w t). So
# a diverging beam, R > 0, focuses past the geometric focus: by (n1/n2) f^2/R at low NA, as the
# lens equation has it. Errors as focus_new, and PK_ERR_INVALID_PARAMETER for a null beam, a
# uniform pupil, or a radius, wavelength, curvature or pupil phase that is not finite.
#must_use
fn focus_from_beam(beam, na, n1, n2, focal, pupil, err_out) {
    store64(err_out, PK_ERR_NONE);
    if ((beam == 0) | (pupil == FOCUS_PUPIL_UNIFORM)) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var lb = GaussianBeam_wavelength(beam);
    var curv = beam_curvature(beam);
    if ((_fo_pos(lb) & _fo_finite(curv)) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # h^2/(2 R lambda_b) cycles, h = f sin(theta), as (f/lambda_b) (f/R)/2: f^2 alone can
    # underflow (review: f = 1e-170) while the phase is billions of cycles.
    var qc = f64_mul(f64_mul(f64_div(focal, lb), f64_mul(focal, curv)), F64_HALF);
    if (_fo_finite(qc) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var l = focus_new(na, n1, n2, f64_mul(lb, n1), focal, pupil, beam_radius(beam), err_out);
    if (l == 0) { return 0; }
    FocusLens_set_qc(l, qc);
    return l;
}

# The six integrals at (rho, z), without the factor A, written to out (FOCUS_INTEGRALS_BYTES):
# I00, I01, I02, Irho, Iz, Iphi as (re, im) pairs. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER for a null handle; rho negative or not finite; z not finite; a point
# at |z| >= f or rho >= f (see THE DEBYE APPROXIMATION); |z| past 2^52 wavelengths in the
# medium, where a double no longer resolves its phase; or a point whose integrand turns through
# so much phase that it needs more than 2048 panels: at NA 0.9 in air, 1744 wavelengths off the
# axis or 1938 along it. out is NaN on any refusal.
fn focus_integrals(lens, rho, z, out) {
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    _fo_nan(out, 12);
    if (lens == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((f64_ge(rho, 0) == 0) | (rho == _PRK_INF) | (_fo_finite(z) == 0)) { return PK_ERR_INVALID_PARAMETER; }
    var focal = FocusLens_focal(lens);
    if ((f64_lt(rho, focal) & f64_lt(f64_abs(z), focal)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    _prk_trace("focus_integrals");
    var cyc = FocusLens_cyc(lens);
    var zc = f64_mul(cyc, z);
    if (f64_lt(f64_abs(zc), 0x4330000000000000) == 0) { return PK_ERR_INVALID_PARAMETER; }    # 2^52
    var s_top = FocusLens_s_top(lens);
    var theta = FocusLens_theta(lens);
    var beta = FocusLens_beta(lens);
    var qc = FocusLens_qc(lens);
    var pupil = FocusLens_pupil(lens);
    var krho = f64_mul(f64_mul(F64_TAU, cyc), rho);
    var kz = f64_mul(F64_TAU, f64_abs(zc));
    # The phase the integrand turns through in psi: Bessel argument, axial phase, pupil phase.
    var turn = f64_mul(f64_add(theta, theta), f64_add(krho, f64_mul(kz, s_top)));
    turn = f64_add(turn, f64_mul(f64_mul(f64_mul(F64_TAU, 0x4010000000000000), f64_abs(qc)), f64_mul(s_top, theta)));
    var m = f64_add(f64_ceil(f64_div(turn, _FO_PANEL)), F64_ONE);
    if (pupil != FOCUS_PUPIL_UNIFORM) { m = f64_add(m, f64_ceil(f64_mul(beta, theta))); }
    if (f64_le(m, _FO_MAX_PANELS) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var cx[152];
    store64(&cx, s_top);
    store64(&cx + 8, FocusLens_c_top(lens));
    store64(&cx + 16, beta);
    store64(&cx + 24, pupil);
    store64(&cx + 32, qc);
    store64(&cx + 40, zc);
    store64(&cx + 48, krho);
    for (var i = 56; i < 152; i = i + 8) { store64(&cx + i, 0); }
    var root = FocusLens_root(lens);
    var h = f64_div(root, m);
    var hw = f64_mul(h, F64_HALF);
    var n = f64_to(m);
    for (var p = 1; p < n; p = p + 1) { _focus_panel(&cx, f64_mul(h, f64_add(f64_from(p), F64_HALF)), hw); }
    # The first panel, halved toward psi = 0 while it is wider than sqrt(cos alpha), which is
    # no further than the branch point of sqrt(cos theta) is from the real axis.
    var first = h;
    var c_top = FocusLens_c_top(lens);
    if (f64_gt(c_top, 0) == 1) {
        var d = f64_sqrt(c_top);
        var g = 0;
        while ((f64_gt(first, d) == 1) & (g < 60)) {
            _focus_panel(&cx, f64_mul(first, 0x3FE8000000000000), f64_mul(first, 0x3FD0000000000000));
            first = f64_mul(first, F64_HALF);
            g = g + 1;
        }
    }
    var fh = f64_mul(first, F64_HALF);
    _focus_panel(&cx, fh, fh);
    # e^(i k z), taken out of the sum.
    var ph = _prk_cycles_phase(zc);
    var gr = _prk_cos(ph);
    var gi = _prk_sin(ph);
    for (var j = 0; j < 6; j = j + 1) {
        var ar = load64(&cx + 56 + j * 16);
        var ai = load64(&cx + 64 + j * 16);
        store64(out + j * 16, f64_sub(f64_mul(ar, gr), f64_mul(ai, gi)));
        store64(out + j * 16 + 8, f64_add(f64_mul(ar, gi), f64_mul(ai, gr)));
    }
    return PK_ERR_NONE;
}

# The field at (rho, phi, z) for a uniformly polarized input of complex Jones vector
# (jx_re + i jx_im, jy_re + i jy_im), written to the PrtField e_out. Returns as
# focus_integrals, and PK_ERR_INVALID_PARAMETER for a null e_out, a phi that is not finite or
# is 2^63 or more in size, a Jones component that is not finite, or a field that overflows;
# e_out is NaN on any refusal.
fn focus_jones(lens, jx_re, jx_im, jy_re, jy_im, rho, phi, z, e_out) {
    if (e_out == 0) { return PK_ERR_INVALID_PARAMETER; }
    _fo_nan(e_out, 6);
    var ok = _fo_phi_ok(phi) & _fo_finite(jx_re) & _fo_finite(jx_im) & _fo_finite(jy_re) & _fo_finite(jy_im);
    if (ok == 0) { return PK_ERR_INVALID_PARAMETER; }
    var ib[96];
    var rc = focus_integrals(lens, rho, z, &ib);
    if (rc != PK_ERR_NONE) { return rc; }
    var a = f64_neg(FocusLens_pref(lens));       # -A: see THE OVERALL SIGN
    var cp = _prk_cos(phi);
    var sp = _prk_sin(phi);
    var c2 = f64_sub(f64_mul(cp, cp), f64_mul(sp, sp));
    var s2 = f64_mul(F64_TWO, f64_mul(sp, cp));
    var i00r = load64(&ib);
    var i00i = load64(&ib + 8);
    var i01r = load64(&ib + 16);
    var i01i = load64(&ib + 24);
    var i02r = load64(&ib + 32);
    var i02i = load64(&ib + 40);
    # X = I00 + I02 cos 2phi, Y = I00 - I02 cos 2phi, S = I02 sin 2phi.
    var xr = f64_add(i00r, f64_mul(i02r, c2));
    var xi = f64_add(i00i, f64_mul(i02i, c2));
    var yr = f64_sub(i00r, f64_mul(i02r, c2));
    var yi = f64_sub(i00i, f64_mul(i02i, c2));
    var sr = f64_mul(i02r, s2);
    var si = f64_mul(i02i, s2);
    # E_x = -i A (jx X + jy S), E_y = -i A (jx S + jy Y), E_z = -2 A I01 (jx cos phi + jy sin phi).
    var pr = f64_add(f64_sub(f64_mul(jx_re, xr), f64_mul(jx_im, xi)), f64_sub(f64_mul(jy_re, sr), f64_mul(jy_im, si)));
    var pim = f64_add(f64_add(f64_mul(jx_re, xi), f64_mul(jx_im, xr)), f64_add(f64_mul(jy_re, si), f64_mul(jy_im, sr)));
    var qr = f64_add(f64_sub(f64_mul(jx_re, sr), f64_mul(jx_im, si)), f64_sub(f64_mul(jy_re, yr), f64_mul(jy_im, yi)));
    var qi = f64_add(f64_add(f64_mul(jx_re, si), f64_mul(jx_im, sr)), f64_add(f64_mul(jy_re, yi), f64_mul(jy_im, yr)));
    var ur = f64_add(f64_mul(jx_re, cp), f64_mul(jy_re, sp));
    var ui = f64_add(f64_mul(jx_im, cp), f64_mul(jy_im, sp));
    var a2 = f64_add(a, a);
    PrtField_set_x_re(e_out, f64_neg(f64_mul(a, pim)));
    PrtField_set_x_im(e_out, f64_mul(a, pr));
    PrtField_set_y_re(e_out, f64_neg(f64_mul(a, qi)));
    PrtField_set_y_im(e_out, f64_mul(a, qr));
    PrtField_set_z_re(e_out, f64_mul(a2, f64_sub(f64_mul(i01r, ur), f64_mul(i01i, ui))));
    PrtField_set_z_im(e_out, f64_mul(a2, f64_add(f64_mul(i01r, ui), f64_mul(i01i, ur))));
    return _fo_done(e_out);
}

# The field for x-polarized input: focus_jones with (1, 0). For polarization at an angle t,
# use the Jones vector (cos t, sin t).
fn focus_linear(lens, rho, phi, z, e_out) {
    return focus_jones(lens, F64_ONE, 0, 0, 0, rho, phi, z, e_out);
}

# The field for a radially polarized input, E0 g rho-hat, written to e_out. Returns as
# focus_jones.
fn focus_radial(lens, rho, phi, z, e_out) {
    if (e_out == 0) { return PK_ERR_INVALID_PARAMETER; }
    _fo_nan(e_out, 6);
    if (_fo_phi_ok(phi) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var ib[96];
    var rc = focus_integrals(lens, rho, z, &ib);
    if (rc != PK_ERR_NONE) { return rc; }
    var a2 = f64_neg(f64_add(FocusLens_pref(lens), FocusLens_pref(lens)));     # -2A
    var cp = _prk_cos(phi);
    var sp = _prk_sin(phi);
    var rr = f64_mul(a2, load64(&ib + 48));       # E_rho = -2 A Irho
    var ri = f64_mul(a2, load64(&ib + 56));
    PrtField_set_x_re(e_out, f64_mul(rr, cp));
    PrtField_set_x_im(e_out, f64_mul(ri, cp));
    PrtField_set_y_re(e_out, f64_mul(rr, sp));
    PrtField_set_y_im(e_out, f64_mul(ri, sp));
    PrtField_set_z_re(e_out, f64_neg(f64_mul(a2, load64(&ib + 72))));      # E_z = -2i A Iz
    PrtField_set_z_im(e_out, f64_mul(a2, load64(&ib + 64)));
    return _fo_done(e_out);
}

# The field for an azimuthally polarized input, E0 g phi-hat, written to e_out. It has no
# axial part. Returns as focus_jones.
fn focus_azimuthal(lens, rho, phi, z, e_out) {
    if (e_out == 0) { return PK_ERR_INVALID_PARAMETER; }
    _fo_nan(e_out, 6);
    if (_fo_phi_ok(phi) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var ib[96];
    var rc = focus_integrals(lens, rho, z, &ib);
    if (rc != PK_ERR_NONE) { return rc; }
    var a2 = f64_neg(f64_add(FocusLens_pref(lens), FocusLens_pref(lens)));     # -2A
    var cp = _prk_cos(phi);
    var sp = _prk_sin(phi);
    var epr = f64_mul(a2, load64(&ib + 80));      # E_phi = -2 A Iphi
    var epi = f64_mul(a2, load64(&ib + 88));
    PrtField_set_x_re(e_out, f64_neg(f64_mul(epr, sp)));
    PrtField_set_x_im(e_out, f64_neg(f64_mul(epi, sp)));
    PrtField_set_y_re(e_out, f64_mul(epr, cp));
    PrtField_set_y_im(e_out, f64_mul(epi, cp));
    PrtField_set_z_re(e_out, 0);
    PrtField_set_z_im(e_out, 0);
    return _fo_done(e_out);
}

# |E|^2 = |E_x|^2 + |E_y|^2 + |E_z|^2 of a PrtField, in units of E0^2: the electric energy
# density up to a constant, which is what focusing papers plot as intensity. NaN for a null
# field.
#must_use
fn focus_intensity(e) {
    if (e == 0) { return _PRK_NAN; }
    var s = 0;
    for (var i = 0; i < 6; i = i + 1) {
        var v = load64(e + i * 8);
        s = f64_add(s, f64_mul(v, v));
    }
    return s;
}

# --- pbr_core.cyr ---

# pbr_core.cyr -- physically-based rendering primitives (BRDFs)
# Usage: include "lib/pbr_core.cyr"
#
# Ported from the Rust `pbr/mod.rs`. Fresnel-Schlick, GGX/Beckmann NDFs, Smith
# geometry, Cook-Torrance, Lambert diffuse, IOR->F0. RGB variants take an
# f0/albedo buffer (3 f64) and write to a 3-f64 out buffer. FRAC_1_PI is the
# exact IEEE-754 hex of Rust's constant (not 1.0/PI, which could differ 1 ULP).
# `_pbr_pow5` replicates Rust `powi(5)` (square-and-multiply): x * (x^2)^2.

# Build an f64 ratio from two integers. Not a hot-path helper — the constants
# below are literals precisely so they never call this.
#must_use
fn _pbr_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# ln 2, for turning a base-2 exponential into the f64_exp the toolchain has.
# 0x3FE62E42FEFA39EF = 0.69314718055994530942 — the same bits f64_ln(2) returns
# (verified), written as a literal so it costs nothing at a call site.
#must_use
fn _pbr_ln2() { return 0x3FE62E42FEFA39EF; }

# 1e-15 guard epsilon. 0x3CD203AF9EE75616 is exactly what
# `f64_div(F64_ONE, f64_from(1000000000000000))` produced — asserted, not assumed
# (tests/pbr_core.tcyr pins it), so this is bit-identical to the form it replaces.
# ⚠ It is a literal for the reason _pbr_ln2's comment states two lines up, which
# this function did not follow until 2.3.2: it ran a DIVISION plus an int->f64
# conversion on every call, and it is called from **twelve** sites across
# pbr_core and pbr_advanced (counted 2.4.9: this said "eight", and was 13 until
# 2.4.9 removed the one in pbr_distribution_ggx_aniso), several inside the
# Smith/geometry terms that a
# shading loop hits per light per pixel.
#must_use
fn _pbr_eps15() { return 0x3CD203AF9EE75616; }

# Minimum GGX alpha (= roughness^2). Floors roughness at 1e-4, which is below
# any physical material; every real roughness passes through untouched, and the
# NDF stays finite (D <= 1/(pi*1e-16) ~ 3.2e15) instead of dividing by zero at
# roughness exactly 0. See pbr_distribution_ggx for why an ADDITIVE epsilon
# cannot do this job.
# 0x3E45798EE2308C3A = the bits `f64_div(F64_ONE, f64_from(100000000))` gave;
# literal for the same reason as _pbr_eps15, and pinned the same way.
#must_use
fn _pbr_alpha_min() { return 0x3E45798EE2308C3A; }

# 1/pi.
#must_use
fn _pbr_frac_1_pi() { return 0x3FD45F306DC9C883; }

# 1e-3 — the floor pbr_cook_torrance clamps n.v and n.l to, keeping the
# 4*(n.v)*(n.l) denominator away from zero at grazing angles. Literal for the
# same reason as _pbr_eps15: cook_torrance called `_pbr_r(1, 1000)` TWICE per
# invocation, and each call was a division plus two int->f64 conversions.
# 0x3F50624DD2F1A9FC is what that expression produced — asserted, not assumed.
#must_use
fn _pbr_min_dot() { return 0x3F50624DD2F1A9FC; }

# x^5 via square-and-multiply (matches Rust f64::powi(5)): x * (x*x)^2.
fn _pbr_pow5(x) {
    var x2 = f64_mul(x, x);
    var x4 = f64_mul(x2, x2);
    return f64_mul(x, x4);
}

# Fresnel-Schlick: F = F0 + (1-F0)*(1-ct)^5, ct = clamp(cos_theta, 0, 1).
#must_use
# ⚠ The clamp and the x^5 are written out rather than delegated to `f64_clamp`
# and `_pbr_pow5`. Cyrius has no `#inline`, so a call here is a real call, and
# this is the cheapest and most-called function in the PBR set — every
# pbr_cook_torrance and pbr_clearcoat_fresnel evaluation goes through it. (Until
# 2.5.1 this said "soorat evaluates it per light per pixel"; soorat evaluates its
# own WGSL copy and calls no prakash Fresnel.) Measured same-binary with
# interleaved arms in 2.3.2: 16.3 ns as written with both calls, 15 ns with only
# `_pbr_pow5` expanded, **12 ns with both (−26%)**. Bit-identical, including at
# both clamp boundaries.
# Keep the delegating form anywhere that is not hot; `_pbr_pow5` is still the
# single definition of the square-and-multiply and the rest of the file uses it.
fn pbr_fresnel_schlick(f0, cos_theta) {
    var ct = cos_theta;
    if (f64_lt(ct, 0) == 1) { ct = 0; }
    if (f64_gt(ct, F64_ONE) == 1) { ct = F64_ONE; }
    var t = f64_sub(F64_ONE, ct);
    var t2 = f64_mul(t, t);
    var t5 = f64_mul(t, f64_mul(t2, t2));
    return f64_add(f0, f64_mul(f64_sub(F64_ONE, f0), t5));
}

# Fresnel-Schlick per RGB channel. f0/out are 3-f64 buffers.
fn pbr_fresnel_schlick_rgb(f0, cos_theta, out) {
    if (f0 == 0) { return 0; }
    if (out == 0) { return 0; }
    var ct = f64_clamp(cos_theta, f64_from(0), F64_ONE);
    var factor = _pbr_pow5(f64_sub(F64_ONE, ct));
    for (var i = 0; i < 3; i = i + 1) {
        var c = load64(f0 + i * 8);
        store64(out + i * 8, f64_add(c, f64_mul(f64_sub(F64_ONE, c), factor)));
    }
    return 0;
}

# GGX/Trowbridge-Reitz NDF: D = a^2 / (pi * denom^2), a = roughness^2,
# denom = (n.h)^2*(a^2-1) + 1.
#
# ⚠ 2.2.6 DELIBERATELY DIVERGES FROM THE RUST ORIGINAL HERE. The Rust was
# `a2 / (PI * denom * denom + 1e-15)` (recoverable at
# `git show 524a7aa^:rust-old/src/pbr/mod.rs`, line 59) and the port carried it
# faithfully. That ADDITIVE ABSOLUTE epsilon is the whole defect: at the
# specular peak denom = a^2 = roughness^4, so the denominator is
# pi*roughness^8, which falls under 1e-15 at roughness ~ 0.024 — and from there
# the epsilon, not the physics, sets the answer. Measured before the fix:
#   roughness   D(n.h=1)        true 1/(pi*a^2)
#   1.0         0.318310        0.318310      (ok)
#   0.1         3183.098761     3183.098862   (ok)
#   0.01        7609427.7       31830988.6    (4.2x LOW)
#   0.001       999.999997      3.1831e11     (8 orders LOW)
# The NDF stopped being monotonic in 1/roughness, so a polished surface
# rendered DARKER than a rough one — the opposite of the physics.
# The epsilon is removed and `a` is floored instead, which keeps a true GGX
# lobe. The floor cannot divide by zero: denom is minimised at n.h = 1 where
# it equals a^2 >= 1e-16, so `pi*denom^2 > 0` for every input.
#must_use
fn pbr_distribution_ggx(n_dot_h, roughness) {
    var a = f64_mul(roughness, roughness);
    # One _pbr_alpha_min() read, not two — the guard and the assignment used to
    # call it separately, and before 2.3.2 each call was a division.
    var amin = _pbr_alpha_min();
    if (f64_lt(a, amin) == 1) { a = amin; }
    var a2 = f64_mul(a, a);
    var ndh = n_dot_h;
    # A microfacet facing away from the macro-normal has no density: chi+(n.h) (Walter et al.
    # 2007, eq. 33). 2.15.1: n.h < 0 was clamped to 0 and answered D(0) = a^2/pi, the density of
    # a facet standing on edge, for every back-facing half vector.
    if (f64_lt(ndh, 0) == 1) { return f64_from(0); }
    if (f64_gt(ndh, F64_ONE) == 1) { ndh = F64_ONE; }
    # ⛔ 2.4.9: `ndh^2 * (a2 - 1) + 1` CANCELS CATASTROPHICALLY AT THE ALPHA FLOOR.
    # The floor above puts a2 at 1e-16, and `1e-16 - 1` is not representable — it
    # rounds to -(1 - 2^-53), so adding 1 back yields 1.11e-16, not 1e-16: an 11%
    # error in denom and a **19% error in D**, which read 2.58e15 against the exact
    # 1/(pi*alpha^2) = 3.18e15 at n.h = 1. So the 2.2.6 floor's own promise ("D <=
    # 1/(pi*1e-16) ~ 3.2e15") was not quite what it delivered. Found in 2.4.9 by the
    # anisotropic twin, which after its own repair computed the exact value and
    # disagreed with this one. The rewrite is the same polynomial —
    #   ndh^2 * (a2 - 1) + 1  ==  ndh^2 * a2 + (1 - ndh^2)
    # — with the tiny term and the (possibly tiny) complement formed SEPARATELY, so
    # nothing large is subtracted from anything large. `1 - ndh^2` is exact by
    # Sterbenz wherever it can be small (ndh^2 in [0.5, 2]); at ndh = 1 it is exactly
    # 0 and denom is exactly a2.
    # ⚠ THE FIRST 2.4.9 REWRITE COST 18% AND THIS ONE COSTS NOTHING. The obvious
    # stable form, `ndh^2*a2 + (1-ndh)(1+ndh)`, adds a multiply and an add, ~2 ns
    # each of inline instructions (a movq pair around the SSE op — this said "a
    # real call" until 2.6.1 disassembled one) on a ~16 ns function. Same-binary,
    # interleaved, 4 pairs x 2e6 iterations: original 16-17 ns, (1-ndh)(1+ndh) form
    # **19-20 ns**, this form **16 ns** — same op count as the original, and
    # 1.000000000000 of the exact value at the floor where the original gave 0.811.
    var ndh2 = f64_mul(ndh, ndh);
    var denom = f64_add(f64_mul(ndh2, a2), f64_sub(F64_ONE, ndh2));
    return f64_div(a2, f64_mul(f64_mul(F64_PI, denom), denom));
}

# Beckmann NDF: exp(-tan2/a^2) / (pi*a^2*cos2^2 + 1e-15).
#must_use
fn pbr_distribution_beckmann(n_dot_h, roughness) {
    var a = f64_mul(roughness, roughness);
    var ndh = f64_clamp(n_dot_h, f64_from(0), F64_ONE);
    var cos2 = f64_mul(ndh, ndh);
    var tan2 = f64_div(f64_sub(F64_ONE, cos2), f64_add(cos2, _pbr_eps15()));
    var exp_term = _prk_exp(f64_div(f64_neg(tan2), f64_mul(a, a)));
    var denom = f64_add(
      f64_mul(f64_mul(f64_mul(f64_mul(F64_PI, a), a), cos2), cos2),
      _pbr_eps15());
    return f64_div(exp_term, denom);
}

# Schlick-GGX geometry (single direction): G1 = ndv / (ndv*(1-k) + k + 1e-15),
# k = (roughness+1)^2 / 8 (direct lighting).
#must_use
fn pbr_geometry_schlick_ggx(n_dot_v, roughness) {
    var r = f64_add(roughness, F64_ONE);
    var k = f64_div(f64_mul(r, r), f64_from(8));
    var ndv = f64_clamp(n_dot_v, f64_from(0), F64_ONE);
    return f64_div(ndv,
      f64_add(f64_add(f64_mul(ndv, f64_sub(F64_ONE, k)), k), _pbr_eps15()));
}

# Schlick-GGX G1 for IMAGE-BASED LIGHTING: k = alpha/2 with alpha = roughness^2,
# where the direct-lighting form above uses k = (r+1)^2/8 (Karis, Real Shading in
# Unreal Engine 4). The two are different remappings of the same Smith G1 and are
# not interchangeable — see pbr_integrate_brdf_lut, which used the DIRECT form
# until 2.2.7 and produced a split-sum whose A + B was 0.22 at roughness 0 where
# it must be exactly 1.
#
# ⚠ 2.2.8 FIXED A SECOND, OPPOSITE ERROR INTRODUCED BY THAT SAME 2.2.7 REPAIR:
# `a` here IS alpha, and the code then squared it again, giving k = alpha^2/2 =
# roughness^4/2. That is energy-GAINING. The split-sum scale A is the directional
# albedo of an F0 = 1 material and cannot exceed 1; measured on the shipped
# code, pbr_integrate_brdf_lut returned A = 1.168, B = 0.136, **A + B = 1.304**
# at n.v = 0.1, roughness = 0.6, and A = 1.4547 at n.v = 0.05, roughness = 0.5 —
# a surface reflecting 45% more light than reached it. With k = alpha/2 the LUT
# satisfies A + B <= 1 at every grid point, with the maximum exactly 1.0 at
# roughness 0 where it must be.
#
# ⚠ AND THE INVARIANT 2.2.7 USED TO "SETTLE" THE k QUESTION CANNOT SEE THIS.
# A + B = 1 at roughness 0 holds for BOTH remaps, because both give k = 0 there.
# The two also coincide at roughness 1 (k = 0.5). The error is a bulge over the
# interior, invisible at exactly the two points anybody would test — and the
# first 2.2.8 test written for this function pinned r = 1 and called it "pins
# k = alpha^2/2 exactly". The discriminating check is energy conservation over
# the whole grid, which is now asserted rather than described.
#must_use
fn pbr_geometry_schlick_ggx_ibl(n_dot_v, roughness) {
    var a = f64_mul(roughness, roughness);
    var k = f64_div(a, F64_TWO);
    var ndv = f64_clamp(n_dot_v, f64_from(0), F64_ONE);
    return f64_div(ndv,
      f64_add(f64_add(f64_mul(ndv, f64_sub(F64_ONE, k)), k), _pbr_eps15()));
}

# Smith geometry for IBL: G = G1_ibl(n.v) * G1_ibl(n.l).
#must_use
fn pbr_geometry_smith_ibl(n_dot_v, n_dot_l, roughness) {
    return f64_mul(
      pbr_geometry_schlick_ggx_ibl(n_dot_v, roughness),
      pbr_geometry_schlick_ggx_ibl(n_dot_l, roughness));
}

# Smith geometry: G = G1(n.v) * G1(n.l).
#must_use
fn pbr_geometry_smith(n_dot_v, n_dot_l, roughness) {
    return f64_mul(
      pbr_geometry_schlick_ggx(n_dot_v, roughness),
      pbr_geometry_schlick_ggx(n_dot_l, roughness));
}

# Cook-Torrance specular: D*F*G / (4 * clamp(n.v,.001,1) * clamp(n.l,.001,1)).
#must_use
fn pbr_cook_torrance(n_dot_h, h_dot_v, n_dot_v, n_dot_l, roughness, f0) {
    var d = pbr_distribution_ggx(n_dot_h, roughness);
    var f = pbr_fresnel_schlick(f0, h_dot_v);
    var g = pbr_geometry_smith(n_dot_v, n_dot_l, roughness);
    var mind = _pbr_min_dot();
    var denom = f64_mul(
      f64_mul(f64_from(4), f64_clamp(n_dot_v, mind, F64_ONE)),
      f64_clamp(n_dot_l, mind, F64_ONE));
    return f64_div(f64_mul(f64_mul(d, f), g), denom);
}

# Lambertian diffuse: albedo / pi.
#must_use
fn pbr_lambert_diffuse(albedo) {
    return f64_mul(albedo, _pbr_frac_1_pi());
}

# Lambertian diffuse per RGB channel. albedo/out are 3-f64 buffers.
fn pbr_lambert_diffuse_rgb(albedo, out) {
    if (albedo == 0) { return 0; }
    if (out == 0) { return 0; }
    for (var i = 0; i < 3; i = i + 1) {
        store64(out + i * 8, f64_mul(load64(albedo + i * 8), _pbr_frac_1_pi()));
    }
    return 0;
}

# Index of refraction -> F0 (reflectance at normal incidence, air n1=1):
# F0 = ((1-ior)/(1+ior))^2. NaN unless ior is finite and > 0 (2.15.1: ior = -1 answered +inf).
#must_use
fn pbr_ior_to_f0(ior) {
    if ((f64_gt(ior, f64_from(0)) & f64_lt(ior, 0x7FF0000000000000)) == 0) { return _PRK_NAN; }
    var r = f64_div(f64_sub(F64_ONE, ior), f64_add(F64_ONE, ior));
    return f64_mul(r, r);
}

# --- pbr_advanced.cyr ---

# pbr_advanced.cyr -- advanced PBR (anisotropy, sheen, clearcoat, SSS,
# iridescence, volumetric, importance sampling, split-sum IBL)
# Usage: include "lib/pbr_advanced.cyr"  (requires pbr_core.cyr; ganita for pow)
#
# Ported from the Rust `pbr/advanced.rs`. Reuses pbr_core helpers (_pbr_r,
# _pbr_pow5, _pbr_eps15, pbr_distribution_ggx, pbr_fresnel_schlick). This file
# is built in two sections: (1) anisotropy/sheen/clearcoat/SSS; (2) iridescence,
# volumetric scattering, importance sampling, and the split-sum IBL helpers.

# ── Anisotropic GGX ────────

# Anisotropic GGX NDF: 1 / (pi*ax*ay*term^2), term = (hx/ax)^2 + (hy/ay)^2 + ndh^2,
# with ax and ay floored at the same alpha minimum as the isotropic form.
# ⛔ 2.4.9: THE 2.2.6 GGX REPAIR NEVER CROSSED THE MODULE BOUNDARY. 2.2.6 found the
# isotropic pbr_distribution_ggx carrying a `+ 1e-15` in its denominator that took
# over the answer at low roughness (4.2x LOW at 0.01, eight orders low at 0.001) and
# replaced it with an alpha floor. This twin, one file over, kept both halves of the
# old form: the epsilon, and no floor. With ax = ay and a CONSISTENT half-vector
# (hx^2 + hy^2 = 1 - ndh^2) the two must agree exactly — the algebra reduces to
# a^2 / (pi*(ndh^2(a^2-1)+1)^2) — and they did not. Measured aniso/iso before:
#   roughness 1e-3, ndh 1     0.999638     roughness 1e-5, ndh 1      0.387219
#   roughness 1e-4, ndh 1     0.294661     roughness 1e-5, ndh 0.999  0.000100
# Confined to the near-mirror regime, which is why nothing saw it; the same defect
# the isotropic form was repaired for. The floor keeps the denominator strictly
# positive (pi*ax*ay*term^2 >= pi*1e-16*ndh^4 ... and term >= ndh^2 > 0 whenever
# the half-vector is in the upper hemisphere), so the epsilon has no job left.
#must_use
fn pbr_distribution_ggx_aniso(n_dot_h, h_dot_x, h_dot_y, roughness_x, roughness_y) {
    var ax = f64_mul(roughness_x, roughness_x);
    var ay = f64_mul(roughness_y, roughness_y);
    var amin = _pbr_alpha_min();
    if (f64_lt(ax, amin) == 1) { ax = amin; }
    if (f64_lt(ay, amin) == 1) { ay = amin; }
    # chi+(n.h), as pbr_distribution_ggx (2.15.1: a back-facing half vector was clamped to n.h = 0).
    if (f64_lt(n_dot_h, f64_from(0)) == 1) { return f64_from(0); }
    var ndh = f64_clamp(n_dot_h, f64_from(0), F64_ONE);
    var hx_ax = f64_div(h_dot_x, ax);
    var hy_ay = f64_div(h_dot_y, ay);
    var term = f64_add(
      f64_add(f64_mul(hx_ax, hx_ax), f64_mul(hy_ay, hy_ay)),
      f64_mul(ndh, ndh));
    var denom = f64_mul(f64_mul(f64_mul(f64_mul(F64_PI, ax), ay), term), term);
    # term = 0 only for a half-vector with ndh = hx = hy = 0, which is not a
    # direction; report 0 rather than divide by it.
    if (f64_le(denom, f64_from(0)) == 1) { return f64_from(0); }
    return f64_div(F64_ONE, denom);
}

# Anisotropic Smith geometry (single direction, Heitz): 2*ndv/denom,
# denom = ndv + sqrt(ndv^2 + (vx*ax)^2 + (vy*ay)^2).
#must_use
fn pbr_geometry_ggx_aniso(n_dot_v, v_dot_x, v_dot_y, roughness_x, roughness_y) {
    var ax = f64_mul(roughness_x, roughness_x);
    var ay = f64_mul(roughness_y, roughness_y);
    var ndv = f64_clamp(n_dot_v, f64_from(0), F64_ONE);
    var vx_ax = f64_mul(v_dot_x, ax);
    var vy_ay = f64_mul(v_dot_y, ay);
    var lambda_sq = f64_add(f64_mul(vx_ax, vx_ax), f64_mul(vy_ay, vy_ay));
    var denom = f64_add(ndv, f64_sqrt(f64_add(f64_mul(ndv, ndv), lambda_sq)));
    if (f64_lt(denom, _pbr_eps15()) == 1) {
        return f64_from(0);
    }
    return f64_div(f64_mul(F64_TWO, ndv), denom);
}

# Anisotropic Smith geometry (both directions).
#must_use
fn pbr_geometry_smith_aniso(n_dot_v, n_dot_l, v_dot_x, v_dot_y, l_dot_x, l_dot_y,
  roughness_x, roughness_y) {
    return f64_mul(
      pbr_geometry_ggx_aniso(n_dot_v, v_dot_x, v_dot_y, roughness_x, roughness_y),
      pbr_geometry_ggx_aniso(n_dot_l, l_dot_x, l_dot_y, roughness_x, roughness_y));
}

# ── Sheen ────────

# Charlie sheen distribution (Estevez & Kulla 2017):
# (2 + 1/a) * sin(theta)^(1/a) / (2*pi), a = clamp(roughness, 0.001, 1).
#must_use
fn pbr_distribution_charlie(n_dot_h, roughness) {
    var alpha = f64_clamp(roughness, _pbr_r(1, 1000), F64_ONE);
    var inv_alpha = f64_div(F64_ONE, alpha);
    var ndh = f64_clamp(n_dot_h, f64_from(0), F64_ONE);
    var sin_theta = f64_sqrt(f64_sub(F64_ONE, f64_mul(ndh, ndh)));
    return f64_div(
      f64_mul(f64_add(F64_TWO, inv_alpha), _prk_pow(sin_theta, inv_alpha)),
      f64_mul(F64_TWO, F64_PI));
}

# Sheen BRDF (Charlie): D / (4*(ndl + ndv - ndl*ndv)).
#must_use
fn pbr_sheen_charlie(n_dot_h, n_dot_l, n_dot_v, roughness) {
    var d = pbr_distribution_charlie(n_dot_h, roughness);
    var ndl = f64_clamp(n_dot_l, _pbr_r(1, 1000), F64_ONE);
    var ndv = f64_clamp(n_dot_v, _pbr_r(1, 1000), F64_ONE);
    return f64_div(d,
      f64_mul(f64_from(4), f64_sub(f64_add(ndl, ndv), f64_mul(ndl, ndv))));
}

# Ashikhmin sheen: intensity * (1 - ct)^5.
#must_use
fn pbr_sheen_ashikhmin(cos_theta, sheen_intensity) {
    var ct = f64_clamp(cos_theta, f64_from(0), F64_ONE);
    return f64_mul(sheen_intensity, _pbr_pow5(f64_sub(F64_ONE, ct)));
}

# ── Clearcoat ────────

# Clearcoat GGX distribution (separate low roughness).
#must_use
fn pbr_clearcoat_distribution(n_dot_h, clearcoat_roughness) {
    return pbr_distribution_ggx(n_dot_h, clearcoat_roughness);
}

# Clearcoat Fresnel (fixed IOR 1.5, F0 = 0.04).
#must_use
fn pbr_clearcoat_fresnel(cos_theta) {
    return pbr_fresnel_schlick(_pbr_r(4, 100), cos_theta);
}

# Clearcoat visibility with no masking or shadowing (G = 1): the Cook-Torrance denominator alone,
# 1/(4 n.v n.l), both clamped to >= 1e-3. ⚠ 2.15.1: this said "Kelemen, simplified". It is not:
# Kelemen's visibility is 1/(4 (l.h)^2), which needs l.h and stays finite at grazing, where this
# grows to 2.5e5.
#must_use
fn pbr_clearcoat_geometry(n_dot_v, n_dot_l) {
    var ndv = f64_clamp(n_dot_v, _pbr_r(1, 1000), F64_ONE);
    var ndl = f64_clamp(n_dot_l, _pbr_r(1, 1000), F64_ONE);
    return f64_div(_pbr_r(1, 4), f64_mul(ndv, ndl));
}

# Full clearcoat BRDF: D * F * G.
#must_use
fn pbr_clearcoat_brdf(n_dot_h, n_dot_v, n_dot_l, h_dot_v, clearcoat_roughness) {
    var d = pbr_clearcoat_distribution(n_dot_h, clearcoat_roughness);
    var f = pbr_clearcoat_fresnel(h_dot_v);
    var g = pbr_clearcoat_geometry(n_dot_v, n_dot_l);
    return f64_mul(f64_mul(d, f), g);
}

# Energy-conserving clearcoat blend:
# (1 - Fc*clearcoat)*base + clearcoat*coat.
#must_use
fn pbr_clearcoat_blend(base_brdf, coat_brdf, clearcoat, h_dot_v) {
    var fc = pbr_clearcoat_fresnel(h_dot_v);
    return f64_add(
      f64_mul(f64_sub(F64_ONE, f64_mul(fc, clearcoat)), base_brdf),
      f64_mul(clearcoat, coat_brdf));
}

# ── Subsurface Scattering ────────

# Burley normalized diffusion with unit albedo: [e^(-r/d) + e^(-r/3d)] / (8*pi*d*r), which
# integrates to 1 over the plane (int R 2 pi r dr = (d + 3d)/(4d)). It diverges as 1/(4 pi d r)
# toward r = 0: +inf at r = 0. NaN for r < 0 or NaN, or d not finite and > 0.
# ⛔ 2.15.1: below r = 1e-15 this returned 1/(2 pi d^2) and called it "the limit"; there is none,
# and the profile jumped from 0.159 at r = 1e-16 to 4.1e13 at 1e-15. d = 0 gave NaN and d < 0 a
# negative profile.
#must_use
fn pbr_sss_profile_burley(r, d) {
    if ((f64_gt(d, f64_from(0)) & f64_lt(d, 0x7FF0000000000000)) == 0) { return _PRK_NAN; }
    if (f64_ge(r, f64_from(0)) == 0) { return _PRK_NAN; }
    if ((r & 0x7FFFFFFFFFFFFFFF) == 0) { return 0x7FF0000000000000; }
    var inv_8pd = f64_div(F64_ONE, f64_mul(f64_mul(f64_from(8), F64_PI), d));
    var terms = f64_add(
      _prk_exp(f64_div(f64_neg(r), d)),
      _prk_exp(f64_div(f64_neg(r), f64_mul(f64_from(3), d))));
    return f64_div(f64_mul(inv_8pd, terms), r);
}

# Gaussian SSS profile: e^(-r^2/(2*sigma^2)) / (2*pi*sigma^2).
#must_use
fn pbr_sss_profile_gaussian(r, sigma) {
    var s2 = f64_mul(sigma, sigma);
    var num = _prk_exp(f64_div(f64_mul(f64_neg(r), r), f64_mul(F64_TWO, s2)));
    return f64_div(num, f64_mul(f64_mul(F64_TWO, F64_PI), s2));
}

# Burley's subsurface lobe (Disney BRDF, 2012; Hanrahan-Krueger in shape), divided by pi:
#   F_ss90 = (l.h)^2 r,  F_ss = (1 + (F_ss90 - 1) F_L)(1 + (F_ss90 - 1) F_V),  F = (1 - cos)^5,
#   ss = 1.25 (F_ss (1/(n.l + n.v) - 1/2) + 1/2),
# with r the perceptual roughness. This signature has no l.h, so it is taken as 1 (the
# retro-reflective direction): F_ss90 = r. 0 where n.l <= 0 or n.v <= 0, as Disney's code.
# ⛔ 2.15.1: F_ss90 was r^2, which is not Burley at any l.h; and n.l = n.v = 0 divided by 1e-15
# and returned 2.5e13.
#must_use
fn pbr_subsurface_diffuse(n_dot_l, n_dot_v, roughness) {
    if ((f64_gt(n_dot_l, f64_from(0)) & f64_gt(n_dot_v, f64_from(0))) == 0) { return f64_from(0); }
    var ndl = f64_clamp(n_dot_l, f64_from(0), F64_ONE);
    var ndv = f64_clamp(n_dot_v, f64_from(0), F64_ONE);
    var fl = _pbr_pow5(f64_sub(F64_ONE, ndl));
    var fv = _pbr_pow5(f64_sub(F64_ONE, ndv));
    var f_ss90 = roughness;
    var f_ss = f64_mul(
      f64_add(F64_ONE, f64_mul(f64_sub(f_ss90, F64_ONE), fl)),
      f64_add(F64_ONE, f64_mul(f64_sub(f_ss90, F64_ONE), fv)));
    var inner = f64_add(
      f64_mul(f_ss, f64_sub(
          f64_div(F64_ONE, f64_add(ndl, ndv)),
          F64_HALF)),
      F64_HALF);
    var fss = f64_mul(_pbr_r(125, 100), inner);
    return f64_div(fss, F64_PI);
}

# Thin-slab diffuse transmittance (Borshukov): e^(-extinction*thickness). NaN for a negative or NaN
# thickness or extinction (2.15.1: extinction -1 transmitted e = 2.72 of the light).
#must_use
fn pbr_sss_transmittance(thickness, extinction) {
    if ((f64_ge(thickness, f64_from(0)) & f64_ge(extinction, f64_from(0))) == 0) { return _PRK_NAN; }
    return _prk_exp(f64_mul(f64_neg(extinction), thickness));
}

# ── Iridescence ────────

# Airy reflectance of one polarization from the SIGNED amplitude coefficients r01, r12 and the
# round-trip phase Phi: (r01^2 + r12^2 + 2 r01 r12 cos Phi)/(1 + r01^2 r12^2 + 2 r01 r12 cos Phi).
#must_use
fn _pbr_airy(r01, r12, cos_phi) {
    var x = f64_mul(f64_mul(F64_TWO, f64_mul(r01, r12)), cos_phi);
    var num = f64_add(f64_add(f64_mul(r01, r01), f64_mul(r12, r12)), x);
    var p = f64_mul(r01, r12);
    return f64_div(num, f64_add(f64_add(F64_ONE, f64_mul(p, p)), x));
}

# Thin-film iridescence reflectance at one wavelength: a lossless film of n_film and thickness
# (the wavelength's unit) between n_outside and n_base, unpolarized (the mean of s and p), by the
# Airy summation (Born & Wolf 1.6.4) with signed Fresnel amplitudes and round-trip phase
# Phi = 4 pi n_film d cos(theta_film)/lambda. 1 at grazing incidence, and wherever the film or
# the base totally reflects (lossless: whatever does not leave through the base comes back).
# ⛔ 2.15.1: the amplitude product entered as sqrt(R01 R12), its sign lost, and only s was
# modelled. A soap film (air | 1.33 | air) has r01 = -r12, so a VANISHING film read 0.077, the
# quarter-wave maximum, and a quarter-wave film read 0: the two swapped. Against a separate
# characteristic-matrix computation (50 digits, ten films) it now agrees to 6e-17.
#must_use
fn pbr_iridescence_fresnel(n_outside, n_film, n_base, thickness, wavelength, cos_theta) {
    var ct = f64_clamp(cos_theta, f64_from(0), F64_ONE);
    if ((ct & 0x7FFFFFFFFFFFFFFF) == 0) { return F64_ONE; }
    var sin2_theta = f64_sub(F64_ONE, f64_mul(ct, ct));
    var of = f64_div(n_outside, n_film);
    var sin2_film = f64_mul(f64_mul(sin2_theta, of), of);
    if (f64_ge(sin2_film, F64_ONE) == 1) {
        return F64_ONE;
    }
    var cos_film = f64_sqrt(f64_sub(F64_ONE, sin2_film));
    var ob = f64_div(n_outside, n_base);
    var sin2_base = f64_mul(f64_mul(sin2_theta, ob), ob);
    if (f64_ge(sin2_base, F64_ONE) == 1) {
        return F64_ONE;
    }
    var cos_base = f64_sqrt(f64_sub(F64_ONE, sin2_base));
    # s: (n_i cos_i - n_t cos_t)/(n_i cos_i + n_t cos_t); p: (n_t cos_i - n_i cos_t)/(n_t cos_i +
    # n_i cos_t). Each polarization keeps one convention at both interfaces, which is all the
    # Airy sum needs.
    var a0 = f64_mul(n_outside, ct);
    var a1 = f64_mul(n_film, cos_film);
    var a2 = f64_mul(n_base, cos_base);
    var s01 = f64_div(f64_sub(a0, a1), f64_add(a0, a1));
    var s12 = f64_div(f64_sub(a1, a2), f64_add(a1, a2));
    var b0 = f64_mul(n_film, ct);
    var b1 = f64_mul(n_outside, cos_film);
    var p01 = f64_div(f64_sub(b0, b1), f64_add(b0, b1));
    var c1 = f64_mul(n_base, cos_film);
    var c2 = f64_mul(n_film, cos_base);
    var p12 = f64_div(f64_sub(c1, c2), f64_add(c1, c2));
    var phi = f64_div(f64_mul(f64_mul(f64_mul(f64_mul(F64_TWO, F64_TAU), n_film), thickness), cos_film), wavelength);
    var cos_phi = _prk_cos(phi);
    var r = f64_mul(F64_HALF, f64_add(_pbr_airy(s01, s12, cos_phi), _pbr_airy(p01, p12, cos_phi)));
    return f64_clamp(r, f64_from(0), F64_ONE);
}

# Iridescence as RGB (R=650nm, G=550nm, B=450nm) into a 3-f64 out buffer. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER and writes nothing for a null out (2.15.1: it was written through).
fn pbr_iridescence_rgb(n_outside, n_film, n_base, thickness_nm, cos_theta, out) {
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    store64(out,
      pbr_iridescence_fresnel(n_outside, n_film, n_base, thickness_nm, f64_from(650), cos_theta));
    store64(out + 8,
      pbr_iridescence_fresnel(n_outside, n_film, n_base, thickness_nm, f64_from(550), cos_theta));
    store64(out + 16,
      pbr_iridescence_fresnel(n_outside, n_film, n_base, thickness_nm, f64_from(450), cos_theta));
    return 0;
}

# ── Volumetric Scattering ────────

# Henyey-Greenstein phase: (1 - g^2) / (4*pi * (1 + g^2 - 2*g*cos)^1.5). NaN unless |g| < 1: past 1
# it is negative, and at 1 it is a delta, not a density.
# ⛔ 2.15.1: g = 2 returned -0.021 as a phase function, and a 1e-15 floor on the denominator
# returned 0 for the forward peak of any g within ~1e-8 of 1, where the true value is ~1e15.
#must_use
fn pbr_henyey_greenstein(cos_theta, g) {
    if (f64_lt(f64_abs(g), F64_ONE) == 0) { return _PRK_NAN; }
    var g2 = f64_mul(g, g);
    var denom = f64_sub(f64_add(F64_ONE, g2), f64_mul(f64_mul(F64_TWO, g), cos_theta));
    var denom_full = f64_mul(denom, f64_sqrt(denom));
    return f64_div(f64_sub(F64_ONE, g2), f64_mul(f64_mul(f64_from(4), F64_PI), denom_full));
}

# Isotropic phase: 1/(4*pi).
#must_use
fn pbr_phase_isotropic() {
    return f64_div(F64_ONE, f64_mul(f64_from(4), F64_PI));
}

# Rayleigh phase: 3*(1 + cos^2) / (16*pi).
#must_use
fn pbr_phase_rayleigh(cos_theta) {
    return f64_div(
      f64_mul(f64_from(3), f64_add(F64_ONE, f64_mul(cos_theta, cos_theta))),
      f64_mul(f64_from(16), F64_PI));
}

# Extinction: sigma_t = absorption + scattering.
#must_use
fn pbr_extinction_coefficient(absorption, scattering) {
    return f64_add(absorption, scattering);
}

# Beer-Lambert volume transmittance: e^(-sigma_t * distance).
#must_use
fn pbr_volume_transmittance(sigma_t, distance) {
    return _prk_exp(f64_mul(f64_neg(sigma_t), distance));
}

# Single-scattering albedo: scattering / (absorption + scattering).
#must_use
fn pbr_single_scatter_albedo(absorption, scattering) {
    var total = f64_add(absorption, scattering);
    if (f64_lt(total, _pbr_eps15()) == 1) {
        return f64_from(0);
    }
    return f64_div(scattering, total);
}

# In-scattering: sigma_s * phase(cos) * T(d) * L.
#must_use
fn pbr_single_scatter_inscattering(scattering, cos_theta, g, sigma_t, distance, light_intensity) {
    var phase = pbr_henyey_greenstein(cos_theta, g);
    var transmittance = pbr_volume_transmittance(sigma_t, distance);
    return f64_mul(f64_mul(f64_mul(scattering, phase), transmittance), light_intensity);
}

# ── Importance Sampling ────────

# GGX importance-sampled half-vector (tangent space) into a 3-f64 out buffer. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER and writes nothing for a null out (2.15.1: it was written through).
fn pbr_sample_ggx(roughness, xi1, xi2, out) {
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    var a = f64_mul(roughness, roughness);
    var a2 = f64_mul(a, a);
    var cos_theta = f64_sqrt(f64_div(
        f64_sub(F64_ONE, xi1),
        f64_add(F64_ONE, f64_mul(f64_sub(a2, F64_ONE), xi1))));
    var sin_theta = f64_max(f64_sqrt(f64_sub(F64_ONE, f64_mul(cos_theta, cos_theta))), f64_from(0));
    var phi = f64_mul(F64_TAU, xi2);
    var sin_phi = _prk_sin(phi);
    var cos_phi = _prk_cos(phi);
    store64(out, f64_mul(sin_theta, cos_phi));
    store64(out + 8, f64_mul(sin_theta, sin_phi));
    store64(out + 16, cos_theta);
    return 0;
}

# PDF of the GGX-sampled half-vector: D(h) * n.h / (4 * h.v).
#must_use
fn pbr_sample_ggx_pdf(n_dot_h, h_dot_v, roughness) {
    var d = pbr_distribution_ggx(n_dot_h, roughness);
    var ndh = f64_clamp(n_dot_h, f64_from(0), F64_ONE);
    var hdv = f64_clamp(h_dot_v, _pbr_r(1, 1000), F64_ONE);
    return f64_div(f64_mul(d, ndh), f64_mul(f64_from(4), hdv));
}

# Cosine-weighted hemisphere sample (Malley's method) into a 3-f64 out buffer. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER and writes nothing for a null out (2.15.1: it was written through).
fn pbr_sample_cosine_hemisphere(xi1, xi2, out) {
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    var r = f64_sqrt(xi1);
    var phi = f64_mul(F64_TAU, xi2);
    var sin_phi = _prk_sin(phi);
    var cos_phi = _prk_cos(phi);
    store64(out, f64_mul(r, cos_phi));
    store64(out + 8, f64_mul(r, sin_phi));
    store64(out + 16, f64_max(f64_sqrt(f64_sub(F64_ONE, xi1)), f64_from(0)));
    return 0;
}

# PDF of cosine hemisphere sampling: n.l / pi.
#must_use
fn pbr_sample_cosine_pdf(n_dot_l) {
    return f64_div(f64_clamp(n_dot_l, f64_from(0), F64_ONE), F64_PI);
}

# ── Split-Sum IBL ────────

# Analytic split-sum (scale, bias) approximation into a 2-f64 out buffer.
# Karis / Lazarov 2013 `EnvBRDFApprox`:
#   r  = (1 - m, -0.0275m + 0.0425, -0.572m + 1.04, 0.022m - 0.04)
#   a  = min(r.x^2, 2^(-9.28 * n.v)) * r.x + r.y
#   A  = -1.04a + r.z        B = 1.04a + r.w
#
# ⚠ 2.2.7 REPLACED THE PREVIOUS FIT OUTRIGHT — it was not merely inaccurate,
# it was inert. Inherited verbatim from the Rust original
# (`rust-old/src/pbr/advanced.rs:540,549`). Two independent failures:
#
#   1. THE BIAS TERM WAS IDENTICALLY ZERO EVERYWHERE, provably. The polynomial
#      b3 = ((0.042x - 0.1)x + 0.03)x - 0.002 is NEGATIVE across the whole
#      x = roughness^2 in [0,1] range (-0.002 at x=0, -0.030 at x=1), and it was
#      multiplied by max(3.09*ndv - 1.929, 0) >= 0, so the product could never be
#      positive — and was then clamped to [0,1]. Measured over a 110-point grid:
#      bias was -0.000000 at every single point.
#   2. THE SCALE'S ANGULAR FACTOR RAN BACKWARDS. min(-1.613*ndv + 2.227, 1)
#      equals 1 for every ndv below 0.761 and then DECREASES to 0.614 at normal
#      incidence — so scale was flat at 0.998 across most of the domain and
#      lowest exactly where the specular response is strongest.
#
# Accuracy of this fit against pbr_integrate_brdf_lut, re-measured at 2.4.9 on the
# CURRENT (energy-conserving, 2.2.8) LUT — grid n.v = 0.0..1.0 step 0.1 x
# r = 0.1..1.0 step 0.1 (110 points), 1024 samples; stable at 4096:
#   scale  max err 0.1803, mean 0.0629  (worst: n.v = 1.0, r = 0.4 — fit 0.777,
#                                        integral 0.958; at NORMAL incidence)
#   bias   max err 0.1357, mean 0.0135  (worst: n.v = 0.0, r = 0.1 — fit 0.762,
#                                        integral 0.626; at grazing)
# ⛔ 2.4.9 REPLACED THE PREVIOUS TABLE, which had been measured against the 2.2.7
# LUT that 2.2.8 found energy-GAINING (k = alpha^2/2). It claimed scale max 0.5547
# (3.1x overstated), bias max 0.0861 (1.6x UNDERSTATED — the one a consumer sizes
# against), and named the worst point as r = 0.6, n.v = 0.1 "where the integral is
# 1.158": the fit there is 0.603 and the corrected integral is 0.635, and 1.158 is
# not reachable anywhere on the current LUT (max A + B over a 21x21 grid is 1.0).
# Its "old fit" row (the pre-2.2.7 constant-and-zero fit) was measured against the
# same superseded LUT and is dropped rather than re-measured. The table now has a
# suite assertion behind it (tests/pbr_advanced.tcyr), so it cannot rot silently.
# ⚠ Karis is a published MOBILE approximation. It is not a replacement for
# pbr_integrate_brdf_lut — callers wanting accuracy should integrate. What it is
# not, any more, is a constant and a zero.
# Writes (scale, bias) to out+0/+8. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER and writes nothing for a null out (2.15.1: it was written through).
fn pbr_split_sum_scale_bias(n_dot_v, roughness, out) {
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    var ndv = f64_clamp(n_dot_v, f64_from(0), F64_ONE);
    var m = f64_clamp(roughness, f64_from(0), F64_ONE);
    var rx = f64_sub(F64_ONE, m);
    var ry = f64_add(f64_mul(f64_neg(_pbr_r(275, 10000)), m), _pbr_r(425, 10000));
    var rz = f64_add(f64_mul(f64_neg(_pbr_r(572, 1000)), m), _pbr_r(104, 100));
    var rw = f64_add(f64_mul(_pbr_r(22, 1000), m), f64_neg(_pbr_r(4, 100)));
    # 2^(-9.28 * n.v) via exp: the shim handles the infinities, and the exponent
    # here is always finite and non-positive.
    var e = _prk_exp(f64_mul(f64_mul(f64_neg(_pbr_r(928, 100)), ndv), _pbr_ln2()));
    var a004 = f64_add(f64_mul(f64_min(f64_mul(rx, rx), e), rx), ry);
    var scale = f64_add(f64_mul(f64_neg(_pbr_r(104, 100)), a004), rz);
    var bias = f64_add(f64_mul(_pbr_r(104, 100), a004), rw);
    store64(out, f64_clamp(scale, f64_from(0), F64_ONE));
    store64(out + 8, f64_clamp(bias, f64_from(0), F64_ONE));
    return 0;
}

# Environment-map mip level: roughness * max_lod.
#must_use
fn pbr_env_map_lod(roughness, max_lod) {
    return f64_mul(roughness, max_lod);
}

# u32 bit-reversal (32-bit) for the Hammersley sequence.
fn _pbr_revbits32(x) {
    var r = 0;
    var i = 0;
    while (i < 32) {
        r = (r << 1) + (x & 1);
        x = x >> 1;
        i = i + 1;
    }
    return r;
}

# Van der Corput radical inverse (base 2): reverse_bits(bits) * 2^-32.
fn _pbr_radvdc(bits) {
    return f64_mul(f64_from(_pbr_revbits32(bits)), 0x3DF0000000000000);
}

# Numerically integrate the split-sum BRDF LUT (scale, bias) into a 2-f64 buffer
# via importance-sampled GGX + Hammersley points.
fn pbr_integrate_brdf_lut(n_dot_v, roughness, num_samples, out) {
    _prk_trace("integrate_brdf_lut");
    # ⚠ 2.2.8: num_samples <= 0 made inv_samples = 1/0 = +inf, the loop never
    # ran, and the function stored inf*0 = NaN into out while returning
    # PK_ERR_NONE. A null out was written through unconditionally. Both now
    # report instead of fabricating.
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (num_samples <= 0) {
        store64(out, f64_from(0));
        store64(out + 8, f64_from(0));
        return PK_ERR_INVALID_PARAMETER;
    }
    var ndv = f64_clamp(n_dot_v, _pbr_r(1, 1000), F64_ONE);
    # ⛔ 2.3.7: these two 24-byte vectors were `alloc`ed per call, and BOTH failure
    # paths read `if (v == 0) { return 0; }` — returning 0, which IS `PK_ERR_NONE`.
    # An allocation failure therefore reported SUCCESS, and did so WITHOUT writing
    # `out`, so the caller read stale memory as a valid split-sum result. That is
    # the exact inversion of CLAUDE.md's "report, don't fabricate" rule, in a
    # function whose other guards return PK_ERR_INVALID_PARAMETER correctly.
    #
    # They are stack locals now, which deletes the failure path rather than fixing
    # its return code: there is no allocation left to fail. 24 bytes each against a
    # measured 122,880-byte per-function budget, so neither can trip cycc's
    # "oversized array local kept in shared global" warning. Also removes 48 bytes
    # of per-call permanent consumption. ⚠ Per CALL, not per sample — both were
    # hoisted outside the sample loop already; the function itself is what runs
    # once per LUT texel, so a 128x128 LUT leaked ~786 KB under a bump allocator
    # that never frees. Measured 48 -> 0 B/call and NO time change (8.03 vs
    # 8.03 us): this is a leak and correctness fix, not a speed one.
    var v[24];
    store64(&v, f64_sqrt(f64_sub(F64_ONE, f64_mul(ndv, ndv))));
    store64(&v + 8, f64_from(0));
    store64(&v + 16, ndv);
    var scale = f64_from(0);
    var bias = f64_from(0);
    var inv_samples = f64_div(F64_ONE, f64_from(num_samples));
    var h[24];
    for (var i = 0; i < num_samples; i = i + 1) {
        var xi1 = f64_mul(f64_from(i), inv_samples);
        pbr_sample_ggx(roughness, xi1, _pbr_radvdc(i), &h);
        var vdh = f64_max(f64_add(
            f64_add(f64_mul(load64(&v), load64(&h)), f64_mul(load64(&v + 8), load64(&h + 8))),
            f64_mul(load64(&v + 16), load64(&h + 16))), f64_from(0));
        var n_dot_l = f64_max(
          f64_sub(f64_mul(f64_mul(F64_TWO, vdh), load64(&h + 16)), load64(&v + 16)),
          f64_from(0));
        var n_dot_h = f64_max(load64(&h + 16), f64_from(0));
        if (f64_gt(n_dot_l, f64_from(0)) == 1) {
            # 2.2.7: was pbr_geometry_smith, the DIRECT-lighting remapping
            # k = (r+1)^2/8. The split-sum integral is image-based lighting and
            # needs the IBL remap. Diagnosed by exact model match — a Python
            # reference using the direct k reproduced this function's output to
            # six decimals at every sampled point, and the IBL k does not. At
            # roughness 0 it gave A + B = 0.2215 at n.v = 0.1 (A = 0.090687,
            # B = 0.130766) where the split sum must give exactly 1.
            # ⛔ 2.5.1: THIS NOTE USED TO SAY "needs k = alpha^2/2" AND THAT
            # A + B = 1 AT ROUGHNESS 0 "SETTLES IT". Both were the 2.2.7 error
            # 2.2.8 then fixed: k = alpha^2/2 is energy-GAINING (A + B = 1.304 at
            # n.v = 0.1, roughness 0.6), the correct IBL remap is k = alpha/2, and
            # the roughness-0 invariant holds for both remaps, so it cannot
            # decide between them. See pbr_geometry_schlick_ggx_ibl in
            # pbr_core.cyr; the code below was right, only this comment was not.
            var g = pbr_geometry_smith_ibl(ndv, n_dot_l, roughness);
            var g_vis = f64_div(f64_mul(g, vdh), f64_add(f64_mul(n_dot_h, ndv), _pbr_eps15()));
            var fc = _pbr_pow5(f64_sub(F64_ONE, vdh));
            scale = f64_add(scale, f64_mul(g_vis, f64_sub(F64_ONE, fc)));
            bias = f64_add(bias, f64_mul(g_vis, fc));
        }
    }
    store64(out, f64_mul(scale, inv_samples));
    store64(out + 8, f64_mul(bias, inv_samples));
    return 0;
}

# --- lens.cyr ---

# lens.cyr -- lens & mirror geometry, aberrations, MTF, depth of field
# Usage: include "lib/lens.cyr"  (requires error.cyr, and wave_zernike.cyr for the aberrated
#   OTF and lens_mtf_through_focus; ganita for atan2/acos/hypot)
#
# Ported from the Rust `lens.rs`. Two sections: (1) thin/thick lens equations,
# f-number/NA, field of view; (2) MTF, Seidel aberrations, Petzval, multi-element
# systems. Rust `Result<f64>` -> err_out pointer (PK_ERR_NONE / PK_ERR_*, 0 on
# error). `f64::INFINITY` = 0x7FF0000000000000; 1/inf = 0 via IEEE division.

fn _lens_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }
# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _lens_eps15() { return 0x3CD203AF9EE75616; }
fn _lens_inf() { return 0x7FF0000000000000; }

# x^2 and x^3 matching Rust powi (square-and-multiply).
fn _lens_pow2(x) { return f64_mul(x, x); }
fn _lens_pow3(x) { return f64_mul(x, f64_mul(x, x)); }

# ── Thin lens ────────

# Thin lens equation 1/f = 1/do + 1/di -> image distance; err if object at focus.
#must_use
fn lens_thin_image_distance(focal_length, object_distance, err_out) {
    store64(err_out, PK_ERR_NONE);
    var denom = f64_sub(object_distance, focal_length);
    if (f64_lt(f64_abs(denom), _lens_eps15()) == 1) {
        store64(err_out, PK_ERR_DIVISION_BY_ZERO);
        return f64_from(0);
    }
    return f64_div(f64_mul(focal_length, object_distance), denom);
}

# Magnification M = -di/do.
#must_use
fn lens_magnification(object_distance, image_distance) {
    return f64_div(f64_neg(image_distance), object_distance);
}

# 1 if r is a usable radius of curvature: not 0 and not NaN (an infinite one is a plane).
#must_use
fn _lens_radius_ok(r) {
    if ((r & 0x7FFFFFFFFFFFFFFF) == 0) { return 0; }
    return f64_eq(r, r);
}

# Lensmaker's equation: 1/f = (n-1)*(1/R1 - 1/R2). PK_ERR_INVALID_PARAMETER (returns 0) for a
# radius of 0 or NaN (2.15.1: 1/0 made the power infinite and f = 0 came back as success).
#must_use
fn lens_lensmaker_focal_length(n, r1, r2, err_out) {
    store64(err_out, PK_ERR_NONE);
    if ((_lens_radius_ok(r1) & _lens_radius_ok(r2)) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return f64_from(0);
    }
    var power = f64_mul(f64_sub(n, F64_ONE),
      f64_sub(f64_div(F64_ONE, r1), f64_div(F64_ONE, r2)));
    if (f64_lt(f64_abs(power), _lens_eps15()) == 1) {
        store64(err_out, PK_ERR_DIVISION_BY_ZERO);
        return f64_from(0);
    }
    return f64_div(F64_ONE, power);
}

# Optical power in diopters: 1/f.
#must_use
fn lens_optical_power(focal_length_m, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (f64_lt(f64_abs(focal_length_m), _lens_eps15()) == 1) {
        store64(err_out, PK_ERR_DIVISION_BY_ZERO);
        return f64_from(0);
    }
    return f64_div(F64_ONE, focal_length_m);
}

# Mirror focal length: f = R/2.
#must_use
fn lens_mirror_focal_length(radius) {
    return f64_div(radius, F64_TWO);
}

# Mirror image distance (same form as thin lens).
#must_use
fn lens_mirror_image_distance(focal_length, object_distance, err_out) {
    return lens_thin_image_distance(focal_length, object_distance, err_out);
}

# ── Lens classification ────────

var LENS_CONVERGING = 0;
var LENS_DIVERGING = 1;

# Classify a lens by focal length (>0 converging, else diverging).
#must_use
fn lens_classify(focal_length) {
    if (f64_gt(focal_length, f64_from(0)) == 1) {
        return LENS_CONVERGING;
    }
    return LENS_DIVERGING;
}

# Two thin lenses in contact: 1/f = 1/f1 + 1/f2.
#must_use
fn lens_combined_focal_length(f1, f2, err_out) {
    store64(err_out, PK_ERR_NONE);
    var sum = f64_add(f1, f2);
    if (f64_lt(f64_abs(sum), _lens_eps15()) == 1) {
        store64(err_out, PK_ERR_DIVISION_BY_ZERO);
        return f64_from(0);
    }
    return f64_div(f64_mul(f1, f2), sum);
}

# Depth of field: writes (near, far) to out+0/+8; far = INFINITY beyond hyperfocal. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER and writes nothing for a null out (2.15.1: it was written through).
fn lens_depth_of_field(focal_length, f_number, coc, subject_dist, out) {
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    var h = f64_div(f64_mul(focal_length, focal_length), f64_mul(f_number, coc));
    var sd_minus_f = f64_sub(subject_dist, focal_length);
    var near = f64_div(f64_mul(h, subject_dist), f64_add(h, sd_minus_f));
    var far_denom = f64_sub(h, sd_minus_f);
    var far = _lens_inf();
    if (f64_le(far_denom, f64_from(0)) == 0) {
        far = f64_div(f64_mul(h, subject_dist), far_denom);
    }
    store64(out, near);
    store64(out + 8, far);
    return 0;
}

# ── Thick lens ────────

# Thick lens focal length: 1/f = (n-1)*[1/R1 - 1/R2 + (n-1)*d/(n*R1*R2)]. PK_ERR_INVALID_PARAMETER
# (returns 0) for a radius of 0 or NaN, as lens_lensmaker_focal_length (2.15.1).
#must_use
fn lens_thick_focal_length(n, r1, r2, thickness, err_out) {
    store64(err_out, PK_ERR_NONE);
    if ((_lens_radius_ok(r1) & _lens_radius_ok(r2)) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return f64_from(0);
    }
    var nm1 = f64_sub(n, F64_ONE);
    var inner = f64_add(
      f64_sub(f64_div(F64_ONE, r1), f64_div(F64_ONE, r2)),
      f64_div(f64_mul(nm1, thickness), f64_mul(f64_mul(n, r1), r2)));
    var power = f64_mul(nm1, inner);
    if (f64_lt(f64_abs(power), _lens_eps15()) == 1) {
        store64(err_out, PK_ERR_DIVISION_BY_ZERO);
        return f64_from(0);
    }
    return f64_div(F64_ONE, power);
}

#derive(accessors)
struct CardinalPoints { focal_length; ffd; bfd; front_principal; back_principal; }

# Cardinal points of a thick lens (returns struct ptr; 0 on error).
# ⚠ SIGN CONVENTION, checked at 2.4.6 and previously unstated. `ffd`/`bfd` are the
# focal distances from the front and back vertex, positive rightward (so `ffd` is
# negative for a converging lens). The two principal-plane fields are the NEGATIVE
# of the usual "position from the vertex, positive rightward": for a symmetric
# biconvex lens (n = 1.5, R = +/-50, d = 5) the planes sit at +1.6949 from V1 and
# -1.6949 from V2, and this struct reports -1.6949 and +1.6949. The convention is
# self-consistent — both fields are "distance from the vertex, positive leftward" —
# and the magnitudes are correct; it is documented rather than changed because the
# fields are public API and consumers may already depend on the values.
#must_use
fn lens_cardinal_points(n, r1, r2, thickness, err_out) {
    _prk_trace("cardinal_points");
    var f = lens_thick_focal_length(n, r1, r2, thickness, err_out);
    if (prakash_is_err(load64(err_out)) == 1) {
        return 0;
    }
    var nm1 = f64_sub(n, F64_ONE);
    var phi1 = f64_div(nm1, r1);
    var phi2 = f64_div(f64_neg(nm1), r2);
    var bfd = f64_mul(f, f64_sub(F64_ONE, f64_div(f64_mul(phi1, thickness), n)));
    var ffd = f64_mul(f64_neg(f), f64_sub(F64_ONE, f64_div(f64_mul(phi2, thickness), n)));
    var cp = alloc(sizeof(CardinalPoints));
    if (cp == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    CardinalPoints_set_focal_length(cp, f);
    CardinalPoints_set_ffd(cp, ffd);
    CardinalPoints_set_bfd(cp, bfd);
    CardinalPoints_set_front_principal(cp, f64_sub(f64_neg(f), ffd));
    CardinalPoints_set_back_principal(cp, f64_sub(f, bfd));
    return cp;
}

# ── Aperture / F-number / NA ────────

# F-number: N = f / D.
#must_use
fn lens_f_number(focal_length, aperture_diameter) {
    return f64_div(focal_length, aperture_diameter);
}

# Aperture diameter from f-number: D = f / N.
#must_use
fn lens_aperture_from_f_number(focal_length, f_num) {
    return f64_div(focal_length, f_num);
}

# Numerical aperture: NA = n * sin(half_angle).
#must_use
fn lens_numerical_aperture(n, half_angle) {
    return f64_mul(n, _prk_sin(half_angle));
}

# Paraxial NA from f-number: NA = 1 / (2*N).
#must_use
fn lens_na_from_f_number(f_num) {
    return f64_div(F64_ONE, f64_mul(F64_TWO, f_num));
}

# Rayleigh diffraction limit: theta = 1.22*lambda / D.
#must_use
fn lens_diffraction_limit(wavelength, aperture_diameter) {
    return f64_div(f64_mul(_lens_r(122, 100), wavelength), aperture_diameter);
}

# Airy disk radius: r = 1.22*lambda*N.
#must_use
fn lens_airy_disk_radius(wavelength, f_num) {
    return f64_mul(f64_mul(_lens_r(122, 100), wavelength), f_num);
}

# ── Field of View ────────

# Full-angle field of view: FOV = 2*atan(sensor / (2*f)).
#must_use
fn lens_field_of_view(sensor_size, focal_length) {
    return f64_mul(F64_TWO,
      ganita_f64_atan2(f64_div(sensor_size, f64_mul(F64_TWO, focal_length)), F64_ONE));
}

# Diagonal field of view from sensor width/height.
#must_use
fn lens_field_of_view_diagonal(width, height, focal_length) {
    return lens_field_of_view(ganita_f64_hypot(width, height), focal_length);
}

# ── MTF ────────

# Literal, not a division: this ran `f64_div(F64_TWO, F64_PI)` on EVERY call, and it is read
# from guard tests in hot paths. 0x3FE45F306DC9C883 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _lens_two_over_pi() { return 0x3FE45F306DC9C883; }

# Diffraction-limited cutoff frequency: 1 / (lambda * N).
#must_use
fn lens_mtf_cutoff_frequency(wavelength, f_num) {
    return f64_div(F64_ONE, f64_mul(wavelength, f_num));
}

# Diffraction-limited MTF: (2/pi)*(acos(v) - v*sqrt(1-v^2)), v = |freq/cutoff|.
# 0 at and above cutoff (|v| >= 1), 1 at zero.
#must_use
fn lens_mtf_diffraction_limited(spatial_freq, cutoff_freq) {
    # |v|: the MTF is even in frequency (the OTF of a real PSF is Hermitian). 2.15.1: v < 0 read
    # as v = 0 and answered 1 at every negative frequency.
    var v = f64_abs(f64_div(spatial_freq, cutoff_freq));
    if (f64_ge(v, F64_ONE) == 1) {
        return f64_from(0);
    }
    if (f64_le(v, f64_from(0)) == 1) {
        return F64_ONE;
    }
    return f64_mul(_lens_two_over_pi(),
      f64_sub(ganita_f64_acos(v), f64_mul(v, f64_sqrt(f64_sub(F64_ONE, f64_mul(v, v))))));
}

# Polychromatic MTF: weighted mean of monochromatic MTFs. wavelengths/weights are
# f64 buffers; missing weights (i >= n_weights) default to 1.0.
# NaN for a null buffer with a nonzero count, or no weight at all (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn lens_mtf_polychromatic(wavelengths, n_wl, weights, n_weights, f_num, spatial_freq) {
    if (n_wl > 0) {
        if (wavelengths == 0) { return _PRK_NAN; }
    }
    if (n_weights > 0) {
        if (weights == 0) { return _PRK_NAN; }
    }
    var sum_w = f64_from(0);
    var sum_mtf = f64_from(0);
    for (var i = 0; i < n_wl; i = i + 1) {
        var w = F64_ONE;
        if (i < n_weights) {
            w = load64(weights + i * 8);
        }
        var cutoff = lens_mtf_cutoff_frequency(load64(wavelengths + i * 8), f_num);
        sum_mtf = f64_add(sum_mtf, f64_mul(w, lens_mtf_diffraction_limited(spatial_freq, cutoff)));
        sum_w = f64_add(sum_w, w);
    }
    if (f64_lt(sum_w, _lens_eps15()) == 1) {
        return _PRK_NAN;
    }
    return f64_div(sum_mtf, sum_w);
}

# Through-focus MTF: writes (defocus, mtf) pairs to out+i*16, the defocus a longitudinal shift of
# the image plane in the wavelength's unit. A shift dz is the pupil wavefront W020 rho^2 with
# W020 = dz/(8 N^2) (dz NA^2/2 at NA = 1/(2N); Hopkins 1955), and the MTF is the modulus of that
# pupil's OTF by autocorrelation: lens_mtf_seidel with the defocus as w220, which at the field
# edge (H = 1) is exactly W020 rho^2, at 64 nodes or more. NaN where the defocus is too large to
# resolve at 256 nodes (a bound of 32 waves) or an input is invalid; the sign of dz does not
# change the MTF.
# ⛔ 2.15.1: this was the in-focus MTF times |sinc(pi W020 v)|, W020 in waves, which is not the
# defocused OTF at any defocus: at f/2.8, 550 nm and 200 cycles/mm it read 0.606 at dz = 10 um,
# where the pupil gives 0.452, and 0.582 at 20 um, where it gives 0.132; past the first zero (OTF
# < 0, a contrast reversal) it could not go at all. It now agrees with a separate quadrature of
# the defocused OTF, one dimension in closed form, to 1e-12.
fn lens_mtf_through_focus(wavelength, f_num, spatial_freq, defocus_range, n_defocus, out) {
    if (n_defocus > 0) {
        if (defocus_range == 0) { return 0; }
        if (out == 0) { return 0; }
    }
    var cutoff = lens_mtf_cutoff_frequency(wavelength, f_num);
    var v = f64_div(spatial_freq, cutoff);
    var w8n2 = f64_mul(f64_mul(f64_from(8), f_num), f_num);
    # A WavefrontCoefficients on the stack, defocus only.
    var wc[40];
    for (var k = 0; k < 40; k = k + 8) { store64(&wc + k, 0); }
    for (var i = 0; i < n_defocus; i = i + 1) {
        var defocus = load64(defocus_range + i * 8);
        WavefrontCoefficients_set_w220(&wc, f64_div(defocus, w8n2));
        store64(out + i * 16, defocus);
        store64(out + i * 16 + 8, lens_mtf_seidel(&wc, wavelength, v, 0, 64));
    }
    return 0;
}

# ── Seidel Aberrations ────────

# Shape factor: q = (R2 + R1) / (R2 - R1); 0 for equal radii.
#must_use
fn lens_shape_factor(r1, r2) {
    var denom = f64_sub(r2, r1);
    if (f64_lt(f64_abs(denom), _lens_eps15()) == 1) {
        return f64_from(0);
    }
    return f64_div(f64_add(r2, r1), denom);
}

# Conjugate (position) factor: p = (di - do) / (di + do); 0 if sum ~ 0.
#must_use
fn lens_conjugate_factor(object_distance, image_distance) {
    var sum = f64_add(image_distance, object_distance);
    if (f64_lt(f64_abs(sum), _lens_eps15()) == 1) {
        return f64_from(0);
    }
    return f64_div(f64_sub(image_distance, object_distance), sum);
}

#derive(accessors)
struct SeidelCoefficients { spherical; coma; astigmatism; field_curvature; distortion; }

# Third-order Seidel aberration coefficients for a thin lens in air, stop at
# the lens, normalised to Welford's sums: spherical = S_I / h^4,
# coma = -S_II / (h^2 H), astigmatism = S_III / H^2, field_curvature =
# S_IV / H^2, distortion = S_V = 0 (h = marginal ray height, H = Lagrange
# invariant). Transverse and wavefront forms follow from these — see
# docs/architecture/math.md.
#must_use
fn lens_seidel_coefficients(n, focal_length, q, p) {
    _prk_trace("seidel_coefficients");
    var phi = f64_div(F64_ONE, focal_length);
    var nm1 = f64_sub(n, F64_ONE);
    # phi^3 / 4: Welford's S_I = (h^4 K^3 / 4) * [bracket], per unit h^4.
    # ⛔ 2.5.0: THIS PREFACTOR WAS phi^3 * n/(4(n-1)^2) FROM THE PORT THROUGH 2.4.9,
    # so `spherical` came out n/(n-1)^2 too large: 6.0x at n = 1.5, 4.44x at 1.6,
    # 2.81x at 1.8. The bracket below is already Welford's own; only the
    # multiplier was wrong. Every audit since 2.2.6 checked the bracket through its
    # ARGMIN over q, and an argmin cannot see a positive q-independent factor, so
    # four repairs of the bracket all passed straight over it. Measured against
    # this library's own ray trace (equiconvex singlet, t = 1, object at
    # infinity), code/traced S_I/h^4 was 6.028 / 6.014 / 6.007 at R = 100 / 200 /
    # 400 — converging on n/(n-1)^2 = 6 as the lens thins. It is now 1.005 /
    # 1.002 / 1.001; the residual is lens thickness, which third-order thin-lens
    # theory leaves out. The pin is the traced one in tests/lens.tcyr.
    var term2 = f64_div(_lens_pow3(phi), f64_from(4));
    # ⚠ 2.2.6 DELIBERATELY DIVERGES FROM THE RUST ORIGINAL. The Rust bracket
    # (rust-old/src/lens.rs:464-468) had only THREE terms and scaled the p^2 one
    # inconsistently, so the quadratic in q had a positive discriminant and
    # crossed zero: third-order spherical came out NEGATIVE for every ordinary
    # positive singlet. A positive singlet in air is always UNDERCORRECTED — the
    # coefficient has a minimum but never changes sign — so the old output was
    # not merely inaccurate, it reported the wrong aberration direction.
    # Measured minimum over q in [-4, 4] at p = -1:
    #   n     Rust min    2.2.6 min
    #   1.5   -7.353      +3.813 (at q = 1.43)
    #   1.6   -5.267      +3.544
    #   1.7   -3.694      +3.457 (at q = 1.46)
    #   1.8   -2.440      +3.444
    # The bracket is the standard Coddington form
    #   (n+2)q^2 + 4(n+1)pq + (3n+2)(n-1)p^2 + n^3/(n-1)
    # divided term-wise by n(n-1) to sit under this function's existing
    # phi^3 * n/(4(n-1)^2) prefactor (itself wrong — see 2.5.0 above; the
    # divided bracket is Welford's, and phi^3/4 is its multiplier). Two changes
    # fall out: the p^2 term loses its extra (n-1), and the constant
    # n^2/(n-1)^2 — absent entirely — comes back.
    # ⚠ 2.2.6'S CROSS-CHECK WAS SELF-REFERENTIAL and is replaced. It compared the
    # argmin against q = 2(n+1)/(n+2) — derived from the same bracket it was
    # validating — so it agreed by construction, and that is how the q^2 term
    # below kept a wrong factor of (n-1) through an audit. The INDEPENDENT check
    # is the textbook best-form singlet at p = -1, argmin q = 2(n^2-1)/(n+2):
    # 0.7143 at n = 1.5, 0.8667 at 1.6, 1.0216 at 1.7 — measured 0.71 / 0.87 /
    # 1.02 on a 0.01 scan. Its companion is the aplanatic (coma-free) shape at
    # q = 0.80 for n = 1.5, which the coma bracket further down now reproduces.
    # A = (n+2)/(n*(n-1)^2) * q * q
    # ⚠ 2.2.8: 2.2.6 fixed the p^2 term and restored the missing constant but
    # left THIS one a factor of (n-1) too large — three of the four terms follow
    # the stated "standard bracket divided term-wise by n(n-1)" scheme and this
    # one did not. The standard Coddington q^2 coefficient is (n+2)/(n-1), not
    # (n+2), so dividing by n(n-1) gives (n+2)/(n(n-1)^2).
    # ⚠ WHY 2.2.6 MISSED IT: its cross-check was SELF-REFERENTIAL. It compared
    # the argmin against 2(n+1)/(n+2) — a value derived from the same wrong
    # bracket — and matched, of course. The independent result is the textbook
    # best-form singlet, argmin q = 2(n^2-1)/(n+2) = 0.7143 at n = 1.5, and the
    # shipped code put it at 1.4286. The sign flip 2.2.6 claimed to have closed
    # also still occurred for |p| > 1.32.
    var sa = f64_mul(f64_mul(f64_div(f64_add(n, F64_TWO), f64_mul(n, _lens_pow2(nm1))), q), q);
    # B = (3n+2)/n * p * p
    var sb = f64_mul(
      f64_mul(f64_div(f64_add(f64_mul(f64_from(3), n), F64_TWO), n), p), p);
    # C = 4*(n+1)/(n*(n-1)) * q * p
    var sc = f64_mul(
      f64_mul(f64_div(f64_mul(f64_from(4), f64_add(n, F64_ONE)), f64_mul(n, nm1)), q), p);
    # D = n^2/(n-1)^2 — the conjugate-independent floor that keeps the
    # coefficient positive. Its absence is what let the sign flip.
    # n^2/(n-1)^2, folded as (n/(n-1))^2. ⚠ THE TWO FORMS ARE NOT BIT-EQUAL:
    # over n = 1.0..4.0 in 0.1 steps they differ in 13 of 30 samples, because
    # the folded form rounds twice (divide, square) where the literal form
    # rounds three times (square, square, divide). The folded one is therefore
    # the marginally more accurate of the two, and the difference is ~1 ULP on a
    # term that is then summed with three larger ones.
    # ⚠ COST IS REAL AND IS NOT RECOVERED BY THIS FOLD. Measured same-binary,
    # 1e6 iterations, full struct-returning function both sides:
    #   2.2.5 (3-term bracket, wrong sign)   75 ns
    #   2.2.6 literal n^2/(n-1)^2           107 ns   (+43%)
    #   2.2.6 folded (this)                 103 ns   (+37%)
    # The bracket is division-dominated, and correctness needs one more
    # division. Precomputing 1/(n(n-1)) once and multiplying through would
    # recover more, but reciprocal-multiply is not divide: it would move every
    # published Seidel value, which a correctness release should not do.
    var nr = f64_div(n, nm1);
    var sd = f64_mul(nr, nr);
    var spherical = f64_mul(term2, f64_add(f64_add(f64_add(sa, sb), sc), sd));
    # phi^2 / 2: Welford's S_II = -(h^2 K^2 H / 2) * [bracket]. `coma` is
    # (phi^2/2) * [bracket], i.e. -S_II/(h^2 H) — the sign convention this
    # function has always had, stated here because it is not self-evident.
    # What it means physically, measured by trace with the stop at the lens:
    # tangential coma (marginal-pair centroid minus chief, along the image
    # height) = -(3/2) * coma * h^2 * theta * f. So coma < 0 is a flare pointing
    # AWAY from the axis — the ordinary "positive coma" of a biconvex singlet.
    # ⛔ 2.5.0: THIS WAS 1/(2(n-1)) THROUGH 2.4.9, and the 2.2.8 note below
    # called that "a consistent normalisation". It was not: it made coma 1/(n-1)
    # too large (2.0x at n = 1.5, 1.67x at 1.6, 1.25x at 1.8). The aplanatic
    # zero at q = 0.80 is invariant under any positive factor, so the 2.2.8 pin
    # that confirmed the bracket could not see it. Traced/formula |ratio| was
    # 2.032 / 2.016 / 2.008 at R = 100 / 200 / 400; it is now 1.016 / 1.008 /
    # 1.004.
    var cterm2 = F64_HALF;
    # ⚠ 2.2.8: BOTH COMA COEFFICIENTS WERE WRONG, and they sat directly beside
    # the spherical bracket that 2.2.6 audited without looking at them.
    # The thin-lens Coddington coma bracket is (n+1)/(n(n-1)) q + (2n+1)/n p;
    # the code had 2(n+1) and (3n+1). Consequence: coma crossed zero at q = 0.55
    # where the true aplanatic singlet is q = 0.80 at n = 1.5 — so the function
    # reported ZERO coma for a shape with substantial real coma, and placed the
    # coma-free shape on the wrong side of the spherical minimum, inverting the
    # standard design conclusion. (2.2.8 left cterm2 = 1/(2(n-1)) alone as "a
    # consistent normalisation"; it was wrong by 1/(n-1) — see 2.5.0 above.)
    # D = (n+1)/(n*(n-1)) * q
    var cd = f64_mul(f64_div(f64_add(n, F64_ONE), f64_mul(n, nm1)), q);
    # E = (2n+1)/n * p
    var ce = f64_mul(f64_div(f64_add(f64_mul(F64_TWO, n), F64_ONE), n), p);
    var coma = f64_mul(f64_mul(_lens_pow2(phi), cterm2), f64_add(cd, ce));
    var out = alloc(sizeof(SeidelCoefficients));
    if (out == 0) { return 0; }
    SeidelCoefficients_set_spherical(out, spherical);
    SeidelCoefficients_set_coma(out, coma);
    SeidelCoefficients_set_astigmatism(out, phi);
    SeidelCoefficients_set_field_curvature(out, f64_div(phi, n));
    SeidelCoefficients_set_distortion(out, f64_from(0));
    return out;
}

# Longitudinal spherical aberration for a marginal ray at ray_height, for the
# equiconvex singlet with the object at infinity — q = 0, p = -1, as the Rust
# original's comment stated (`rust-old/src/lens.rs:502`). A length, in the unit
# of focal_length: z_paraxial - z_marginal, positive for an undercorrected lens
# (marginal focus nearer the lens). Third-order: h^2 B / (8 f).
# ⛔ 2.4.6: THIS FUNCTION EVALUATES THE SAME BRACKET AS lens_seidel_coefficients
# ABOVE, AND IT STILL CARRIED BOTH HALVES OF THE DEFECT 2.2.6 REPAIRED THERE.
# `inner` read `(3n+2)(n-1)/n`: the p^2 term with the extra (n-1) that 2.2.6
# removed, and no `n^2/(n-1)^2` constant at all — the very term 2.2.6's note calls
# "absent entirely". 2.2.6 and 2.2.8 both audited the bracket thirty lines up and
# neither looked here. Measured cost: the bracket came out **6.15x too small at
# n = 1.5**, 4.46x at 1.6, 3.45x at 1.7, 2.79x at 1.8.
# ⚠ The suite could not see it. Its only assertion was "LSA increases with ray
# height", which holds for ANY positive bracket — inherited from the Rust test of
# the same name. The pin that finds it is the one now in tests/lens.tcyr: this
# function's s1 MUST equal lens_seidel_coefficients(n, f, 0, -1).spherical,
# because that is the same quantity. Keep the two expressions in step.
# ⛔ 2.5.0: AND THEN IT RETURNED h^2 * s1 / (2 phi), WHICH IS NOT A LENGTH.
# Longitudinal SA is S_I / (2 u'^2) with u' = h phi the marginal ray's image-
# space slope, so per unit h^4 it is h^2 * s1 / (2 phi^2) = h^2 B / (8 f). The
# old divisor dropped one phi, making the result scale as 1/f^2 instead of 1/f,
# and it sat on top of the n/(n-1)^2 prefactor error fixed above. Net: 16.7x too
# small at f = 100, 33x at f = 200, 67x at f = 400 (n = 1.5) — the factor
# f(n-1)^2/n. 2.4.6 computed that gap against the textbook h^2 B/(8f), and set
# it aside as a normalisation convention; its value pin was derived from this
# expression and so agreed with it. The pin is now the traced z_paraxial -
# z_marginal in tests/lens.tcyr: 0.016562 at R = 100 (h = 1) against 0.016639
# here, the gap being lens thickness, shrinking to 0.12% at R = 400.
#must_use
fn lens_longitudinal_spherical_aberration(ray_height, focal_length, n) {
    var phi = f64_div(F64_ONE, focal_length);
    var nm1 = f64_sub(n, F64_ONE);
    # B + D of the Seidel bracket at q = 0, p = -1, written exactly as they are
    # written there (the folded n/(n-1) square included) so the two agree.
    var nr = f64_div(n, nm1);
    var inner = f64_add(
      f64_div(f64_add(f64_mul(f64_from(3), n), F64_TWO), n),
      f64_mul(nr, nr));
    var s1 = f64_mul(f64_div(_lens_pow3(phi), f64_from(4)), inner);
    return f64_div(f64_mul(f64_mul(ray_height, ray_height), s1),
      f64_mul(F64_TWO, f64_mul(phi, phi)));
}

# Longitudinal (axial) chromatic aberration: LCA = f / V.
#must_use
fn lens_chromatic_aberration(focal_length, abbe_v) {
    return f64_div(focal_length, abbe_v);
}

# Petzval sum S = sum 1/(n_i*f_i). elements is an interleaved (n, f) buffer.
# NaN for a null buffer with a nonzero count (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn lens_petzval_sum(elements, n_elements) {
    if (n_elements > 0) {
        if (elements == 0) { return _PRK_NAN; }
    }
    var sum = f64_from(0);
    for (var i = 0; i < n_elements; i = i + 1) {
        sum = f64_add(sum,
          f64_div(F64_ONE, f64_mul(load64(elements + i * 16), load64(elements + i * 16 + 8))));
    }
    return sum;
}

# Petzval radius R_p = -1/S. Returns 1 and writes R_p to out if S != 0, else 0
# (flat field, Rust None), writing nothing. A curved field with a null out returns
# PK_ERR_INVALID_PARAMETER (2.15.1: it was written through).
fn lens_petzval_radius(petzval_sum, out) {
    if (f64_lt(f64_abs(petzval_sum), _lens_eps15()) == 1) {
        return 0;
    }
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    store64(out, f64_div(f64_neg(F64_ONE), petzval_sum));
    return 1;
}

# ── Multi-element System ────────

# Two separated thin lenses: 1/f = 1/f1 + 1/f2 - d/(f1*f2).
#must_use
fn lens_separated_focal_length(f1, f2, separation, err_out) {
    store64(err_out, PK_ERR_NONE);
    var power = f64_sub(
      f64_add(f64_div(F64_ONE, f1), f64_div(F64_ONE, f2)),
      f64_div(separation, f64_mul(f1, f2)));
    if (f64_lt(f64_abs(power), _lens_eps15()) == 1) {
        store64(err_out, PK_ERR_DIVISION_BY_ZERO);
        return f64_from(0);
    }
    return f64_div(F64_ONE, power);
}

# Back focal distance of a two-lens system: BFD = f*(1 - d/f1).
#must_use
fn lens_separated_bfd(f1, f2, separation, err_out) {
    var f = lens_separated_focal_length(f1, f2, separation, err_out);
    if (prakash_is_err(load64(err_out)) == 1) {
        return f64_from(0);
    }
    return f64_mul(f, f64_sub(F64_ONE, f64_div(separation, f1)));
}

# System magnification = product of individual magnifications (empty = 1).
# NaN for a null buffer with a nonzero count (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn lens_system_magnification(magnifications, n) {
    if (n > 0) {
        if (magnifications == 0) { return _PRK_NAN; }
    }
    var prod = F64_ONE;
    for (var i = 0; i < n; i = i + 1) {
        prod = f64_mul(prod, load64(magnifications + i * 8));
    }
    return prod;
}

# ── Wavefront aberration and the aberrated OTF (2.7.0) ────────
#
# SIGN: W here is optical_path_difference's — the ray's optical path minus the
# chief ray's, to the chief ray's image point — and H is taken POSITIVE, H = h*theta,
# for a field point on +y. Welford's W has the opposite overall sign, and his
# H = n'u'eta' is NEGATIVE for an image on +y (u' < 0), so relative to Welford the
# terms EVEN in H flip (W040 = -S_I/8, W222, W220) and the terms ODD in H keep
# his sign (W131 = +S_II/2, W311 = +S_V/2). ⛔ 2.7.0 review: the first cut flipped
# all five, and W131 came out with the wrong sign against the traced OPD — a
# mistake that an OTF phase conjugated the other way hid end to end. Each term is
# now pinned to the traced OPD fan of a real singlet (tests/lens_otf.tcyr).
# FIELD AND PUPIL: the field point lies on +y, and the pupil coordinates (x, y)
# are normalised to the pupil radius, so the Seidel wavefront at the field edge is
#   W(x, y) = W040*r^4 + W131*y*r^2 + W222*y^2 + W220*r^2 + W311*y,  r^2 = x^2 + y^2
# (Welford's rho^4, rho^3 cos(theta), rho^2 cos^2(theta), rho^2, rho cos(theta) with
# theta from the y axis). y-z is the tangential plane.

#derive(accessors)
struct WavefrontCoefficients { w040; w131; w222; w220; w311; }

# Wavefront aberration coefficients (lengths, at the pupil and field edge) of a
# SeidelCoefficients at marginal ray height h and Lagrange invariant H — for an
# object at infinity with the stop at the lens, H = h*theta, theta the field angle
# in radians. With S_I = spherical*h^4, S_II = -coma*h^2*H, S_III = astigmatism*H^2,
# S_IV = field_curvature*H^2 and S_V = distortion (stored as S_V itself; 0 for a
# thin lens with the stop at the lens):
#   W040 = -S_I/8, W131 = +S_II/2, W222 = -S_III/2, W220 = -(S_III + S_IV)/4,
#   W311 = +S_V/2
# (Welford's relations in this convention: see above). W220 carries the sagittal field
# curvature (S_III + S_IV), and W222 + W220 the tangential (3 S_III + S_IV)/4.
# Returns 0 for a null seidel or on allocation failure.
#must_use
fn lens_wavefront_coefficients(seidel, ray_height, lagrange_invariant) {
    if (seidel == 0) { return 0; }
    var h2 = f64_mul(ray_height, ray_height);
    var hh2 = f64_mul(lagrange_invariant, lagrange_invariant);
    var s1 = f64_mul(SeidelCoefficients_spherical(seidel), f64_mul(h2, h2));
    var s2 = f64_neg(f64_mul(f64_mul(SeidelCoefficients_coma(seidel), h2), lagrange_invariant));
    var s3 = f64_mul(SeidelCoefficients_astigmatism(seidel), hh2);
    var s4 = f64_mul(SeidelCoefficients_field_curvature(seidel), hh2);
    var s5 = SeidelCoefficients_distortion(seidel);
    var wc = alloc(sizeof(WavefrontCoefficients));
    if (wc == 0) { return 0; }
    WavefrontCoefficients_set_w040(wc, f64_neg(f64_div(s1, f64_from(8))));
    WavefrontCoefficients_set_w131(wc, f64_div(s2, F64_TWO));
    WavefrontCoefficients_set_w222(wc, f64_neg(f64_div(s3, F64_TWO)));
    WavefrontCoefficients_set_w220(wc, f64_neg(f64_div(f64_add(s3, s4), f64_from(4))));
    WavefrontCoefficients_set_w311(wc, f64_div(s5, F64_TWO));
    return wc;
}

# Seidel wavefront W(x, y) at the field edge (see the section header).
fn _lens_seidel_w(wc, x, y) {
    var r2 = f64_add(f64_mul(x, x), f64_mul(y, y));
    var w = f64_mul(WavefrontCoefficients_w040(wc), f64_mul(r2, r2));
    w = f64_add(w, f64_mul(WavefrontCoefficients_w131(wc), f64_mul(y, r2)));
    w = f64_add(w, f64_mul(WavefrontCoefficients_w222(wc), f64_mul(y, y)));
    w = f64_add(w, f64_mul(WavefrontCoefficients_w220(wc), r2));
    return f64_add(w, f64_mul(WavefrontCoefficients_w311(wc), y));
}

# W at pupil point (x, y) for a wavefront of the given kind: 0 none (a perfect
# lens), 1 a ZernikeWavefront (Noll, theta from +x), 2 WavefrontCoefficients.
fn _lens_w_at(kind, wf, x, y) {
    if (kind == 1) {
        var rho = f64_sqrt(f64_add(f64_mul(x, x), f64_mul(y, y)));
        return zernike_wf_evaluate(wf, rho, ganita_f64_atan2(y, x));
    }
    if (kind == 2) { return _lens_seidel_w(wf, x, y); }
    return 0;
}

# Gauss-Legendre nodes and weights on [-1, 1] for n points, into caller buffers
# (Newton on P_n from the Chebyshev-like first guess cos(pi*(i + 0.75)/(n + 0.5))).
fn _lens_gauss(n, xs, ws) {
    var m = (n + 1) / 2;
    var nf = f64_from(n);
    for (var i = 0; i < m; i = i + 1) {
        var z = _prk_cos(f64_div(f64_mul(F64_PI, f64_add(f64_from(i), _lens_r(3, 4))), f64_add(nf, F64_HALF)));
        var pp = F64_ONE;
        for (var it = 0; it < 100; it = it + 1) {
            var p1 = F64_ONE;
            var p2 = 0;
            for (var j = 1; j <= n; j = j + 1) {
                var p3 = p2;
                p2 = p1;
                var jf = f64_from(j);
                p1 = f64_div(f64_sub(f64_mul(f64_mul(f64_from(2 * j - 1), z), p2), f64_mul(f64_from(j - 1), p3)), jf);
            }
            pp = f64_div(f64_mul(nf, f64_sub(f64_mul(z, p1), p2)), f64_sub(f64_mul(z, z), F64_ONE));
            var z1 = z;
            z = f64_sub(z1, f64_div(p1, pp));
            if (f64_lt(f64_abs(f64_sub(z, z1)), 0x3CB0000000000000) == 1) { break; }   # 2^-52
        }
        var wgt = f64_div(F64_TWO, f64_mul(f64_sub(F64_ONE, f64_mul(z, z)), f64_mul(pp, pp)));
        store64(xs + i * 8, f64_neg(z));
        store64(xs + (n - 1 - i) * 8, z);
        store64(ws + i * 8, wgt);
        store64(ws + (n - 1 - i) * 8, wgt);
    }
    return 0;
}

# The OTF at normalised frequency v = nu/nu_cutoff (0..1, nu_cutoff = 1/(lambda*N))
# of a unit circular pupil carrying wavefront W, by direct autocorrelation of the
# generalised pupil function P = exp(i*k*W):
#   OTF(v) = (1/pi) * integral over the overlap of exp(i*k*[W(a - v) - W(a + v)]),
# the two copies of the pupil shifted by -+v along the frequency direction. That is
# the STANDARD OTF (Goodman eq. 6-25, ISO 9334), the Fourier transform with kernel
# e^(-2*pi*i*nu*x) of the PSF |FT{P}|^2 that psf_from_wavefront forms: a tilt that
# moves the PSF by +d gives phase -2*pi*nu*d. ⛔ 2.7.0 review: the first cut used
# Goodman's eq. 6-31 form W(a + v) - W(a - v), which drops a sign in H(f) = P(-lzf)
# and returned the CONJUGATE (FFT of the PSF: 0.17666 - 0.46963i; it gave +0.46785i).
# The overlap is integrated exactly — y = Y*sin(t), Y = sqrt(1 - v^2), then x across
# the chord — with n-point Gauss-Legendre in each, converging EXPONENTIALLY in n
# once n resolves the phase: measured ~1e-12 with n >= 8 nodes per wave of
# max|W(a - v) - W(a + v)| (64 to 8 waves, 128 to ~20, 256 to 32 and more) and
# v >= 0.02; smaller v wants 128. The public entries raise n to that (_lens_n_for).
fn _lens_otf(kind, wf, k, v, direction, n, re_out, im_out) {
    var gx[2048];
    var gw[2048];
    _lens_gauss(n, &gx, &gw);
    var yy = f64_sqrt(f64_sub(F64_ONE, f64_mul(v, v)));
    var sr = 0;
    var si = 0;
    for (var i = 0; i < n; i = i + 1) {
        var t = f64_mul(load64(&gx + i * 8), F64_PI_2);
        var ct = _prk_cos(t);
        var st = _prk_sin(t);
        var y = f64_mul(yy, st);
        var xh = f64_sub(f64_sqrt(f64_add(f64_mul(ct, ct), f64_mul(f64_mul(v, v), f64_mul(st, st)))), v);
        var rr = 0;
        var ri = 0;
        for (var j = 0; j < n; j = j + 1) {
            var x = f64_mul(xh, load64(&gx + j * 8));
            var wa = 0;
            var wb = 0;
            if (direction == 1) {
                wa = _lens_w_at(kind, wf, y, f64_add(x, v));
                wb = _lens_w_at(kind, wf, y, f64_sub(x, v));
            } else {
                wa = _lens_w_at(kind, wf, f64_add(x, v), y);
                wb = _lens_w_at(kind, wf, f64_sub(x, v), y);
            }
            var ph = f64_mul(k, f64_sub(wb, wa));
            var wj = load64(&gw + j * 8);
            rr = f64_add(rr, f64_mul(wj, _prk_cos(ph)));
            ri = f64_add(ri, f64_mul(wj, _prk_sin(ph)));
        }
        # dy = Y*cos(t)*(pi/2) ds, dx = xh du; the 1/pi and pi/2 leave 1/2.
        var jac = f64_mul(f64_mul(load64(&gw + i * 8), f64_mul(yy, ct)), f64_mul(xh, F64_HALF));
        sr = f64_add(sr, f64_mul(jac, rr));
        si = f64_add(si, f64_mul(jac, ri));
    }
    store64(re_out, sr);
    store64(im_out, si);
    return PK_ERR_NONE;
}

# A bound on max|W(a - v) - W(a + v)| over the overlap, in W's length unit: the
# smaller of the peak-to-valley bound and 2v times a gradient bound. Seidel: over
# the unit disk r^4 and r^2, y^2 span [0, 1] and y*r^2, y span [-1, 1]; their
# gradients are at most 4, 2, 2, 3, 1. Zernike: each Noll-normalised Z_n^m spans at
# most +-sqrt(n+1) (m = 0) or +-sqrt(2(n+1)). Conservative by design (about 2x on
# defocus): it only chooses a node count. NaN for a non-finite coefficient.
fn _lens_w_bound(kind, wf, v) {
    if (kind == 2) {
        var a0 = f64_abs(WavefrontCoefficients_w040(wf));
        var a1 = f64_abs(WavefrontCoefficients_w131(wf));
        var a2 = f64_abs(WavefrontCoefficients_w222(wf));
        var a3 = f64_abs(WavefrontCoefficients_w220(wf));
        var a4 = f64_abs(WavefrontCoefficients_w311(wf));
        var pv = f64_add(f64_add(f64_add(a0, f64_mul(F64_TWO, a1)), f64_add(a2, a3)), f64_mul(F64_TWO, a4));
        var g = f64_add(f64_add(f64_mul(f64_from(4), a0), f64_mul(f64_from(3), a1)),
          f64_add(f64_mul(F64_TWO, f64_add(a2, a3)), a4));
        var gb = f64_mul(f64_mul(F64_TWO, v), g);
        if (f64_lt(gb, pv) == 1) { return gb; }
        return pv;
    }
    if (kind == 1) {
        var coeffs = ZernikeWavefront_coeffs(wf);
        var len = ZernikeWavefront_len(wf);
        if (len > 0) {
            if (coeffs == 0) { return _PRK_NAN; }
        }
        var tot = 0;
        var zn = 0;
        var zm = 0;
        for (var j = 0; j < len; j = j + 1) {
            zernike_noll_to_nm(j + 1, &zn, &zm);
            var nm = f64_from(zn + 1);
            if (zm != 0) { nm = f64_mul(F64_TWO, nm); }
            tot = f64_add(tot, f64_mul(f64_mul(F64_TWO, f64_abs(load64(coeffs + j * 8))), f64_sqrt(nm)));
        }
        return tot;
    }
    return 0;
}

# The node count used: n raised to 8 per wave of the bound above (and to 128 below
# v = 0.02); -1 if that exceeds 256 or the bound is not finite. Past 256 no node
# count allowed here resolves the phase, and a result would be a plausible wrong
# number (2.7.0 review: an f/4 singlet's 18.5 waves of spherical came back at
# n = 64 as OTF(0.3) = -5.3e-3, true +3.1e-4, as success). The 256 cap is ALSO
# _lens_otf's node-buffer size (gx/gw, 2048 bytes): a mutant without this refusal
# overwrites the stack and SIGSEGVs.
fn _lens_n_for(kind, wf, wavelength, v, n) {
    var b = _lens_w_bound(kind, wf, v);
    if ((b & _PRK_ABS) >= 0x7FF0000000000000) { return 0 - 1; }
    var need = f64_mul(f64_from(8), f64_div(b, wavelength));
    if (f64_gt(need, f64_from(256)) == 1) { return 0 - 1; }
    var ni = f64_to(f64_ceil(need));
    if (ni > n) { n = ni; }
    if (f64_lt(v, _lens_r(2, 100)) == 1) {
        if (n < 128) { n = 128; }
    }
    return n;
}

fn _lens_otf_checked(kind, wf, wavelength, v, direction, n, re_out, im_out) {
    if ((n < 4) | (n > 256)) { return _lens_otf_fail(re_out, im_out); }
    if ((direction != 0) & (direction != 1)) { return _lens_otf_fail(re_out, im_out); }
    if (f64_gt(wavelength, 0) == 0) { return _lens_otf_fail(re_out, im_out); }
    if (wavelength == 0x7FF0000000000000) { return _lens_otf_fail(re_out, im_out); }
    if (f64_ge(v, 0) == 0) { return _lens_otf_fail(re_out, im_out); }   # also NaN
    if (f64_ge(v, F64_ONE) == 1) {                                       # past cutoff
        store64(re_out, 0);
        store64(im_out, 0);
        return PK_ERR_NONE;
    }
    var ne = _lens_n_for(kind, wf, wavelength, v, n);
    if (ne < 0) { return _lens_otf_fail(re_out, im_out); }
    return _lens_otf(kind, wf, f64_div(F64_TAU, wavelength), v, direction, ne, re_out, im_out);
}

fn _lens_otf_fail(re_out, im_out) {
    store64(re_out, 0);
    store64(im_out, 0);
    return PK_ERR_INVALID_PARAMETER;
}

# OTF of a circular pupil with a Zernike wavefront (ZernikeWavefront, coefficients
# in the same length unit as wavelength), at normalised frequency v in [0, 1] along
# x (direction 0) or y (direction 1). n (4..256) is the MINIMUM Gauss-Legendre nodes
# per axis: it is raised to resolve the wavefront (8 per wave of a bound on the
# phase difference; 128 below v = 0.02) — ~1e-12, see _lens_otf. Writes the
# standard (Goodman 6-25) Re/Im OTF; v >= 1 is 0. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER for a null output pointer (nothing written); for a null
# wavefront, a wavelength not finite and positive, v negative or NaN, a direction
# other than 0/1, n outside 4..256, or a wavefront too aberrated for 256 nodes
# (writing 0, 0).
fn lens_otf_zernike(wf, wavelength, v, direction, n, re_out, im_out) {
    if ((re_out == 0) | (im_out == 0)) { return PK_ERR_INVALID_PARAMETER; }
    if (wf == 0) { return _lens_otf_fail(re_out, im_out); }
    return _lens_otf_checked(1, wf, wavelength, v, direction, n, re_out, im_out);
}

# OTF of the Seidel wavefront of a WavefrontCoefficients (lens_wavefront_coefficients)
# at the field edge: direction 0 is along x, the SAGITTAL MTF for this field point on
# +y; direction 1 along y, the TANGENTIAL. Otherwise as lens_otf_zernike.
fn lens_otf_seidel(wc, wavelength, v, direction, n, re_out, im_out) {
    if ((re_out == 0) | (im_out == 0)) { return PK_ERR_INVALID_PARAMETER; }
    if (wc == 0) { return _lens_otf_fail(re_out, im_out); }
    return _lens_otf_checked(2, wc, wavelength, v, direction, n, re_out, im_out);
}

# |OTF| of lens_otf_zernike — the aberrated MTF. NaN on invalid input (0 is a
# legitimate MTF).
#must_use
fn lens_mtf_zernike(wf, wavelength, v, direction, n) {
    var re = 0;
    var im = 0;
    if (lens_otf_zernike(wf, wavelength, v, direction, n, &re, &im) != PK_ERR_NONE) { return _PRK_NAN; }
    return f64_sqrt(f64_add(f64_mul(re, re), f64_mul(im, im)));
}

# |OTF| of lens_otf_seidel. NaN on invalid input.
#must_use
fn lens_mtf_seidel(wc, wavelength, v, direction, n) {
    var re = 0;
    var im = 0;
    if (lens_otf_seidel(wc, wavelength, v, direction, n, &re, &im) != PK_ERR_NONE) { return _PRK_NAN; }
    return f64_sqrt(f64_add(f64_mul(re, re), f64_mul(im, im)));
}

# Polychromatic OTF at spatial frequency nu (cycles per unit length, the unit of
# wavelength) for an f-number N: the weighted sum of the COMPLEX monochromatic OTFs,
#   OTF(nu) = sum_i w_i*OTF_i(nu*lambda_i*N) / sum_i w_i,
# which is the OTF of the weighted sum of the PSFs. Unlike lens_mtf_polychromatic —
# a real weighted mean of diffraction-limited MTFs, correct only while every OTF is
# real and non-negative — it keeps each OTF's phase, so a band where some
# wavelengths' contrast reverses (OTF < 0) cancels against the rest instead of
# adding. The wavefront (kind as the monochromatic functions: wf a ZernikeWavefront
# or WavefrontCoefficients, selected by `seidel` = 0/1) is the same length at every
# wavelength, so its phase k*W scales as 1/lambda. wavelengths/weights are f64
# buffers of n_wl; missing weights (i >= n_weights) are 1. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER for a null output pointer (nothing written); for a null
# wavefront or buffer, `seidel` other than 0/1, n_wl < 1, N not finite and positive,
# nu not finite and >= 0, a non-finite weight, weights summing to <= 0, or any
# wavelength the monochromatic functions refuse (writing 0, 0).
fn lens_otf_polychromatic(wf, seidel, wavelengths, n_wl, weights, n_weights, f_num, spatial_freq,
  direction, n, re_out, im_out) {
    if ((re_out == 0) | (im_out == 0)) { return PK_ERR_INVALID_PARAMETER; }
    if (wf == 0) { return _lens_otf_fail(re_out, im_out); }
    if ((seidel != 0) & (seidel != 1)) { return _lens_otf_fail(re_out, im_out); }
    if (n_wl < 1) { return _lens_otf_fail(re_out, im_out); }
    if (wavelengths == 0) { return _lens_otf_fail(re_out, im_out); }
    if (n_weights > 0) {
        if (weights == 0) { return _lens_otf_fail(re_out, im_out); }
    }
    if (f64_gt(f_num, 0) == 0) { return _lens_otf_fail(re_out, im_out); }
    if (f_num == 0x7FF0000000000000) { return _lens_otf_fail(re_out, im_out); }
    if (f64_ge(spatial_freq, 0) == 0) { return _lens_otf_fail(re_out, im_out); }
    if (spatial_freq == 0x7FF0000000000000) { return _lens_otf_fail(re_out, im_out); }
    var kind = 1;
    if (seidel == 1) { kind = 2; }
    var sw = 0;
    var sr = 0;
    var si = 0;
    var re = 0;
    var im = 0;
    for (var i = 0; i < n_wl; i = i + 1) {
        var wl = load64(wavelengths + i * 8);
        var w = F64_ONE;
        if (i < n_weights) { w = load64(weights + i * 8); }
        if ((w & _PRK_ABS) >= 0x7FF0000000000000) { return _lens_otf_fail(re_out, im_out); }
        var v = f64_mul(f64_mul(spatial_freq, wl), f_num);
        if (_lens_otf_checked(kind, wf, wl, v, direction, n, &re, &im) != PK_ERR_NONE) {
            return _lens_otf_fail(re_out, im_out);
        }
        sr = f64_add(sr, f64_mul(w, re));
        si = f64_add(si, f64_mul(w, im));
        sw = f64_add(sw, w);
    }
    if (f64_gt(sw, 0) == 0) { return _lens_otf_fail(re_out, im_out); }
    store64(re_out, f64_div(sr, sw));
    store64(im_out, f64_div(si, sw));
    return PK_ERR_NONE;
}

# --- lens_aberration.cyr ---

# lens_aberration.cyr -- third- and fifth-order transverse aberration of a surface sequence:
# the Seidel sums and Buchdahl's fifth-order sums, surface by surface
# Usage: include "lib/lens_aberration.cyr"
#   (requires error.cyr, ray_core.cyr, ray_fresnel.cyr, ray_trace.cyr, ray_system.cyr)
#
# New in 2.14.0, and NOT a port: the Rust 1.x crate had only the thin-lens Seidel
# coefficients that lens.cyr still carries. This takes a Prescription and its paraxial
# marginal and chief rays and returns, for every surface and for the system, the third-order
# (Seidel) and fifth-order (Buchdahl) coefficients of the transverse ray aberration, each
# fifth-order term split into the part the surface makes on its own (intrinsic) and the part
# it makes from the aberration it is handed (induced).
#
# THE EXPANSION, in Rimmer's letters as J. Sasian gives them (OPTI 517, "Higher-order
# aberrations", the Buchdahl-Rimmer slide):
#   eps_y = B cos(phi) rho^3 + F (2 + cos 2phi) rho^2 H + (3C + PI) cos(phi) rho H^2 + E H^3
#         + B5 cos(phi) rho^5 + (F1 + F2 cos 2phi) rho^4 H
#         + (M1 + M2 + M3 cos^2 phi) cos(phi) rho^3 H^2 + (N1 + N2 cos^2 phi) rho^2 H^3
#         + (5 C5 + PI5) cos(phi) rho H^4 + E5 H^5
#   eps_x = B sin(phi) rho^3 + F sin(2phi) rho^2 H + (C + PI) sin(phi) rho H^2
#         + B5 sin(phi) rho^5 + F2 sin(2phi) rho^4 H + (M2 + M3 cos^2 phi) sin(phi) rho^3 H^2
#         + N3 sin(2phi) rho^2 H^3 + (C5 + PI5) sin(phi) rho H^4
# B, F, C, PI, E are spherical aberration, coma, astigmatism, Petzval and distortion. Of the
# fifth order, B5 is spherical, F1 and F2 coma, M1 to M3 oblique spherical, N1 to N3
# elliptical coma, C5 and PI5 astigmatism and Petzval, E5 distortion. There is no settled
# naming past these letters, so none is offered.
#
# COORDINATES — read these before comparing a value against another program:
# - A ray is rho_vec times the paraxial marginal ray plus H times the chief ray, as straight
#   lines in object space in (height, direction tangent). So at the paraxial entrance pupil
#   its height is rho_vec times the marginal ray's; at a finite object, H times the chief
#   ray's; for an object at infinity its direction tangent is H times the chief ray's slope.
# - rho_vec = (rho sin(phi), rho cos(phi)): phi runs from +y, the meridional direction, and
#   H runs along y, in the y of the rays passed in.
# - eps is where the ray meets the paraxial image plane, minus the paraxial image point
#   H ybar', in lens units. Every coefficient is the aberration at rho = H = 1, so it scales
#   with the rays passed in.
# - ⚠ THE SIGN OF A TERM ODD IN H (F, E; F1, F2, N1 to N3, E5) is the chief ray's: it turns
#   over with the chief ray, as the image point H ybar' does. So read it against the sign of
#   ybar' (AberrSums_image_height): with ybar' > 0, E < 0 is barrel distortion; with
#   ybar' < 0, barrel distortion is E > 0. The terms even in H do not depend on it.
# - u is the slope dy/dz, nu = n u, and refraction is nu' = nu - y phi, as ray_system.
#
# THE SEIDEL SUMS are Welford's per-surface forms, with A = n (u + y c), Abar likewise,
# H_L = y nubar - nu ybar (the Lagrange invariant) and Delta the change across the surface:
#   S_I = -A^2 y Delta(u/n)    S_II = -A Abar y Delta(u/n)    S_III = -Abar^2 y Delta(u/n)
#   S_IV = -H_L^2 c Delta(1/n)    S_V = (Abar/A)(S_III + S_IV)
# In this sign convention B = S_I/(2 n'u'), and F, C, PI, E likewise from S_II to S_V, with
# n'u' the marginal ray's reduced slope in image space. Each surface's S equals its own third
# order here exactly, not only in the total.
#
# HOW (Buchdahl's method). In the variables where moving between surfaces is exactly linear —
# the height on each surface's tangent plane and n times the direction tangent — a real ray's
# coordinates (A, B) against the paraxial marginal and chief rays, which Lagrange brackets
# give, are constant between surfaces and change only at a refraction. At the paraxial image
# plane the ray's height is B ybar', so eps is ybar' times the sum of those changes: a sum over
# surfaces, exactly. Each change is a function of the (A, B) the surface receives.
# - Its cubic part is the surface's Seidel term.
# - Its quintic part, at the object-space (rho, H), is the INTRINSIC fifth order.
# - The INDUCED fifth order is the cubic part's response to the third-order error already in
#   the incoming A and B: the pupil and image aberrations of every surface before it.
# The refraction is expanded in truncated series in the invariants A.A, A.B and B.B of the
# incoming ray, by series arithmetic on the exact ray-sphere intersection and Snell's law. No
# fifth-order formula is typed in.
#
# ⚠ THE SPLIT BETWEEN SURFACES depends on those variables, and another program's surface
# contributions may differ from these by terms that cancel in the total. The system totals do
# not depend on it: they are the expansion of a measured quantity in the coordinates above.
#
# MEASURED against a 100-digit real-ray trace (3D vector refraction, not this expansion) over
# seven systems:
# - a seven-surface triplet with a dummy stop;
# - a singlet behind a remote stop with a finite object;
# - a cemented doublet;
# - an object in water;
# - the same with a stop between two lenses;
# - an aplanatic surface;
# - a plate in a converging beam.
# Every surface's third order, intrinsic and induced fifth order, and every system total, is
# within 1.3e-15 (third order) and 1.2e-14 (fifth) of the largest surface term of its order. A
# small coefficient is a cancellation of large surface terms, and its relative error is larger
# by that ratio. An independent review's own 90-digit trace agreed over 13 systems.

var ABERR3_B  = 0;      # spherical aberration (S_I)
var ABERR3_F  = 1;      # coma (S_II)
var ABERR3_C  = 2;      # astigmatism (S_III)
var ABERR3_PI = 3;      # Petzval (S_IV)
var ABERR3_E  = 4;      # distortion (S_V)

var ABERR5_B5  = 0;
var ABERR5_F1  = 1;
var ABERR5_F2  = 2;
var ABERR5_M1  = 3;
var ABERR5_M2  = 4;
var ABERR5_M3  = 5;
var ABERR5_N1  = 6;
var ABERR5_N2  = 7;
var ABERR5_N3  = 8;
var ABERR5_C5  = 9;
var ABERR5_PI5 = 10;
var ABERR5_E5  = 11;

# aberr_fifth's part: intrinsic + induced, or one of them.
var ABERR_TOTAL     = 0;
var ABERR_INTRINSIC = 1;
var ABERR_INDUCED   = 2;

# The surface index that names the whole system.
var ABERR_SYSTEM = (0 - 1);

# A row is 29 f64: the third order (5), then the intrinsic (12) and induced (12) fifth order.
var _AB_ROW = 29;

# 2^-40. A paraxial slope or height that a cancellation leaves within this fraction of the terms
# it was formed from is a zero that rounding has not reached: the 2.14.0 review found a system
# afocal to 1 ulp answered with an image 2.9e17 away, and a stop 2 ulps short of a focus with a
# marginal ray 1.35e16 high.
var _AB_NOISE = 0x3D70000000000000;

# The result of aberr_sums. count surfaces; lagrange = y nubar - nu ybar; image_height = ybar'
# and image_distance = the paraxial image plane's distance past the last vertex; image_nu =
# n'u' of the marginal ray there; rows = count + 1 rows of _AB_ROW f64, the last the system.
#derive(accessors)
struct AberrSums { count; lagrange; image_height; image_distance; image_nu; rows; }

# ── Truncated series ────────
# A series is 10 f64 (80 bytes): the coefficients of 1, a, b, c, a^2, ab, ac, b^2, bc, c^2 in
# the invariants a = A.A, b = A.B, c = B.B. Times A or B, its linear part is of third order in
# the ray and its quadratic part of fifth; products drop the rest. Every function here may
# write its result over an operand.

# 1 if x is finite (not NaN, not +-inf).
fn _ab_finite(x) {
    if ((x & _PRK_ABS) >= _PRK_INF) { return 0; }
    return 1;
}

# x, with -0 made +0: a coefficient that is zero is reported as +0, whatever sign scaled it.
fn _ab_pz(x) {
    if ((x & _PRK_ABS) == 0) { return 0; }
    return x;
}

# x = the constant k.
fn _abt_const(x, k) {
    store64(x, k);
    for (var i = 1; i < 10; i = i + 1) { store64(x + i * 8, 0); }
    return 0;
}

# x = la a + lb b + lc c.
fn _abt_lin(x, la, lb, lc) {
    _abt_const(x, 0);
    store64(x + 8, la);
    store64(x + 16, lb);
    store64(x + 24, lc);
    return 0;
}

# z = kx x + ky y.
fn _abt_comb(z, x, kx, y, ky) {
    for (var i = 0; i < 10; i = i + 1) {
        store64(z + i * 8, f64_add(f64_mul(kx, load64(x + i * 8)), f64_mul(ky, load64(y + i * 8))));
    }
    return 0;
}

# z = x + y.
fn _abt_add(z, x, y) { return _abt_comb(z, x, F64_ONE, y, F64_ONE); }

# z = x - y.
fn _abt_sub(z, x, y) { return _abt_comb(z, x, F64_ONE, y, f64_neg(F64_ONE)); }

# x's linear part alone.
fn _abt_lin_of(z, x) { return _abt_lin(z, load64(x + 8), load64(x + 16), load64(x + 24)); }

# z = k x.
fn _abt_scale(z, x, k) {
    for (var i = 0; i < 10; i = i + 1) { store64(z + i * 8, f64_mul(k, load64(x + i * 8))); }
    return 0;
}

# z = x + k.
fn _abt_addc(z, x, k) {
    for (var i = 1; i < 10; i = i + 1) { store64(z + i * 8, load64(x + i * 8)); }
    store64(z, f64_add(load64(x), k));
    return 0;
}

# z = x y. Every operand is loaded before z is written, so z may be x or y. Inlined, with the
# order of operations fixed: three helper calls a coefficient cost 122 ns a product, this 46 ns,
# and the results are identical to the bit.
fn _abt_mul(z, x, y) {
    var x0 = load64(x);
    var x1 = load64(x + 8);
    var x2 = load64(x + 16);
    var x3 = load64(x + 24);
    var y0 = load64(y);
    var y1 = load64(y + 8);
    var y2 = load64(y + 16);
    var y3 = load64(y + 24);
    var t1 = f64_add(f64_mul(x0, y1), f64_mul(x1, y0));
    var t2 = f64_add(f64_mul(x0, y2), f64_mul(x2, y0));
    var t3 = f64_add(f64_mul(x0, y3), f64_mul(x3, y0));
    # aa, ab, ac, bb, bc, cc: x0 y_k + x_k y0 plus the products of the linear parts
    var t4 = f64_add(f64_add(f64_mul(x0, load64(y + 32)), f64_mul(load64(x + 32), y0)), f64_mul(x1, y1));
    var t5 = f64_add(f64_add(f64_mul(x0, load64(y + 40)), f64_mul(load64(x + 40), y0)),
      f64_add(f64_mul(x1, y2), f64_mul(x2, y1)));
    var t6 = f64_add(f64_add(f64_mul(x0, load64(y + 48)), f64_mul(load64(x + 48), y0)),
      f64_add(f64_mul(x1, y3), f64_mul(x3, y1)));
    var t7 = f64_add(f64_add(f64_mul(x0, load64(y + 56)), f64_mul(load64(x + 56), y0)), f64_mul(x2, y2));
    var t8 = f64_add(f64_add(f64_mul(x0, load64(y + 64)), f64_mul(load64(x + 64), y0)),
      f64_add(f64_mul(x2, y3), f64_mul(x3, y2)));
    var t9 = f64_add(f64_add(f64_mul(x0, load64(y + 72)), f64_mul(load64(x + 72), y0)), f64_mul(x3, y3));
    store64(z, f64_mul(x0, y0));
    store64(z + 8, t1);
    store64(z + 16, t2);
    store64(z + 24, t3);
    store64(z + 32, t4);
    store64(z + 40, t5);
    store64(z + 48, t6);
    store64(z + 56, t7);
    store64(z + 64, t8);
    store64(z + 72, t9);
    return 0;
}

# Quadratic coefficient k (4 to 9) of e^2, for e with no constant term and linear part e1, e2, e3.
fn _abt_sq2(k, e1, e2, e3) {
    if (k == 4) { return f64_mul(e1, e1); }
    if (k == 5) { return f64_mul(F64_TWO, f64_mul(e1, e2)); }
    if (k == 6) { return f64_mul(F64_TWO, f64_mul(e1, e3)); }
    if (k == 7) { return f64_mul(e2, e2); }
    if (k == 8) { return f64_mul(F64_TWO, f64_mul(e2, e3)); }
    return f64_mul(e3, e3);
}

# z = f(x) for a function with f(x0 (1 + e)) = f0 (1 + d1 e + d2 e^2 + ...). x0 must be non-zero.
fn _abt_func(z, x, f0, d1, d2) {
    var x0 = load64(x);
    var e1 = f64_div(load64(x + 8), x0);
    var e2 = f64_div(load64(x + 16), x0);
    var e3 = f64_div(load64(x + 24), x0);
    var t[80];
    store64(&t, F64_ONE);
    for (var k = 1; k < 10; k = k + 1) {
        var v = f64_mul(d1, f64_div(load64(x + k * 8), x0));
        if (k > 3) { v = f64_add(v, f64_mul(d2, _abt_sq2(k, e1, e2, e3))); }
        store64(&t + k * 8, v);
    }
    for (var i = 0; i < 10; i = i + 1) { store64(z + i * 8, f64_mul(f0, load64(&t + i * 8))); }
    return 0;
}

# z = 1/x.
fn _abt_inv(z, x) { return _abt_func(z, x, f64_div(F64_ONE, load64(x)), f64_neg(F64_ONE), F64_ONE); }

# z = sqrt(x), for x0 > 0. 0x3FC0000000000000 is 1/8.
fn _abt_sqrt(z, x) { return _abt_func(z, x, f64_sqrt(load64(x)), F64_HALF, f64_neg(0x3FC0000000000000)); }

# ── One surface ────────

# The refraction at one surface, expanded. The incoming paraxial marginal ray is (y, u) and the
# chief ray (yb, ub), as heights on the vertex plane and direction tangents; n -> n2 are the
# media, c the curvature, nu2 and nub2 the rays' reduced slopes after, il = 1/[m, c]. A ray
# arriving as A m + B c, in the variables of the section header, leaves with its tangent-plane
# height and n2 times its direction tangent changed from the paraxial refraction's by
#   Y alpha + T beta  and  Y gamma + T delta,  Y = y A + yb B,  T = u A + ub B,
# where, with t the axial depth of the hit, D = cos(I) sqrt(1 + T.T), G = n2 cos(I') - n cos(I)
# and W = n/sqrt(1 + T.T) + G (1 - c t),
#   beta = t G/W   alpha = c beta   gamma = (n2 - n) c - n2 c G/W
#   delta = n2 (n/sqrt(1 + T.T) - c G t)/W - n
# Writes four series to out (320 bytes): P and Q, the change in B as A P + B Q, then PA and QA,
# the change in A as A PA + B QA.
fn _ab_surface(y, u, yb, ub, n, n2, c, nu2, nub2, il, out) {
    var xi[80];
    var eta[80];
    var zeta[80];
    var opz[80];
    var s[80];
    var s2[80];
    var omc[80];
    var arg[80];
    var dd[80];
    var t[80];
    var g[80];
    var w[80];
    var tmp[80];
    var al[80];
    var be[80];
    var ga[80];
    var de[80];
    _abt_lin(&xi, f64_mul(y, y), f64_mul(F64_TWO, f64_mul(y, yb)), f64_mul(yb, yb));          # Y.Y
    _abt_lin(&eta, f64_mul(y, u), f64_add(f64_mul(y, ub), f64_mul(yb, u)), f64_mul(yb, ub)); # Y.T
    _abt_lin(&zeta, f64_mul(u, u), f64_mul(F64_TWO, f64_mul(u, ub)), f64_mul(ub, ub));       # T.T
    _abt_addc(&opz, &zeta, F64_ONE);
    _abt_inv(&s2, &opz);
    _abt_sqrt(&s, &s2);                                  # 1/sqrt(1 + T.T)
    _abt_scale(&omc, &eta, f64_neg(c));
    _abt_addc(&omc, &omc, F64_ONE);                      # 1 - c Y.T
    _abt_mul(&arg, &omc, &omc);
    _abt_mul(&tmp, &xi, &opz);
    _abt_scale(&tmp, &tmp, f64_mul(c, c));
    _abt_sub(&arg, &arg, &tmp);                          # (1 - c Y.T)^2 - c^2 Y.Y (1 + T.T)
    _abt_sqrt(&dd, &arg);                                # D
    _abt_add(&tmp, &omc, &dd);
    _abt_inv(&tmp, &tmp);
    _abt_mul(&t, &xi, &tmp);
    _abt_scale(&t, &t, c);                               # t = c Y.Y / ((1 - c Y.T) + D)
    _abt_mul(&g, &arg, &s2);
    _abt_scale(&g, &g, f64_mul(n, n));
    _abt_addc(&g, &g, f64_sub(f64_mul(n2, n2), f64_mul(n, n)));
    _abt_sqrt(&g, &g);                                   # n2 cos(I')
    _abt_mul(&tmp, &dd, &s);
    _abt_comb(&g, &g, F64_ONE, &tmp, f64_neg(n));        # G
    _abt_scale(&tmp, &t, f64_neg(c));
    _abt_addc(&tmp, &tmp, F64_ONE);
    _abt_mul(&w, &g, &tmp);
    _abt_comb(&w, &w, F64_ONE, &s, n);
    _abt_inv(&w, &w);                                    # 1/W
    _abt_mul(&be, &t, &g);
    _abt_mul(&be, &be, &w);                              # beta
    _abt_scale(&al, &be, c);                             # alpha
    _abt_mul(&ga, &g, &w);
    _abt_scale(&ga, &ga, f64_neg(f64_mul(n2, c)));
    _abt_addc(&ga, &ga, f64_mul(f64_sub(n2, n), c));     # gamma
    _abt_mul(&de, &g, &t);
    _abt_comb(&de, &s, n, &de, f64_neg(c));
    _abt_mul(&de, &de, &w);
    _abt_scale(&de, &de, n2);
    _abt_addc(&de, &de, f64_neg(n));                     # delta
    # The brackets: the change in B is [m', dr]/[m, c] = (y dmom - nu2 dpos) il, the change in A
    # is [dr, c']/[m, c] = (nub2 dpos - yb dmom) il.
    _abt_comb(&xi, &ga, y, &al, f64_neg(nu2));           # B's coefficient of Y
    _abt_comb(&eta, &de, y, &be, f64_neg(nu2));          # B's coefficient of T
    _abt_comb(&zeta, &al, nub2, &ga, f64_neg(yb));       # A's coefficient of Y
    _abt_comb(&opz, &be, nub2, &de, f64_neg(yb));        # A's coefficient of T
    _abt_comb(out, &xi, f64_mul(il, y), &eta, f64_mul(il, u));
    _abt_comb(out + 80, &xi, f64_mul(il, yb), &eta, f64_mul(il, ub));
    _abt_comb(out + 160, &zeta, f64_mul(il, y), &opz, f64_mul(il, u));
    _abt_comb(out + 240, &zeta, f64_mul(il, yb), &opz, f64_mul(il, ub));
    return 0;
}

# out = sa P1 + sb Q1 + (X1's change), quadratic part: the fifth order a cubic part X1 (P1 or Q1)
# picks up when its invariants move by da, db, dc. P1, Q1, sa, sb are linear series.
fn _ab_induced1(x1, p1, q1, sa, sb, da, db, dc, out) {
    var tmp[80];
    _abt_mul(out, sa, p1);
    _abt_mul(&tmp, sb, q1);
    _abt_add(out, out, &tmp);
    _abt_comb(&tmp, da, load64(x1 + 8), db, load64(x1 + 16));
    _abt_add(out, out, &tmp);
    _abt_comb(out, out, F64_ONE, dc, load64(x1 + 24));
    return 0;
}

# The fifth order the cubic parts P1, Q1 of a surface pick up from the third-order error already
# in the coordinates it receives, A = rho (1 + SPA) + H SQA and B = rho SPB + H (1 + SQB), where
# SPA, SQA, SPB, SQB are the cubic sums of the surfaces before it (linear series). The changes
# in the invariants are
#   da = 2 (a SPA + b SQA)   db = a SPB + b SQB + b SPA + c SQA   dc = 2 (b SPB + c SQB)
# and the result is iP = SPA P1 + SPB Q1 + dP1, iQ = SQA P1 + SQB Q1 + dQ1.
fn _ab_induced(p1, q1, spa, sqa, spb, sqb, ip, iq) {
    var va[80];
    var vb[80];
    var vc[80];
    var da[80];
    var db[80];
    var dc[80];
    var tmp[80];
    _abt_lin(&va, F64_ONE, 0, 0);
    _abt_lin(&vb, 0, F64_ONE, 0);
    _abt_lin(&vc, 0, 0, F64_ONE);
    _abt_mul(&da, &va, spa);
    _abt_mul(&tmp, &vb, sqa);
    _abt_comb(&da, &da, F64_TWO, &tmp, F64_TWO);
    _abt_mul(&db, &va, spb);
    _abt_mul(&tmp, &vb, sqb);
    _abt_add(&db, &db, &tmp);
    _abt_mul(&tmp, &vb, spa);
    _abt_add(&db, &db, &tmp);
    _abt_mul(&tmp, &vc, sqa);
    _abt_add(&db, &db, &tmp);
    _abt_mul(&dc, &vb, spb);
    _abt_mul(&tmp, &vc, sqb);
    _abt_comb(&dc, &dc, F64_TWO, &tmp, F64_TWO);
    _ab_induced1(p1, p1, q1, spa, spb, &da, &db, &dc, ip);
    _ab_induced1(q1, p1, q1, sqa, sqb, &da, &db, &dc, iq);
    return 0;
}

# Adds Rimmer's twelve fifth-order letters, from the quadratic parts of P and Q, to row + 8 off.
fn _ab_add5(row, off, p, q) {
    var v[96];
    var pk = load64(p + 40);                            # P's ab coefficient
    var qk = load64(q + 64);                            # Q's bc coefficient
    store64(&v, load64(p + 32));                                            # B5 = p_aa
    store64(&v + 8, f64_add(load64(q + 32), f64_mul(F64_HALF, pk)));        # F1 = q_aa + p_ab/2
    store64(&v + 16, f64_mul(F64_HALF, pk));                                # F2 = p_ab/2
    store64(&v + 24, load64(q + 40));                                       # M1 = q_ab
    store64(&v + 32, load64(p + 48));                                       # M2 = p_ac
    store64(&v + 40, load64(p + 56));                                       # M3 = p_bb
    store64(&v + 48, load64(q + 48));                                       # N1 = q_ac
    store64(&v + 56, f64_add(load64(p + 64), load64(q + 56)));              # N2 = p_bc + q_bb
    store64(&v + 64, f64_mul(F64_HALF, load64(p + 64)));                    # N3 = p_bc/2
    store64(&v + 72, f64_mul(0x3FD0000000000000, qk));                      # C5 = q_bc/4
    store64(&v + 80, f64_sub(load64(p + 72), f64_mul(0x3FD0000000000000, qk))); # PI5 = p_cc - q_bc/4
    store64(&v + 88, load64(q + 72));                                       # E5 = q_cc
    for (var k = 0; k < 12; k = k + 1) {
        var a = row + (off + k) * 8;
        store64(a, f64_add(load64(a), load64(&v + k * 8)));
    }
    return 0;
}

# Adds the five third-order letters, from the linear parts of P and Q, to row.
fn _ab_add3(row, p, q) {
    var v[40];
    var qb = f64_mul(F64_HALF, load64(q + 16));
    store64(&v, load64(p + 8));                         # B = p_a
    store64(&v + 8, f64_mul(F64_HALF, load64(p + 16))); # F = p_b/2 (= q_a)
    store64(&v + 16, qb);                               # C = q_b/2
    store64(&v + 24, f64_sub(load64(p + 24), qb));      # PI = p_c - q_b/2
    store64(&v + 32, load64(q + 24));                   # E = q_c
    for (var k = 0; k < 5; k = k + 1) { store64(row + k * 8, f64_add(load64(row + k * 8), load64(&v + k * 8))); }
    return 0;
}

# ── API ────────

# Writes code to err_out and returns 0.
fn _ab_fail(err_out, code) {
    store64(err_out, code);
    return 0;
}

# 1 if x is finite and strictly positive. f64_gt is false for NaN.
fn _ab_pos(x) {
    if (f64_gt(x, 0) == 0) { return 0; }
    if (x == _PRK_INF) { return 0; }
    return 1;
}

# 1 if a prescription surface can be expanded: a radius that is not 0 or NaN (+-inf is flat),
# n_after finite and positive, and, unless last, a finite thickness.
fn _ab_surface_ok(ps, last) {
    if (ps == 0) { return 0; }
    var r = PrescriptionSurface_radius(ps) & _PRK_ABS;
    if ((r == 0) | (r > _PRK_INF)) { return 0; }
    if (_ab_pos(PrescriptionSurface_n_after(ps)) == 0) { return 0; }
    if (last == 1) { return 1; }
    return _ab_finite(PrescriptionSurface_thickness(ps));
}

# 1 if the prescription is non-null, non-empty, n_initial is finite and positive and every
# surface passes _ab_surface_ok.
fn _ab_prescription_ok(p) {
    if (p == 0) { return 0; }
    var count = prescription_len(p);
    if (count == 0) { return 0; }
    if (_ab_pos(Prescription_n_initial(p)) == 0) { return 0; }
    var surfs = Prescription_surfaces(p);
    for (var j = 0; j < count; j = j + 1) {
        var last = 0;
        if (j == count - 1) { last = 1; }
        if (_ab_surface_ok(vec_get(surfs, j), last) == 0) { return 0; }
    }
    return 1;
}

# Third- and fifth-order transverse aberration of a prescription for the paraxial marginal and
# chief rays `marginal` and `chief` (ParaxialRay: height at the first vertex and reduced slope
# in object space), surface by surface. See the section header for the coordinates: the
# coefficients are lengths at the paraxial image plane, at rho = H = 1. The last surface's
# thickness is ignored: the image is where the marginal ray crosses the axis.
# Writes PK_ERR_INVALID_PARAMETER for a null handle, an empty prescription, n_initial or an
# n_after that is not finite and positive, a radius of 0 or NaN, a thickness or ray value that
# is not finite, rays with a zero Lagrange invariant (no field or no aperture), or a result
# that overflows; PK_ERR_DIVISION_BY_ZERO if the image is at infinity (the marginal ray leaves
# parallel to the axis, to within 2^-40 of the slopes it was formed from); PK_ERR_ALLOCATION if
# memory runs out. Returns 0 on any of them. A coefficient that is zero is +0.
#must_use
fn aberr_sums(prescription, marginal, chief, err_out) {
    store64(err_out, PK_ERR_NONE);
    _prk_trace("aberr_sums");
    if ((marginal == 0) | (chief == 0)) { return _ab_fail(err_out, PK_ERR_INVALID_PARAMETER); }
    if (_ab_prescription_ok(prescription) == 0) { return _ab_fail(err_out, PK_ERR_INVALID_PARAMETER); }
    var y = ParaxialRay_y(marginal);
    var nu = ParaxialRay_nu(marginal);
    var yb = ParaxialRay_y(chief);
    var nub = ParaxialRay_nu(chief);
    if ((_ab_finite(y) & _ab_finite(nu) & _ab_finite(yb) & _ab_finite(nub)) == 0) {
        return _ab_fail(err_out, PK_ERR_INVALID_PARAMETER);
    }
    var lag = f64_sub(f64_mul(y, nub), f64_mul(nu, yb));
    var il = f64_div(F64_ONE, lag);
    if ((_ab_finite(lag) & _ab_finite(il)) == 0) { return _ab_fail(err_out, PK_ERR_INVALID_PARAMETER); }
    var count = prescription_len(prescription);
    var nvals = (count + 1) * _AB_ROW;
    var rows = alloc(nvals * 8);
    if (rows == 0) { return _ab_fail(err_out, PK_ERR_ALLOCATION); }
    for (var i = 0; i < nvals; i = i + 1) { store64(rows + i * 8, 0); }
    var ser[320];
    var p1[80];
    var q1[80];
    var pa1[80];
    var qa1[80];
    var ip[80];
    var iq[80];
    var spa[80];
    var sqa[80];
    var spb[80];
    var sqb[80];
    _abt_const(&spa, 0);
    _abt_const(&sqa, 0);
    _abt_const(&spb, 0);
    _abt_const(&sqb, 0);
    var surfs = Prescription_surfaces(prescription);
    var n = Prescription_n_initial(prescription);
    var nuscale = f64_abs(nu);                          # the largest slope n'u' was formed from
    for (var j = 0; j < count; j = j + 1) {
        var ps = vec_get(surfs, j);
        var n2 = PrescriptionSurface_n_after(ps);
        var c = f64_div(F64_ONE, PrescriptionSurface_radius(ps));
        var phi = f64_mul(f64_sub(n2, n), c);
        var nu2 = f64_sub(nu, f64_mul(y, phi));
        # Where nu' cancels, y phi is as large as the nu it cancels against, so nu alone sets the
        # scale (a mutant that also tracked y phi changed nothing the suite or a caller sees).
        if (f64_gt(f64_abs(nu), nuscale) == 1) { nuscale = f64_abs(nu); }
        var nub2 = f64_sub(nub, f64_mul(yb, phi));
        # Between equal indices a surface refracts nothing, and its row stays exactly +0.
        if (n2 != n) {
            _ab_surface(y, f64_div(nu, n), yb, f64_div(nub, n), n, n2, c, nu2, nub2, il, &ser);
            _abt_lin_of(&p1, &ser);
            _abt_lin_of(&q1, &ser + 80);
            _abt_lin_of(&pa1, &ser + 160);
            _abt_lin_of(&qa1, &ser + 240);
            _ab_induced(&p1, &q1, &spa, &sqa, &spb, &sqb, &ip, &iq);
            var row = rows + j * _AB_ROW * 8;
            _ab_add3(row, &ser, &ser + 80);
            _ab_add5(row, 5, &ser, &ser + 80);
            _ab_add5(row, 17, &ip, &iq);
            _abt_add(&spa, &spa, &pa1);
            _abt_add(&sqa, &sqa, &qa1);
            _abt_add(&spb, &spb, &p1);
            _abt_add(&sqb, &sqb, &q1);
        }
        if (j < count - 1) {
            var rt = f64_div(PrescriptionSurface_thickness(ps), n2);
            y = f64_add(y, f64_mul(rt, nu2));
            yb = f64_add(yb, f64_mul(rt, nub2));
        }
        nu = nu2;
        nub = nub2;
        n = n2;
    }
    # An image at infinity, or within rounding of it, is refused rather than placed 1e17 away.
    if (f64_le(f64_abs(nu), f64_mul(_AB_NOISE, nuscale)) == 1) { return _ab_fail(err_out, PK_ERR_DIVISION_BY_ZERO); }
    var dist = f64_neg(f64_div(f64_mul(y, n), nu));
    var hb = f64_add(yb, f64_mul(dist, f64_div(nub, n)));
    var ok = _ab_finite(dist) & _ab_finite(hb);
    var sys = rows + count * _AB_ROW * 8;
    for (var s = 0; s < count; s = s + 1) {
        for (var k = 0; k < _AB_ROW; k = k + 1) {
            var a = rows + (s * _AB_ROW + k) * 8;
            var v = _ab_pz(f64_mul(load64(a), hb));
            store64(a, v);
            store64(sys + k * 8, _ab_pz(f64_add(load64(sys + k * 8), v)));
        }
    }
    for (var i2 = 0; i2 < nvals; i2 = i2 + 1) { ok = ok & _ab_finite(load64(rows + i2 * 8)); }
    if (ok == 0) { return _ab_fail(err_out, PK_ERR_INVALID_PARAMETER); }
    var ab = alloc(sizeof(AberrSums));
    if (ab == 0) { return _ab_fail(err_out, PK_ERR_ALLOCATION); }
    AberrSums_set_count(ab, count);
    AberrSums_set_lagrange(ab, lag);
    AberrSums_set_image_height(ab, hb);
    AberrSums_set_image_distance(ab, dist);
    AberrSums_set_image_nu(ab, nu);
    AberrSums_set_rows(ab, rows);
    return ab;
}

# The row of surface `surface` (0 to count - 1) or of ABERR_SYSTEM; 0 for a null handle or an
# index out of range.
fn _ab_row(ab, surface) {
    if (ab == 0) { return 0; }
    var count = AberrSums_count(ab);
    var idx = surface;
    if (surface == ABERR_SYSTEM) { idx = count; }
    if ((idx < 0) | (idx > count)) { return 0; }
    if ((idx == count) & (surface != ABERR_SYSTEM)) { return 0; }
    return AberrSums_rows(ab) + idx * _AB_ROW * 8;
}

# Third-order coefficient k (ABERR3_*) of surface `surface` or ABERR_SYSTEM, in lens units.
# NaN for a null handle or an index out of range.
#must_use
fn aberr_third(ab, surface, k) {
    var row = _ab_row(ab, surface);
    if ((row == 0) | (k < 0) | (k > 4)) { return _PRK_NAN; }
    return load64(row + k * 8);
}

# Welford's Seidel sum S_I to S_V (k = ABERR3_*) of surface `surface` or ABERR_SYSTEM: the
# third-order coefficient times 2 n'u'. NaN for a null handle or an index out of range.
#must_use
fn aberr_seidel(ab, surface, k) {
    var t = aberr_third(ab, surface, k);
    if (ab == 0) { return _PRK_NAN; }
    return _ab_pz(f64_mul(f64_mul(F64_TWO, AberrSums_image_nu(ab)), t));
}

# Fifth-order coefficient k (ABERR5_*) of surface `surface` or ABERR_SYSTEM, in lens units:
# part ABERR_INTRINSIC, ABERR_INDUCED or their sum, ABERR_TOTAL. NaN for a null handle or an
# index or part out of range.
#must_use
fn aberr_fifth(ab, surface, k, part) {
    var row = _ab_row(ab, surface);
    if ((row == 0) | (k < 0) | (k > 11)) { return _PRK_NAN; }
    var intr = load64(row + (5 + k) * 8);
    var ind = load64(row + (17 + k) * 8);
    if (part == ABERR_INTRINSIC) { return intr; }
    if (part == ABERR_INDUCED) { return ind; }
    if (part == ABERR_TOTAL) { return f64_add(intr, ind); }
    return _PRK_NAN;
}

# The system's transverse aberration (eps_x, eps_y) at the fractional pupil point (px, py),
# py meridional, and fractional field h: the third order alone (order 3) or the third and the
# fifth (order 5). Writes 2 f64 to out and returns PK_ERR_NONE; on a null handle or out, an
# order other than 3 or 5, an input that is not finite or a result that overflows, writes NaN
# (when out is not null) and returns PK_ERR_INVALID_PARAMETER.
fn aberr_transverse(ab, px, py, h, order, out) {
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    store64(out, _PRK_NAN);
    store64(out + 8, _PRK_NAN);
    var row = _ab_row(ab, ABERR_SYSTEM);
    if ((row == 0) | ((order != 3) & (order != 5))) { return PK_ERR_INVALID_PARAMETER; }
    if ((_ab_finite(px) & _ab_finite(py) & _ab_finite(h)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var a = f64_add(f64_mul(px, px), f64_mul(py, py));
    var b = f64_mul(py, h);
    var c = f64_mul(h, h);
    var f = load64(row + 8);
    var cc = load64(row + 16);
    var p = f64_add(f64_add(f64_mul(load64(row), a), f64_mul(f64_mul(F64_TWO, f), b)),
      f64_mul(f64_add(cc, load64(row + 24)), c));
    var q = f64_add(f64_add(f64_mul(f, a), f64_mul(f64_mul(F64_TWO, cc), b)), f64_mul(load64(row + 32), c));
    if (order == 5) {
        var t[96];
        for (var k = 0; k < 12; k = k + 1) {
            store64(&t + k * 8, f64_add(load64(row + (5 + k) * 8), load64(row + (17 + k) * 8)));
        }
        var aa = f64_mul(a, a);
        var ab2 = f64_mul(a, b);
        var ac = f64_mul(a, c);
        var bb = f64_mul(b, b);
        var bc = f64_mul(b, c);
        var c2 = f64_mul(c, c);
        var f2 = load64(&t + 16);
        var n3 = load64(&t + 64);
        var c5 = load64(&t + 72);
        # P: B5 a^2 + 2 F2 ab + M2 ac + M3 b^2 + 2 N3 bc + (C5 + PI5) c^2
        p = f64_add(p, f64_mul(load64(&t), aa));
        p = f64_add(p, f64_mul(f64_mul(F64_TWO, f2), ab2));
        p = f64_add(p, f64_mul(load64(&t + 32), ac));
        p = f64_add(p, f64_mul(load64(&t + 40), bb));
        p = f64_add(p, f64_mul(f64_mul(F64_TWO, n3), bc));
        p = f64_add(p, f64_mul(f64_add(c5, load64(&t + 80)), c2));
        # Q: (F1 - F2) a^2 + M1 ab + N1 ac + (N2 - 2 N3) b^2 + 4 C5 bc + E5 c^2
        q = f64_add(q, f64_mul(f64_sub(load64(&t + 8), f2), aa));
        q = f64_add(q, f64_mul(load64(&t + 24), ab2));
        q = f64_add(q, f64_mul(load64(&t + 48), ac));
        q = f64_add(q, f64_mul(f64_sub(load64(&t + 56), f64_mul(F64_TWO, n3)), bb));
        q = f64_add(q, f64_mul(f64_mul(f64_from(4), c5), bc));
        q = f64_add(q, f64_mul(load64(&t + 88), c2));
    }
    var ex = f64_mul(px, p);
    var ey = f64_add(f64_mul(py, p), f64_mul(h, q));
    if ((_ab_finite(ex) & _ab_finite(ey)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    store64(out, _ab_pz(ex));
    store64(out + 8, _ab_pz(ey));
    return PK_ERR_NONE;
}

# Paraxial height, at the vertex of surface k, of the ray with height y0 and reduced slope nu0 at
# the first vertex, or 0 when that height is within _AB_NOISE of the largest term it was summed
# from: a ray that reaches the stop only through rounding does not reach it. The surfaces before
# k must have passed _ab_surface_ok.
fn _ab_height_at(prescription, k, y0, nu0) {
    var surfs = Prescription_surfaces(prescription);
    var n = Prescription_n_initial(prescription);
    var y = y0;
    var nu = nu0;
    var scale = f64_abs(y0);
    for (var j = 0; j < k; j = j + 1) {
        var ps = vec_get(surfs, j);
        var n2 = PrescriptionSurface_n_after(ps);
        var c = f64_div(F64_ONE, PrescriptionSurface_radius(ps));
        nu = f64_sub(nu, f64_mul(y, f64_mul(f64_sub(n2, n), c)));
        var dy = f64_mul(f64_div(PrescriptionSurface_thickness(ps), n2), nu);
        y = f64_add(y, dy);
        if (f64_gt(f64_abs(dy), scale) == 1) { scale = f64_abs(dy); }
        if (f64_gt(f64_abs(y), scale) == 1) { scale = f64_abs(y); }
        n = n2;
    }
    if (f64_le(f64_abs(y), f64_mul(_AB_NOISE, scale)) == 1) { return 0; }
    return y;
}

# 1 if object_distance names an object at infinity (+-inf).
fn _ab_at_infinity(object_distance) {
    if ((object_distance & _PRK_ABS) == _PRK_INF) { return 1; }
    return 0;
}

# 1 if the inputs aberr_marginal_ray and aberr_chief_ray share are usable.
fn _ab_ray_inputs_ok(prescription, object_distance, stop_index) {
    if (_ab_prescription_ok(prescription) == 0) { return 0; }
    if ((stop_index < 0) | (stop_index >= prescription_len(prescription))) { return 0; }
    if ((object_distance & _PRK_ABS) > _PRK_INF) { return 0; }
    return 1;
}

# The paraxial marginal ray, at the first vertex in object space, for an aperture stop of radius
# stop_radius on the vertex plane of surface stop_index: from the axial object point at
# object_distance in front of the first vertex (negative for a virtual object), or parallel to
# the axis when object_distance is +-inf. Writes PK_ERR_INVALID_PARAMETER for an invalid
# prescription (as aberr_sums), a stop index out of range, a radius that is not finite and
# positive, a NaN distance, or a stop on an image of the object (to within rounding), where no
# ray reaches its edge; PK_ERR_ALLOCATION if memory runs out. Returns 0 on any of them.
#must_use
fn aberr_marginal_ray(prescription, object_distance, stop_index, stop_radius, err_out) {
    store64(err_out, PK_ERR_NONE);
    if ((_ab_ray_inputs_ok(prescription, object_distance, stop_index) & _ab_pos(stop_radius)) == 0) {
        return _ab_fail(err_out, PK_ERR_INVALID_PARAMETER);
    }
    var n0 = Prescription_n_initial(prescription);
    var y = 0;
    var nu = 0;
    if (_ab_at_infinity(object_distance) == 1) {
        y = f64_div(stop_radius, _ab_height_at(prescription, stop_index, F64_ONE, 0));
    } else {
        # The ray from the axial point with slope 1, to the stop's height.
        var sc = f64_div(stop_radius, _ab_height_at(prescription, stop_index, object_distance, n0));
        y = f64_mul(object_distance, sc);
        nu = f64_mul(n0, sc);
    }
    if ((_ab_finite(y) & _ab_finite(nu)) == 0) { return _ab_fail(err_out, PK_ERR_INVALID_PARAMETER); }
    if (((y | nu) & _PRK_ABS) == 0) { return _ab_fail(err_out, PK_ERR_INVALID_PARAMETER); }
    var r = paraxial_ray_new(y, nu);
    if (r == 0) { return _ab_fail(err_out, PK_ERR_ALLOCATION); }
    return r;
}

# The paraxial chief ray, at the first vertex in object space, through the centre of a stop on
# the vertex plane of surface stop_index: from the object point at height `field` (object
# distance as aberr_marginal_ray), or, for an object at infinity, with slope `field`, the
# tangent of the field angle. ⚠ The two read a positive field from opposite sides, as lens
# design programs do: a positive height is an object above the axis, a positive slope a ray
# rising from below it. With a positive lens the first images below the axis, the second above;
# the coefficients odd in H follow (see the section header). A stop at the back focus of what
# precedes it is telecentric in object space: with a finite object the chief ray leaves it
# parallel to the axis, and is returned; with an object at infinity the stop is on the object's
# image, and is refused. Errors as aberr_marginal_ray, with a field that is 0 or not finite
# refused in place of the radius.
#must_use
fn aberr_chief_ray(prescription, object_distance, field, stop_index, err_out) {
    store64(err_out, PK_ERR_NONE);
    if ((_ab_ray_inputs_ok(prescription, object_distance, stop_index) & _ab_finite(field)) == 0) {
        return _ab_fail(err_out, PK_ERR_INVALID_PARAMETER);
    }
    if ((field & _PRK_ABS) == 0) { return _ab_fail(err_out, PK_ERR_INVALID_PARAMETER); }
    var n0 = Prescription_n_initial(prescription);
    var y1s = _ab_height_at(prescription, stop_index, F64_ONE, 0);
    var y2s = _ab_height_at(prescription, stop_index, 0, n0);
    var yb = 0;
    var ub = 0;
    if (_ab_at_infinity(object_distance) == 1) {
        ub = field;
        yb = f64_neg(f64_div(f64_mul(ub, y2s), y1s));
    } else {
        # d is the stop height of the ray from the axial point with slope 1. The height is
        # field y2s/d, not field + distance ub: that subtraction lost 3.9% at a distance of 1e15.
        var d = _ab_height_at(prescription, stop_index, object_distance, n0);
        ub = f64_neg(f64_div(f64_mul(field, y1s), d));
        yb = f64_div(f64_mul(field, y2s), d);
    }
    var nub = f64_mul(n0, ub);
    if ((_ab_finite(yb) & _ab_finite(nub)) == 0) { return _ab_fail(err_out, PK_ERR_INVALID_PARAMETER); }
    var r = paraxial_ray_new(yb, nub);
    if (r == 0) { return _ab_fail(err_out, PK_ERR_ALLOCATION); }
    return r;
}

# --- atmosphere.cyr ---

# atmosphere.cyr -- atmospheric optics (Rayleigh/Mie scattering, sky color,
# air mass, optical depth)
# Usage: include "lib/atmosphere.cyr"  (requires ganita for pow/acos)
#
# Ported from the Rust `atmosphere.rs`. Physical constants: N_AIR=1.000293
# (exact ratio), N_S=2.504e25 and RAYLEIGH_PREFACTOR=(8pi^3/3)(N_AIR^2-1)^2/N_S^2
# are exact IEEE-754 hex (extreme magnitude / precomputed const). RGB channels
# use wavelengths R=650nm, G=550nm, B=450nm; [f64;3] returns -> 3-f64 out buffers.

fn _atm_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }
# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _atm_eps15() { return 0x3CD203AF9EE75616; }

# Physical constants.
# ⛔ THROUGH 2.4.4 THESE TWO DESCRIBED AIR AT TWO DIFFERENT TEMPERATURES, and the
# Rayleigh formula multiplies one by the square of the other, so the mismatch did not
# cancel — it compounded. `_atm_prefactor` was built from n_air = 1.000293, which is
# the textbook index of air at **0 C**; `_atm_n_s` was 2.504e25 m^-3, which is air at
# about **20 C**. Since (n-1) is proportional to number density, pairing the two put
# beta(550 nm) 11.8% and tau_R 13.5% above the published sea-level figures, rising to
# +15% at 700 nm. Both are now standard air — **15 C, 101.325 kPa** — which is what
# "sea level" means in every atmospheric-optics reference and the condition at which
# the published beta and tau this module is checked against are quoted.
fn _atm_n_s() { return 0x4535114541AD5EB6; }                # 2.5469e25 molecules/m^3 (15 C, 101.325 kPa)
fn _atm_beta_m() { return _atm_r(21, 1000000); }            # 21e-6 1/m (Mie sea level)
fn _atm_scale_h_rayleigh() { return f64_from(8500); }       # meters
fn _atm_scale_h_mie() { return f64_from(1200); }            # meters
fn _atm_mie_g() { return _atm_r(76, 100); }                 # 0.76
# (8*pi^3/3)*(N_AIR^2-1)^2/N_S^2 -- compile-time const, exact hex.
# Reproduce with n_air = 1.000277824 and N_S = 2.5469e25: the index of standard air
# (15 C, 101.325 kPa) AT 550 nm, from the Edlen/Ciddor dispersion formula
# (n-1)*1e8 = 8342.13 + 2406030/(130-s^2) + 15997/(38.9-s^2), s = 1/lambda_um.
# ⚠ ONE n FOR THE WHOLE BAND IS THIS MODEL'S OWN APPROXIMATION, not a defect: the
# prefactor is wavelength-independent by construction, while air's (n-1) varies about
# 2% across 400-700 nm and beta goes as (n^2-1)^2. 550 nm is chosen because it is the
# wavelength published Rayleigh coefficients are quoted at. Measured residual against
# Hansen & Travis (1974) across the visible: -3.1% at 400 nm, +0.3% at 550, +1.8% at
# 700 — against +9.6% / +13.5% / +15.2% before the repair above.
fn _atm_prefactor() { return 0x346EE338997F4085; }
# 180/pi for to_degrees (matches Rust's precomputed const).
fn _atm_to_degrees(x) { return f64_mul(x, f64_div(f64_from(180), F64_PI)); }

# i-th RGB wavelength in meters: 650/550/450 nm.
fn _atm_rgb_wl(i) {
    if (i == 0) {
        return _atm_r(65, 100000000);
    }
    if (i == 1) {
        return _atm_r(55, 100000000);
    }
    return _atm_r(45, 100000000);
}

# ── King correction factor ────────

# King factor F_K = (6 + 3*rho_n) / (6 - 7*rho_n),
# rho_n = 0.0279 + 0.000174/lambda_um^2 (Bates 1984).
#must_use
fn atm_king_factor(wavelength_m) {
    var lambda_um = f64_mul(wavelength_m, f64_from(1000000));
    var rho_n = f64_add(_atm_r(279, 10000),
      f64_div(_atm_r(174, 1000000), f64_mul(lambda_um, lambda_um)));
    return f64_div(
      f64_add(f64_from(6), f64_mul(f64_from(3), rho_n)),
      f64_sub(f64_from(6), f64_mul(f64_from(7), rho_n)));
}

# ── Rayleigh scattering ────────

# Rayleigh cross-section: sigma(lambda) = PREFACTOR / lambda^4.
#must_use
fn atm_rayleigh_cross_section(wavelength_m) {
    var lambda4 = f64_mul(
      f64_mul(f64_mul(wavelength_m, wavelength_m), wavelength_m), wavelength_m);
    return f64_div(_atm_prefactor(), lambda4);
}

# Rayleigh cross-section with King correction.
#must_use
fn atm_rayleigh_cross_section_corrected(wavelength_m) {
    return f64_mul(atm_rayleigh_cross_section(wavelength_m), atm_king_factor(wavelength_m));
}

# Rayleigh scattering coefficient at sea level: beta = N_S * sigma.
#must_use
fn atm_rayleigh_scattering_coefficient(wavelength_m) {
    return f64_mul(_atm_n_s(), atm_rayleigh_cross_section(wavelength_m));
}

# Rayleigh coefficient at altitude: beta0 * exp(-h/H_R).
#must_use
fn atm_rayleigh_scattering_at_altitude(wavelength_m, altitude_m) {
    return f64_mul(atm_rayleigh_scattering_coefficient(wavelength_m),
      _prk_exp(f64_div(f64_neg(altitude_m), _atm_scale_h_rayleigh())));
}

# Rayleigh phase function: 3*(1 + cos^2) / (16*pi).
#must_use
fn atm_phase_rayleigh(cos_theta) {
    return f64_div(
      f64_mul(f64_from(3), f64_add(F64_ONE, f64_mul(cos_theta, cos_theta))),
      f64_mul(f64_from(16), F64_PI));
}

# ── Mie scattering ────────

# Mie scattering coefficient at sea level (wavelength-independent, alpha=0).
#must_use
fn atm_mie_scattering_coefficient(wavelength_m) {
    return _atm_beta_m();
}

# Mie coefficient at altitude: beta0 * exp(-h/H_M).
#must_use
fn atm_mie_scattering_at_altitude(wavelength_m, altitude_m) {
    return f64_mul(atm_mie_scattering_coefficient(wavelength_m),
      _prk_exp(f64_div(f64_neg(altitude_m), _atm_scale_h_mie())));
}

# Cornette-Shanks Mie phase:
# (3/8pi)*(1-g^2)(1+cos^2) / ((2+g^2)(1+g^2-2g*cos)^1.5).
#must_use
fn atm_mie_phase_cornette_shanks(cos_theta, g) {
    var g2 = f64_mul(g, g);
    var denom_base = f64_sub(f64_add(F64_ONE, g2), f64_mul(f64_mul(F64_TWO, g), cos_theta));
    var denom = f64_mul(f64_mul(f64_add(F64_TWO, g2), denom_base), f64_sqrt(denom_base));
    if (f64_lt(denom, _atm_eps15()) == 1) {
        return f64_from(0);
    }
    return f64_div(
      f64_mul(
        f64_mul(f64_div(f64_from(3), f64_mul(f64_from(8), F64_PI)), f64_sub(F64_ONE, g2)),
        f64_add(F64_ONE, f64_mul(cos_theta, cos_theta))),
      denom);
}

# ── Air mass & optical depth ────────

# Relative air mass (Kasten & Young 1989):
# 1 / (cos(z) + 0.50572*(96.07995 - z_deg)^-1.6364), z_deg = to_degrees(|z|).min(90). The zenith
# angle's sign is a side, not a height: -z is z. NaN for NaN or an infinite angle.
# ⛔ 2.15.1: a NaN angle passed f64_min as the horizon and answered 37.92, and a negative angle
# entered the degree term as -z, so z = -60 deg gave 1.99948 where +60 gives 1.99429.
#must_use
fn atm_air_mass(zenith_angle) {
    if (f64_lt(f64_abs(zenith_angle), 0x7FF0000000000000) == 0) { return _PRK_NAN; }
    # 2.2.6: the clamp was applied ONLY to the degree value feeding the
    # Kasten-Young correction term, while cos_z used the RAW angle. Past 90 deg
    # cos goes negative, the denominator goes negative, and air mass goes
    # NEGATIVE — which turns atm_atmospheric_transmittance's exp(-tau*m) into
    # exponential GAIN. Kasten-Young is only fitted for z <= 90, so the angle is
    # now clamped once, up front, and BOTH terms use the clamped value; air mass
    # saturates at the horizon value (~37.92) for any sun at or below the
    # horizon, which is the standard treatment.
    var z = f64_min(f64_abs(zenith_angle), F64_PI_2);
    var zenith_deg = f64_min(_atm_to_degrees(z), f64_from(90));
    var cos_z = _prk_cos(z);
    var correction = f64_mul(_atm_r(50572, 100000),
      _prk_pow(f64_sub(_atm_r(9607995, 100000), zenith_deg), f64_neg(_atm_r(16364, 10000))));
    return f64_div(F64_ONE, f64_add(cos_z, correction));
}

# Rayleigh optical depth (zenith): tau_R = beta_R * H_R.
#must_use
fn atm_optical_depth_rayleigh(wavelength_m) {
    return f64_mul(atm_rayleigh_scattering_coefficient(wavelength_m), _atm_scale_h_rayleigh());
}

# Mie optical depth: tau_M = beta_M * H_M.
#must_use
fn atm_optical_depth_mie() {
    return f64_mul(_atm_beta_m(), _atm_scale_h_mie());
}

# Atmospheric transmittance: exp(-(tau_R + tau_M) * air_mass(z)).
#must_use
fn atm_atmospheric_transmittance(wavelength_m, zenith_angle) {
    var m = atm_air_mass(zenith_angle);
    var tau_r = atm_optical_depth_rayleigh(wavelength_m);
    var tau_m = atm_optical_depth_mie();
    return _prk_exp(f64_mul(f64_neg(f64_add(tau_r, tau_m)), m));
}

# ── Sky color ────────

# Shared core of atm_sky_radiance_single_scatter, with the two scattering-angle
# terms already evaluated by the caller. Split out in 2.3.1 so atm_sky_color_rgb
# can evaluate them once instead of once per RGB channel; the arithmetic and its
# order are unchanged, so both callers produce bit-identical results.
#must_use
fn _atm_sky_radiance_with_phase(wavelength_m, sun_zenith, phase_r, phase_m) {
    var beta_r = atm_rayleigh_scattering_coefficient(wavelength_m);
    var beta_m = atm_mie_scattering_coefficient(wavelength_m);
    var radiance_r = f64_mul(beta_r, phase_r);
    var radiance_m = f64_mul(beta_m, phase_m);
    var sun_transmittance = atm_atmospheric_transmittance(wavelength_m, sun_zenith);
    return f64_mul(f64_add(radiance_r, radiance_m), sun_transmittance);
}

# Single-scatter sky radiance (relative) at one wavelength.
#must_use
fn atm_sky_radiance_single_scatter(wavelength_m, sun_zenith, scattering_angle) {
    var cos_scatter = _prk_cos(scattering_angle);
    return _atm_sky_radiance_with_phase(wavelength_m, sun_zenith,
      atm_phase_rayleigh(cos_scatter),
      atm_mie_phase_cornette_shanks(cos_scatter, _atm_mie_g()));
}

# Sky color RGB (single-scatter, R/G/B wavelengths) into a 3-f64 out buffer. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER and writes nothing for a null out (2.15.1: it was written through).
fn atm_sky_color_rgb(sun_zenith, scattering_angle, out) {
    _prk_trace("sky_color_rgb");
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    # The scattering-angle terms carry no wavelength dependence, so they are
    # evaluated ONCE here rather than three times inside the loop. Through 2.3.0
    # this called atm_sky_radiance_single_scatter per channel, which recomputed
    # _prk_cos plus both phase functions — and Cornette-Shanks alone carries an
    # f64_sqrt and two divisions — for the same three answers every pass. Hoisting
    # is bit-exact: each term is a pure function of values that do not vary with i,
    # so the per-channel arithmetic below sees the identical operands it saw before.
    var cos_scatter = _prk_cos(scattering_angle);
    var phase_r = atm_phase_rayleigh(cos_scatter);
    var phase_m = atm_mie_phase_cornette_shanks(cos_scatter, _atm_mie_g());
    for (var i = 0; i < 3; i = i + 1) {
        store64(out + i * 8,
          _atm_sky_radiance_with_phase(_atm_rgb_wl(i), sun_zenith, phase_r, phase_m));
    }
    return 0;
}

# ── Sunset / sunrise ────────

# Direct-sunlight color (transmittance) after the atmospheric path, into 3-f64. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER and writes nothing for a null out (2.15.1: it was written through).
fn atm_sunlight_color(sun_zenith, out) {
    _prk_trace("sunlight_color");
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    for (var i = 0; i < 3; i = i + 1) {
        store64(out + i * 8, atm_atmospheric_transmittance(_atm_rgb_wl(i), sun_zenith));
    }
    return 0;
}

# Sunset/sunrise sky gradient RGB into a 3-f64 out buffer. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER and writes nothing for a null out (2.15.1: it was written through).
fn atm_sunset_gradient(sun_zenith, view_elevation, angular_distance_to_sun, out) {
    _prk_trace("sunset_gradient");
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    var view_zenith = f64_clamp(f64_sub(F64_PI_2, view_elevation), f64_from(0), F64_PI_2);
    var cos_scatter = _prk_cos(angular_distance_to_sun);
    var phase_r = atm_phase_rayleigh(cos_scatter);
    var phase_m = atm_mie_phase_cornette_shanks(cos_scatter, _atm_mie_g());
    var sun_air_mass = atm_air_mass(sun_zenith);
    var view_air_mass = atm_air_mass(view_zenith);
    var tau_m = atm_optical_depth_mie();
    for (var i = 0; i < 3; i = i + 1) {
        var beta_r = atm_rayleigh_scattering_coefficient(_atm_rgb_wl(i));
        var total_tau = f64_add(f64_mul(beta_r, _atm_scale_h_rayleigh()), tau_m);
        var sun_transmittance = _prk_exp(f64_mul(f64_neg(total_tau), sun_air_mass));
        var view_transmittance = _prk_exp(f64_mul(f64_neg(total_tau), view_air_mass));
        var scatter = f64_mul(
          f64_add(f64_mul(beta_r, phase_r), f64_mul(_atm_beta_m(), phase_m)),
          sun_transmittance);
        store64(out + i * 8, f64_mul(scatter, view_transmittance));
    }
    return 0;
}

# Scattering angle between sun and view directions (zenith + azimuth):
# acos(clamp(cos_s*cos_v + sin_s*sin_v*cos(azimuth_diff), -1, 1)).
#must_use
fn atm_scattering_angle(sun_zenith, view_zenith, azimuth_diff) {
    var cos_gamma = f64_add(
      f64_mul(_prk_cos(sun_zenith), _prk_cos(view_zenith)),
      f64_mul(f64_mul(_prk_sin(sun_zenith), _prk_sin(view_zenith)), _prk_cos(azimuth_diff)));
    return ganita_f64_acos(f64_clamp(cos_gamma, f64_neg(F64_ONE), F64_ONE));
}

# --- bridge.cyr ---

# bridge.cyr -- cross-crate bridges: primitive f64 converters from other AGNOS
# science crates (bijli EM, tara stellar, badal weather) into prakash optics.
# Usage: include "lib/bridge.cyr"  (requires ganita for pow; math for ln)
#
# Ported from the Rust `bridge.rs`. All inputs/outputs are primitive f64 (no
# science-crate deps). c=299792458 m/s; EPSILON_0=8.854187817e-12 (exact hex);
# stellar-RGB fit coefficients are exact ratios of the Rust literals.

fn _br_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _br_c() { return f64_from(299792458); }
fn _br_epsilon0() { return 0x3DA37876F148112E; }   # 8.854187817e-12 F/m

# ── Bijli bridges (electromagnetism) ────────

# EM frequency (Hz) -> optical wavelength (nm): lambda = c/f, then m->nm.
#must_use
fn br_em_frequency_to_wavelength_nm(frequency_hz) {
    if (f64_le(frequency_hz, f64_from(0)) == 1) {
        return f64_from(0);
    }
    return f64_mul(f64_div(_br_c(), frequency_hz), f64_from(1000000000));
}

# Optical wavelength (nm) -> EM frequency (Hz): f = c/lambda.
#must_use
fn br_wavelength_nm_to_em_frequency(wavelength_nm) {
    if (f64_le(wavelength_nm, f64_from(0)) == 1) {
        return f64_from(0);
    }
    return f64_div(_br_c(), f64_mul(wavelength_nm, _br_r(1, 1000000000)));
}

# E-field amplitude (V/m) -> intensity (W/m^2): I = 0.5*eps0*c*E^2.
#must_use
fn br_e_field_to_intensity(e_amplitude_v_per_m) {
    return f64_mul(
      f64_mul(f64_mul(f64_mul(F64_HALF, _br_epsilon0()), _br_c()), e_amplitude_v_per_m),
      e_amplitude_v_per_m);
}

# Intensity (W/m^2) -> E-field amplitude (V/m): E = sqrt(2*I/(eps0*c)).
#must_use
fn br_intensity_to_e_field(intensity_w_per_m2) {
    if (f64_le(intensity_w_per_m2, f64_from(0)) == 1) {
        return f64_from(0);
    }
    return f64_sqrt(f64_div(
        f64_mul(F64_TWO, intensity_w_per_m2),
        f64_mul(_br_epsilon0(), _br_c())));
}

# Refractive index from wavelength (nm) via Cauchy BK7 approximation:
# n = 1.5046 + 0.00420/l2 + 0.0/l2^2, l = wavelength in micrometres.
#must_use
fn br_refractive_index_cauchy_bk7(wavelength_nm) {
    if (f64_le(wavelength_nm, f64_from(0)) == 1) {
        return F64_ONE;
    }
    var lambda_um = f64_mul(wavelength_nm, _br_r(1, 1000));
    var l2 = f64_mul(lambda_um, lambda_um);
    return f64_add(
      f64_add(_br_r(15046, 10000), f64_div(_br_r(42, 10000), l2)),
      f64_div(f64_from(0), f64_mul(l2, l2)));
}

# ── Tara bridges (stellar astrophysics) ────────

# Stellar effective temperature (K) -> RGB [r,g,b] in 0..1, into a 3-f64 buffer. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER and writes nothing for a null out (2.15.1: it was written through).
fn br_stellar_temperature_to_rgb(temperature_k, out) {
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    var t = f64_clamp(f64_div(temperature_k, f64_from(100)), f64_from(10), f64_from(400));
    var r = F64_ONE;
    if (f64_le(t, f64_from(66)) == 0) {
        var xr = f64_sub(t, f64_from(60));
        r = f64_clamp(
          f64_div(f64_mul(_br_r(329698727446, 1000000000),
              _prk_pow(xr, f64_neg(_br_r(1332047592, 10000000000)))), f64_from(255)),
          f64_from(0), F64_ONE);
    }
    var g = f64_from(0);
    if (f64_le(t, f64_from(66)) == 1) {
        g = f64_div(
          f64_clamp(f64_sub(f64_mul(_br_r(994708025861, 10000000000), f64_ln(t)),
              _br_r(1611195681661, 10000000000)), f64_from(0), f64_from(255)),
          f64_from(255));
    } else {
        var xg = f64_sub(t, f64_from(60));
        g = f64_clamp(
          f64_div(f64_mul(_br_r(2881221695283, 10000000000),
              _prk_pow(xg, f64_neg(_br_r(7551484937, 100000000000)))), f64_from(255)),
          f64_from(0), F64_ONE);
    }
    var b = F64_ONE;
    if (f64_ge(t, f64_from(66)) == 1) {
        b = F64_ONE;
    } elif (f64_le(t, f64_from(19)) == 1) {
        b = f64_from(0);
    } else {
        var xb = f64_sub(t, f64_from(10));
        b = f64_div(
          f64_clamp(f64_sub(f64_mul(_br_r(1385177312231, 10000000000), f64_ln(xb)),
              _br_r(3050447927307, 10000000000)), f64_from(0), f64_from(255)),
          f64_from(255));
    }
    store64(out, r);
    store64(out + 8, g);
    store64(out + 16, b);
    return 0;
}

# B-V color index -> temperature (K), Ballesteros (2012):
# T = 4600*(1/(0.92*bv+1.7) + 1/(0.92*bv+0.62)). NaN where 0.92 bv + 0.62 <= 0 (bv <= -0.674) or
# for NaN: there the formula is infinite or NEGATIVE (2.15.1: bv = -1 answered -9,436 K).
#must_use
fn br_color_index_to_temperature(b_minus_v) {
    if (f64_gt(f64_add(f64_mul(_br_r(92, 100), b_minus_v), _br_r(62, 100)), f64_from(0)) == 0) { return _PRK_NAN; }
    var a = f64_add(f64_mul(_br_r(92, 100), b_minus_v), _br_r(17, 10));
    var c = f64_add(f64_mul(_br_r(92, 100), b_minus_v), _br_r(62, 100));
    return f64_mul(f64_from(4600),
      f64_add(f64_div(F64_ONE, a), f64_div(F64_ONE, c)));
}

# Spectral class letter (ASCII code) -> midpoint temperature (K): O B A F G K M L T Y, either case.
# NaN for any other code (2.15.1: every unknown letter answered 5500 K, G's value, so G's own test
# could not fail).
#must_use
fn br_spectral_class_to_temperature(class) {
    var cu = class;
    if (class >= 97) {
        if (class <= 122) {
            cu = class - 32;
        }
    }
    if (cu == 79) {
        return f64_from(35000);
    }
    if (cu == 66) {
        return f64_from(17500);
    }
    if (cu == 65) {
        return f64_from(8750);
    }
    if (cu == 70) {
        return f64_from(6750);
    }
    if (cu == 71) {
        return f64_from(5500);
    }
    if (cu == 75) {
        return f64_from(4250);
    }
    if (cu == 77) {
        return f64_from(3000);
    }
    if (cu == 76) {
        return f64_from(1750);
    }
    if (cu == 84) {
        return f64_from(1000);
    }
    if (cu == 89) {
        return f64_from(500);
    }
    return _PRK_NAN;
}

# Absolute magnitude -> luminosity relative to the Sun: 10^((M_sun - M)/2.5).
#must_use
fn br_absolute_magnitude_to_luminosity(absolute_magnitude) {
    return _prk_pow(f64_from(10),
      f64_div(f64_sub(_br_r(483, 100), absolute_magnitude), _br_r(25, 10)));
}

# ── Badal bridges (weather/atmosphere) ────────

# Air density (kg/m^3) -> Rayleigh scale factor (1.0 at sea-level 1.225 kg/m^3).
#must_use
fn br_density_to_rayleigh_scale(density_kg_m3) {
    if (f64_le(density_kg_m3, f64_from(0)) == 1) {
        return f64_from(0);
    }
    return f64_div(density_kg_m3, _br_r(1225, 1000));
}

# Relative humidity (%) -> Mie scale factor (1.0 at 50% RH baseline).
#must_use
fn br_humidity_to_mie_scale(relative_humidity_percent) {
    var rh = f64_clamp(relative_humidity_percent, f64_from(0), f64_from(100));
    if (f64_lt(rh, f64_from(50)) == 1) {
        return f64_add(F64_HALF, f64_div(rh, f64_from(100)));
    }
    return f64_add(F64_ONE, f64_div(f64_sub(rh, f64_from(50)), f64_from(50)));
}

# Cloud cover fraction (0..1) -> diffuse light fraction: 0.1 + 0.85*cf.
#must_use
fn br_cloud_cover_to_diffuse_fraction(cloud_fraction) {
    var cf = f64_clamp(cloud_fraction, f64_from(0), F64_ONE);
    return f64_add(_br_r(1, 10), f64_mul(_br_r(85, 100), cf));
}

# Visibility (km) -> Mie extinction coefficient (1/m), Koschmieder: 3.912/V_m.
#must_use
fn br_visibility_to_extinction(visibility_km) {
    var v_m = f64_mul(visibility_km, f64_from(1000));
    if (f64_le(v_m, f64_from(0)) == 1) {
        return f64_from(0);
    }
    return f64_div(_br_r(3912, 1000), v_m);
}

# --- serialize.cyr ---

# serialize.cyr -- JSON (de)serialization for the types that had serde derives
# Usage: include "lib/serialize.cyr"  (requires the type modules + bayan)
#
# Ported from the Rust `#[derive(Serialize, Deserialize)]` types that had serde
# roundtrip tests: Rgb, Medium, SellmeierCoefficients, LensType, Polarization,
# Prescription, Spd. Uses the bayan recipe — build with str_from() keys/values +
# v_float_new(bits), parse with parse_buf(data,len); *_from_json takes (data ptr,
# byte len) since bayan's build output Str is not NUL-terminated.
#
# FLOAT FIDELITY: since bayan 1.2.1 the ENCODER is Grisu2 round-trip-correct — it
# always emits the shortest string that parses back to the original bits. (Before
# that it rendered 6 decimals, which silently flushed any |x| < 5e-7 to zero —
# prakash 2.0.0 shipped against that encoder.)
# The DECODER is correctly rounded since bayan 1.5.7, so a finite double survives a
# to_json/from_json cycle BIT-EXACTLY. 2.10.1, seeded random doubles through
# rgb_to_json -> rgb_from_json, half over the whole exponent range and half with
# |x| in 1e-16..1e16: **0 mismatches in 299,763**, where the same sweep on 2.10.0's
# bayan 1.5.6 gave 6. tests/hardening.tcyr pins a value that used to fail.
# ⛔ 2.4.9 had recorded the gap: this header used to claim bit-exactness without
# qualification when the decoder mis-rounded ~1 in 10^5 doubles by 1 ULP.
# Filed upstream at 2.5.0 as bayan docs/development/issues/
# 2026-09-22-prakash-f64-parse-double-rounding-at-midpoint.md. Root cause: the
# slow path rounded W*10^E to 64 bits, which landed near-midpoint values EXACTLY on
# the midpoint, then broke that false tie to even.
#
# FAILURE CONVENTION (2.1.0): every `*_from_json` takes a trailing `err_out`
# pointer, per the library-wide convention in error.cyr. It writes PK_ERR_NONE on
# entry and one of these on failure, returning 0:
#
#   PK_ERR_PARSE              the bytes are not well-formed JSON, or the document
#                             is not the type the decoder needs (bad bytes). From
#                             bayan 1.11.1 that takes in a duplicate key and a
#                             leading zero, which used to decode (2.11.1)
#   PK_ERR_INVALID_PARAMETER  parsed fine, but a required field is absent or of
#                             the wrong type (wrong schema)
#   PK_ERR_ALLOCATION         a caller-sized buffer could not be allocated
#
# Callers: `var e = 0; var c = rgb_from_json(p, n, &e); if (prakash_is_err(e))`.
# `lens_type_from_json` still returns LENS_TYPE_INVALID as its in-band failure
# value, since 0 is already LENS_CONVERGING.
#
# Before 2.0.2 these paths either dereferenced null and aborted the process
# (`str_data(0)` is `load64(0)`) or silently fabricated a zero-valued struct,
# because every bayan accessor returns 0 for a missing or wrong-typed node and 0
# is the bit pattern for 0.0. 2.0.2 made them fail safely; 2.1.0 makes them say
# why.

# Returned by lens_type_from_json when the input is not a known lens type.
# Distinct from LENS_CONVERGING (0) and LENS_DIVERGING (1).
var LENS_TYPE_INVALID = (0 - 1);

# ── decode helpers ────────
#
# Each helper writes its own failure code into `err_out` and returns a zero
# value. Callers read several fields in a row and then test `err_out` ONCE, so
# `err_out` doubles as the failure accumulator — the first code written is not
# overwritten by a later success, because success never writes.

# Parse `json`/`len` and require a JSON object. Returns the value, or 0 with
# PK_ERR_PARSE.
#must_use
fn _ser_obj(json, len, err_out) {
    # 2.4.9: a null buffer with a nonzero length was read straight off address 0
    # inside bayan (vendored, not ours to guard), so every decoder routed through
    # here exited 139 on it. This is the untrusted-input boundary; report PARSE.
    if (json == 0) {
        store64(err_out, PK_ERR_PARSE);
        return 0;
    }
    var v = bayan_json_v_parse_buf(json, len);
    if (v == 0) {
        store64(err_out, PK_ERR_PARSE);
        return 0;
    }
    if (bayan_json_v_is_obj(v) == 0) {
        store64(err_out, PK_ERR_PARSE);
        return 0;
    }
    return v;
}

# A decoded number, or PK_ERR_INVALID_PARAMETER and 0.0 if it is not finite: a literal past the
# double range (1e400) parses to +-inf, and JSON has no infinities, so it is not a value the
# encoder can have written (2.15.1: 1e400 decoded as +inf, as success).
fn _ser_fin(x, err_out) {
    if ((x & 0x7FFFFFFFFFFFFFFF) < 0x7FF0000000000000) { return x; }
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return f64_from(0);
}

# Read a required numeric field. JSON integers are accepted as well as floats
# (bayan tags `1` as JTAG_INT and `1.0` as JTAG_FLOAT; both are valid f64 input).
# A missing or wrong-typed field, or one past the double range, writes PK_ERR_INVALID_PARAMETER
# and returns 0.0.
#must_use
fn _ser_num(v, key, err_out) {
    var node = bayan_json_v_obj_get_by_cstr(v, key);
    if (bayan_json_v_is_float(node) == 1) { return _ser_fin(bayan_json_v_float(node), err_out); }
    if (bayan_json_v_is_int(node) == 1) { return _ser_fin(bayan_json_v_float(node), err_out); }
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return f64_from(0);
}

# Read a required numeric field that may legitimately be non-finite. JSON has no
# infinity literal, so bayan encodes a non-finite f64 as `null`; this restores
# +inf for it. Used for an optical surface radius, where `null` means a FLAT
# surface (radius = infinity, i.e. zero curvature). Without this, a plano
# surface decoded as 0.0 — a zero radius, i.e. INFINITE curvature, the exact
# physical inverse. Also an aperture radius, where null is an unbounded aperture (2.15.1: the
# encoder wrote +inf as null and this decoder refused it back). The encoder writes -inf as null
# too: a radius of -inf is the same plane as +inf, and a negative aperture is no aperture.
# Only null is an infinity: a number literal past the double range is refused.
#must_use
fn _ser_num_or_inf(v, key, err_out) {
    var node = bayan_json_v_obj_get_by_cstr(v, key);
    if (bayan_json_v_is_null(node) == 1) { return 0x7FF0000000000000; }
    if (bayan_json_v_is_float(node) == 1) { return _ser_fin(bayan_json_v_float(node), err_out); }
    if (bayan_json_v_is_int(node) == 1) { return _ser_fin(bayan_json_v_float(node), err_out); }
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return f64_from(0);
}

# Read a required string field. Returns a cstring, or 0 with
# PK_ERR_INVALID_PARAMETER.
#must_use
fn _ser_str(v, key, err_out) {
    var node = bayan_json_v_obj_get_by_cstr(v, key);
    if (bayan_json_v_is_str(node) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var s = bayan_json_v_str(node);
    if (s == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return str_data(s);
}

# 1 if `bits` is a NaN: exponent all ones with a nonzero mantissa. A signed
# compare is exact here because masking the sign bit leaves a non-negative i64.
fn _ser_is_nan(bits) {
    if ((bits & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000) { return 1; }
    return 0;
}

# ── Rgb (spectral) ────────

# Append one f64 to a str_builder in bayan's JSON form.
#
# Uses `bayan_f64_to_json` — the SAME Grisu2 renderer bayan's own value-tree
# walker uses — so a hand-assembled document is byte-identical to the tree-built
# one. Non-finite values render as `null`, exactly as the tree path does.
#
# ⚠ Placed ABOVE rgb_to_json's doc block, not between it and its function. The
# first attempt in 2.3.4 inserted it in the gap and silently took rgb_to_json's
# `#must_use` with it — the third time this session that landing a function
# between a doc block and its target rebound the attribute. `cyrius audit`
# reported only "1 undocumented public fn"; the lost `#must_use` was invisible.
#
# ⛔ NOT `#must_use`, and that is deliberate as of 2.3.9. It carried the attribute
# from 2.3.4 while all 15 of its own call sites discard the result — cycc warns
# `#must_use result of '_ser_sb_f64' is discarded` at every one. ⚠ `cyrius lint`
# does NOT report that class, so it only surfaces under `cyrius build`/`bench`,
# which is how it went unnoticed for two releases. The attribute was also
# inconsistent with its neighbours: none of the 40-odd `str_builder_add_cstr`
# calls in this file checks its return either. The failure mode here is OOM
# inside a str_builder, which the surrounding code does not handle at any site;
# marking one helper and not the rest bought nothing.
fn _ser_sb_f64(sb, bits) {
    var fb[64];
    var fl = bayan_f64_to_json(bits, &fb);
    store8(&fb + fl, 0);
    return str_builder_add_cstr(sb, &fb);
}

# Rgb -> JSON Str: {"r":..,"g":..,"b":..}.
#must_use
fn rgb_to_json(c) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (c == 0) { return 0; }
    # 2.3.5: emitted straight into a str_builder instead of through a bayan value
    # tree. See _ser_sb_f64 and the [2.3.5] CHANGELOG entry for why; output is
    # byte-identical and pinned in tests/serialize.tcyr.
    var sb = str_builder_new();
    if (sb == 0) { return 0; }
    str_builder_add_cstr(sb, "{\"r\":");
    _ser_sb_f64(sb, Rgb_r(c));
    str_builder_add_cstr(sb, ",\"g\":");
    _ser_sb_f64(sb, Rgb_g(c));
    str_builder_add_cstr(sb, ",\"b\":");
    _ser_sb_f64(sb, Rgb_b(c));
    str_builder_putc(sb, 125);
    return str_builder_build(sb);
}

# JSON -> Rgb. Sets err_out and returns 0 if r/g/b are not all present and
# numeric.
#must_use
fn rgb_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var r = _ser_num(v, "r", err_out);
    var g = _ser_num(v, "g", err_out);
    var b = _ser_num(v, "b", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var built = rgb_new(r, g, b);
    if (built == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return built;
}

# ── Medium (ray) ────────

# Medium -> JSON Str: {"n":..,"name":".."}. 0 for a null handle or a null name (2.15.1: a null
# name was read straight off address 0).
#must_use
fn medium_to_json(m) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (m == 0) { return 0; }
    if (Medium_name(m) == 0) { return 0; }
    # 2.3.5: emitted straight into a str_builder instead of through a bayan value
    # tree. See _ser_sb_f64 and the [2.3.5] CHANGELOG entry for why; output is
    # byte-identical and pinned in tests/serialize.tcyr.
    var sb = str_builder_new();
    if (sb == 0) { return 0; }
    str_builder_add_cstr(sb, "{\"n\":");
    _ser_sb_f64(sb, Medium_n(m));
    str_builder_add_cstr(sb, ",\"name\":");
    str_builder_add_json_str(sb, str_from(Medium_name(m)));
    str_builder_putc(sb, 125);
    return str_builder_build(sb);
}

# JSON -> Medium. Sets err_out and returns 0 if "n" is not numeric or "name" is
# not a string.
#must_use
fn medium_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var n = _ser_num(v, "n", err_out);
    var name = _ser_str(v, "name", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    # 2.2.6: was `_medium_mk(n, name)`, which skips the n >= 1.0 check that
    # medium_custom enforces — a document carrying "n": -0.5 minted a Medium
    # with a negative refractive index and reported PK_ERR_NONE. Routing
    # through medium_custom makes the decoder honour the same invariant as the
    # constructor, reporting PK_ERR_INVALID_INDEX instead.
    var built = medium_custom(n, name, err_out);
    if (built == 0) {
        if (prakash_is_err(load64(err_out)) == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    }
    return built;
}

