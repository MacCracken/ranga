# ── LensType (lens) ────────

# LensType -> JSON Str: bare "Converging" / "Diverging" (serde unit-variant); 0 for any other
# value (2.15.1: LENS_TYPE_INVALID and every unknown code were laundered into "Diverging", which
# decodes back as a valid lens type).
#must_use
fn lens_type_to_json(lt) {
    # 2.3.5: both variants are fixed ASCII with nothing JSON-escapable, so the
    # quoted form is a literal. This was 5 allocations and 472 ns to produce one
    # of two constant strings; it is now one str_from.
    if (lt == LENS_CONVERGING) {
        return str_from("\"Converging\"");
    }
    if (lt == LENS_DIVERGING) {
        return str_from("\"Diverging\"");
    }
    return 0;
}

# JSON -> LensType. Returns LENS_TYPE_INVALID (and sets err_out) for anything
# that is not one of the two unit-variant strings — 0 is already LENS_CONVERGING,
# so the return value alone cannot signal failure.
#must_use
fn lens_type_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    # The one decoder that does not enter through _ser_obj, so it needs its own.
    if (json == 0) {
        store64(err_out, PK_ERR_PARSE);
        return LENS_TYPE_INVALID;
    }
    var v = bayan_json_v_parse_buf(json, len);
    if (v == 0) {
        store64(err_out, PK_ERR_PARSE);
        return LENS_TYPE_INVALID;
    }
    if (bayan_json_v_is_str(v) == 0) {
        store64(err_out, PK_ERR_PARSE);
        return LENS_TYPE_INVALID;
    }
    var s = bayan_json_v_str(v);
    if (s == 0) {
        store64(err_out, PK_ERR_PARSE);
        return LENS_TYPE_INVALID;
    }
    var t = str_data(s);
    if (streq(t, "Converging") == 1) { return LENS_CONVERGING; }
    if (streq(t, "Diverging") == 1) { return LENS_DIVERGING; }
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return LENS_TYPE_INVALID;
}

