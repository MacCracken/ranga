# ── Observer ────────
var OBS_CIE1931 = 0;
var OBS_CIE1964 = 1;
var OBS_CIE2015_2DEG = 2;
var OBS_CIE2015_10DEG = 3;

# Color-matching-function table pointer for an observer.
#must_use
fn observer_cmf(obs) {
    if (obs == OBS_CIE1964) { return _cie1964(); }
    if (obs == OBS_CIE2015_2DEG) { return _cie2015_2(); }
    if (obs == OBS_CIE2015_10DEG) { return _cie2015_10(); }
    return _cie1931();
}

# Public CIE 1931 table pointer + fixed length (81 entries, 380-780nm @ 5nm).
#must_use
fn cie_1931_table() { return _cie1931(); }
# CIE 1964 10-degree observer CMF table (81 rows, 380-780 nm @ 5 nm).
#must_use
fn cie_1964_table() { return _cie1964(); }
# CIE 2015 (cone-fundamental-based) 2-degree observer CMF table (81 rows).
#must_use
fn cie_2015_2deg_table() { return _cie2015_2(); }
# CIE 2015 (cone-fundamental-based) 10-degree observer CMF table (81 rows).
#must_use
fn cie_2015_10deg_table() { return _cie2015_10(); }
# Row count shared by every CMF table: 81 (380-780 nm @ 5 nm).
#must_use
fn cie_cmf_len() { return 81; }

# ── XYZ tristimulus ────────

#derive(accessors)
struct Xyz { x; y; z; }

# Heap Xyz tristimulus {x, y, z}; 0 on allocation failure.
#must_use
fn xyz_new(x, y, z) {
    var v = alloc(sizeof(Xyz));
    if (v == 0) { return 0; }
    Xyz_set_x(v, x);
    Xyz_set_y(v, y);
    Xyz_set_z(v, z);
    return v;
}

# D65 white point with Y = 1: (0.95047, 1, 1.08883).
#must_use
fn xyz_d65_white() { return xyz_new(_cie_r(95047, 100000), F64_ONE, _cie_r(108883, 100000)); }
# D50 white point with Y = 1: (0.96422, 1, 0.82521).
#must_use
fn xyz_d50_white() { return xyz_new(_cie_r(96422, 100000), F64_ONE, _cie_r(82521, 100000)); }

# CIE xyY chromaticity (x, y, Y).
#derive(accessors)
struct XyY { x; y; big_y; }

fn _xyy_new(x, y, big_y) {
    var v = alloc(sizeof(XyY));
    if (v == 0) { return 0; }
    XyY_set_x(v, x);
    XyY_set_y(v, y);
    XyY_set_big_y(v, big_y);
    return v;
}

# XYZ -> xyY chromaticity; (0, 0, 0) when X + Y + Z < 1e-15.
#must_use
fn xyz_to_xyy(xyz) {
    if (xyz == 0) { return 0; }
    var sum = f64_add(f64_add(Xyz_x(xyz), Xyz_y(xyz)), Xyz_z(xyz));
    if (f64_lt(sum, _cie_eps15()) == 1) {
        return _xyy_new(f64_from(0), f64_from(0), f64_from(0));
    }
    return _xyy_new(f64_div(Xyz_x(xyz), sum), f64_div(Xyz_y(xyz), sum), Xyz_y(xyz));
}

# xyY -> XYZ; (0, 0, 0) when y < 1e-15.
#must_use
fn xyz_from_xyy(cx, cy, big_y) {
    if (f64_lt(cy, _cie_eps15()) == 1) {
        return xyz_new(f64_from(0), f64_from(0), f64_from(0));
    }
    return xyz_new(
      f64_mul(f64_div(cx, cy), big_y),
      big_y,
      f64_mul(f64_div(f64_sub(f64_sub(F64_ONE, cx), cy), cy), big_y));
}

# Linear sRGB (D65) from XYZ.
#must_use
fn xyz_to_linear_srgb(xyz) {
    if (xyz == 0) { return 0; }
    var o[24];
    _xyz_lin3(Xyz_x(xyz), Xyz_y(xyz), Xyz_z(xyz), &o);
    return rgb_new(load64(&o), load64(&o + 8), load64(&o + 16));
}

# The XYZ -> linear sRGB matrix into out[0..2]: the arithmetic xyz_to_linear_srgb always did,
# split out (2.15.1) so the sRGB paths can run it on the stack instead of allocating an Rgb.
fn _xyz_lin3(x, y, z, out) {
    var r = f64_sub(f64_sub(
        f64_mul(_cie_r(32404542, 10000000), x),
        f64_mul(_cie_r(15371385, 10000000), y)),
      f64_mul(_cie_r(4985314, 10000000), z));
    var g = f64_add(f64_add(
        f64_mul(f64_neg(_cie_r(9692660, 10000000)), x),
        f64_mul(_cie_r(18760108, 10000000), y)),
      f64_mul(_cie_r(415560, 10000000), z));
    var b = f64_add(f64_sub(
        f64_mul(_cie_r(556434, 10000000), x),
        f64_mul(_cie_r(2040259, 10000000), y)),
      f64_mul(_cie_r(10572252, 10000000), z));
    store64(out, r);
    store64(out + 8, g);
    store64(out + 16, b);
    return 0;
}

# Gamma-corrected, clamped sRGB of (x, y, z) as an Rgb, the only allocation.
fn _xyz_srgb_new(x, y, z) {
    var o[24];
    _xyz_lin3(x, y, z, &o);
    return rgb_new(
      f64_clamp(linear_to_srgb_gamma(load64(&o)), f64_from(0), F64_ONE),
      f64_clamp(linear_to_srgb_gamma(load64(&o + 8)), f64_from(0), F64_ONE),
      f64_clamp(linear_to_srgb_gamma(load64(&o + 16)), f64_from(0), F64_ONE));
}

# Gamma-corrected, clamped sRGB from XYZ. Allocates its result only (2.15.1: the linear and the
# unclamped intermediates were two more Rgbs, 48 bytes leaked per call).
#must_use
fn xyz_to_srgb(xyz) {
    if (xyz == 0) { return 0; }
    return _xyz_srgb_new(Xyz_x(xyz), Xyz_y(xyz), Xyz_z(xyz));
}

# XYZ from linear sRGB (inverse matrix).
#must_use
fn linear_srgb_to_xyz(rgb) {
    if (rgb == 0) { return 0; }
    var r = Rgb_r(rgb);
    var g = Rgb_g(rgb);
    var b = Rgb_b(rgb);
    return xyz_new(
      f64_add(f64_add(f64_mul(_cie_r(4124564, 10000000), r),
          f64_mul(_cie_r(3575761, 10000000), g)), f64_mul(_cie_r(1804375, 10000000), b)),
      f64_add(f64_add(f64_mul(_cie_r(2126729, 10000000), r),
          f64_mul(_cie_r(7151522, 10000000), g)), f64_mul(_cie_r(721750, 10000000), b)),
      f64_add(f64_add(f64_mul(_cie_r(193339, 10000000), r),
          f64_mul(_cie_r(1191920, 10000000), g)), f64_mul(_cie_r(9503041, 10000000), b)));
}

# ── sRGB gamma ────────

# linear -> sRGB gamma.
#must_use
fn linear_to_srgb_gamma(c) {
    if (f64_le(c, _cie_r(31308, 10000000)) == 1) {
        return f64_mul(_cie_r(1292, 100), c);
    }
    return f64_sub(
      f64_mul(_cie_r(1055, 1000), _prk_pow(c, f64_div(F64_ONE, _cie_r(24, 10)))),
      _cie_r(55, 1000));
}

# sRGB -> linear.
#must_use
fn srgb_gamma_to_linear(c) {
    if (f64_le(c, _cie_r(4045, 100000)) == 1) {
        return f64_div(c, _cie_r(1292, 100));
    }
    return _prk_pow(f64_div(f64_add(c, _cie_r(55, 1000)), _cie_r(1055, 1000)), _cie_r(24, 10));
}

# ── CCT ────────

# Correlated color temperature (K) from CIE 1931 xy (McCamy's approximation).
#must_use
fn cct_from_xy(cx, cy) {
    var n = f64_div(f64_sub(cx, _cie_r(3320, 10000)), f64_sub(_cie_r(1858, 10000), cy));
    return f64_add(f64_add(f64_add(
          f64_mul(f64_mul(f64_mul(f64_from(449), n), n), n),
          f64_mul(f64_mul(f64_from(3525), n), n)),
        f64_mul(_cie_r(68233, 10), n)),
      _cie_r(552033, 100));
}

# ── CMF interpolation ────────

# CIE 1931 CMF value at an arbitrary wavelength (linear interp; 0 outside range).
#must_use
fn cie_cmf_at(wavelength_nm) {
    var in_range = 0;
    if (f64_ge(wavelength_nm, f64_from(380)) == 1) {
        if (f64_le(wavelength_nm, f64_from(780)) == 1) {
            in_range = 1;
        }
    }
    if (in_range == 0) {
        return xyz_new(f64_from(0), f64_from(0), f64_from(0));
    }
    var t = _cie1931();
    # ⛔ 2.3.8: the lazy table builders now return 0 when their one-time
    # allocation fails (they used to store through it and SIGSEGV). A 0 here
    # must not be indexed — report the same degenerate answer this function
    # already gives for an out-of-domain input, rather than faulting.
    if (t == 0) { return xyz_new(f64_from(0), f64_from(0), f64_from(0)); }
    var idx_f = f64_div(f64_sub(wavelength_nm, f64_from(380)), f64_from(5));
    var idx = f64_to(idx_f);
    if (idx >= 80) {
        return xyz_new(_cmf_x(t, 80), _cmf_y(t, 80), _cmf_z(t, 80));
    }
    var frac = f64_sub(idx_f, f64_from(idx));
    return xyz_new(
      f64_add(_cmf_x(t, idx), f64_mul(frac, f64_sub(_cmf_x(t, idx + 1), _cmf_x(t, idx)))),
      f64_add(_cmf_y(t, idx), f64_mul(frac, f64_sub(_cmf_y(t, idx + 1), _cmf_y(t, idx)))),
      f64_add(_cmf_z(t, idx), f64_mul(frac, f64_sub(_cmf_z(t, idx + 1), _cmf_z(t, idx)))));
}

# ── Spectral power distribution ────────

# start_nm, step_nm, values (pointer to f64 array), len (count).
#derive(accessors)
struct Spd { start_nm; step_nm; values; len; }

# Spd of `len` samples from start_nm every step_nm. `values` is borrowed, not
# copied — the caller keeps it alive. 0 on allocation failure. Any grid is
# accepted, but colour integration reads only 380 + 5k nm — see spd_to_xyz
# before building a line spectrum on a fine grid.
#must_use
fn spd_new(start_nm, step_nm, values, len) {
    var s = alloc(sizeof(Spd));
    if (s == 0) { return 0; }
    Spd_set_start_nm(s, start_nm);
    Spd_set_step_nm(s, step_nm);
    Spd_set_values(s, values);
    Spd_set_len(s, len);
    return s;
}

# Equivalent to spd_new in Cyrius (no Cow distinction).
#must_use
fn spd_from_static(start_nm, step_nm, values, len) {
    return spd_new(start_nm, step_nm, values, len);
}

# Wavelength of the last sample: start + step*(len - 1). NaN for a null SPD (2.15.1: 0.0, which is
# also a legitimate answer).
#must_use
fn spd_end_nm(s) {
    # 2.2.8: see spd_at below — null-guarded at the dereference site.
    if (s == 0) { return _PRK_NAN; }
    return f64_add(Spd_start_nm(s), f64_mul(Spd_step_nm(s), f64_from(Spd_len(s) - 1)));
}

# Interpolate the SPD at a wavelength (0 outside range).
# NaN for a null SPD (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn spd_at(s, wavelength_nm) {
    # 2.2.8: a null handle used to be dereferenced here. `spd_from_json` is
    # DOCUMENTED to return 0 on malformed input, so the untrusted-JSON path ran
    # straight into spd_to_xyz(0) and killed the process with SIGSEGV — verified
    # end to end from a JSON document with a scalar `values` field. Guarding the
    # three dereference sites (spd_end_nm, spd_at, _spd_integrate) covers all
    # nine consumers at once: spd_to_xyz, spd_to_xyz_observer, spd_to_srgb and
    # the three photometry integrators.
    # ⛔ 2.4.8 STRUCK A FALSE CLAIM FROM THIS NOTE. It read "Null-guarding is
    # already the library-wide convention — ray_core, ray_trace, ray_system and
    # the wave_* accessors all do it; the Spd family was simply missed." That was
    # **not true of ray_system**: all five `== 0` tests in that file were
    # alloc-result checks, and every one of its seven Prescription consumers
    # dereferenced `prescription_from_json`'s documented 0, exiting 139. The same
    # defect, in the same shape, one module over — asserted as already-solved by
    # the very repair that should have gone looking. It is true now (2.4.8 guarded
    # all seven), but the lesson is that "the convention covers this" is a claim to
    # CHECK, not to state.
    if (s == 0) { return _PRK_NAN; }
    # An empty SPD has no value to interpolate. Without this, a zero step makes
    # idx_f = 0/0 = NaN and the `idx >= len - 1` branch reads _spd_val(vals, -1)
    # — a load from 8 bytes before the buffer. (The Rust original indexed a Vec
    # and panicked here rather than reading out of bounds.)
    if (Spd_len(s) <= 0) { return f64_from(0); }
    if (f64_lt(wavelength_nm, Spd_start_nm(s)) == 1) { return f64_from(0); }
    if (f64_gt(wavelength_nm, spd_end_nm(s)) == 1) { return f64_from(0); }
    var idx_f = f64_div(f64_sub(wavelength_nm, Spd_start_nm(s)), Spd_step_nm(s));
    var idx = f64_to(idx_f);
    var vals = Spd_values(s);
    var len = Spd_len(s);
    # A NaN or negative idx (zero/negative step) must not index backwards.
    if (idx < 0) { idx = 0; }
    if (idx >= len - 1) {
        return _spd_val(vals, len - 1);
    }
    var frac = f64_sub(idx_f, f64_from(idx));
    return f64_add(_spd_val(vals, idx),
      f64_mul(frac, f64_sub(_spd_val(vals, idx + 1), _spd_val(vals, idx))));
}

# Integrate an SPD against a CMF table (81 rows, 5nm), scaled by the 5nm step.
fn _spd_integrate(s, cmf) {
    var o[24];
    _spd_integrate3(s, cmf, &o);
    return xyz_new(load64(&o), load64(&o + 8), load64(&o + 16));
}

# _spd_integrate's sums into out[0..2] instead of a fresh Xyz (2.15.1), zeros for a null SPD or CMF.
fn _spd_integrate3(s, cmf, out) {
    store64(out, f64_from(0));
    store64(out + 8, f64_from(0));
    store64(out + 16, f64_from(0));
    # 2.2.8: same class as spd_at above.
    if (s == 0) { return 0; }
    if (cmf == 0) { return 0; }
    var x = f64_from(0);
    var y = f64_from(0);
    var z = f64_from(0);
    var aligned = 0;
    if (f64_lt(f64_abs(f64_sub(Spd_start_nm(s), f64_from(380))), _cie_eps10()) == 1) {
        if (f64_lt(f64_abs(f64_sub(Spd_step_nm(s), f64_from(5))), _cie_eps10()) == 1) {
            aligned = 1;
        }
    }
    var vals = Spd_values(s);
    var len = Spd_len(s);
    var i = 0;
    while (i < 81) {
        var power = f64_from(0);
        if (aligned == 1) {
            if (i < len) {
                power = _spd_val(vals, i);
            } else {
                power = spd_at(s, f64_add(f64_from(380), f64_mul(f64_from(i), f64_from(5))));
            }
        } else {
            power = spd_at(s, f64_add(f64_from(380), f64_mul(f64_from(i), f64_from(5))));
        }
        x = f64_add(x, f64_mul(power, _cmf_x(cmf, i)));
        y = f64_add(y, f64_mul(power, _cmf_y(cmf, i)));
        z = f64_add(z, f64_mul(power, _cmf_z(cmf, i)));
        i = i + 1;
    }
    store64(out, f64_mul(x, f64_from(5)));
    store64(out + 8, f64_mul(y, f64_from(5)));
    store64(out + 16, f64_mul(z, f64_from(5)));
    return 0;
}

# Integrate the SPD against the CIE 1931 2-degree CMFs -> Xyz.
# ⚠ LINE SPECTRA DO NOT SURVIVE THIS. The integral is a 5 nm rectangle rule at
# the 81 CIE wavelengths, and an SPD on any other grid is READ AT those points
# through spd_at — so a feature narrower than ~5 nm is weighted by where it
# happens to fall, not by its energy. Measured against a fine-grid integral of
# the same samples (2.5.1): a 1 nm-FWHM Gaussian line reads 4.70x at 590.0 nm
# (on a sample), 1.19x at 589.3 nm and 0 at 592.5 nm (between samples); a 0.1
# nm line at 589.3 nm reads 0. A 10 nm line is right to 0.04%. For discrete
# lines, sum I_k * cie_cmf_at(lambda_k) instead.
#must_use
fn spd_to_xyz(s) {
    _prk_trace("spd_to_xyz");
    return _spd_integrate(s, _cie1931());
}

# Integrate the SPD against the CMFs of `observer` (an OBS_* tag) -> Xyz.
#must_use
fn spd_to_xyz_observer(s, observer) { return _spd_integrate(s, observer_cmf(observer)); }

# SPD -> gamma-corrected, clamped sRGB (D65), scaled so Y = 1 first (unscaled when Y < 1e-15).
# Allocates its result only (2.15.1: the XYZ, the scaled XYZ and xyz_to_srgb's two intermediates
# were 96 bytes leaked per call).
#must_use
fn spd_to_srgb(s) {
    var xyz[24];
    _spd_integrate3(s, _cie1931(), &xyz);
    var norm = F64_ONE;
    if (f64_gt(load64(&xyz + 8), _cie_eps15()) == 1) {
        norm = f64_div(F64_ONE, load64(&xyz + 8));
    }
    var sx = f64_mul(load64(&xyz), norm);
    var sz = f64_mul(load64(&xyz + 16), norm);
    return _xyz_srgb_new(sx, f64_mul(load64(&xyz + 8), norm), sz);
}

# Planck radiance at 380, 385, ... 780 nm into values[0..80].
fn _bb_fill(values, temperature_k) {
    var i = 0;
    while (i < 81) {
        var wl_m = f64_mul(f64_from(380 + i * 5), _cie_r(1, 1000000000));
        store64(values + i * 8, planck_radiance(wl_m, temperature_k));
        i = i + 1;
    }
    return 0;
}

# Blackbody SPD at temperature_k, 5nm from 380-780nm (81 samples).
#must_use
fn spd_blackbody(temperature_k) {
    var values = alloc(648);
    if (values == 0) { return 0; }
    _bb_fill(values, temperature_k);
    return spd_new(f64_from(380), f64_from(5), values, 81);
}

# ── Standard illuminants ────────

# CIE standard illuminant D65 (daylight, ~6504 K): 81 samples, 380-780 nm @ 5 nm.
#must_use
fn illuminant_d65() { return spd_from_static(f64_from(380), f64_from(5), _illum_d65_data(), 81); }
# CIE standard illuminant D50 (horizon daylight, ~5003 K): 81 samples, 380-780 nm @ 5 nm.
#must_use
fn illuminant_d50() { return spd_from_static(f64_from(380), f64_from(5), _illum_d50_data(), 81); }
# ⚠ F2 AND F11 WERE BOTH WRONG UNTIL 2.2.7, AND THE PORT WAS NOT AT FAULT — the
# deleted Rust archive carries a byte-identical F11 table
# (`git show 524a7aa^:rust-old/src/spectral/cie.rs`, ILLUMINANT_F11_DATA), so the
# error predates the Cyrius translation. F11's emission lines sat at 440/565/615
# nm where CIE F11's are at 436/546/611; integrated against this file's own CMFs
# it produced (0.46141, 0.46385) against a published (0.38052, 0.37713).
# 75 of 81 F11 entries and 48 of 81 F2 entries were replaced from CIE 15:2004.
#
# ⚠ HOW THE REPLACEMENT WAS VALIDATED — two published quantities, neither of them
# fitted to. Integrating the new SPDs against this file's CIE 1931 CMFs:
#
#   illuminant   before            after             published CIE
#   F2           0.37546, 0.37184  0.37207, 0.37512  0.37208, 0.37529
#   F11          0.46141, 0.46385  0.38054, 0.37691  0.38052, 0.37713
#   D65          0.31272, 0.32903  unchanged         0.31271, 0.32902
#   A            0.44754, 0.40743  unchanged         0.44757, 0.40745
#
# and the correlated colour temperature, which no part of the transcription
# could have been tuned against, lands at 4007 K for F11 (nominal 4000) and
# 4230 K for F2 (nominal 4230). D65 and A were already correct and are untouched,
# which is what isolated the fault to these two tables in the first place.
#must_use
fn illuminant_f2() { return spd_from_static(f64_from(380), f64_from(5), _illum_f2_data(), 81); }
# CIE fluorescent illuminant F11 (narrow-band tri-phosphor, ~4000 K): 81 samples @ 5 nm.
#must_use
fn illuminant_f11() { return spd_from_static(f64_from(380), f64_from(5), _illum_f11_data(), 81); }

# Illuminant A (incandescent ~2856K): Planck normalized to 100 at 560nm.
#must_use
fn illuminant_a() {
    var values = alloc(648);
    if (values == 0) { return 0; }
    var norm = planck_radiance(_cie_r(56, 100000000), f64_from(2856));
    var i = 0;
    while (i < 81) {
        var wl_m = f64_mul(f64_from(380 + i * 5), _cie_r(1, 1000000000));
        store64(values + i * 8,
          f64_div(f64_mul(f64_from(100), planck_radiance(wl_m, f64_from(2856))), norm));
        i = i + 1;
    }
    return spd_new(f64_from(380), f64_from(5), values, 81);
}

# ── CRI ────────

# |test_norm - ref_norm| for one spectral band (5nm steps, CIE 1931 y weight).
fn _cri_band_delta(test_spd, ref_spd, test_y_total, ref_y_total, start, end) {
    var t = _cie1931();
    # ⛔ 2.4.8: the 2.3.8 sweep that added these guards missed this one.
    # The lazy table builders return 0 when their one-time allocation fails,
    # and a 0 indexed here is the SIGSEGV that sweep existed to remove.
    if (t == 0) { return f64_from(0); }
    var test_y = f64_from(0);
    var ref_y = f64_from(0);
    var wl = start;
    while (f64_le(wl, end) == 1) {
        var idx = f64_to(f64_div(f64_sub(wl, f64_from(380)), f64_from(5)));
        var cy = f64_from(0);
        if (idx < 81) {
            cy = _cmf_y(t, idx);
        }
        test_y = f64_add(test_y, f64_mul(spd_at(test_spd, wl), cy));
        ref_y = f64_add(ref_y, f64_mul(spd_at(ref_spd, wl), cy));
        wl = f64_add(wl, f64_from(5));
    }
    var test_norm = f64_from(0);
    if (f64_gt(test_y_total, _cie_eps15()) == 1) {
        test_norm = f64_div(test_y, test_y_total);
    }
    var ref_norm = f64_from(0);
    if (f64_gt(ref_y_total, _cie_eps15()) == 1) {
        ref_norm = f64_div(ref_y, ref_y_total);
    }
    return f64_abs(f64_sub(test_norm, ref_norm));
}

# 8-band spectral similarity of a test SPD against its reference illuminant,
# normalised to a 0-100 scale. Reference is D65 at or above 5000 K, a Planckian
# radiator of matching CCT below.
#
# ⚠ THIS IS NOT CIE 13.3 Ra, AND 2.2.7 RENAMED IT SO IT STOPS CLAIMING TO BE.
# CIE 13.3 requires eight Test Colour Samples with tabulated spectral
# reflectances, conversion into CIE 1964 W*U*V*, a von Kries chromatic
# adaptation, per-sample R_i = 100 - 4.6*dE_i, and Ra as their mean. This
# computes none of that: it compares NORMALISED ENERGY IN EIGHT FIXED
# WAVELENGTH BANDS. Measured against published Ra:
#
#   illuminant   this metric   published CIE Ra
#   D65          100.000       100 (reference, by definition)
#   A             99.996       100 (reference, by definition)
#   F2            97.196        64
#   F11           93.688        83
#
# The two reference illuminants come out right because any similarity metric
# scores an illuminant against itself as perfect; the two that carry real
# information are wrong by 33 and 11 points, and in F2's case it reports
# near-perfect rendering for a lamp that is notoriously poor. A caller comparing
# these numbers to a datasheet is being actively misled, which is why the honest
# name is the primary one now.
#
# ⚠ Implementing real Ra needs the eight TCS reflectance tables (8 x 81 values)
# from the CIE dataset. That is data this repo does not have, and reconstructing
# it is the same hazard documented at illuminant_f11 above.
# NaN for a null SPD (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn spectral_band_similarity(test_spd) {
    # 2.2.8: guarded to match its sibling color_rendering_index, which already
    # returned 0 for a null SPD. The two are documented as alternatives and
    # differed in whether one of them crashed.
    if (test_spd == 0) { return _PRK_NAN; }
    return _cri_impl(test_spd);
}

# 2.15.1: allocation-free. The XYZ, its xyY, the reference SPD (an 81-sample blackbody when it is
# one) and the reference XYZ were 784 bytes per call; they are this frame's now, the reference an
# Spd on the stack over a stack (or the static D65) table.
#must_use
fn _cri_impl(test_spd) {
    _prk_trace("color_rendering_index");
    var txyz[24];
    _spd_integrate3(test_spd, _cie1931(), &txyz);
    var tsum = f64_add(f64_add(load64(&txyz), load64(&txyz + 8)), load64(&txyz + 16));
    var cx = f64_from(0);
    var cy = f64_from(0);
    if (f64_lt(tsum, _cie_eps15()) == 0) {
        cx = f64_div(load64(&txyz), tsum);
        cy = f64_div(load64(&txyz + 8), tsum);
    }
    var test_cct = cct_from_xy(cx, cy);
    var rvals[648];
    var rs[32];
    if (f64_lt(test_cct, f64_from(5000)) == 1) {
        _bb_fill(&rvals, test_cct);
        Spd_set_values(&rs, &rvals);
    } else {
        Spd_set_values(&rs, _illum_d65_data());
    }
    Spd_set_start_nm(&rs, f64_from(380));
    Spd_set_step_nm(&rs, f64_from(5));
    Spd_set_len(&rs, 81);
    var ref_spd = &rs;
    var rxyz[24];
    _spd_integrate3(ref_spd, _cie1931(), &rxyz);
    var ty = load64(&txyz + 8);
    var ry = load64(&rxyz + 8);
    var s = _cri_band_delta(test_spd, ref_spd, ty, ry, f64_from(400), f64_from(450));
    s = f64_add(s, _cri_band_delta(test_spd, ref_spd, ty, ry, f64_from(450), f64_from(490)));
    s = f64_add(s, _cri_band_delta(test_spd, ref_spd, ty, ry, f64_from(490), f64_from(520)));
    s = f64_add(s, _cri_band_delta(test_spd, ref_spd, ty, ry, f64_from(520), f64_from(560)));
    s = f64_add(s, _cri_band_delta(test_spd, ref_spd, ty, ry, f64_from(560), f64_from(600)));
    s = f64_add(s, _cri_band_delta(test_spd, ref_spd, ty, ry, f64_from(600), f64_from(640)));
    s = f64_add(s, _cri_band_delta(test_spd, ref_spd, ty, ry, f64_from(640), f64_from(690)));
    s = f64_add(s, _cri_band_delta(test_spd, ref_spd, ty, ry, f64_from(690), f64_from(750)));
    var delta_e_avg = f64_div(s, f64_from(8));
    return f64_clamp(
      f64_sub(f64_from(100), f64_mul(f64_mul(_cie_r(46, 10), delta_e_avg), f64_from(100))),
      f64_from(0), f64_from(100));
}

# ── CIE 13.3 Colour Rendering Index ────────
#
# 2.2.7: real Ra, replacing the 8-band energy comparison that used to answer to
# this name (that metric survives as `spectral_band_similarity`; it scores F2 at
# 97.20 against a published Ra of 64). The data below is the missing half of the
# 2.2.6 note that said this "needs the CIE datasets": the eight Test Colour
# Sample reflectances and the D-illuminant S0/S1/S2 basis, both transcribed
# PROGRAMMATICALLY from colour-science's CIE 15:2004 / CIE 13.3 datasets — parsed
# from the source file rather than read off a page, because every hand
