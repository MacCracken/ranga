# Reflectance of Test Colour Sample `i` (1-8) at table index `j` (0-80).
#must_use
fn _cri_tcs_at(i, j) {
    if (i == 1) { return load64(_cri_tcs1() + j * 8); }
    if (i == 2) { return load64(_cri_tcs2() + j * 8); }
    if (i == 3) { return load64(_cri_tcs3() + j * 8); }
    if (i == 4) { return load64(_cri_tcs4() + j * 8); }
    if (i == 5) { return load64(_cri_tcs5() + j * 8); }
    if (i == 6) { return load64(_cri_tcs6() + j * 8); }
    if (i == 7) { return load64(_cri_tcs7() + j * 8); }
    return load64(_cri_tcs8() + j * 8);
}

# CIE D-illuminant at `t_k`, reconstructed from the S0/S1/S2 basis.
# xd is the two-branch cubic in 1/T; yd the quadratic in xd; M1/M2 the standard
# mixing coefficients. Used as the CRI reference above 5000 K.
#must_use
fn _cri_d_illuminant(t_k) {
    var inv = f64_div(F64_ONE, t_k);
    var inv2 = f64_mul(inv, inv);
    var inv3 = f64_mul(inv2, inv);
    var xd = f64_from(0);
    if (f64_lt(t_k, f64_from(7000)) == 1) {
        xd = f64_add(f64_add(f64_add(
              f64_mul(f64_neg(_cie_r(4607, 1)), f64_mul(inv3, f64_from(1000000))),
              f64_mul(_cie_r(29678, 10), f64_mul(inv2, f64_from(1000)))),
            f64_mul(_cie_r(9911, 100), inv)),
          _cie_r(244063, 1000000));
    } else {
        xd = f64_add(f64_add(f64_add(
              f64_mul(f64_neg(_cie_r(20064, 10)), f64_mul(inv3, f64_from(1000000))),
              f64_mul(_cie_r(19018, 10), f64_mul(inv2, f64_from(1000)))),
            f64_mul(_cie_r(24748, 100), inv)),
          _cie_r(237040, 1000000));
    }
    var yd = f64_add(f64_add(
        f64_mul(f64_neg(f64_from(3)), f64_mul(xd, xd)),
        f64_mul(_cie_r(287, 100), xd)),
      f64_neg(_cie_r(275, 1000)));
    var m = f64_add(f64_add(_cie_r(241, 10000),
        f64_mul(_cie_r(2562, 10000), xd)),
      f64_mul(f64_neg(_cie_r(7341, 10000)), yd));
    var m1 = f64_div(f64_add(f64_add(f64_neg(_cie_r(13515, 10000)),
          f64_mul(f64_neg(_cie_r(17703, 10000)), xd)),
        f64_mul(_cie_r(59114, 10000), yd)), m);
    var m2 = f64_div(f64_add(f64_add(_cie_r(300, 10000),
          f64_mul(f64_neg(_cie_r(314424, 10000)), xd)),
        f64_mul(_cie_r(300717, 10000), yd)), m);
    var vals = alloc(648);
    if (vals == 0) { return 0; }
    var s0 = _cri_s0();
    var s1 = _cri_s1();
    var s2 = _cri_s2();
    for (var i = 0; i < 81; i = i + 1) {
        store64(vals + i * 8, f64_add(f64_add(load64(s0 + i * 8),
              f64_mul(m1, load64(s1 + i * 8))),
            f64_mul(m2, load64(s2 + i * 8))));
    }
    return spd_new(f64_from(380), f64_from(5), vals, 81);
}

# CIE 1960 UCS (u, v) from a tristimulus triple, written into `out`.
fn _cri_uv(xyz, out) {
    var d = f64_add(f64_add(Xyz_x(xyz), f64_mul(f64_from(15), Xyz_y(xyz))),
      f64_mul(f64_from(3), Xyz_z(xyz)));
    if (f64_lt(f64_abs(d), _cie_eps15()) == 1) {
        store64(out, f64_from(0));
        store64(out + 8, f64_from(0));
        return 0;
    }
    store64(out, f64_div(f64_mul(f64_from(4), Xyz_x(xyz)), d));
    store64(out + 8, f64_div(f64_mul(f64_from(6), Xyz_y(xyz)), d));
    return 0;
}

# The von Kries c/d coefficients CIE 13.3 adapts with, into `out`.
fn _cri_cd(u, v, out) {
    if (f64_lt(f64_abs(v), _cie_eps15()) == 1) {
        store64(out, f64_from(0));
        store64(out + 8, f64_from(0));
        return 0;
    }
    store64(out, f64_div(f64_sub(f64_sub(f64_from(4), u), f64_mul(f64_from(10), v)), v));
    store64(out + 8, f64_div(f64_add(f64_sub(f64_mul(_cie_r(1708, 1000), v),
            f64_mul(_cie_r(1481, 1000), u)), _cie_r(404, 1000)), v));
    return 0;
}

# XYZ of `spd` seen through Test Colour Sample `i`.
#must_use
fn _cri_tcs_xyz(spd, i) {
    # ⚠ 2.2.8: FUSED. This used to allocate a 648-byte scratch SPD, fill it with
    # spd * reflectance, wrap it in a fresh Spd, and hand that to spd_to_xyz —
    # per sample, twice (test and reference), so SIXTEEN times per Ra call. On a
    # bump allocator that never frees, one color_rendering_index leaked roughly
    # 23.6 KB. Multiplying into the accumulator directly removes the scratch
    # buffer entirely.
    # ⚠ BIT-IDENTICAL, and the multiply ORDER is why: the old code computed
    # (power * tcs) and then multiplied by the CMF inside _spd_integrate, so the
    # fused loop keeps exactly that association — (power * tcs) * cmf, never
    # power * (tcs * cmf). Verified against the pinned Ra values, which did not
    # move by a single bit.
    var cmf = _cie1931();
    # ⛔ 2.4.8: the 2.3.8 sweep that added these guards missed this one.
    # The lazy table builders return 0 when their one-time allocation fails,
    # and a 0 indexed here is the SIGSEGV that sweep existed to remove.
    if (cmf == 0) { return xyz_new(f64_from(0), f64_from(0), f64_from(0)); }
    var x = f64_from(0);
    var y = f64_from(0);
    var z = f64_from(0);
    var aligned = 0;
    # ⚠ The two `==` below are RAW BIT COMPARISONS and are meant to be. `cycc`
    # warns "comparison mixes f64 and integer operands" on both (measured:
    # `cyrius check --with-deps` flags src/spectral_cie.cyr:2974 and :2975), because
    # a `#derive(accessors)` getter's return type is untracked and reads as a
    # tagged integer while `f64_from` yields an f64. ⛔ `cyrius lint` cannot see
    # this class at all, so the warning appears only under `check` — which is why
    # it sat unremarked. Do NOT "fix" it to `f64_eq`: this is an exact-alignment
    # test for the fast path (81 samples, 380 nm start, 5 nm step), where anything
    # other than bit-identical must take the interpolating path. hisab records the
    # identical false positive in its own suite for the same reason.
    if (Spd_len(spd) == 81) {
        if (Spd_start_nm(spd) == f64_from(380)) {
            if (Spd_step_nm(spd) == f64_from(5)) { aligned = 1; }
        }
    }
    var src = Spd_values(spd);
    for (var k = 0; k < 81; k = k + 1) {
        var power = f64_from(0);
        if (aligned == 1) {
            power = load64(src + k * 8);
        } else {
            power = spd_at(spd, f64_from(380 + k * 5));
        }
        var p = f64_mul(power, _cri_tcs_at(i, k));
        x = f64_add(x, f64_mul(p, _cmf_x(cmf, k)));
        y = f64_add(y, f64_mul(p, _cmf_y(cmf, k)));
        z = f64_add(z, f64_mul(p, _cmf_z(cmf, k)));
    }
    return xyz_new(f64_mul(x, f64_from(5)), f64_mul(y, f64_from(5)), f64_mul(z, f64_from(5)));
}

# W* of the CIE 1964 W*U*V* space: 25*Y^(1/3) - 17, Y normalised to 100.
#must_use
fn _cri_wstar(y_sample, y_source) {
    if (f64_lt(f64_abs(y_source), _cie_eps15()) == 1) { return f64_neg(f64_from(17)); }
    var yn = f64_div(f64_mul(f64_from(100), y_sample), y_source);
    if (f64_lt(yn, f64_from(0)) == 1) { yn = f64_from(0); }
    return f64_sub(f64_mul(f64_from(25), _prk_pow(yn, f64_div(F64_ONE, f64_from(3)))), f64_from(17));
}

# Shared, sample-INDEPENDENT half of a CRI evaluation, into a 7-slot context:
#   [0] ref_spd  [1] uk [2] vk  [3] ur [4] vr  [5] Yk [6] Yr  [7] ck [8] dk
#   [9] cr [10] dr
# Returns 0 if the test SPD is unusable.
#
# ⚠ 2.2.8: THIS SPLIT IS A 5x SAVING, NOT A TIDY-UP. Through 2.2.7,
# color_rendering_index called cri_special eight times and each call recomputed
# ALL of this — the test XYZ, the CCT, the entire reference SPD (which for the
# D-series branch means 81 basis mixes and a 648-byte allocation), the reference
# XYZ, and both u,v / c,d pairs. Only _cri_tcs_xyz actually varies with the
# sample index. Measured: 202us per Ra call before, and the bump allocator never
# frees, so a single Ra leaked roughly 16 KB.
# CIE 1960 (u, v) of a Planckian radiator at `t_k`, into `out`. Fused: no Spd
# and no scratch buffer, so it is cheap enough to call inside a search loop.
fn _cri_planck_uv2(t_k, u_out, v_out) {
    var cmf = _cie1931();
    # ⛔ 2.4.8: the 2.3.8 sweep that added these guards missed this one, which reports through out-pointers.
    # The lazy table builders return 0 when their one-time allocation fails,
    # and a 0 indexed here is the SIGSEGV that sweep existed to remove.
    if (cmf == 0) { store64(u_out, f64_from(0));
        store64(v_out, f64_from(0));
        return 0; }
    var x = f64_from(0);
    var y = f64_from(0);
    var z = f64_from(0);
    for (var i = 0; i < 81; i = i + 1) {
        var wl_m = f64_mul(f64_from(380 + i * 5), _cie_r(1, 1000000000));
        var pw = planck_radiance(wl_m, t_k);
        x = f64_add(x, f64_mul(pw, _cmf_x(cmf, i)));
        y = f64_add(y, f64_mul(pw, _cmf_y(cmf, i)));
        z = f64_add(z, f64_mul(pw, _cmf_z(cmf, i)));
    }
    var d = f64_add(f64_add(x, f64_mul(f64_from(15), y)), f64_mul(f64_from(3), z));
    if (f64_lt(f64_abs(d), _cie_eps15()) == 1) {
        store64(u_out, f64_from(0));
        store64(v_out, f64_from(0));
        return 0;
    }
    store64(u_out, f64_div(f64_mul(f64_from(4), x), d));
    store64(v_out, f64_div(f64_mul(f64_from(6), y), d));
    return 0;
}

# Squared CIE 1960 distance from (uk, vk) to the Planckian locus at `t_k`.
# Stack locals, not alloc: this runs inside the search loop below, and the bump
# allocator never frees.
#must_use
fn _cri_locus_dist2(t_k, uk, vk) {
    var uu = 0;
    var vv = 0;
    _cri_planck_uv2(t_k, &uu, &vv);
    var du = f64_sub(uu, uk);
    var dv = f64_sub(vv, vk);
    return f64_add(f64_mul(du, du), f64_mul(dv, dv));
}

# One golden-section pass over [lo, hi]: 22 steps, ONE new locus evaluation per
# step rather than the two a ternary search needs, and each evaluation is 81
# Planck exponentials. 0.618^22 ~ 1.3e-5 of the bracket width.
#must_use
fn _cri_golden(lo_in, hi_in, uk, vk) {
    var lo = lo_in;
    var hi = hi_in;
    var gr = _cie_r(6180339887, 10000000000);
    var m1 = f64_sub(hi, f64_mul(gr, f64_sub(hi, lo)));
    var m2 = f64_add(lo, f64_mul(gr, f64_sub(hi, lo)));
    var f1 = _cri_locus_dist2(m1, uk, vk);
    var f2 = _cri_locus_dist2(m2, uk, vk);
    for (var it = 0; it < 22; it = it + 1) {
        if (f64_lt(f1, f2) == 1) {
            hi = m2;
            m2 = m1;
            f2 = f1;
            m1 = f64_sub(hi, f64_mul(gr, f64_sub(hi, lo)));
            f1 = _cri_locus_dist2(m1, uk, vk);
        } else {
            lo = m1;
            m1 = m2;
            f1 = f2;
            m2 = f64_add(lo, f64_mul(gr, f64_sub(hi, lo)));
            f2 = _cri_locus_dist2(m2, uk, vk);
        }
    }
    return f64_div(f64_add(lo, hi), F64_TWO);
}

# Correlated colour temperature by minimising the CIE 1960 distance to the
# Planckian locus, seeded from McCamy's cubic and refined by golden-section search
# (`_cri_golden` above), widening the bracket whenever the minimum lands on an
# endpoint. Measured (2.4.9): recovers a blackbody's own temperature to within
# **0.077 K anywhere in 1000-25000 K** — pinned in tests/spectral_cie.tcyr.
#
# ⚠ 2.2.8: THE CRI REFERENCE USED TO COME STRAIGHT FROM McCAMY, whose cubic is
# an approximation, so the reference blackbody sat at the wrong temperature and
# a Planckian test source did not score Ra = 100 — which it must, being its own
# reference below 5000 K. Measured before: a 2000 K blackbody was assigned
# CCT 1981.4 K and scored Ra = 99.1024; 3400 K -> 3409.6 K, Ra = 99.7959.
# ⚠ 2.4.9 struck the sentence that followed, which described this search as "40
# ternary iterations over a +/-8% bracket". A later release replaced that with a
# 22-step golden section over +/-3%, and the description was never updated — so a
# reader checking "is the bracket wide enough?" was told +/-8%, which WOULD have
# contained the 1500 K case that +/-3% silently clamped (the 2.4.8 defect below).
# McCamy is deliberately LEFT ALONE as the public cct_from_xy: it is the
# documented, tested, published approximation and callers may want exactly it.
#
# ⛔ 2.4.8: A GOLDEN SECTION CANNOT FIND A MINIMUM OUTSIDE ITS BRACKET — IT
# RETURNS THE ENDPOINT, SILENTLY. The +/-3% bracket below was sized from McCamy's
# error "worst measured 18.6 K at 2000 K, i.e. 0.93%", and that measurement was
# taken only where the bracket already works. McCamy's real error is **+601 K
# (+50.1%) at 1200 K** and **-5533 K (-22.1%) at 25000 K**, so outside roughly
# 1630-11850 K the true minimum lay outside the bracket and this returned
# `seed * 0.97` or `seed * 1.03` with no diagnostic.
# ⚠ It reaches Ra. Below 5000 K a Planckian radiator IS its own CIE 13.3
# reference, so `color_rendering_index(spd_blackbody(T))` must be exactly 100.
# Measured before this repair: **1000 K -> 15.589**, 1200 K -> 63.938,
# 1500 K -> 95.300, 1600 K -> 99.222; correct only from ~1800 K up.
# The repair keeps the cheap bracket for the common case and WIDENS it when the
# converged point lands on an endpoint, which is the signal that the minimum is
# outside. In 1630-11850 K nothing changes and no extra locus evaluation is made;
# outside it the bracket grows 4x per round until the minimum is interior or the
# [1000, 25000] K domain is exhausted.
#must_use
fn _cri_cct_refine(uk, vk, seed) {
    if (f64_lt(seed, f64_from(1000)) == 1) { return seed; }
    if (f64_gt(seed, f64_from(25000)) == 1) { return seed; }
    var lo_lim = f64_from(1000);
    var hi_lim = f64_from(25000);
    var lo = f64_mul(seed, _cie_r(97, 100));
    var hi = f64_mul(seed, _cie_r(103, 100));
    var res = seed;
    for (var round = 0; round < 8; round = round + 1) {
        if (f64_lt(lo, lo_lim) == 1) { lo = lo_lim; }
        if (f64_gt(hi, hi_lim) == 1) { hi = hi_lim; }
        res = _cri_golden(lo, hi, uk, vk);
        var width = f64_sub(hi, lo);
        # 2% of the bracket: the golden section converges to ~1.3e-5 of the width,
        # so anything this close to an end IS the end.
        var edge = f64_mul(width, _cie_r(2, 100));
        var at_lo = f64_lt(res, f64_add(lo, edge));
        var at_hi = f64_gt(res, f64_sub(hi, edge));
        if (at_lo == 0) {
            if (at_hi == 0) { return res; }
        }
        # An endpoint that is also the domain edge is a real answer, not a clamp.
        if (at_lo == 1) {
            if (f64_le(lo, lo_lim) == 1) { return res; }
        }
        if (at_hi == 1) {
            if (f64_ge(hi, hi_lim) == 1) { return res; }
        }
        var grow = f64_mul(width, f64_from(3));
        if (at_lo == 1) {
            lo = f64_sub(lo, grow);
        } else {
            hi = f64_add(hi, grow);
        }
    }
    return res;
}

# Fills the caller's 88-byte ctx for test_spd and returns 1, or 0 if an allocation is refused.
# ⛔ 2.15.1: the context and four 16-byte scratch pairs were alloc()ed per call, 392 of the 1528
# bytes one Ra cost, on an allocator that never frees. They are the caller's stack now.
# It also returns 0, so the CRI is NaN, for a source CIE 13.3 gives no CRI: a CCT below 1000 K or
# NaN, or a chromaticity farther than DC = 5.4e-3 (CIE 1960 uv) from the Planckian locus at its
# CCT (CIE 13.3-1995 sec. 5.3: "not sufficiently white"). The refinement searches 1000-25000 K, so
# a cooler source converges on the 1000 K edge and DC is what shows it: an 800 K blackbody is
# 0.052 from the locus at 1000 K, and scored Ra = 82.9 against that wrong reference (2.15.1).
# Every illuminant the library ships passes, the farthest E at 4.4e-3.
#must_use
fn _cri_context(test_spd, ctx) {
    var t_xyz = spd_to_xyz(test_spd);
    if (t_xyz == 0) { return 0; }
    var xyy = xyz_to_xyy(t_xyz);
    var t_cct = cct_from_xy(XyY_x(xyy), XyY_y(xyy));
    var uv0[16];
    _cri_uv(t_xyz, &uv0);
    t_cct = _cri_cct_refine(load64(&uv0), load64(&uv0 + 8), t_cct);
    if (f64_ge(t_cct, f64_from(1000)) == 0) { return 0; }
    if (f64_le(_cri_locus_dist2(t_cct, load64(&uv0), load64(&uv0 + 8)), 0x3EFE9393F10E1FA9) == 0) { return 0; }
    # 2.4.9: choose the reference, THEN build it. This used to construct the full
    # 81-sample D-series SPD first and overwrite it with the blackbody whenever the
    # source was below 5000 K — on a bump allocator that never frees, a discarded
    # 680-byte reference per CRI call for every warm source (illuminant A, every
    # incandescent, every Planckian below 5000 K).
    var ref_spd = 0;
    if (f64_lt(t_cct, f64_from(5000)) == 1) {
        ref_spd = spd_blackbody(t_cct);
    } else {
        ref_spd = _cri_d_illuminant(t_cct);
    }
    if (ref_spd == 0) { return 0; }
    var r_xyz = spd_to_xyz(ref_spd);
    if (r_xyz == 0) { return 0; }
    var uv[16];
    var cd[16];
    store64(ctx, ref_spd);
    _cri_uv(t_xyz, &uv);
    store64(ctx + 8, load64(&uv));
    store64(ctx + 16, load64(&uv + 8));
    _cri_cd(load64(&uv), load64(&uv + 8), &cd);
    store64(ctx + 56, load64(&cd));
    store64(ctx + 64, load64(&cd + 8));
    _cri_uv(r_xyz, &uv);
    store64(ctx + 24, load64(&uv));
    store64(ctx + 32, load64(&uv + 8));
    _cri_cd(load64(&uv), load64(&uv + 8), &cd);
    store64(ctx + 72, load64(&cd));
    store64(ctx + 80, load64(&cd + 8));
    store64(ctx + 40, Xyz_y(t_xyz));
    store64(ctx + 48, Xyz_y(r_xyz));
    return 1;
}

# R_i for sample `i` given a prepared context. The only per-sample work.
#must_use
fn _cri_ri(test_spd, ctx, i) {
    var ref_spd = load64(ctx);
    var ki_xyz = _cri_tcs_xyz(test_spd, i);
    var ri_xyz = _cri_tcs_xyz(ref_spd, i);
    if (ki_xyz == 0) { return _PRK_NAN; }
    if (ri_xyz == 0) { return _PRK_NAN; }
    var uv[16];
    var cd[16];
    _cri_uv(ki_xyz, &uv);
    var uki = load64(&uv);
    var vki = load64(&uv + 8);
    _cri_cd(uki, vki, &cd);
    var cki = load64(&cd);
    var dki = load64(&cd + 8);
    _cri_uv(ri_xyz, &uv);
    var uri = load64(&uv);
    var vri = load64(&uv + 8);

    var ur = load64(ctx + 24);
    var vr = load64(ctx + 32);
    var ck = load64(ctx + 56);
    var dk = load64(ctx + 64);
    var cr = load64(ctx + 72);
    var dr = load64(ctx + 80);
    if (f64_lt(f64_abs(ck), _cie_eps15()) == 1) { return _PRK_NAN; }
    if (f64_lt(f64_abs(dk), _cie_eps15()) == 1) { return _PRK_NAN; }
    var ct = f64_mul(f64_div(cr, ck), cki);
    var dt = f64_mul(f64_div(dr, dk), dki);
    var den = f64_sub(f64_add(_cie_r(16518, 1000), f64_mul(_cie_r(1481, 1000), ct)), dt);
    if (f64_lt(f64_abs(den), _cie_eps15()) == 1) { return _PRK_NAN; }
    var uk2 = f64_div(f64_sub(f64_add(_cie_r(10872, 1000), f64_mul(_cie_r(404, 1000), ct)),
        f64_mul(f64_from(4), dt)), den);
    var vk2 = f64_div(_cie_r(5520, 1000), den);

    var wk = _cri_wstar(Xyz_y(ki_xyz), load64(ctx + 40));
    var wr = _cri_wstar(Xyz_y(ri_xyz), load64(ctx + 48));
    var uk = f64_mul(f64_mul(f64_from(13), wk), f64_sub(uk2, ur));
    var vk = f64_mul(f64_mul(f64_from(13), wk), f64_sub(vk2, vr));
    var uu = f64_mul(f64_mul(f64_from(13), wr), f64_sub(uri, ur));
    var vv = f64_mul(f64_mul(f64_from(13), wr), f64_sub(vri, vr));
    var dw = f64_sub(wk, wr);
    var du = f64_sub(uk, uu);
    var dv = f64_sub(vk, vv);
    var de = f64_sqrt(f64_add(f64_add(f64_mul(dw, dw), f64_mul(du, du)), f64_mul(dv, dv)));
    return f64_sub(f64_from(100), f64_mul(_cie_r(46, 10), de));
}

# Special Colour Rendering Index R_i for Test Colour Sample `i` (1-8).
# 100 - 4.6*dE, dE in CIE 1964 W*U*V* after the von Kries adaptation above.
#
# ⚠ 2.2.8 SPLIT THE FAILURE SENTINELS, because 0.0 is a LEGITIMATE R_i — a
# source that renders a sample badly enough scores 0, and a very bad one scores
# NEGATIVE — so returning 0.0 on failure was indistinguishable from an answer.
#   - an INTERNAL failure (allocation refused, degenerate von Kries denominator)
#     returns NaN, which is never a valid R_i and propagates visibly through
#     color_rendering_index's mean rather than quietly dragging it toward zero.
#   - a null SPD, or an index outside 1..8, returned 0.0 until 2.15.1, "the documented, tested
#     contract". It was the same ambiguity, and it is NaN now too.
#must_use
fn cri_special(test_spd, i) {
    if (test_spd == 0) { return _PRK_NAN; }
    if (i < 1) { return _PRK_NAN; }
    if (i > 8) { return _PRK_NAN; }
    var ctx[88];
    # An internal failure is NaN, as the note above says: until 2.15.1 a refused allocation
    # here returned 0.0, which is a legitimate R_i.
    if (_cri_context(test_spd, &ctx) == 0) { return _PRK_NAN; }
    return _cri_ri(test_spd, &ctx, i);
}

# General Colour Rendering Index Ra: the mean of R1..R8.
#
# ⚠ 2.2.7 REPLACED THIS FUNCTION'S ALGORITHM ENTIRELY. Through 2.2.6 it returned
# an 8-band normalised-energy comparison that scored F2 at 98.29 (on the
# pre-2.2.7 F2 table; 97.20 on the corrected one) where the
# published CIE Ra is 64 — a lamp famous for poor rendering reported as nearly
# perfect. That metric is still available, honestly named, as
# `spectral_band_similarity`; this is now real CIE 13.3.
# NaN for a null SPD (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn color_rendering_index(test_spd) {
    _prk_trace("color_rendering_index");
    if (test_spd == 0) { return _PRK_NAN; }
    var ctx[88];
    # An internal failure is NaN, as for cri_special (2.15.1: it was 0.0, a legitimate Ra).
    if (_cri_context(test_spd, &ctx) == 0) { return _PRK_NAN; }
    var sum = f64_from(0);
    for (var i = 1; i <= 8; i = i + 1) {
        sum = f64_add(sum, _cri_ri(test_spd, &ctx, i));
    }
    return f64_div(sum, f64_from(8));
}

# --- spectral_photometry.cyr ---

# spectral_photometry.cyr -- radiometric-to-photometric conversion via V(lambda)
# Usage: include "lib/spectral_photometry.cyr"
#   (requires error.cyr, spectral_core.cyr, spectral_cie.cyr for Spd + spd_at)
#
# Ported from the Rust `spectral/photometry.rs`. The two 81-value luminous-
# efficiency tables (photopic V and scotopic V') are lazily-initialized flat f64
# buffers of exact IEEE-754 hex bit patterns generated from the Rust source.

fn _vl(t, i) { return load64(t + i * 8); }
# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _phot_eps15() { return 0x3CD203AF9EE75616; }

# ── V(lambda) tables (generated: exact IEEE-754 hex from spectral/photometry.rs) ──

var _vlambda_photopic_p = 0;
fn _vlambda_photopic() {
    if (_vlambda_photopic_p != 0) { return _vlambda_photopic_p; }
    var t = alloc(648);
    if (t == 0) { return 0; }
    store64(t + 0, 0x3F04727DCBDDB984);
    store64(t + 8, 0x3F10C6F7A0B5ED8D);
    store64(t + 16, 0x3F1F75104D551D69);
