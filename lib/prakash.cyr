# --- error.cyr ---

# error.cyr -- prakash error codes
# Usage: include "lib/error.cyr"
#
# Replaces Rust's PrakashError enum with integer error codes. Functions return
# PK_ERR_NONE (0) on success or a negative PK_ERR_* code on failure. Where a
# function also returns an f64 result, it takes an `err_out` pointer and writes
# the code there. Detailed failure context (angles, indices) is logged via
# sakshi at the failure site rather than carried in the return value.
#
# Pairs with tagged.cyr for Result-like patterns when an Option is needed.

var PK_ERR_NONE                  = 0;

# Total internal reflection — incident angle exceeds the critical angle.
var PK_ERR_TIR               = (0 - 1);
# Refractive index is below the physical minimum of 1.0.
var PK_ERR_INVALID_INDEX     = (0 - 2);
# Wavelength is outside the visible range (380-780 nm).
var PK_ERR_WAVELENGTH_RANGE  = (0 - 3);
# Angle is outside the valid range (0-90 deg) for a surface interaction.
var PK_ERR_INVALID_ANGLE     = (0 - 4);
# Negative focal length where a positive one is required.
var PK_ERR_INVALID_FOCAL     = (0 - 5);
# Division by zero in an optical calculation.
var PK_ERR_DIVISION_BY_ZERO  = (0 - 6);
# A parameter is outside the valid range for the operation. Also covers an
# out-of-range buffer index and a null handle passed to an accessor.
var PK_ERR_INVALID_PARAMETER = (0 - 7);
# An allocation was refused — the request exceeds ALLOC_MAX (2 GiB), the size
# computation overflowed, or the heap is exhausted. Distinct from
# PK_ERR_INVALID_PARAMETER: the arguments were sane, the memory was not there.
var PK_ERR_ALLOCATION        = (0 - 8);
# The input bytes are not well-formed JSON, or the document is not of the type
# the decoder expected (e.g. an array where an object was required). Distinct
# from PK_ERR_INVALID_PARAMETER, which means the document parsed but a required
# field was absent or of the wrong type — bad bytes vs. wrong schema.
var PK_ERR_PARSE             = (0 - 9);

# 1 if `code` is an error (negative), else 0.
#must_use
fn prakash_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# 1 if `code` is success (PK_ERR_NONE), else 0.
#must_use
fn prakash_is_ok(code) {
    if (code == 0) { return 1; }
    return 0;
}

# ── Rust-semantics math shims ────────
# The Cyrius math builtins diverge from Rust's f64 methods at the infinite and
# zero boundaries, because `ganita_f64_pow` is implemented as `exp(n*ln(base))`
# and the x87 `exp` returns NaN for an infinite argument. Every ported call site
# that can reach those boundaries goes through these shims so the port keeps
# matching `rust-old/`. Measured on cyrius 6.5.20, x86_64:
#
#   expression              Cyrius builtin   Rust           shim
#   ganita_f64_pow(0.0, 2)  NaN              0.0            0.0
#   f64_exp(-inf)           NaN              0.0            0.0
#   f64_exp(+inf)           NaN              +inf           +inf
#
# Finite arguments are delegated unchanged, so no in-range result moves.

# Rust `f64::exp` semantics. Only the infinite arguments are special-cased;
# NaN in still gives NaN out, matching Rust.
#must_use
fn _prk_exp(x) {
    if (x == 0x7FF0000000000000) { return 0x7FF0000000000000; }
    if (x == 0xFFF0000000000000) { return 0; }
    return f64_exp(x);
}

# Sine/cosine with an explicit domain guard. The x86 `fsin`/`fcos` instructions
# are undefined for |x| >= 2^63 and return the ARGUMENT UNCHANGED there, so
# `f64_sin(1e300)` yields 1e300 — an "intensity" far outside [-1, 1] that then
# propagates silently through an interference or slit calculation. Measured on
# cyrius 6.5.20: correct through 2^62, broken at 1e300 and at the infinities.
#
# Beyond 2^63 a double's spacing exceeds 2048 while a period is 2*pi, so the
# argument no longer identifies a phase at all and the result is unrecoverable
# without Payne-Hanek reduction. prakash reports the loss instead of inventing a
# value: these return NaN, which propagates visibly. (Rust's libm would perform
# the full reduction and return a value; this is a deliberate, documented
# divergence in favour of not fabricating.) Below the limit both delegate
# unchanged, so no in-range result moves.
var _PRK_TRIG_LIMIT = 0x43E0000000000000;   # 2^63
var _PRK_NAN        = 0x7FF8000000000000;

#must_use
fn _prk_sin(x) {
    if (f64_lt(f64_abs(x), _PRK_TRIG_LIMIT) == 0) { return _PRK_NAN; }
    return f64_sin(x);
}

#must_use
fn _prk_cos(x) {
    if (f64_lt(f64_abs(x), _PRK_TRIG_LIMIT) == 0) { return _PRK_NAN; }
    return f64_cos(x);
}

# Rust `f64::powf` semantics for a non-negative base. `ganita_f64_pow` computes
# exp(n*ln(base)), so a zero base gives exp(-inf) = NaN where Rust gives
# 0.0 (positive exponent), 1.0 (zero exponent) or +inf (negative exponent).
# A negative base is delegated unchanged: Rust's powf is also NaN there for a
# non-integer exponent, and no prakash call site passes a negative base.
#must_use
fn _prk_pow(base, exp) {
    if (f64_abs(base) == 0) {
        if (f64_gt(exp, 0) == 1) { return 0; }
        if (f64_lt(exp, 0) == 1) { return 0x7FF0000000000000; }
        return F64_ONE;
    }
    return ganita_f64_pow(base, exp);
}

# ── Logging (sakshi) ────────
# Ports the Rust `tracing::trace!` diagnostics. Consumers set the level with
# prakash_set_log_level(SK_TRACE) to see operation-entry traces; the default
# (SK_INFO) leaves them off. `_prk_trace` is a thin wrapper the optics modules
# call at operation entry — sakshi_trace is compile-elidable (#if SAKSHI_LEVEL)
# and runtime-guarded, so it is near-free when trace is disabled.

# Set the global log level (SK_OFF/ERROR/WARN/INFO/DEBUG/TRACE from sakshi).
fn prakash_set_log_level(level) {
    return sakshi_set_level(level);
}

# Emit a TRACE-level operation marker (the Rust trace!("op") equivalent).
fn _prk_trace(name) {
    sakshi_trace(name, strlen(name));
    return 0;
}

# --- ray_core.cyr ---

# ray_core.cyr -- geometric (ray) optics core
# Usage: include "lib/ray_core.cyr"  (requires error.cyr for PK_ERR_*)
#
# Reflection, refraction, Snell's law, and the common-material refractive-index
# database. Ported from the Rust `ray/mod.rs`. All angles are in radians unless a
# name says otherwise.
#
# f64 note: values are IEEE-754 bit patterns. Non-integer literals are written as
# ratios `f64_div(f64_from(num), f64_from(den))` because `f64_from` takes an
# integer (a decimal literal would decode to NaN). Transcendentals come from the
# stdlib f64 builtins (`f64_sin`, `f64_sqrt`) and ganita (`ganita_f64_asin`).
#
# Errors: functions that can fail take an `err_out` pointer and write `PK_ERR_NONE`
# or a negative `PK_ERR_*` code there, returning 0 on failure.
#
# `snell_3d` lives with the Fresnel module (ray_fresnel.cyr) since it needs the
# Fresnel s/p reflectances.

# 3D / 2D f64 vectors for direction and normal args. Layout matches hisab HVec3
# ── hisab interop contract (2.1.2) ────────
# RayVec3 is `{ x; y; z; }` — byte-identical to hisab's HVec3 (x@0, y@8, z@16).
# This is a GUARANTEE, not a coincidence: a RayVec3 pointer IS an HVec3 pointer,
# so all 26 of hisab's `hvec3_*` operations (dot, cross, normalize, reflect,
# project, angle, …) work on prakash vectors with zero conversion, and hisab
# results read back through the RayVec3 accessors. `tests/hisab_interop.tcyr`
# pins the layout, the field order, and that `ray_reflect_3d` agrees with
# `hvec3_reflect`; changing either struct breaks that suite rather than silently
# corrupting a consumer.
#
# prakash deliberately does NOT call hvec3_* internally. Measured: routing the
# tracer's dot products through `hvec3_dot` costs 2-11% on ray/trace_surface,
# ray/trace_sequential and ray/fresnel_unpolarized, because it is two nested
# calls (hvec3_dot -> f64v_dot) where the inline form is straight-line
# arithmetic. The contract exists for consumers; the hot paths stay inline.
#derive(accessors)
struct RayVec3 { x; y; z; }

#derive(accessors)
struct RayVec2 { x; y; }

#must_use
fn ray_vec3(x, y, z) {
    var v = alloc(sizeof(RayVec3));
    if (v == 0) { return 0; }
    RayVec3_set_x(v, x);
    RayVec3_set_y(v, y);
    RayVec3_set_z(v, z);
    return v;
}

#must_use
fn ray_vec2(x, y) {
    var v = alloc(sizeof(RayVec2));
    if (v == 0) { return 0; }
    RayVec2_set_x(v, x);
    RayVec2_set_y(v, y);
    return v;
}

# ── Refractive indices for common materials (at ~589 nm, sodium D line) ──────

# Medium: { n: refractive index (>= 1.0), name: cstr }.
#derive(accessors)
struct Medium { n; name; }

# Internal unchecked constructor.
fn _medium_mk(n, name) {
    var m = alloc(sizeof(Medium));
    if (m == 0) { return 0; }
    Medium_set_n(m, n);
    Medium_set_name(m, name);
    return m;
}

#must_use
fn medium_vacuum() { return _medium_mk(F64_ONE, "vacuum"); }
#must_use
fn medium_air() { return _medium_mk(f64_div(f64_from(1000293), f64_from(1000000)), "air"); }
#must_use
fn medium_water() { return _medium_mk(f64_div(f64_from(1333), f64_from(1000)), "water"); }
#must_use
fn medium_glass() { return _medium_mk(f64_div(f64_from(152), f64_from(100)), "glass"); }
#must_use
fn medium_crown_glass() { return _medium_mk(f64_div(f64_from(1523), f64_from(1000)), "crown glass"); }
#must_use
fn medium_flint_glass() { return _medium_mk(f64_div(f64_from(162), f64_from(100)), "flint glass"); }
#must_use
fn medium_diamond() { return _medium_mk(f64_div(f64_from(2417), f64_from(1000)), "diamond"); }
#must_use
fn medium_ice() { return _medium_mk(f64_div(f64_from(131), f64_from(100)), "ice"); }
#must_use
fn medium_quartz() { return _medium_mk(f64_div(f64_from(1544), f64_from(1000)), "quartz"); }
#must_use
fn medium_sapphire() { return _medium_mk(f64_div(f64_from(177), f64_from(100)), "sapphire"); }
#must_use
fn medium_acrylic() { return _medium_mk(f64_div(f64_from(149), f64_from(100)), "acrylic"); }
#must_use
fn medium_polycarbonate() { return _medium_mk(f64_div(f64_from(1585), f64_from(1000)), "polycarbonate"); }

# Custom medium with a given refractive index. Writes PK_ERR_INVALID_INDEX and
# returns 0 if n < 1.0.
#must_use
fn medium_custom(n, name, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (f64_lt(n, F64_ONE) == 1) {
        store64(err_out, PK_ERR_INVALID_INDEX);
        return 0;
    }
    return _medium_mk(n, name);
}

# Relative dielectric permittivity (eps_r = n^2). Bridges to bijli's EM
# permittivity; for non-magnetic materials n = sqrt(eps_r).
#must_use
fn medium_permittivity(m) {
    var n = Medium_n(m);
    return f64_mul(n, n);
}

# ── Snell's Law ────────

# Apply Snell's law: n1 sin(t1) = n2 sin(t2). Returns the refracted angle in
# radians, or writes PK_ERR_TIR (and returns 0) on total internal reflection.
#must_use
fn ray_snell(n1, n2, incident_angle, err_out) {
    _prk_trace("snell");
    store64(err_out, PK_ERR_NONE);
    var sin_t = f64_mul(f64_div(n1, n2), _prk_sin(incident_angle));
    if (f64_gt(f64_abs(sin_t), F64_ONE) == 1) {
        store64(err_out, PK_ERR_TIR);
        return 0;
    }
    return ganita_f64_asin(sin_t);
}

# Critical angle for total internal reflection (requires n1 > n2). Writes
# PK_ERR_INVALID_PARAMETER (returns 0) if n1 <= n2.
#must_use
fn ray_critical_angle(n1, n2, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (f64_le(n1, n2) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return ganita_f64_asin(f64_div(n2, n1));
}

# ── Reflection ────────

# Angle of reflection equals angle of incidence.
#must_use
fn ray_reflect_angle(incident_angle) {
    return incident_angle;
}

# Reflect a 2D direction vector about a surface normal (both normalized).
#must_use
fn ray_reflect_2d(direction, normal) {
    var dx = RayVec2_x(direction);
    var dy = RayVec2_y(direction);
    var nx = RayVec2_x(normal);
    var ny = RayVec2_y(normal);
    var dot = f64_add(f64_mul(dx, nx), f64_mul(dy, ny));
    var two_dot = f64_mul(F64_TWO, dot);
    return ray_vec2(
    f64_sub(dx, f64_mul(two_dot, nx)),
    f64_sub(dy, f64_mul(two_dot, ny)));
}

# Reflect a 3D direction vector about a surface normal (both normalized).
#must_use
fn ray_reflect_3d(direction, normal) {
    var dx = RayVec3_x(direction);
    var dy = RayVec3_y(direction);
    var dz = RayVec3_z(direction);
    var nx = RayVec3_x(normal);
    var ny = RayVec3_y(normal);
    var nz = RayVec3_z(normal);
    var dot = f64_add(f64_add(f64_mul(dx, nx), f64_mul(dy, ny)), f64_mul(dz, nz));
    var two_dot = f64_mul(F64_TWO, dot);
    return ray_vec3(
    f64_sub(dx, f64_mul(two_dot, nx)),
    f64_sub(dy, f64_mul(two_dot, ny)),
    f64_sub(dz, f64_mul(two_dot, nz)));
}

# Refract a 3D direction through a surface (vector form of Snell's law):
#   t = ratio*d + (ratio*cos_i - cos_t)*n
# with ratio = n1/n2, cos_i = -(d.n), cos_t = sqrt(1 - ratio^2 (1 - cos_i^2)).
# Returns the refracted RayVec3, or writes PK_ERR_TIR (returns 0) if the
# discriminant is negative. `direction` and outward `normal` should be normalized.
#must_use
fn ray_refract_3d(direction, normal, n1, n2, err_out) {
    store64(err_out, PK_ERR_NONE);
    var dx = RayVec3_x(direction);
    var dy = RayVec3_y(direction);
    var dz = RayVec3_z(direction);
    var nx = RayVec3_x(normal);
    var ny = RayVec3_y(normal);
    var nz = RayVec3_z(normal);
    var ratio = f64_div(n1, n2);
    var dot = f64_add(f64_add(f64_mul(dx, nx), f64_mul(dy, ny)), f64_mul(dz, nz));
    var cos_i = f64_neg(dot);
    var sin2_t = f64_mul(f64_mul(ratio, ratio), f64_sub(F64_ONE, f64_mul(cos_i, cos_i)));
    if (f64_gt(sin2_t, F64_ONE) == 1) {
        store64(err_out, PK_ERR_TIR);
        return 0;
    }
    var cos_t = f64_sqrt(f64_sub(F64_ONE, sin2_t));
    var factor = f64_sub(f64_mul(ratio, cos_i), cos_t);
    return ray_vec3(
    f64_add(f64_mul(ratio, dx), f64_mul(factor, nx)),
    f64_add(f64_mul(ratio, dy), f64_mul(factor, ny)),
    f64_add(f64_mul(ratio, dz), f64_mul(factor, nz)));
}

# ── Utility ────────

# Convert degrees to radians.
#must_use
fn ray_deg_to_rad(deg) {
    return f64_mul(deg, f64_div(F64_PI, f64_from(180)));
}

# Convert radians to degrees.
#must_use
fn ray_rad_to_deg(rad) {
    return f64_mul(rad, f64_div(f64_from(180), F64_PI));
}

# --- ray_fresnel.cyr ---

# ray_fresnel.cyr -- Fresnel equations (real + complex), Brewster, Beer-Lambert
# Usage: include "lib/ray_fresnel.cyr"  (requires error.cyr, ray_core.cyr)
#
# Ported from the Rust `ray/fresnel.rs`, plus `snell_3d` (which needs the s/p
# reflectances). All angles in radians. f64 values are bit patterns; see
# ray_core.cyr for the f64 conventions.

# Denominator-underflow guards (Rust used 1e-15 / 1e-30 literals).
fn _fr_eps15() { return f64_div(F64_ONE, f64_from(1000000000000000)); }
fn _fr_eps30() {
    var e = f64_div(F64_ONE, f64_from(1000000000000000));
    return f64_mul(e, e);
}

# ── Fresnel equations (real refractive index) ────────

# Fresnel reflectance for s-polarized light (TE mode).
#must_use
fn fresnel_s(n1, n2, cos_i, cos_t) {
    var num = f64_sub(f64_mul(n1, cos_i), f64_mul(n2, cos_t));
    var den = f64_add(f64_mul(n1, cos_i), f64_mul(n2, cos_t));
    if (f64_lt(f64_abs(den), _fr_eps15()) == 1) {
        return F64_ONE;
    }
    var r = f64_div(num, den);
    return f64_mul(r, r);
}

# Fresnel reflectance for p-polarized light (TM mode).
#must_use
fn fresnel_p(n1, n2, cos_i, cos_t) {
    var num = f64_sub(f64_mul(n2, cos_i), f64_mul(n1, cos_t));
    var den = f64_add(f64_mul(n2, cos_i), f64_mul(n1, cos_t));
    if (f64_lt(f64_abs(den), _fr_eps15()) == 1) {
        return F64_ONE;
    }
    var r = f64_div(num, den);
    return f64_mul(r, r);
}

# Fresnel reflectance at normal incidence: R = ((n1-n2)/(n1+n2))^2.
#must_use
fn fresnel_normal(n1, n2) {
    var r = f64_div(f64_sub(n1, n2), f64_add(n1, n2));
    return f64_mul(r, r);
}

# Average (unpolarized) Fresnel reflectance. Writes PK_ERR_TIR (returns 0) if
# the incident angle exceeds the critical angle.
#must_use
fn fresnel_unpolarized(n1, n2, incident_angle, err_out) {
    store64(err_out, PK_ERR_NONE);
    var sin_i = _prk_sin(incident_angle);
    var cos_i = _prk_cos(incident_angle);
    var sin_t = f64_mul(f64_div(n1, n2), sin_i);
    if (f64_gt(f64_abs(sin_t), F64_ONE) == 1) {
        store64(err_out, PK_ERR_TIR);
        return 0;
    }
    var cos_t = f64_sqrt(f64_sub(F64_ONE, f64_mul(sin_t, sin_t)));
    var rs = fresnel_s(n1, n2, cos_i, cos_t);
    var rp = fresnel_p(n1, n2, cos_i, cos_t);
    return f64_mul(F64_HALF, f64_add(rs, rp));
}

# ── Brewster's angle ────────

# Brewster's angle: atan(n2/n1) — reflected light is fully s-polarized.
#must_use
fn brewster_angle(n1, n2) {
    return ganita_f64_atan2(f64_div(n2, n1), F64_ONE);
}

# ── Complex Fresnel (absorbing media) ────────

# Complex refractive index medium: n~ = n + i*k. { n, k, name }.
#derive(accessors)
struct ComplexMedium { n; k; name; }

fn _cm_mk(n, k, name) {
    var m = alloc(sizeof(ComplexMedium));
    if (m == 0) { return 0; }
    ComplexMedium_set_n(m, n);
    ComplexMedium_set_k(m, k);
    ComplexMedium_set_name(m, name);
    return m;
}

#must_use
fn complex_gold_550nm() {
    return _cm_mk(f64_div(f64_from(43), f64_from(100)), f64_div(f64_from(246), f64_from(100)), "gold (550nm)");
}
#must_use
fn complex_silver_550nm() {
    return _cm_mk(f64_div(f64_from(59), f64_from(1000)), f64_div(f64_from(333), f64_from(100)), "silver (550nm)");
}
#must_use
fn complex_copper_550nm() {
    return _cm_mk(f64_div(f64_from(113), f64_from(100)), f64_div(f64_from(260), f64_from(100)), "copper (550nm)");
}
#must_use
fn complex_aluminum_550nm() {
    return _cm_mk(f64_div(f64_from(96), f64_from(100)), f64_div(f64_from(669), f64_from(100)), "aluminum (550nm)");
}

# Dielectric (non-absorbing) complex medium (k = 0).
#must_use
fn complex_dielectric(n, name) {
    return _cm_mk(n, f64_from(0), name);
}

# Fresnel reflectance at normal incidence for an absorbing medium:
# R = ((n1-n2)^2 + k2^2) / ((n1+n2)^2 + k2^2).
#must_use
fn fresnel_normal_complex(n1, medium) {
    var mn = ComplexMedium_n(medium);
    var mk = ComplexMedium_k(medium);
    var dn = f64_sub(n1, mn);
    var dp = f64_add(n1, mn);
    var k2 = f64_mul(mk, mk);
    return f64_div(f64_add(f64_mul(dn, dn), k2), f64_add(f64_mul(dp, dp), k2));
}

# Complex cos(theta_t) = principal sqrt(u + i*v) where
#   cos^2(theta_t) = 1 - (n1/n~)^2 sin^2(theta_i).
# Writes the real/imag parts through cos_re_out/cos_im_out.
fn _fr_complex_cos_t(n1, mn, mk, incident_angle, cos_re_out, cos_im_out) {
    var sin_i = _prk_sin(incident_angle);
    var sin2_i = f64_mul(sin_i, sin_i);
    var n2_sq = f64_sub(f64_mul(mn, mn), f64_mul(mk, mk));
    var n2_im = f64_mul(f64_mul(F64_TWO, mn), mk);
    var denom = f64_add(f64_mul(n2_sq, n2_sq), f64_mul(n2_im, n2_im));
    var n1_sin2 = f64_mul(f64_mul(n1, n1), sin2_i);
    var u = f64_sub(F64_ONE, f64_div(f64_mul(n1_sin2, n2_sq), denom));
    var v = f64_div(f64_mul(n1_sin2, n2_im), denom);
    var mag = f64_sqrt(f64_add(f64_mul(u, u), f64_mul(v, v)));
    var cos_re = f64_sqrt(f64_div(f64_add(mag, u), F64_TWO));
    var cos_im = f64_sqrt(f64_div(f64_sub(mag, u), F64_TWO));
    if (f64_lt(v, f64_from(0)) == 1) {
        cos_im = f64_neg(cos_im);
    }
    store64(cos_re_out, cos_re);
    store64(cos_im_out, cos_im);
    return 0;
}

# Fresnel reflectance for s-polarized light on an absorbing medium. R_s = |r_s|^2.
#must_use
fn fresnel_s_complex(n1, medium, incident_angle) {
    var mn = ComplexMedium_n(medium);
    var mk = ComplexMedium_k(medium);
    var cos_i = _prk_cos(incident_angle);
    var cos_t_re = 0;
    var cos_t_im = 0;
    _fr_complex_cos_t(n1, mn, mk, incident_angle, &cos_t_re, &cos_t_im);
    var nt_re = f64_sub(f64_mul(mn, cos_t_re), f64_mul(mk, cos_t_im));
    var nt_im = f64_add(f64_mul(mn, cos_t_im), f64_mul(mk, cos_t_re));
    var num_re = f64_sub(f64_mul(n1, cos_i), nt_re);
    var num_im = f64_neg(nt_im);
    var den_re = f64_add(f64_mul(n1, cos_i), nt_re);
    var den_im = nt_im;
    var num_mag = f64_add(f64_mul(num_re, num_re), f64_mul(num_im, num_im));
    var den_mag = f64_add(f64_add(f64_mul(den_re, den_re), f64_mul(den_im, den_im)), _fr_eps30());
    return f64_div(num_mag, den_mag);
}

# Fresnel reflectance for p-polarized light on an absorbing medium. R_p = |r_p|^2.
#must_use
fn fresnel_p_complex(n1, medium, incident_angle) {
    var mn = ComplexMedium_n(medium);
    var mk = ComplexMedium_k(medium);
    var cos_i = _prk_cos(incident_angle);
    var cos_t_re = 0;
    var cos_t_im = 0;
    _fr_complex_cos_t(n1, mn, mk, incident_angle, &cos_t_re, &cos_t_im);
    var nci_re = f64_mul(mn, cos_i);
    var nci_im = f64_mul(mk, cos_i);
    var num_re = f64_sub(nci_re, f64_mul(n1, cos_t_re));
    var num_im = f64_sub(nci_im, f64_mul(n1, cos_t_im));
    var den_re = f64_add(nci_re, f64_mul(n1, cos_t_re));
    var den_im = f64_add(nci_im, f64_mul(n1, cos_t_im));
    var num_mag = f64_add(f64_mul(num_re, num_re), f64_mul(num_im, num_im));
    var den_mag = f64_add(f64_add(f64_mul(den_re, den_re), f64_mul(den_im, den_im)), _fr_eps30());
    return f64_div(num_mag, den_mag);
}

# Average (unpolarized) Fresnel reflectance on an absorbing medium.
#must_use
fn fresnel_unpolarized_complex(n1, medium, incident_angle) {
    var rs = fresnel_s_complex(n1, medium, incident_angle);
    var rp = fresnel_p_complex(n1, medium, incident_angle);
    return f64_mul(F64_HALF, f64_add(rs, rp));
}

# ── Attenuation ────────

# Beer-Lambert law: I = intensity * exp(-alpha * distance).
#must_use
fn beer_lambert(intensity, alpha, distance) {
    return f64_mul(intensity, _prk_exp(f64_neg(f64_mul(alpha, distance))));
}

# ── 3D Snell's law (refracted direction + Fresnel reflectance) ────────

# Compute the refracted direction and unpolarized Fresnel reflectance for a 3D
# ray. Returns the refracted RayVec3 (0 on TIR); writes the reflectance to
# refl_out and the error code to err_out. `direction` and outward `normal`
# should be normalized.
#must_use
fn ray_snell_3d(direction, normal, n1, n2, refl_out, err_out) {
    store64(err_out, PK_ERR_NONE);
    store64(refl_out, f64_from(0));
    var dx = RayVec3_x(direction);
    var dy = RayVec3_y(direction);
    var dz = RayVec3_z(direction);
    var nx = RayVec3_x(normal);
    var ny = RayVec3_y(normal);
    var nz = RayVec3_z(normal);
    var dot = f64_add(f64_add(f64_mul(dx, nx), f64_mul(dy, ny)), f64_mul(dz, nz));
    var cos_i = f64_neg(dot);
    var ratio = f64_div(n1, n2);
    var sin2_t = f64_mul(f64_mul(ratio, ratio), f64_sub(F64_ONE, f64_mul(cos_i, cos_i)));
    if (f64_gt(sin2_t, F64_ONE) == 1) {
        store64(err_out, PK_ERR_TIR);
        return 0;
    }
    var cos_t = f64_sqrt(f64_sub(F64_ONE, sin2_t));
    var factor = f64_sub(f64_mul(ratio, cos_i), cos_t);
    var refr = ray_vec3(
    f64_add(f64_mul(ratio, dx), f64_mul(factor, nx)),
    f64_add(f64_mul(ratio, dy), f64_mul(factor, ny)),
    f64_add(f64_mul(ratio, dz), f64_mul(factor, nz)));
    var rs = fresnel_s(n1, n2, cos_i, cos_t);
    var rp = fresnel_p(n1, n2, cos_i, cos_t);
    store64(refl_out, f64_mul(F64_HALF, f64_add(rs, rp)));
    return refr;
}

# --- ray_trace.cyr ---

# ray_trace.cyr -- sequential ray tracing through optical surfaces
# Usage: include "lib/ray_trace.cyr"  (requires error.cyr, ray_core.cyr, ray_fresnel.cyr)
#
# Ported from the Rust `ray/trace.rs`. The Rust `SurfaceShape` enum
# (Sphere{radius} | Plane) is flattened into OpticalSurface as a shape_tag +
# radius (radius unused for Plane). Vectors of hits use the stdlib `vec`.

# Surface shape tags (was the SurfaceShape enum).
var SURF_SPHERE = 0;
var SURF_PLANE = 1;

# Small geometry thresholds (Rust literals 1e-15 / 1e-10).
fn _trace_eps15() { return f64_div(F64_ONE, f64_from(1000000000000000)); }
fn _trace_eps10() { return f64_div(F64_ONE, f64_from(10000000000)); }

# An interface between two media. shape_tag is SURF_SPHERE/SURF_PLANE; radius is
# the radius of curvature (sphere only; +radius = center to the right).
#derive(accessors)
struct OpticalSurface { shape_tag; radius; z_position; n_after; aperture_radius; }

#must_use
fn surface_sphere(radius, z_position, n_after, aperture_radius) {
    var s = alloc(sizeof(OpticalSurface));
    if (s == 0) { return 0; }
    OpticalSurface_set_shape_tag(s, SURF_SPHERE);
    OpticalSurface_set_radius(s, radius);
    OpticalSurface_set_z_position(s, z_position);
    OpticalSurface_set_n_after(s, n_after);
    OpticalSurface_set_aperture_radius(s, aperture_radius);
    return s;
}

#must_use
fn surface_plane(z_position, n_after, aperture_radius) {
    var s = alloc(sizeof(OpticalSurface));
    if (s == 0) { return 0; }
    OpticalSurface_set_shape_tag(s, SURF_PLANE);
    OpticalSurface_set_radius(s, f64_from(0));
    OpticalSurface_set_z_position(s, z_position);
    OpticalSurface_set_n_after(s, n_after);
    OpticalSurface_set_aperture_radius(s, aperture_radius);
    return s;
}

# A ray state during tracing: position, direction (normalized), medium index n.
# position and direction are RayVec3.
#derive(accessors)
struct TraceRay { pos; dir; n; }

#must_use
fn trace_ray_new(pos, dir, n) {
    var r = alloc(sizeof(TraceRay));
    if (r == 0) { return 0; }
    TraceRay_set_pos(r, pos);
    TraceRay_set_dir(r, dir);
    TraceRay_set_n(r, n);
    return r;
}

# Result of tracing through one surface: hit point, outward normal (both
# RayVec3), refracted ray_after (TraceRay), and Fresnel reflectance.
#derive(accessors)
struct TraceHit { hit_point; normal; ray_after; reflectance; }

# Trace a ray through a single optical surface. Returns a TraceHit (0 on error)
# and writes PK_ERR_NONE / PK_ERR_* to err_out. Surfaces are centered on the z
# axis; a spherical surface's center of curvature is at z_position + radius.
#must_use
fn trace_surface(ray, surface, err_out) {
    _prk_trace("trace_surface");
    store64(err_out, PK_ERR_NONE);
    var pos = TraceRay_pos(ray);
    var dir = TraceRay_dir(ray);
    var px = RayVec3_x(pos);
    var py = RayVec3_y(pos);
    var pz = RayVec3_z(pos);
    var dx = RayVec3_x(dir);
    var dy = RayVec3_y(dir);
    var dz = RayVec3_z(dir);
    var z_pos = OpticalSurface_z_position(surface);

    var hit_x = f64_from(0);
    var hit_y = f64_from(0);
    var hit_z = f64_from(0);
    var nx = f64_from(0);
    var ny = f64_from(0);
    var nz = f64_from(0);

    if (OpticalSurface_shape_tag(surface) == SURF_PLANE) {
        # Intersection with the z = z_position plane.
        if (f64_lt(f64_abs(dz), _trace_eps15()) == 1) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        var t = f64_div(f64_sub(z_pos, pz), dz);
        if (f64_lt(t, f64_from(0)) == 1) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        hit_x = f64_add(px, f64_mul(t, dx));
        hit_y = f64_add(py, f64_mul(t, dy));
        hit_z = f64_add(pz, f64_mul(t, dz));
        # Normal points back against propagation.
        if (f64_gt(dz, f64_from(0)) == 1) {
            nz = f64_neg(F64_ONE);
        } else {
            nz = F64_ONE;
        }
    } else {
        # Spherical surface. Center of curvature at [0, 0, z_pos + radius].
        var radius = OpticalSurface_radius(surface);
        var cz = f64_add(z_pos, radius);
        var ocx = px;
        var ocy = py;
        var ocz = f64_sub(pz, cz);
        var half_b = f64_add(f64_add(f64_mul(ocx, dx), f64_mul(ocy, dy)), f64_mul(ocz, dz));
        var cc = f64_sub(
        f64_add(f64_add(f64_mul(ocx, ocx), f64_mul(ocy, ocy)), f64_mul(ocz, ocz)),
        f64_mul(radius, radius));
        var disc = f64_sub(f64_mul(half_b, half_b), cc);
        if (f64_lt(disc, f64_from(0)) == 1) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        var sqrt_d = f64_sqrt(disc);
        var t1 = f64_sub(f64_neg(half_b), sqrt_d);
        var t2 = f64_add(f64_neg(half_b), sqrt_d);
        var t = f64_from(0);
        if (f64_gt(t1, _trace_eps10()) == 1) {
            t = t1;
        } elif (f64_gt(t2, _trace_eps10()) == 1) {
            t = t2;
        } else {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        hit_x = f64_add(px, f64_mul(t, dx));
        hit_y = f64_add(py, f64_mul(t, dy));
        hit_z = f64_add(pz, f64_mul(t, dz));
        # Outward normal = (hit - center) / |hit - center|.
        nx = hit_x;
        ny = hit_y;
        nz = f64_sub(hit_z, cz);
        var nlen = f64_sqrt(f64_add(f64_add(f64_mul(nx, nx), f64_mul(ny, ny)), f64_mul(nz, nz)));
        nx = f64_div(nx, nlen);
        ny = f64_div(ny, nlen);
        nz = f64_div(nz, nlen);
        # Ensure the normal faces the incoming ray.
        var dot_dn = f64_add(f64_add(f64_mul(dx, nx), f64_mul(dy, ny)), f64_mul(dz, nz));
        if (f64_gt(dot_dn, f64_from(0)) == 1) {
            nx = f64_neg(nx);
            ny = f64_neg(ny);
            nz = f64_neg(nz);
        }
    }

    # Aperture check.
    var r2 = f64_add(f64_mul(hit_x, hit_x), f64_mul(hit_y, hit_y));
    var ap = OpticalSurface_aperture_radius(surface);
    if (f64_gt(r2, f64_mul(ap, ap)) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }

    # Refract through the surface.
    var normal = ray_vec3(nx, ny, nz);
    var refl = f64_from(0);
    var serr = 0;
    var refr_dir = ray_snell_3d(dir, normal, TraceRay_n(ray), OpticalSurface_n_after(surface), &refl, &serr);
    if (prakash_is_err(serr) == 1) {
        store64(err_out, serr);
        return 0;
    }

    var hit_point = ray_vec3(hit_x, hit_y, hit_z);
    var ray_after = trace_ray_new(hit_point, refr_dir, OpticalSurface_n_after(surface));
    var hit = alloc(sizeof(TraceHit));
    if (hit == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    TraceHit_set_hit_point(hit, hit_point);
    TraceHit_set_normal(hit, normal);
    TraceHit_set_ray_after(hit, ray_after);
    TraceHit_set_reflectance(hit, refl);
    return hit;
}

# Trace a ray through a sequence of surfaces (a `vec` of OpticalSurface).
# Returns a `vec` of TraceHit (0 on error, with err_out set).
#must_use
fn trace_sequential(initial_ray, surfaces, err_out) {
    _prk_trace("trace_sequential");
    store64(err_out, PK_ERR_NONE);
    var hits = vec_new();
    var current = initial_ray;
    var count = vec_len(surfaces);
    var i = 0;
    while (i < count) {
        var surface = vec_get(surfaces, i);
        var he = 0;
        var hit = trace_surface(current, surface, &he);
        if (prakash_is_err(he) == 1) {
            store64(err_out, he);
            return 0;
        }
        current = TraceHit_ray_after(hit);
        vec_push(hits, hit);
        i = i + 1;
    }
    return hits;
}

# ── Polarization ray tracing ────────

# A geometric hit plus cumulative s/p transmittance and the R_p/R_s ratio.
#derive(accessors)
struct PolarizedTraceHit { hit; rp_over_rs; transmittance_s; transmittance_p; }

# Trace with polarization tracking: at each surface accumulate the s- and
# p-polarized Fresnel transmittances. Returns a `vec` of PolarizedTraceHit
# (0 on error, err_out set).
#must_use
fn trace_sequential_polarized(initial_ray, surfaces, err_out) {
    _prk_trace("trace_sequential_polarized");
    store64(err_out, PK_ERR_NONE);
    var results = vec_new();
    var current = initial_ray;
    var cum_ts = F64_ONE;
    var cum_tp = F64_ONE;
    var count = vec_len(surfaces);
    var i = 0;
    while (i < count) {
        var surface = vec_get(surfaces, i);
        var he = 0;
        var hit = trace_surface(current, surface, &he);
        if (prakash_is_err(he) == 1) {
            store64(err_out, he);
            return 0;
        }
        var nrm = TraceHit_normal(hit);
        var cdir = TraceRay_dir(current);
        var dot_i = f64_add(
        f64_add(f64_mul(RayVec3_x(cdir), RayVec3_x(nrm)), f64_mul(RayVec3_y(cdir), RayVec3_y(nrm))),
        f64_mul(RayVec3_z(cdir), RayVec3_z(nrm)));
        var cos_i = f64_neg(f64_abs(dot_i));
        var adir = TraceRay_dir(TraceHit_ray_after(hit));
        var dot_t = f64_add(
        f64_add(f64_mul(RayVec3_x(adir), RayVec3_x(nrm)), f64_mul(RayVec3_y(adir), RayVec3_y(nrm))),
        f64_mul(RayVec3_z(adir), RayVec3_z(nrm)));
        var cos_t = f64_neg(f64_abs(dot_t));
        var n1 = TraceRay_n(current);
        var n2 = OpticalSurface_n_after(surface);
        var rs = fresnel_s(n1, n2, cos_i, cos_t);
        var rp = fresnel_p(n1, n2, cos_i, cos_t);
        cum_ts = f64_mul(cum_ts, f64_sub(F64_ONE, rs));
        cum_tp = f64_mul(cum_tp, f64_sub(F64_ONE, rp));
        var rp_over_rs = f64_from(0);
        if (f64_gt(rs, _trace_eps15()) == 1) {
            rp_over_rs = f64_div(rp, rs);
        }
        var pth = alloc(sizeof(PolarizedTraceHit));
        if (pth == 0) { return 0; }
        PolarizedTraceHit_set_hit(pth, hit);
        PolarizedTraceHit_set_rp_over_rs(pth, rp_over_rs);
        PolarizedTraceHit_set_transmittance_s(pth, cum_ts);
        PolarizedTraceHit_set_transmittance_p(pth, cum_tp);
        vec_push(results, pth);
        current = TraceHit_ray_after(hit);
        i = i + 1;
    }
    return results;
}

# --- ray_simulate.cyr ---

# ray_simulate.cyr -- recursive ray tracing, ray fans, spot diagrams, OPD
# Usage: include "lib/ray_simulate.cyr"
#   (requires error.cyr, ray_core.cyr, ray_fresnel.cyr, ray_trace.cyr)
#
# Ported from the Rust `ray/simulate.rs`. The TraceEvent enum
# (Refraction{reflectance,surface_idx} | Reflection{surface_idx} | Escaped |
# Terminated) is flattened into TraceSegment as event_tag + reflectance +
# surface_idx. Vectors use the stdlib `vec`.

var EVENT_REFRACTION = 0;
var EVENT_REFLECTION = 1;
var EVENT_ESCAPED = 2;
var EVENT_TERMINATED = 3;

fn _sim_eps15() { return f64_div(F64_ONE, f64_from(1000000000000000)); }

# Euclidean distance between two RayVec3 points.
fn _sim_dist(a, b) {
    var dx = f64_sub(RayVec3_x(b), RayVec3_x(a));
    var dy = f64_sub(RayVec3_y(b), RayVec3_y(a));
    var dz = f64_sub(RayVec3_z(b), RayVec3_z(a));
    return f64_sqrt(f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz)));
}

# ── Recursive ray tracing ────────

# A segment of a recursively traced path. origin/direction are RayVec3. event_tag
# is EVENT_*; reflectance/surface_idx are meaningful for Refraction/Reflection.
#derive(accessors)
struct TraceSegment {
    origin; direction; n; path_length; optical_path; energy; depth; event_tag; reflectance; surface_idx;
}

fn _seg_new(origin, direction, n, path_length, optical_path, energy, depth, event_tag, reflectance, surface_idx) {
    var s = alloc(sizeof(TraceSegment));
    if (s == 0) { return 0; }
    TraceSegment_set_origin(s, origin);
    TraceSegment_set_direction(s, direction);
    TraceSegment_set_n(s, n);
    TraceSegment_set_path_length(s, path_length);
    TraceSegment_set_optical_path(s, optical_path);
    TraceSegment_set_energy(s, energy);
    TraceSegment_set_depth(s, depth);
    TraceSegment_set_event_tag(s, event_tag);
    TraceSegment_set_reflectance(s, reflectance);
    TraceSegment_set_surface_idx(s, surface_idx);
    return s;
}

# Recursive-trace configuration: max_depth (int), min_energy (f64).
#derive(accessors)
struct TraceConfig { max_depth; min_energy; }

#must_use
fn trace_config_new(max_depth, min_energy) {
    var c = alloc(sizeof(TraceConfig));
    if (c == 0) { return 0; }
    TraceConfig_set_max_depth(c, max_depth);
    TraceConfig_set_min_energy(c, min_energy);
    return c;
}

# Defaults: max_depth = 8, min_energy = 0.001.
#must_use
fn trace_config_default() {
    return trace_config_new(8, f64_div(F64_ONE, f64_from(1000)));
}

# Flat list of all traced segments (depth-first) plus interaction count.
#derive(accessors)
struct TraceTree { segments; interactions; }

# Trace a ray recursively, following refracted + reflected paths at each surface.
#must_use
fn trace_recursive(ray, surfaces, config) {
    _prk_trace("trace_recursive");
    var segments = vec_new();
    var interactions = 0;
    _trace_recursive_inner(ray, surfaces, config, F64_ONE, 0, segments, &interactions);
    var tree = alloc(sizeof(TraceTree));
    if (tree == 0) { return 0; }
    TraceTree_set_segments(tree, segments);
    TraceTree_set_interactions(tree, interactions);
    return tree;
}

fn _trace_recursive_inner(ray, surfaces, config, energy, depth, segments, inter_ptr) {
    if (depth >= TraceConfig_max_depth(config)) {
        vec_push(segments, _seg_new(TraceRay_pos(ray), TraceRay_dir(ray), TraceRay_n(ray),
        f64_from(0), f64_from(0), energy, depth, EVENT_TERMINATED, f64_from(0), 0));
        return 0;
    }
    if (f64_lt(energy, TraceConfig_min_energy(config)) == 1) {
        vec_push(segments, _seg_new(TraceRay_pos(ray), TraceRay_dir(ray), TraceRay_n(ray),
        f64_from(0), f64_from(0), energy, depth, EVENT_TERMINATED, f64_from(0), 0));
        return 0;
    }

    # Find the nearest surface hit.
    var best_idx = (0 - 1);
    var best_dist = f64_from(0);
    var best_hit = 0;
    var count = vec_len(surfaces);
    var i = 0;
    while (i < count) {
        var e = 0;
        var hit = trace_surface(ray, vec_get(surfaces, i), &e);
        if (prakash_is_err(e) == 0) {
            var dist = _sim_dist(TraceRay_pos(ray), TraceHit_hit_point(hit));
            if (best_idx < 0) {
                best_idx = i;
                best_dist = dist;
                best_hit = hit;
            } elif (f64_lt(dist, best_dist) == 1) {
                best_idx = i;
                best_dist = dist;
                best_hit = hit;
            }
        }
        i = i + 1;
    }

    if (best_idx < 0) {
        vec_push(segments, _seg_new(TraceRay_pos(ray), TraceRay_dir(ray), TraceRay_n(ray),
        f64_from(0), f64_from(0), energy, depth, EVENT_ESCAPED, f64_from(0), 0));
        return 0;
    }

    store64(inter_ptr, load64(inter_ptr) + 1);
    var path_len = best_dist;
    var optical_path = f64_mul(TraceRay_n(ray), path_len);
    var reflectance = TraceHit_reflectance(best_hit);
    var transmittance = f64_sub(F64_ONE, reflectance);

    vec_push(segments, _seg_new(TraceRay_pos(ray), TraceRay_dir(ray), TraceRay_n(ray),
    path_len, optical_path, f64_mul(energy, transmittance), depth, EVENT_REFRACTION, reflectance, best_idx));

    var refracted_energy = f64_mul(energy, transmittance);
    if (f64_ge(refracted_energy, TraceConfig_min_energy(config)) == 1) {
        _trace_recursive_inner(TraceHit_ray_after(best_hit), surfaces, config,
        refracted_energy, depth + 1, segments, inter_ptr);
    }

    var reflected_energy = f64_mul(energy, reflectance);
    if (f64_ge(reflected_energy, TraceConfig_min_energy(config)) == 1) {
        var reflected_dir = ray_reflect_3d(TraceRay_dir(ray), TraceHit_normal(best_hit));
        var reflected_ray = trace_ray_new(TraceHit_hit_point(best_hit), reflected_dir, TraceRay_n(ray));
        vec_push(segments, _seg_new(TraceHit_hit_point(best_hit), reflected_dir, TraceRay_n(ray),
        f64_from(0), f64_from(0), reflected_energy, depth, EVENT_REFLECTION, f64_from(0), best_idx));
        _trace_recursive_inner(reflected_ray, surfaces, config,
        reflected_energy, depth + 1, segments, inter_ptr);
    }
    return 0;
}

# ── Ray fan generators ────────

# A ray in a fan tagged with its normalized aperture height.
#derive(accessors)
struct FanRay { ray; aperture_height; }

fn _fan_ray(tr, aperture_height) {
    var fr = alloc(sizeof(FanRay));
    if (fr == 0) { return 0; }
    FanRay_set_ray(fr, tr);
    FanRay_set_aperture_height(fr, aperture_height);
    return fr;
}

# Normalized fan parameter t in [-1, 1] for ray i of num_rays (0 if single ray).
fn _fan_t(i, num_rays) {
    if (num_rays == 1) { return f64_from(0); }
    return f64_add(f64_neg(F64_ONE),
    f64_div(f64_mul(F64_TWO, f64_from(i)), f64_from(num_rays - 1)));
}

# Meridional ray fan (rays spread across y in the y-z plane).
#must_use
fn ray_fan_meridional(aperture_radius, num_rays, field_angle, start_z) {
    _prk_trace("ray_fan_meridional");
    var rays = vec_new();
    var sin_f = _prk_sin(field_angle);
    var cos_f = _prk_cos(field_angle);
    var i = 0;
    while (i < num_rays) {
        var t = _fan_t(i, num_rays);
        var tr = trace_ray_new(ray_vec3(f64_from(0), f64_mul(t, aperture_radius), start_z),
        ray_vec3(f64_from(0), sin_f, cos_f), F64_ONE);
        vec_push(rays, _fan_ray(tr, t));
        i = i + 1;
    }
    return rays;
}

# Sagittal ray fan (rays spread across x in the x-z plane).
#must_use
fn ray_fan_sagittal(aperture_radius, num_rays, field_angle, start_z) {
    _prk_trace("ray_fan_sagittal");
    var rays = vec_new();
    var sin_f = _prk_sin(field_angle);
    var cos_f = _prk_cos(field_angle);
    var i = 0;
    while (i < num_rays) {
        var t = _fan_t(i, num_rays);
        var tr = trace_ray_new(ray_vec3(f64_mul(t, aperture_radius), f64_from(0), start_z),
        ray_vec3(sin_f, f64_from(0), cos_f), F64_ONE);
        vec_push(rays, _fan_ray(tr, t));
        i = i + 1;
    }
    return rays;
}

# Radial ray bundle: a chief ray plus num_rings concentric rings of num_arms rays.
#must_use
fn ray_bundle(aperture_radius, num_rings, num_arms, field_angle, start_z) {
    _prk_trace("ray_bundle");
    var rays = vec_new();
    var sin_f = _prk_sin(field_angle);
    var cos_f = _prk_cos(field_angle);
    vec_push(rays, _fan_ray(
    trace_ray_new(ray_vec3(f64_from(0), f64_from(0), start_z),
    ray_vec3(f64_from(0), sin_f, cos_f), F64_ONE), f64_from(0)));
    var ring = 1;
    while (ring <= num_rings) {
        # Match Rust's left-associative order: (ap * ring) / num_rings.
        var r = f64_div(f64_mul(aperture_radius, f64_from(ring)), f64_from(num_rings));
        var t = f64_div(r, aperture_radius);
        var arm = 0;
        while (arm < num_arms) {
            # Match Rust's order: ((2*PI) * arm) / num_arms.
            var phi = f64_div(f64_mul(f64_mul(F64_TWO, F64_PI), f64_from(arm)), f64_from(num_arms));
            var x = f64_mul(r, _prk_cos(phi));
            var y = f64_mul(r, _prk_sin(phi));
            vec_push(rays, _fan_ray(
            trace_ray_new(ray_vec3(x, y, start_z),
            ray_vec3(f64_from(0), sin_f, cos_f), F64_ONE), t));
            arm = arm + 1;
        }
        ring = ring + 1;
    }
    return rays;
}

# ── Spot diagram ────────

# A point where a ray crosses the image plane.
#derive(accessors)
struct SpotPoint { x; y; optical_path; aperture_height; }

# Trace a ray bundle through the surfaces and record image-plane crossings.
# Vignetted / parallel / behind rays are silently skipped.
#must_use
fn spot_diagram(surfaces, aperture_radius, num_rings, num_arms, field_angle, start_z, image_z) {
    _prk_trace("spot_diagram");
    var bundle = ray_bundle(aperture_radius, num_rings, num_arms, field_angle, start_z);
    var spots = vec_new();
    var count = vec_len(bundle);
    var i = 0;
    while (i < count) {
        var fan_ray = vec_get(bundle, i);
        var fr_ray = FanRay_ray(fan_ray);
        var e = 0;
        var hits = trace_sequential(fr_ray, surfaces, &e);
        if (prakash_is_err(e) == 0) {
            var nhits = vec_len(hits);
            var final_ray = fr_ray;
            if (nhits > 0) {
                final_ray = TraceHit_ray_after(vec_get(hits, nhits - 1));
            }
            var fdir = TraceRay_dir(final_ray);
            var fpos = TraceRay_pos(final_ray);
            var dz = RayVec3_z(fdir);
            if (f64_ge(f64_abs(dz), _sim_eps15()) == 1) {
                var t = f64_div(f64_sub(image_z, RayVec3_z(fpos)), dz);
                if (f64_ge(t, f64_from(0)) == 1) {
                    var img_x = f64_add(RayVec3_x(fpos), f64_mul(t, RayVec3_x(fdir)));
                    var img_y = f64_add(RayVec3_y(fpos), f64_mul(t, RayVec3_y(fdir)));
                    var opl = f64_from(0);
                    var prev_pos = TraceRay_pos(fr_ray);
                    var prev_n = TraceRay_n(fr_ray);
                    var j = 0;
                    while (j < nhits) {
                        var hit = vec_get(hits, j);
                        opl = f64_add(opl, f64_mul(prev_n, _sim_dist(prev_pos, TraceHit_hit_point(hit))));
                        prev_pos = TraceHit_hit_point(hit);
                        prev_n = TraceRay_n(TraceHit_ray_after(hit));
                        j = j + 1;
                    }
                    var img_pt = ray_vec3(img_x, img_y, image_z);
                    opl = f64_add(opl, f64_mul(prev_n, _sim_dist(prev_pos, img_pt)));
                    var sp = alloc(sizeof(SpotPoint));
                    if (sp == 0) { return 0; }
                    SpotPoint_set_x(sp, img_x);
                    SpotPoint_set_y(sp, img_y);
                    SpotPoint_set_optical_path(sp, opl);
                    SpotPoint_set_aperture_height(sp, FanRay_aperture_height(fan_ray));
                    vec_push(spots, sp);
                }
            }
        }
        i = i + 1;
    }
    return spots;
}

# RMS distance of spot points from their centroid (0 for empty).
#must_use
fn spot_rms_radius(spots) {
    var n = vec_len(spots);
    if (n == 0) { return f64_from(0); }
    var nf = f64_from(n);
    var sx = f64_from(0);
    var sy = f64_from(0);
    var i = 0;
    while (i < n) {
        var s = vec_get(spots, i);
        sx = f64_add(sx, SpotPoint_x(s));
        sy = f64_add(sy, SpotPoint_y(s));
        i = i + 1;
    }
    var cx = f64_div(sx, nf);
    var cy = f64_div(sy, nf);
    var sum_r2 = f64_from(0);
    i = 0;
    while (i < n) {
        var s = vec_get(spots, i);
        var ddx = f64_sub(SpotPoint_x(s), cx);
        var ddy = f64_sub(SpotPoint_y(s), cy);
        sum_r2 = f64_add(sum_r2, f64_add(f64_mul(ddx, ddx), f64_mul(ddy, ddy)));
        i = i + 1;
    }
    return f64_sqrt(f64_div(sum_r2, nf));
}

# ── Optical path difference ────────

# Optical path length of a ray through the system to image_z (n * distance,
# summed). Writes the error code to err_out (0 on error return).
#must_use
fn optical_path_length(ray, surfaces, image_z, err_out) {
    store64(err_out, PK_ERR_NONE);
    var e = 0;
    var hits = trace_sequential(ray, surfaces, &e);
    if (prakash_is_err(e) == 1) {
        store64(err_out, e);
        return f64_from(0);
    }
    var opl = f64_from(0);
    var prev_pos = TraceRay_pos(ray);
    var prev_n = TraceRay_n(ray);
    var nhits = vec_len(hits);
    var i = 0;
    while (i < nhits) {
        var hit = vec_get(hits, i);
        opl = f64_add(opl, f64_mul(prev_n, _sim_dist(prev_pos, TraceHit_hit_point(hit))));
        prev_pos = TraceHit_hit_point(hit);
        prev_n = TraceRay_n(TraceHit_ray_after(hit));
        i = i + 1;
    }
    var final_ray = ray;
    if (nhits > 0) {
        final_ray = TraceHit_ray_after(vec_get(hits, nhits - 1));
    }
    var fdir = TraceRay_dir(final_ray);
    var fpos = TraceRay_pos(final_ray);
    var dz = RayVec3_z(fdir);
    if (f64_gt(f64_abs(dz), _sim_eps15()) == 1) {
        var t = f64_div(f64_sub(image_z, RayVec3_z(fpos)), dz);
        if (f64_gt(t, f64_from(0)) == 1) {
            var end = ray_vec3(
            f64_add(RayVec3_x(fpos), f64_mul(t, RayVec3_x(fdir))),
            f64_add(RayVec3_y(fpos), f64_mul(t, RayVec3_y(fdir))),
            image_z);
            opl = f64_add(opl, f64_mul(prev_n, _sim_dist(prev_pos, end)));
        }
    }
    return opl;
}

# Optical path difference of a ray relative to a chief ray. Writes err to err_out.
#must_use
fn optical_path_difference(ray, chief_ray, surfaces, image_z, err_out) {
    store64(err_out, PK_ERR_NONE);
    var e1 = 0;
    var opl_ray = optical_path_length(ray, surfaces, image_z, &e1);
    if (prakash_is_err(e1) == 1) {
        store64(err_out, e1);
        return f64_from(0);
    }
    var e2 = 0;
    var opl_chief = optical_path_length(chief_ray, surfaces, image_z, &e2);
    if (prakash_is_err(e2) == 1) {
        store64(err_out, e2);
        return f64_from(0);
    }
    return f64_sub(opl_ray, opl_chief);
}

# An (aperture_height, opd) pair for opd_fan results.
#derive(accessors)
struct OpdPoint { height; opd; }

# OPD for each ray in a fan relative to the chief ray (min |aperture_height|).
# Returns a `vec` of OpdPoint; vignetted rays are excluded, empty on failure.
#must_use
fn opd_fan(fan, surfaces, image_z) {
    _prk_trace("opd_fan");
    var result = vec_new();
    var count = vec_len(fan);
    if (count == 0) {
        return result;
    }
    var chief_idx = 0;
    var best_abs = f64_abs(FanRay_aperture_height(vec_get(fan, 0)));
    var i = 1;
    while (i < count) {
        var h = f64_abs(FanRay_aperture_height(vec_get(fan, i)));
        if (f64_lt(h, best_abs) == 1) {
            best_abs = h;
            chief_idx = i;
        }
        i = i + 1;
    }
    var ec = 0;
    var opl_chief = optical_path_length(FanRay_ray(vec_get(fan, chief_idx)), surfaces, image_z, &ec);
    if (prakash_is_err(ec) == 1) {
        return result;
    }
    i = 0;
    while (i < count) {
        var fr = vec_get(fan, i);
        var e = 0;
        var opl = optical_path_length(FanRay_ray(fr), surfaces, image_z, &e);
        if (prakash_is_err(e) == 0) {
            var op = alloc(sizeof(OpdPoint));
            if (op == 0) { return 0; }
            OpdPoint_set_height(op, FanRay_aperture_height(fr));
            OpdPoint_set_opd(op, f64_sub(opl, opl_chief));
            vec_push(result, op);
        }
        i = i + 1;
    }
    return result;
}

# --- ray_system.cyr ---

# ray_system.cyr -- optical bench: paraxial trace, prescriptions, cardinal points
# Usage: include "lib/ray_system.cyr"
#   (requires error.cyr, ray_core.cyr, ray_fresnel.cyr, ray_trace.cyr)
#
# Ported from the Rust `ray/system.rs`. `f64::INFINITY` (flat surface radius) is
# the bit pattern 0x7FF0000000000000; is_infinite is detected via f64_abs. The
# `(power, reduced_thickness)` tuple becomes a ParaxSurf struct; String names are
# cstr pointers (compared with streq). Vectors use the stdlib `vec`.

fn _sys_eps15() { return f64_div(F64_ONE, f64_from(1000000000000000)); }

# Positive-infinity bit pattern (flat-surface radius).
fn _sys_inf() { return 0x7FF0000000000000; }

# 1 if x is +inf or -inf (f64_abs clears the sign bit).
fn _sys_is_inf(x) {
    if (f64_abs(x) == 0x7FF0000000000000) { return 1; }
    return 0;
}

# ── Paraxial ray trace (y-nu method) ────────

# Paraxial ray: height y and optical direction cosine nu = n*u.
#derive(accessors)
struct ParaxialRay { y; nu; }

#must_use
fn paraxial_ray_new(y, nu) {
    var r = alloc(sizeof(ParaxialRay));
    if (r == 0) { return 0; }
    ParaxialRay_set_y(r, y);
    ParaxialRay_set_nu(r, nu);
    return r;
}

# Marginal ray: enters at the aperture edge, parallel to the axis (nu = 0).
#must_use
fn paraxial_marginal(aperture_height) {
    return paraxial_ray_new(aperture_height, f64_from(0));
}

# Chief ray: enters on-axis from a field point at angle field_angle in medium n.
#must_use
fn paraxial_chief(field_angle, n) {
    return paraxial_ray_new(f64_from(0), f64_mul(n, field_angle));
}

# Refract a paraxial ray at a surface of power phi: nu' = nu - y*phi.
#must_use
fn paraxial_refract(ray, power) {
    return paraxial_ray_new(ParaxialRay_y(ray),
    f64_sub(ParaxialRay_nu(ray), f64_mul(ParaxialRay_y(ray), power)));
}

# Transfer a paraxial ray across a reduced thickness t/n: y' = y + (t/n)*nu.
#must_use
fn paraxial_transfer(ray, reduced_thickness) {
    return paraxial_ray_new(
    f64_add(ParaxialRay_y(ray), f64_mul(reduced_thickness, ParaxialRay_nu(ray))),
    ParaxialRay_nu(ray));
}

# A (power, reduced_thickness) paraxial surface parameter pair.
#derive(accessors)
struct ParaxSurf { power; reduced_t; }

#must_use
fn paraxsurf_new(power, reduced_t) {
    var p = alloc(sizeof(ParaxSurf));
    if (p == 0) { return 0; }
    ParaxSurf_set_power(p, power);
    ParaxSurf_set_reduced_t(p, reduced_t);
    return p;
}

# Trace a paraxial ray through a `vec` of ParaxSurf. Returns a `vec` of the ray
# state after each surface (including the input state). Last thickness ignored.
#must_use
fn paraxial_trace(ray, surfaces) {
    _prk_trace("paraxial_trace");
    var states = vec_new();
    var current = ray;
    vec_push(states, current);
    var count = vec_len(surfaces);
    var i = 0;
    while (i < count) {
        var ps = vec_get(surfaces, i);
        current = paraxial_refract(current, ParaxSurf_power(ps));
        vec_push(states, current);
        if (i < count - 1) {
            current = paraxial_transfer(current, ParaxSurf_reduced_t(ps));
        }
        i = i + 1;
    }
    return states;
}

# ── Optical system builder ────────

# One surface in a prescription. radius is _sys_inf() for a flat surface.
#derive(accessors)
struct PrescriptionSurface { radius; thickness; n_after; aperture_radius; }

# A complete system prescription: name (cstr), surfaces (vec), n_initial.
#derive(accessors)
struct Prescription { name; surfaces; n_initial; }

#must_use
fn prescription_new(name) {
    var p = alloc(sizeof(Prescription));
    if (p == 0) { return 0; }
    Prescription_set_name(p, name);
    Prescription_set_surfaces(p, vec_new());
    Prescription_set_n_initial(p, F64_ONE);
    return p;
}

# Set the initial medium index (before the first surface). Returns the prescription.
#must_use
fn prescription_with_initial_medium(p, n) {
    Prescription_set_n_initial(p, n);
    return p;
}

# Append a surface. Mutates and returns the prescription (for chaining).
#must_use
fn prescription_add_surface(p, radius, thickness, n_after, aperture_radius) {
    var ps = alloc(sizeof(PrescriptionSurface));
    if (ps == 0) { return 0; }
    PrescriptionSurface_set_radius(ps, radius);
    PrescriptionSurface_set_thickness(ps, thickness);
    PrescriptionSurface_set_n_after(ps, n_after);
    PrescriptionSurface_set_aperture_radius(ps, aperture_radius);
    vec_push(Prescription_surfaces(p), ps);
    return p;
}

#must_use
fn prescription_len(p) { return vec_len(Prescription_surfaces(p)); }

#must_use
fn prescription_is_empty(p) {
    if (vec_len(Prescription_surfaces(p)) == 0) { return 1; }
    return 0;
}

# Convert to a `vec` of OpticalSurface with absolute z-positions from cumulative
# thicknesses (flat radius -> plane surface).
#must_use
fn prescription_to_trace_surfaces(p) {
    var surfaces = vec_new();
    var z = f64_from(0);
    var ps_vec = Prescription_surfaces(p);
    var count = vec_len(ps_vec);
    var i = 0;
    while (i < count) {
        var ps = vec_get(ps_vec, i);
        var radius = PrescriptionSurface_radius(ps);
        var na = PrescriptionSurface_n_after(ps);
        var ap = PrescriptionSurface_aperture_radius(ps);
        var os = 0;
        if (_sys_is_inf(radius) == 1) {
            os = surface_plane(z, na, ap);
        } else {
            os = surface_sphere(radius, z, na, ap);
        }
        vec_push(surfaces, os);
        z = f64_add(z, PrescriptionSurface_thickness(ps));
        i = i + 1;
    }
    return surfaces;
}

# Convert to a `vec` of ParaxSurf (power, reduced_thickness) pairs.
#must_use
fn prescription_to_paraxial_surfaces(p) {
    var result = vec_new();
    var n_before = Prescription_n_initial(p);
    var ps_vec = Prescription_surfaces(p);
    var count = vec_len(ps_vec);
    var i = 0;
    while (i < count) {
        var ps = vec_get(ps_vec, i);
        var na = PrescriptionSurface_n_after(ps);
        var power = f64_from(0);
        if (_sys_is_inf(PrescriptionSurface_radius(ps)) == 0) {
            power = f64_div(f64_sub(na, n_before), PrescriptionSurface_radius(ps));
        }
        var reduced_t = PrescriptionSurface_thickness(ps);
        if (f64_gt(f64_abs(na), _sys_eps15()) == 1) {
            reduced_t = f64_div(PrescriptionSurface_thickness(ps), na);
        }
        vec_push(result, paraxsurf_new(power, reduced_t));
        n_before = na;
        i = i + 1;
    }
    return result;
}

# ── System cardinal points ────────

# Cardinal points and properties of a complete system.
#derive(accessors)
struct SystemProperties { focal_length; bfd; ffd; power; entrance_pupil; exit_pupil; }

# Find the cardinal points from a prescription by tracing marginal paraxial rays
# forward (EFL, BFD) and reverse (FFD). Returns 0 and writes an error code if the
# system is empty or afocal (zero power).
#must_use
fn find_system_properties(prescription, err_out) {
    _prk_trace("find_system_properties");
    store64(err_out, PK_ERR_NONE);
    if (prescription_is_empty(prescription) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }

    var paraxial_surfaces = prescription_to_paraxial_surfaces(prescription);
    var marginal = paraxial_marginal(F64_ONE);
    var forward_states = paraxial_trace(marginal, paraxial_surfaces);
    var nf = vec_len(forward_states);
    var final_ray = marginal;
    if (nf > 0) {
        final_ray = vec_get(forward_states, nf - 1);
    }
    if (f64_lt(f64_abs(ParaxialRay_nu(final_ray)), _sys_eps15()) == 1) {
        store64(err_out, PK_ERR_DIVISION_BY_ZERO);
        return 0;
    }

    var efl = f64_div(f64_neg(ParaxialRay_y(marginal)), ParaxialRay_nu(final_ray));
    var power = f64_div(F64_ONE, efl);
    var bfd = f64_div(f64_neg(ParaxialRay_y(final_ray)), ParaxialRay_nu(final_ray));

    # Reverse marginal ray for FFD: reverse surface order, negate radii, swap media.
    var ps_vec = Prescription_surfaces(prescription);
    var num = vec_len(ps_vec);
    var n_values = vec_new();
    vec_push(n_values, Prescription_n_initial(prescription));
    var k = 0;
    while (k < num) {
        vec_push(n_values, PrescriptionSurface_n_after(vec_get(ps_vec, k)));
        k = k + 1;
    }

    var reverse_surfaces = vec_new();
    var i = num - 1;
    while (i >= 0) {
        var ps = vec_get(ps_vec, i);
        var n_before_reverse = vec_get(n_values, i + 1);
        var n_after_reverse = vec_get(n_values, i);
        var power_reverse = f64_from(0);
        if (_sys_is_inf(PrescriptionSurface_radius(ps)) == 0) {
            power_reverse = f64_div(f64_sub(n_after_reverse, n_before_reverse),
            f64_neg(PrescriptionSurface_radius(ps)));
        }
        var thickness = f64_from(0);
        if (i > 0) {
            thickness = PrescriptionSurface_thickness(vec_get(ps_vec, i - 1));
        }
        var reduced_t = thickness;
        if (f64_gt(f64_abs(n_after_reverse), _sys_eps15()) == 1) {
            reduced_t = f64_div(thickness, n_after_reverse);
        }
        vec_push(reverse_surfaces, paraxsurf_new(power_reverse, reduced_t));
        i = i - 1;
    }

    var reverse_marginal = paraxial_marginal(F64_ONE);
    var reverse_states = paraxial_trace(reverse_marginal, reverse_surfaces);
    var nr = vec_len(reverse_states);
    var reverse_final = reverse_marginal;
    if (nr > 0) {
        reverse_final = vec_get(reverse_states, nr - 1);
    }
    var ffd = _sys_inf();
    if (f64_gt(f64_abs(ParaxialRay_nu(reverse_final)), _sys_eps15()) == 1) {
        ffd = f64_div(ParaxialRay_y(reverse_final), ParaxialRay_nu(reverse_final));
    }

    var props = alloc(sizeof(SystemProperties));
    if (props == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    SystemProperties_set_focal_length(props, efl);
    SystemProperties_set_bfd(props, bfd);
    SystemProperties_set_ffd(props, ffd);
    SystemProperties_set_power(props, power);
    SystemProperties_set_entrance_pupil(props, f64_from(0));
    SystemProperties_set_exit_pupil(props, f64_sub(bfd, efl));
    return props;
}

# ── Common prescriptions ────────

# Symmetric biconvex thin lens: R = 2*f*(n-1), R1 = -R2.
#must_use
fn prescription_biconvex(focal_length, n, aperture, thickness) {
    var r = f64_mul(f64_mul(F64_TWO, focal_length), f64_sub(n, F64_ONE));
    var p = prescription_new("biconvex");
    var _p1 = prescription_add_surface(p, r, thickness, n, aperture);
    var _p2 = prescription_add_surface(p, f64_neg(r), f64_from(0), F64_ONE, aperture);
    return p;
}

# Plano-convex lens, flat side first: R = -f*(n-1).
#must_use
fn prescription_planoconvex(focal_length, n, aperture, thickness) {
    var r = f64_mul(f64_neg(focal_length), f64_sub(n, F64_ONE));
    var p = prescription_new("plano-convex");
    var _p1 = prescription_add_surface(p, _sys_inf(), thickness, n, aperture);
    var _p2 = prescription_add_surface(p, r, f64_from(0), F64_ONE, aperture);
    return p;
}

# Cemented achromatic doublet. Achromatic condition phi1/v1 + phi2/v2 = 0.
#must_use
fn prescription_doublet(focal_length, n1, v1, n2, v2, aperture, t1, t2) {
    var phi = f64_div(F64_ONE, focal_length);
    var phi1 = f64_div(f64_mul(phi, v1), f64_sub(v1, v2));
    var phi2 = f64_sub(phi, phi1);
    var r1 = f64_div(f64_mul(F64_TWO, f64_sub(n1, F64_ONE)), phi1);
    var r2 = f64_div(f64_sub(n1, F64_ONE), f64_div(phi1, F64_TWO));
    var r4 = _sys_inf();
    if (f64_gt(f64_abs(phi2), _sys_eps15()) == 1) {
        r4 = f64_div(f64_mul(f64_neg(r2), f64_sub(n2, F64_ONE)),
        f64_add(f64_mul(r2, phi2), f64_sub(n2, F64_ONE)));
    }
    var p = prescription_new("achromatic doublet");
    var _p1 = prescription_add_surface(p, r1, t1, n1, aperture);
    var _p2 = prescription_add_surface(p, r2, t2, n2, aperture);
    var _p3 = prescription_add_surface(p, r4, f64_from(0), F64_ONE, aperture);
    return p;
}

# --- ray_dispersion.cyr ---

# ray_dispersion.cyr -- dispersion models (Cauchy/Sellmeier/Herzberger/Schott/
# Conrady), prisms, Abbe number, chromatic aberration.
# Usage: include "lib/ray_dispersion.cyr"  (requires error.cyr)
#
# Ported from the Rust `ray/dispersion.rs`. Glass coefficients are encoded as
# exact ratios (num/den, both < 2^53) which reproduce Rust's decimal literals
# bit-for-bit. Wavelengths are in micrometers.

fn _disp_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _disp_eps15() { return f64_div(F64_ONE, f64_from(1000000000000000)); }

# Fraunhofer reference wavelengths (micrometers).
#must_use
fn fraunhofer_d() { return _disp_r(58756, 100000); }   # 0.58756 (He yellow)
#must_use
fn fraunhofer_f() { return _disp_r(48613, 100000); }   # 0.48613 (H blue)
#must_use
fn fraunhofer_c() { return _disp_r(65627, 100000); }   # 0.65627 (H red)

# ── Cauchy dispersion: n(l) = b + c/l^2 ────────

#derive(accessors)
struct CauchyCoefficients { b; c; }

fn _cauchy_mk(b, c) {
    var x = alloc(sizeof(CauchyCoefficients));
    if (x == 0) { return 0; }
    CauchyCoefficients_set_b(x, b);
    CauchyCoefficients_set_c(x, c);
    return x;
}

#must_use
fn cauchy_bk7() { return _cauchy_mk(_disp_r(15046, 10000), _disp_r(420, 100000)); }
#must_use
fn cauchy_fused_silica() { return _cauchy_mk(_disp_r(14580, 10000), _disp_r(354, 100000)); }

# Refractive index at wavelength_um: b + c/l^2.
#must_use
fn cauchy_n_at(coef, wavelength_um) {
    var l2 = f64_mul(wavelength_um, wavelength_um);
    return f64_add(CauchyCoefficients_b(coef), f64_div(CauchyCoefficients_c(coef), l2));
}

# ── Sellmeier dispersion (3-term) ────────

#derive(accessors)
struct SellmeierCoefficients { b1; c1; b2; c2; b3; c3; }

fn _sellmeier_mk(b1, c1, b2, c2, b3, c3) {
    var s = alloc(sizeof(SellmeierCoefficients));
    if (s == 0) { return 0; }
    SellmeierCoefficients_set_b1(s, b1);
    SellmeierCoefficients_set_c1(s, c1);
    SellmeierCoefficients_set_b2(s, b2);
    SellmeierCoefficients_set_c2(s, c2);
    SellmeierCoefficients_set_b3(s, b3);
    SellmeierCoefficients_set_c3(s, c3);
    return s;
}

#must_use
fn sellmeier_bk7() {
    return _sellmeier_mk(
    _disp_r(103961212, 100000000), _disp_r(600069867, 100000000000),
    _disp_r(231792344, 1000000000), _disp_r(200179144, 10000000000),
    _disp_r(101046945, 100000000), _disp_r(103560653, 1000000));
}
#must_use
fn sellmeier_sf11() {
    return _sellmeier_mk(
    _disp_r(173759626, 100000000), _disp_r(131887070, 10000000000),
    _disp_r(313747346, 1000000000), _disp_r(623068142, 10000000000),
    _disp_r(189878101, 100000000), _disp_r(15523629, 100000));
}
#must_use
fn sellmeier_fused_silica() {
    return _sellmeier_mk(
    _disp_r(6961663, 10000000), _disp_r(46791482, 10000000000),
    _disp_r(4079426, 10000000), _disp_r(13512063, 1000000000),
    _disp_r(8974794, 10000000), _disp_r(979340025, 10000000));
}
#must_use
fn sellmeier_sapphire() {
    return _sellmeier_mk(
    _disp_r(14313493, 10000000), _disp_r(527925, 100000000),
    _disp_r(65054713, 100000000), _disp_r(1421826, 100000000),
    _disp_r(53414822, 10000000), _disp_r(32501783, 100000));
}
#must_use
fn sellmeier_water() {
    return _sellmeier_mk(
    _disp_r(56701972, 100000000), _disp_r(508550, 100000000),
    _disp_r(17262926, 100000000), _disp_r(1818000, 100000000),
    _disp_r(2062460, 100000000), _disp_r(2625000, 100000000));
}
#must_use
fn sellmeier_diamond() {
    # two-term fit: b3 = 0, c3 = 1.0
    return _sellmeier_mk(
    _disp_r(43358, 10000), _disp_r(106, 10000),
    _disp_r(3060, 10000), _disp_r(175, 10000),
    f64_from(0), F64_ONE);
}

# One Sellmeier term with a resonance-pole guard: b*l2/(l2-c), or 0 near the pole.
fn _sellmeier_term(b, l2, c) {
    var d = f64_sub(l2, c);
    if (f64_gt(f64_abs(d), _disp_eps15()) == 1) {
        return f64_div(f64_mul(b, l2), d);
    }
    return f64_from(0);
}

# Refractive index at wavelength_um. Clamps to 1.0 in the unphysical n^2 < 1 region.
#must_use
fn sellmeier_n_at(coef, wavelength_um) {
    var l2 = f64_mul(wavelength_um, wavelength_um);
    var t1 = _sellmeier_term(SellmeierCoefficients_b1(coef), l2, SellmeierCoefficients_c1(coef));
    var t2 = _sellmeier_term(SellmeierCoefficients_b2(coef), l2, SellmeierCoefficients_c2(coef));
    var t3 = _sellmeier_term(SellmeierCoefficients_b3(coef), l2, SellmeierCoefficients_c3(coef));
    var n2 = f64_add(f64_add(f64_add(F64_ONE, t1), t2), t3);
    if (f64_lt(n2, F64_ONE) == 1) {
        return F64_ONE;
    }
    return f64_sqrt(n2);
}

# Abbe number V = (n_d - 1) / (n_F - n_C).
#must_use
fn abbe_number(sellmeier) {
    var n_d = sellmeier_n_at(sellmeier, fraunhofer_d());
    var n_f = sellmeier_n_at(sellmeier, fraunhofer_f());
    var n_c = sellmeier_n_at(sellmeier, fraunhofer_c());
    return f64_div(f64_sub(n_d, F64_ONE), f64_sub(n_f, n_c));
}

# ── Prism ────────

# Minimum deviation angle: d_min = 2*asin(n*sin(A/2)) - A. Writes PK_ERR_TIR
# (returns 0) if n*sin(A/2) exceeds 1.
#must_use
fn prism_deviation(apex_angle, n, err_out) {
    store64(err_out, PK_ERR_NONE);
    var sin_half_a = _prk_sin(f64_div(apex_angle, F64_TWO));
    var arg = f64_mul(n, sin_half_a);
    if (f64_gt(f64_abs(arg), F64_ONE) == 1) {
        store64(err_out, PK_ERR_TIR);
        return 0;
    }
    return f64_sub(f64_mul(F64_TWO, ganita_f64_asin(arg)), apex_angle);
}

# Prism deviation using the Sellmeier index at wavelength_um.
#must_use
fn prism_dispersion(apex_angle, sellmeier, wavelength_um, err_out) {
    var n = sellmeier_n_at(sellmeier, wavelength_um);
    return prism_deviation(apex_angle, n, err_out);
}

# (dev_short, dev_long, angular_spread) for prism_angular_spread.
#derive(accessors)
struct PrismSpread { dev_short; dev_long; spread; }

# Angular spread across a wavelength range. Returns a PrismSpread (0 on error).
#must_use
fn prism_angular_spread(apex_angle, sellmeier, wavelength_short_um, wavelength_long_um, err_out) {
    store64(err_out, PK_ERR_NONE);
    var e1 = 0;
    var dev_short = prism_dispersion(apex_angle, sellmeier, wavelength_short_um, &e1);
    if (prakash_is_err(e1) == 1) {
        store64(err_out, e1);
        return 0;
    }
    var e2 = 0;
    var dev_long = prism_dispersion(apex_angle, sellmeier, wavelength_long_um, &e2);
    if (prakash_is_err(e2) == 1) {
        store64(err_out, e2);
        return 0;
    }
    var ps = alloc(sizeof(PrismSpread));
    if (ps == 0) { return 0; }
    PrismSpread_set_dev_short(ps, dev_short);
    PrismSpread_set_dev_long(ps, dev_long);
    PrismSpread_set_spread(ps, f64_abs(f64_sub(dev_short, dev_long)));
    return ps;
}

# ── Additional dispersion models ────────

# Herzberger (5-term): n = a + b*L + c*L^2 + d*l2 + e*l2^2, L = 1/(l2 - 0.028).
#derive(accessors)
struct HerzbergerCoefficients { a; b; c; d; e; }

fn _herzberger_mk(a, b, c, d, e) {
    var h = alloc(sizeof(HerzbergerCoefficients));
    if (h == 0) { return 0; }
    HerzbergerCoefficients_set_a(h, a);
    HerzbergerCoefficients_set_b(h, b);
    HerzbergerCoefficients_set_c(h, c);
    HerzbergerCoefficients_set_d(h, d);
    HerzbergerCoefficients_set_e(h, e);
    return h;
}

#must_use
fn herzberger_n_at(coef, wavelength_um) {
    var l2 = f64_mul(wavelength_um, wavelength_um);
    var l = f64_div(F64_ONE, f64_sub(l2, _disp_r(28, 1000)));   # 0.028
    # Match Rust's left-associative coefficient-first order: c*l*l = (c*l)*l.
    var term_a = HerzbergerCoefficients_a(coef);
    var term_b = f64_mul(HerzbergerCoefficients_b(coef), l);
    var term_c = f64_mul(f64_mul(HerzbergerCoefficients_c(coef), l), l);
    var term_d = f64_mul(HerzbergerCoefficients_d(coef), l2);
    var term_e = f64_mul(f64_mul(HerzbergerCoefficients_e(coef), l2), l2);
    return f64_add(f64_add(f64_add(f64_add(term_a, term_b), term_c), term_d), term_e);
}

# Schott (6-term legacy): n^2 = a0 + a1*l2 + a2/l2 + a3/l2^2 + a4/l2^3 + a5/l2^4.
#derive(accessors)
struct SchottCoefficients { a0; a1; a2; a3; a4; a5; }

fn _schott_mk(a0, a1, a2, a3, a4, a5) {
    var s = alloc(sizeof(SchottCoefficients));
    if (s == 0) { return 0; }
    SchottCoefficients_set_a0(s, a0);
    SchottCoefficients_set_a1(s, a1);
    SchottCoefficients_set_a2(s, a2);
    SchottCoefficients_set_a3(s, a3);
    SchottCoefficients_set_a4(s, a4);
    SchottCoefficients_set_a5(s, a5);
    return s;
}

#must_use
fn schott_bk7() {
    return _schott_mk(
    _disp_r(22718929, 10000000), f64_neg(_disp_r(10108077, 1000000000)),
    _disp_r(10592509, 1000000000), _disp_r(200816, 1000000000),
    f64_neg(_disp_r(76472538, 10000000000000)), _disp_r(49240991, 100000000000000));
}

#must_use
fn schott_n_at(coef, wavelength_um) {
    var l2 = f64_mul(wavelength_um, wavelength_um);
    var li = f64_div(F64_ONE, l2);
    # Match Rust's left-associative coefficient-first folds: a3*x*x = (a3*x)*x.
    var t3 = f64_mul(f64_mul(SchottCoefficients_a3(coef), li), li);
    var t4 = f64_mul(f64_mul(f64_mul(SchottCoefficients_a4(coef), li), li), li);
    var t5 = f64_mul(f64_mul(f64_mul(f64_mul(SchottCoefficients_a5(coef), li), li), li), li);
    var n2 = f64_add(f64_add(f64_add(f64_add(f64_add(
    SchottCoefficients_a0(coef),
    f64_mul(SchottCoefficients_a1(coef), l2)),
    f64_mul(SchottCoefficients_a2(coef), li)),
    t3), t4), t5);
    if (f64_gt(n2, f64_from(0)) == 1) {
        return f64_sqrt(n2);
    }
    return F64_ONE;
}

# Conrady (3-term): n = n0 + a/l + b/l^3.5.
#derive(accessors)
struct ConradyCoefficients { n0; a; b; }

fn _conrady_mk(n0, a, b) {
    var c = alloc(sizeof(ConradyCoefficients));
    if (c == 0) { return 0; }
    ConradyCoefficients_set_n0(c, n0);
    ConradyCoefficients_set_a(c, a);
    ConradyCoefficients_set_b(c, b);
    return c;
}

#must_use
fn conrady_n_at(coef, wavelength_um) {
    var term_a = f64_div(ConradyCoefficients_a(coef), wavelength_um);
    var term_b = f64_div(ConradyCoefficients_b(coef), _prk_pow(wavelength_um, _disp_r(7, 2)));
    return f64_add(f64_add(ConradyCoefficients_n0(coef), term_a), term_b);
}

# ── Partial dispersion & chromatic aberration ────────

# Partial dispersion P_g,F = (n_g - n_F) / (n_F - n_C). 0 if n_F ~ n_C.
#must_use
fn partial_dispersion(sellmeier) {
    var n_g = sellmeier_n_at(sellmeier, _disp_r(43584, 100000));   # g-line 0.43584
    var n_f = sellmeier_n_at(sellmeier, fraunhofer_f());
    var n_c = sellmeier_n_at(sellmeier, fraunhofer_c());
    var dn_fc = f64_sub(n_f, n_c);
    if (f64_lt(f64_abs(dn_fc), _disp_eps15()) == 1) {
        return f64_from(0);
    }
    return f64_div(f64_sub(n_g, n_f), dn_fc);
}

# Longitudinal chromatic aberration (axial color): df = f / V.
#must_use
fn longitudinal_chromatic_aberration(focal_length, abbe_num) {
    return f64_div(focal_length, abbe_num);
}

# Lateral (transverse) chromatic aberration: TCA = h / V.
#must_use
fn lateral_chromatic_aberration(image_height, abbe_num) {
    return f64_div(image_height, abbe_num);
}

# Secondary spectrum (residual after achromatic correction): f * dP / V.
#must_use
fn secondary_spectrum(focal_length, delta_p, abbe_num) {
    return f64_div(f64_mul(focal_length, delta_p), abbe_num);
}

# --- ray_fiber.cyr ---

# ray_fiber.cyr -- fiber optics: numerical aperture, V-number, modes, coupling
# Usage: include "lib/ray_fiber.cyr"  (requires error.cyr)
#
# Ported from the Rust `ray/fiber.rs`. Non-integer literals are exact ratios.
# `v.powf(-1.5)` uses ganita_f64_pow (transcendental, like Rust powf); `v.powi(-6)`
# is an exact integer power computed as 1/v^6 by squaring (not a transcendental).

fn _fib_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# Single-mode cutoff V-number (first zero of the J0 Bessel function).
fn _fib_cutoff() { return _fib_r(2405, 1000); }   # 2.405

# Numerical aperture: NA = sqrt(n_core^2 - n_clad^2). Writes
# PK_ERR_INVALID_PARAMETER (returns 0) if n_core < n_clad.
#must_use
fn fiber_na(n_core, n_clad, err_out) {
    store64(err_out, PK_ERR_NONE);
    var na2 = f64_sub(f64_mul(n_core, n_core), f64_mul(n_clad, n_clad));
    if (f64_lt(na2, f64_from(0)) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return f64_sqrt(na2);
}

# V-number (normalized frequency): V = 2*pi*a*NA/lambda. Single-mode at V < 2.405.
#must_use
fn v_number(core_radius, na, wavelength) {
    return f64_div(f64_mul(f64_mul(f64_mul(F64_TWO, F64_PI), core_radius), na), wavelength);
}

# Approximate guided-mode count in a step-index multimode fiber: N ~ V^2/2
# (>= 1). Single-mode (V < 2.405) has exactly one mode.
#must_use
fn num_modes(v) {
    if (f64_lt(v, _fib_cutoff()) == 1) {
        return 1;
    }
    var n = f64_to(f64_div(f64_mul(v, v), F64_TWO));
    if (n < 1) {
        return 1;
    }
    return n;
}

# 1 if the fiber supports only a single mode at this V-number (V < 2.405).
#must_use
fn is_single_mode(v) {
    return f64_lt(v, _fib_cutoff());
}

# Mode field diameter (Marcuse): MFD ~ 2a*(0.65 + 1.619*V^-1.5 + 2.879*V^-6).
# Valid for 0.8 < V < 2.5.
#must_use
fn mode_field_diameter(core_radius, v) {
    # V^-6 as an exact integer power: 1 / (V^2 * (V^2 * V^2)), matching powi.
    var v2 = f64_mul(v, v);
    var v6 = f64_mul(v2, f64_mul(v2, v2));
    var inv_v6 = f64_div(F64_ONE, v6);
    var term_pm15 = f64_mul(_fib_r(1619, 1000), _prk_pow(v, f64_neg(_fib_r(15, 10))));
    var term_pm6 = f64_mul(_fib_r(2879, 1000), inv_v6);
    var factor = f64_add(f64_add(_fib_r(65, 100), term_pm15), term_pm6);
    return f64_mul(f64_mul(F64_TWO, core_radius), factor);
}

# Gaussian-beam / single-mode-fiber coupling efficiency:
# eta = (2*w_beam*w_fiber / (w_beam^2 + w_fiber^2))^2. eta = 1 when w_beam = w_fiber.
#must_use
fn coupling_efficiency_gaussian(w_beam, w_fiber) {
    var num = f64_mul(f64_mul(F64_TWO, w_beam), w_fiber);
    var den = f64_add(f64_mul(w_beam, w_beam), f64_mul(w_fiber, w_fiber));
    var ratio = f64_div(num, den);
    return f64_mul(ratio, ratio);
}

# --- spectral_core.cyr ---

# spectral_core.cyr -- wavelength<->RGB, blackbody radiation, color temperature
# Usage: include "lib/spectral_core.cyr"  (requires error.cyr)
#
# Ported from the Rust `spectral/mod.rs`. Extreme-magnitude physical constants
# (Planck, Boltzmann) are encoded as exact IEEE-754 hex bit patterns; other
# non-integers are exact ratios. `_expm1` reproduces Rust's `f64::exp_m1` via
# Kahan's identity (2.1.1) — the port previously substituted a bare exp(x)-1,
# which returned 0 for any |x| below about 1e-16.

fn _r(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# ── Physical constants ────────
#must_use
fn spec_visible_min_nm() { return f64_from(380); }
#must_use
fn spec_visible_max_nm() { return f64_from(780); }
#must_use
fn spec_speed_of_light() { return f64_from(299792458); }        # m/s
#must_use
fn spec_planck_h() { return 0x390B860BDE023111; }               # 6.62607015e-34 J*s
#must_use
fn spec_boltzmann_k() { return 0x3B30B0E6D55E647C; }            # 1.380649e-23 J/K

# First/second radiation constants (2*h*c*c ; h*c/k), left-associative like Rust.
fn _planck_c1() {
    return f64_mul(f64_mul(f64_mul(F64_TWO, spec_planck_h()), spec_speed_of_light()), spec_speed_of_light());
}
fn _planck_c2() {
    return f64_div(f64_mul(spec_planck_h(), spec_speed_of_light()), spec_boltzmann_k());
}

# ── Rgb ────────

#derive(accessors)
struct Rgb { r; g; b; }

#must_use
fn rgb_new(r, g, b) {
    var c = alloc(sizeof(Rgb));
    if (c == 0) { return 0; }
    Rgb_set_r(c, r);
    Rgb_set_g(c, g);
    Rgb_set_b(c, b);
    return c;
}

#must_use
fn rgb_black() { return rgb_new(f64_from(0), f64_from(0), f64_from(0)); }
#must_use
fn rgb_white() { return rgb_new(F64_ONE, F64_ONE, F64_ONE); }

# Clamp all channels to [0, 1].
#must_use
fn rgb_clamp(c) {
    return rgb_new(
    f64_clamp(Rgb_r(c), f64_from(0), F64_ONE),
    f64_clamp(Rgb_g(c), f64_from(0), F64_ONE),
    f64_clamp(Rgb_b(c), f64_from(0), F64_ONE));
}

# 8-bit sRGB channels (0-255).
#derive(accessors)
struct RgbU8 { r; g; b; }

# channel*255 + 0.5 truncated, with Rust `as u8` saturation. f64_clamp lets a
# NaN through (matching Rust f64::clamp), and f64_to(NaN) is INT64_MIN, so the
# NaN case must be caught here: Rust's saturating cast yields 0.
fn _r_sat_u8(ch) {
    var v = f64_add(f64_mul(ch, f64_from(255)), _r(5, 10));
    # NaN fails every comparison, so this catches it as well as negatives.
    if (f64_gt(v, f64_from(0)) == 0) { return 0; }
    if (f64_gt(v, f64_from(255)) == 1) { return 255; }
    return f64_to(v);
}

#must_use
fn rgb_to_u8(c) {
    var cc = rgb_clamp(c);
    var u = alloc(sizeof(RgbU8));
    if (u == 0) { return 0; }
    RgbU8_set_r(u, _r_sat_u8(Rgb_r(cc)));
    RgbU8_set_g(u, _r_sat_u8(Rgb_g(cc)));
    RgbU8_set_b(u, _r_sat_u8(Rgb_b(cc)));
    return u;
}

# Rec. 709 luminance: 0.2126*r + 0.7152*g + 0.0722*b.
#must_use
fn rgb_luminance(c) {
    return f64_add(f64_add(
    f64_mul(_r(2126, 10000), Rgb_r(c)),
    f64_mul(_r(7152, 10000), Rgb_g(c))),
    f64_mul(_r(722, 10000), Rgb_b(c)));
}

# ── Wavelength -> RGB ────────

# Piecewise-linear CIE approximation. Writes PK_ERR_WAVELENGTH_RANGE (returns 0)
# outside 380-780 nm (NaN also fails the range test).
#must_use
fn wavelength_to_rgb(wavelength_nm, err_out) {
    _prk_trace("wavelength_to_rgb");
    store64(err_out, PK_ERR_NONE);
    var in_range = 0;
    if (f64_ge(wavelength_nm, spec_visible_min_nm()) == 1) {
        if (f64_le(wavelength_nm, spec_visible_max_nm()) == 1) {
            in_range = 1;
        }
    }
    if (in_range == 0) {
        store64(err_out, PK_ERR_WAVELENGTH_RANGE);
        return 0;
    }

    var w = wavelength_nm;
    var r = f64_from(0);
    var g = f64_from(0);
    var b = f64_from(0);
    if (f64_lt(w, f64_from(440)) == 1) {
        r = f64_div(f64_neg(f64_sub(w, f64_from(440))), f64_sub(f64_from(440), f64_from(380)));
        b = F64_ONE;
    } elif (f64_lt(w, f64_from(490)) == 1) {
        g = f64_div(f64_sub(w, f64_from(440)), f64_sub(f64_from(490), f64_from(440)));
        b = F64_ONE;
    } elif (f64_lt(w, f64_from(510)) == 1) {
        g = F64_ONE;
        b = f64_div(f64_neg(f64_sub(w, f64_from(510))), f64_sub(f64_from(510), f64_from(490)));
    } elif (f64_lt(w, f64_from(580)) == 1) {
        r = f64_div(f64_sub(w, f64_from(510)), f64_sub(f64_from(580), f64_from(510)));
        g = F64_ONE;
    } elif (f64_lt(w, f64_from(645)) == 1) {
        r = F64_ONE;
        g = f64_div(f64_neg(f64_sub(w, f64_from(645))), f64_sub(f64_from(645), f64_from(580)));
    } else {
        r = F64_ONE;
    }

    var factor = F64_ONE;
    if (f64_lt(w, f64_from(420)) == 1) {
        factor = f64_add(_r(3, 10),
        f64_div(f64_mul(_r(7, 10), f64_sub(w, f64_from(380))), f64_sub(f64_from(420), f64_from(380))));
    } elif (f64_gt(w, f64_from(700)) == 1) {
        factor = f64_add(_r(3, 10),
        f64_div(f64_mul(_r(7, 10), f64_sub(f64_from(780), w)), f64_sub(f64_from(780), f64_from(700))));
    }

    return rgb_new(f64_mul(r, factor), f64_mul(g, factor), f64_mul(b, factor));
}

# ── Blackbody radiation ────────

# exp(x) - 1, accurate for small x. Rust used `f64::exp_m1`; the port originally
# substituted a bare `exp(x) - 1`, which loses the entire result to cancellation
# once x is small enough that exp(x) rounds to a neighbour of 1.0 (below about
# 1e-16 it returns exactly 0 where the true value is x).
#
# Kahan's identity: with u = exp(x), the ratio (u-1)/ln(u) corrects the rounding
# in both u and u-1, because the SAME u appears in numerator and denominator, so
# their errors cancel to first order. Exact at u == 1 (return x directly) and
# guarded at u == 0 (x very negative, where exp underflows and the answer is -1).
fn _expm1(x) {
    var u = _prk_exp(x);
    if (u == F64_ONE) { return x; }
    if (u == 0) { return f64_neg(F64_ONE); }
    var um1 = f64_sub(u, F64_ONE);
    if (um1 == f64_neg(F64_ONE)) { return f64_neg(F64_ONE); }
    return f64_div(f64_mul(um1, x), f64_ln(u));
}

# Planck's law: spectral radiance (W*sr^-1*m^-3) at wavelength_m and temperature_k.
# Uses the Wien approximation for x > 500 to avoid exp overflow; 0 for T <= 0.
#must_use
fn planck_radiance(wavelength_m, temperature_k) {
    if (f64_le(temperature_k, f64_from(0)) == 1) {
        return f64_from(0);
    }
    var x = f64_div(_planck_c2(), f64_mul(wavelength_m, temperature_k));
    # lambda^5 as an exact integer power (powi 5): wl * (wl^2)^2.
    var wl2 = f64_mul(wavelength_m, wavelength_m);
    var wl4 = f64_mul(wl2, wl2);
    var lambda5 = f64_mul(wavelength_m, wl4);
    if (f64_gt(x, f64_from(500)) == 1) {
        return f64_div(_planck_c1(), f64_mul(lambda5, _prk_exp(x)));
    }
    return f64_div(_planck_c1(), f64_mul(lambda5, _expm1(x)));
}

# Wien's displacement law: peak wavelength (m) = 2.897771955e-3 / T.
#must_use
fn wien_peak(temperature_k) {
    return f64_div(_r(2897771955, 1000000000000), temperature_k);
}

# Color temperature (Kelvin) -> RGB via Tanner Helland's algorithm.
#must_use
fn color_temperature_to_rgb(kelvin) {
    _prk_trace("color_temperature_to_rgb");
    var temp = f64_clamp(f64_div(kelvin, f64_from(100)), f64_from(10), f64_from(400));

    var r = F64_ONE;
    # Negate `temp <= 66` rather than testing `temp > 66`: the two agree for
    # every finite input, but on a NaN both comparisons are false, and Rust's
    # `if temp <= 66.0 { 1.0 } else { ... }` takes the ELSE branch there.
    # bridge.cyr's copy of this fit already negates; this keeps them identical.
    if (f64_le(temp, f64_from(66)) == 0) {
        var xr = f64_sub(temp, f64_from(60));
        r = f64_clamp(
        f64_div(f64_mul(_r(329698727446, 1000000000),
        _prk_pow(xr, f64_neg(_r(1332047592, 10000000000)))), f64_from(255)),
        f64_from(0), F64_ONE);
    }

    var g = f64_from(0);
    if (f64_le(temp, f64_from(66)) == 1) {
        g = f64_div(f64_clamp(
        f64_sub(f64_mul(_r(994708025861, 10000000000), f64_ln(temp)), _r(1611195681661, 10000000000)),
        f64_from(0), f64_from(255)), f64_from(255));
    } else {
        var xg = f64_sub(temp, f64_from(60));
        g = f64_clamp(
        f64_div(f64_mul(_r(2881221695283, 10000000000),
        _prk_pow(xg, f64_neg(_r(7551484937, 100000000000)))), f64_from(255)),
        f64_from(0), F64_ONE);
    }

    var b = F64_ONE;
    if (f64_ge(temp, f64_from(66)) == 1) {
        b = F64_ONE;
    } elif (f64_le(temp, f64_from(19)) == 1) {
        b = f64_from(0);
    } else {
        var xb = f64_sub(temp, f64_from(10));
        b = f64_div(f64_clamp(
        f64_sub(f64_mul(_r(1385177312231, 10000000000), f64_ln(xb)), _r(3050447927307, 10000000000)),
        f64_from(0), f64_from(255)), f64_from(255));
    }

    return rgb_new(r, g, b);
}

# ── Frequency & photon energy ────────

# Wavelength (nm) -> frequency (Hz).
#must_use
fn wavelength_to_frequency(wavelength_nm) {
    return f64_div(spec_speed_of_light(), f64_mul(wavelength_nm, _r(1, 1000000000)));
}

# Frequency (Hz) -> wavelength (nm).
#must_use
fn frequency_to_wavelength(frequency_hz) {
    return f64_mul(f64_div(spec_speed_of_light(), frequency_hz), f64_from(1000000000));
}

# Photon energy (Joules) for a wavelength (nm).
#must_use
fn photon_energy(wavelength_nm) {
    return f64_mul(spec_planck_h(), wavelength_to_frequency(wavelength_nm));
}

# Photon energy (electron-volts) for a wavelength (nm).
#must_use
fn photon_energy_ev(wavelength_nm) {
    return f64_div(photon_energy(wavelength_nm), 0x3C07A4DA290C1653);   # / 1.602176634e-19
}

# --- spectral_cie.cyr ---

# spectral_cie.cyr -- CIE color science: CMF tables, XYZ, SPD, illuminants, CRI
# Usage: include "lib/spectral_cie.cyr"  (requires error.cyr, spectral_core.cyr)
#
# Ported from the Rust `spectral/cie.rs`. The four 81x3 color-matching-function
# tables and four 81-value illuminant SPDs are lazily-initialized flat f64
# buffers filled with exact IEEE-754 hex bit patterns (generated from the Rust
# source). Rust's Cow<[f64]> borrowed/owned storage has no Cyrius analogue, so an
# Spd just holds a values pointer + length (from_static and new are equivalent).

fn _cie_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }
fn _cie_eps15() { return f64_div(F64_ONE, f64_from(1000000000000000)); }
fn _cie_eps10() { return f64_div(F64_ONE, f64_from(10000000000)); }

# CMF table row accessors (row i, 24 bytes: x@0, y@8, z@16).
fn _cmf_x(t, i) { return load64(t + i * 24); }
fn _cmf_y(t, i) { return load64(t + i * 24 + 8); }
fn _cmf_z(t, i) { return load64(t + i * 24 + 16); }
# SPD/illuminant value accessor (i-th f64).
fn _spd_val(t, i) { return load64(t + i * 8); }

# ── CIE tables (generated: exact IEEE-754 hex from rust-old/src/spectral/cie.rs) ──
# CMF tables: 81 rows x 3 (x,y,z) = 1944 bytes. Illuminants: 81 f64 = 648 bytes.

var _cie1931_p = 0;
fn _cie1931() {
    if (_cie1931_p != 0) { return _cie1931_p; }
    var t = alloc(1944);
    store64(t + 0, 0x3F5669CED0B30B5B);
    store64(t + 8, 0x3F04727DCBDDB984);
