# ── Prescription (ray/system) ────────

# Prescription -> JSON Str: {"name":..,"surfaces":[{radius,thickness,n_after,
# aperture_radius}...],"n_initial":..}. A flat surface has radius = infinity,
# which JSON cannot express; bayan encodes it as `null` and
# `prescription_from_json` restores it (see `_ser_num_or_inf`).
#must_use
fn prescription_to_json(p) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (p == 0) { return 0; }
    # 2.15.1: a null name was read straight off address 0.
    if (Prescription_name(p) == 0) { return 0; }
    # ⛔ 2.4.9: REFUSE A NaN RATHER THAN LAUNDER IT INTO A VALID LENS. JSON has no
    # NaN, so bayan writes every non-finite f64 as `null` — and the decoder reads a
    # null RADIUS as +inf, a flat surface (_ser_num_or_inf, which exists because a
    # plano surface must survive). So a corrupt or uninitialised radius went in as
    # garbage and came out as a legitimate, silently different lens, with
    # err = PK_ERR_NONE on the way back. A NaN in any other field encoded as null
    # and was REJECTED on decode — loud, but the encoder had still emitted a document
    # its own decoder refuses. Either way the right answer is to not emit it: return
    # the 0 sentinel, the same one a null handle gets.
    if (_ser_is_nan(Prescription_n_initial(p)) == 1) { return 0; }
    var ns = Prescription_surfaces(p);
    for (var ci = 0; ci < vec_len(ns); ci = ci + 1) {
        var cs = vec_get(ns, ci);
        if (_ser_is_nan(PrescriptionSurface_radius(cs)) == 1) { return 0; }
        if (_ser_is_nan(PrescriptionSurface_thickness(cs)) == 1) { return 0; }
        if (_ser_is_nan(PrescriptionSurface_n_after(cs)) == 1) { return 0; }
        if (_ser_is_nan(PrescriptionSurface_aperture_radius(cs)) == 1) { return 0; }
    }
    # 2.3.5: emitted straight into a str_builder instead of through a bayan value
    # tree. See _ser_sb_f64 and the [2.3.5] CHANGELOG entry for why; output is
    # byte-identical and pinned in tests/serialize.tcyr.
    var sb = str_builder_new();
    if (sb == 0) { return 0; }
    str_builder_add_cstr(sb, "{\"name\":");
    str_builder_add_json_str(sb, str_from(Prescription_name(p)));
    str_builder_add_cstr(sb, ",\"surfaces\":[");
    var vec = Prescription_surfaces(p);
    var n = vec_len(vec);
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { str_builder_putc(sb, 44); }
        var surf = vec_get(vec, i);
        str_builder_add_cstr(sb, "{\"radius\":");
        _ser_sb_f64(sb, PrescriptionSurface_radius(surf));
        str_builder_add_cstr(sb, ",\"thickness\":");
        _ser_sb_f64(sb, PrescriptionSurface_thickness(surf));
        str_builder_add_cstr(sb, ",\"n_after\":");
        _ser_sb_f64(sb, PrescriptionSurface_n_after(surf));
        str_builder_add_cstr(sb, ",\"aperture_radius\":");
        _ser_sb_f64(sb, PrescriptionSurface_aperture_radius(surf));
        str_builder_putc(sb, 125);
    }
    str_builder_add_cstr(sb, "],\"n_initial\":");
    _ser_sb_f64(sb, Prescription_n_initial(p));
    str_builder_putc(sb, 125);
    return str_builder_build(sb);
}

# JSON -> Prescription. Sets err_out and returns 0 if the name, n_initial,
# surfaces array, or any surface field is missing or of the wrong type.
#must_use
fn prescription_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var name = _ser_str(v, "name", err_out);
    var n_initial = _ser_num(v, "n_initial", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var surfaces_v = bayan_json_v_obj_get_by_cstr(v, "surfaces");
    if (bayan_json_v_is_arr(surfaces_v) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var p = prescription_new(name);
    if (p == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    Prescription_set_n_initial(p, n_initial);
    for (var i = 0; i < bayan_json_v_arr_len(surfaces_v); i = i + 1) {
        var so = bayan_json_v_arr_get(surfaces_v, i);
        if (bayan_json_v_is_obj(so) == 0) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        var radius = _ser_num_or_inf(so, "radius", err_out);
        var thickness = _ser_num(so, "thickness", err_out);
        var n_after = _ser_num(so, "n_after", err_out);
        var aperture_radius = _ser_num_or_inf(so, "aperture_radius", err_out);
        if (prakash_is_err(load64(err_out)) == 1) { return 0; }
        # A dropped surface would return a Prescription with FEWER elements
        # than the document and PK_ERR_NONE — a silently different lens.
        if (prescription_add_surface(p, radius, thickness, n_after, aperture_radius) == 0) {
            store64(err_out, PK_ERR_ALLOCATION);
            return 0;
        }
    }
    return p;
}

# ── Spd (spectral/cie) ────────

# Spd -> JSON Str: {"start_nm":..,"step_nm":..,"values":[..]}.
#must_use
fn spd_to_json(s) {
    # 2.2.7: a null handle read straight off address 0. The DECODE side was
    # hardened in 2.0.2 (every *_from_json returns 0 rather than dereferencing
    # null) and pinned in tests/hardening.tcyr; the ENCODE side never was, and
    # `cyrius coverage` could not see it because these are all exercised with
    # valid handles. Returning 0 matches the decoders' sentinel.
    if (s == 0) { return 0; }
    # ⛔ 2.4.9: an EMPTY Spd encoded to {"start_nm":..,"step_nm":..,"values":[]},
    # which spd_from_json then rejected with PK_ERR_INVALID_PARAMETER (its `n <= 0`
    # check is deliberate). A document prakash produced that prakash refuses to
    # read breaks the round-trip property the module exists for. The decoder's
    # strictness stands; the encoder now declines to emit what it would refuse.
    if (Spd_len(s) <= 0) { return 0; }
    # ⭐ 2.3.4: emitted straight into a str_builder rather than through a bayan
    # value tree. An Spd carries ~81 samples, so the tree form allocated a JSON
    # float node AND a vec push PER SAMPLE — 162 allocations for one call — to
    # build a structure whose only consumer was the serializer three lines later.
    #
    # Measured same-binary with interleaved arms: **71.76 -> 67.59 us (-5.8%)**,
    # and allocation volume **6,808 -> 2,576 bytes per call (-62%)** for D65 — the
    # cost tracks the rendered decimal length of the values, not only the sample
    # count, so at 81 samples it spans 1,464 (F2) to 5,632 (a 5000 K blackbody).
    # ⚠ The memory figure is the one that matters: prakash's bump allocator NEVER FREES, so
    # every spd_to_json call permanently consumed 6.8 KB. A consumer serializing a
    # few thousand SPDs was giving up ~27 MB it could never get back.
    #
    # ⚠ Grisu2 is UNTOUCHED and deliberately so. `bayan_f64_to_json` is the same
    # renderer the tree path used; it is ~68% of this function's cost and it is
    # why the EMITTED text is round-trip-correct — decoding is bayan's and is not
    # always exact, see the file header (2.3.3 measured it at 671 ns against
    # 66 ns for the 6-decimal renderer it replaced, which silently flushed
    # |x| < 5e-7 to zero). Only the tree is skipped, never the float path.
    #
    # Output is BYTE-IDENTICAL, pinned by tests/serialize.tcyr against the exact
    # wire format: {"start_nm":380.0,"step_nm":5.0,"values":[...]} — no spaces,
    # keys in insertion order.
    var sb = str_builder_new();
    if (sb == 0) { return 0; }
    str_builder_add_cstr(sb, "{\"start_nm\":");
    _ser_sb_f64(sb, Spd_start_nm(s));
    str_builder_add_cstr(sb, ",\"step_nm\":");
    _ser_sb_f64(sb, Spd_step_nm(s));
    str_builder_add_cstr(sb, ",\"values\":[");
    var data = Spd_values(s);
    var n = Spd_len(s);
    for (var i = 0; i < n; i = i + 1) {
        if (i > 0) { str_builder_putc(sb, 44); }
        _ser_sb_f64(sb, load64(data + i * 8));
    }
    str_builder_add_cstr(sb, "]}");
    return str_builder_build(sb);
}

# JSON -> Spd. Sets err_out and returns 0 if start_nm/step_nm are not numeric,
# "values" is not a non-empty array, an element is not numeric, or the sample
# buffer cannot be allocated.
#must_use
fn spd_from_json(json, len, err_out) {
    store64(err_out, PK_ERR_NONE);
    var v = _ser_obj(json, len, err_out);
    if (v == 0) { return 0; }
    var start_nm = _ser_num(v, "start_nm", err_out);
    var step_nm = _ser_num(v, "step_nm", err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    # A grid steps forward (2.15.1: step 0 decoded, and every spd_at on it was NaN; a negative step
    # decoded a grid that runs backward, which nothing reads correctly).
    if (f64_gt(step_nm, f64_from(0)) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var vals_v = bayan_json_v_obj_get_by_cstr(v, "values");
    if (bayan_json_v_is_arr(vals_v) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var n = bayan_json_v_arr_len(vals_v);
    if (n <= 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # `alloc` returns 0 past ALLOC_MAX or on heap exhaustion; `n` comes from the
    # input, so this must be checked before the fill loop stores through it.
    var data = alloc(n * 8);
    if (data == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    for (var i = 0; i < n; i = i + 1) {
        var e = bayan_json_v_arr_get(vals_v, i);
        if (bayan_json_v_is_float(e) == 0) {
            if (bayan_json_v_is_int(e) == 0) {
                store64(err_out, PK_ERR_INVALID_PARAMETER);
                return 0;
            }
        }
        store64(data + i * 8, _ser_fin(bayan_json_v_float(e), err_out));
    }
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    var built = spd_new(start_nm, step_nm, data, n);
    if (built == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return built;
}
