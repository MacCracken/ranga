# Requires (compile-verified; the leaves of dist/prakash.deps):
include "lib/bayan.cyr"

# --- error.cyr ---

# error.cyr -- prakash error codes
# Usage: include "lib/error.cyr"
#
# Replaces Rust's PrakashError enum with integer error codes. Functions return
# PK_ERR_NONE (0) on success or a negative PK_ERR_* code on failure. Where a
# function also returns an f64 result, it takes an `err_out` pointer and writes
# the code there. Detailed failure context (angles, indices) is logged via
# sakshi at the failure site rather than carried in the return value.
#
# Pairs with tagged.cyr for Result-like patterns when an Option is needed.

var PK_ERR_NONE                  = 0;

# Total internal reflection — incident angle exceeds the critical angle.
var PK_ERR_TIR               = (0 - 1);
# Refractive index is below the physical minimum of 1.0.
var PK_ERR_INVALID_INDEX     = (0 - 2);
# Wavelength is outside the visible range (380-780 nm).
var PK_ERR_WAVELENGTH_RANGE  = (0 - 3);
# Angle is outside the valid range (0-90 deg) for a surface interaction.
var PK_ERR_INVALID_ANGLE     = (0 - 4);
# Negative focal length where a positive one is required.
var PK_ERR_INVALID_FOCAL     = (0 - 5);
# Division by zero in an optical calculation.
var PK_ERR_DIVISION_BY_ZERO  = (0 - 6);
# A parameter is outside the valid range for the operation. Also covers an
# out-of-range buffer index and a null handle passed to an accessor.
var PK_ERR_INVALID_PARAMETER = (0 - 7);
# An allocation was refused — the request exceeds ALLOC_MAX (2 GiB), the size
# computation overflowed, or the heap is exhausted. Distinct from
# PK_ERR_INVALID_PARAMETER: the arguments were sane, the memory was not there.
var PK_ERR_ALLOCATION        = (0 - 8);
# The input bytes are not well-formed JSON, or the document is not of the type
# the decoder expected (e.g. an array where an object was required). Distinct
# from PK_ERR_INVALID_PARAMETER, which means the document parsed but a required
# field was absent or of the wrong type — bad bytes vs. wrong schema.
var PK_ERR_PARSE             = (0 - 9);

# Cache epoch: prakash_reset_caches() increments it, and any cache defined in a
# module that cannot see that function's own list (bundle order) compares against
# it and drops itself when it moves. It lives here because this is the one module
# every other module, and every test suite, includes. (2.5.1)
var _prk_cache_epoch = 0;

# 1 if `code` is an error (negative), else 0.
#must_use
fn prakash_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# 1 if `code` is success (PK_ERR_NONE), else 0.
#must_use
fn prakash_is_ok(code) {
    if (code == 0) { return 1; }
    return 0;
}

# ── Rust-semantics math shims ────────
# The Cyrius math builtins diverge from Rust's f64 methods at the infinite and
# zero boundaries. Every ported call site that can reach those boundaries goes
# through these shims so the port keeps matching the Rust original (retrievable
# at tag 2.2.2 / 1.2.0 — see CONTRIBUTING.md).
#
# ⚠ RE-MEASURED FOR cyrius 6.5.33 / ganita 1.1.4 (2.2.4). The previous table
# here was stamped "Measured on cyrius 6.5.20" and ONE OF ITS ROWS HAD GONE
# FALSE: ganita 1.1.4 gained an explicit domain prologue, so a zero base no
# longer falls into exp(n*ln(base)) and no longer returns NaN. No test caught
# it — all 5485 assertions passed either side of the bump — because the shim
# masks the builtin at exactly the point the table describes.
#
# Re-measured on cyrius 6.7.18 / ganita 1.2.15, x86_64 (raw f64 bits), for 2.11.1;
# every row is as it was at 6.6.6 / 1.2.6 (2.4.9):
#
#   expression              Cyrius builtin              Rust    shim
#   ganita_f64_pow(0.0, 2)  0.0  (NaN before 1.1.4)     0.0     0.0
#   ganita_f64_pow(0.0, 0)  1.0  (NaN before 1.1.4)     1.0     1.0
#   ganita_f64_pow(0.0,-1)  +inf (NaN before 1.1.4)     +inf    +inf
#   f64_exp(-inf)           0.0  (NaN at 6.5.33)        0.0     0.0
#   f64_exp(+inf)           +inf (NaN at 6.5.33)        +inf    +inf
#
# ⛔ 2.4.9: ALL FIVE ROWS NOW AGREE WITH RUST WITHOUT THE SHIM. This table used to
# say "the two f64_exp rows are the ones still doing work" — true at 6.5.33 and
# false by 6.6.6, where the intrinsic returns 0.0 and +inf itself. So `_prk_exp`,
# like the zero-base `_prk_pow` branch, is now a REDUNDANT PIN rather than a live
# repair. It stays: it costs one comparison, and if an intrinsic regresses it
# catches that before a consumer does. tests/hardening.tcyr now asserts the RAW
# builtins too, so the next upstream move fails the suite rather than rotting this
# table a third time (it went stale once at 1.1.4 and again between 6.5.33 and
# 6.6.6, both times with every assertion passing).
#
# Finite arguments are delegated unchanged, so no in-range result moves.

# Rust `f64::exp` semantics. Only the infinite arguments are special-cased;
# NaN in still gives NaN out, matching Rust.
#must_use
fn _prk_exp(x) {
    if (x == 0x7FF0000000000000) { return 0x7FF0000000000000; }
    if (x == 0xFFF0000000000000) { return 0; }
    return f64_exp(x);
}

# Sine/cosine with an explicit domain guard. Below cyrius 6.6.9 the x86 builtins
# were bare `fsin`/`fcos`, undefined for |x| >= 2^63: they returned the ARGUMENT
# UNCHANGED, so `f64_sin(1e300)` yielded 1e300 — an "intensity" far outside
# [-1, 1] that then propagated silently through an interference or slit
# calculation. A consumer's pin decides which builtin the bundle compiles against.
#
# ⛔ 2.10.1: THE GUARD OUTLIVES THAT DEFECT, BECAUSE ITS REASON IS THE ARGUMENT, NOT
# THE BUILTIN. 6.6.9's software sin/cos do the full reduction: measured at 6.7.18,
# f64_sin(1e300) = -0.81788 and f64_cos(1e300) = -0.57539, both right, and NaN at
# the infinities. But beyond 2^63 a double's spacing exceeds 2048 while a period is
# 2*pi, so the argument no longer identifies a physical phase at all. prakash
# reports the loss instead of returning a number: these return NaN, which
# propagates visibly. (Rust's libm returns a value; this is a deliberate,
# documented divergence in favour of not fabricating.) Below the limit both
# delegate unchanged.
#
# ⛔ 6.6.9 ALSO CLOSED A DEFECT THIS COMMENT NEVER NAMED. fsin reduces against a
# 66-bit pi, so near a multiple of pi it returned noise WELL inside the limit.
# Against exact rational arithmetic, over 39,999 points x = (7k + 1)*pi up to
# 8.8e5: fsin was up to 44% wrong relative (2.4e15 ulp), the polyfill at most
# 0.5 ulp. tests/hardening.tcyr pins three of those points.
var _PRK_TRIG_LIMIT = 0x43E0000000000000;   # 2^63
var _PRK_NAN        = 0x7FF8000000000000;

#must_use
fn _prk_sin(x) {
    if (f64_lt(f64_abs(x), _PRK_TRIG_LIMIT) == 0) { return _PRK_NAN; }
    return f64_sin(x);
}

#must_use
fn _prk_cos(x) {
    if (f64_lt(f64_abs(x), _PRK_TRIG_LIMIT) == 0) { return _PRK_NAN; }
    return f64_cos(x);
}

# The phase 2*pi*cycles with the whole cycles removed first: a path r at wavelength
# lambda is r/lambda cycles, and this is the phase to hand _prk_sin/_prk_cos.
# 2.11.0: from 2^20*pi/2 ~ 1.65e6 rad (a path of 0.14 m at 550 nm) f64_sin/f64_cos
# take full reduction at ~525 ns, 10x their ~45 ns, and cycles - floor(cycles) is
# exact, so one floor saves that. It also rounds less: k*r rounds twice, r/lambda
# once. Against exact rational arithmetic over r = 1 mm..1e9 m and 400-700 nm the
# worst phase error is 2.4x smaller, at every scale.
# ⛔ Past 2^52 cycles the fraction is 0 for EVERY argument, so a reduced phase would
# be a fabricated 0. There the unreduced phase goes through, and _prk_sin/_prk_cos
# report it as NaN past 2^63 rad. The sign of `cycles` does not matter: the fraction
# is taken from the floor, so a negative argument lands in [0, 2*pi) one period on.
#must_use
fn _prk_cycles_phase(cycles) {
    if (f64_lt(f64_abs(cycles), 0x4330000000000000) == 0) {     # 2^52; NaN lands here too
        return f64_mul(F64_TAU, cycles);
    }
    return f64_mul(F64_TAU, f64_sub(cycles, f64_floor(cycles)));
}

# Rust `f64::powf` semantics across the whole non-finite domain.
#
# Rust's `powf` is IEEE-754 / C99 `pow`. `ganita_f64_pow` was not when this was
# written: its core was `exp(y * ln x)`, and every operand it did not special-case
# ahead of that core reached `f64_exp`, which was the x87 `exp` — NaN for an
# infinite argument. This shim restores conformance; the C99 F.10.4.4 order is
# followed literally, because the cases overlap and the order is what
# disambiguates them (pow(NaN, 0) is 1, not NaN; pow(1, NaN) is 1, not NaN).
#
# ⛔ 2.10.1: ganita 1.2.7 took C99's table itself and 1.2.8 sent every finite pow
# through fdlibm's e_pow. Re-measured at 1.2.14, raw ganita_f64_pow against this
# shim over the 256 rows of {+-0, +-1, +-2, +-1/2, +-3, +-5/2, +-inf, +-NaN}^2: NO
# VALUE DIFFERS. The 27 rows that do differ are all NaN sign: ganita answers
# 0xFFF8..., this shim the operand's NaN, as Rust does. So the shim now repairs that
# sign and is otherwise a pin, kept for consumers whose ganita is older than theirs.
#
# ⚠ 2.2.5 IS THE BEHAVIOUR CHANGE. Through 2.2.4 this shim handled a zero base
# and delegated everything else, so 24 of the 50 rows in the C99 special-case
# table disagreed with Rust. Measured on cyrius 6.5.33 / ganita 1.1.4, raw f64
# bits, against `(base as f64).powf(exp)` on rustc 1.97.1 — the divergent rows:
#
#   expression        2.2.4 (_prk_pow)      Rust / 2.2.5
#   pow(±0, NaN)      0x3FF0…  (1.0)        NaN  (the exponent's own NaN)
#   pow(1, NaN)       NaN                   0x3FF0…  (1.0)
#   pow(1, ±inf)      NaN                   0x3FF0…  (1.0)
#   pow(-1, ±inf)     NaN                   0x3FF0…  (1.0)
#   pow(2, +inf)      NaN                   +inf          pow(2, -inf)  -> +0
#   pow(0.5, +inf)    NaN                   +0            pow(0.5,-inf) -> +inf
#   pow(-2, ±inf)     NaN                   +inf / +0
#   pow(±inf, y)      NaN                   ±inf / ±0 by sign and y's parity
#   pow(-0, 3)        0x0      (+0.0)       0x8000…  (-0.0)
#   pow(-0, -3)       +inf                  -inf
#   pow(-NaN, 2)      0x7FF8…               0xFFF8…  (Rust propagates sign)
#
# ⚠ TWO OF THOSE WERE REACHABLE, which is why this is a release and not a note.
# `br_absolute_magnitude_to_luminosity` computes `10^((4.83 - M)/2.5)`, so an
# infinite magnitude gives an infinite exponent; `atm_air_mass` computes
# `(96.07995 - z_deg)^-1.6364`, so an infinite zenith angle gives an infinite
# base. Both returned NaN where Rust returns a defined value. The other ten
# `_prk_pow` call sites (12 in all, counted 2.4.9 — this said "seven") pass a
# finite exponent and cannot reach here: nine pass a constant, and the tenth,
# pbr_distribution_charlie, passes the COMPUTED 1/alpha — finite by construction
# because alpha is clamped to [0.001, 1] two lines above it, so 1/alpha <= 1000.
#
# ⚠ WHAT THIS DOES NOT FIX — ONE remaining divergent row, ULP inexactness in the
# `exp`/`ln` pair rather than a domain error, left alone:
#   pow(2, 0.5) = 0x3FF6A09E667F3BCC  vs Rust 0x3FF6A09E667F3BCD (1 ULP)
# Closing it means a correctly-rounded pow, not a guard.
# ⛔ 2.4.9: THIS LISTED THREE ROWS; TWO HAD CLOSED UPSTREAM. Re-measured on cyrius
# 6.6.6 / ganita 1.2.6: pow(2, 3) = 0x4020000000000000 and pow(-2, 3) =
# 0xC020000000000000, exactly 8 and -8 as Rust gives. tests/hardening.tcyr had
# already recorded that ("the cyrius 6.6.2 bump CLOSED three of the four"), so the
# suite and this comment contradicted each other and the suite was right — and this
# text ships verbatim in both dist/ bundles, telling consumers integer powers were
# 1 ULP under when they were exact.
#
# ⚠ AND ONE MORE, found by widening the sweep rather than reported — AND ALSO
# CLOSED UPSTREAM BY 6.6.6 (re-measured 2.4.9: raw ganita_f64_pow(-5e-324, 3) =
# 0x8000000000000000, matching Rust). What it said, for the record: a negative
# base that underflowed through an odd exponent lost its sign.
#   pow(-5e-324, 3) = 0x0  vs Rust 0x8000000000000000 (-0.0)   [was; now fixed]
# Root cause traced, not guessed: ganita takes the magnitude from
# exp(3*ln(5e-324)), which underflows to +0 (measured), then applies the sign
# with `f64_neg` — and cyrius's `f64_neg(+0.0)` yielded +0.0 until 6.6.8 (measured).
# The sign is lost in the delegate's underflow tail, not in the domain guard
# below, so repairing it means intercepting the inexact negative-base path this
# release deliberately leaves alone. Also a negative base: unreachable.
#
# ⚠ THE ZERO-BASE BRANCH IS REDUNDANT AND KEPT ANYWAY. ganita 1.1.4 answers
# 0.0 / 1.0 / +inf for a zero base itself, bit-for-bit what this produces. It is
# retained as a pin: a silent upstream revert would otherwise move published
# optics values with nothing watching for it. `tests/hardening.tcyr` asserts
# the whole table above for the same reason.
var _PRK_INF   = 0x7FF0000000000000;
var _PRK_NINF  = 0xFFF0000000000000;
var _PRK_NZERO = 0x8000000000000000;
var _PRK_ABS   = 0x7FFFFFFFFFFFFFFF;   # clears the sign bit
var _PRK_TWO53 = 0x4340000000000000;   # 2^53

# 1 if `v` is an odd integer, else 0. `v` is finite and non-zero at every call
# site below (NaN and the infinities have already returned). This is the parity
# test C's pow uses to decide whether a negative base or a negative zero keeps
# its sign. |v| >= 2^53 is even by construction: consecutive doubles are 2 apart
# at that magnitude, so no odd integer is representable there.
#must_use
fn _prk_is_odd_int(v) {
    var a = f64_abs(v);
    if (f64_ge(a, _PRK_TWO53) == 1) { return 0; }
    if (f64_floor(a) == a) {
        if (f64_to(a) & 1 == 1) { return 1; }
    }
    return 0;
}

#must_use
fn _prk_pow(base, exp) {
    # pow(x, ±0) = 1 for every x, NaN included. Must stay first.
    if ((exp & _PRK_ABS) == 0) { return F64_ONE; }
    # pow(1, y) = 1 for every y, NaN and the infinities included. Must precede
    # the NaN propagation below, which would otherwise claim pow(1, NaN).
    if (base == F64_ONE) { return F64_ONE; }
    # NaN in, that same NaN out — Rust propagates the operand's sign and
    # payload rather than canonicalising (measured: pow(2, -NaN) = 0xFFF8…,
    # pow(2, NaN:payload 7) = 0x7FF8000000000007).
    if ((base & _PRK_ABS) > _PRK_INF) { return base; }
    if ((exp & _PRK_ABS) > _PRK_INF) { return exp; }

    # Infinite exponent — the result depends only on |base| against 1.
    if ((exp & _PRK_ABS) == _PRK_INF) {
        var mag = f64_abs(base);
        if (mag == F64_ONE) { return F64_ONE; }        # base == -1
        if (f64_lt(mag, F64_ONE) == 1) {
            if (exp == _PRK_INF) { return 0; }
            return _PRK_INF;
        }
        if (exp == _PRK_INF) { return _PRK_INF; }
        return 0;
    }

    # Infinite base — pow(-inf, y) == pow(-0, -y); the sign survives only
    # through an odd integer exponent.
    if ((base & _PRK_ABS) == _PRK_INF) {
        var inf_neg = 0;
        if (base == _PRK_NINF) {
            if (_prk_is_odd_int(exp) == 1) { inf_neg = 1; }
        }
        if (f64_lt(exp, 0) == 1) {
            if (inf_neg == 1) { return _PRK_NZERO; }
            return 0;
        }
        if (inf_neg == 1) { return _PRK_NINF; }
        return _PRK_INF;
    }

    # Zero base — same parity rule. `f64_mul(f64_from(-1), f64_from(0))` yields
    # 0x8000000000000000, and so does `f64_neg(f64_from(0))` from cyrius 6.6.8, so
    # a negative zero IS reachable through the f64 surface and the sign is carried.
    if ((base & _PRK_ABS) == 0) {
        var zero_neg = 0;
        if (base == _PRK_NZERO) {
            if (_prk_is_odd_int(exp) == 1) { zero_neg = 1; }
        }
        if (f64_lt(exp, 0) == 1) {
            if (zero_neg == 1) { return _PRK_NINF; }
            return _PRK_INF;
        }
        if (zero_neg == 1) { return _PRK_NZERO; }
        return 0;
    }

    return ganita_f64_pow(base, exp);
}

# ── Logging (sakshi) ────────
# Ports the Rust `tracing::trace!` diagnostics. Consumers set the level with
# prakash_set_log_level(SK_TRACE) to see operation-entry traces; the default
# (SK_INFO) leaves them off.
#
# ⚠ THIS BLOCK USED TO CLAIM THE DISABLED PATH WAS "NEAR-FREE" AND IT WAS NOT.
# Two things it got wrong, both measured in 2.3.4:
#   1. `sakshi_trace` is NOT compile-elided here. Its body is `#if SAKSHI_LEVEL
#      >= 5`, and sakshi's own `#ifndef SAKSHI_LEVEL` defaults it to **5** —
#      prakash never defines it, so the branch is live in every build.
#   2. Even if it were elided, `strlen(name)` is an ARGUMENT, so it is evaluated
#      before the call either way. Every traced operation entry walked its label
#      to compute a length that `_sk_log` then discarded, because the runtime
#      level (SK_INFO) already suppressed the message.
# Measured cost per entry with tracing OFF: **28 ns** for a 13-char label and
# **37 ns** for a 34-char one — i.e. it scaled with the label. Reading the level
# first makes it **7 ns and flat**: −74% and −81%. Across the 32 `_prk_trace`
# sites this is the whole of what the disabled path costs.

# Set the global log level (SK_OFF/ERROR/WARN/INFO/DEBUG/TRACE from sakshi).
fn prakash_set_log_level(level) {
    return sakshi_set_level(level);
}

# Emit a TRACE-level operation marker (the Rust trace!("op") equivalent).
#
# The level test comes FIRST and is the point: `strlen` must not run when the
# message is going to be dropped. `_sk_log` suppresses when `SK_TRACE >
# _sk_log_level`, so `sakshi_get_level() < SK_TRACE` is the same predicate,
# evaluated before the label is touched. Tracing enabled behaves exactly as
# before — same label, same length, same sakshi call.
fn _prk_trace(name) {
    if (sakshi_get_level() < SK_TRACE) { return 0; }
    sakshi_trace(name, strlen(name));
    return 0;
}

# --- ray_core.cyr ---

# ray_core.cyr -- geometric (ray) optics core
# Usage: include "lib/ray_core.cyr"  (requires error.cyr for PK_ERR_*)
#
# Reflection, refraction, Snell's law, and the common-material refractive-index
# database. Ported from the Rust `ray/mod.rs`. All angles are in radians unless a
# name says otherwise.
#
# f64 note: values are IEEE-754 bit patterns. Non-integer literals are written as
# ratios `f64_div(f64_from(num), f64_from(den))` because `f64_from` takes an
# integer (a decimal literal would decode to NaN). Transcendentals come from the
# stdlib f64 builtins (`f64_sin`, `f64_sqrt`) and ganita (`ganita_f64_asin`).
#
# Errors: functions that can fail take an `err_out` pointer and write `PK_ERR_NONE`
# or a negative `PK_ERR_*` code there, returning 0 on failure.
#
# `snell_3d` lives with the Fresnel module (ray_fresnel.cyr) since it needs the
# Fresnel s/p reflectances.

# 3D / 2D f64 vectors for direction and normal args. Layout matches hisab HVec3
# ── hisab interop contract (2.1.2) ────────
# RayVec3 is `{ x; y; z; }` — byte-identical to hisab's HVec3 (x@0, y@8, z@16).
# This is a GUARANTEE, not a coincidence: a RayVec3 pointer IS an HVec3 pointer,
# so all 26 of hisab's `hvec3_*` operations (dot, cross, normalize, reflect,
# project, angle, …) work on prakash vectors with zero conversion, and hisab
# results read back through the RayVec3 accessors. `tests/hisab_interop.tcyr`
# pins the layout, the field order, and that `ray_reflect_3d` agrees with
# `hvec3_reflect`; changing either struct breaks that suite rather than silently
# corrupting a consumer.
#
# prakash deliberately does NOT call hvec3_* internally. Measured: routing the
# tracer's dot products through `hvec3_dot` costs 2-11% on ray/trace_surface,
# ray/trace_sequential and ray/fresnel_unpolarized, because it is two nested
# calls (hvec3_dot -> f64v_dot) where the inline form is straight-line
# arithmetic. The contract exists for consumers; the hot paths stay inline.
#derive(accessors)
struct RayVec3 { x; y; z; }

#derive(accessors)
struct RayVec2 { x; y; }

# Heap RayVec3 {x, y, z}; 0 on allocation failure.
#must_use
fn ray_vec3(x, y, z) {
    var v = alloc(sizeof(RayVec3));
    if (v == 0) { return 0; }
    RayVec3_set_x(v, x);
    RayVec3_set_y(v, y);
    RayVec3_set_z(v, z);
    return v;
}

# Heap RayVec2 {x, y}; 0 on allocation failure.
#must_use
fn ray_vec2(x, y) {
    var v = alloc(sizeof(RayVec2));
    if (v == 0) { return 0; }
    RayVec2_set_x(v, x);
    RayVec2_set_y(v, y);
    return v;
}

# ── Refractive indices for common materials (at ~589 nm, sodium D line) ──────

# Medium: { n: refractive index (>= 1.0), name: cstr }.
#derive(accessors)
struct Medium { n; name; }

# Internal unchecked constructor.
fn _medium_mk(n, name) {
    var m = alloc(sizeof(Medium));
    if (m == 0) { return 0; }
    Medium_set_n(m, n);
    Medium_set_name(m, name);
    return m;
}

# Vacuum: n = 1 exactly.
#must_use
fn medium_vacuum() { return _medium_mk(F64_ONE, "vacuum"); }
# Air (STP): n = 1.000293.
#must_use
fn medium_air() { return _medium_mk(f64_div(f64_from(1000293), f64_from(1000000)), "air"); }
# Water: n = 1.333.
#must_use
fn medium_water() { return _medium_mk(f64_div(f64_from(1333), f64_from(1000)), "water"); }
# Generic glass: n = 1.52.
#must_use
fn medium_glass() { return _medium_mk(f64_div(f64_from(152), f64_from(100)), "glass"); }
# Crown glass: n = 1.523.
#must_use
fn medium_crown_glass() { return _medium_mk(f64_div(f64_from(1523), f64_from(1000)), "crown glass"); }
# Flint glass: n = 1.62.
#must_use
fn medium_flint_glass() { return _medium_mk(f64_div(f64_from(162), f64_from(100)), "flint glass"); }
# Diamond: n = 2.417.
#must_use
fn medium_diamond() { return _medium_mk(f64_div(f64_from(2417), f64_from(1000)), "diamond"); }
# Ice: n = 1.31.
#must_use
fn medium_ice() { return _medium_mk(f64_div(f64_from(131), f64_from(100)), "ice"); }
# Crystalline quartz (ordinary ray): n = 1.544.
#must_use
fn medium_quartz() { return _medium_mk(f64_div(f64_from(1544), f64_from(1000)), "quartz"); }
# Sapphire (ordinary ray): n = 1.77.
#must_use
fn medium_sapphire() { return _medium_mk(f64_div(f64_from(177), f64_from(100)), "sapphire"); }
# Acrylic (PMMA): n = 1.49.
#must_use
fn medium_acrylic() { return _medium_mk(f64_div(f64_from(149), f64_from(100)), "acrylic"); }
# Polycarbonate: n = 1.585.
#must_use
fn medium_polycarbonate() { return _medium_mk(f64_div(f64_from(1585), f64_from(1000)), "polycarbonate"); }

# Custom medium with a given refractive index. Writes PK_ERR_INVALID_INDEX and
# returns 0 unless 1 <= n < infinity (2.15.1: NaN and infinity were accepted), and
# PK_ERR_INVALID_PARAMETER for a null name (2.15.1: accepted, and medium_to_json then read it).
#must_use
fn medium_custom(n, name, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (name == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if ((f64_ge(n, F64_ONE) == 0) | (n == 0x7FF0000000000000)) {
        store64(err_out, PK_ERR_INVALID_INDEX);
        return 0;
    }
    # 2.4.9: a failed allocation used to return 0 with err_out still PK_ERR_NONE,
    # so a caller that checked prakash_is_ok() then dereferenced null. A null
    # handle must be distinguishable from a success (CLAUDE.md).
    var m = _medium_mk(n, name);
    if (m == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return m;
}

# Relative dielectric permittivity (eps_r = n^2). Bridges to bijli's EM
# permittivity; for non-magnetic materials n = sqrt(eps_r).
# NaN for a null medium (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn medium_permittivity(m) {
    if (m == 0) { return _PRK_NAN; }
    var n = Medium_n(m);
    return f64_mul(n, n);
}

# ── Snell's Law ────────

# 1 if n is a refractive index these functions can use: finite and > 0.
#must_use
fn _ray_index_ok(n) {
    if (f64_gt(n, f64_from(0)) == 0) { return 0; }
    return f64_lt(n, 0x7FF0000000000000);
}

# sin(theta_t) as Snell gives it, with the critical angle's rounding taken back: a |sin| that
# is above 1 by at most 4 ulps is 1 (grazing). ray_critical_angle's own angle, fed back, gave
# n1 sin(theta_c)/n2 = 1 + 1 ulp for about one n1 in three, and TIR was reported at the very
# angle that defines its onset (2.15.1).
#must_use
fn _ray_snell_sin(sin_t) {
    if (f64_gt(f64_abs(sin_t), F64_ONE) == 0) { return sin_t; }
    if (f64_gt(f64_abs(sin_t), 0x3FF0000000000004) == 1) { return sin_t; }
    if (f64_lt(sin_t, f64_from(0)) == 1) { return f64_neg(F64_ONE); }
    return F64_ONE;
}

# Apply Snell's law: n1 sin(t1) = n2 sin(t2). Returns the refracted angle in
# radians, or writes PK_ERR_TIR (and returns 0) on total internal reflection, or
# PK_ERR_INVALID_INDEX (returns 0) unless both indices are finite and > 0 (2.15.1).
#must_use
fn ray_snell(n1, n2, incident_angle, err_out) {
    _prk_trace("snell");
    store64(err_out, PK_ERR_NONE);
    if ((_ray_index_ok(n1) & _ray_index_ok(n2)) == 0) {
        store64(err_out, PK_ERR_INVALID_INDEX);
        return 0;
    }
    var sin_t = _ray_snell_sin(f64_mul(f64_div(n1, n2), _prk_sin(incident_angle)));
    if (f64_gt(f64_abs(sin_t), F64_ONE) == 1) {
        store64(err_out, PK_ERR_TIR);
        return 0;
    }
    return ganita_f64_asin(sin_t);
}

# Critical angle for total internal reflection (requires n1 > n2). Writes
# PK_ERR_INVALID_PARAMETER (returns 0) if n1 <= n2, or PK_ERR_INVALID_INDEX unless both are
# finite and > 0 (2.15.1: n2 = 0 answered 0 and n2 = -1 a negative angle).
#must_use
fn ray_critical_angle(n1, n2, err_out) {
    store64(err_out, PK_ERR_NONE);
    if ((_ray_index_ok(n1) & _ray_index_ok(n2)) == 0) {
        store64(err_out, PK_ERR_INVALID_INDEX);
        return 0;
    }
    if (f64_le(n1, n2) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return ganita_f64_asin(f64_div(n2, n1));
}

# ── Reflection ────────

# Angle of reflection equals angle of incidence.
#must_use
fn ray_reflect_angle(incident_angle) {
    return incident_angle;
}

# Reflect a 2D direction vector about a surface normal (both normalized).
#must_use
fn ray_reflect_2d(direction, normal) {
    if (direction == 0) { return 0; }
    if (normal == 0) { return 0; }
    var dx = RayVec2_x(direction);
    var dy = RayVec2_y(direction);
    var nx = RayVec2_x(normal);
    var ny = RayVec2_y(normal);
    var dot = f64_add(f64_mul(dx, nx), f64_mul(dy, ny));
    var two_dot = f64_mul(F64_TWO, dot);
    return ray_vec2(
      f64_sub(dx, f64_mul(two_dot, nx)),
      f64_sub(dy, f64_mul(two_dot, ny)));
}

# Reflect a 3D direction vector about a surface normal (both normalized).
#must_use
fn ray_reflect_3d(direction, normal) {
    if (direction == 0) { return 0; }
    if (normal == 0) { return 0; }
    var dx = RayVec3_x(direction);
    var dy = RayVec3_y(direction);
    var dz = RayVec3_z(direction);
    var nx = RayVec3_x(normal);
    var ny = RayVec3_y(normal);
    var nz = RayVec3_z(normal);
    var dot = f64_add(f64_add(f64_mul(dx, nx), f64_mul(dy, ny)), f64_mul(dz, nz));
    var two_dot = f64_mul(F64_TWO, dot);
    return ray_vec3(
      f64_sub(dx, f64_mul(two_dot, nx)),
      f64_sub(dy, f64_mul(two_dot, ny)),
      f64_sub(dz, f64_mul(two_dot, nz)));
}

# Refract a 3D direction through a surface (vector form of Snell's law):
#   t = ratio*d + (ratio*cos_i - cos_t)*n
# with ratio = n1/n2, cos_i = -(d.n), cos_t = sqrt(1 - ratio^2 (1 - cos_i^2)).
# Returns the refracted RayVec3, or writes PK_ERR_TIR (returns 0) if the
# discriminant is negative. `direction` and outward `normal` should be normalized, with the
# normal facing the incoming ray: d.n > 0 is the back of the surface, and writes
# PK_ERR_INVALID_ANGLE (2.15.1: the formula ran on and sent the ray back the way it came).
#must_use
fn ray_refract_3d(direction, normal, n1, n2, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (direction == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (normal == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var dx = RayVec3_x(direction);
    var dy = RayVec3_y(direction);
    var dz = RayVec3_z(direction);
    var nx = RayVec3_x(normal);
    var ny = RayVec3_y(normal);
    var nz = RayVec3_z(normal);
    var ratio = f64_div(n1, n2);
    var dot = f64_add(f64_add(f64_mul(dx, nx), f64_mul(dy, ny)), f64_mul(dz, nz));
    var cos_i = f64_neg(dot);
    if (f64_lt(cos_i, f64_from(0)) == 1) {
        store64(err_out, PK_ERR_INVALID_ANGLE);
        return 0;
    }
    var sin2_t = f64_mul(f64_mul(ratio, ratio), f64_sub(F64_ONE, f64_mul(cos_i, cos_i)));
    if (f64_gt(sin2_t, F64_ONE) == 1) {
        store64(err_out, PK_ERR_TIR);
        return 0;
    }
    var cos_t = f64_sqrt(f64_sub(F64_ONE, sin2_t));
    var factor = f64_sub(f64_mul(ratio, cos_i), cos_t);
    # 2.4.9: a failed allocation used to return 0 with err_out still PK_ERR_NONE,
    # so a caller that checked prakash_is_ok() then dereferenced null. A null
    # handle must be distinguishable from a success (CLAUDE.md).
    var v = ray_vec3(
      f64_add(f64_mul(ratio, dx), f64_mul(factor, nx)),
      f64_add(f64_mul(ratio, dy), f64_mul(factor, ny)),
      f64_add(f64_mul(ratio, dz), f64_mul(factor, nz)));
    if (v == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return v;
}

# ── Utility ────────

# Convert degrees to radians.
#must_use
fn ray_deg_to_rad(deg) {
    return f64_mul(deg, f64_div(F64_PI, f64_from(180)));
}

# Convert radians to degrees.
#must_use
fn ray_rad_to_deg(rad) {
    return f64_mul(rad, f64_div(f64_from(180), F64_PI));
}

# --- ray_fresnel.cyr ---

# ray_fresnel.cyr -- Fresnel equations (real + complex), Brewster, Beer-Lambert
# Usage: include "lib/ray_fresnel.cyr"  (requires error.cyr, ray_core.cyr)
#
# Ported from the Rust `ray/fresnel.rs`, plus `snell_3d` (which needs the s/p
# reflectances). All angles in radians. f64 values are bit patterns; see
# ray_core.cyr for the f64 conventions.

# Denominator-underflow guards (Rust used 1e-15 / 1e-30 literals).
# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _fr_eps15() { return 0x3CD203AF9EE75616; }
fn _fr_eps30() {
    var e = f64_div(F64_ONE, f64_from(1000000000000000));
    return f64_mul(e, e);
}

# ── Fresnel equations (real refractive index) ────────

# Fresnel reflectance for s-polarized light (TE mode).
#must_use
fn fresnel_s(n1, n2, cos_i, cos_t) {
    var num = f64_sub(f64_mul(n1, cos_i), f64_mul(n2, cos_t));
    var den = f64_add(f64_mul(n1, cos_i), f64_mul(n2, cos_t));
    if (f64_lt(f64_abs(den), _fr_eps15()) == 1) {
        return F64_ONE;
    }
    var r = f64_div(num, den);
    return f64_mul(r, r);
}

# Fresnel reflectance for p-polarized light (TM mode).
#must_use
fn fresnel_p(n1, n2, cos_i, cos_t) {
    var num = f64_sub(f64_mul(n2, cos_i), f64_mul(n1, cos_t));
    var den = f64_add(f64_mul(n2, cos_i), f64_mul(n1, cos_t));
    if (f64_lt(f64_abs(den), _fr_eps15()) == 1) {
        return F64_ONE;
    }
    var r = f64_div(num, den);
    return f64_mul(r, r);
}

# Fresnel reflectance at normal incidence: R = ((n1-n2)/(n1+n2))^2.
#must_use
fn fresnel_normal(n1, n2) {
    var r = f64_div(f64_sub(n1, n2), f64_add(n1, n2));
    return f64_mul(r, r);
}

# Average (unpolarized) Fresnel reflectance. Writes PK_ERR_TIR (returns 0) if
# the incident angle exceeds the critical angle, PK_ERR_INVALID_ANGLE past 90 degrees (cos < 0,
# the back of the surface), PK_ERR_INVALID_INDEX unless both indices are finite and > 0. At the
# critical angle itself, as ray_critical_angle rounds it, R = 1 (grazing), not TIR. (2.15.1: all
# three were computed through, R = NaN at n2 = 0.)
#must_use
fn fresnel_unpolarized(n1, n2, incident_angle, err_out) {
    store64(err_out, PK_ERR_NONE);
    if ((_ray_index_ok(n1) & _ray_index_ok(n2)) == 0) {
        store64(err_out, PK_ERR_INVALID_INDEX);
        return 0;
    }
    var sin_i = _prk_sin(incident_angle);
    var cos_i = _prk_cos(incident_angle);
    if (f64_lt(cos_i, f64_from(0)) == 1) {
        store64(err_out, PK_ERR_INVALID_ANGLE);
        return 0;
    }
    var sin_t = _ray_snell_sin(f64_mul(f64_div(n1, n2), sin_i));
    if (f64_gt(f64_abs(sin_t), F64_ONE) == 1) {
        store64(err_out, PK_ERR_TIR);
        return 0;
    }
    var cos_t = f64_sqrt(f64_sub(F64_ONE, f64_mul(sin_t, sin_t)));
    var rs = fresnel_s(n1, n2, cos_i, cos_t);
    var rp = fresnel_p(n1, n2, cos_i, cos_t);
    return f64_mul(F64_HALF, f64_add(rs, rp));
}

# ── Brewster's angle ────────

# Brewster's angle: atan(n2/n1) — reflected light is fully s-polarized.
#must_use
fn brewster_angle(n1, n2) {
    return ganita_f64_atan2(f64_div(n2, n1), F64_ONE);
}

# ── Complex Fresnel (absorbing media) ────────

# Complex refractive index medium: n~ = n + i*k. { n, k, name }.
#derive(accessors)
struct ComplexMedium { n; k; name; }

fn _cm_mk(n, k, name) {
    var m = alloc(sizeof(ComplexMedium));
    if (m == 0) { return 0; }
    ComplexMedium_set_n(m, n);
    ComplexMedium_set_k(m, k);
    ComplexMedium_set_name(m, name);
    return m;
}

# Gold at 550 nm: n = 0.43, k = 2.46.
#must_use
fn complex_gold_550nm() {
    return _cm_mk(f64_div(f64_from(43), f64_from(100)), f64_div(f64_from(246), f64_from(100)), "gold (550nm)");
}
# Silver at 550 nm: n = 0.059, k = 3.33.
#must_use
fn complex_silver_550nm() {
    return _cm_mk(f64_div(f64_from(59), f64_from(1000)), f64_div(f64_from(333), f64_from(100)), "silver (550nm)");
}
# Copper at 550 nm: n = 1.13, k = 2.60.
#must_use
fn complex_copper_550nm() {
    return _cm_mk(f64_div(f64_from(113), f64_from(100)), f64_div(f64_from(260), f64_from(100)), "copper (550nm)");
}
# Aluminum at 550 nm: n = 0.96, k = 6.69.
#must_use
fn complex_aluminum_550nm() {
    return _cm_mk(f64_div(f64_from(96), f64_from(100)), f64_div(f64_from(669), f64_from(100)), "aluminum (550nm)");
}

# Dielectric (non-absorbing) complex medium (k = 0).
#must_use
fn complex_dielectric(n, name) {
    return _cm_mk(n, f64_from(0), name);
}

# Fresnel reflectance at normal incidence for an absorbing medium:
# R = ((n1-n2)^2 + k2^2) / ((n1+n2)^2 + k2^2).
# NaN for a null medium (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn fresnel_normal_complex(n1, medium) {
    if (medium == 0) { return _PRK_NAN; }
    var mn = ComplexMedium_n(medium);
    var mk = ComplexMedium_k(medium);
    var dn = f64_sub(n1, mn);
    var dp = f64_add(n1, mn);
    var k2 = f64_mul(mk, mk);
    return f64_div(f64_add(f64_mul(dn, dn), k2), f64_add(f64_mul(dp, dp), k2));
}

# Complex cos(theta_t) = principal sqrt(u + i*v) where
#   cos^2(theta_t) = 1 - (n1/n~)^2 sin^2(theta_i).
# Writes the real/imag parts through cos_re_out/cos_im_out.
fn _fr_complex_cos_t(n1, mn, mk, incident_angle, cos_re_out, cos_im_out) {
    var sin_i = _prk_sin(incident_angle);
    var sin2_i = f64_mul(sin_i, sin_i);
    var n2_sq = f64_sub(f64_mul(mn, mn), f64_mul(mk, mk));
    var n2_im = f64_mul(f64_mul(F64_TWO, mn), mk);
    var denom = f64_add(f64_mul(n2_sq, n2_sq), f64_mul(n2_im, n2_im));
    var n1_sin2 = f64_mul(f64_mul(n1, n1), sin2_i);
    var u = f64_sub(F64_ONE, f64_div(f64_mul(n1_sin2, n2_sq), denom));
    var v = f64_div(f64_mul(n1_sin2, n2_im), denom);
    var mag = f64_sqrt(f64_add(f64_mul(u, u), f64_mul(v, v)));
    var cos_re = f64_sqrt(f64_div(f64_add(mag, u), F64_TWO));
    var cos_im = f64_sqrt(f64_div(f64_sub(mag, u), F64_TWO));
    if (f64_lt(v, f64_from(0)) == 1) {
        cos_im = f64_neg(cos_im);
    }
    store64(cos_re_out, cos_re);
    store64(cos_im_out, cos_im);
    return 0;
}

# Fresnel reflectance for s-polarized light on an absorbing medium. R_s = |r_s|^2.
# NaN for a null medium (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn fresnel_s_complex(n1, medium, incident_angle) {
    if (medium == 0) { return _PRK_NAN; }
    var mn = ComplexMedium_n(medium);
    var mk = ComplexMedium_k(medium);
    var cos_i = _prk_cos(incident_angle);
    var cos_t_re = 0;
    var cos_t_im = 0;
    _fr_complex_cos_t(n1, mn, mk, incident_angle, &cos_t_re, &cos_t_im);
    var nt_re = f64_sub(f64_mul(mn, cos_t_re), f64_mul(mk, cos_t_im));
    var nt_im = f64_add(f64_mul(mn, cos_t_im), f64_mul(mk, cos_t_re));
    var num_re = f64_sub(f64_mul(n1, cos_i), nt_re);
    var num_im = f64_neg(nt_im);
    var den_re = f64_add(f64_mul(n1, cos_i), nt_re);
    var den_im = nt_im;
    var num_mag = f64_add(f64_mul(num_re, num_re), f64_mul(num_im, num_im));
    var den_mag = f64_add(f64_add(f64_mul(den_re, den_re), f64_mul(den_im, den_im)), _fr_eps30());
    return f64_div(num_mag, den_mag);
}

# Fresnel reflectance for p-polarized light on an absorbing medium. R_p = |r_p|^2.
# NaN for a null medium (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn fresnel_p_complex(n1, medium, incident_angle) {
    if (medium == 0) { return _PRK_NAN; }
    var mn = ComplexMedium_n(medium);
    var mk = ComplexMedium_k(medium);
    var cos_i = _prk_cos(incident_angle);
    var cos_t_re = 0;
    var cos_t_im = 0;
    _fr_complex_cos_t(n1, mn, mk, incident_angle, &cos_t_re, &cos_t_im);
    var nci_re = f64_mul(mn, cos_i);
    var nci_im = f64_mul(mk, cos_i);
    var num_re = f64_sub(nci_re, f64_mul(n1, cos_t_re));
    var num_im = f64_sub(nci_im, f64_mul(n1, cos_t_im));
    var den_re = f64_add(nci_re, f64_mul(n1, cos_t_re));
    var den_im = f64_add(nci_im, f64_mul(n1, cos_t_im));
    var num_mag = f64_add(f64_mul(num_re, num_re), f64_mul(num_im, num_im));
    var den_mag = f64_add(f64_add(f64_mul(den_re, den_re), f64_mul(den_im, den_im)), _fr_eps30());
    return f64_div(num_mag, den_mag);
}

# Average (unpolarized) Fresnel reflectance on an absorbing medium.
# NaN for a null medium (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn fresnel_unpolarized_complex(n1, medium, incident_angle) {
    if (medium == 0) { return _PRK_NAN; }
    var rs = fresnel_s_complex(n1, medium, incident_angle);
    var rp = fresnel_p_complex(n1, medium, incident_angle);
    return f64_mul(F64_HALF, f64_add(rs, rp));
}

# ── Complex Fresnel amplitudes ────────

# The complex amplitude coefficients of one plane interface. T_s = flux_s*|t_s|^2 and
# T_p = flux_p*|t_p|^2 are the powers crossing it, so R + T = 1 at every angle, into an
# absorber too. flux_s = flux_p = 0 at total internal reflection.
#derive(accessors)
struct FresnelAmplitudes { rs_re; rs_im; rp_re; rp_im; ts_re; ts_im; tp_re; tp_im; flux_s; flux_p; }

# An index n + ik is admissible: finite, >= 0 and <= 2^100, with max(n, k) >= 2^-100, the
# rule multilayer_rta keeps (see _diff_medium_ok). With the floor on n1 cos_i below, the
# flux factors in fresnel_amplitudes stay finite. A |t|^2 can still round to 0 at the far
# end of both ranges, where the power it stands for is 0 to double precision too.
fn _fr_medium_ok(n, k) {
    if (((n & _PRK_ABS) >= _PRK_INF) | ((k & _PRK_ABS) >= _PRK_INF)) { return 0; }
    if ((f64_ge(n, 0) & f64_ge(k, 0)) == 0) { return 0; }
    if ((f64_le(n, 0x4630000000000000) & f64_le(k, 0x4630000000000000)) == 0) { return 0; }
    if ((f64_ge(n, 0x39B0000000000000) | f64_ge(k, 0x39B0000000000000)) == 0) { return 0; }
    return 1;
}

# a/b for complex a, b, by Smith's algorithm: it forms no |b|^2, which an interface hit
# at a grazing angle between near-equal media would underflow to a division by zero.
fn _fr_cdiv(ar, ai, br, bi, re_out, im_out) {
    if (f64_ge(f64_abs(br), f64_abs(bi)) == 1) {
        var t = f64_div(bi, br);
        var d = f64_add(br, f64_mul(bi, t));
        store64(re_out, f64_div(f64_add(ar, f64_mul(ai, t)), d));
        store64(im_out, f64_div(f64_sub(ai, f64_mul(ar, t)), d));
        return 0;
    }
    var u = f64_div(br, bi);
    var e = f64_add(f64_mul(br, u), bi);
    store64(re_out, f64_div(f64_add(f64_mul(ar, u), ai), e));
    store64(im_out, f64_div(f64_sub(f64_mul(ai, u), ar), e));
    return 0;
}

# The Fresnel amplitude coefficients of the interface from real n1 into n2 + i k2, for a
# ray meeting it at cos_i in (0, 1], written to a FresnelAmplitudes the caller owns.
# Returns PK_ERR_NONE, PK_ERR_INVALID_PARAMETER (null out, or an index the rule above
# refuses, which includes gain) or PK_ERR_INVALID_ANGLE (cos_i outside (0, 1], or n1 cos_i
# under 2^-500: a ray in the plane of the surface meets nothing, and that close to it the
# flux factor and |t|^2 leave the double range, so R + T = 1 could not hold). out is untouched
# on a refusal.
#
# CONVENTIONS. Time dependence e^(-i w t), so n + ik with k >= 0 decays, as in
# multilayer_rta. With q = n~ cos(theta_t) = sqrt(n~^2 - (n1 sin(theta_i))^2), Im q >= 0:
#   r_s = (n1 c - q)/(n1 c + q)                  t_s = 2 n1 c/(n1 c + q)
#   r_p = (n~^2 c - n1 q)/(n~^2 c + n1 q)        t_p = 2 n1 n~ c/(n~^2 c + n1 q)
# This is Chipman's sign: E_r = r_s s + r_p p', p' = k' x s, so r_p = -r_s at normal
# incidence, and a perfect conductor has r_s = -1, r_p = +1. Above the critical angle q is
# purely imaginary and |r_s| = |r_p| = 1, with the phases of total internal reflection.
# Everything is checked against Maxwell's boundary conditions solved as a 6x6 system
# (tests/ray_fresnel.tcyr), not against these formulas.
#
# r_s and r_p are evaluated without their numerators' cancellation, which is the whole
# reflectance of a weak interface: (n1 c)^2 - q^2 = n1^2 - n~^2, so
#   r_s = (n1^2 - n~^2)/(n1 c + q)^2
#   r_p = (n~^2 - n1^2)(n~ c - n1 s)(n~ c + n1 s)/(n~^2 c + n1 q)^2
# and q^2 = (n~^2 - n1^2) + (n1 c)^2 never forms sin: below c ~ 1e-8 it rounds to 1, and
# between equal media q would come out 0 and t_s = 2, where the ray does not notice.
#must_use
fn fresnel_amplitudes(n1, n2, k2, cos_i, out) {
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((_fr_medium_ok(n1, 0) & _fr_medium_ok(n2, k2)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((f64_gt(cos_i, 0) & f64_le(cos_i, F64_ONE)) == 0) { return PK_ERR_INVALID_ANGLE; }
    var c = cos_i;
    var ns = f64_mul(n1, f64_sqrt(f64_mul(f64_sub(F64_ONE, c), f64_add(F64_ONE, c))));
    # n~^2, and q = a + ib = the root of n~^2 - ns^2 with b >= 0.
    var e2r = f64_mul(f64_sub(n2, k2), f64_add(n2, k2));
    var e2i = f64_mul(f64_mul(F64_TWO, n2), k2);
    var ac = f64_mul(n1, c);
    if (f64_ge(ac, 0x20B0000000000000) == 0) { return PK_ERR_INVALID_ANGLE; }     # 2^-500
    var wr = f64_add(f64_sub(f64_mul(f64_sub(n2, n1), f64_add(n2, n1)), f64_mul(k2, k2)), f64_mul(ac, ac));
    var mag = ganita_f64_hypot(wr, e2i);
    var a = 0;
    var b = 0;
    if (f64_ge(wr, 0) == 1) {
        a = f64_sqrt(f64_mul(F64_HALF, f64_add(mag, wr)));
        if (f64_gt(a, 0) == 1) { b = f64_div(e2i, f64_mul(F64_TWO, a)); }
    } else {
        b = f64_sqrt(f64_mul(F64_HALF, f64_sub(mag, wr)));
        a = f64_div(e2i, f64_mul(F64_TWO, b));
    }
    var dsr = f64_add(ac, a);
    # n~^2 c + n1 q, and n1^2 - n~^2.
    var dpr = f64_add(f64_mul(e2r, c), f64_mul(n1, a));
    var dpi = f64_add(f64_mul(e2i, c), f64_mul(n1, b));
    var dr = f64_add(f64_mul(f64_sub(n1, n2), f64_add(n1, n2)), f64_mul(k2, k2));
    var di = f64_neg(e2i);
    var rr = 0;
    var ri = 0;
    var _c = _fr_cdiv(dr, di, dsr, b, &rr, &ri);
    var rsr = 0;
    var rsi = 0;
    _c = _fr_cdiv(rr, ri, dsr, b, &rsr, &rsi);
    # (n~ c - ns)(n~ c + ns), times n~^2 - n1^2 = -(dr + i di).
    var ncr = f64_mul(n2, c);
    var nci = f64_mul(k2, c);
    var yr = f64_sub(f64_mul(f64_sub(ncr, ns), f64_add(ncr, ns)), f64_mul(nci, nci));
    var yi = f64_mul(f64_mul(F64_TWO, ncr), nci);
    var nr = f64_neg(f64_sub(f64_mul(dr, yr), f64_mul(di, yi)));
    var ni = f64_neg(f64_add(f64_mul(dr, yi), f64_mul(di, yr)));
    _c = _fr_cdiv(nr, ni, dpr, dpi, &rr, &ri);
    var rpr = 0;
    var rpi = 0;
    _c = _fr_cdiv(rr, ri, dpr, dpi, &rpr, &rpi);
    var tsr = 0;
    var tsi = 0;
    _c = _fr_cdiv(f64_mul(F64_TWO, ac), 0, dsr, b, &tsr, &tsi);
    var tpr = 0;
    var tpi = 0;
    var tw = f64_mul(F64_TWO, ac);
    _c = _fr_cdiv(f64_mul(tw, n2), f64_mul(tw, k2), dpr, dpi, &tpr, &tpi);
    FresnelAmplitudes_set_rs_re(out, rsr);
    FresnelAmplitudes_set_rs_im(out, rsi);
    FresnelAmplitudes_set_rp_re(out, rpr);
    FresnelAmplitudes_set_rp_im(out, rpi);
    FresnelAmplitudes_set_ts_re(out, tsr);
    FresnelAmplitudes_set_ts_im(out, tsi);
    FresnelAmplitudes_set_tp_re(out, tpr);
    FresnelAmplitudes_set_tp_im(out, tpi);
    # T_s = Re(q)/(n1 c) |t_s|^2, T_p = Re(q conj(n~)/n~)/(n1 c) |t_p|^2 (Byrnes 2016).
    FresnelAmplitudes_set_flux_s(out, f64_div(a, ac));
    var nn = f64_add(f64_mul(n2, n2), f64_mul(k2, k2));
    FresnelAmplitudes_set_flux_p(out,
      f64_div(f64_div(f64_add(f64_mul(e2r, a), f64_mul(e2i, b)), nn), ac));
    return PK_ERR_NONE;
}

# ── Attenuation ────────

# Beer-Lambert law: I = intensity * exp(-alpha * distance).
#must_use
fn beer_lambert(intensity, alpha, distance) {
    return f64_mul(intensity, _prk_exp(f64_neg(f64_mul(alpha, distance))));
}

# ── 3D Snell's law (refracted direction + Fresnel reflectance) ────────

# Compute the refracted direction and unpolarized Fresnel reflectance for a 3D
# ray. Returns the refracted RayVec3 (0 on TIR); writes the reflectance to
# refl_out and the error code to err_out. `direction` and outward `normal`
# should be normalized.
#must_use
# Snell refraction in 3D, answering through caller slots instead of allocating.
#
# Split out of ray_snell_3d in 2.3.6 so trace_surface can learn whether the ray
# totally-internally-reflects BEFORE it allocates — the TIR case needs 80 bytes
# where a refracting hit needs 128, and a single block cannot be sized until that
# is known. The normal arrives as three SCALARS rather than a RayVec3 pointer for
# the same reason: at the call site the normal's components are already in hand
# and boxing them only to read them back is the cost being removed.
#
# The arithmetic and its order are IDENTICAL to the wrapper below; only the
# delivery changes, so both produce bit-identical results.
fn _ray_snell_3d_out(direction, nx, ny, nz, n1, n2, rx_out, ry_out, rz_out, refl_out, err_out) {
    store64(err_out, PK_ERR_NONE);
    store64(refl_out, f64_from(0));
    var dx = RayVec3_x(direction);
    var dy = RayVec3_y(direction);
    var dz = RayVec3_z(direction);
    var dot = f64_add(f64_add(f64_mul(dx, nx), f64_mul(dy, ny)), f64_mul(dz, nz));
    var cos_i = f64_neg(dot);
    # The back of the surface (2.15.1: R = 25 came back as a reflectance). trace_surface turns
    # its normal to face the ray, so only a direct caller can land here.
    if (f64_lt(cos_i, f64_from(0)) == 1) {
        store64(err_out, PK_ERR_INVALID_ANGLE);
        return 0;
    }
    var ratio = f64_div(n1, n2);
    var sin2_t = f64_mul(f64_mul(ratio, ratio), f64_sub(F64_ONE, f64_mul(cos_i, cos_i)));
    if (f64_gt(sin2_t, F64_ONE) == 1) {
        store64(err_out, PK_ERR_TIR);
        return 0;
    }
    var cos_t = f64_sqrt(f64_sub(F64_ONE, sin2_t));
    var factor = f64_sub(f64_mul(ratio, cos_i), cos_t);
    store64(rx_out, f64_add(f64_mul(ratio, dx), f64_mul(factor, nx)));
    store64(ry_out, f64_add(f64_mul(ratio, dy), f64_mul(factor, ny)));
    store64(rz_out, f64_add(f64_mul(ratio, dz), f64_mul(factor, nz)));
    var rs = fresnel_s(n1, n2, cos_i, cos_t);
    var rp = fresnel_p(n1, n2, cos_i, cos_t);
    store64(refl_out, f64_mul(F64_HALF, f64_add(rs, rp)));
    return 0;
}

# Compute the refracted direction and unpolarized Fresnel reflectance for a 3D
# ray. Returns the refracted RayVec3 (0 on TIR); writes the reflectance to
# refl_out and the error code to err_out. `direction` and outward `normal`
# should be normalized, the normal facing the incoming ray; d.n > 0 writes PK_ERR_INVALID_ANGLE.
#
# A thin wrapper over _ray_snell_3d_out since 2.3.6 — it boxes the result the
# caller-slot form answers through. Callers on a hot path should use that form
# directly; this one preserves the public signature.
#must_use
fn ray_snell_3d(direction, normal, n1, n2, refl_out, err_out) {
    if (direction == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (normal == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var rx = f64_from(0);
    var ry = f64_from(0);
    var rz = f64_from(0);
    var _r = _ray_snell_3d_out(direction, RayVec3_x(normal), RayVec3_y(normal), RayVec3_z(normal),
      n1, n2, &rx, &ry, &rz, refl_out, err_out);
    if (prakash_is_err(load64(err_out)) == 1) { return 0; }
    # 2.4.9: a failed allocation used to return 0 with err_out still PK_ERR_NONE,
    # so a caller that checked prakash_is_ok() then dereferenced null. A null
    # handle must be distinguishable from a success (CLAUDE.md).
    var v = ray_vec3(rx, ry, rz);
    if (v == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return v;
}

# --- ray_trace.cyr ---

# ray_trace.cyr -- sequential ray tracing through optical surfaces
# Size of the single block trace_surface carves a hit out of:
# [TraceHit][hit_point RayVec3][normal RayVec3][after dir RayVec3][after TraceRay].
#must_use
fn _trace_hit_block() { return sizeof(TraceHit) + 3 * sizeof(RayVec3) + sizeof(TraceRay); }

# The TIR variant. A totally-internally-reflecting hit has no transmitted ray, so
# the after-direction and after-ray are never carved and the block is shorter.
#must_use
fn _trace_hit_block_tir() { return sizeof(TraceHit) + 2 * sizeof(RayVec3); }

# Usage: include "lib/ray_trace.cyr"  (requires error.cyr, ray_core.cyr, ray_fresnel.cyr)
#
# Ported from the Rust `ray/trace.rs`. The Rust `SurfaceShape` enum
# (Sphere{radius} | Plane) is flattened into OpticalSurface as a shape_tag +
# radius (radius unused for Plane). Vectors of hits use the stdlib `vec`.

# Surface shape tags (was the SurfaceShape enum).
var SURF_SPHERE = 0;
var SURF_PLANE = 1;

# Small geometry thresholds (Rust literals 1e-15 / 1e-10).
# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _trace_eps15() { return 0x3CD203AF9EE75616; }
# 1 if the hit at parameter `t` lies on the cap of the sphere that contains the
# surface vertex, else 0. The vertex sits at z = cz - radius, so the vertex cap
# is the side where (hit_z - cz) has the OPPOSITE sign to radius; the product
# being <= 0 is that test, and it admits the equator exactly. See the sphere
# branch of trace_surface for why taking the nearest root alone is wrong.
#must_use
fn _trace_on_vertex_cap(pz, dz, t, cz, radius) {
    var hz = f64_add(pz, f64_mul(t, dz));
    if (f64_gt(f64_mul(f64_sub(hz, cz), radius), f64_from(0)) == 1) { return 0; }
    return 1;
}

# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(10000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3DDB7CDFD9D7BDBB is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _trace_eps10() { return 0x3DDB7CDFD9D7BDBB; }

# An interface between two media. shape_tag is SURF_SPHERE/SURF_PLANE; radius is
# the radius of curvature (sphere only; +radius = center to the right).
#derive(accessors)
struct OpticalSurface { shape_tag; radius; z_position; n_after; aperture_radius; }

# Spherical surface: vertex at z_position, signed radius (+ = centre to the right),
# index n_after behind it; 0 on allocation failure.
#must_use
fn surface_sphere(radius, z_position, n_after, aperture_radius) {
    var s = alloc(sizeof(OpticalSurface));
    if (s == 0) { return 0; }
    OpticalSurface_set_shape_tag(s, SURF_SPHERE);
    OpticalSurface_set_radius(s, radius);
    OpticalSurface_set_z_position(s, z_position);
    OpticalSurface_set_n_after(s, n_after);
    OpticalSurface_set_aperture_radius(s, aperture_radius);
    return s;
}

# Plane surface at z_position (radius stored as 0), index n_after behind it;
# 0 on allocation failure.
#must_use
fn surface_plane(z_position, n_after, aperture_radius) {
    var s = alloc(sizeof(OpticalSurface));
    if (s == 0) { return 0; }
    OpticalSurface_set_shape_tag(s, SURF_PLANE);
    OpticalSurface_set_radius(s, f64_from(0));
    OpticalSurface_set_z_position(s, z_position);
    OpticalSurface_set_n_after(s, n_after);
    OpticalSurface_set_aperture_radius(s, aperture_radius);
    return s;
}

# A ray state during tracing: position, direction (normalized), medium index n.
# position and direction are RayVec3.
#derive(accessors)
struct TraceRay { pos; dir; n; }

# TraceRay at `pos` heading `dir` (both RayVec3, dir normalised) in a medium of
# index n; 0 on allocation failure.
#must_use
fn trace_ray_new(pos, dir, n) {
    var r = alloc(sizeof(TraceRay));
    if (r == 0) { return 0; }
    TraceRay_set_pos(r, pos);
    TraceRay_set_dir(r, dir);
    TraceRay_set_n(r, n);
    return r;
}

# Result of tracing through one surface: hit point, outward normal (both
# RayVec3), refracted ray_after (TraceRay), and Fresnel reflectance.
#derive(accessors)
struct TraceHit { hit_point; normal; ray_after; reflectance; }

# Trace a ray through a single optical surface. Returns a TraceHit (0 on error)
# and writes PK_ERR_NONE / PK_ERR_* to err_out. Surfaces are centered on the z
# axis; a spherical surface's center of curvature is at z_position + radius.
#must_use
fn trace_surface(ray, surface, err_out) {
    _prk_trace("trace_surface");
    store64(err_out, PK_ERR_NONE);
    # ⛔ 2.3.5: a null `ray` or `surface` read straight off address 0 and SIGSEGVed
    # — `TraceRay_pos(0)` on the next line. Verified: `trace_surface(0, 0, &e)`
    # exited 139 with a core dump. This is the defect class 2.0.2 swept seven
    # public entry points for and 2.2.8 found four more of; trace_surface was
    # missed by both, and `cyrius coverage` cannot see it because every test calls
    # it with valid handles. The whole tracing stack funnels through here —
    # trace_sequential, trace_sequential_polarized and the recursive tracer all
    # call it in a loop — so one null surface in a caller-built list took the
    # process down rather than reporting. PK_ERR_INVALID_PARAMETER and a 0 return
    # match what the aperture and geometry rejects below already do.
    if (ray == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (surface == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var pos = TraceRay_pos(ray);
    var dir = TraceRay_dir(ray);
    var px = RayVec3_x(pos);
    var py = RayVec3_y(pos);
    var pz = RayVec3_z(pos);
    var dx = RayVec3_x(dir);
    var dy = RayVec3_y(dir);
    var dz = RayVec3_z(dir);
    var z_pos = OpticalSurface_z_position(surface);

    var hit_x = f64_from(0);
    var hit_y = f64_from(0);
    var hit_z = f64_from(0);
    var nx = f64_from(0);
    var ny = f64_from(0);
    var nz = f64_from(0);

    if (OpticalSurface_shape_tag(surface) == SURF_PLANE) {
        # Intersection with the z = z_position plane.
        if (f64_lt(f64_abs(dz), _trace_eps15()) == 1) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        var t = f64_div(f64_sub(z_pos, pz), dz);
        # 2.2.6: was `f64_lt(t, 0)`, which ACCEPTS t == 0 — a ray whose origin
        # already lies on the plane re-hits it at zero distance, so
        # trace_recursive re-enters the same surface forever. The sphere branch
        # below always required t > _trace_eps10(); this now matches it.
        if (f64_gt(t, _trace_eps10()) == 0) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        hit_x = f64_add(px, f64_mul(t, dx));
        hit_y = f64_add(py, f64_mul(t, dy));
        hit_z = f64_add(pz, f64_mul(t, dz));
        # Normal points back against propagation.
        if (f64_gt(dz, f64_from(0)) == 1) {
            nz = f64_neg(F64_ONE);
        } else {
            nz = F64_ONE;
        }
    } else {
        # Spherical surface. Center of curvature at [0, 0, z_pos + radius].
        var radius = OpticalSurface_radius(surface);
        var cz = f64_add(z_pos, radius);
        var ocx = px;
        var ocy = py;
        var ocz = f64_sub(pz, cz);
        var half_b = f64_add(f64_add(f64_mul(ocx, dx), f64_mul(ocy, dy)), f64_mul(ocz, dz));
        var cc = f64_sub(
          f64_add(f64_add(f64_mul(ocx, ocx), f64_mul(ocy, ocy)), f64_mul(ocz, ocz)),
          f64_mul(radius, radius));
        var disc = f64_sub(f64_mul(half_b, half_b), cc);
        if (f64_lt(disc, f64_from(0)) == 1) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        var sqrt_d = f64_sqrt(disc);
        var t1 = f64_sub(f64_neg(half_b), sqrt_d);
        var t2 = f64_add(f64_neg(half_b), sqrt_d);
        # 2.2.6: this took the nearest positive root of the WHOLE sphere. The
        # optical surface is only the cap containing the vertex at z_position —
        # the cap where sign(hit_z - cz) == sign(-radius). For radius > 0 the
        # vertex cap IS the near cap, so convex surfaces were always right; for
        # radius < 0 the vertex cap is the FAR one, so any concave surface
        # reached from outside its own sphere took the back cap. That is not
        # merely a displaced hit: the normal is flipped to face the incoming ray
        # below, so the transverse component comes out with the opposite sign
        # and the concave surface REFRACTS LIKE A CONVEX ONE, with err_out left
        # at PK_ERR_NONE. Measured (radius = -50, z = 0, axis-parallel ray at
        # y = 10): from z = -200 the hit was z = -98.99 with outgoing dy
        # -0.067575; the correct vertex-cap hit is z = -1.010205 with dy
        # +0.067575. The shipped prescriptions all place the concave centre far
        # enough left that the ray starts inside the sphere, which is why the
        # suite never saw it.
        var t = f64_from(0);
        var got = 0;
        if (f64_gt(t1, _trace_eps10()) == 1) {
            if (_trace_on_vertex_cap(pz, dz, t1, cz, radius) == 1) { t = t1; got = 1; }
        }
        if (got == 0) {
            if (f64_gt(t2, _trace_eps10()) == 1) {
                if (_trace_on_vertex_cap(pz, dz, t2, cz, radius) == 1) { t = t2; got = 1; }
            }
        }
        if (got == 0) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
        hit_x = f64_add(px, f64_mul(t, dx));
        hit_y = f64_add(py, f64_mul(t, dy));
        hit_z = f64_add(pz, f64_mul(t, dz));
        # Outward normal = (hit - center) / |hit - center|.
        nx = hit_x;
        ny = hit_y;
        nz = f64_sub(hit_z, cz);
        var nlen = f64_sqrt(f64_add(f64_add(f64_mul(nx, nx), f64_mul(ny, ny)), f64_mul(nz, nz)));
        nx = f64_div(nx, nlen);
        ny = f64_div(ny, nlen);
        nz = f64_div(nz, nlen);
        # Ensure the normal faces the incoming ray.
        var dot_dn = f64_add(f64_add(f64_mul(dx, nx), f64_mul(dy, ny)), f64_mul(dz, nz));
        if (f64_gt(dot_dn, f64_from(0)) == 1) {
            nx = f64_neg(nx);
            ny = f64_neg(ny);
            nz = f64_neg(nz);
        }
    }

    # Aperture check.
    var r2 = f64_add(f64_mul(hit_x, hit_x), f64_mul(hit_y, hit_y));
    var ap = OpticalSurface_aperture_radius(surface);
    if (f64_gt(r2, f64_mul(ap, ap)) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }

    # Refract through the surface.
    #
    # ⭐ 2.3.6: Snell answers through stack locals and the five objects below share
    # ONE allocation. This function used to make FIVE separate ones per hit —
    # normal, the refracted direction, hit_point, the after-ray and the TraceHit
    # header, 128 bytes total — and it runs twice per trace_sequential and 38
    # times per spot_diagram.
    #
    # ⚠ The obvious fix is illegal here and was measured to corrupt. CLAUDE.md says
    # "write into a caller buffer, not a fresh allocation", but that rule assumes
    # the CALLER owns the lifetime, and no caller in src/ does: trace_sequential
    # retains every hit in the vec it returns, and _trace_recursive_inner hands
    # best_hit's hit_point to TraceSegments that outlive the trace. A reused buffer
    # aliases them — demonstrated, both entries of the returned vec became the same
    # pointer and the first surface's hit was destroyed, silently and with no error
    # code. Sub-allocating one FRESH block per call keeps lifetimes bit-for-bit
    # what they are today while paying for one alloc instead of five.
    #
    # ⚠ This buys TIME, not memory: the block is the same 128 bytes the five
    # separate objects occupied, so allocation VOLUME is unchanged.
    var refl = f64_from(0);
    var serr = 0;
    var rx = f64_from(0);
    var ry = f64_from(0);
    var rz = f64_from(0);
    var _sr = _ray_snell_3d_out(dir, nx, ny, nz, TraceRay_n(ray),
      OpticalSurface_n_after(surface), &rx, &ry, &rz, &refl, &serr);
    # ⚠ 2.2.8: TOTAL INTERNAL REFLECTION IS A HIT, NOT A MISS. This returned 0
    # for TIR exactly as it does for a geometric miss, and trace_recursive's
    # candidate filter is `prakash_is_err(e) == 0` — so a totally-internally-
    # reflecting surface was dropped from the nearest-surface search and THE RAY
    # PASSED STRAIGHT THROUGH IT. Measured: a ray at 60 deg inside n=1.5
    # (critical angle 41.8 deg) hitting a glass-air plane produced
    # interactions = 0 and a single EVENT_ESCAPED segment at full energy — the
    # defining phenomenon of a prism or a light guide, silently deleted.
    # TIR now returns a real TraceHit carrying the hit point and normal, with
    # reflectance = 1.0 and ray_after = 0 (there is no transmitted ray), while
    # STILL reporting PK_ERR_TIR through err_out. A caller that only checks
    # err_out is unaffected; one that wants to reflect now has the geometry it
    # needs, which it previously could not obtain at all.
    var tir = 0;
    if (prakash_is_err(serr) == 1) {
        if (serr != PK_ERR_TIR) {
            store64(err_out, serr);
            return 0;
        }
        tir = 1;
        refl = F64_ONE;
    }

    # One block: [TraceHit][hit_point][normal][after dir][after ray]. TIR needs
    # only the first three — there is no transmitted ray — so it takes 80 bytes
    # where a refracting hit takes 128. Knowing `tir` before this point is exactly
    # what the _ray_snell_3d_out split above bought. Every offset is a multiple of
    # 8 and alloc returns 16-byte aligned memory.
    var size = _trace_hit_block();
    if (tir == 1) { size = _trace_hit_block_tir(); }
    var hit = alloc(size);
    if (hit == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    var hit_point = hit + sizeof(TraceHit);
    RayVec3_set_x(hit_point, hit_x);
    RayVec3_set_y(hit_point, hit_y);
    RayVec3_set_z(hit_point, hit_z);
    var normal = hit_point + sizeof(RayVec3);
    RayVec3_set_x(normal, nx);
    RayVec3_set_y(normal, ny);
    RayVec3_set_z(normal, nz);
    var ray_after = 0;
    if (tir == 0) {
        var after_dir = normal + sizeof(RayVec3);
        RayVec3_set_x(after_dir, rx);
        RayVec3_set_y(after_dir, ry);
        RayVec3_set_z(after_dir, rz);
        ray_after = after_dir + sizeof(RayVec3);
        TraceRay_set_pos(ray_after, hit_point);
        TraceRay_set_dir(ray_after, after_dir);
        TraceRay_set_n(ray_after, OpticalSurface_n_after(surface));
    }
    TraceHit_set_hit_point(hit, hit_point);
    TraceHit_set_normal(hit, normal);
    TraceHit_set_ray_after(hit, ray_after);
    TraceHit_set_reflectance(hit, refl);
    if (tir == 1) { store64(err_out, PK_ERR_TIR); }
    return hit;
}

# Trace a ray through a sequence of surfaces (a `vec` of OpticalSurface).
# Returns a `vec` of TraceHit (0 on error, with err_out set).
#must_use
fn trace_sequential(initial_ray, surfaces, err_out) {
    _prk_trace("trace_sequential");
    store64(err_out, PK_ERR_NONE);
    if (initial_ray == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (surfaces == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var hits = vec_new();
    var current = initial_ray;
    var count = vec_len(surfaces);
    var i = 0;
    while (i < count) {
        var surface = vec_get(surfaces, i);
        var he = 0;
        var hit = trace_surface(current, surface, &he);
        if (prakash_is_err(he) == 1) {
            store64(err_out, he);
            return 0;
        }
        current = TraceHit_ray_after(hit);
        vec_push(hits, hit);
        i = i + 1;
    }
    return hits;
}

# ── Polarization ray tracing ────────

# A geometric hit plus cumulative s/p transmittance and the R_p/R_s ratio.
#derive(accessors)
struct PolarizedTraceHit { hit; rp_over_rs; transmittance_s; transmittance_p; }

# Trace with polarization tracking: at each surface accumulate the s- and
# p-polarized Fresnel transmittances. Returns a `vec` of PolarizedTraceHit
# (0 on error, err_out set).
#must_use
fn trace_sequential_polarized(initial_ray, surfaces, err_out) {
    _prk_trace("trace_sequential_polarized");
    store64(err_out, PK_ERR_NONE);
    if (initial_ray == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (surfaces == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var results = vec_new();
    var current = initial_ray;
    var cum_ts = F64_ONE;
    var cum_tp = F64_ONE;
    var count = vec_len(surfaces);
    var i = 0;
    while (i < count) {
        var surface = vec_get(surfaces, i);
        var he = 0;
        var hit = trace_surface(current, surface, &he);
        if (prakash_is_err(he) == 1) {
            store64(err_out, he);
            return 0;
        }
        var nrm = TraceHit_normal(hit);
        var cdir = TraceRay_dir(current);
        var dot_i = f64_add(
          f64_add(f64_mul(RayVec3_x(cdir), RayVec3_x(nrm)), f64_mul(RayVec3_y(cdir), RayVec3_y(nrm))),
          f64_mul(RayVec3_z(cdir), RayVec3_z(nrm)));
        var cos_i = f64_neg(f64_abs(dot_i));
        var adir = TraceRay_dir(TraceHit_ray_after(hit));
        var dot_t = f64_add(
          f64_add(f64_mul(RayVec3_x(adir), RayVec3_x(nrm)), f64_mul(RayVec3_y(adir), RayVec3_y(nrm))),
          f64_mul(RayVec3_z(adir), RayVec3_z(nrm)));
        var cos_t = f64_neg(f64_abs(dot_t));
        var n1 = TraceRay_n(current);
        var n2 = OpticalSurface_n_after(surface);
        var rs = fresnel_s(n1, n2, cos_i, cos_t);
        var rp = fresnel_p(n1, n2, cos_i, cos_t);
        cum_ts = f64_mul(cum_ts, f64_sub(F64_ONE, rs));
        cum_tp = f64_mul(cum_tp, f64_sub(F64_ONE, rp));
        var rp_over_rs = f64_from(0);
        if (f64_gt(rs, _trace_eps15()) == 1) {
            rp_over_rs = f64_div(rp, rs);
        }
        var pth = alloc(sizeof(PolarizedTraceHit));
        if (pth == 0) {
            store64(err_out, PK_ERR_ALLOCATION);
            return 0;
        }
        PolarizedTraceHit_set_hit(pth, hit);
        PolarizedTraceHit_set_rp_over_rs(pth, rp_over_rs);
        PolarizedTraceHit_set_transmittance_s(pth, cum_ts);
        PolarizedTraceHit_set_transmittance_p(pth, cum_tp);
        vec_push(results, pth);
        current = TraceHit_ray_after(hit);
        i = i + 1;
    }
    return results;
}

# --- ray_prt.cyr ---

# ray_prt.cyr -- three-dimensional polarization ray tracing
# Usage: include "lib/ray_prt.cyr"  (requires error.cyr, ray_core.cyr, ray_fresnel.cyr,
# ray_trace.cyr)
#
# New in 2.12.0, and NOT a port: the Rust 1.x crate tracked scalar s/p transmittance, and so
# does trace_sequential_polarized. Here the polarization state of a ray is a 3D electric
# field in global coordinates, carried by a 3x3 complex matrix per surface: Chipman's
# polarization ray-tracing matrix (Yun, Crabtree & Chipman, Appl. Opt. 50, 2855 (2011);
# Yun, McClain & Chipman, Appl. Opt. 50, 2866 (2011)).
#
# THE MATRIX. For a ray of direction k meeting a surface of normal eta and leaving along k',
#   s = k x eta / |k x eta|,  p = k x s,  p' = k' x s,
#   P = O_out diag(a_s, a_p, 1) O_in^-1 = a_s s s^T + a_p p' p^T + k' k^T,
# with O_in = (s, p, k), O_out = (s, p', k'), and (a_s, a_p) = (t_s, t_p) on refraction,
# (r_s, r_p) on reflection, from fresnel_amplitudes. E' = P E in global coordinates, P k = k',
# and a path multiplies along itself: P_total = P_N ... P_2 P_1.
#
# GEOMETRY IS NOT RETARDANCE. A fold mirror turns a polarization state with no physical
# phase shift, and P cannot tell the two apart: two paths can share a P and differ in
# retardance. Q is the same chain for a nonpolarizing system, which holds only the geometry:
#   Q = O_out diag(1, +-1, 1) O_in^T,  + on refraction, - on reflection.
# The - is Chipman's: Lam's dissertation (Univ. Arizona, 2015) Eqs. 4.5-4.6, "a right-handed
# orthonormal basis becomes left-handed after reflection". With it, an ideal mirror is no
# retarder at normal incidence, and a reflection's Q is the mirror matrix I - 2 eta eta^T.
# (Her diag has 0 in the last place, so her Q annihilates k. The 1 here keeps Q orthogonal
# and changes nothing in the transverse plane, which is all retardance reads.)
#   Q^T P, restricted to the plane transverse to the first k, is then a 2x2 Jones matrix J in
# the input frame, and diattenuation and retardance are J's.
#
# ⚠ WHAT "RETARDANCE" MEANS ON A REFLECTION. It is measured from that ideal mirror. So an
# odd number of reflections reads pi away from a bare arg(r_p/r_s): total internal
# reflection at the critical angle has r_s = r_p = 1 and reads pi, a half wave, which is
# Lam's "polarization inversion". An even number agrees: a Fresnel rhomb reads 2 delta.
#
# ⚠ TIME CONVENTION. e^(-i w t), as in ray_fresnel, multilayer_rta, wave_focus and wave_doe, so
# a published matrix in the e^(+i w t) convention is the complex conjugate of this one. Lam's
# is, and so is wave_beam (Siegman's convention). Retardance and diattenuation are the same
# either way. (2.15.1: this said "as everywhere else in prakash", which wave_beam is not.)
#
# Unit vectors are checked, not assumed: a k or eta off unit length by more than ~1e-12 is
# refused, because the frames above would silently stop being orthonormal.
#
# ⚠ THE ABSOLUTE NOISE FLOOR. P keeps k' k^T at unit size next to the transverse terms, so an
# amplitude under ~1e-12 of the input is not readable from it: diattenuation and retardance
# answer NaN there rather than a number made of rounding.

# A P or Q matrix is a 144-byte buffer of 18 f64: element (i, j) has its real part at byte
# offset (i*3 + j)*8 and its imaginary part 72 bytes on.
var PRT_MATRIX_BYTES = 144;

# 2^-80. P's elements carry k' k^T at unit size, so their rounding is ABSOLUTE, ~1e-16 in
# every element whatever the path passes. A transverse amplitude under 2^-40 ~ 1e-12 of the
# input cannot be read back from them to better than a part in 1e4, so as a power this is the
# floor for "the path passes something" (|J|^2) and for a usable second singular value.
var _PRT_NOTHING = 0x3AF0000000000000;

# A complex electric field in global coordinates.
#derive(accessors)
struct PrtField { x_re; x_im; y_re; y_im; z_re; z_im; }

# One surface's result. p and q are PRT_MATRIX_BYTES buffers inside the step; (kx, ky, kz)
# is the exiting direction; flux turns |P E|^2 into the power crossing the surface;
# reflectance is (R_s + R_p)/2, or NaN from prt_surface on a refraction, which is not told.
#derive(accessors)
struct PrtStep { p; q; kx; ky; kz; flux; reflectance; }

# A surface of a trace_sequential_prt path. hit is the TraceHit; surface_p the surface's P;
# total_p and total_q the chains so far; flux their cumulative flux factor. All
# PRT_MATRIX_BYTES buffers are inside this hit, so it owns them.
#derive(accessors)
struct PrtTraceHit { hit; surface_p; total_p; total_q; flux; }

# The identity, written to a PRT_MATRIX_BYTES buffer. Returns m.
fn prt_identity(m) {
    if (m == 0) { return 0; }
    for (var i = 0; i < 18; i = i + 1) { store64(m + i * 8, 0); }
    store64(m, F64_ONE);
    store64(m + 32, F64_ONE);
    store64(m + 64, F64_ONE);
    return m;
}

# A new identity matrix; 0 on allocation failure.
#must_use
fn prt_new() {
    return prt_identity(alloc(PRT_MATRIX_BYTES));
}

# Re P(i, j), or NaN for a null matrix or an index outside 0..2.
#must_use
fn prt_re(m, i, j) {
    if ((m == 0) | (i < 0) | (i > 2) | (j < 0) | (j > 2)) { return _PRK_NAN; }
    return load64(m + (i * 3 + j) * 8);
}

# Im P(i, j), or NaN for a null matrix or an index outside 0..2.
#must_use
fn prt_im(m, i, j) {
    if ((m == 0) | (i < 0) | (i > 2) | (j < 0) | (j > 2)) { return _PRK_NAN; }
    return load64(m + 72 + (i * 3 + j) * 8);
}

# out = a b, the path a after b. out may be a or b. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER for a null handle.
fn prt_multiply(a, b, out) {
    if ((a == 0) | (b == 0) | (out == 0)) { return PK_ERR_INVALID_PARAMETER; }
    var t[144];
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var re = 0;
            var im = 0;
            for (var k = 0; k < 3; k = k + 1) {
                var ar = load64(a + (i * 3 + k) * 8);
                var ai = load64(a + 72 + (i * 3 + k) * 8);
                var br = load64(b + (k * 3 + j) * 8);
                var bi = load64(b + 72 + (k * 3 + j) * 8);
                re = f64_add(re, f64_sub(f64_mul(ar, br), f64_mul(ai, bi)));
                im = f64_add(im, f64_add(f64_mul(ar, bi), f64_mul(ai, br)));
            }
            store64(&t + (i * 3 + j) * 8, re);
            store64(&t + 72 + (i * 3 + j) * 8, im);
        }
    }
    for (var n = 0; n < 18; n = n + 1) { store64(out + n * 8, load64(&t + n * 8)); }
    return PK_ERR_NONE;
}

# A new field; 0 on allocation failure.
#must_use
fn prt_field_new(x_re, x_im, y_re, y_im, z_re, z_im) {
    var e = alloc(sizeof(PrtField));
    if (e == 0) { return 0; }
    PrtField_set_x_re(e, x_re);
    PrtField_set_x_im(e, x_im);
    PrtField_set_y_re(e, y_re);
    PrtField_set_y_im(e, y_im);
    PrtField_set_z_re(e, z_re);
    PrtField_set_z_im(e, z_im);
    return e;
}

# out = m e, for PrtFields e and out. out may be e. Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER for a null handle.
fn prt_apply(m, e, out) {
    if ((m == 0) | (e == 0) | (out == 0)) { return PK_ERR_INVALID_PARAMETER; }
    var t[48];
    for (var i = 0; i < 3; i = i + 1) {
        var re = 0;
        var im = 0;
        for (var j = 0; j < 3; j = j + 1) {
            var mr = load64(m + (i * 3 + j) * 8);
            var mi = load64(m + 72 + (i * 3 + j) * 8);
            var er = load64(e + j * 16);
            var ei = load64(e + j * 16 + 8);
            re = f64_add(re, f64_sub(f64_mul(mr, er), f64_mul(mi, ei)));
            im = f64_add(im, f64_add(f64_mul(mr, ei), f64_mul(mi, er)));
        }
        store64(&t + i * 16, re);
        store64(&t + i * 16 + 8, im);
    }
    for (var n = 0; n < 6; n = n + 1) { store64(out + n * 8, load64(&t + n * 8)); }
    return PK_ERR_NONE;
}

# A step with its two matrices; 0 on allocation failure. One block, reusable across a sweep.
#must_use
fn prt_step_new() {
    var s = alloc(sizeof(PrtStep) + 2 * PRT_MATRIX_BYTES);
    if (s == 0) { return 0; }
    PrtStep_set_p(s, prt_identity(s + sizeof(PrtStep)));
    PrtStep_set_q(s, prt_identity(s + sizeof(PrtStep) + PRT_MATRIX_BYTES));
    PrtStep_set_kx(s, 0);
    PrtStep_set_ky(s, 0);
    PrtStep_set_kz(s, 0);
    PrtStep_set_flux(s, F64_ONE);
    PrtStep_set_reflectance(s, 0);
    return s;
}

# 1 if v is a non-null RayVec3 of unit length to within 2^-40 of |v|^2 = 1. NaN fails it.
fn _prt_unit_ok(v) {
    if (v == 0) { return 0; }
    var x = RayVec3_x(v);
    var y = RayVec3_y(v);
    var z = RayVec3_z(v);
    var l2 = f64_add(f64_add(f64_mul(x, x), f64_mul(y, y)), f64_mul(z, z));
    return f64_lt(f64_abs(f64_sub(l2, F64_ONE)), 0x3D70000000000000);
}

# a x b for three-slot buffers; out may not be a or b.
fn _prt_cross(a, b, out) {
    store64(out, f64_sub(f64_mul(load64(a + 8), load64(b + 16)), f64_mul(load64(a + 16), load64(b + 8))));
    store64(out + 8, f64_sub(f64_mul(load64(a + 16), load64(b)), f64_mul(load64(a), load64(b + 16))));
    store64(out + 16, f64_sub(f64_mul(load64(a), load64(b + 8)), f64_mul(load64(a + 8), load64(b))));
    return 0;
}

# Scale a three-slot buffer to unit length.
fn _prt_unit(v) {
    var x = load64(v);
    var y = load64(v + 8);
    var z = load64(v + 16);
    var l = f64_sqrt(f64_add(f64_add(f64_mul(x, x), f64_mul(y, y)), f64_mul(z, z)));
    store64(v, f64_div(x, l));
    store64(v + 8, f64_div(y, l));
    store64(v + 16, f64_div(z, l));
    return 0;
}

# A unit vector transverse to the unit vector k: the axis k leans on least, crossed with k.
fn _prt_transverse(k, out) {
    var ax = f64_abs(load64(k));
    var ay = f64_abs(load64(k + 8));
    var az = f64_abs(load64(k + 16));
    var e[24];
    store64(&e, 0);
    store64(&e + 8, 0);
    store64(&e + 16, 0);
    if ((f64_le(ax, ay) & f64_le(ax, az)) == 1) {
        store64(&e, F64_ONE);
    } else {
        if (f64_le(ay, az) == 1) { store64(&e + 8, F64_ONE); } else { store64(&e + 16, F64_ONE); }
    }
    var _c = _prt_cross(&e, k, out);
    return _prt_unit(out);
}

# Fill a step's P and Q from the two directions, s and the two amplitudes. qp is Q's sign
# on p: +1 for refraction, -1 for reflection. Assumes k, o, s are unit and s is
# perpendicular to both.
fn _prt_compose(step, k, o, s, asr, asi, apr, api, qp) {
    var pi[24];
    var po[24];
    var _c = _prt_cross(k, s, &pi);
    _c = _prt_cross(o, s, &po);
    var pm = PrtStep_p(step);
    var qm = PrtStep_q(step);
    for (var i = 0; i < 3; i = i + 1) {
        for (var j = 0; j < 3; j = j + 1) {
            var ss = f64_mul(load64(s + i * 8), load64(s + j * 8));
            var pp = f64_mul(load64(&po + i * 8), load64(&pi + j * 8));
            var kk = f64_mul(load64(o + i * 8), load64(k + j * 8));
            var at = (i * 3 + j) * 8;
            store64(pm + at, f64_add(f64_add(f64_mul(asr, ss), f64_mul(apr, pp)), kk));
            store64(pm + 72 + at, f64_add(f64_mul(asi, ss), f64_mul(api, pp)));
            store64(qm + at, f64_add(f64_add(ss, f64_mul(qp, pp)), kk));
            store64(qm + 72 + at, 0);
        }
    }
    return 0;
}

# The unit s of a ray k at normal eta, into a three-slot buffer. At normal incidence k x eta
# is nothing, and any transverse s serves: a_s = a_p on refraction and a_s = -a_p on
# reflection make P independent of it, and P stays continuous there because the difference
# is second order in the angle.
#
# ⚠ Near normal k x eta is part rounding, which leaves s off perpendicular to k by ~1e-16
# over the angle: every element of P was wrong at 2e-16 rad, and five digits were gone at
# 1e-6 rad. Which way s points hardly matters there, for the reason above; that it is
# transverse does. So it is always made transverse by hand. The result is perpendicular to
# k' too, to within the angle times the noise, which is an ulp.
fn _prt_s(k, eta, out) {
    var c[24];
    var _c = _prt_cross(k, eta, &c);
    var cx = load64(&c);
    var cy = load64(&c + 8);
    var cz = load64(&c + 16);
    var l2 = f64_add(f64_add(f64_mul(cx, cx), f64_mul(cy, cy)), f64_mul(cz, cz));
    if (f64_lt(l2, 0x3930000000000000) == 1) { return _prt_transverse(k, out); }     # 2^-108
    store64(out, cx);
    store64(out + 8, cy);
    store64(out + 16, cz);
    _c = _prt_unit(out);
    var d = f64_add(f64_add(f64_mul(load64(out), load64(k)), f64_mul(load64(out + 8), load64(k + 8))),
      f64_mul(load64(out + 16), load64(k + 16)));
    for (var i = 0; i < 3; i = i + 1) {
        store64(out + i * 8, f64_sub(load64(out + i * 8), f64_mul(d, load64(k + i * 8))));
    }
    return _prt_unit(out);
}

# 1 if k_out is a ray a surface of this normal can send: same tangential direction as k_in,
# and across the surface on refraction, or mirrored about it on reflection, to ~1e-12. The
# directions are compared as directions, so the test keeps its meaning however small they
# are, plus 2^-50 of absolute noise on each, which is all a legal ray near normal can carry.
fn _prt_geometry_ok(k_in, normal, k_out, reflect) {
    var dk = f64_add(f64_add(f64_mul(RayVec3_x(k_in), RayVec3_x(normal)), f64_mul(RayVec3_y(k_in), RayVec3_y(normal))),
      f64_mul(RayVec3_z(k_in), RayVec3_z(normal)));
    if (reflect == 1) {
        var e = 0;
        for (var i = 0; i < 3; i = i + 1) {
            var d = f64_sub(f64_sub(load64(k_in + i * 8), f64_mul(f64_mul(F64_TWO, dk), load64(normal + i * 8))),
              load64(k_out + i * 8));
            e = f64_add(e, f64_mul(d, d));
        }
        return f64_le(e, _PRT_NOTHING);
    }
    var dov = f64_add(f64_add(f64_mul(RayVec3_x(k_out), RayVec3_x(normal)), f64_mul(RayVec3_y(k_out),
          RayVec3_y(normal))),
      f64_mul(RayVec3_z(k_out), RayVec3_z(normal)));
    if (f64_gt(f64_mul(dk, dov), 0) == 0) { return 0; }
    var tin[24];
    var tou[24];
    var par[24];
    var _c = _prt_cross(k_in, normal, &tin);
    _c = _prt_cross(k_out, normal, &tou);
    _c = _prt_cross(&tin, &tou, &par);
    var e2 = f64_add(f64_add(f64_mul(load64(&par), load64(&par)), f64_mul(load64(&par + 8), load64(&par + 8))),
      f64_mul(load64(&par + 16), load64(&par + 16)));
    var two = f64_add(f64_add(f64_mul(load64(&tin), load64(&tou)), f64_mul(load64(&tin + 8), load64(&tou + 8))),
      f64_mul(load64(&tin + 16), load64(&tou + 16)));
    var li = f64_add(f64_add(f64_mul(load64(&tin), load64(&tin)), f64_mul(load64(&tin + 8), load64(&tin + 8))),
      f64_mul(load64(&tin + 16), load64(&tin + 16)));
    var lo = f64_add(f64_add(f64_mul(load64(&tou), load64(&tou)), f64_mul(load64(&tou + 8), load64(&tou + 8))),
      f64_mul(load64(&tou + 16), load64(&tou + 16)));
    # Straight down the normal, k_out must leave along it too.
    if ((f64_lt(li, 0x3930000000000000) == 1) & (f64_gt(lo, _PRT_NOTHING) == 1)) { return 0; }
    var lim = f64_add(f64_mul(_PRT_NOTHING, f64_mul(li, lo)), f64_mul(0x39B0000000000000, f64_add(li, lo)));
    return f64_le(e2, lim) & f64_ge(two, f64_neg(_PRT_NOTHING));
}

# P and Q of a surface given its amplitudes directly, for a coating or any other source of
# a_s and a_p: k_in at normal to k_out, reflect = 1 on reflection, 0 on refraction. All three
# are unit RayVec3s and the normal's sign does not matter. a_s and a_p are taken on trust;
# the geometry is not. step's flux is left at 1 and its k is set to k_out. Returns
# PK_ERR_NONE, or PK_ERR_INVALID_PARAMETER for a null handle, a non-unit vector, an unknown
# reflect, or a k_out no such surface can send (out of the plane of incidence, on the wrong
# side, or off the law of reflection). A P built on any of those is not a P at all: its
# frames are not orthonormal, so nothing read from it would mean anything.
fn prt_surface(k_in, normal, k_out, as_re, as_im, ap_re, ap_im, reflect, step) {
    if (step == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((_prt_unit_ok(k_in) & _prt_unit_ok(normal) & _prt_unit_ok(k_out)) == 0) {
        return PK_ERR_INVALID_PARAMETER;
    }
    if ((reflect != 0) & (reflect != 1)) { return PK_ERR_INVALID_PARAMETER; }
    if (_prt_geometry_ok(k_in, normal, k_out, reflect) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var s[24];
    var _c = _prt_s(k_in, normal, &s);
    var qp = F64_ONE;
    if (reflect == 1) { qp = f64_neg(F64_ONE); }
    _c = _prt_compose(step, k_in, k_out, &s, as_re, as_im, ap_re, ap_im, qp);
    PrtStep_set_kx(step, RayVec3_x(k_out));
    PrtStep_set_ky(step, RayVec3_y(k_out));
    PrtStep_set_kz(step, RayVec3_z(k_out));
    PrtStep_set_flux(step, F64_ONE);
    var rf = _PRK_NAN;
    if (reflect == 1) {
        rf = f64_mul(F64_HALF, f64_add(f64_add(f64_mul(as_re, as_re), f64_mul(as_im, as_im)),
            f64_add(f64_mul(ap_re, ap_re), f64_mul(ap_im, ap_im))));
    }
    PrtStep_set_reflectance(step, rf);
    return PK_ERR_NONE;
}

# cos(theta_i) of a unit k at a unit normal, and the normal turned to face the ray.
fn _prt_face(k, normal, facing, cos_out) {
    var nx = RayVec3_x(normal);
    var ny = RayVec3_y(normal);
    var nz = RayVec3_z(normal);
    var dot = f64_add(f64_add(f64_mul(RayVec3_x(k), nx), f64_mul(RayVec3_y(k), ny)), f64_mul(RayVec3_z(k), nz));
    if (f64_gt(dot, 0) == 1) {
        nx = f64_neg(nx);
        ny = f64_neg(ny);
        nz = f64_neg(nz);
    }
    store64(facing, nx);
    store64(facing + 8, ny);
    store64(facing + 16, nz);
    # Unit to rounding is not unit: a k along a normal has k.k just above 1 about one time in
    # six, and fresnel_amplitudes rightly refuses a cosine above 1.
    var c = f64_abs(dot);
    if (f64_gt(c, F64_ONE) == 1) { c = F64_ONE; }
    store64(cos_out, c);
    return 0;
}

# (R_s + R_p)/2 of an amplitude record.
fn _prt_r_avg(fa) {
    var rs = f64_add(f64_mul(FresnelAmplitudes_rs_re(fa), FresnelAmplitudes_rs_re(fa)),
      f64_mul(FresnelAmplitudes_rs_im(fa), FresnelAmplitudes_rs_im(fa)));
    var rp = f64_add(f64_mul(FresnelAmplitudes_rp_re(fa), FresnelAmplitudes_rp_re(fa)),
      f64_mul(FresnelAmplitudes_rp_im(fa), FresnelAmplitudes_rp_im(fa)));
    return f64_mul(F64_HALF, f64_add(rs, rp));
}

# Refraction of a ray along unit k_in at a surface of unit normal (either sign), from real
# n1 into real n2: fills step with P, Q, the refracted direction and the flux factor
# n2 cos(theta_t)/(n1 cos(theta_i)). Returns PK_ERR_NONE, PK_ERR_TIR (there is no refracted
# ray), or PK_ERR_INVALID_PARAMETER / PK_ERR_INVALID_ANGLE as fresnel_amplitudes, and for a
# null step or a non-unit vector. step is untouched on any refusal.
fn prt_refract(k_in, normal, n1, n2, step) {
    if (step == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((_prt_unit_ok(k_in) & _prt_unit_ok(normal)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var f[24];
    var c = 0;
    var _c = _prt_face(k_in, normal, &f, &c);
    var fa[80];
    var e = fresnel_amplitudes(n1, n2, 0, c, &fa);
    if (e != PK_ERR_NONE) { return e; }
    var flux = FresnelAmplitudes_flux_s(&fa);
    if (f64_gt(flux, 0) == 0) { return PK_ERR_TIR; }
    # k' = ratio t - cos_t f from the tangential part t = k + c f, whose length is sin(theta_i)
    # to full precision: a cosine near 1 cannot resolve a small angle, so going back through c
    # broke n sin(theta) by 1e-12 at n1/n2 = 100. x = ratio |t| is sin(theta_t), and the
    # refusal above and this one agree but for the last ulp before the critical angle.
    var ratio = f64_div(n1, n2);
    var t[24];
    var t2 = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var ti = f64_add(load64(k_in + i * 8), f64_mul(c, load64(&f + i * 8)));
        store64(&t + i * 8, ti);
        t2 = f64_add(t2, f64_mul(ti, ti));
    }
    var x = f64_mul(ratio, f64_sqrt(t2));
    if (f64_ge(x, F64_ONE) == 1) { return PK_ERR_TIR; }
    var ct = f64_sqrt(f64_mul(f64_sub(F64_ONE, x), f64_add(F64_ONE, x)));
    var o[24];
    for (var j = 0; j < 3; j = j + 1) {
        store64(&o + j * 8, f64_sub(f64_mul(ratio, load64(&t + j * 8)), f64_mul(ct, load64(&f + j * 8))));
    }
    _c = _prt_unit(&o);
    var s[24];
    _c = _prt_s(k_in, normal, &s);
    _c = _prt_compose(step, k_in, &o, &s, FresnelAmplitudes_ts_re(&fa), FresnelAmplitudes_ts_im(&fa),
      FresnelAmplitudes_tp_re(&fa), FresnelAmplitudes_tp_im(&fa), F64_ONE);
    PrtStep_set_kx(step, load64(&o));
    PrtStep_set_ky(step, load64(&o + 8));
    PrtStep_set_kz(step, load64(&o + 16));
    PrtStep_set_flux(step, flux);
    PrtStep_set_reflectance(step, _prt_r_avg(&fa));
    return PK_ERR_NONE;
}

# Reflection of a ray along unit k_in, in real n1, from a surface of unit normal (either
# sign) backed by n2 + i k2: a metal, a dielectric, or total internal reflection. Fills step
# with P, Q and the mirrored direction; flux = 1, since |r|^2 is already the power. Returns
# PK_ERR_NONE, or PK_ERR_INVALID_PARAMETER / PK_ERR_INVALID_ANGLE as fresnel_amplitudes, and
# for a null step or a non-unit vector. step is untouched on any refusal.
fn prt_reflect(k_in, normal, n1, n2, k2, step) {
    if (step == 0) { return PK_ERR_INVALID_PARAMETER; }
    if ((_prt_unit_ok(k_in) & _prt_unit_ok(normal)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var f[24];
    var c = 0;
    var _c = _prt_face(k_in, normal, &f, &c);
    var fa[80];
    var e = fresnel_amplitudes(n1, n2, k2, c, &fa);
    if (e != PK_ERR_NONE) { return e; }
    var o[24];
    var two_c = f64_mul(F64_TWO, c);
    for (var i = 0; i < 3; i = i + 1) {
        store64(&o + i * 8, f64_add(load64(k_in + i * 8), f64_mul(two_c, load64(&f + i * 8))));
    }
    # Unit, so that a long path can feed k' back: a light guide left to drift was refused
    # by its own unit test after 1691 bounces.
    _c = _prt_unit(&o);
    var s[24];
    _c = _prt_s(k_in, normal, &s);
    _c = _prt_compose(step, k_in, &o, &s, FresnelAmplitudes_rs_re(&fa), FresnelAmplitudes_rs_im(&fa),
      FresnelAmplitudes_rp_re(&fa), FresnelAmplitudes_rp_im(&fa), f64_neg(F64_ONE));
    PrtStep_set_kx(step, load64(&o));
    PrtStep_set_ky(step, load64(&o + 8));
    PrtStep_set_kz(step, load64(&o + 16));
    PrtStep_set_flux(step, F64_ONE);
    PrtStep_set_reflectance(step, _prt_r_avg(&fa));
    return PK_ERR_NONE;
}

# A new hit, one block holding its three matrices; 0 on allocation failure.
fn _prt_hit_new(hit) {
    var h = alloc(sizeof(PrtTraceHit) + 3 * PRT_MATRIX_BYTES);
    if (h == 0) { return 0; }
    var at = h + sizeof(PrtTraceHit);
    PrtTraceHit_set_hit(h, hit);
    PrtTraceHit_set_surface_p(h, at);
    PrtTraceHit_set_total_p(h, at + PRT_MATRIX_BYTES);
    PrtTraceHit_set_total_q(h, at + 2 * PRT_MATRIX_BYTES);
    return h;
}

# Trace a ray through a `vec` of OpticalSurface as trace_sequential does, carrying Chipman's
# P and Q. Returns a `vec` of PrtTraceHit, or 0 with err_out set.
#
# mirrors is 0, or a `vec` as long as surfaces: an entry of 0 refracts at that surface, and a
# ComplexMedium reflects from it, so complex_gold_550nm() makes a gold mirror of that surface
# and complex_dielectric(n, name) a surface that reflects with its true Fresnel coefficient,
# total internal reflection included. A mirror keeps the ray in its medium, so the surface's
# n_after is not read. The surface's shape and aperture are, as ever.
#
# PK_ERR_TIR ends a path at a surface that refracts, as in trace_sequential: name it in
# mirrors to follow the reflected ray.
#must_use
fn trace_sequential_prt(initial_ray, surfaces, mirrors, err_out) {
    _prk_trace("trace_sequential_prt");
    store64(err_out, PK_ERR_NONE);
    if ((initial_ray == 0) | (surfaces == 0)) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var count = vec_len(surfaces);
    if (mirrors != 0) {
        if (vec_len(mirrors) != count) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
    }
    var step = prt_step_new();
    var acc_p = prt_new();
    var acc_q = prt_new();
    var results = vec_new();
    if ((step == 0) | (acc_p == 0) | (acc_q == 0) | (results == 0)) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    var current = initial_ray;
    var flux = F64_ONE;
    var i = 0;
    while (i < count) {
        var surface = vec_get(surfaces, i);
        var mirror = 0;
        if (mirrors != 0) { mirror = vec_get(mirrors, i); }
        var he = 0;
        var hit = 0;
        if (mirror == 0) {
            hit = trace_surface(current, surface, &he);
        } else {
            if (surface == 0) {
                store64(err_out, PK_ERR_INVALID_PARAMETER);
                return 0;
            }
            # The geometry of this surface without its refraction: a copy whose n_after is the
            # ray's own passes the ray straight through, and the hit keeps nothing of it.
            var plain[40];
            for (var w = 0; w < 5; w = w + 1) { store64(&plain + w * 8, load64(surface + w * 8)); }
            OpticalSurface_set_n_after(&plain, TraceRay_n(current));
            hit = trace_surface(current, &plain, &he);
        }
        if (prakash_is_err(he) == 1) {
            store64(err_out, he);
            return 0;
        }
        var kd = TraceRay_dir(current);
        var nrm = TraceHit_normal(hit);
        var e = 0;
        if (mirror == 0) {
            e = prt_refract(kd, nrm, TraceRay_n(current), OpticalSurface_n_after(surface), step);
        } else {
            e = prt_reflect(kd, nrm, TraceRay_n(current), ComplexMedium_n(mirror), ComplexMedium_k(mirror), step);
        }
        if (e != PK_ERR_NONE) {
            store64(err_out, e);
            return 0;
        }
        # The path carries the step's own k', so that P k = k' runs unbroken along it.
        var after = TraceHit_ray_after(hit);
        var ad = TraceRay_dir(after);
        RayVec3_set_x(ad, PrtStep_kx(step));
        RayVec3_set_y(ad, PrtStep_ky(step));
        RayVec3_set_z(ad, PrtStep_kz(step));
        if (mirror != 0) { TraceHit_set_reflectance(hit, PrtStep_reflectance(step)); }
        var ph = _prt_hit_new(hit);
        if (ph == 0) {
            store64(err_out, PK_ERR_ALLOCATION);
            return 0;
        }
        for (var m = 0; m < 18; m = m + 1) {
            store64(PrtTraceHit_surface_p(ph) + m * 8, load64(PrtStep_p(step) + m * 8));
        }
        var _p = prt_multiply(PrtStep_p(step), acc_p, acc_p);
        _p = prt_multiply(PrtStep_q(step), acc_q, acc_q);
        for (var c = 0; c < 18; c = c + 1) {
            store64(PrtTraceHit_total_p(ph) + c * 8, load64(acc_p + c * 8));
            store64(PrtTraceHit_total_q(ph) + c * 8, load64(acc_q + c * 8));
        }
        flux = f64_mul(flux, PrtStep_flux(step));
        PrtTraceHit_set_flux(ph, flux);
        vec_push(results, ph);
        current = after;
        i = i + 1;
    }
    return results;
}

# Fraction of the power of a field e, transverse to the path's first direction k_in, that
# reaches this hit: flux |P e|^2/|e|^2. NaN for a null handle, a zero or non-finite field, or
# a field with a component along k_in, which no plane wave has.
#must_use
fn prt_transmittance(hit, k_in, e) {
    if ((hit == 0) | (e == 0)) { return _PRK_NAN; }
    if (_prt_unit_ok(k_in) == 0) { return _PRK_NAN; }
    var e2 = 0;
    var dr = 0;
    var di = 0;
    for (var i = 0; i < 3; i = i + 1) {
        var r = load64(e + i * 16);
        var m = load64(e + i * 16 + 8);
        e2 = f64_add(e2, f64_add(f64_mul(r, r), f64_mul(m, m)));
        dr = f64_add(dr, f64_mul(r, load64(k_in + i * 8)));
        di = f64_add(di, f64_mul(m, load64(k_in + i * 8)));
    }
    if ((f64_gt(e2, 0) & f64_lt(e2, _PRK_INF)) == 0) { return _PRK_NAN; }
    var along = f64_add(f64_mul(dr, dr), f64_mul(di, di));
    if (f64_gt(along, f64_mul(e2, 0x3BB0000000000000)) == 1) { return _PRK_NAN; }    # 2^-68
    var o[48];
    var _a = prt_apply(PrtTraceHit_total_p(hit), e, &o);
    var o2 = 0;
    for (var n = 0; n < 6; n = n + 1) {
        o2 = f64_add(o2, f64_mul(load64(&o + n * 8), load64(&o + n * 8)));
    }
    return f64_mul(PrtTraceHit_flux(hit), f64_div(o2, e2));
}

# The 2x2 Jones matrix of a path, in the input frame: J = [u v]^T Q^T P [u v], for the right-
# handed transverse pair (u, v) that _prt_transverse builds on k_in. Geometry is gone: for a
# nonpolarizing path J is a phase times the identity (-1 for one ideal mirror). Writes j00,
# j01, j10, j11 as (re, im) pairs, 64 bytes, to out, which may be p or q. Returns PK_ERR_NONE,
# or PK_ERR_INVALID_PARAMETER for a null handle or non-unit k_in.
fn prt_jones(p, q, k_in, out) {
    if ((p == 0) | (q == 0) | (out == 0)) { return PK_ERR_INVALID_PARAMETER; }
    if (_prt_unit_ok(k_in) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var u[24];
    var v[24];
    var t[64];
    var _c = _prt_transverse(k_in, &u);
    _c = _prt_cross(k_in, &u, &v);
    for (var col = 0; col < 2; col = col + 1) {
        var a = &u;
        if (col == 1) { a = &v; }
        # P a, then Q^T of it: Q is real.
        var pa[48];
        for (var i = 0; i < 3; i = i + 1) {
            var re = 0;
            var im = 0;
            for (var j = 0; j < 3; j = j + 1) {
                var av = load64(a + j * 8);
                re = f64_add(re, f64_mul(load64(p + (i * 3 + j) * 8), av));
                im = f64_add(im, f64_mul(load64(p + 72 + (i * 3 + j) * 8), av));
            }
            store64(&pa + i * 16, re);
            store64(&pa + i * 16 + 8, im);
        }
        for (var row = 0; row < 2; row = row + 1) {
            var b = &u;
            if (row == 1) { b = &v; }
            var jr = 0;
            var ji = 0;
            for (var x = 0; x < 3; x = x + 1) {
                # (Q b)_x: b^T Q^T (P a) = (Q b).(P a).
                var w = 0;
                for (var y = 0; y < 3; y = y + 1) {
                    w = f64_add(w, f64_mul(load64(b + y * 8), load64(q + (x * 3 + y) * 8)));
                }
                jr = f64_add(jr, f64_mul(w, load64(&pa + x * 16)));
                ji = f64_add(ji, f64_mul(w, load64(&pa + x * 16 + 8)));
            }
            store64(&t + (row * 2 + col) * 16, jr);
            store64(&t + (row * 2 + col) * 16 + 8, ji);
        }
    }
    for (var n = 0; n < 8; n = n + 1) { store64(out + n * 8, load64(&t + n * 8)); }
    return PK_ERR_NONE;
}

# prt_jones, divided by its largest component m, written to m_out. S below is fourth order in
# the amplitudes, which overflow or vanish long before P does, and neither D nor retardance
# depends on scale: at 1e80 an overflow read 1.5708 rad on a path with no retardance at all.
# Returns PK_ERR_NONE, or PK_ERR_INVALID_PARAMETER for a bad handle, or a J that is all zero
# or not finite.
fn _prt_jones_scaled(p, q, k_in, j, m_out) {
    var e = prt_jones(p, q, k_in, j);
    if (e != PK_ERR_NONE) { return e; }
    var m = 0;
    for (var i = 0; i < 8; i = i + 1) {
        var a = load64(j + i * 8) & _PRK_ABS;
        if (a >= _PRK_INF) { return PK_ERR_INVALID_PARAMETER; }
        if (f64_gt(a, m) == 1) { m = a; }
    }
    if (f64_gt(m, 0) == 0) { return PK_ERR_INVALID_PARAMETER; }
    for (var n = 0; n < 8; n = n + 1) { store64(j + n * 8, f64_div(load64(j + n * 8), m)); }
    store64(m_out, m);
    return PK_ERR_NONE;
}

# S = J^H J for a prt_jones matrix: s[0] = S00, s[1] = S11, (s[2], s[3]) = S01.
fn _prt_jhj(j, s) {
    var a2 = f64_add(f64_mul(load64(j), load64(j)), f64_mul(load64(j + 8), load64(j + 8)));
    var b2 = f64_add(f64_mul(load64(j + 16), load64(j + 16)), f64_mul(load64(j + 24), load64(j + 24)));
    var c2 = f64_add(f64_mul(load64(j + 32), load64(j + 32)), f64_mul(load64(j + 40), load64(j + 40)));
    var d2 = f64_add(f64_mul(load64(j + 48), load64(j + 48)), f64_mul(load64(j + 56), load64(j + 56)));
    store64(s, f64_add(a2, c2));
    store64(s + 8, f64_add(b2, d2));
    store64(s + 16, f64_add(
        f64_add(f64_mul(load64(j), load64(j + 16)), f64_mul(load64(j + 8), load64(j + 24))),
        f64_add(f64_mul(load64(j + 32), load64(j + 48)), f64_mul(load64(j + 40), load64(j + 56)))));
    store64(s + 24, f64_add(
        f64_sub(f64_mul(load64(j), load64(j + 24)), f64_mul(load64(j + 8), load64(j + 16))),
        f64_sub(f64_mul(load64(j + 32), load64(j + 56)), f64_mul(load64(j + 40), load64(j + 48)))));
    return 0;
}

# Diattenuation of a path: (L1^2 - L2^2)/(L1^2 + L2^2), L1 >= L2 the singular values of its
# Jones matrix, so 0 for no polarization dependence and 1 for a perfect polarizer. It is
# (T_max - T_min)/(T_max + T_min) over all input states. NaN for a null handle, a non-unit
# k_in, a J that is not finite, or a path that passes nothing: |J|^2 under 2^-80, where only
# rounding is left.
#must_use
fn prt_diattenuation(p, q, k_in) {
    var j[64];
    var m = 0;
    if (_prt_jones_scaled(p, q, k_in, &j, &m) != PK_ERR_NONE) { return _PRK_NAN; }
    var s[32];
    var _c = _prt_jhj(&j, &s);
    var tr = f64_add(load64(&s), load64(&s + 8));
    if (f64_gt(f64_mul(f64_mul(tr, m), m), _PRT_NOTHING) == 0) { return _PRK_NAN; }
    # The eigenvalues of S differ by sqrt((S00 - S11)^2 + 4|S01|^2), read off directly so that
    # a D near 0 is not the square root of a rounding error.
    var ds = f64_sub(load64(&s), load64(&s + 8));
    var o2 = f64_add(f64_mul(load64(&s + 16), load64(&s + 16)), f64_mul(load64(&s + 24), load64(&s + 24)));
    var d = f64_div(f64_sqrt(f64_add(f64_mul(ds, ds), f64_mul(f64_from(4), o2))), tr);
    if (f64_gt(d, F64_ONE) == 1) { return F64_ONE; }
    return d;
}

# Retardance of a path, in radians in [0, pi]: the phase between the eigenstates of the unitary
# part U of J = U H, H = sqrt(J^H J). 0 for a nonpolarizing path. See the module header for
# what it means on a reflection. NaN for a null handle, a non-unit k_in, a J that is not
# finite, or one whose smaller singular value is under about 2^-40: U is not defined at 0,
# and below that it is rounding. A long lossy path can get there: 200 bounces in a gold guide
# reach 1.3e-13, and NaN is right, the true value being unreadable a few dozen bounces on.
#must_use
fn prt_retardance(p, q, k_in) {
    var j[64];
    var m = 0;
    if (_prt_jones_scaled(p, q, k_in, &j, &m) != PK_ERR_NONE) { return _PRK_NAN; }
    var s[32];
    var _c = _prt_jhj(&j, &s);
    var j00r = load64(&j);
    var j00i = load64(&j + 8);
    var j01r = load64(&j + 16);
    var j01i = load64(&j + 24);
    var j10r = load64(&j + 32);
    var j10i = load64(&j + 40);
    var j11r = load64(&j + 48);
    var j11i = load64(&j + 56);
    var dr = f64_sub(f64_sub(f64_mul(j00r, j11r), f64_mul(j00i, j11i)), f64_sub(f64_mul(j01r, j10r),
        f64_mul(j01i, j10i)));
    var di = f64_sub(f64_add(f64_mul(j00r, j11i), f64_mul(j00i, j11r)), f64_add(f64_mul(j01r, j10i),
        f64_mul(j01i, j10r)));
    var d = ganita_f64_hypot(dr, di);
    # d = L1 L2 and tr = L1^2 + L2^2, so d^2/tr is L2^2 to first order. The noise here is
    # absolute (see _PRT_NOTHING): a test relative to L1 let a zero L2 through at L1 = 1e-5,
    # as a retardance of 2.14 rad made from rounding.
    var tr = f64_add(load64(&s), load64(&s + 8));
    if (f64_gt(f64_mul(f64_mul(tr, m), m), _PRT_NOTHING) == 0) { return _PRK_NAN; }
    if (f64_gt(f64_mul(f64_mul(f64_div(f64_mul(d, d), tr), m), m), _PRT_NOTHING) == 0) { return _PRK_NAN; }
    # sqrt(S) = (S + d I)/tau by Cayley-Hamilton, so U = J adj(S + d I)/(d tau), and the
    # common scale drops out of the angle below. V = U (d tau).
    var a00 = f64_add(load64(&s), d);
    var a11 = f64_add(load64(&s + 8), d);
    var or = load64(&s + 16);
    var oi = load64(&s + 24);
    # V00 = J00 a11 - J01 conj(S01),  V01 = J01 a00 - J00 S01
    var v00r = f64_sub(f64_mul(j00r, a11), f64_add(f64_mul(j01r, or), f64_mul(j01i, oi)));
    var v00i = f64_sub(f64_mul(j00i, a11), f64_sub(f64_mul(j01i, or), f64_mul(j01r, oi)));
    var v01r = f64_sub(f64_mul(j01r, a00), f64_sub(f64_mul(j00r, or), f64_mul(j00i, oi)));
    var v01i = f64_sub(f64_mul(j01i, a00), f64_add(f64_mul(j00r, oi), f64_mul(j00i, or)));
    # V10 = J10 a11 - J11 conj(S01),  V11 = J11 a00 - J10 S01
    var v10r = f64_sub(f64_mul(j10r, a11), f64_add(f64_mul(j11r, or), f64_mul(j11i, oi)));
    var v10i = f64_sub(f64_mul(j10i, a11), f64_sub(f64_mul(j11i, or), f64_mul(j11r, oi)));
    var v11r = f64_sub(f64_mul(j11r, a00), f64_sub(f64_mul(j10r, or), f64_mul(j10i, oi)));
    var v11i = f64_sub(f64_mul(j11i, a00), f64_add(f64_mul(j10r, oi), f64_mul(j10i, or)));
    # U = e^(i phi)(cos(d/2) I + i sin(d/2) n.sigma): |tr U|^2/4 = cos^2(d/2), and the
    # traceless part has |.|_F^2/2 = sin^2(d/2). atan2 keeps both ends of [0, pi] accurate,
    # where an acos of the trace would lose half the digits near 0.
    var tr_r = f64_add(v00r, v11r);
    var tr_i = f64_add(v00i, v11i);
    var cos2 = f64_mul(0x3FD0000000000000, f64_add(f64_mul(tr_r, tr_r), f64_mul(tr_i, tr_i)));
    var hr = f64_sub(v00r, v11r);
    var hi = f64_sub(v00i, v11i);
    var sin2 = f64_mul(F64_HALF, f64_add(
        f64_mul(F64_HALF, f64_add(f64_mul(hr, hr), f64_mul(hi, hi))),
        f64_add(f64_add(f64_mul(v01r, v01r), f64_mul(v01i, v01i)), f64_add(f64_mul(v10r, v10r), f64_mul(v10i, v10i)))));
    return f64_mul(F64_TWO, ganita_f64_atan2(f64_sqrt(sin2), f64_sqrt(cos2)));
}

# --- ray_simulate.cyr ---

# ray_simulate.cyr -- recursive ray tracing, ray fans, spot diagrams, OPD
# Usage: include "lib/ray_simulate.cyr"
#   (requires error.cyr, ray_core.cyr, ray_fresnel.cyr, ray_trace.cyr)
#
# Ported from the Rust `ray/simulate.rs`. The TraceEvent enum
# (Refraction{reflectance,surface_idx} | Reflection{surface_idx} | Escaped |
# Terminated) is flattened into TraceSegment as event_tag + reflectance +
# surface_idx. Vectors use the stdlib `vec`.

var EVENT_REFRACTION = 0;
var EVENT_REFLECTION = 1;
var EVENT_ESCAPED = 2;
var EVENT_TERMINATED = 3;

# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _sim_eps15() { return 0x3CD203AF9EE75616; }

# Euclidean distance between two RayVec3 points.
fn _sim_dist(a, b) {
    var dx = f64_sub(RayVec3_x(b), RayVec3_x(a));
    var dy = f64_sub(RayVec3_y(b), RayVec3_y(a));
    var dz = f64_sub(RayVec3_z(b), RayVec3_z(a));
    return f64_sqrt(f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz)));
}

# ── Recursive ray tracing ────────

# A segment of a recursively traced path. origin/direction are RayVec3. event_tag
# is EVENT_*; reflectance/surface_idx are meaningful for Refraction/Reflection.
#derive(accessors)
struct TraceSegment {
    origin; direction; n; path_length; optical_path; energy; depth; event_tag; reflectance; surface_idx;
}

fn _seg_new(origin, direction, n, path_length, optical_path, energy, depth, event_tag, reflectance, surface_idx) {
    var s = alloc(sizeof(TraceSegment));
    if (s == 0) { return 0; }
    TraceSegment_set_origin(s, origin);
    TraceSegment_set_direction(s, direction);
    TraceSegment_set_n(s, n);
    TraceSegment_set_path_length(s, path_length);
    TraceSegment_set_optical_path(s, optical_path);
    TraceSegment_set_energy(s, energy);
    TraceSegment_set_depth(s, depth);
    TraceSegment_set_event_tag(s, event_tag);
    TraceSegment_set_reflectance(s, reflectance);
    TraceSegment_set_surface_idx(s, surface_idx);
    return s;
}

# Recursive-trace configuration: max_depth (int), min_energy (f64).
#derive(accessors)
struct TraceConfig { max_depth; min_energy; }

# TraceConfig with a bounce limit and a minimum ray energy; 0 on allocation failure.
#must_use
fn trace_config_new(max_depth, min_energy) {
    var c = alloc(sizeof(TraceConfig));
    if (c == 0) { return 0; }
    TraceConfig_set_max_depth(c, max_depth);
    TraceConfig_set_min_energy(c, min_energy);
    return c;
}

# Defaults: max_depth = 8, min_energy = 0.001.
#must_use
fn trace_config_default() {
    return trace_config_new(8, f64_div(F64_ONE, f64_from(1000)));
}

# Flat list of all traced segments (depth-first) plus interaction count.
#derive(accessors)
struct TraceTree { segments; interactions; }

# Trace a ray recursively, following refracted + reflected paths at each surface. The surfaces
# are a sequential system in order along +z: surface i separates the medium before it (surface
# i-1's n_after, or the starting ray's index for i = 0) from its own n_after, so a ray crossing
# it toward -z passes into the medium before it. 0 for a null ray, surfaces or config, or on
# allocation failure.
# ⛔ 2.15.1: every crossing went into n_after, whichever way the ray travelled. A ray reflected
# inside a glass slab crossed its front face back into the GLASS, with R = 0 (glass to glass), and
# escaped at n = 1.5; the slab's back-and-forth series never formed. A null config SIGSEGVed.
#must_use
fn trace_recursive(ray, surfaces, config) {
    _prk_trace("trace_recursive");
    if (ray == 0) { return 0; }
    if (surfaces == 0) { return 0; }
    if (config == 0) { return 0; }
    var segments = vec_new();
    if (segments == 0) { return 0; }
    var interactions = 0;
    _trace_recursive_inner(ray, surfaces, config, F64_ONE, 0, segments, &interactions, TraceRay_n(ray));
    var tree = alloc(sizeof(TraceTree));
    if (tree == 0) { return 0; }
    TraceTree_set_segments(tree, segments);
    TraceTree_set_interactions(tree, interactions);
    return tree;
}

# The medium in front of surface i: surface i-1's n_after, or n0 (the starting ray's) for i = 0.
#must_use
fn _trace_n_before(surfaces, i, n0) {
    if (i == 0) { return n0; }
    return OpticalSurface_n_after(vec_get(surfaces, i - 1));
}

fn _trace_recursive_inner(ray, surfaces, config, energy, depth, segments, inter_ptr, n0) {
    if (depth >= TraceConfig_max_depth(config)) {
        vec_push(segments, _seg_new(TraceRay_pos(ray), TraceRay_dir(ray), TraceRay_n(ray),
            f64_from(0), f64_from(0), energy, depth, EVENT_TERMINATED, f64_from(0), 0));
        return 0;
    }
    if (f64_lt(energy, TraceConfig_min_energy(config)) == 1) {
        vec_push(segments, _seg_new(TraceRay_pos(ray), TraceRay_dir(ray), TraceRay_n(ray),
            f64_from(0), f64_from(0), energy, depth, EVENT_TERMINATED, f64_from(0), 0));
        return 0;
    }

    # Find the nearest surface hit.
    var best_idx = (0 - 1);
    var best_dist = f64_from(0);
    var best_hit = 0;
    var count = vec_len(surfaces);
    # Travelling toward -z, a crossing leads into the medium in front of the surface: test each
    # surface as a copy whose n_after is that medium. trace_surface reads the surface only while
    # it runs, so a stack copy is enough.
    var backward = f64_lt(RayVec3_z(TraceRay_dir(ray)), f64_from(0));
    var flip[40];
    var i = 0;
    while (i < count) {
        var e = 0;
        var surf = vec_get(surfaces, i);
        if (backward == 1) {
            for (var w = 0; w < 40; w = w + 8) { store64(&flip + w, load64(surf + w)); }
            OpticalSurface_set_n_after(&flip, _trace_n_before(surfaces, i, n0));
            surf = &flip;
        }
        var hit = trace_surface(ray, surf, &e);
        # ⚠ 2.2.8: PK_ERR_TIR is a HIT, not a miss. This filter lumped it in
        # with a geometric miss and an aperture rejection, so a totally-
        # internally-reflecting surface was removed from the nearest-surface
        # search entirely and the ray passed through it unreflected. TIR now
        # yields a TraceHit with reflectance = 1.0 and ray_after = 0, so the
        # transmittance below is 0 and only the EVENT_REFLECTION branch fires —
        # which is exactly the physics.
        if (hit != 0) {
            var dist = _sim_dist(TraceRay_pos(ray), TraceHit_hit_point(hit));
            if (best_idx < 0) {
                best_idx = i;
                best_dist = dist;
                best_hit = hit;
            } elif (f64_lt(dist, best_dist) == 1) {
                best_idx = i;
                best_dist = dist;
                best_hit = hit;
            }
        }
        i = i + 1;
    }

    if (best_idx < 0) {
        vec_push(segments, _seg_new(TraceRay_pos(ray), TraceRay_dir(ray), TraceRay_n(ray),
            f64_from(0), f64_from(0), energy, depth, EVENT_ESCAPED, f64_from(0), 0));
        return 0;
    }

    store64(inter_ptr, load64(inter_ptr) + 1);
    var path_len = best_dist;
    var optical_path = f64_mul(TraceRay_n(ray), path_len);
    var reflectance = TraceHit_reflectance(best_hit);
    var transmittance = f64_sub(F64_ONE, reflectance);

    vec_push(segments, _seg_new(TraceRay_pos(ray), TraceRay_dir(ray), TraceRay_n(ray),
        path_len, optical_path, f64_mul(energy, transmittance), depth, EVENT_REFRACTION, reflectance, best_idx));

    var refracted_energy = f64_mul(energy, transmittance);
    # `ray_after` is 0 under TIR — there is no transmitted ray. With a
    # min_energy of 0 the f64_ge below is true even at zero energy, so the null
    # check is load-bearing, not decorative.
    if (TraceHit_ray_after(best_hit) != 0) {
        if (f64_ge(refracted_energy, TraceConfig_min_energy(config)) == 1) {
            _trace_recursive_inner(TraceHit_ray_after(best_hit), surfaces, config,
              refracted_energy, depth + 1, segments, inter_ptr, n0);
        }
    }

    var reflected_energy = f64_mul(energy, reflectance);
    if (f64_ge(reflected_energy, TraceConfig_min_energy(config)) == 1) {
        var reflected_dir = ray_reflect_3d(TraceRay_dir(ray), TraceHit_normal(best_hit));
        var reflected_ray = trace_ray_new(TraceHit_hit_point(best_hit), reflected_dir, TraceRay_n(ray));
        vec_push(segments, _seg_new(TraceHit_hit_point(best_hit), reflected_dir, TraceRay_n(ray),
            f64_from(0), f64_from(0), reflected_energy, depth, EVENT_REFLECTION, f64_from(0), best_idx));
        _trace_recursive_inner(reflected_ray, surfaces, config,
          reflected_energy, depth + 1, segments, inter_ptr, n0);
    }
    return 0;
}

# ── Ray fan generators ────────

# A ray in a fan tagged with its normalized aperture height.
#derive(accessors)
struct FanRay { ray; aperture_height; }

fn _fan_ray(tr, aperture_height) {
    var fr = alloc(sizeof(FanRay));
    if (fr == 0) { return 0; }
    FanRay_set_ray(fr, tr);
    FanRay_set_aperture_height(fr, aperture_height);
    return fr;
}

# Normalized fan parameter t in [-1, 1] for ray i of num_rays (0 if single ray).
fn _fan_t(i, num_rays) {
    if (num_rays == 1) { return f64_from(0); }
    return f64_add(f64_neg(F64_ONE),
      f64_div(f64_mul(F64_TWO, f64_from(i)), f64_from(num_rays - 1)));
}

# Meridional ray fan (rays spread across y in the y-z plane).
#must_use
fn ray_fan_meridional(aperture_radius, num_rays, field_angle, start_z) {
    _prk_trace("ray_fan_meridional");
    var rays = vec_new();
    var sin_f = _prk_sin(field_angle);
    var cos_f = _prk_cos(field_angle);
    var i = 0;
    while (i < num_rays) {
        var t = _fan_t(i, num_rays);
        var tr = trace_ray_new(ray_vec3(f64_from(0), f64_mul(t, aperture_radius), start_z),
          ray_vec3(f64_from(0), sin_f, cos_f), F64_ONE);
        vec_push(rays, _fan_ray(tr, t));
        i = i + 1;
    }
    return rays;
}

# Sagittal ray fan: the same field as ray_fan_meridional (tilted in the y-z plane, so the two
# fans share their chief ray), with the rays spread across x, perpendicular to the meridional
# plane. ⛔ 2.15.1: this tilted the field into x-z as well, which made it the meridional fan
# turned 90 degrees, with that fan's aberrations: no sagittal fan at all.
#must_use
fn ray_fan_sagittal(aperture_radius, num_rays, field_angle, start_z) {
    _prk_trace("ray_fan_sagittal");
    var rays = vec_new();
    if (rays == 0) { return 0; }
    var sin_f = _prk_sin(field_angle);
    var cos_f = _prk_cos(field_angle);
    var i = 0;
    while (i < num_rays) {
        var t = _fan_t(i, num_rays);
        var tr = trace_ray_new(ray_vec3(f64_mul(t, aperture_radius), f64_from(0), start_z),
          ray_vec3(f64_from(0), sin_f, cos_f), F64_ONE);
        vec_push(rays, _fan_ray(tr, t));
        i = i + 1;
    }
    return rays;
}

# Radial ray bundle: a chief ray plus num_rings concentric rings of num_arms rays.
#must_use
fn ray_bundle(aperture_radius, num_rings, num_arms, field_angle, start_z) {
    _prk_trace("ray_bundle");
    var rays = vec_new();
    var sin_f = _prk_sin(field_angle);
    var cos_f = _prk_cos(field_angle);
    vec_push(rays, _fan_ray(
        trace_ray_new(ray_vec3(f64_from(0), f64_from(0), start_z),
          ray_vec3(f64_from(0), sin_f, cos_f), F64_ONE), f64_from(0)));
    var ring = 1;
    while (ring <= num_rings) {
        # Match Rust's left-associative order: (ap * ring) / num_rings.
        var r = f64_div(f64_mul(aperture_radius, f64_from(ring)), f64_from(num_rings));
        var t = f64_div(r, aperture_radius);
        var arm = 0;
        while (arm < num_arms) {
            # Match Rust's order: ((2*PI) * arm) / num_arms.
            var phi = f64_div(f64_mul(f64_mul(F64_TWO, F64_PI), f64_from(arm)), f64_from(num_arms));
            var x = f64_mul(r, _prk_cos(phi));
            var y = f64_mul(r, _prk_sin(phi));
            vec_push(rays, _fan_ray(
                trace_ray_new(ray_vec3(x, y, start_z),
                  ray_vec3(f64_from(0), sin_f, cos_f), F64_ONE), t));
            arm = arm + 1;
        }
        ring = ring + 1;
    }
    return rays;
}

# ── Spot diagram ────────

# A point where a ray crosses the image plane.
#derive(accessors)
struct SpotPoint { x; y; optical_path; aperture_height; }

# Trace a ray bundle through the surfaces and record image-plane crossings.
# Vignetted / parallel / behind rays are silently skipped.
#must_use
fn spot_diagram(surfaces, aperture_radius, num_rings, num_arms, field_angle, start_z, image_z) {
    _prk_trace("spot_diagram");
    if (surfaces == 0) { return 0; }
    var bundle = ray_bundle(aperture_radius, num_rings, num_arms, field_angle, start_z);
    var spots = vec_new();
    var count = vec_len(bundle);
    var i = 0;
    while (i < count) {
        var fan_ray = vec_get(bundle, i);
        var fr_ray = FanRay_ray(fan_ray);
        var e = 0;
        var hits = trace_sequential(fr_ray, surfaces, &e);
        if (prakash_is_err(e) == 0) {
            var nhits = vec_len(hits);
            var final_ray = fr_ray;
            if (nhits > 0) {
                final_ray = TraceHit_ray_after(vec_get(hits, nhits - 1));
            }
            var fdir = TraceRay_dir(final_ray);
            var fpos = TraceRay_pos(final_ray);
            var dz = RayVec3_z(fdir);
            if (f64_ge(f64_abs(dz), _sim_eps15()) == 1) {
                var t = f64_div(f64_sub(image_z, RayVec3_z(fpos)), dz);
                if (f64_ge(t, f64_from(0)) == 1) {
                    var img_x = f64_add(RayVec3_x(fpos), f64_mul(t, RayVec3_x(fdir)));
                    var img_y = f64_add(RayVec3_y(fpos), f64_mul(t, RayVec3_y(fdir)));
                    var opl = f64_from(0);
                    var prev_pos = TraceRay_pos(fr_ray);
                    var prev_n = TraceRay_n(fr_ray);
                    var j = 0;
                    while (j < nhits) {
                        var hit = vec_get(hits, j);
                        opl = f64_add(opl, f64_mul(prev_n, _sim_dist(prev_pos, TraceHit_hit_point(hit))));
                        prev_pos = TraceHit_hit_point(hit);
                        prev_n = TraceRay_n(TraceHit_ray_after(hit));
                        j = j + 1;
                    }
                    var img_pt = ray_vec3(img_x, img_y, image_z);
                    opl = f64_add(opl, f64_mul(prev_n, _sim_dist(prev_pos, img_pt)));
                    var sp = alloc(sizeof(SpotPoint));
                    if (sp == 0) { return 0; }
                    SpotPoint_set_x(sp, img_x);
                    SpotPoint_set_y(sp, img_y);
                    SpotPoint_set_optical_path(sp, opl);
                    SpotPoint_set_aperture_height(sp, FanRay_aperture_height(fan_ray));
                    vec_push(spots, sp);
                }
            }
        }
        i = i + 1;
    }
    return spots;
}

# RMS distance of spot points from their centroid. NaN for a null or empty vec: no spots have no
# RMS (2.15.1: 0.0, a perfect focus, for a diagram where every ray missed).
#must_use
fn spot_rms_radius(spots) {
    if (spots == 0) { return _PRK_NAN; }
    var n = vec_len(spots);
    if (n == 0) { return _PRK_NAN; }
    var nf = f64_from(n);
    var sx = f64_from(0);
    var sy = f64_from(0);
    var i = 0;
    while (i < n) {
        var s = vec_get(spots, i);
        sx = f64_add(sx, SpotPoint_x(s));
        sy = f64_add(sy, SpotPoint_y(s));
        i = i + 1;
    }
    var cx = f64_div(sx, nf);
    var cy = f64_div(sy, nf);
    var sum_r2 = f64_from(0);
    i = 0;
    while (i < n) {
        var s = vec_get(spots, i);
        var ddx = f64_sub(SpotPoint_x(s), cx);
        var ddy = f64_sub(SpotPoint_y(s), cy);
        sum_r2 = f64_add(sum_r2, f64_add(f64_mul(ddx, ddx), f64_mul(ddy, ddy)));
        i = i + 1;
    }
    return f64_sqrt(f64_div(sum_r2, nf));
}

# ── Optical path difference ────────

# Optical path length of a ray through the system to image_z (n * distance,
# summed). Writes the error code to err_out (0 on error return). The last leg is signed: a plane
# behind the final ray (a virtual image) subtracts n' times the distance back to it, the sign the
# OPD functions give it. PK_ERR_INVALID_PARAMETER if the final ray runs parallel to the plane.
# ⛔ 2.15.1: a plane behind the final ray, or one it never reaches, dropped the last leg without
# a word and returned the path to the last surface.
#must_use
fn optical_path_length(ray, surfaces, image_z, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (ray == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var e = 0;
    var hits = trace_sequential(ray, surfaces, &e);
    if (prakash_is_err(e) == 1) {
        store64(err_out, e);
        return f64_from(0);
    }
    var opl = f64_from(0);
    var prev_pos = TraceRay_pos(ray);
    var prev_n = TraceRay_n(ray);
    var nhits = vec_len(hits);
    var i = 0;
    while (i < nhits) {
        var hit = vec_get(hits, i);
        opl = f64_add(opl, f64_mul(prev_n, _sim_dist(prev_pos, TraceHit_hit_point(hit))));
        prev_pos = TraceHit_hit_point(hit);
        prev_n = TraceRay_n(TraceHit_ray_after(hit));
        i = i + 1;
    }
    var final_ray = ray;
    if (nhits > 0) {
        final_ray = TraceHit_ray_after(vec_get(hits, nhits - 1));
    }
    var fdir = TraceRay_dir(final_ray);
    var fpos = TraceRay_pos(final_ray);
    var dz = RayVec3_z(fdir);
    if (f64_gt(f64_abs(dz), _sim_eps15()) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return f64_from(0);
    }
    var t = f64_div(f64_sub(image_z, RayVec3_z(fpos)), dz);
    var ex = f64_sub(f64_add(RayVec3_x(fpos), f64_mul(t, RayVec3_x(fdir))), RayVec3_x(prev_pos));
    var ey = f64_sub(f64_add(RayVec3_y(fpos), f64_mul(t, RayVec3_y(fdir))), RayVec3_y(prev_pos));
    var ez = f64_sub(image_z, RayVec3_z(prev_pos));
    var leg = f64_mul(prev_n, f64_sqrt(f64_add(f64_add(f64_mul(ex, ex), f64_mul(ey, ey)), f64_mul(ez, ez))));
    if (f64_lt(t, f64_from(0)) == 1) { leg = f64_neg(leg); }
    return f64_add(opl, leg);
}

# ── Wavefront reference ────────
# ⛔ 2.5.0: optical_path_difference and opd_fan subtracted two optical_path_length
# values, each ending where ITS OWN ray crosses image_z. Those are different
# points, and a wavefront aberration is only defined against a COMMON one. The
# extra path from a ray's own intercept to the reference point is first order in
# its transverse aberration and does not cancel: it subtracts h * dW/dh from W,
# which for spherical aberration (W ~ h^4) is 4W — so both functions returned -3x
# the true wavefront aberration, sign flipped. Measured on an equiconvex singlet
# (R = 100, t = 1, n = 1.5, image plane at paraxial focus): -3.001 / -3.004 /
# -3.009 / -3.016 at h = 1..4, against a separately coded path-to-common-point
# harness that agrees with Welford's -h^4 B / (32 f^3) to 0.5%. Every ray now
# ends at P, the chief ray's intercept with image_z:
#   W = [OPL to the last surface + n' |Q - P|] - [chief OPL to P]
# signed negative when the final ray travels away from P (a virtual image). The
# segment Q -> P is not the ray's own path; the difference is second order in
# the ray's angular deviation from QP, far below W at any aperture where
# third-order aberration theory means anything. optical_path_length itself is
# unchanged: it is a correct path length to a plane, just not an OPD.

# Traces `ray` and returns its optical path to the last surface it hits, storing
# the ray leaving that surface (or `ray` itself for an empty system) at fr_out.
# 0 with err_out set when the trace fails.
fn _sim_opl_to_last(ray, surfaces, fr_out, err_out) {
    store64(err_out, PK_ERR_NONE);
    store64(fr_out, ray);
    var e = 0;
    var hits = trace_sequential(ray, surfaces, &e);
    if (prakash_is_err(e) == 1) {
        store64(err_out, e);
        return f64_from(0);
    }
    var opl = f64_from(0);
    var prev_pos = TraceRay_pos(ray);
    var prev_n = TraceRay_n(ray);
    var nhits = vec_len(hits);
    var i = 0;
    while (i < nhits) {
        var hit = vec_get(hits, i);
        opl = f64_add(opl, f64_mul(prev_n, _sim_dist(prev_pos, TraceHit_hit_point(hit))));
        prev_pos = TraceHit_hit_point(hit);
        prev_n = TraceRay_n(TraceHit_ray_after(hit));
        i = i + 1;
    }
    if (nhits > 0) {
        store64(fr_out, TraceHit_ray_after(vec_get(hits, nhits - 1)));
    }
    return opl;
}

# n' times the distance from the final ray's origin to (px, py, pz), negative
# when the ray travels away from that point.
fn _sim_leg_to_point(fr, px, py, pz) {
    var q = TraceRay_pos(fr);
    var d = TraceRay_dir(fr);
    var dx = f64_sub(px, RayVec3_x(q));
    var dy = f64_sub(py, RayVec3_y(q));
    var dz = f64_sub(pz, RayVec3_z(q));
    var len = f64_sqrt(f64_add(f64_add(f64_mul(dx, dx), f64_mul(dy, dy)), f64_mul(dz, dz)));
    var along = f64_add(f64_add(f64_mul(dx, RayVec3_x(d)), f64_mul(dy, RayVec3_y(d))),
      f64_mul(dz, RayVec3_z(d)));
    if (f64_lt(along, f64_from(0)) == 1) { len = f64_neg(len); }
    return f64_mul(TraceRay_n(fr), len);
}

# The chief ray's optical path to its own intercept P with the plane image_z;
# P's x and y go to px_out / py_out. PK_ERR_INVALID_PARAMETER when the chief
# ray leaves the system parallel to that plane and so never meets it.
fn _sim_chief_ref(chief_ray, surfaces, image_z, px_out, py_out, err_out) {
    var fr = 0;
    var e = 0;
    var opl = _sim_opl_to_last(chief_ray, surfaces, &fr, &e);
    if (prakash_is_err(e) == 1) {
        store64(err_out, e);
        return f64_from(0);
    }
    var q = TraceRay_pos(fr);
    var d = TraceRay_dir(fr);
    if (f64_gt(f64_abs(RayVec3_z(d)), _sim_eps15()) == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return f64_from(0);
    }
    var t = f64_div(f64_sub(image_z, RayVec3_z(q)), RayVec3_z(d));
    store64(px_out, f64_add(RayVec3_x(q), f64_mul(t, RayVec3_x(d))));
    store64(py_out, f64_add(RayVec3_y(q), f64_mul(t, RayVec3_y(d))));
    store64(err_out, PK_ERR_NONE);
    return f64_add(opl, _sim_leg_to_point(fr, load64(px_out), load64(py_out), image_z));
}

# Wavefront aberration of `ray` relative to `chief_ray` at the plane image_z:
# both paths end at the chief ray's image-plane intercept (see the 2.5.0 note
# above). Negative at the paraxial focus of an undercorrected singlet. Writes
# err to err_out.
#must_use
fn optical_path_difference(ray, chief_ray, surfaces, image_z, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (ray == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (chief_ray == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var px = 0;
    var py = 0;
    var e2 = 0;
    var opl_chief = _sim_chief_ref(chief_ray, surfaces, image_z, &px, &py, &e2);
    if (prakash_is_err(e2) == 1) {
        store64(err_out, e2);
        return f64_from(0);
    }
    var fr = 0;
    var e1 = 0;
    var opl_ray = _sim_opl_to_last(ray, surfaces, &fr, &e1);
    if (prakash_is_err(e1) == 1) {
        store64(err_out, e1);
        return f64_from(0);
    }
    return f64_sub(f64_add(opl_ray, _sim_leg_to_point(fr, px, py, image_z)), opl_chief);
}

# An (aperture_height, opd) pair for opd_fan results. `height` is the fan's
# NORMALISED pupil coordinate (-1..1), not a length; `opd` is in lens units.
#derive(accessors)
struct OpdPoint { height; opd; }

# Wavefront aberration for each ray in a fan, relative to the chief ray (min
# |aperture_height|) and referenced to that ray's image-plane intercept, as
# optical_path_difference. Returns a `vec` of OpdPoint; vignetted rays are
# excluded, empty on failure. Give an odd ray count so the fan contains its
# chief ray exactly (ray_fan_meridional puts t = 0 in the middle).
#must_use
fn opd_fan(fan, surfaces, image_z) {
    _prk_trace("opd_fan");
    if (fan == 0) { return 0; }
    var result = vec_new();
    var count = vec_len(fan);
    if (count == 0) {
        return result;
    }
    var chief_idx = 0;
    var best_abs = f64_abs(FanRay_aperture_height(vec_get(fan, 0)));
    var i = 1;
    while (i < count) {
        var h = f64_abs(FanRay_aperture_height(vec_get(fan, i)));
        if (f64_lt(h, best_abs) == 1) {
            best_abs = h;
            chief_idx = i;
        }
        i = i + 1;
    }
    var px = 0;
    var py = 0;
    var ec = 0;
    var opl_chief = _sim_chief_ref(FanRay_ray(vec_get(fan, chief_idx)), surfaces, image_z,
      &px, &py, &ec);
    if (prakash_is_err(ec) == 1) {
        return result;
    }
    i = 0;
    while (i < count) {
        var fr = vec_get(fan, i);
        var last = 0;
        var e = 0;
        var opl = _sim_opl_to_last(FanRay_ray(fr), surfaces, &last, &e);
        if (prakash_is_err(e) == 0) {
            var op = alloc(sizeof(OpdPoint));
            if (op == 0) { return 0; }
            OpdPoint_set_height(op, FanRay_aperture_height(fr));
            OpdPoint_set_opd(op,
              f64_sub(f64_add(opl, _sim_leg_to_point(last, px, py, image_z)), opl_chief));
            vec_push(result, op);
        }
        i = i + 1;
    }
    return result;
}

# --- ray_system.cyr ---

# ray_system.cyr -- optical bench: paraxial trace, prescriptions, cardinal points
# Usage: include "lib/ray_system.cyr"
#   (requires error.cyr, ray_core.cyr, ray_fresnel.cyr, ray_trace.cyr)
#
# Ported from the Rust `ray/system.rs`. `f64::INFINITY` (flat surface radius) is
# the bit pattern 0x7FF0000000000000; is_infinite is detected via f64_abs. The
# `(power, reduced_thickness)` tuple becomes a ParaxSurf struct; String names are
# cstr pointers (compared with streq). Vectors use the stdlib `vec`.

# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _sys_eps15() { return 0x3CD203AF9EE75616; }

# Positive-infinity bit pattern (flat-surface radius).
fn _sys_inf() { return 0x7FF0000000000000; }

# 1 if x is +inf or -inf (f64_abs clears the sign bit).
fn _sys_is_inf(x) {
    if (f64_abs(x) == 0x7FF0000000000000) { return 1; }
    return 0;
}

# ── Paraxial ray trace (y-nu method) ────────

# Paraxial ray: height y and optical direction cosine nu = n*u.
#derive(accessors)
struct ParaxialRay { y; nu; }

# ParaxialRay at height y with reduced slope nu = n*u; 0 on allocation failure.
#must_use
fn paraxial_ray_new(y, nu) {
    var r = alloc(sizeof(ParaxialRay));
    if (r == 0) { return 0; }
    ParaxialRay_set_y(r, y);
    ParaxialRay_set_nu(r, nu);
    return r;
}

# Marginal ray: enters at the aperture edge, parallel to the axis (nu = 0).
#must_use
fn paraxial_marginal(aperture_height) {
    return paraxial_ray_new(aperture_height, f64_from(0));
}

# Chief ray: enters on-axis from a field point at angle field_angle in medium n.
#must_use
fn paraxial_chief(field_angle, n) {
    return paraxial_ray_new(f64_from(0), f64_mul(n, field_angle));
}

# Refract a paraxial ray at a surface of power phi: nu' = nu - y*phi.
#must_use
fn paraxial_refract(ray, power) {
    if (ray == 0) { return 0; }
    return paraxial_ray_new(ParaxialRay_y(ray),
      f64_sub(ParaxialRay_nu(ray), f64_mul(ParaxialRay_y(ray), power)));
}

# Transfer a paraxial ray across a reduced thickness t/n: y' = y + (t/n)*nu.
#must_use
fn paraxial_transfer(ray, reduced_thickness) {
    if (ray == 0) { return 0; }
    return paraxial_ray_new(
      f64_add(ParaxialRay_y(ray), f64_mul(reduced_thickness, ParaxialRay_nu(ray))),
      ParaxialRay_nu(ray));
}

# A (power, reduced_thickness) paraxial surface parameter pair.
#derive(accessors)
struct ParaxSurf { power; reduced_t; }

# ParaxSurf {power, reduced_t = thickness/n to the next surface}; 0 on allocation failure.
#must_use
fn paraxsurf_new(power, reduced_t) {
    var p = alloc(sizeof(ParaxSurf));
    if (p == 0) { return 0; }
    ParaxSurf_set_power(p, power);
    ParaxSurf_set_reduced_t(p, reduced_t);
    return p;
}

# Trace a paraxial ray through a `vec` of ParaxSurf. Returns a `vec` of the ray
# state after each surface (including the input state). Last thickness ignored.
#must_use
fn paraxial_trace(ray, surfaces) {
    _prk_trace("paraxial_trace");
    if (ray == 0) { return 0; }
    if (surfaces == 0) { return 0; }
    var states = vec_new();
    var current = ray;
    vec_push(states, current);
    var count = vec_len(surfaces);
    var i = 0;
    while (i < count) {
        var ps = vec_get(surfaces, i);
        current = paraxial_refract(current, ParaxSurf_power(ps));
        vec_push(states, current);
        if (i < count - 1) {
            current = paraxial_transfer(current, ParaxSurf_reduced_t(ps));
        }
        i = i + 1;
    }
    return states;
}

# ── Optical system builder ────────

# One surface in a prescription. radius is _sys_inf() for a flat surface.
#derive(accessors)
struct PrescriptionSurface { radius; thickness; n_after; aperture_radius; }

# A complete system prescription: name (cstr), surfaces (vec), n_initial.
#derive(accessors)
struct Prescription { name; surfaces; n_initial; }

# Empty Prescription called `name`, n_initial = 1 (air/vacuum); 0 on allocation failure.
#must_use
fn prescription_new(name) {
    # 2.15.1: a null name was accepted and prescription_to_json read it off address 0.
    if (name == 0) { return 0; }
    var p = alloc(sizeof(Prescription));
    if (p == 0) { return 0; }
    Prescription_set_name(p, name);
    Prescription_set_surfaces(p, vec_new());
    Prescription_set_n_initial(p, F64_ONE);
    return p;
}

# Set the initial medium index (before the first surface). Returns the prescription.
# ⛔ 2.4.8: NULL-HANDLE GUARD. `prescription_from_json` is DOCUMENTED to return 0
# on malformed input and tests/hardening.tcyr asserts exactly that — and every one
# of this file's seven Prescription consumers then dereferenced it, exiting 139.
# Measured: `prescription_from_json("not json at all", 15, &e)` -> 0, then any of
# these -> SIGSEGV. Identical to the 2.2.8 Spd repair, which even recorded in
# spectral_cie.cyr that "null-guarding is already the library-wide convention —
# ray_core, ray_trace, ray_system and the wave_* accessors all do it". It was not
# true of ray_system; it is now.
#must_use
fn prescription_with_initial_medium(p, n) {
    if (p == 0) { return 0; }
    Prescription_set_n_initial(p, n);
    return p;
}

# Append a surface. Mutates and returns the prescription (for chaining).
#must_use
fn prescription_add_surface(p, radius, thickness, n_after, aperture_radius) {
    if (p == 0) { return 0; }
    var ps = alloc(sizeof(PrescriptionSurface));
    if (ps == 0) { return 0; }
    PrescriptionSurface_set_radius(ps, radius);
    PrescriptionSurface_set_thickness(ps, thickness);
    PrescriptionSurface_set_n_after(ps, n_after);
    PrescriptionSurface_set_aperture_radius(ps, aperture_radius);
    vec_push(Prescription_surfaces(p), ps);
    return p;
}

# Number of surfaces in the prescription.
#must_use
fn prescription_len(p) {
    if (p == 0) { return 0; }
    return vec_len(Prescription_surfaces(p));
}

# 1 if the prescription has no surfaces, else 0.
#must_use
fn prescription_is_empty(p) {
    # A null handle has no surfaces, which is the same answer an empty one gives.
    if (p == 0) { return 1; }
    if (vec_len(Prescription_surfaces(p)) == 0) { return 1; }
    return 0;
}

# Convert to a `vec` of OpticalSurface with absolute z-positions from cumulative
# thicknesses (flat radius -> plane surface).
#must_use
fn prescription_to_trace_surfaces(p) {
    if (p == 0) { return 0; }
    var surfaces = vec_new();
    var z = f64_from(0);
    var ps_vec = Prescription_surfaces(p);
    var count = vec_len(ps_vec);
    var i = 0;
    while (i < count) {
        var ps = vec_get(ps_vec, i);
        var radius = PrescriptionSurface_radius(ps);
        var na = PrescriptionSurface_n_after(ps);
        var ap = PrescriptionSurface_aperture_radius(ps);
        var os = 0;
        if (_sys_is_inf(radius) == 1) {
            os = surface_plane(z, na, ap);
        } else {
            os = surface_sphere(radius, z, na, ap);
        }
        vec_push(surfaces, os);
        z = f64_add(z, PrescriptionSurface_thickness(ps));
        i = i + 1;
    }
    return surfaces;
}

# Convert to a `vec` of ParaxSurf (power, reduced_thickness) pairs.
#must_use
fn prescription_to_paraxial_surfaces(p) {
    if (p == 0) { return 0; }
    var result = vec_new();
    var n_before = Prescription_n_initial(p);
    var ps_vec = Prescription_surfaces(p);
    var count = vec_len(ps_vec);
    var i = 0;
    while (i < count) {
        var ps = vec_get(ps_vec, i);
        var na = PrescriptionSurface_n_after(ps);
        var power = f64_from(0);
        if (_sys_is_inf(PrescriptionSurface_radius(ps)) == 0) {
            power = f64_div(f64_sub(na, n_before), PrescriptionSurface_radius(ps));
        }
        var reduced_t = PrescriptionSurface_thickness(ps);
        if (f64_gt(f64_abs(na), _sys_eps15()) == 1) {
            reduced_t = f64_div(PrescriptionSurface_thickness(ps), na);
        }
        vec_push(result, paraxsurf_new(power, reduced_t));
        n_before = na;
        i = i + 1;
    }
    return result;
}

# ── System cardinal points ────────

# Cardinal points and properties of a complete system.
#derive(accessors)
struct SystemProperties { focal_length; bfd; ffd; power; entrance_pupil; exit_pupil; }

# Find the cardinal points from a prescription by tracing marginal paraxial rays
# forward (EFL, BFD) and reverse (FFD). Returns 0 and writes an error code if the
# system is empty or afocal (zero power), or PK_ERR_INVALID_PARAMETER for a surface whose radius
# is 0 or NaN (no curvature to give it).
#   focal_length  the effective focal length 1/power
#   bfd           last vertex to the rear focal point, n' f_E: -n' y_k/(n'u'_k)
#   ffd           signed z of the front focal point from the first vertex, -n f_E for a thin
#                 system: the reverse trace's back focal distance, times the object index
#   entrance_pupil, exit_pupil  NaN: a prescription has no aperture stop, so it has no pupils
# ⛔ 2.15.1: bfd and ffd were the reduced distances, f_E for a single surface into glass where
# the rear focus is n' f_E (a real trace crosses the axis at 30, not 20), and the object index
# never entered ffd. entrance_pupil was a hard-coded 0 and exit_pupil was bfd - efl, the rear
# principal plane when n' = 1: neither is a pupil.
#must_use
fn find_system_properties(prescription, err_out) {
    _prk_trace("find_system_properties");
    store64(err_out, PK_ERR_NONE);
    if (prescription == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (prescription_is_empty(prescription) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var sv = Prescription_surfaces(prescription);
    var nsv = vec_len(sv);
    for (var j = 0; j < nsv; j = j + 1) {
        var rj = PrescriptionSurface_radius(vec_get(sv, j));
        if (((rj & 0x7FFFFFFFFFFFFFFF) == 0) | ((rj & 0x7FFFFFFFFFFFFFFF) > 0x7FF0000000000000)) {
            store64(err_out, PK_ERR_INVALID_PARAMETER);
            return 0;
        }
    }

    var paraxial_surfaces = prescription_to_paraxial_surfaces(prescription);
    var marginal = paraxial_marginal(F64_ONE);
    var forward_states = paraxial_trace(marginal, paraxial_surfaces);
    var nf = vec_len(forward_states);
    var final_ray = marginal;
    if (nf > 0) {
        final_ray = vec_get(forward_states, nf - 1);
    }
    if (f64_lt(f64_abs(ParaxialRay_nu(final_ray)), _sys_eps15()) == 1) {
        store64(err_out, PK_ERR_DIVISION_BY_ZERO);
        return 0;
    }

    var efl = f64_div(f64_neg(ParaxialRay_y(marginal)), ParaxialRay_nu(final_ray));
    var power = f64_div(F64_ONE, efl);
    var n_image = PrescriptionSurface_n_after(vec_get(sv, nsv - 1));
    var bfd = f64_div(f64_neg(f64_mul(n_image, ParaxialRay_y(final_ray))), ParaxialRay_nu(final_ray));

    # Reverse marginal ray for FFD: reverse surface order, negate radii, swap media.
    var ps_vec = Prescription_surfaces(prescription);
    var num = vec_len(ps_vec);
    var n_values = vec_new();
    vec_push(n_values, Prescription_n_initial(prescription));
    var k = 0;
    while (k < num) {
        vec_push(n_values, PrescriptionSurface_n_after(vec_get(ps_vec, k)));
        k = k + 1;
    }

    var reverse_surfaces = vec_new();
    var i = num - 1;
    while (i >= 0) {
        var ps = vec_get(ps_vec, i);
        var n_before_reverse = vec_get(n_values, i + 1);
        var n_after_reverse = vec_get(n_values, i);
        var power_reverse = f64_from(0);
        if (_sys_is_inf(PrescriptionSurface_radius(ps)) == 0) {
            power_reverse = f64_div(f64_sub(n_after_reverse, n_before_reverse),
              f64_neg(PrescriptionSurface_radius(ps)));
        }
        var thickness = f64_from(0);
        if (i > 0) {
            thickness = PrescriptionSurface_thickness(vec_get(ps_vec, i - 1));
        }
        var reduced_t = thickness;
        if (f64_gt(f64_abs(n_after_reverse), _sys_eps15()) == 1) {
            reduced_t = f64_div(thickness, n_after_reverse);
        }
        vec_push(reverse_surfaces, paraxsurf_new(power_reverse, reduced_t));
        i = i - 1;
    }

    var reverse_marginal = paraxial_marginal(F64_ONE);
    var reverse_states = paraxial_trace(reverse_marginal, reverse_surfaces);
    var nr = vec_len(reverse_states);
    var reverse_final = reverse_marginal;
    if (nr > 0) {
        reverse_final = vec_get(reverse_states, nr - 1);
    }
    var ffd = _sys_inf();
    if (f64_gt(f64_abs(ParaxialRay_nu(reverse_final)), _sys_eps15()) == 1) {
        ffd = f64_div(f64_mul(Prescription_n_initial(prescription), ParaxialRay_y(reverse_final)),
          ParaxialRay_nu(reverse_final));
    }

    var props = alloc(sizeof(SystemProperties));
    if (props == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    SystemProperties_set_focal_length(props, efl);
    SystemProperties_set_bfd(props, bfd);
    SystemProperties_set_ffd(props, ffd);
    SystemProperties_set_power(props, power);
    SystemProperties_set_entrance_pupil(props, _PRK_NAN);
    SystemProperties_set_exit_pupil(props, _PRK_NAN);
    return props;
}

# ── Common prescriptions ────────

# Symmetric biconvex thin lens: R = 2*f*(n-1), R1 = -R2.
#must_use
fn prescription_biconvex(focal_length, n, aperture, thickness) {
    var r = f64_mul(f64_mul(F64_TWO, focal_length), f64_sub(n, F64_ONE));
    var p = prescription_new("biconvex");
    var _p1 = prescription_add_surface(p, r, thickness, n, aperture);
    var _p2 = prescription_add_surface(p, f64_neg(r), f64_from(0), F64_ONE, aperture);
    return p;
}

# Plano-convex lens, flat side first: R = -f*(n-1).
#must_use
fn prescription_planoconvex(focal_length, n, aperture, thickness) {
    var r = f64_mul(f64_neg(focal_length), f64_sub(n, F64_ONE));
    var p = prescription_new("plano-convex");
    var _p1 = prescription_add_surface(p, _sys_inf(), thickness, n, aperture);
    var _p2 = prescription_add_surface(p, r, f64_from(0), F64_ONE, aperture);
    return p;
}

# Cemented achromatic doublet. Achromatic condition phi1/v1 + phi2/v2 = 0. 0 if v1 == v2 (or
# either is NaN): two glasses of one Abbe number cannot be achromatised, and phi1 = phi v1/(v1 - v2)
# was infinite (2.15.1: built and returned anyway).
#must_use
fn prescription_doublet(focal_length, n1, v1, n2, v2, aperture, t1, t2) {
    if (f64_eq(v1, v2) == 1) { return 0; }
    if (f64_eq(f64_sub(v1, v2), f64_sub(v1, v2)) == 0) { return 0; }
    var phi = f64_div(F64_ONE, focal_length);
    var phi1 = f64_div(f64_mul(phi, v1), f64_sub(v1, v2));
    var phi2 = f64_sub(phi, phi1);
    var r1 = f64_div(f64_mul(F64_TWO, f64_sub(n1, F64_ONE)), phi1);
    # 2.2.6: was `(n1-1)/(phi1/2)`, which is ALGEBRAICALLY IDENTICAL to r1, not
    # its negative — so R1 == R2 bitwise and the crown's thin-lens power
    # (n1-1)(1/R1 - 1/R2) came out exactly 0. The design wants an EQUICONVEX
    # crown, R2 = -R1. Proof the negation is the whole fix, and that r4 below
    # was already correct: r4 solves R4 = R3(n2-1)/((n2-1) - R3*phi2) only under
    # the substitution R3 = -r2, i.e. it was derived against the negated value.
    # Measured, doublet(f=200, n1=1.517, v1=64, n2=1.648, v2=34, ap=25, 4, 2):
    #   as shipped  EFL = 130.527584  (-34.7% from the requested 200)
    #   R2 negated  EFL = 200.010223  (the residual is the thick-lens term)
    # tests/ray_system.tcyr asserted only prescription_len == 3 and the name,
    # never a radius or the focal length, which is why the suite passed.
    var r2 = f64_neg(r1);
    # r4 must be expressed in terms of the CEMENTED radius, which is now r2
    # itself. The standard form is R4 = R3(n2-1) / ((n2-1) - R3*phi2). The old
    # expression was `-r2(n2-1) / (r2*phi2 + (n2-1))`, which is that same
    # formula with R3 = -r2 substituted in — i.e. it was already written against
    # the NEGATED radius, and only produced the right number because r2 carried
    # the wrong sign. With r2 corrected above, the substitution has to come out.
    var r4 = _sys_inf();
    if (f64_gt(f64_abs(phi2), _sys_eps15()) == 1) {
        r4 = f64_div(f64_mul(r2, f64_sub(n2, F64_ONE)),
          f64_sub(f64_sub(n2, F64_ONE), f64_mul(r2, phi2)));
    }
    var p = prescription_new("achromatic doublet");
    var _p1 = prescription_add_surface(p, r1, t1, n1, aperture);
    var _p2 = prescription_add_surface(p, r2, t2, n2, aperture);
    var _p3 = prescription_add_surface(p, r4, f64_from(0), F64_ONE, aperture);
    return p;
}

# --- ray_dispersion.cyr ---

# ray_dispersion.cyr -- dispersion models (Cauchy/Sellmeier/Herzberger/Schott/
# Conrady), prisms, Abbe number, chromatic aberration.
# Usage: include "lib/ray_dispersion.cyr"  (requires error.cyr)
#
# Ported from the Rust `ray/dispersion.rs`. Glass coefficients are encoded as
# exact ratios (num/den, both < 2^53) which reproduce Rust's decimal literals
# bit-for-bit. Wavelengths are in micrometers.

fn _disp_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }
# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _disp_eps15() { return 0x3CD203AF9EE75616; }

# Fraunhofer reference wavelengths (micrometers).
#must_use
fn fraunhofer_d() { return _disp_r(58756, 100000); }   # 0.58756 (He yellow)
# Fraunhofer F line (hydrogen H-beta, blue): 0.48613 um.
#must_use
fn fraunhofer_f() { return _disp_r(48613, 100000); }   # 0.48613 (H blue)
# Fraunhofer C line (hydrogen H-alpha, red): 0.65627 um.
#must_use
fn fraunhofer_c() { return _disp_r(65627, 100000); }   # 0.65627 (H red)

# ── Cauchy dispersion: n(l) = b + c/l^2 ────────

#derive(accessors)
struct CauchyCoefficients { b; c; }

fn _cauchy_mk(b, c) {
    var x = alloc(sizeof(CauchyCoefficients));
    if (x == 0) { return 0; }
    CauchyCoefficients_set_b(x, b);
    CauchyCoefficients_set_c(x, c);
    return x;
}

# Cauchy coefficients for BK7: b = 1.5046, c = 0.00420 um^2.
#must_use
fn cauchy_bk7() { return _cauchy_mk(_disp_r(15046, 10000), _disp_r(420, 100000)); }
# Cauchy coefficients for fused silica: b = 1.4483, c = 0.00351 um^2.
# ⛔ Through 2.4.3 this read b = 1.4580, which is fused silica's n_d — NOT its Cauchy
# constant. `b` is the asymptotic index, always below n_d: BK7 above has b = 1.5046
# against an n_d of 1.5168, and that contrast is what gives the slip away. Adding
# c/l^2 on top of n_d double-counts the dispersion, so this returned n_d = 1.46825
# against a true 1.45846 — an 0.0098 error the suite's `TOL_02` assertion was twice
# too wide to see. Inherited from the Rust archive, which labelled it "approximate".
# The pair here is a least-squares refit to this file's own (verified) Malitson
# Sellmeier fused-silica set over 400-700 nm: worst |dn| 1.7e-4 across the band,
# n_d within 1e-5, comparable to what the BK7 pair achieves (1.0e-4).
#must_use
fn cauchy_fused_silica() { return _cauchy_mk(_disp_r(14483, 10000), _disp_r(351, 100000)); }

# Refractive index at wavelength_um: b + c/l^2.
# NaN for a null coefficient set (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn cauchy_n_at(coef, wavelength_um) {
    if (coef == 0) { return _PRK_NAN; }
    if (_disp_wl_ok(wavelength_um) == 0) { return _PRK_NAN; }
    var l2 = f64_mul(wavelength_um, wavelength_um);
    return f64_add(CauchyCoefficients_b(coef), f64_div(CauchyCoefficients_c(coef), l2));
}

# ── Sellmeier dispersion (3-term) ────────

#derive(accessors)
struct SellmeierCoefficients { b1; c1; b2; c2; b3; c3; }

fn _sellmeier_mk(b1, c1, b2, c2, b3, c3) {
    var s = alloc(sizeof(SellmeierCoefficients));
    if (s == 0) { return 0; }
    SellmeierCoefficients_set_b1(s, b1);
    SellmeierCoefficients_set_c1(s, c1);
    SellmeierCoefficients_set_b2(s, b2);
    SellmeierCoefficients_set_c2(s, c2);
    SellmeierCoefficients_set_b3(s, b3);
    SellmeierCoefficients_set_c3(s, c3);
    return s;
}

# Sellmeier coefficients (b1,c1,b2,c2,b3,c3; c in um^2) for Schott N-BK7.
#must_use
fn sellmeier_bk7() {
    return _sellmeier_mk(
      _disp_r(103961212, 100000000), _disp_r(600069867, 100000000000),
      _disp_r(231792344, 1000000000), _disp_r(200179144, 10000000000),
      _disp_r(101046945, 100000000), _disp_r(103560653, 1000000));
}
# Sellmeier coefficients for Schott N-SF11 dense flint.
# ⚠ N-SF11, the lead-free glass, not the older SF11 — both are catalogued at
# n_d = 1.78472, but their Abbe numbers differ (N-SF11 25.68, SF11 25.76) and this
# set answers 25.68. The Rust archive labelled it N-SF11; prakash's own doc line said
# "SF11" from 2.4.1 until 2.4.4, and the suite pinned SF11's 25.76 at a tolerance of
# 1.0, wide enough that neither reading failed. The function name is unchanged: it is
# public API, and renaming it to move one prefix is not worth a breaking change.
# b1 was `1.73759626` through 2.4.3, a transcription slip for the catalogued
# `1.73759695`; worth 2e-7 in n, corrected for fidelity rather than for accuracy.
#must_use
fn sellmeier_sf11() {
    return _sellmeier_mk(
      _disp_r(173759695, 100000000), _disp_r(131887070, 10000000000),
      _disp_r(313747346, 1000000000), _disp_r(623068142, 10000000000),
      _disp_r(189878101, 100000000), _disp_r(15523629, 100000));
}
# Sellmeier coefficients for fused silica (Malitson 1965).
#must_use
fn sellmeier_fused_silica() {
    return _sellmeier_mk(
      _disp_r(6961663, 10000000), _disp_r(46791482, 10000000000),
      _disp_r(4079426, 10000000), _disp_r(13512063, 1000000000),
      _disp_r(8974794, 10000000), _disp_r(979340025, 10000000));
}
# Sellmeier coefficients for sapphire (Al2O3), ordinary ray — Malitson & Dodge.
# c1/c2/c3 are resonance wavelengths SQUARED: 0.0726631^2, 0.1193242^2, 18.028251^2.
# ⚠ Through 2.4.3 three of the six were slipped in transcription — c2 read 0.01421826
# for 0.01423826 and b3 read 5.3414822 for 5.3414021 (both digit transpositions), and
# c1 was rounded to 0.00527925 for 0.005279925. Net effect was only 3.3e-5 in n, so
# unlike the diamond and water repairs this is fidelity to the cited source rather
# than a correctness fix; it is made because the source IS cited and b1/b2 already
# matched it exactly, which is what identified the other four as slips.
#must_use
fn sellmeier_sapphire() {
    return _sellmeier_mk(
      _disp_r(14313493, 10000000), _disp_r(5279925, 1000000000),
      _disp_r(65054713, 100000000), _disp_r(1423826, 100000000),
      _disp_r(53414021, 10000000), _disp_r(325017834, 1000000));
}
# Sellmeier coefficients for water at 20 C, derived from Daimon & Masumura (2007).
# Fit validity 0.182-1.129 um, which contains the whole visible band. ⚠ Outside it
# the third term's resonance at 3.27 um takes over and the output is meaningless
# (n crosses 1 there and the n^2 < 1 clamp in sellmeier_n_at fires) — this preset
# is for visible and near-IR light, as every consumer of prakash is.
#
# ⚠ TERMS 1 AND 3 ARE D&M VERBATIM; TERM 2 IS PRAKASH'S OWN, AND THAT IS
# DELIBERATE — do not "restore" it from the paper. D&M is a FOUR-term fit and
# `SellmeierCoefficients` holds three, so D&M's two adjacent UV resonances (135 nm
# and 162 nm) are carried here by ONE least-squares merged term at 138.3 nm.
# Measured: the merged set tracks the published four-term fit to **3.5e-6 in n**
# across 380-780 nm, and reproduces published n at all three Fraunhofer lines to
# 1e-5. The alternative was widening the struct to four terms, which moves public
# API for every preset; 2.4.3 is a patch, and the merge costs nothing measurable.
#
# ⛔ Through 2.4.2 this preset was D&M's first three terms with the IR term simply
# DROPPED. That is the one term the visible band cannot do without: it contributes
# about -0.0014 to n across the whole band, so n_d read 1.33418 against a published
# 1.33304 and V_d read 65.1 against ~55.7 — a 17% dispersion error, printed by
# examples/rainbow.cyr for six releases. See the [2.4.3] CHANGELOG entry.
#must_use
fn sellmeier_water() {
    return _sellmeier_mk(
      _disp_r(5674277366, 10000000000), _disp_r(5101829712, 1000000000000),
      _disp_r(19345245, 100000000), _disp_r(1914, 100000),
      _disp_r(1130748688, 10000000000), _disp_r(1069792721, 100000000));
}
# Sellmeier coefficients for diamond (Peter 1923), two-term fit (b3 = 0, c3 = 1).
# Fit validity 0.225-0.665 um, so all three Fraunhofer lines sit inside it.
# ⚠ c1 AND c2 ARE RESONANCE WAVELENGTHS **SQUARED** — 0.1060^2 = 0.011236 and
# 0.1750^2 = 0.030625 um^2 — which is this file's convention everywhere else
# (fused silica stores 0.0684043^2 as 0.0046791482, sapphire 0.0726631^2). Through
# 2.4.1 this entry stored `0.0106` and `0.0175`: the wavelengths themselves, neither
# squared nor even scaled consistently, with b2 = 0.3060 for a published 0.3306.
# Measured cost of that: n_d = 2.4074 against a published 2.4175, n_F 2.4228 vs
# 2.4355, n_C 2.4009 vs 2.4099, and an Abbe number of 64.2 for a material whose
# published value is 55.3 — the dispersion was off by 16%, not the index alone.
# ⛔ The error was inherited character-for-character from the Rust archive
# (`git show 524a7aa^:rust-old/src/ray/dispersion.rs`), a seventh member of the
# 2.2.6 class, AND so was the 0.02 test tolerance that let it pass — wide enough
# to swallow a 0.0096 miss. The pins below are tight and at three wavelengths.
#must_use
fn sellmeier_diamond() {
    return _sellmeier_mk(
      _disp_r(43356, 10000), _disp_r(11236, 1000000),
      _disp_r(3306, 10000), _disp_r(30625, 1000000),
      f64_from(0), F64_ONE);
}

# 1 if a wavelength is one a dispersion formula can take: finite and > 0.
#must_use
fn _disp_wl_ok(wl) {
    if (f64_gt(wl, f64_from(0)) == 0) { return 0; }
    return f64_lt(wl, 0x7FF0000000000000);
}

# One Sellmeier term with a resonance-pole guard: b*l2/(l2-c), or NaN within 1e-15 of the pole
# (2.15.1: it was 0, which dropped the term and answered with the other two). A b = 0 term
# contributes nothing and has no pole, as in _sellmeier_f012_term.
fn _sellmeier_term(b, l2, c) {
    if ((b & 0x7FFFFFFFFFFFFFFF) == 0) { return f64_from(0); }
    var d = f64_sub(l2, c);
    if (f64_gt(f64_abs(d), _disp_eps15()) == 1) {
        return f64_div(f64_mul(b, l2), d);
    }
    return _PRK_NAN;
}

# Refractive index at wavelength_um. NaN for a wavelength that is not finite and > 0, within
# 1e-15 um^2 of a pole, or where the model gives n^2 < 0 (inside an absorption band, where it
# has no real index). 0 < n < 1 is returned as computed.
# ⛔ 2.15.1: n^2 < 1 was clamped to 1.0, so one ulp below a pole, where n^2 is -5e7, the answer
# was vacuum; lambda = 0 and NaN answered 1.0, and a negative lambda answered n(|lambda|).
# NaN for a null coefficient set (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn sellmeier_n_at(coef, wavelength_um) {
    if (coef == 0) { return _PRK_NAN; }
    if (_disp_wl_ok(wavelength_um) == 0) { return _PRK_NAN; }
    var l2 = f64_mul(wavelength_um, wavelength_um);
    var t1 = _sellmeier_term(SellmeierCoefficients_b1(coef), l2, SellmeierCoefficients_c1(coef));
    var t2 = _sellmeier_term(SellmeierCoefficients_b2(coef), l2, SellmeierCoefficients_c2(coef));
    var t3 = _sellmeier_term(SellmeierCoefficients_b3(coef), l2, SellmeierCoefficients_c3(coef));
    var n2 = f64_add(f64_add(f64_add(F64_ONE, t1), t2), t3);
    if (f64_lt(n2, f64_from(0)) == 1) {
        return _PRK_NAN;
    }
    return f64_sqrt(n2);
}

# One term's contribution to chi = n^2 - 1, f' and f'' (accumulated into
# acc[0..2]); 0 inside the pole guard. A b = 0 term contributes nothing and has
# no pole — diamond's unused third term is (0, 1), which would otherwise refuse
# lambda = 1 um. The derivatives are formed as (2BC/d)(l/d) and
# (2BC/d)((3l^2 + C)/d)/d, never through d^3 — which overflowed past l = 2.4e51 um
# and turned f'' into 0 and D's sign around (round 1 of the review).
fn _sellmeier_f012_term(b, c, wl, acc) {
    if ((b & 0x7FFFFFFFFFFFFFFF) == 0) { return 1; }
    var l2 = f64_mul(wl, wl);
    # l^2 underflowing to 0 (l < 1.6e-162 um) makes every term exactly 0 and chi a
    # true +0 that passes the chi < 0 test (round 2 of the review).
    if (l2 == 0) { return 0; }
    var d = f64_sub(l2, c);
    if (f64_gt(f64_abs(d), _disp_eps15()) == 0) { return 0; }
    var g = f64_div(f64_mul(F64_TWO, f64_mul(b, c)), d);
    store64(acc, f64_add(load64(acc), f64_div(f64_mul(b, l2), d)));
    store64(acc + 8, f64_sub(load64(acc + 8), f64_mul(g, f64_div(wl, d))));
    store64(acc + 16, f64_add(load64(acc + 16),
        f64_div(f64_mul(g, f64_div(f64_add(f64_mul(f64_from(3), l2), c), d)), d)));
    return 1;
}

# n^2 and its first two wavelength derivatives, f = n^2, f', f'' (um^-1, um^-2),
# into out[0..2]:  f  = 1 + chi, chi = sum B l^2/(l^2 - C),
#                  f' = sum -2 B C l/(l^2 - C)^2,
#                  f''= sum 2 B C (3 l^2 + C)/(l^2 - C)^3.
# Returns 1, or 0 for a null set, a wavelength that is not finite and positive
# or whose square underflows, a term within sellmeier_n_at's pole guard, chi < 0 — the n^2 < 1 region
# sellmeier_n_at clamps to 1, where its derivatives would describe a curve it
# does not return — or any of f, f', f'' not finite. chi is summed on its own and
# tested before 1 is added: below l = 6e-10 um silica's first term is under half
# an ulp of 1, and a test on 1 + chi let that (all-negative) region through.
fn _sellmeier_f012(coef, wavelength_um, out) {
    if (coef == 0) { return 0; }
    if (f64_gt(wavelength_um, 0) == 0) { return 0; }
    if ((wavelength_um & 0x7FFFFFFFFFFFFFFF) >= 0x7FF0000000000000) { return 0; }
    store64(out, 0);
    store64(out + 8, 0);
    store64(out + 16, 0);
    var ok = _sellmeier_f012_term(SellmeierCoefficients_b1(coef), SellmeierCoefficients_c1(coef),
      wavelength_um, out);
    ok = ok & _sellmeier_f012_term(SellmeierCoefficients_b2(coef), SellmeierCoefficients_c2(coef),
      wavelength_um, out);
    ok = ok & _sellmeier_f012_term(SellmeierCoefficients_b3(coef), SellmeierCoefficients_c3(coef),
      wavelength_um, out);
    if (ok == 0) { return 0; }
    if (f64_ge(load64(out), 0) == 0) { return 0; }
    store64(out, f64_add(F64_ONE, load64(out)));
    var i = 0;
    while (i < 3) {
        if ((load64(out + i * 8) & 0x7FFFFFFFFFFFFFFF) >= 0x7FF0000000000000) { return 0; }
        i = i + 1;
    }
    return 1;
}

# dn/dlambda (um^-1) of a Sellmeier material at wavelength_um: f'/(2n) with
# f = n^2. Analytic, not a finite difference. NaN where _sellmeier_f012 refuses
# (null set, bad wavelength, a pole, the n^2 < 1 region sellmeier_n_at clamps, or
# an overflow).
#must_use
fn sellmeier_dn_dlambda(coef, wavelength_um) {
    var f[24];
    if (_sellmeier_f012(coef, wavelength_um, &f) == 0) { return 0x7FF8000000000000; }
    return f64_div(load64(&f + 8), f64_mul(F64_TWO, f64_sqrt(load64(&f))));
}

# d^2n/dlambda^2 (um^-2) at wavelength_um: (f'' - 2 n'^2)/(2n), from f = n^2.
# NaN on the same inputs as sellmeier_dn_dlambda.
#must_use
fn sellmeier_d2n_dlambda2(coef, wavelength_um) {
    var f[24];
    if (_sellmeier_f012(coef, wavelength_um, &f) == 0) { return 0x7FF8000000000000; }
    var n = f64_sqrt(load64(&f));
    var n1 = f64_div(load64(&f + 8), f64_mul(F64_TWO, n));
    return f64_div(f64_sub(load64(&f + 16), f64_mul(F64_TWO, f64_mul(n1, n1))), f64_mul(F64_TWO, n));
}

# Group index N_g = n - lambda dn/dlambda at wavelength_um: c over the group
# velocity of a pulse in the bulk material. NaN on the same inputs as above.
#must_use
fn sellmeier_group_index(coef, wavelength_um) {
    var f[24];
    if (_sellmeier_f012(coef, wavelength_um, &f) == 0) { return 0x7FF8000000000000; }
    var n = f64_sqrt(load64(&f));
    var n1 = f64_div(load64(&f + 8), f64_mul(F64_TWO, n));
    return f64_sub(n, f64_mul(wavelength_um, n1));
}

# Abbe number V = (n_d - 1) / (n_F - n_C).
# NaN for a null coefficient set (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn abbe_number(sellmeier) {
    if (sellmeier == 0) { return _PRK_NAN; }
    var n_d = sellmeier_n_at(sellmeier, fraunhofer_d());
    var n_f = sellmeier_n_at(sellmeier, fraunhofer_f());
    var n_c = sellmeier_n_at(sellmeier, fraunhofer_c());
    return f64_div(f64_sub(n_d, F64_ONE), f64_sub(n_f, n_c));
}

# ── Prism ────────

# Minimum deviation angle: d_min = 2*asin(n*sin(A/2)) - A. Writes PK_ERR_TIR
# (returns 0) if n*sin(A/2) exceeds 1.
#must_use
fn prism_deviation(apex_angle, n, err_out) {
    store64(err_out, PK_ERR_NONE);
    var sin_half_a = _prk_sin(f64_div(apex_angle, F64_TWO));
    var arg = f64_mul(n, sin_half_a);
    if (f64_gt(f64_abs(arg), F64_ONE) == 1) {
        store64(err_out, PK_ERR_TIR);
        return 0;
    }
    return f64_sub(f64_mul(F64_TWO, ganita_f64_asin(arg)), apex_angle);
}

# Prism deviation using the Sellmeier index at wavelength_um. PK_ERR_WAVELENGTH_RANGE (returns
# 0) where the index is NaN (2.15.1: lambda = 0 answered a deviation, 0, as success).
#must_use
fn prism_dispersion(apex_angle, sellmeier, wavelength_um, err_out) {
    if (sellmeier == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var n = sellmeier_n_at(sellmeier, wavelength_um);
    if (f64_eq(n, n) == 0) {
        store64(err_out, PK_ERR_WAVELENGTH_RANGE);
        return 0;
    }
    return prism_deviation(apex_angle, n, err_out);
}

# (dev_short, dev_long, angular_spread) for prism_angular_spread.
#derive(accessors)
struct PrismSpread { dev_short; dev_long; spread; }

# Angular spread across a wavelength range. Returns a PrismSpread (0 on error).
#must_use
fn prism_angular_spread(apex_angle, sellmeier, wavelength_short_um, wavelength_long_um, err_out) {
    store64(err_out, PK_ERR_NONE);
    if (sellmeier == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var e1 = 0;
    var dev_short = prism_dispersion(apex_angle, sellmeier, wavelength_short_um, &e1);
    if (prakash_is_err(e1) == 1) {
        store64(err_out, e1);
        return 0;
    }
    var e2 = 0;
    var dev_long = prism_dispersion(apex_angle, sellmeier, wavelength_long_um, &e2);
    if (prakash_is_err(e2) == 1) {
        store64(err_out, e2);
        return 0;
    }
    var ps = alloc(sizeof(PrismSpread));
    if (ps == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    PrismSpread_set_dev_short(ps, dev_short);
    PrismSpread_set_dev_long(ps, dev_long);
    PrismSpread_set_spread(ps, f64_abs(f64_sub(dev_short, dev_long)));
    return ps;
}

# ── Additional dispersion models ────────

# Herzberger (5-term): n = a + b*L + c*L^2 + d*l2 + e*l2^2, L = 1/(l2 - 0.028).
#derive(accessors)
struct HerzbergerCoefficients { a; b; c; d; e; }

fn _herzberger_mk(a, b, c, d, e) {
    var h = alloc(sizeof(HerzbergerCoefficients));
    if (h == 0) { return 0; }
    HerzbergerCoefficients_set_a(h, a);
    HerzbergerCoefficients_set_b(h, b);
    HerzbergerCoefficients_set_c(h, c);
    HerzbergerCoefficients_set_d(h, d);
    HerzbergerCoefficients_set_e(h, e);
    return h;
}

# Herzberger index at wavelength_um: a + b*L + c*L^2 + d*l^2 + e*l^4, L = 1/(l^2 - 0.028).
# NaN for a null coefficient set (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn herzberger_n_at(coef, wavelength_um) {
    if (coef == 0) { return _PRK_NAN; }
    var l2 = f64_mul(wavelength_um, wavelength_um);
    var l = f64_div(F64_ONE, f64_sub(l2, _disp_r(28, 1000)));   # 0.028
    # Match Rust's left-associative coefficient-first order: c*l*l = (c*l)*l.
    var term_a = HerzbergerCoefficients_a(coef);
    var term_b = f64_mul(HerzbergerCoefficients_b(coef), l);
    var term_c = f64_mul(f64_mul(HerzbergerCoefficients_c(coef), l), l);
    var term_d = f64_mul(HerzbergerCoefficients_d(coef), l2);
    var term_e = f64_mul(f64_mul(HerzbergerCoefficients_e(coef), l2), l2);
    return f64_add(f64_add(f64_add(f64_add(term_a, term_b), term_c), term_d), term_e);
}

# Schott (6-term legacy): n^2 = a0 + a1*l2 + a2/l2 + a3/l2^2 + a4/l2^3 + a5/l2^4.
#derive(accessors)
struct SchottCoefficients { a0; a1; a2; a3; a4; a5; }

fn _schott_mk(a0, a1, a2, a3, a4, a5) {
    var s = alloc(sizeof(SchottCoefficients));
    if (s == 0) { return 0; }
    SchottCoefficients_set_a0(s, a0);
    SchottCoefficients_set_a1(s, a1);
    SchottCoefficients_set_a2(s, a2);
    SchottCoefficients_set_a3(s, a3);
    SchottCoefficients_set_a4(s, a4);
    SchottCoefficients_set_a5(s, a5);
    return s;
}

# Schott power-series coefficients a0..a5 for N-BK7 (wavelength in um).
# ⛔ a3 read `0.000200816` through 2.4.3, for a catalogued `0.00020816` — a zero
# inserted after the leading 2. It put this series 2.1e-5 off the Sellmeier fit of
# the SAME GLASS at the d-line (9.5e-5 at 400 nm) and its Abbe number at 64.41
# against a catalogued 64.17. Corrected, the two models agree to **1.7e-6** across
# 400-700 nm and n_d lands on 1.51680 exactly.
# ⚠ The cross-check that finds this already existed — `Schott BK7 ~ Sellmeier BK7` —
# and was inherited from the Rust archive at a tolerance of **0.002**, a hundred times
# the defect. Two independent models of one glass is the right instrument; 0.002 is
# the wrong setting for it. Now pinned at 1e-5, at five wavelengths.
#must_use
fn schott_bk7() {
    return _schott_mk(
      _disp_r(22718929, 10000000), f64_neg(_disp_r(10108077, 1000000000)),
      _disp_r(10592509, 1000000000), _disp_r(20816, 100000000),
      f64_neg(_disp_r(76472538, 10000000000000)), _disp_r(49240991, 100000000000000));
}

# Schott power-series index: sqrt(a0 + a1*l^2 + a2/l^2 + a3/l^4 + a4/l^6 + a5/l^8). NaN if n^2 < 0
# or the wavelength is not finite and > 0 (2.15.1: those answered 1.0, NaN included).
# NaN for a null coefficient set (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn schott_n_at(coef, wavelength_um) {
    if (coef == 0) { return _PRK_NAN; }
    if (_disp_wl_ok(wavelength_um) == 0) { return _PRK_NAN; }
    var l2 = f64_mul(wavelength_um, wavelength_um);
    var li = f64_div(F64_ONE, l2);
    # Match Rust's left-associative coefficient-first folds: a3*x*x = (a3*x)*x.
    var t3 = f64_mul(f64_mul(SchottCoefficients_a3(coef), li), li);
    var t4 = f64_mul(f64_mul(f64_mul(SchottCoefficients_a4(coef), li), li), li);
    var t5 = f64_mul(f64_mul(f64_mul(f64_mul(SchottCoefficients_a5(coef), li), li), li), li);
    var n2 = f64_add(f64_add(f64_add(f64_add(f64_add(
              SchottCoefficients_a0(coef),
              f64_mul(SchottCoefficients_a1(coef), l2)),
            f64_mul(SchottCoefficients_a2(coef), li)),
          t3), t4), t5);
    if (f64_lt(n2, f64_from(0)) == 1) { return _PRK_NAN; }
    return f64_sqrt(n2);
}

# Conrady (3-term): n = n0 + a/l + b/l^3.5.
#derive(accessors)
struct ConradyCoefficients { n0; a; b; }

fn _conrady_mk(n0, a, b) {
    var c = alloc(sizeof(ConradyCoefficients));
    if (c == 0) { return 0; }
    ConradyCoefficients_set_n0(c, n0);
    ConradyCoefficients_set_a(c, a);
    ConradyCoefficients_set_b(c, b);
    return c;
}

# Conrady index at wavelength_um: n0 + a/l + b/l^3.5.
# NaN for a null coefficient set (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn conrady_n_at(coef, wavelength_um) {
    if (coef == 0) { return _PRK_NAN; }
    if (_disp_wl_ok(wavelength_um) == 0) { return _PRK_NAN; }
    var term_a = f64_div(ConradyCoefficients_a(coef), wavelength_um);
    var term_b = f64_div(ConradyCoefficients_b(coef), _prk_pow(wavelength_um, _disp_r(7, 2)));
    return f64_add(f64_add(ConradyCoefficients_n0(coef), term_a), term_b);
}

# ── Partial dispersion & chromatic aberration ────────

# Partial dispersion P_g,F = (n_g - n_F) / (n_F - n_C). 0 if n_F ~ n_C.
# NaN for a null coefficient set (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn partial_dispersion(sellmeier) {
    if (sellmeier == 0) { return _PRK_NAN; }
    var n_g = sellmeier_n_at(sellmeier, _disp_r(43584, 100000));   # g-line 0.43584
    var n_f = sellmeier_n_at(sellmeier, fraunhofer_f());
    var n_c = sellmeier_n_at(sellmeier, fraunhofer_c());
    var dn_fc = f64_sub(n_f, n_c);
    if (f64_lt(f64_abs(dn_fc), _disp_eps15()) == 1) {
        return f64_from(0);
    }
    return f64_div(f64_sub(n_g, n_f), dn_fc);
}

# Longitudinal chromatic aberration (axial color): df = f / V.
#must_use
fn longitudinal_chromatic_aberration(focal_length, abbe_num) {
    return f64_div(focal_length, abbe_num);
}

# Lateral colour as the chromatic difference of magnification: TCA = h / V, the spread between
# the F and C image heights h = f tan(theta), each on its own focal plane (delta h = delta f tan
# theta = h/V). On ONE image plane a thin lens with its stop at the lens has none: the chief ray
# goes through the centre undeviated in every colour. Stop shift is what produces that kind.
#must_use
fn lateral_chromatic_aberration(image_height, abbe_num) {
    return f64_div(image_height, abbe_num);
}

# Secondary spectrum (residual after achromatic correction): f * dP / V.
#must_use
fn secondary_spectrum(focal_length, delta_p, abbe_num) {
    return f64_div(f64_mul(focal_length, delta_p), abbe_num);
}

# --- ray_fiber.cyr ---

# ray_fiber.cyr -- fiber optics: numerical aperture, V-number, modes, coupling
# Usage: include "lib/ray_fiber.cyr"  (requires error.cyr, ray_dispersion.cyr)
#
# Ported from the Rust `ray/fiber.rs`. Non-integer literals are exact ratios.
# `v.powf(-1.5)` uses ganita_f64_pow (transcendental, like Rust powf); `v.powi(-6)`
# is an exact integer power computed as 1/v^6 by squaring (not a transcendental).

fn _fib_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# 1 if n is a usable refractive index: finite and > 0 (ray_core's test, kept local so this
# module still needs only error.cyr and ray_dispersion.cyr).
#must_use
fn _fib_index_ok(n) {
    if (f64_gt(n, f64_from(0)) == 0) { return 0; }
    return f64_lt(n, 0x7FF0000000000000);
}

# Single-mode cutoff V-number (first zero of the J0 Bessel function).
fn _fib_cutoff() { return _fib_r(2405, 1000); }   # 2.405

# Numerical aperture: NA = sqrt(n_core^2 - n_clad^2). Writes
# PK_ERR_INVALID_PARAMETER (returns 0) if n_core < n_clad, PK_ERR_INVALID_INDEX unless both are
# finite and > 0 (2.15.1: (-1.5, -1.4) answered NA = 0.54, the squares hiding the signs).
#must_use
fn fiber_na(n_core, n_clad, err_out) {
    store64(err_out, PK_ERR_NONE);
    if ((_fib_index_ok(n_core) & _fib_index_ok(n_clad)) == 0) {
        store64(err_out, PK_ERR_INVALID_INDEX);
        return 0;
    }
    var na2 = f64_sub(f64_mul(n_core, n_core), f64_mul(n_clad, n_clad));
    if (f64_lt(na2, f64_from(0)) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    return f64_sqrt(na2);
}

# V-number (normalized frequency): V = 2*pi*a*NA/lambda. Single-mode at V < 2.405.
#must_use
fn v_number(core_radius, na, wavelength) {
    return f64_div(f64_mul(f64_mul(f64_mul(F64_TWO, F64_PI), core_radius), na), wavelength);
}

# Approximate guided-mode count in a step-index multimode fiber: N ~ V^2/2
# (>= 1). Single-mode (V < 2.405) has exactly one mode. From V ~ 2^32 the count
# saturates at i64::MAX (cyrius >= 6.6.8; below it f64_to wraps and this answers 1).
#must_use
fn num_modes(v) {
    if (f64_lt(v, _fib_cutoff()) == 1) {
        return 1;
    }
    var n = f64_to(f64_div(f64_mul(v, v), F64_TWO));
    if (n < 1) {
        return 1;
    }
    return n;
}

# 1 if the fiber supports only a single mode at this V-number (V < 2.405).
#must_use
fn is_single_mode(v) {
    return f64_lt(v, _fib_cutoff());
}

# Mode field diameter (Marcuse 1977): MFD ~ 2a*(0.65 + 1.619*V^-1.5 + 2.879*V^-6), within about 1%
# of the exact LP01 Gaussian fit for 1.2 <= V <= 2.4 (2.15.1: this said 0.8 < V < 2.5).
#must_use
fn mode_field_diameter(core_radius, v) {
    # V^-6 as an exact integer power: 1 / (V^2 * (V^2 * V^2)), matching powi.
    var v2 = f64_mul(v, v);
    var v6 = f64_mul(v2, f64_mul(v2, v2));
    var inv_v6 = f64_div(F64_ONE, v6);
    var term_pm15 = f64_mul(_fib_r(1619, 1000), _prk_pow(v, f64_neg(_fib_r(15, 10))));
    var term_pm6 = f64_mul(_fib_r(2879, 1000), inv_v6);
    var factor = f64_add(f64_add(_fib_r(65, 100), term_pm15), term_pm6);
    return f64_mul(f64_mul(F64_TWO, core_radius), factor);
}

# Gaussian-beam / single-mode-fiber coupling efficiency:
# eta = (2*w_beam*w_fiber / (w_beam^2 + w_fiber^2))^2. eta = 1 when w_beam = w_fiber.
#must_use
fn coupling_efficiency_gaussian(w_beam, w_fiber) {
    var num = f64_mul(f64_mul(F64_TWO, w_beam), w_fiber);
    var den = f64_add(f64_mul(w_beam, w_beam), f64_mul(w_fiber, w_fiber));
    var ratio = f64_div(num, den);
    return f64_mul(ratio, ratio);
}

# ── Chromatic dispersion (2.10.0) ────────
#
# D = d(tau/L)/d(lambda) in ps/(nm km), the unit fibre data sheets use. With the
# wavelength in um and n'' in um^-2, D = -(lambda/c) n'' is ps per um of
# wavelength per um of length; 1 um of length is 1e-9 km and 1 um of wavelength
# 1000 nm, and c = 299.792458 um/ps, so D[ps/(nm km)] = -lambda n'' * 1e12/299792458.
# Wavelengths and core radii are in MICROMETRES here, the Sellmeier convention —
# unlike this module's older functions, which take any consistent unit.

fn _fib_finite(x) {
    if ((x & 0x7FFFFFFFFFFFFFFF) >= 0x7FF0000000000000) { return 0; }
    return 1;
}
fn _fib_pos(x) { return f64_gt(x, 0) & _fib_finite(x); }

# 1e12/299792458 = 3335.6409519815205 (correctly rounded; pinned in the suite).
fn _fib_dconst() { return f64_div(f64_from(1000000000000), f64_from(299792458)); }

# The largest double BELOW j01 = 2.40482555769577277, J0's first zero — the LP01
# root's upper bound. (Round 1 of the review: the nearest double,
# 0x40033D152E971B40, is 1.2e-16 ABOVE the zero; a solve that converged onto it
# evaluated g past the pole and returned NaN as success for V past 3e16.)
var _FIB_J01 = 0x40033D152E971B3F;

# The largest V the LP01 functions answer: 2^48 ~ 2.8e14. The root lies within
# ~j01/V of J0's zero, so past ~1e16 a double cannot place it at all; below
# 2^48 it is resolved to ~1e-15. Every real fibre has V < 1e3.
fn _fib_v_ok(v) { return _fib_pos(v) & f64_le(v, 0x42F0000000000000); }

# Material dispersion D = -(lambda/c) d^2n/dlambda^2 of a Sellmeier material, in
# ps/(nm km), at wavelength_um. Positive is "anomalous": the group delay grows
# with wavelength, so short wavelengths travel faster (blue leads red). Fused
# silica (Malitson) crosses zero at 1.2727 um; NaN where sellmeier_d2n_dlambda2
# refuses.
#must_use
fn fiber_material_dispersion(coef, wavelength_um) {
    var d2 = sellmeier_d2n_dlambda2(coef, wavelength_um);
    return f64_neg(f64_mul(f64_mul(wavelength_um, d2), _fib_dconst()));
}

# g(U) = U J1(U)/J0(U) by the backward continued fraction
# t <- U^2/(2k - t), k = 20..1 — U J_k/J_{k-1} from the Bessel recurrence, with no
# J evaluated and no division by U. Twenty levels leave a tail below 1e-27 for
# U <= 3.4, the most the LP01 solve reaches. The pole at U = j01 is J0's zero.
fn _fib_g(u) {
    var u2 = f64_mul(u, u);
    var t = 0;
    var k = 20;
    while (k >= 1) {
        t = f64_div(u2, f64_sub(f64_from(2 * k), t));
        k = k - 1;
    }
    return t;
}

# Steed's continued fraction z for W >= 1, with W K1(W)/K0(W) = W + 1/2 - z/4
# (Thompson & Barnett 1987; Numerical Recipes' CF2 at order 0): partial
# numerators -(i - 1/2)^2, denominators 2(i + W). Needs 60 levels at W = 1 and
# fewer above. The U-branch derivatives use z itself: 4(h - W) - 2 = -z, which
# is O(1/W) and would otherwise be recovered by cancelling O(1) terms.
fn _fib_kcf(w) {
    var b = f64_mul(F64_TWO, f64_add(F64_ONE, w));
    var d = f64_div(F64_ONE, b);
    var h = d;
    var delh = d;
    var a = f64_neg(0x3FD0000000000000);
    var i = 2;
    while (i < 400) {
        a = f64_sub(a, f64_from(2 * (i - 1)));
        b = f64_add(b, F64_TWO);
        d = f64_div(F64_ONE, f64_add(b, f64_mul(a, d)));
        delh = f64_mul(f64_sub(f64_mul(b, d), F64_ONE), delh);
        h = f64_add(h, delh);
        # 2^-56 relative.
        if (f64_lt(f64_abs(delh), f64_mul(f64_abs(h), 0x3C70000000000000)) == 1) { i = 400; }
        i = i + 1;
    }
    return h;
}

# h(W) = W K1(W)/K0(W); s = ln W, passed so the small-W branch needs no log and
# works past the point where W itself underflows. W < 1: the ascending series
#   K0 = sum (H_k - L) q^k/(k!)^2,
#   W K1 = 1 + q sum (2L - H_k - H_{k+1}) q^k/(k!(k+1)!),
# q = W^2/4, L = ln(W/2) + gamma, H_k harmonic (A&S 9.6.13, 9.6.11); W >= 1,
# _fib_kcf. Both measured at <= 6e-16 relative against mpmath across 1e-3..1e3.
fn _fib_h(w, s) {
    if (f64_lt(w, F64_ONE) == 1) {
        var q = f64_mul(F64_HALF, f64_mul(F64_HALF, f64_mul(w, w)));
        var lg = f64_add(f64_sub(s, 0x3FE62E42FEFA39EF), 0x3FE2788CFC6FB619);
        var k0 = 0;
        var wk1 = 0;
        var t0 = F64_ONE;
        var t1 = F64_ONE;
        var hk = 0;
        var k = 0;
        while (k < 14) {
            var hn = f64_add(hk, f64_div(F64_ONE, f64_from(k + 1)));
            k0 = f64_add(k0, f64_mul(f64_sub(hk, lg), t0));
            wk1 = f64_add(wk1, f64_mul(f64_sub(f64_sub(f64_add(lg, lg), hk), hn), t1));
            t0 = f64_div(f64_mul(t0, q), f64_from((k + 1) * (k + 1)));
            t1 = f64_div(f64_mul(t1, q), f64_from((k + 1) * (k + 2)));
            hk = hn;
            k = k + 1;
        }
        return f64_div(f64_add(F64_ONE, f64_mul(q, wk1)), k0);
    }
    return f64_sub(f64_add(w, F64_HALF), f64_mul(0x3FD0000000000000, _fib_kcf(w)));
}

# The scalar LP01 mode of a step-index fibre (weak guidance): the root of
#   U J1(U)/J0(U) = W K1(W)/K0(W),   U^2 + W^2 = V^2,
# written to out[0..3] as U, W^2, X = the common value of both sides, and 1 if
# it was solved in U (then W >= V/sqrt 2 >= 1.6) or 0 if in s.
# F rises monotonically through the root, so a bracketed Newton with bisection
# fallback cannot miss it. It is solved in U when the root has U < W and in
# s = ln W otherwise, so neither of U, W is recovered from V^2 minus a nearly
# equal square: small V has W ~ 2 e^(1/4 - gamma) e^(-2/V^2) = 1.44 e^(-2/V^2),
# resolved in s down to W = e^-800 (V ~ 0.05; below it W^2 is 0 in double).
# Callers keep V <= 2^48 (_fib_v_ok).
fn _fib_lp01(v, out) {
    var um = f64_mul(v, 0x3FE6A09E667F3BCD);   # V/sqrt 2: U = W there
    var ubranch = f64_ge(um, _FIB_J01);
    if (ubranch == 0) {
        var fm = f64_sub(_fib_g(um), _fib_h(um, f64_ln(um)));
        ubranch = f64_gt(fm, 0);
    }
    if (ubranch == 1) {
        var lo = 0;
        var hi = f64_min(um, _FIB_J01);
        # Gloge's closed form U ~ (1 + sqrt 2) V/(1 + (4 + V^4)^(1/4)) to start.
        var v2 = f64_mul(v, v);
        var u = f64_div(f64_mul(0x4003504F333F9DE6, v),
          f64_add(F64_ONE, f64_sqrt(f64_sqrt(f64_add(f64_from(4), f64_mul(v2, v2))))));
        if ((f64_gt(u, lo) & f64_lt(u, hi)) == 0) { u = f64_mul(F64_HALF, f64_add(lo, hi)); }
        var it = 0;
        while (it < 200) {
            var w2 = f64_mul(f64_sub(v, u), f64_add(v, u));
            var w = f64_sqrt(w2);
            var g = _fib_g(u);
            var hh = _fib_h(w, f64_ln(w));
            var f = f64_sub(g, hh);
            if (f64_gt(f, 0) == 1) { hi = u; }
            if (f64_lt(f, 0) == 1) { lo = u; }
            if (f == 0) { it = 200; }
            var gp = f64_add(u, f64_div(f64_mul(g, g), u));
            var fp = f64_add(gp, f64_div(f64_mul(f64_sub(f64_mul(hh, hh), w2), u), w2));
            var un = f64_sub(u, f64_div(f, fp));
            # A Newton step below 2^-52 relative has converged — tested BEFORE the
            # bracket, whose edge the converged iterate itself usually is (a
            # sub-ulp step lands on it and would be thrown to a bisection).
            if (f64_le(f64_abs(f64_sub(un, u)), f64_mul(u, 0x3CB0000000000000)) == 1) { it = 200; }
            if (it < 200) {
                if ((f64_gt(un, lo) & f64_lt(un, hi)) == 0) { un = f64_add(lo, f64_mul(F64_HALF, f64_sub(hi, lo))); }
                if (f64_le(f64_sub(hi, lo), f64_mul(hi, 0x3CB0000000000000)) == 1) { it = 200; }
                u = un;
            }
            it = it + 1;
        }
        store64(out, u);
        store64(out + 8, f64_mul(f64_sub(v, u), f64_add(v, u)));
        store64(out + 16, _fib_g(u));
        store64(out + 24, 1);
        return 0;
    }
    # s-branch: F(s) = g(U(s)) - h(e^s) FALLS through the root.
    var shi = f64_ln(um);
    # Past j01 the lower end is where U reaches the pole (F = +inf there).
    var slo = f64_from(-800);
    if (f64_gt(v, _FIB_J01) == 1) {
        slo = f64_mul(F64_HALF, f64_ln(f64_mul(f64_sub(v, _FIB_J01), f64_add(v, _FIB_J01))));
    }
    var gv = _fib_g(v);
    var deep = f64_le(v, _FIB_J01) & f64_le(f64_sub(gv, _fib_h(0, slo)), 0);
    if (deep == 1) {
        # The root is below W = e^-800: W^2 is 0 in double and so is b.
        store64(out, v);
        store64(out + 8, 0);
        store64(out + 16, gv);
        store64(out + 24, 0);
        return 0;
    }
    # Small-W asymptote h ~ -1/(ln(W/2) + gamma) = g to start.
    var s = f64_sub(f64_sub(0x3FE62E42FEFA39EF, 0x3FE2788CFC6FB619), f64_div(F64_ONE, gv));
    if ((f64_gt(s, slo) & f64_lt(s, shi)) == 0) { s = f64_mul(F64_HALF, f64_add(slo, shi)); }
    var us = v;
    var ws2 = 0;
    var xs = gv;
    var jt = 0;
    while (jt < 200) {
        var ws = _prk_exp(s);
        ws2 = f64_mul(ws, ws);
        us = f64_sqrt(f64_mul(f64_sub(v, ws), f64_add(v, ws)));
        xs = _fib_g(us);
        var hs = _fib_h(ws, s);
        var fs = f64_sub(xs, hs);
        if (f64_gt(fs, 0) == 1) { slo = s; }
        if (f64_lt(fs, 0) == 1) { shi = s; }
        if (fs == 0) { jt = 200; }
        var gps = f64_add(us, f64_div(f64_mul(xs, xs), us));
        var fps = f64_neg(f64_add(f64_div(f64_mul(gps, ws2), us), f64_sub(f64_mul(hs, hs), ws2)));
        var sn = f64_sub(s, f64_div(fs, fps));
        var tol = f64_mul(f64_max(F64_ONE, f64_abs(s)), 0x3CB0000000000000);
        if (f64_le(f64_abs(f64_sub(sn, s)), tol) == 1) { jt = 200; }
        if (jt < 200) {
            if ((f64_gt(sn, slo) & f64_lt(sn, shi)) == 0) { sn = f64_add(slo, f64_mul(F64_HALF, f64_sub(shi, slo))); }
            if (f64_le(f64_sub(shi, slo), tol) == 1) { jt = 200; }
            s = sn;
        }
        jt = jt + 1;
    }
    var wf = _prk_exp(s);
    store64(out, f64_sqrt(f64_mul(f64_sub(v, wf), f64_add(v, wf))));
    store64(out + 8, f64_mul(wf, wf));
    store64(out + 16, _fib_g(load64(out)));
    store64(out + 24, 0);
    return 0;
}

# V-derivatives of the LP01 root by implicit differentiation, into out[0..3]:
# b, b' = db/dV, b'' and the waveguide factor F = V (Vb)''. With X the common
# value, g' = U + X^2/U and g'' = 1 + 2Xg'/U - X^2/U^2 (from (x J1)' = x J0,
# J0' = -J1), and h' = (X^2 - W^2)/W, h'' = 2Xh'/W - X^2/W^2 - 1 (from
# (x K1)' = -x K0, K0' = -K1). Two forms, one per solve branch, each free of the
# cancellation the other suffers. The formulas agree with 60-digit finite
# differences of the root to 17 digits; the double implementation is within
# ~3e-15 relative across V = 0.5..10 (3e-16 absolute at the factor's zero near
# V = 3).
#
# s-branch (small V, W -> 0), in s = ln W, H(s) = h(e^s), H_s = X^2 - W^2,
# H_ss = 2X H_s - 2W^2:
#   s'  = g' V/(U H_s + g' W^2),   U' = (V - W^2 s')/U,
#   s'' = [g'' U'^2 + g'(1 - U'^2 - 2W^2 s'^2)/U - H_ss s'^2] U/(U H_s + g' W^2),
#   1 - U'^2 = W^2 (2V s' - 1 - W^2 s'^2)/U^2,
#   F = W^2 [4s'^2 + 2s'' - 4s'/V + 2/V^2],
# every term carrying its factor of W^2 explicitly, so none cancels as W
# vanishes. Past V ~ 3 those terms cancel to a result O(1/V^2) smaller — 1400
# ulps at V = 10 — so the
# U-branch (W >= 1.6) works in U, with h's excess m = h - W = 1/2 - z/4 and
# 4m - 2 = -z taken from the continued fraction rather than by subtraction:
#   h' = m(2W + m)/W,   h'' = -z + (6m^2 - 2m)/W + (2m^3 - m^2)/W^2,
#   U' = h' V/(W g' + h' U),   W' = (V - U U')/W,
#   1 - U'^2 - W'^2 = -(U - V U')^2/W^2,
#   U'' = [h'' W'^2 + h'(1 - U'^2 - W'^2)/W - g'' U'^2] W/(W g' + h' U),
#   F = -2(U'^2 + U U'') + 4U U'/V - 2U^2/V^2.
fn _fib_lp01_derivs(v, out) {
    var r[32];
    _fib_lp01(v, &r);
    var u = load64(&r);
    var w2 = load64(&r + 8);
    var x = load64(&r + 16);
    var x2 = f64_mul(x, x);
    var gp = f64_add(u, f64_div(x2, u));
    var gpp = f64_sub(f64_add(F64_ONE, f64_div(f64_mul(f64_mul(F64_TWO, x), gp), u)), f64_div(x2, f64_mul(u, u)));
    var iv = f64_div(F64_ONE, v);
    var v2 = f64_mul(v, v);
    if (load64(&r + 24) == 1) {
        var w = f64_sqrt(w2);
        var z = _fib_kcf(w);
        var m = f64_sub(F64_HALF, f64_mul(0x3FD0000000000000, z));
        var hp = f64_div(f64_mul(m, f64_add(f64_add(w, w), m)), w);
        var m2 = f64_mul(m, m);
        var hpp = f64_add(f64_add(f64_neg(z), f64_div(f64_sub(f64_mul(f64_from(6), m2), f64_add(m, m)), w)),
          f64_div(f64_sub(f64_mul(F64_TWO, f64_mul(m2, m)), m2), w2));
        var den = f64_add(f64_mul(w, gp), f64_mul(hp, u));
        var up = f64_div(f64_mul(hp, v), den);
        var wp = f64_div(f64_sub(v, f64_mul(u, up)), w);
        var e = f64_sub(u, f64_mul(v, up));
        var one = f64_neg(f64_div(f64_mul(e, e), w2));
        var num = f64_sub(f64_add(f64_mul(hpp, f64_mul(wp, wp)), f64_div(f64_mul(hp, one), w)),
          f64_mul(gpp, f64_mul(up, up)));
        var upp = f64_div(f64_mul(num, w), den);
        var q = f64_add(f64_mul(up, up), f64_mul(u, upp));
        var uu = f64_mul(u, u);
        var uup = f64_mul(u, up);
        store64(out, f64_div(w2, v2));
        store64(out + 8, f64_mul(f64_div(f64_add(u, u), v2), f64_sub(f64_mul(u, iv), up)));
        var bvv = f64_add(f64_neg(f64_div(f64_add(q, q), v2)), f64_div(f64_mul(f64_from(8), uup), f64_mul(v2, v)));
        store64(out + 16, f64_sub(bvv, f64_div(f64_mul(f64_from(6), uu), f64_mul(v2, v2))));
        store64(out + 24, f64_sub(f64_add(f64_neg(f64_add(q, q)), f64_mul(f64_mul(f64_from(4), uup), iv)),
            f64_div(f64_add(uu, uu), v2)));
        return 0;
    }
    if (w2 == 0) {
        # b and all its derivatives are below the double range.
        var i = 0;
        while (i < 4) {
            store64(out + i * 8, 0);
            i = i + 1;
        }
        return 0;
    }
    var hsd = f64_sub(x2, w2);
    var dn = f64_add(f64_mul(u, hsd), f64_mul(gp, w2));
    var sp = f64_div(f64_mul(gp, v), dn);
    var usp = f64_div(f64_sub(v, f64_mul(w2, sp)), u);
    var sp2 = f64_mul(sp, sp);
    var om = f64_div(f64_mul(w2, f64_sub(f64_sub(f64_mul(f64_mul(F64_TWO, v), sp), F64_ONE),
          f64_mul(w2, sp2))), f64_mul(u, u));
    var hss = f64_sub(f64_mul(f64_mul(F64_TWO, x), hsd), f64_mul(F64_TWO, w2));
    var sn = f64_sub(f64_add(f64_mul(gpp, f64_mul(usp, usp)),
        f64_div(f64_mul(gp, f64_sub(om, f64_mul(f64_mul(F64_TWO, w2), sp2))), u)), f64_mul(hss, sp2));
    var spp = f64_div(f64_mul(sn, u), dn);
    var c2 = f64_div(f64_mul(F64_TWO, w2), v2);
    var e1 = f64_sub(sp, iv);
    store64(out, f64_div(w2, v2));
    store64(out + 8, f64_mul(c2, e1));
    store64(out + 16, f64_mul(c2, f64_add(f64_add(f64_mul(F64_TWO, f64_mul(e1, e1)), spp), f64_mul(iv, iv))));
    var br = f64_add(f64_sub(f64_add(f64_mul(f64_from(4), sp2), f64_mul(F64_TWO, spp)),
        f64_mul(f64_mul(f64_from(4), sp), iv)), f64_mul(F64_TWO, f64_mul(iv, iv)));
    store64(out + 24, f64_mul(w2, br));
    return 0;
}

# Normalized propagation constant b = W^2/V^2 = (n_eff^2 - n_clad^2)/(n_core^2 -
# n_clad^2) of the fundamental LP01 mode at normalized frequency V, from the exact
# weak-guidance eigenvalue equation (not the Rudolph-Neumann fit):
# b(1) = 0.0409504, b(2) = 0.4161634, b(2.405) = 0.5312608. 0 < b < 1 in exact
# arithmetic; in double b underflows to 0 below V ~ 0.073 (it is ~e^(-4/V^2))
# and rounds to 1 above V ~ 1e8. Writes PK_ERR_INVALID_PARAMETER (returns 0)
# unless 0 < V <= 2^48 (_fib_v_ok).
#must_use
fn fiber_lp01_b(v, err_out) {
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    if (_fib_v_ok(v) == 0) { return 0; }
    var r[32];
    _fib_lp01(v, &r);
    store64(err_out, PK_ERR_NONE);
    # W^2 = 0 is the deep branch; V^2 itself may underflow there (V < 1.6e-162).
    if (load64(&r + 8) == 0) { return 0; }
    return f64_div(load64(&r + 8), f64_mul(v, v));
}

# The waveguide-dispersion factor V d^2(Vb)/dV^2 of the LP01 mode — the curve
# Gloge (1971) tabulates: 1.3456 at V = 1, 0.4623 at V = 2, 0.1951 at V = 2.4,
# crossing zero just above V = 3. Exact within weak guidance (implicit
# derivatives of the eigenvalue equation, not Marcuse's 0.080 + 0.549(2.834 -
# V)^2 fit). PK_ERR_INVALID_PARAMETER (returns 0) unless 0 < V <= 2^48.
#must_use
fn fiber_waveguide_factor(v, err_out) {
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    if (_fib_v_ok(v) == 0) { return 0; }
    var dv[32];
    _fib_lp01_derivs(v, &dv);
    store64(err_out, PK_ERR_NONE);
    return load64(&dv + 24);
}

# V = 2 pi a sqrt(n1^2 - n2^2)/lambda for cladding index n2 and relative index
# step delta = (n1^2 - n2^2)/(2 n1^2): sqrt(n1^2 - n2^2) = n2 sqrt(rho),
# rho = 2 delta/(1 - 2 delta).
fn _fib_rho(delta) { return f64_div(f64_add(delta, delta), f64_sub(F64_ONE, f64_add(delta, delta))); }

# Waveguide dispersion of a step-index fibre in the textbook split (Gloge 1971;
# Keiser, Optical Fiber Communications):
#   D_w = -(n2 delta/(c lambda)) V d^2(Vb)/dV^2      [ps/(nm km)]
# with the exact weak-guidance factor above. `clad` is the cladding's Sellmeier
# set — like fiber_material_dispersion and fiber_dispersion, not an index value
# (round 1: an index here took a set pointer as a subnormal "index" and answered
# 0 as success) — delta = (n1^2 - n2^2)/(2 n1^2), core_radius_um the radius.
# ⚠ It is an approximation of the dispersion fiber_dispersion computes, and not
# only by the cross term: expanding n_eff to first order in delta gives the
# waveguide term with n2 replaced by N_g^2/n2 (Agrawal's form), 2.6% larger for
# silica at 1.55 um. D_m + D_w misses fiber_dispersion by -0.048 ps/(nm km) at
# delta = 0.36%, a = 4.1 um, 1.55 um (+0.085 cross term, -0.123 prefactor,
# -0.010 second order). Both are the scalar LP01 model — see fiber_dispersion.
# Writes PK_ERR_INVALID_PARAMETER (returns 0) for a null set or a wavelength
# sellmeier_d2n_dlambda2 refuses, a core radius that is not finite and positive,
# delta outside (0, 1/2), or V past 2^48.
#must_use
fn fiber_waveguide_dispersion(clad, delta, core_radius_um, wavelength_um, err_out) {
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    if (_fib_pos(core_radius_um) == 0) { return 0; }
    if ((_fib_pos(delta) & f64_lt(delta, F64_HALF)) == 0) { return 0; }
    var f[24];
    if (_sellmeier_f012(clad, wavelength_um, &f) == 0) { return 0; }
    var n2 = f64_sqrt(load64(&f));
    var v = f64_div(f64_mul(f64_mul(f64_mul(F64_TAU, core_radius_um), n2),
        f64_sqrt(_fib_rho(delta))), wavelength_um);
    var e = 0;
    var fw = fiber_waveguide_factor(v, &e);
    if (e != PK_ERR_NONE) { return 0; }
    var dw = f64_neg(f64_div(f64_mul(f64_mul(f64_mul(n2, delta), fw), _fib_dconst()), wavelength_um));
    if (_fib_finite(dw) == 0) { return 0; }
    store64(err_out, PK_ERR_NONE);
    return dw;
}

# Total chromatic dispersion of a step-index fibre, ps/(nm km): D = -(lambda/c)
# d^2 n_eff/dlambda^2 with n_eff^2 = n2^2 + b(V)(n1^2 - n2^2) for the LP01 mode —
# material, waveguide and their cross term together, not summed from the two
# approximations. The cladding is the Sellmeier material `clad` and the core is
# the same glass raised by a constant relative step delta (n1 = n2/sqrt(1 -
# 2 delta)); a constant delta has no dispersion of its own. delta = 0 (either
# sign of zero) is the bulk material, returned as fiber_material_dispersion
# exactly.
# ⚠ WEAK GUIDANCE. b(V) is the scalar LP01 mode, exact only as delta -> 0. Against
# an exact vector (HE11) solution of the same constant-delta silica model the
# error grows ~delta^2: -0.035 ps/(nm km) (0.2% of D) at delta = 0.36%,
# a = 4.1 um, 1.55 um, but -0.49 (11%) at delta = 1%, a = 2 um, and 13% at delta
# near its limit. Use it for standard fibres, not high-contrast waveguides.
# Writes PK_ERR_INVALID_PARAMETER (returns 0) for a null set, a wavelength
# sellmeier_d2n_dlambda2 refuses, delta outside [0, 1/2), (delta > 0) a core
# radius that is not finite and positive or V past 2^48, or a result that is not
# finite.
#must_use
fn fiber_dispersion(clad, delta, core_radius_um, wavelength_um, err_out) {
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    if ((f64_ge(delta, 0) & f64_lt(delta, F64_HALF)) == 0) { return 0; }
    var f[24];
    if (_sellmeier_f012(clad, wavelength_um, &f) == 0) { return 0; }
    var lam = wavelength_um;
    var n2 = f64_sqrt(load64(&f));
    var n2p = f64_div(load64(&f + 8), f64_mul(F64_TWO, n2));
    var n2pp = f64_div(f64_sub(load64(&f + 16), f64_mul(F64_TWO, f64_mul(n2p, n2p))), f64_mul(F64_TWO, n2));
    var kd = _fib_dconst();
    if ((delta & 0x7FFFFFFFFFFFFFFF) == 0) {
        var dm = f64_neg(f64_mul(f64_mul(lam, n2pp), kd));
        if (_fib_finite(dm) == 0) { return 0; }
        store64(err_out, PK_ERR_NONE);
        return dm;
    }
    if (_fib_pos(core_radius_um) == 0) { return 0; }
    var rho = _fib_rho(delta);
    var ka = f64_mul(f64_mul(F64_TAU, core_radius_um), f64_sqrt(rho));
    var v = f64_div(f64_mul(ka, n2), lam);
    if (_fib_v_ok(v) == 0) { return 0; }
    var dv[32];
    _fib_lp01_derivs(v, &dv);
    var b = load64(&dv);
    var bv = load64(&dv + 8);
    var bvv = load64(&dv + 16);
    # V(lambda) = ka n2/lambda:  V' = ka (n2' lambda - n2)/lambda^2,
    # V'' = ka [n2''/lambda - 2 (n2' lambda - n2)/lambda^3].
    var l2 = f64_mul(lam, lam);
    var m = f64_sub(f64_mul(n2p, lam), n2);
    var vl = f64_div(f64_mul(ka, m), l2);
    var vll = f64_mul(ka, f64_sub(f64_div(n2pp, lam), f64_div(f64_mul(F64_TWO, m), f64_mul(l2, lam))));
    # n_eff = n2 Q, Q = sqrt(1 + rho b): Q' = rho b'/(2Q), Q'' = (rho b'' - 2Q'^2)/(2Q).
    var q = f64_sqrt(f64_add(F64_ONE, f64_mul(rho, b)));
    var bl = f64_mul(bv, vl);
    var bll = f64_add(f64_mul(bvv, f64_mul(vl, vl)), f64_mul(bv, vll));
    var ql = f64_div(f64_mul(rho, bl), f64_mul(F64_TWO, q));
    var qll = f64_div(f64_sub(f64_mul(rho, bll), f64_mul(F64_TWO, f64_mul(ql, ql))), f64_mul(F64_TWO, q));
    var npp = f64_add(f64_add(f64_mul(n2pp, q), f64_mul(f64_mul(F64_TWO, n2p), ql)), f64_mul(n2, qll));
    var d = f64_neg(f64_mul(f64_mul(lam, npp), kd));
    if (_fib_finite(d) == 0) { return 0; }
    store64(err_out, PK_ERR_NONE);
    return d;
}

# The zero-dispersion wavelength (um) of fiber_dispersion(clad, delta,
# core_radius_um, .) between lo_um and hi_um: Illinois false position, with a
# bisection whenever three steps have not halved the bracket — at the GEOMETRIC
# mean while the ends are more than a factor 4 apart, so a bracket spanning
# decades converges too (round 2: [1e-3, 1e60] um ran out of steps). Converges to
# 2^-51 relative. delta = 0 finds the MATERIAL zero: 1.2727539 um for fused
# silica, the roadmap's pin. Writes PK_ERR_INVALID_PARAMETER (returns 0) if
# lo_um >= hi_um, if fiber_dispersion refuses either end or any iterate, unless D
# is nonzero with OPPOSITE signs at the two ends, or if the bracket has not
# converged in 400 steps. An end where D is exactly 0 is refused, not returned:
# past ~2e81 um D underflows to 0 (at 1e100 um the true value is -5.1e-295), and
# such an end must not come back as a "zero".
#must_use
fn fiber_zero_dispersion_wavelength(clad, delta, core_radius_um, lo_um, hi_um, err_out) {
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    if (f64_lt(lo_um, hi_um) == 0) { return 0; }
    var e = 0;
    var a = lo_um;
    var b = hi_um;
    var fa = fiber_dispersion(clad, delta, core_radius_um, a, &e);
    if (e != PK_ERR_NONE) { return 0; }
    var fb = fiber_dispersion(clad, delta, core_radius_um, b, &e);
    if (e != PK_ERR_NONE) { return 0; }
    if ((f64_lt(fa, 0) & f64_gt(fb, 0)) == 0) {
        if ((f64_gt(fa, 0) & f64_lt(fb, 0)) == 0) { return 0; }
    }
    var side = 0;
    var c = a;
    var done = 0;
    var wref = f64_sub(b, a);
    var it = 0;
    while ((it < 400) & (done == 0)) {
        c = f64_div(f64_sub(f64_mul(a, fb), f64_mul(b, fa)), f64_sub(fb, fa));
        # Every third step, bisect unless the last three halved the bracket.
        if ((it % 3) == 2) {
            var w = f64_sub(b, a);
            if (f64_gt(w, f64_mul(F64_HALF, wref)) == 1) {
                c = f64_add(a, f64_mul(F64_HALF, w));
                if (f64_gt(b, f64_mul(f64_from(4), a)) == 1) { c = f64_sqrt(f64_mul(a, b)); }
            }
            wref = f64_sub(b, a);
        }
        if ((f64_gt(c, a) & f64_lt(c, b)) == 0) { c = f64_add(a, f64_mul(F64_HALF, f64_sub(b, a))); }
        var fc = fiber_dispersion(clad, delta, core_radius_um, c, &e);
        if (e != PK_ERR_NONE) { return 0; }
        if ((fc & 0x7FFFFFFFFFFFFFFF) == 0) { done = 1; }
        if (done == 0) {
            if (f64_lt(fc, 0) == f64_lt(fb, 0)) {
                b = c;
                fb = fc;
                if (side == 0 - 1) { fa = f64_mul(F64_HALF, fa); }
                side = 0 - 1;
            } else {
                a = c;
                fa = fc;
                if (side == 1) { fb = f64_mul(F64_HALF, fb); }
                side = 1;
            }
            # 2^-51 relative bracket.
            if (f64_le(f64_sub(b, a), f64_mul(b, 0x3CC0000000000000)) == 1) { done = 1; }
        }
        it = it + 1;
    }
    if (done == 0) { return 0; }
    store64(err_out, PK_ERR_NONE);
    return c;
}

# --- ray_grin.cyr ---

# ray_grin.cyr -- gradient-index (GRIN) optics: ray tracing through a continuously
# varying refractive index
# Usage: include "lib/ray_grin.cyr"  (requires error.cyr, ray_core.cyr, ray_trace.cyr)
#
# New in 2.8.0, and NOT a port: the Rust 1.x crate had no GRIN support, so every
# formula here is checked against the literature and closed-form trajectories,
# never against itself.
#
# THE RAY EQUATION. d/ds(n dr/ds) = grad n, written with Sharma, Kumar & Ghatak
# (Appl. Opt. 21, 984 (1982)) in the parameter t, dt = ds/n, and the optical
# direction vector T = n dr/ds:
#   d^2 R/dt^2 = D(R),   D = n grad n = grad(n^2)/2,   T = dR/dt,   |T| = n.
# It is integrated by their Runge-Kutta-Nystrom scheme (fourth order, three D
# evaluations per step — the one at the step's end is reused as the next step's
# first):
#   A = dt D(R),  B = dt D(R + (dt/2) T + (dt/8) A),  C = dt D(R + dt T + (dt/2) B)
#   R' = R + dt (T + (A + 2B)/6),   T' = T + (A + 4B + C)/6
# The optical path OPL = integral n ds = integral n^2 dt rides along with a
# two-point Hermite rule, dt/2 (f0 + f1) + dt^2/12 (f0' - f1') with f = n^2 and
# f' = 2 D.T — fourth order like the rays, and free: n^2 and D at both ends are
# already known.
#
# CONVENTIONS. Lengths in any ONE unit. Radial profiles are symmetric about the
# z axis; spherical ones about (0, 0, cz). The index is the index at ONE
# wavelength (a GRIN material's dispersion is the caller's).
#
# THE STEP is an arc length: each step covers at most `step` of the ray,
# dt = min(step/n(start), step/n(here)) — the cap keeps dt from growing where n
# falls towards 0 (2.8.0 review: a dt fixed at step/n(start) let a ray starting in
# low index run steps n_max/n_start times too long, and returned a NEGATIVE optical
# path as success). The global error is O(step^4) (tests/ray_grin.tcyr pins the
# order); a usable step is small against the profile's scale (step*g << 1 for a
# rod, step << R for a sphere). A step is re-taken at half the length, up to 40
# times, when a stage point has no index or the step is not a step of a ray — T
# turns by more than 0.5 rad, n^2 changes by more than 2x, or the optical path
# does not grow — a trace whose |T| has drifted 10% from n on the way stops at
# once, and one whose |T|^2/n^2 is more than 2e-3 from 1 at the end is refused
# rather than returned. That last check is RELATIVE TO THE INDEX AT THE END: drift
# made where n is large reads (n_max/n_end)^2 larger where the ray lands, so a
# trace landing in much lower index than it crossed needs a proportionally smaller
# step — and may be refused although its result would have been accurate (a
# refusal, never a wrong answer: rescaling the check by n_max let 0.29 rad
# direction errors through, 2.8.0 round 2). None of this is error control: within
# those bounds the error is the method's. Size max_steps to the path: for a ray
# that never arrives, the budget, not the ray, decides when it is refused.

fn _grin_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# 1 if x is finite (not NaN, not +-inf).
fn _grin_finite(x) {
    if ((x & _PRK_ABS) >= _PRK_INF) { return 0; }
    return 1;
}

# 1 if x is finite and strictly positive. f64_gt is false for NaN.
fn _grin_pos(x) {
    if (f64_gt(x, 0) == 0) { return 0; }
    if (x == _PRK_INF) { return 0; }
    return 1;
}

# 1 if x is finite and positive with x^2 a finite NORMAL number — a scale the
# profile formulas can square (n0, g, R). Past about 1.3e154 or below 1.5e-154
# the index is NaN everywhere (2.8.0 review), so such a profile is refused.
fn _grin_sq_ok(x) {
    if (_grin_pos(x) == 0) { return 0; }
    var q = f64_mul(x, x);
    if (q == _PRK_INF) { return 0; }
    if ((q & 0x7FF0000000000000) == 0) { return 0; }
    return 1;
}

# ── Profiles ────────

# Profile tags. The GrinProfile's a1..a6 and cz mean, per kind:
#   GRIN_SELFOC   n^2 = n0^2 [1 - (g r)^2 + h4 (g r)^4 + h6 (g r)^6]   a1 = g, a2 = h4, a3 = h6
#   GRIN_SECH     n = n0 sech(g r)                                     a1 = g
#   GRIN_POLY     n = n0 + nr2 r^2 + nr4 r^4 + nr6 r^6 + nz1 z + nz2 z^2 + nz3 z^3
#                                                  a1..a3 = nr2, nr4, nr6; a4..a6 = nz1, nz2, nz3
#   GRIN_LUNEBURG n^2 = n0^2 (2 - (rho/R)^2)                           a1 = R, cz
#   GRIN_FISHEYE  n = n0 / (1 + (rho/R)^2)                             a1 = R, cz
# with r = sqrt(x^2 + y^2) and rho the distance from (0, 0, cz).
var GRIN_SELFOC = 0;
var GRIN_SECH = 1;
var GRIN_POLY = 2;
var GRIN_LUNEBURG = 3;
var GRIN_FISHEYE = 4;

# A gradient-index profile; see the tags above for what a1..a6 and cz hold.
#derive(accessors)
struct GrinProfile { kind; n0; a1; a2; a3; a4; a5; a6; cz; }

fn _grin_mk(kind, n0, a1, a2, a3, a4, a5, a6, cz, err_out) {
    var p = alloc(sizeof(GrinProfile));
    if (p == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    GrinProfile_set_kind(p, kind);
    GrinProfile_set_n0(p, n0);
    GrinProfile_set_a1(p, a1);
    GrinProfile_set_a2(p, a2);
    GrinProfile_set_a3(p, a3);
    GrinProfile_set_a4(p, a4);
    GrinProfile_set_a5(p, a5);
    GrinProfile_set_a6(p, a6);
    GrinProfile_set_cz(p, cz);
    store64(err_out, PK_ERR_NONE);
    return p;
}

fn _grin_bad(err_out) {
    store64(err_out, PK_ERR_INVALID_PARAMETER);
    return 0;
}

# A radial SELFOC-type rod, in the manufacturer's form
#   n^2(r) = n0^2 [1 - (g r)^2 + h4 (g r)^4 + h6 (g r)^6]
# (g the gradient constant, h4/h6 the higher-order coefficients; h4 = h6 = 0 is the
# parabolic-n^2 profile, whose rays are exactly harmonic in t, and h4 = 2/3,
# h6 = -17/45 matches n0 sech(g r) through sixth order). Paraxial pitch 2*pi/g.
# n0 and g finite and positive with finite normal squares, h4 and h6 finite; else
# PK_ERR_INVALID_PARAMETER and 0. PK_ERR_ALLOCATION and 0 if the struct cannot be allocated.
#must_use
fn grin_selfoc(n0, g, h4, h6, err_out) {
    if (_grin_sq_ok(n0) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(g) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(h4) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(h6) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(f64_mul(n0, g)) == 0) { return _grin_bad(err_out); }
    return _grin_mk(GRIN_SELFOC, n0, g, h4, h6, 0, 0, 0, 0, err_out);
}

# The hyperbolic-secant rod n(r) = n0 sech(g r): every MERIDIONAL ray is periodic
# with period 2*pi/g at any amplitude, sinh(g y) = C sin(g z + phi) — so a
# collimated meridional fan focuses exactly on axis at a quarter pitch. (Skew rays
# do not.) n0 and g finite and positive with finite normal squares; else
# PK_ERR_INVALID_PARAMETER and 0.
#must_use
fn grin_sech(n0, g, err_out) {
    if (_grin_sq_ok(n0) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(g) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(f64_mul(n0, g)) == 0) { return _grin_bad(err_out); }
    return _grin_mk(GRIN_SECH, n0, g, 0, 0, 0, 0, 0, 0, err_out);
}

# A radial-plus-axial polynomial profile (the form lens-design codes call
# "gradient 3"):
#   n = n0 + nr2 r^2 + nr4 r^4 + nr6 r^6 + nz1 z + nz2 z^2 + nz3 z^3
# with z the GLOBAL z (put the rod's front face at z = 0 to measure the axial
# terms from it). Axial GRIN is nr2 = nr4 = nr6 = 0. n0 finite and positive with a
# finite normal square, every coefficient finite; else PK_ERR_INVALID_PARAMETER and 0. Where n <= 0 there is no
# index: grin_index is NaN there. (A ray only approaches a zero of n: an oblique
# one turns back as a mirage, PK_ERR_TIR; one running head-on is refused,
# PK_ERR_INVALID_PARAMETER — see grin_trace_to_plane.)
#must_use
fn grin_polynomial(n0, nr2, nr4, nr6, nz1, nz2, nz3, err_out) {
    if (_grin_sq_ok(n0) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(nr2) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(nr4) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(nr6) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(nz1) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(nz2) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(nz3) == 0) { return _grin_bad(err_out); }
    return _grin_mk(GRIN_POLY, n0, nr2, nr4, nr6, nz1, nz2, nz3, 0, err_out);
}

# The Luneburg lens: a sphere of radius R about (0, 0, cz) with
#   n = n_surface * sqrt(2 - (rho/R)^2),
# n_surface at its rim, so in a medium of that index a collimated beam is focused
# perfectly on the far side of the sphere — every ray, at every height (Luneburg
# 1944). The LAW holds for rho < sqrt(2) R; the lens is the ball rho <= R, which
# is what grin_ball_trace traces. n_surface and R finite and positive with finite
# normal squares, cz finite; else PK_ERR_INVALID_PARAMETER and 0.
#must_use
fn grin_luneburg(n_surface, radius, cz, err_out) {
    if (_grin_sq_ok(n_surface) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(radius) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(cz) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(f64_div(n_surface, radius)) == 0) { return _grin_bad(err_out); }
    return _grin_mk(GRIN_LUNEBURG, n_surface, radius, 0, 0, 0, 0, 0, cz, err_out);
}

# Maxwell's fish-eye about (0, 0, cz): n = n0 / (1 + (rho/R)^2). Every ray is a
# circle, and every ray from a point P meets again at its inversion
# -R^2 P/|P|^2 (relative to the centre) — a point on the sphere rho = R images to
# its antipode, with optical path n0*pi*R/2 on every ray (Maxwell 1854). n0 and R
# finite and positive with finite normal squares, cz finite; else
# PK_ERR_INVALID_PARAMETER and 0.
#must_use
fn grin_maxwell_fisheye(n0, radius, cz, err_out) {
    if (_grin_sq_ok(n0) == 0) { return _grin_bad(err_out); }
    if (_grin_sq_ok(radius) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(cz) == 0) { return _grin_bad(err_out); }
    var nr = f64_div(n0, radius);
    if (_grin_sq_ok(nr) == 0) { return _grin_bad(err_out); }
    if (_grin_finite(f64_mul(F64_TWO, f64_mul(nr, nr))) == 0) { return _grin_bad(err_out); }
    return _grin_mk(GRIN_FISHEYE, n0, radius, 0, 0, 0, 0, 0, cz, err_out);
}

# expm1(y) accurate for small |y| (Kahan: (e^y - 1) * y / ln(e^y) cancels the
# rounding of e^y). Only the sech profile needs it: 1 - e^(-2u) near the axis.
fn _grin_expm1(y) {
    var w = f64_exp(y);
    if (w == F64_ONE) { return y; }
    var wm = f64_sub(w, F64_ONE);
    if (f64_gt(f64_abs(y), F64_HALF) == 1) { return wm; }
    return f64_div(f64_mul(wm, y), f64_ln(w));
}

# D = grad(n^2)/2 and n^2 at (x, y, z) into out[0..3]. Returns 1, or 0 where the
# profile has no physical index: n^2 not finite and positive (SELFOC past its
# zero, a polynomial with n <= 0) or a non-finite gradient.
fn _grin_eval(p, x, y, z, out) {
    var kind = GrinProfile_kind(p);
    var n0 = GrinProfile_n0(p);
    var n02 = f64_mul(n0, n0);
    var n2 = 0;
    var dx = 0;
    var dy = 0;
    var dz = 0;
    if (kind == GRIN_SELFOC) {
        var g = GrinProfile_a1(p);
        var g2 = f64_mul(g, g);
        var h4 = GrinProfile_a2(p);
        var h6 = GrinProfile_a3(p);
        var u = f64_mul(g2, f64_add(f64_mul(x, x), f64_mul(y, y)));
        var poly = f64_add(f64_neg(F64_ONE), f64_mul(u, f64_add(h4, f64_mul(u, h6))));
        n2 = f64_mul(n02, f64_add(F64_ONE, f64_mul(u, poly)));
        var s = f64_mul(f64_mul(n02, g2),
          f64_add(f64_neg(F64_ONE), f64_mul(u, f64_add(f64_mul(F64_TWO, h4), f64_mul(f64_from(3), f64_mul(h6, u))))));
        dx = f64_mul(s, x);
        dy = f64_mul(s, y);
    }
    if (kind == GRIN_SECH) {
        var gs = GrinProfile_a1(p);
        var u2 = f64_mul(gs, f64_sqrt(f64_add(f64_mul(x, x), f64_mul(y, y))));
        var e = f64_exp(f64_mul(f64_from(0 - 2), u2));
        var op = f64_add(F64_ONE, e);
        n2 = f64_div(f64_mul(n02, f64_mul(f64_from(4), e)), f64_mul(op, op));
        # tanh(u)/u = (1 - e^(-2u)) / ((1 + e^(-2u)) u), 1 at u = 0.
        var tu = F64_ONE;
        if (f64_gt(u2, 0x3E50000000000000) == 1) {
            tu = f64_div(f64_neg(_grin_expm1(f64_mul(f64_from(0 - 2), u2))), f64_mul(op, u2));
        }
        var ss = f64_neg(f64_mul(f64_mul(n2, f64_mul(gs, gs)), tu));
        dx = f64_mul(ss, x);
        dy = f64_mul(ss, y);
    }
    if (kind == GRIN_POLY) {
        var r2 = f64_add(f64_mul(x, x), f64_mul(y, y));
        var a1 = GrinProfile_a1(p);
        var a2 = GrinProfile_a2(p);
        var a3 = GrinProfile_a3(p);
        var a4 = GrinProfile_a4(p);
        var a5 = GrinProfile_a5(p);
        var a6 = GrinProfile_a6(p);
        var nn = f64_add(f64_add(n0, f64_mul(r2, f64_add(a1, f64_mul(r2, f64_add(a2, f64_mul(r2, a3)))))),
          f64_mul(z, f64_add(a4, f64_mul(z, f64_add(a5, f64_mul(z, a6))))));
        if (f64_gt(nn, 0) == 0) { return 0; }
        n2 = f64_mul(nn, nn);
        var gr = f64_add(f64_mul(F64_TWO, a1),
          f64_mul(r2, f64_add(f64_mul(f64_from(4), a2), f64_mul(f64_from(6), f64_mul(a3, r2)))));
        var gz = f64_add(a4, f64_mul(z, f64_add(f64_mul(F64_TWO, a5), f64_mul(f64_from(3), f64_mul(a6, z)))));
        dx = f64_mul(f64_mul(nn, gr), x);
        dy = f64_mul(f64_mul(nn, gr), y);
        dz = f64_mul(nn, gz);
    }
    if (kind >= GRIN_LUNEBURG) {
        var rr = GrinProfile_a1(p);
        var rr2 = f64_mul(rr, rr);
        var zc = f64_sub(z, GrinProfile_cz(p));
        var rho2 = f64_div(f64_add(f64_add(f64_mul(x, x), f64_mul(y, y)), f64_mul(zc, zc)), rr2);
        var sl = 0;
        if (kind == GRIN_LUNEBURG) {
            n2 = f64_mul(n02, f64_sub(F64_TWO, rho2));
            sl = f64_neg(f64_div(n02, rr2));
        } else {
            # An unknown tag is not a fish-eye: no index (grin_* refuse it first).
            if (kind != GRIN_FISHEYE) { return 0; }
            var q = f64_add(F64_ONE, rho2);
            n2 = f64_div(n02, f64_mul(q, q));
            sl = f64_neg(f64_div(f64_mul(F64_TWO, n2), f64_mul(rr2, q)));
        }
        dx = f64_mul(sl, x);
        dy = f64_mul(sl, y);
        dz = f64_mul(sl, zc);
    }
    if (_grin_pos(n2) == 0) { return 0; }
    if (_grin_finite(f64_add(f64_add(dx, dy), dz)) == 0) { return 0; }
    store64(out, dx);
    store64(out + 8, dy);
    store64(out + 16, dz);
    store64(out + 24, n2);
    return 1;
}

# 1 if p is a profile handle with a known tag.
fn _grin_kind_ok(p) {
    if (p == 0) { return 0; }
    var k = GrinProfile_kind(p);
    if ((k < GRIN_SELFOC) | (k > GRIN_FISHEYE)) { return 0; }
    return 1;
}

# The index at (x, y, z), or NaN for a null profile, a non-finite coordinate, or a
# point where the profile has no physical index (see _grin_eval).
#must_use
fn grin_index(profile, x, y, z) {
    if (_grin_kind_ok(profile) == 0) { return _PRK_NAN; }
    if (_grin_finite(f64_add(f64_add(x, y), z)) == 0) { return _PRK_NAN; }
    var w[32];
    if (_grin_eval(profile, x, y, z, &w) == 0) { return _PRK_NAN; }
    return f64_sqrt(load64(&w + 24));
}

# grad n at (x, y, z) into out[0..2] (three f64). Returns PK_ERR_NONE, or
# PK_ERR_INVALID_PARAMETER for a null profile/out or a non-finite coordinate, or
# PK_ERR_INVALID_INDEX where the profile has no physical index; out is untouched on
# an error.
fn grin_gradient(profile, x, y, z, out) {
    if (_grin_kind_ok(profile) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_finite(f64_add(f64_add(x, y), z)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var w[32];
    if (_grin_eval(profile, x, y, z, &w) == 0) { return PK_ERR_INVALID_INDEX; }
    var n = f64_sqrt(load64(&w + 24));
    store64(out, f64_div(load64(&w), n));
    store64(out + 8, f64_div(load64(&w + 8), n));
    store64(out + 16, f64_div(load64(&w + 16), n));
    return PK_ERR_NONE;
}

# ── The integrator ────────
# A state is 10 f64: R (0..2), T (3..5), D(R) (6..8), n^2(R) (9).

# One Runge-Kutta-Nystrom step of dt from state s into state o. Returns 1, or 0 if
# any stage point has no physical index.
fn _grin_step(p, s, dt, o) {
    var w[32];
    var x = load64(s);
    var y = load64(s + 8);
    var z = load64(s + 16);
    var tx = load64(s + 24);
    var ty = load64(s + 32);
    var tz = load64(s + 40);
    var ax = load64(s + 48);
    var ay = load64(s + 56);
    var az = load64(s + 64);
    var hdt = f64_mul(F64_HALF, dt);
    var dt2 = f64_mul(dt, dt);
    var q8 = f64_mul(dt2, _grin_r(1, 8));
    # B point: R + (dt/2) T + (dt^2/8) D(R).
    var px = f64_add(f64_add(x, f64_mul(hdt, tx)), f64_mul(q8, ax));
    var py = f64_add(f64_add(y, f64_mul(hdt, ty)), f64_mul(q8, ay));
    var pz = f64_add(f64_add(z, f64_mul(hdt, tz)), f64_mul(q8, az));
    if (_grin_eval(p, px, py, pz, &w) == 0) { return 0; }
    var bx = load64(&w);
    var by = load64(&w + 8);
    var bz = load64(&w + 16);
    # C point: R + dt T + (dt^2/2) D(B).
    var q2 = f64_mul(F64_HALF, dt2);
    px = f64_add(f64_add(x, f64_mul(dt, tx)), f64_mul(q2, bx));
    py = f64_add(f64_add(y, f64_mul(dt, ty)), f64_mul(q2, by));
    pz = f64_add(f64_add(z, f64_mul(dt, tz)), f64_mul(q2, bz));
    if (_grin_eval(p, px, py, pz, &w) == 0) { return 0; }
    var cx = load64(&w);
    var cy = load64(&w + 8);
    var cz = load64(&w + 16);
    var q6 = f64_div(dt2, f64_from(6));
    var d6 = f64_div(dt, f64_from(6));
    var nx = f64_add(f64_add(x, f64_mul(dt, tx)), f64_mul(q6, f64_add(ax, f64_mul(F64_TWO, bx))));
    var ny = f64_add(f64_add(y, f64_mul(dt, ty)), f64_mul(q6, f64_add(ay, f64_mul(F64_TWO, by))));
    var nz = f64_add(f64_add(z, f64_mul(dt, tz)), f64_mul(q6, f64_add(az, f64_mul(F64_TWO, bz))));
    var f4 = f64_from(4);
    store64(o, nx);
    store64(o + 8, ny);
    store64(o + 16, nz);
    store64(o + 24, f64_add(tx, f64_mul(d6, f64_add(f64_add(ax, f64_mul(f4, bx)), cx))));
    store64(o + 32, f64_add(ty, f64_mul(d6, f64_add(f64_add(ay, f64_mul(f4, by)), cy))));
    store64(o + 40, f64_add(tz, f64_mul(d6, f64_add(f64_add(az, f64_mul(f4, bz)), cz))));
    return _grin_eval(p, nx, ny, nz, o + 48);
}

# D.T of a state.
fn _grin_dt(s) {
    return f64_add(f64_add(f64_mul(load64(s + 48), load64(s + 24)), f64_mul(load64(s + 56), load64(s + 32))),
      f64_mul(load64(s + 64), load64(s + 40)));
}

# |T|^2 of a state.
fn _grin_t2(s) {
    return f64_add(f64_add(f64_mul(load64(s + 24), load64(s + 24)), f64_mul(load64(s + 32), load64(s + 32))),
      f64_mul(load64(s + 40), load64(s + 40)));
}

# The optical path over a step of dt from state a to state b (Hermite, n^2 and
# d(n^2)/dt = 2 D.T at both ends).
fn _grin_opl(a, b, dt) {
    var tr = f64_mul(f64_mul(F64_HALF, dt), f64_add(load64(a + 72), load64(b + 72)));
    return f64_add(tr, f64_mul(f64_div(f64_mul(dt, dt), f64_from(6)), f64_sub(_grin_dt(a), _grin_dt(b))));
}

# 1 if the step a -> b of dt is a step of a RAY: T turns by at most 0.5 rad, n^2
# changes by at most 2x, and the optical path grows. Deliberately loose — it
# catches a step that has left the method's regime (the 2.8.0 review's coarse
# steps returned n = 6.7e20 and a negative optical path as success), not ordinary
# truncation error. A failing step is re-taken shorter. Writes the step's optical
# path to dopl.
fn _grin_sane(a, b, dt, dopl) {
    var dot = f64_add(f64_add(f64_mul(load64(a + 24), load64(b + 24)), f64_mul(load64(a + 32), load64(b + 32))),
      f64_mul(load64(a + 40), load64(b + 40)));
    if (f64_gt(dot, 0) == 0) { return 0; }
    # dot^2 >= cos^2(0.5) |Ta|^2 |Tb|^2
    if (f64_lt(f64_mul(dot, dot), f64_mul(0x3FE8A51407DA8346, f64_mul(_grin_t2(a), _grin_t2(b)))) == 1) { return 0; }
    var na = load64(a + 72);
    var nb = load64(b + 72);
    if (f64_gt(nb, f64_mul(F64_TWO, na)) == 1) { return 0; }
    if (f64_gt(na, f64_mul(F64_TWO, nb)) == 1) { return 0; }
    var d = _grin_opl(a, b, dt);
    store64(dopl, d);
    if (f64_gt(d, 0) == 0) { return 0; }
    return 1;
}

# 1 if a state still carries the ray's one exact invariant, |T| = n, to 1e-3
# (|T|^2/n^2 within 2e-3 of 1). NaN fails.
fn _grin_held(s) {
    var r = f64_div(_grin_t2(s), load64(s + 72));
    if (f64_le(f64_abs(f64_sub(r, F64_ONE)), 0x3F60624DD2F1A9FC) == 1) { return 1; }
    return 0;
}

# The peak over u in (0, 1) of the cubic Hermite interpolant of f on a step of dt,
# from f0, f1 and their t-derivatives d0, d1 — O(dt^4) like the step itself — when
# f rises then falls inside the step (d0 > 0 > d1); else the larger end. Writes the
# peak's fraction of the step to uout (0 when it is an end).
fn _grin_cpeak(f0, f1, d0, d1, dt, uout) {
    store64(uout, 0);
    var m = f0;
    if (f64_gt(f1, m) == 1) { m = f1; }
    if (f64_gt(d0, 0) == 0) { return m; }
    if (f64_lt(d1, 0) == 0) { return m; }
    # f(u) = f0 + c1 u + c2 u^2 + c3 u^3 on u in [0, 1]; f'(0) > 0 > f'(1).
    var c1 = f64_mul(dt, d0);
    var c2 = f64_sub(f64_sub(f64_mul(f64_from(3), f64_sub(f1, f0)), f64_mul(F64_TWO, c1)), f64_mul(dt, d1));
    var c3 = f64_add(f64_add(f64_mul(F64_TWO, f64_sub(f0, f1)), c1), f64_mul(dt, d1));
    # f'(u) = c1 + 2 c2 u + 3 c3 u^2 = 0: its two roots in cancellation-free form are
    # c1/qq and qq/(3 c3), qq = -(c2 + sign(c2) sqrt(c2^2 - 3 c1 c3)). (2.8.0 round 2:
    # the first cut took c1/(-qq), so a peak inside a step was never found.)
    var qa = f64_mul(f64_from(3), c3);
    var disc = f64_sub(f64_mul(c2, c2), f64_mul(qa, c1));
    if (f64_lt(disc, 0) == 1) { disc = 0; }
    var sq = f64_sqrt(disc);
    var qq = f64_neg(f64_add(c2, sq));
    if (f64_lt(c2, 0) == 1) { qq = f64_neg(f64_sub(c2, sq)); }
    var k = 0;
    while (k < 2) {
        var u = f64_div(c1, qq);
        if (k == 1) { u = f64_div(qq, qa); }
        if ((f64_gt(u, 0) & f64_lt(u, F64_ONE)) == 1) {
            var f = f64_add(f64_add(f0, f64_mul(c1, u)), f64_mul(f64_mul(u, u), f64_add(c2, f64_mul(c3, u))));
            if (f64_gt(f, m) == 1) {
                m = f;
                store64(uout, u);
            }
        }
        k = k + 1;
    }
    return m;
}

# The largest r^2 = x^2 + y^2 over the step a -> b of dt (d r^2/dt = 2 (x T_x +
# y T_y)): a rod's wall is met between step ends too.
fn _grin_r2max(a, b, dt) {
    var fa = f64_add(f64_mul(load64(a), load64(a)), f64_mul(load64(a + 8), load64(a + 8)));
    var fb = f64_add(f64_mul(load64(b), load64(b)), f64_mul(load64(b + 8), load64(b + 8)));
    var da = f64_mul(F64_TWO, f64_add(f64_mul(load64(a), load64(a + 24)), f64_mul(load64(a + 8), load64(a + 32))));
    var db = f64_mul(F64_TWO, f64_add(f64_mul(load64(b), load64(b + 24)), f64_mul(load64(b + 8), load64(b + 32))));
    var u = 0;
    return _grin_cpeak(fa, fb, da, db, dt, &u);
}

# The stop function: < 0 before the boundary, >= 0 at or past it. stop 0 is the
# plane z = c1 approached from the side sig (+1: from below); stop 1 is the
# sphere of radius c2 about (0, 0, c1), left from inside.
fn _grin_g(s, stop, c1, c2, sig) {
    if (stop == 0) { return f64_mul(sig, f64_sub(load64(s + 16), c1)); }
    var zc = f64_sub(load64(s + 16), c1);
    var r2 = f64_add(f64_add(f64_mul(load64(s), load64(s)), f64_mul(load64(s + 8), load64(s + 8))), f64_mul(zc, zc));
    return f64_sub(r2, f64_mul(c2, c2));
}

# dg/dt of a state.
fn _grin_gd(s, stop, c1, sig) {
    if (stop == 0) { return f64_mul(sig, load64(s + 40)); }
    var zc = f64_sub(load64(s + 16), c1);
    return f64_mul(F64_TWO, f64_add(f64_add(f64_mul(load64(s), load64(s + 24)), f64_mul(load64(s + 8), load64(s + 32))),
        f64_mul(zc, load64(s + 40))));
}

# The straight-line estimate of the t to the boundary from state s — the plane's
# -g/(dg/dt), the sphere chord's far root — or 0 when the line never reaches it.
fn _grin_tau(s, stop, c1, c2, sig) {
    var g = _grin_g(s, stop, c1, c2, sig);
    var gd = _grin_gd(s, stop, c1, sig);
    if (stop == 0) {
        if (f64_gt(gd, 0) == 0) { return 0; }
        return f64_div(f64_neg(g), gd);
    }
    # |R + tau T - c|^2 - rho^2 = g + gd tau + |T|^2 tau^2.
    var qa = _grin_t2(s);
    var disc = f64_sub(f64_mul(gd, gd), f64_mul(f64_from(4), f64_mul(qa, g)));
    if (f64_lt(disc, 0) == 1) { return 0; }
    var sq = f64_sqrt(disc);
    if (f64_gt(gd, 0) == 1) {
        var den = f64_add(gd, sq);
        if (f64_gt(den, 0) == 0) { return 0; }
        return f64_div(f64_mul(F64_TWO, f64_neg(g)), den);
    }
    return f64_div(f64_add(f64_neg(gd), sq), f64_mul(F64_TWO, qa));
}

# The first t > 0 at which the step's own quadratic, g + g' t + g'' t^2/2 with the
# curvature D, predicts the boundary; 0 when it predicts none. (The straight chord
# alone is tiny for a ray skimming inside a sphere while the curved ray stays in:
# 2.8.0 round 2 measured 1000x the steps for a Luneburg ray 1e-12 R from the rim.)
fn _grin_tau2(s, stop, c1, c2, sig, dt) {
    var g = _grin_g(s, stop, c1, c2, sig);
    var b = _grin_gd(s, stop, c1, sig);
    var a = f64_mul(F64_HALF, f64_mul(sig, load64(s + 64)));
    if (stop == 1) {
        # g'' / 2 = |T|^2 + (R - c).D
        var zc = f64_sub(load64(s + 16), c1);
        var rd = f64_add(f64_mul(load64(s), load64(s + 48)), f64_mul(load64(s + 8), load64(s + 56)));
        a = f64_add(_grin_t2(s), f64_add(rd, f64_mul(zc, load64(s + 64))));
    }
    # a t^2 + b t + g = 0 with g < 0: the smallest positive root — unless the
    # quadratic cannot climb to 0 within dt at all (the usual case, far from it).
    if (f64_gt(g, 0) == 1) { return 0; }
    if (f64_lt(f64_add(g, f64_mul(dt, f64_add(f64_abs(b), f64_mul(dt, f64_abs(a))))), 0) == 1) { return 0; }
    var disc = f64_sub(f64_mul(b, b), f64_mul(f64_from(4), f64_mul(a, g)));
    if (f64_lt(disc, 0) == 1) { return 0; }
    var q = f64_neg(f64_mul(F64_HALF, f64_add(b, f64_sqrt(disc))));
    if (f64_lt(b, 0) == 1) { q = f64_neg(f64_mul(F64_HALF, f64_sub(b, f64_sqrt(disc)))); }
    var best = 0;
    if (f64_gt(f64_abs(q), 0) == 1) {
        var r1 = f64_div(g, q);
        if (f64_gt(r1, 0) == 1) { best = r1; }
    }
    if (f64_gt(f64_abs(a), 0) == 1) {
        var r2 = f64_div(q, a);
        if (f64_gt(r2, 0) == 1) {
            if ((best == 0) | (f64_lt(r2, best) == 1)) { best = r2; }
        }
    }
    return best;
}

# 1 if the profile has no axial gradient (T_z is then conserved exactly: a ray
# not heading for a plane never reaches it).
fn _grin_zinv(p) {
    var k = GrinProfile_kind(p);
    if ((k == GRIN_SELFOC) | (k == GRIN_SECH)) { return 1; }
    if (k != GRIN_POLY) { return 0; }
    var az = (GrinProfile_a4(p) | GrinProfile_a5(p) | GrinProfile_a6(p)) & _PRK_ABS;
    if (az == 0) { return 1; }
    return 0;
}

fn _grin_copy(dst, src) {
    for (var i = 0; i < 80; i = i + 8) { store64(dst + i, load64(src + i)); }
    return 0;
}

# Accept the step a -> b of tau as the one that ends on the boundary: check it
# (a step of a ray, the invariant held, inside the cylinder), snap the end onto the
# boundary (the plane's z set to it, the sphere's radius rescaled to it — both
# rounding-level corrections), and write the end state and the optical path.
fn _grin_finish(a, b, tau, stop, c1, c2, cyl2, opl, sout, opl_out) {
    var dop = 0;
    if (_grin_sane(a, b, tau, &dop) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_held(b) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (cyl2 != _PRK_INF) {
        if (f64_gt(_grin_r2max(a, b, tau), cyl2) == 1) { return PK_ERR_INVALID_PARAMETER; }
    }
    var total = f64_add(opl, dop);
    _grin_copy(sout, b);
    if (stop == 0) {
        store64(sout + 16, c1);
    } else {
        var ex = load64(b);
        var ey = load64(b + 8);
        var ez = f64_sub(load64(b + 16), c1);
        var sc = f64_div(c2, f64_sqrt(f64_add(f64_add(f64_mul(ex, ex), f64_mul(ey, ey)), f64_mul(ez, ez))));
        store64(sout, f64_mul(ex, sc));
        store64(sout + 8, f64_mul(ey, sc));
        store64(sout + 16, f64_add(c1, f64_mul(ez, sc)));
    }
    store64(opl_out, total);
    return PK_ERR_NONE;
}

# Trace state s0 to the boundary — stop 0: the plane z = c1; stop 1: the sphere of
# radius c2 about (0, 0, c1), left from inside — in steps of arc length at most
# `step` (see the header), then one partial step whose length Newton finds, so the
# ray ends ON the boundary. cyl2 is the square of the radius of a cylinder about
# the z axis the ray must stay inside (a rod's wall; +inf for none). Writes the end
# state to sout and the optical path to opl_out. Returns PK_ERR_NONE, or:
# - PK_ERR_INVALID_INDEX if a step meets a point with no index even at 2^-40 of
#   its length;
# - PK_ERR_TIR if the budget runs out on a plane trace whose ray, once heading for
#   the plane, turned away (a gradient-index mirage: an oblique ray turns back where
#   n falls to its transverse invariant);
# - PK_ERR_INVALID_PARAMETER if the budget runs out otherwise, a plane trace's ray
#   heads away in a profile with no axial gradient (it can never arrive), a sphere
#   trace starts outside, the ray meets the cylinder, a step cannot move the ray,
#   a step is not a step of a ray even at 2^-40 of its length (a ray running
#   HEAD-ON into n -> 0, whose T reverses in every step, ends here), or the
#   landing fails its checks.
fn _grin_run(p, s0, stop, c1, c2, step, max_steps, cyl2, sout, opl_out) {
    var ba[80];
    var bb[80];
    var bt[80];
    var cur = &ba;
    var nxt = &bb;
    var opl = 0;
    store64(opl_out, 0);
    _grin_copy(cur, s0);
    var dt0 = f64_div(step, f64_sqrt(load64(s0 + 72)));
    var sig = F64_ONE;
    var gscale = 0;
    var toward = 0;
    var turned = 0;
    if (stop == 0) {
        # On the plane already (either signed zero).
        if ((f64_sub(load64(s0 + 16), c1) & _PRK_ABS) == 0) {
            _grin_copy(sout, cur);
            return PK_ERR_NONE;
        }
        if (f64_gt(load64(s0 + 16), c1) == 1) { sig = f64_neg(F64_ONE); }
        if (f64_gt(f64_mul(sig, load64(s0 + 40)), 0) == 1) { toward = 1; }
        if (toward == 0) {
            if (_grin_zinv(p) == 1) { return PK_ERR_INVALID_PARAMETER; }
        }
    } else {
        # g carries ~2 rho ulp(|c| + rho) of rounding (2.8.0 review: a scale of
        # rho^2 alone refused every trace of a ball 2000 radii from the origin).
        gscale = f64_mul(c2, f64_add(c2, f64_abs(c1)));
        var gstart = f64_add(f64_mul(f64_mul(c2, c2), _grin_r(1, 1000000000)), f64_mul(gscale, 0x3CF0000000000000));
        var g0 = _grin_g(cur, 1, c1, c2, sig);
        if (f64_gt(g0, gstart) == 1) { return PK_ERR_INVALID_PARAMETER; }
        # On the sphere (to rounding) it must head in: a tangent start follows the
        # rim or leaves at once depending on the first step's rounding (round 2).
        if (f64_gt(g0, f64_neg(gstart)) == 1) {
            if (f64_ge(_grin_gd(cur, 1, c1, sig), 0) == 1) { return PK_ERR_INVALID_PARAMETER; }
        }
    }
    var r20 = f64_add(f64_mul(load64(s0), load64(s0)), f64_mul(load64(s0 + 8), load64(s0 + 8)));
    if (f64_gt(r20, cyl2) == 1) { return PK_ERR_INVALID_PARAMETER; }
    # Every fish-eye ray is a closed circle of optical length pi n0 R, so a real
    # arrival comes within one loop; past two the integrator's drift, not the ray,
    # would decide (2.8.0 round 2: a never-arriving orbit precessed into the plane
    # and "arrived" once max_steps allowed it).
    var oplcap = _PRK_INF;
    if (GrinProfile_kind(p) == GRIN_FISHEYE) {
        oplcap = f64_mul(F64_TAU, f64_mul(GrinProfile_n0(p), GrinProfile_a1(p)));
    }
    var i = 0;
    while (i < max_steps) {
        var dt = dt0;
        var dn = f64_div(step, f64_sqrt(load64(cur + 72)));
        if (f64_lt(dn, dt) == 1) { dt = dn; }
        # Shorten a step that would overshoot the boundary — as the step's own
        # quadratic predicts it — by more than 1/8, so stage points stay near the
        # medium (floored at 1/1024 of the step, so the ray always moves).
        var te = _grin_tau2(cur, stop, c1, c2, sig, dt);
        if (f64_gt(te, 0) == 1) {
            var tc = f64_mul(te, _grin_r(9, 8));
            var tf = f64_mul(dt, _grin_r(1, 1024));
            if (f64_lt(tc, tf) == 1) { tc = tf; }
            if (f64_lt(tc, dt) == 1) { dt = tc; }
        }
        var nh = 0;
        var ok = 0;
        var why = PK_ERR_INVALID_INDEX;
        var dop = 0;
        while (nh <= 40) {
            if (_grin_step(p, cur, dt, nxt) == 1) {
                if (_grin_sane(cur, nxt, dt, &dop) == 1) {
                    ok = 1;
                    break;
                }
                why = PK_ERR_INVALID_PARAMETER;
            } else {
                why = PK_ERR_INVALID_INDEX;
            }
            dt = f64_mul(F64_HALF, dt);
            nh = nh + 1;
        }
        if (ok == 0) { return why; }
        # A step below the coordinates' resolution: no budget can finish the trace.
        var same = 0;
        if (load64(nxt) == load64(cur)) {
            if (load64(nxt + 8) == load64(cur + 8)) {
                if (load64(nxt + 16) == load64(cur + 16)) { same = 1; }
            }
        }
        if (same == 1) { return PK_ERR_INVALID_PARAMETER; }
        # A ray whose |T| has lost 10% against n cannot reach where the true ray
        # does: stop now. An early exit — the landing check or the budget would
        # refuse it later — so its cost, not its verdict, is what it saves (round 2
        # measured 2 s for a 50-step trace at max_steps 1e6 before the fish-eye
        # loop cap below took that case too).
        if (f64_le(f64_abs(f64_sub(f64_div(_grin_t2(nxt), load64(nxt + 72)), F64_ONE)), _grin_r(1, 10)) == 0) {
            return PK_ERR_INVALID_PARAMETER;
        }
        var gn = _grin_g(nxt, stop, c1, c2, sig);
        var land = 0;
        var hi = dt;
        if (f64_ge(gn, 0) == 1) {
            if ((gn & _PRK_ABS) == 0) { return _grin_finish(cur, nxt, dt, stop, c1, c2, cyl2, opl, sout, opl_out); }
            land = 1;
        } else {
            # A crossing and a return INSIDE the step — a ray grazing out of a
            # sphere through a thin cap, a plane just past a mirage's turning point
            # — shows as a peak of g between two negative ends. (2.8.0 round 2: only
            # the ends were tested, so such a ray was traced on as if it never
            # left.) The step's cubic finds the peak; one RKN step confirms it.
            var up = 0;
            var gpk = gn;
            var d1n = _grin_gd(nxt, stop, c1, sig);
            if (f64_lt(d1n, 0) == 1) {
                var g0c = _grin_g(cur, stop, c1, c2, sig);
                gpk = _grin_cpeak(g0c, gn, _grin_gd(cur, stop, c1, sig), d1n, dt, &up);
            }
            if (f64_gt(gpk, 0) == 1) {
                if (f64_gt(up, 0) == 1) {
                    var tpk = f64_mul(up, dt);
                    if (_grin_step(p, cur, tpk, &bt) == 1) {
                        if (f64_ge(_grin_g(&bt, stop, c1, c2, sig), 0) == 1) {
                            hi = tpk;
                            land = 1;
                        }
                    }
                }
            }
        }
        if (land == 1) {
            # The crossing is in (0, hi]: find tau with safeguarded Newton on
            # g(step(tau)) = 0.
            var gs = gscale;
            if (stop == 0) { gs = f64_add(f64_abs(c1), f64_mul(dt, f64_sqrt(load64(cur + 72)))); }
            var lo = 0;
            var tau = _grin_tau(cur, stop, c1, c2, sig);
            if (f64_gt(tau, 0) == 0) { tau = f64_mul(F64_HALF, hi); }
            if (f64_gt(tau, hi) == 1) { tau = hi; }
            var done = 0;
            var it = 0;
            while (it < 60) {
                if (_grin_step(p, cur, tau, &bt) == 0) { return PK_ERR_INVALID_INDEX; }
                var h = _grin_g(&bt, stop, c1, c2, sig);
                if (f64_le(f64_abs(h), f64_mul(gs, 0x3CB0000000000000)) == 1) {
                    done = 1;
                    break;
                }
                if (f64_gt(h, 0) == 1) { hi = tau; } else { lo = tau; }
                var tn = f64_sub(tau, f64_div(h, _grin_gd(&bt, stop, c1, sig)));
                # Newton unless it leaves the bracket (or dg/dt is 0/NaN): then bisect.
                if (f64_gt(tn, lo) == 0) { tn = f64_mul(F64_HALF, f64_add(lo, hi)); }
                if (f64_lt(tn, hi) == 0) { tn = f64_mul(F64_HALF, f64_add(lo, hi)); }
                # A correction at the ulp scale of dt: h is rounding noise, and &bt
                # (the state at tau) is the answer. Waiting for tn == tau instead
                # can cycle on that noise.
                if (f64_le(f64_abs(f64_sub(tn, tau)), f64_mul(dt, 0x3CD0000000000000)) == 1) {
                    done = 1;
                    break;
                }
                tau = tn;
                it = it + 1;
            }
            if (done == 0) { return PK_ERR_INVALID_PARAMETER; }
            if (f64_gt(f64_abs(_grin_g(&bt, stop, c1, c2, sig)), f64_mul(gs, _grin_r(1, 1000000000000))) == 1) {
                return PK_ERR_INVALID_PARAMETER;
            }
            return _grin_finish(cur, &bt, tau, stop, c1, c2, cyl2, opl, sout, opl_out);
        }
        if (cyl2 != _PRK_INF) {
            if (f64_gt(_grin_r2max(cur, nxt, dt), cyl2) == 1) { return PK_ERR_INVALID_PARAMETER; }
        }
        opl = f64_add(opl, dop);
        if (f64_gt(opl, oplcap) == 1) { break; }
        if (stop == 0) {
            var tw = 0;
            if (f64_gt(f64_mul(sig, load64(nxt + 40)), 0) == 1) { tw = 1; }
            if ((toward == 1) & (tw == 0)) { turned = 1; }
            toward = tw;
        }
        var tmp = cur;
        cur = nxt;
        nxt = tmp;
        i = i + 1;
    }
    if (turned == 1) { return PK_ERR_TIR; }
    return PK_ERR_INVALID_PARAMETER;
}

# (dx, dy, dz) scaled to unit length into out[0..2] — by the largest component
# first, so no square over- or underflows (2.8.0 review: a finite direction of
# 1e154 was refused and one of 1e-162 lost bits). Returns 1, or 0 for a zero or
# non-finite vector.
fn _grin_unit(dx, dy, dz, out) {
    var m = f64_abs(dx);
    if (f64_gt(f64_abs(dy), m) == 1) { m = f64_abs(dy); }
    if (f64_gt(f64_abs(dz), m) == 1) { m = f64_abs(dz); }
    if (_grin_pos(m) == 0) { return 0; }
    if ((_grin_finite(dx) & _grin_finite(dy) & _grin_finite(dz)) == 0) { return 0; }
    var sx = f64_div(dx, m);
    var sy = f64_div(dy, m);
    var sz = f64_div(dz, m);
    var l = f64_sqrt(f64_add(f64_add(f64_mul(sx, sx), f64_mul(sy, sy)), f64_mul(sz, sz)));
    store64(out, f64_div(sx, l));
    store64(out + 8, f64_div(sy, l));
    store64(out + 16, f64_div(sz, l));
    return 1;
}

# Validate a trace's common arguments; on success fill state s from the ray (at its
# position, direction normalised, T = n(pos) * dir) and return PK_ERR_NONE.
# PK_ERR_INVALID_INDEX (s only partly filled) where the profile has no index at the
# ray's position — the rod and ball traces, whose rays start outside, ignore it.
fn _grin_start(p, ray, step, max_steps, s) {
    if (_grin_kind_ok(p) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (ray == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_pos(step) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (max_steps < 1) { return PK_ERR_INVALID_PARAMETER; }
    var pos = TraceRay_pos(ray);
    var dir = TraceRay_dir(ray);
    if ((pos == 0) | (dir == 0)) { return PK_ERR_INVALID_PARAMETER; }
    var x = RayVec3_x(pos);
    var y = RayVec3_y(pos);
    var z = RayVec3_z(pos);
    if (_grin_finite(f64_add(f64_add(x, y), z)) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var u[24];
    if (_grin_unit(RayVec3_x(dir), RayVec3_y(dir), RayVec3_z(dir), &u) == 0) { return PK_ERR_INVALID_PARAMETER; }
    store64(s, x);
    store64(s + 8, y);
    store64(s + 16, z);
    store64(s + 24, load64(&u));
    store64(s + 32, load64(&u + 8));
    store64(s + 40, load64(&u + 16));
    if (_grin_eval(p, x, y, z, s + 48) == 0) { return PK_ERR_INVALID_INDEX; }
    var n = f64_sqrt(load64(s + 72));
    store64(s + 24, f64_mul(n, load64(&u)));
    store64(s + 32, f64_mul(n, load64(&u + 8)));
    store64(s + 40, f64_mul(n, load64(&u + 16)));
    return PK_ERR_NONE;
}

fn _grin_fail(e, opl_out, err_out) {
    if (opl_out != 0) { store64(opl_out, 0); }
    store64(err_out, e);
    return 0;
}

# The result: a TraceRay at state s's position, heading along its T, in index n.
# Its three RayVec3/TraceRay blocks are the only allocations a trace makes.
fn _grin_done(s, n, opl, opl_out, err_out) {
    var u[24];
    if (_grin_unit(load64(s + 24), load64(s + 32), load64(s + 40), &u) == 0) {
        return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out);
    }
    var pos = ray_vec3(load64(s), load64(s + 8), load64(s + 16));
    var dir = ray_vec3(load64(&u), load64(&u + 8), load64(&u + 16));
    if ((pos == 0) | (dir == 0)) { return _grin_fail(PK_ERR_ALLOCATION, opl_out, err_out); }
    var r = trace_ray_new(pos, dir, n);
    if (r == 0) { return _grin_fail(PK_ERR_ALLOCATION, opl_out, err_out); }
    if (opl_out != 0) { store64(opl_out, opl); }
    store64(err_out, PK_ERR_NONE);
    return r;
}

# Trace a ray INSIDE the medium to the plane z = z_end (either side of it). The
# ray's position is its start, its direction is normalised here, and its index
# field is ignored — the profile gives n there. `step` is the arc length of a step
# (finite, > 0; see the header — the error is O(step^4)); `max_steps` bounds the
# steps. Returns a new TraceRay at the plane (direction of the ray there, n the
# profile's index there; its z is exactly z_end) and the optical path through
# opl_out (may be 0). Errors (0 returned, opl 0):
# - PK_ERR_INVALID_PARAMETER for a null or non-finite argument, a zero direction,
#   step <= 0, max_steps < 1; a ray heading away from the plane in a profile with
#   no axial gradient (SELFOC, sech, a polynomial with no z terms: it can never
#   arrive); the budget running out; a step too small to move the ray, or one the
#   header's checks refuse even at 2^-40 of its length (a step far too coarse, or
#   a ray running head-on into n -> 0);
# - PK_ERR_TIR if the budget runs out after the ray, once heading for the plane,
#   turned away (a gradient-index mirage);
# - PK_ERR_INVALID_INDEX if the ray starts, or a step at 2^-40 of its length
#   still reaches, where the profile has no index.
#must_use
fn grin_trace_to_plane(profile, ray, z_end, step, max_steps, opl_out, err_out) {
    _prk_trace("grin_trace_to_plane");
    if (_grin_finite(z_end) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var s0[80];
    var e = _grin_start(profile, ray, step, max_steps, &s0);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var se[80];
    var opl = 0;
    e = _grin_run(profile, &s0, 0, z_end, 0, step, max_steps, _PRK_INF, &se, &opl);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    return _grin_done(&se, f64_sqrt(load64(&se + 72)), opl, opl_out, err_out);
}

# Trace a ray INSIDE the medium (or on the sphere, heading in) until it leaves the
# sphere of radius `radius` about (0, 0, cz); the result lies exactly on it. Same
# arguments and result as grin_trace_to_plane. Errors: PK_ERR_INVALID_PARAMETER for
# a null or non-finite argument, radius not finite and positive with a finite
# normal square, a ray starting outside the sphere or on it not heading in, the
# budget running out, or a step refused as for grin_trace_to_plane;
# PK_ERR_INVALID_INDEX as for it. Never PK_ERR_TIR.
#must_use
fn grin_trace_to_sphere(profile, ray, cz, radius, step, max_steps, opl_out, err_out) {
    _prk_trace("grin_trace_to_sphere");
    if (_grin_finite(cz) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    if (_grin_sq_ok(radius) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var s0[80];
    var e = _grin_start(profile, ray, step, max_steps, &s0);
    if (e == PK_ERR_INVALID_INDEX) {
        # Outside the sphere is the documented refusal even where the law has no
        # index there (a Luneburg past sqrt(2) R).
        var sz = f64_sub(load64(&s0 + 16), cz);
        var sr2 = f64_add(f64_add(f64_mul(load64(&s0), load64(&s0)), f64_mul(load64(&s0 + 8), load64(&s0 + 8))),
          f64_mul(sz, sz));
        if (f64_gt(sr2, f64_mul(radius, radius)) == 1) { e = PK_ERR_INVALID_PARAMETER; }
    }
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var se[80];
    var opl = 0;
    e = _grin_run(profile, &s0, 1, cz, radius, step, max_steps, _PRK_INF, &se, &opl);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    return _grin_done(&se, f64_sqrt(load64(&se + 72)), opl, opl_out, err_out);
}

# Vector Snell, on stack scalars (2.8.0 review: going through ray_refract_3d cost
# six discarded RayVec3 allocations per rod or ball trace, and reported an
# allocation failure as a bad argument): unit incident (dx, dy, dz) in index n1,
# unit normal (nx, ny, nz) facing it, into index n2 —
#   t = r d + (r cos_i - cos_t) n,   r = n1/n2,   cos_i = -d.n.
# Writes the refracted unit direction to out[0..2]; PK_ERR_NONE or PK_ERR_TIR.
fn _grin_refract(dx, dy, dz, nx, ny, nz, n1, n2, out) {
    var ratio = f64_div(n1, n2);
    var ci = f64_neg(f64_add(f64_add(f64_mul(dx, nx), f64_mul(dy, ny)), f64_mul(dz, nz)));
    var s2 = f64_mul(f64_mul(ratio, ratio), f64_sub(F64_ONE, f64_mul(ci, ci)));
    if (f64_gt(s2, F64_ONE) == 1) { return PK_ERR_TIR; }
    var fac = f64_sub(f64_mul(ratio, ci), f64_sqrt(f64_sub(F64_ONE, s2)));
    store64(out, f64_add(f64_mul(ratio, dx), f64_mul(fac, nx)));
    store64(out + 8, f64_add(f64_mul(ratio, dy), f64_mul(fac, ny)));
    store64(out + 16, f64_add(f64_mul(ratio, dz), f64_mul(fac, nz)));
    return PK_ERR_NONE;
}

# Refract the incoming unit direction (dx, dy, dz) in index n_in into the GRIN at
# boundary point (x, y, z) with unit normal (nx, ny, nz) facing the incoming ray,
# and fill state s there. Returns PK_ERR_NONE, PK_ERR_TIR or PK_ERR_INVALID_INDEX.
fn _grin_enter(p, x, y, z, dx, dy, dz, nx, ny, nz, n_in, s) {
    if (_grin_eval(p, x, y, z, s + 48) == 0) { return PK_ERR_INVALID_INDEX; }
    var n = f64_sqrt(load64(s + 72));
    var d[24];
    var e = _grin_refract(dx, dy, dz, nx, ny, nz, n_in, n, &d);
    if (e != PK_ERR_NONE) { return e; }
    store64(s, x);
    store64(s + 8, y);
    store64(s + 16, z);
    store64(s + 24, f64_mul(n, load64(&d)));
    store64(s + 32, f64_mul(n, load64(&d + 8)));
    store64(s + 40, f64_mul(n, load64(&d + 16)));
    return PK_ERR_NONE;
}

# Refract state s (on a boundary, heading along T) out of the GRIN into n_after
# through a surface whose unit normal (nx, ny, nz) points back into the GRIN.
# Rewrites s's T as the refracted UNIT direction. PK_ERR_NONE or PK_ERR_TIR.
fn _grin_exit(s, nx, ny, nz, n_after) {
    var u[24];
    if (_grin_unit(load64(s + 24), load64(s + 32), load64(s + 40), &u) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var d[24];
    var n1 = f64_sqrt(load64(s + 72));
    var e = _grin_refract(load64(&u), load64(&u + 8), load64(&u + 16), nx, ny, nz, n1, n_after, &d);
    if (e != PK_ERR_NONE) { return e; }
    store64(s + 24, load64(&d));
    store64(s + 32, load64(&d + 8));
    store64(s + 40, load64(&d + 16));
    return PK_ERR_NONE;
}

# A GRIN ROD of radius `radius` about the z axis between the planes z = z_front and
# z = z_front + length: the ray, in a homogeneous medium of its own index
# (TraceRay_n), travels straight to the front face, refracts in, is traced
# through, and refracts out into n_after. Returns the ray just past the back face
# (index n_after) and, through opl_out (may be 0), the optical path from the ray's
# start to the back face. The ray must start at or before the front face heading
# +z. `radius` is the rod's wall (+inf for a laterally unbounded rod): a ray that
# meets the front face outside it, or reaches it anywhere inside the rod, is
# vignetted — PK_ERR_INVALID_PARAMETER, like an aperture miss in trace_surface.
# Errors otherwise as grin_trace_to_plane, plus PK_ERR_INVALID_PARAMETER for a ray
# that starts past the front face or does not head +z, a non-finite z_front,
# length not finite and positive, radius neither +inf nor finite and positive with a
# finite normal square, n_after or the ray's index not
# finite and positive with a finite normal square; PK_ERR_TIR at either face.
#must_use
fn grin_rod_trace(profile, ray, z_front, length, radius, n_after, step, max_steps, opl_out, err_out) {
    _prk_trace("grin_rod_trace");
    if (_grin_finite(z_front) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    if (_grin_pos(length) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    if (radius != _PRK_INF) {
        if (_grin_sq_ok(radius) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    }
    if (_grin_sq_ok(n_after) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var s0[80];
    var e = _grin_start(profile, ray, step, max_steps, &s0);
    if (e == PK_ERR_INVALID_INDEX) { e = PK_ERR_NONE; }
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var n_in = TraceRay_n(ray);
    if (_grin_sq_ok(n_in) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var u[24];
    var rd = TraceRay_dir(ray);
    _grin_unit(RayVec3_x(rd), RayVec3_y(rd), RayVec3_z(rd), &u);
    var dx = load64(&u);
    var dy = load64(&u + 8);
    var dz = load64(&u + 16);
    var gap = f64_sub(z_front, load64(&s0 + 16));
    if (f64_gt(dz, 0) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    if (f64_lt(gap, 0) == 1) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var t = f64_div(gap, dz);
    var x = f64_add(load64(&s0), f64_mul(t, dx));
    var y = f64_add(load64(&s0 + 8), f64_mul(t, dy));
    var cyl2 = f64_mul(radius, radius);
    if (f64_gt(f64_add(f64_mul(x, x), f64_mul(y, y)), cyl2) == 1) {
        return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out);
    }
    var s[80];
    e = _grin_enter(profile, x, y, z_front, dx, dy, dz, 0, 0, f64_neg(F64_ONE), n_in, &s);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var se[80];
    var opl = 0;
    e = _grin_run(profile, &s, 0, f64_add(z_front, length), 0, step, max_steps, cyl2, &se, &opl);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    e = _grin_exit(&se, 0, 0, f64_neg(F64_ONE), n_after);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    return _grin_done(&se, n_after, f64_add(f64_mul(n_in, t), opl), opl_out, err_out);
}

# A GRIN BALL of radius `radius` about (0, 0, cz) — the Luneburg lens, or any
# profile cut to a sphere: the ray, in a homogeneous medium of its own index, travels
# straight to the sphere, refracts in, is traced through, and refracts out into
# n_after. Returns the ray just outside the exit point and, through opl_out (may
# be 0), the optical path from the ray's start to the exit point. The ray must start
# outside the sphere or on it (to rounding), heading in. A ray that misses the
# sphere, only touches it (tangent), heads away from it, or starts inside, is
# PK_ERR_INVALID_PARAMETER;
# otherwise errors as grin_trace_to_sphere, plus PK_ERR_INVALID_PARAMETER for
# n_after or the ray's index not finite and positive with a finite normal square,
# and PK_ERR_TIR at either face.
#must_use
fn grin_ball_trace(profile, ray, cz, radius, n_after, step, max_steps, opl_out, err_out) {
    _prk_trace("grin_ball_trace");
    if (_grin_finite(cz) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    if (_grin_sq_ok(radius) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    if (_grin_sq_ok(n_after) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var s0[80];
    var e = _grin_start(profile, ray, step, max_steps, &s0);
    if (e == PK_ERR_INVALID_INDEX) { e = PK_ERR_NONE; }
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var n_in = TraceRay_n(ray);
    if (_grin_sq_ok(n_in) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var u[24];
    var rd = TraceRay_dir(ray);
    _grin_unit(RayVec3_x(rd), RayVec3_y(rd), RayVec3_z(rd), &u);
    var dx = load64(&u);
    var dy = load64(&u + 8);
    var dz = load64(&u + 16);
    var lx = load64(&s0);
    var ly = load64(&s0 + 8);
    var lz = f64_sub(load64(&s0 + 16), cz);
    var b = f64_add(f64_add(f64_mul(lx, dx), f64_mul(ly, dy)), f64_mul(lz, dz));
    # From outside or on the sphere, b >= 0 moves away from the centre: a miss.
    if (f64_lt(b, 0) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    var c0 = f64_sub(f64_add(f64_add(f64_mul(lx, lx), f64_mul(ly, ly)), f64_mul(lz, lz)), f64_mul(radius, radius));
    if (f64_lt(c0, 0) == 1) {
        # On the sphere to rounding is a start there; clearly inside is refused.
        # The same tolerance _grin_run's start check uses (round 2: 1e-9 R(R + |cz|)
        # took a start 4e-4 R inside a ball at cz = 1e6 R as on the sphere).
        var ctol = f64_add(f64_mul(f64_mul(radius, radius), _grin_r(1, 1000000000)),
          f64_mul(f64_mul(radius, f64_add(radius, f64_abs(cz))), 0x3CF0000000000000));
        if (f64_lt(c0, f64_neg(ctol)) == 1) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
        c0 = 0;
    }
    # The discriminant from the perpendicular distance, R^2 - |L - (L.d) d|^2, not
    # b^2 - c0, which cancels for a far start (Haines, Guenther & Akenine-Moller,
    # "Precision Improvements for Ray/Sphere Intersection", Ray Tracing Gems 2019).
    var fx = f64_sub(lx, f64_mul(b, dx));
    var fy = f64_sub(ly, f64_mul(b, dy));
    var fz = f64_sub(lz, f64_mul(b, dz));
    var fq = f64_sqrt(f64_add(f64_add(f64_mul(fx, fx), f64_mul(fy, fy)), f64_mul(fz, fz)));
    var disc = f64_mul(f64_sub(radius, fq), f64_add(radius, fq));
    # disc <= 0 touches at most: a tangent ray is a miss (round 2: traced, it followed
    # the rim or left at once depending on the first step's rounding). NaN too.
    if (f64_gt(disc, 0) == 0) { return _grin_fail(PK_ERR_INVALID_PARAMETER, opl_out, err_out); }
    # The near root, in the cancellation-free form c0 / (-b + sqrt(disc)).
    var t = f64_div(c0, f64_add(f64_neg(b), f64_sqrt(disc)));
    var x = f64_add(load64(&s0), f64_mul(t, dx));
    var y = f64_add(load64(&s0 + 8), f64_mul(t, dy));
    var zr = f64_add(lz, f64_mul(t, dz));
    # Onto the sphere: from a far start the entry carries ~distance * eps of
    # rounding, which _grin_run's start check would read as "outside" (round 2:
    # half the rays from 1e7 R were refused).
    var snp = f64_div(radius, f64_sqrt(f64_add(f64_add(f64_mul(x, x), f64_mul(y, y)), f64_mul(zr, zr))));
    x = f64_mul(x, snp);
    y = f64_mul(y, snp);
    zr = f64_mul(zr, snp);
    var s[80];
    var nrm = f64_div(F64_ONE, radius);
    var ez0 = f64_add(cz, zr);
    e = _grin_enter(profile, x, y, ez0, dx, dy, dz, f64_mul(x, nrm), f64_mul(y, nrm), f64_mul(zr, nrm), n_in, &s);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var se[80];
    var opl = 0;
    e = _grin_run(profile, &s, 1, cz, radius, step, max_steps, _PRK_INF, &se, &opl);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    var ex = f64_neg(f64_mul(load64(&se), nrm));
    var ey = f64_neg(f64_mul(load64(&se + 8), nrm));
    var ez = f64_neg(f64_mul(f64_sub(load64(&se + 16), cz), nrm));
    e = _grin_exit(&se, ex, ey, ez, n_after);
    if (e != PK_ERR_NONE) { return _grin_fail(e, opl_out, err_out); }
    return _grin_done(&se, n_after, f64_add(f64_mul(n_in, t), opl), opl_out, err_out);
}

# ── SELFOC paraxial optics ────────

# The paraxial pitch 2*pi/g of a SELFOC rod (the length of one full sinusoidal
# ray period); NaN unless g is finite and positive and 2*pi/g is finite.
#must_use
fn grin_selfoc_pitch(g) {
    if (_grin_pos(g) == 0) { return _PRK_NAN; }
    var p = f64_div(F64_TAU, g);
    if (_grin_finite(p) == 0) { return _PRK_NAN; }
    return p;
}

# The paraxial ABCD matrix of a SELFOC rod of length L between flat faces, in a
# medium of index n_ext on both sides, on (height, real slope) — the convention
# wave_beam's beam_abcd takes:
#   [ cos gL                sin gL * n_ext/(n0 g) ]
#   [ -sin gL * n0 g/n_ext  cos gL                ]
# (inside, y'' = -g^2 y; the faces scale the slope by n_ext/n0 in and back out).
# Writes A, B, C, D to out[0..3]. Returns PK_ERR_NONE, or PK_ERR_INVALID_PARAMETER
# (out untouched) for a null out, n0, g or n_ext not finite and positive, a
# non-finite length, |g L| >= 2^53 (ulp(g L) >= 2 rad there: the double carries no
# phase), n0 g subnormal, or an entry that is not finite.
fn grin_selfoc_abcd(n0, g, length, n_ext, out) {
    if (out == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_pos(n0) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_pos(g) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_pos(n_ext) == 0) { return PK_ERR_INVALID_PARAMETER; }
    if (_grin_finite(length) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var gl = f64_mul(g, length);
    # From 2^53 up ulp(gL) >= 2 rad: the product carries no phase to take a cosine of.
    if (f64_lt(f64_abs(gl), 0x4340000000000000) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var c = _prk_cos(gl);
    var s = _prk_sin(gl);
    var ng = f64_mul(n0, g);
    if ((ng & 0x7FF0000000000000) == 0) { return PK_ERR_INVALID_PARAMETER; }
    var bb = f64_div(f64_mul(s, n_ext), ng);
    var cc = f64_neg(f64_div(f64_mul(s, ng), n_ext));
    if (_grin_finite(f64_add(f64_add(c, s), f64_add(bb, cc))) == 0) { return PK_ERR_INVALID_PARAMETER; }
    store64(out, c);
    store64(out + 8, bb);
    store64(out + 16, cc);
    store64(out + 24, c);
    return PK_ERR_NONE;
}

# --- spectral_core.cyr ---

# spectral_core.cyr -- wavelength<->RGB, blackbody radiation, color temperature
# Usage: include "lib/spectral_core.cyr"  (requires error.cyr)
#
# Ported from the Rust `spectral/mod.rs`. Extreme-magnitude physical constants
# (Planck, Boltzmann) are encoded as exact IEEE-754 hex bit patterns; other
# non-integers are exact ratios. `_expm1` reproduces Rust's `f64::exp_m1` via
# Kahan's identity (2.1.1) — the port previously substituted a bare exp(x)-1,
# which returned 0 for any |x| below about 1e-16.

fn _r(num, den) { return f64_div(f64_from(num), f64_from(den)); }

# ── Physical constants ────────
# Lower edge of the visible band used by the spectral tables: 380 nm.
#must_use
fn spec_visible_min_nm() { return f64_from(380); }
# Upper edge of the visible band used by the spectral tables: 780 nm.
#must_use
fn spec_visible_max_nm() { return f64_from(780); }
# Speed of light c = 299792458 m/s (exact).
#must_use
fn spec_speed_of_light() { return f64_from(299792458); }        # m/s
# Planck constant h = 6.62607015e-34 J*s (exact, 2019 SI), stored as its IEEE-754 bit pattern.
#must_use
fn spec_planck_h() { return 0x390B860BDE023111; }               # 6.62607015e-34 J*s
# Boltzmann constant k = 1.380649e-23 J/K (exact, 2019 SI), stored as its IEEE-754 bit pattern.
#must_use
fn spec_boltzmann_k() { return 0x3B30B0E6D55E647C; }            # 1.380649e-23 J/K

# First/second radiation constants (2*h*c*c ; h*c/k), left-associative like Rust.
fn _planck_c1() {
    return f64_mul(f64_mul(f64_mul(F64_TWO, spec_planck_h()), spec_speed_of_light()), spec_speed_of_light());
}
fn _planck_c2() {
    return f64_div(f64_mul(spec_planck_h(), spec_speed_of_light()), spec_boltzmann_k());
}

# ── Rgb ────────

#derive(accessors)
struct Rgb { r; g; b; }

# Heap Rgb {r, g, b} (linear, nominally 0-1, unclamped); 0 on allocation failure.
#must_use
fn rgb_new(r, g, b) {
    var c = alloc(sizeof(Rgb));
    if (c == 0) { return 0; }
    Rgb_set_r(c, r);
    Rgb_set_g(c, g);
    Rgb_set_b(c, b);
    return c;
}

# Rgb (0, 0, 0).
#must_use
fn rgb_black() { return rgb_new(f64_from(0), f64_from(0), f64_from(0)); }
# Rgb (1, 1, 1).
#must_use
fn rgb_white() { return rgb_new(F64_ONE, F64_ONE, F64_ONE); }

# Clamp all channels to [0, 1].
#must_use
fn rgb_clamp(c) {
    if (c == 0) { return 0; }
    return rgb_new(
      f64_clamp(Rgb_r(c), f64_from(0), F64_ONE),
      f64_clamp(Rgb_g(c), f64_from(0), F64_ONE),
      f64_clamp(Rgb_b(c), f64_from(0), F64_ONE));
}

# 8-bit sRGB channels (0-255).
#derive(accessors)
struct RgbU8 { r; g; b; }

# channel*255 + 0.5 truncated, with Rust `as u8` saturation. f64_clamp lets a
# NaN through (matching Rust f64::clamp), and f64_to(NaN) depends on the
# consumer's pin (0 from cyrius 6.6.8, INT64_MIN below it), so the NaN case is
# caught here: Rust's saturating cast yields 0.
fn _r_sat_u8(ch) {
    var v = f64_add(f64_mul(ch, f64_from(255)), _r(5, 10));
    # NaN fails every comparison, so this catches it as well as negatives.
    if (f64_gt(v, f64_from(0)) == 0) { return 0; }
    if (f64_gt(v, f64_from(255)) == 1) { return 255; }
    return f64_to(v);
}

# Clamp to [0, 1] and quantise to 8-bit channels (RgbU8; NaN -> 0); 0 on allocation failure.
# Allocates its result only (2.15.1: the clamped copy was an Rgb, 24 bytes leaked per call).
#must_use
fn rgb_to_u8(c) {
    if (c == 0) { return 0; }
    var u = alloc(sizeof(RgbU8));
    if (u == 0) { return 0; }
    RgbU8_set_r(u, _r_sat_u8(f64_clamp(Rgb_r(c), f64_from(0), F64_ONE)));
    RgbU8_set_g(u, _r_sat_u8(f64_clamp(Rgb_g(c), f64_from(0), F64_ONE)));
    RgbU8_set_b(u, _r_sat_u8(f64_clamp(Rgb_b(c), f64_from(0), F64_ONE)));
    return u;
}

# Rec. 709 luminance: 0.2126*r + 0.7152*g + 0.0722*b.
# NaN for a null colour (2.15.1: 0.0, which is also a legitimate answer).
#must_use
fn rgb_luminance(c) {
    if (c == 0) { return _PRK_NAN; }
    return f64_add(f64_add(
        f64_mul(_r(2126, 10000), Rgb_r(c)),
        f64_mul(_r(7152, 10000), Rgb_g(c))),
      f64_mul(_r(722, 10000), Rgb_b(c)));
}

# ── Wavelength -> RGB ────────

# Piecewise-linear CIE approximation. Writes PK_ERR_WAVELENGTH_RANGE (returns 0)
# outside 380-780 nm (NaN also fails the range test).
#must_use
fn wavelength_to_rgb(wavelength_nm, err_out) {
    _prk_trace("wavelength_to_rgb");
    store64(err_out, PK_ERR_NONE);
    var in_range = 0;
    if (f64_ge(wavelength_nm, spec_visible_min_nm()) == 1) {
        if (f64_le(wavelength_nm, spec_visible_max_nm()) == 1) {
            in_range = 1;
        }
    }
    if (in_range == 0) {
        store64(err_out, PK_ERR_WAVELENGTH_RANGE);
        return 0;
    }

    var w = wavelength_nm;
    var r = f64_from(0);
    var g = f64_from(0);
    var b = f64_from(0);
    if (f64_lt(w, f64_from(440)) == 1) {
        r = f64_div(f64_neg(f64_sub(w, f64_from(440))), f64_sub(f64_from(440), f64_from(380)));
        b = F64_ONE;
    } elif (f64_lt(w, f64_from(490)) == 1) {
        g = f64_div(f64_sub(w, f64_from(440)), f64_sub(f64_from(490), f64_from(440)));
        b = F64_ONE;
    } elif (f64_lt(w, f64_from(510)) == 1) {
        g = F64_ONE;
        b = f64_div(f64_neg(f64_sub(w, f64_from(510))), f64_sub(f64_from(510), f64_from(490)));
    } elif (f64_lt(w, f64_from(580)) == 1) {
        r = f64_div(f64_sub(w, f64_from(510)), f64_sub(f64_from(580), f64_from(510)));
        g = F64_ONE;
    } elif (f64_lt(w, f64_from(645)) == 1) {
        r = F64_ONE;
        g = f64_div(f64_neg(f64_sub(w, f64_from(645))), f64_sub(f64_from(645), f64_from(580)));
    } else {
        r = F64_ONE;
    }

    var factor = F64_ONE;
    if (f64_lt(w, f64_from(420)) == 1) {
        factor = f64_add(_r(3, 10),
          f64_div(f64_mul(_r(7, 10), f64_sub(w, f64_from(380))), f64_sub(f64_from(420), f64_from(380))));
    } elif (f64_gt(w, f64_from(700)) == 1) {
        factor = f64_add(_r(3, 10),
          f64_div(f64_mul(_r(7, 10), f64_sub(f64_from(780), w)), f64_sub(f64_from(780), f64_from(700))));
    }

    # 2.4.9: a failed allocation used to return 0 with err_out still PK_ERR_NONE,
    # so a caller that checked prakash_is_ok() then dereferenced null. A null
    # handle must be distinguishable from a success (CLAUDE.md).
    var c = rgb_new(f64_mul(r, factor), f64_mul(g, factor), f64_mul(b, factor));
    if (c == 0) { store64(err_out, PK_ERR_ALLOCATION); }
    return c;
}

# ── Blackbody radiation ────────

# exp(x) - 1, accurate for small x. Rust used `f64::exp_m1`; the port originally
# substituted a bare `exp(x) - 1`, which loses the entire result to cancellation
# once x is small enough that exp(x) rounds to a neighbour of 1.0 (below about
# 1e-16 it returns exactly 0 where the true value is x).
#
# Kahan's identity: with u = exp(x), the ratio (u-1)/ln(u) corrects the rounding
# in both u and u-1, because the SAME u appears in numerator and denominator, so
# their errors cancel to first order. Exact at u == 1 (return x directly) and
# guarded at u == 0 (x very negative, where exp underflows and the answer is -1).
fn _expm1(x) {
    var u = _prk_exp(x);
    if (u == F64_ONE) { return x; }
    if (u == 0) { return f64_neg(F64_ONE); }
    var um1 = f64_sub(u, F64_ONE);
    if (um1 == f64_neg(F64_ONE)) { return f64_neg(F64_ONE); }
    return f64_div(f64_mul(um1, x), f64_ln(u));
}

# Planck's law: spectral radiance (W*sr^-1*m^-3) at wavelength_m and temperature_k.
# Uses the Wien approximation for x > 500 to avoid exp overflow; 0 for T <= 0 (no emission).
# NaN for a wavelength that is not finite and > 0 (2.15.1: lambda = 0 answered 0 and a negative
# lambda a negative radiance).
#must_use
fn planck_radiance(wavelength_m, temperature_k) {
    if ((f64_gt(wavelength_m, f64_from(0)) & f64_lt(wavelength_m, 0x7FF0000000000000)) == 0) {
        return _PRK_NAN;
    }
    if (f64_le(temperature_k, f64_from(0)) == 1) {
        return f64_from(0);
    }
    var x = f64_div(_planck_c2(), f64_mul(wavelength_m, temperature_k));
    # lambda^5 as an exact integer power (powi 5): wl * (wl^2)^2.
    var wl2 = f64_mul(wavelength_m, wavelength_m);
    var wl4 = f64_mul(wl2, wl2);
    var lambda5 = f64_mul(wavelength_m, wl4);
    if (f64_gt(x, f64_from(500)) == 1) {
        return f64_div(_planck_c1(), f64_mul(lambda5, _prk_exp(x)));
    }
    return f64_div(_planck_c1(), f64_mul(lambda5, _expm1(x)));
}

# Wien's displacement law: peak wavelength (m) = 2.897771955e-3 / T.
#must_use
fn wien_peak(temperature_k) {
    return f64_div(_r(2897771955, 1000000000000), temperature_k);
}

# Color temperature (Kelvin) -> RGB via Tanner Helland's algorithm.
#must_use
fn color_temperature_to_rgb(kelvin) {
    _prk_trace("color_temperature_to_rgb");
    var temp = f64_clamp(f64_div(kelvin, f64_from(100)), f64_from(10), f64_from(400));

    var r = F64_ONE;
    # Negate `temp <= 66` rather than testing `temp > 66`: the two agree for
    # every finite input, but on a NaN both comparisons are false, and Rust's
    # `if temp <= 66.0 { 1.0 } else { ... }` takes the ELSE branch there.
    # bridge.cyr's copy of this fit already negates; this keeps them identical.
    if (f64_le(temp, f64_from(66)) == 0) {
        var xr = f64_sub(temp, f64_from(60));
        r = f64_clamp(
          f64_div(f64_mul(_r(329698727446, 1000000000),
              _prk_pow(xr, f64_neg(_r(1332047592, 10000000000)))), f64_from(255)),
          f64_from(0), F64_ONE);
    }

    var g = f64_from(0);
    if (f64_le(temp, f64_from(66)) == 1) {
        g = f64_div(f64_clamp(
            f64_sub(f64_mul(_r(994708025861, 10000000000), f64_ln(temp)), _r(1611195681661, 10000000000)),
            f64_from(0), f64_from(255)), f64_from(255));
    } else {
        var xg = f64_sub(temp, f64_from(60));
        g = f64_clamp(
          f64_div(f64_mul(_r(2881221695283, 10000000000),
              _prk_pow(xg, f64_neg(_r(7551484937, 100000000000)))), f64_from(255)),
          f64_from(0), F64_ONE);
    }

    var b = F64_ONE;
    if (f64_ge(temp, f64_from(66)) == 1) {
        b = F64_ONE;
    } elif (f64_le(temp, f64_from(19)) == 1) {
        b = f64_from(0);
    } else {
        var xb = f64_sub(temp, f64_from(10));
        b = f64_div(f64_clamp(
            f64_sub(f64_mul(_r(1385177312231, 10000000000), f64_ln(xb)), _r(3050447927307, 10000000000)),
            f64_from(0), f64_from(255)), f64_from(255));
    }

    return rgb_new(r, g, b);
}

# ── Frequency & photon energy ────────

# Wavelength (nm) -> frequency (Hz).
#must_use
fn wavelength_to_frequency(wavelength_nm) {
    return f64_div(spec_speed_of_light(), f64_mul(wavelength_nm, _r(1, 1000000000)));
}

# Frequency (Hz) -> wavelength (nm).
#must_use
fn frequency_to_wavelength(frequency_hz) {
    return f64_mul(f64_div(spec_speed_of_light(), frequency_hz), f64_from(1000000000));
}

# Photon energy (Joules) for a wavelength (nm).
#must_use
fn photon_energy(wavelength_nm) {
    return f64_mul(spec_planck_h(), wavelength_to_frequency(wavelength_nm));
}

# Photon energy (electron-volts) for a wavelength (nm).
#must_use
fn photon_energy_ev(wavelength_nm) {
    return f64_div(photon_energy(wavelength_nm), 0x3C07A4DA290C1653);   # / 1.602176634e-19
}

# --- spectral_cie.cyr ---

# spectral_cie.cyr -- CIE color science: CMF tables, XYZ, SPD, illuminants, CRI
# Build an Spd by SAMPLING a continuous spectral function at `n` wavelengths from
# `start_nm` to `end_nm` inclusive.
#
# `fp` is the address of a one-argument function taking a wavelength in nm and
# returning spectral power as an f64 — `&my_spectrum`. The step is
# (end_nm - start_nm) / (n - 1), so the last sample lands exactly on `end_nm`,
# matching `spd_end_nm`.
#
# ⛔ THIS POINT-SAMPLES. IT DOES NOT INTEGRATE, AND THAT IS THE WHOLE DESIGN
# DECISION. The roadmap carried this item for six releases as "build an SPD via
# hisab's calc_integral_gauss5 — the one place hisab's quadrature genuinely fits".
# That premise is wrong, and implementing it would have silently produced wrong
# colour values for every SPD built this way:
#
#   - `_spd_integrate` — the CIE method prakash implements — computes
#     `sum(power[i] * cmf[i]) * 5`. That is a rectangle rule whose `power[i]` is
#     the value AT 380 + 5i nm and whose trailing `* 5` IS the bin width. The
#     samples are points; the integral is applied by the consumer, once.
#   - `spd_blackbody`, directly below, already builds an Spd from a continuous
#     function (`planck_radiance`) and point-samples it at 81 wavelengths. An
#     integrating `spd_from_function` would disagree with the function beside it.
#   - Empirically: D65 reads exactly 100.0 at 560 nm, its definitional
#     normalisation point, and `spd_to_xyz(D65)` gives (0.3127, 0.3290) against
#     the published chromaticity. Both hold only under point sampling.
#
# A bin INTEGRAL over a 5 nm step is about 5x a point sample, so quadrature here
# would have produced an SPD ~5x too bright that still looked plausible — and
# `spd_to_xyz` normalises by X+Y+Z, so the chromaticity would have looked RIGHT
# while every absolute photometric quantity was wrong.
#
# ⚠ The cost of point sampling is real and worth stating: structure narrower than
# the step is aliased, not averaged. A laser line between two sample points is
# missed entirely. Sampling finely keeps the line in the Spd — `n` is the
# caller's choice for that reason — but it does NOT carry it into colour:
# spd_to_xyz and the photometry integrators read any SPD only at 380 + 5k nm, so
# a line narrower than ~5 nm still reads 0 to 4.7x depending on where it falls
# (see spd_to_xyz). For discrete lines, sum I_k * cie_cmf_at(lambda_k). (2.5.1:
# this used to say "sample finely enough", which cannot fix that.)
#
# Sets err_out to PK_ERR_INVALID_PARAMETER for a null `fp`, n < 2, or
# end_nm <= start_nm; PK_ERR_ALLOCATION if the sample buffer cannot be allocated.
# Returns 0 on any error.
#must_use
fn spd_from_function(fp, start_nm, end_nm, n, err_out) {
    store64(err_out, PK_ERR_NONE);
    _prk_trace("spd_from_function");
    if (fp == 0) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (n < 2) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    if (f64_le(end_nm, start_nm) == 1) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    # ⛔ 2.4.8: `n * 8` OVERFLOWS BEFORE alloc SEES IT. For n above 2^60 the product
    # wraps to a small or negative value, alloc happily returns a tiny buffer, and
    # the fill loop below then writes n elements through it — a SIGSEGV, which is
    # the 2.0.2 defect class CLAUDE.md names. The `n < 2` check above screens the
    # low end and nothing screened the high end. Same bound and shape as
    # `_pat_dims_bad` in wave_pattern.cyr: 2^31 bytes / 8 per f64.
    if (n > 268435456) {
        store64(err_out, PK_ERR_INVALID_PARAMETER);
        return 0;
    }
    var values = alloc(n * 8);
    if (values == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    var step = f64_div(f64_sub(end_nm, start_nm), f64_from(n - 1));
    for (var i = 0; i < n; i = i + 1) {
        store64(values + i * 8, fncall1(fp, f64_add(start_nm, f64_mul(f64_from(i), step))));
    }
    var s = spd_new(start_nm, step, values, n);
    if (s == 0) {
        store64(err_out, PK_ERR_ALLOCATION);
        return 0;
    }
    return s;
}

# Usage: include "lib/spectral_cie.cyr"  (requires error.cyr, spectral_core.cyr)
#
# Ported from the Rust `spectral/cie.rs`. The four 81x3 color-matching-function
# tables and four 81-value illuminant SPDs are lazily-initialized flat f64
# buffers filled with exact IEEE-754 hex bit patterns (generated from the Rust
# source). Rust's Cow<[f64]> borrowed/owned storage has no Cyrius analogue, so an
# Spd just holds a values pointer + length (from_static and new are equivalent).

fn _cie_r(num, den) { return f64_div(f64_from(num), f64_from(den)); }
# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(1000000000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3CD203AF9EE75616 is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _cie_eps15() { return 0x3CD203AF9EE75616; }
# Literal, not a division: this ran `f64_div(F64_ONE, f64_from(10000000000))` on EVERY call, and it is read
# from guard tests in hot paths. 0x3DDB7CDFD9D7BDBB is exactly what that expression
# produced — asserted in the module's suite, not assumed. (2.3.2)
fn _cie_eps10() { return 0x3DDB7CDFD9D7BDBB; }

# CMF table row accessors (row i, 24 bytes: x@0, y@8, z@16).
fn _cmf_x(t, i) { return load64(t + i * 24); }
fn _cmf_y(t, i) { return load64(t + i * 24 + 8); }
fn _cmf_z(t, i) { return load64(t + i * 24 + 16); }
# SPD/illuminant value accessor (i-th f64).
fn _spd_val(t, i) { return load64(t + i * 8); }

# ── CIE tables (generated: exact IEEE-754 hex from rust-old/src/spectral/cie.rs) ──
# CMF tables: 81 rows x 3 (x,y,z) = 1944 bytes. Illuminants: 81 f64 = 648 bytes.

# Drop every lazily-built CIE table so the next call rebuilds it.
#
# ⛔ THIS EXISTS BECAUSE THE ONLY RECLAIM PATH A CONSUMER HAS SILENTLY CORRUPTS
# PRAKASH. prakash never frees — the bump allocator has no free — and exposes no
# teardown, so a long-running consumer's only option is the stdlib's
# `alloc_reset()`. That scrubs the heap while these 19 pointers keep pointing into
# it, and every table then reads as zeros. Reproduced at the public API:
# `cie_cmf_at(555)` returns y_bar = 1.0 before `alloc_reset()` and **0.0** after,
# with no error and no crash. 555 nm is the photopic peak, which is 1.0 by
# definition, so every downstream colour value — spd_to_xyz, luminous_flux, the
# whole CRI computation — silently becomes garbage.
#
# Call this immediately after `alloc_reset()`. It is not a free; it only forgets,
# so the next use rebuilds from the compiled-in constants.
fn _cie_reset_caches() {
    _cie1931_p = 0;
    _cie1964_p = 0;
    _cie2015_2_p = 0;
    _cie2015_10_p = 0;
    _illum_d65_p = 0;
    _illum_d50_p = 0;
    _illum_f2_p = 0;
    _illum_f11_p = 0;
    _cri_tcs1_p = 0;
    _cri_tcs2_p = 0;
    _cri_tcs3_p = 0;
    _cri_tcs4_p = 0;
    _cri_tcs5_p = 0;
    _cri_tcs6_p = 0;
    _cri_tcs7_p = 0;
    _cri_tcs8_p = 0;
    _cri_s0_p = 0;
    _cri_s1_p = 0;
    _cri_s2_p = 0;
    return 0;
}

var _cie1931_p = 0;
fn _cie1931() {
    if (_cie1931_p != 0) { return _cie1931_p; }
    var t = alloc(1944);
    if (t == 0) { return 0; }
    store64(t + 0, 0x3F5669CED0B30B5B);
    store64(t + 8, 0x3F04727DCBDDB984);
    store64(t + 16, 0x3F7A6B50B0F27BB3);
    store64(t + 24, 0x3F62513B5BF6A0DC);
    store64(t + 32, 0x3F10C6F7A0B5ED8D);
    store64(t + 40, 0x3F859B3D07C84B5E);
    store64(t + 48, 0x3F71611BA3CA7504);
    store64(t + 56, 0x3F1F75104D551D69);
    store64(t + 64, 0x3F9487FCB923A29C);
    store64(t + 72, 0x3F7F559B3D07C84B);
    store64(t + 80, 0x3F2C714FCE746CB9);
    store64(t + 88, 0x3FA28A1DFB9389B5);
    store64(t + 96, 0x3F8D4E8FB00BCBE6);
    store64(t + 104, 0x3F39F3C70C996B76);
    store64(t + 112, 0x3FB15E9E1B089A02);
    store64(t + 120, 0x3F97BF1E8E608073);
