# probe.cyr -- the Cyrius side of ranga's differential oracle, printing mode.
# The groups live in probe_core.cyr. See scripts/oracle/README.md. Build it from the
# repository root (run.sh does), so `src/` resolves.

include "scripts/oracle/probe_core.cyr"

fn main() {
    alloc_init();
    args_init();
    _OB = fl_alloc(_OCAP);
    run_groups(argc());
    o_flush();
    return 0;
}

var r = main();
sys_exit_group(r);
