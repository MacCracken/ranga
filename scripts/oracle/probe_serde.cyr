# probe_serde.cyr -- the serde group of the oracle: src/serde.cyr's JSON codecs
# against serde_json 1.0.151. Included by probe_core.cyr. Mirrors g_serde in
# scripts/oracle/rust/src/main.rs: the same generator, drawn in the same order, the
# same decode inputs (serde_inputs.cyr, generated by make_serde_inputs.py) and the
# same keys.

include "scripts/oracle/serde_inputs.cyr"

fn o_key(t, i) { o_str(t); o_byte(46); o_dec(i); return 0; }

# A line whose key is "<t>.<i>" or "<t>.<i>.<f>".
fn sd_line_json(g, t, i, bv) {
    o_g(g); o_key(t, i); o_t("json");
    var p = rg_bv_data(bv);
    var n = rg_bv_len(bv);
    var j = 0;
    while (j < n) { o_byte(load8(p + j)); j = j + 1; }
    o_nl();
    rg_bv_free(bv);
    return 0;
}
fn sd_line_code(g, t, i, f, c) {
    o_g(g); o_key(t, i);
    if (f != 0) { o_byte(46); o_str(f); }
    o_t("code"); o_dec(c); o_nl();
    return 0;
}
fn sd_line_f32(g, t, i, f, v) {
    o_g(g); o_key(t, i); o_byte(46); o_str(f); o_t("f32"); o_hex(v & 0xFFFFFFFF, 8); o_nl();
    return 0;
}
fn sd_line_f64(g, t, i, f, v) {
    o_g(g); o_key(t, i); o_byte(46); o_str(f); o_t("f64"); o_hex(v, 16); o_nl();
    return 0;
}
fn sd_line_u8s(g, t, i, f, p, n) {
    o_g(g); o_key(t, i); o_byte(46); o_str(f); o_t("u8");
    var j = 0;
    while (j < n) { o_hex(load8(p + j), 2); j = j + 1; }
    o_nl();
    return 0;
}

var SD_E32 = 0;
var SD_E64 = 0;
fn sd_edges() {
    SD_E32 = fl_alloc(16 * 8);
    var e = SD_E32;
    store64(e, 0); store64(e + 8, 0x80000000); store64(e + 16, 0x3F800000); store64(e + 24, 0x3DCCCCCD);
    store64(e + 32, 0x00000001); store64(e + 40, 0x007FFFFF); store64(e + 48, 0x00800000);
    store64(e + 56, 0x7F7FFFFF); store64(e + 64, 0x7F800000); store64(e + 72, 0xFF800000);
    store64(e + 80, 0x7FC00000); store64(e + 88, 0x4B189680); store64(e + 96, 0x5368D4A5);
    store64(e + 104, 0x358637BD); store64(e + 112, 0x3A83126F); store64(e + 120, 0xC2F6E979);
    SD_E64 = fl_alloc(12 * 8);
    e = SD_E64;
    store64(e, 0); store64(e + 8, 0x8000000000000000); store64(e + 16, 0x3FF0000000000000);
    store64(e + 24, 0x3FB999999999999A); store64(e + 32, 1); store64(e + 40, 0x7FEFFFFFFFFFFFFF);
    store64(e + 48, 0x7FF0000000000000); store64(e + 56, 0x7FF8000000000000);
    store64(e + 64, 0x4341C37937E08000); store64(e + 72, 0x44B52D02C7E14AF6);
    store64(e + 80, 0x3EB0C6F7A0B5ED8D); store64(e + 88, 0xC08F400000000000);
    return 0;
}
fn sd_r32(i) {
    if (i < 16) { return load64(SD_E32 + i * 8); }
    return (rng_next() >> 32) & 0xFFFFFFFF;
}
fn sd_r64(i) {
    if (i < 12) { return load64(SD_E64 + i * 8); }
    return rng_next();
}
# Rust's `x % m` on a u64, for small m.
fn sd_umod(x, m) { return (2 * ((x >> 1) % m) + (x & 1)) % m; }

fn g_serde() {
    sd_edges();
    var g = "serde_enc";
    _RNG = 0x5E4DE00000000001;
    var i = 0;
    while (i < 300) {
        var a = sd_r32(i);
        var b = sd_r32((i + 5) % 300);
        var c = sd_r32((i + 9) % 300);
        var d = sd_r32((i + 3) % 300);
        sd_line_json(g, "LinRgba", i, lin_rgba_to_json(lin_rgba_new(a, b, c, d)));
        sd_line_json(g, "Hsl", i, hsl_to_json(hsl_new(a, b, c)));
        sd_line_json(g, "Cmyk", i, cmyk_to_json(cmyk_new(a, b, c, d)));
        sd_line_json(g, "Oklab", i, oklab_to_json(oklab_new(a, b, c)));
        sd_line_json(g, "Oklch", i, oklch_to_json(oklch_new(a, b, c)));
        i = i + 1;
    }
    var v = fl_alloc(9 * 8);
    i = 0;
    while (i < 300) {
        var j = 0;
        while (j < 9) { store64(v + j * 8, sd_r64((i + j * 7) % 300)); j = j + 1; }
        sd_line_json(g, "CieXyz", i, cie_xyz_to_json(cie_xyz_new(load64(v), load64(v + 8), load64(v + 16))));
        sd_line_json(g, "CieLab", i, cie_lab_to_json(cie_lab_new(load64(v + 24), load64(v + 32), load64(v + 40))));
        sd_line_json(g, "Affine", i, affine_to_json(affine_new(load64(v), load64(v + 8), load64(v + 16),
          load64(v + 24), load64(v + 32), load64(v + 40))));
        sd_line_json(g, "Perspective", i, perspective_to_json(perspective_new(load64(v), load64(v + 8),
          load64(v + 16), load64(v + 24), load64(v + 32), load64(v + 40), load64(v + 48), load64(v + 56),
          load64(v + 64))));
        o_g(g); o_str("ToneCurve.g"); o_dec(i); o_t("json");
        var tg = tone_curve_gamma(load64(v + 64));
        var bg = tone_curve_to_json(tg);
        var q = 0;
        while (q < rg_bv_len(bg)) { o_byte(load8(rg_bv_data(bg) + q)); q = q + 1; }
        o_nl();
        rg_bv_free(bg);
        tone_curve_free(tg);
        var n = sd_umod(rng_next(), 6);
        var tab = 0;
        if (n > 0) { tab = fl_alloc(n * 8); memcpy(tab, v, n * 8); }
        var tt = tone_curve_table(tab, n);
        var bt = tone_curve_to_json(tt);
        o_g(g); o_str("ToneCurve.t"); o_dec(i); o_t("json");
        q = 0;
        while (q < rg_bv_len(bt)) { o_byte(load8(rg_bv_data(bt) + q)); q = q + 1; }
        o_nl();
        rg_bv_free(bt);
        tone_curve_free(tt);
        i = i + 1;
    }
    i = 0;
    while (i < 200) {
        var sr = rng_byte();
        var sg = rng_byte();
        var sb = rng_byte();
        var sa = rng_byte();
        sd_line_json(g, "Srgba", i, srgba_to_json(srgba_new(sr, sg, sb, sa)));
        i = i + 1;
    }
    i = 0;
    while (i < 6) { sd_line_json(g, "PixelFormat", i, pixel_format_to_json(i)); i = i + 1; }
    i = 0;
    while (i < 7) { sd_line_json(g, "ColorSpace", i, color_space_to_json(i)); i = i + 1; }
    i = 0;
    while (i < 12) { sd_line_json(g, "BlendMode", i, blend_mode_to_json(i)); i = i + 1; }
    fl_free(v);
    g_serde_dec();
    g_serde_long();
    return 0;
}

fn sd_dec_one(g, t, i, buf, nb, err, one) {
        var rc = 0;
        if (streq(t, "Srgba") == 1) {
            var c1 = srgba_from_json(buf, nb, err);
            rc = load64(err);
            sd_line_code(g, t, i, 0, rc);
            if (rc == 0) { sd_line_u8s(g, t, i, "v", c1, 4); srgba_free(c1); }
        } elif (streq(t, "LinRgba") == 1) {
            var c2 = lin_rgba_from_json(buf, nb, err);
            rc = load64(err); sd_line_code(g, t, i, 0, rc);
            if (rc == 0) {
                sd_line_f32(g, t, i, "r", lin_rgba_r(c2)); sd_line_f32(g, t, i, "g", lin_rgba_g(c2));
                sd_line_f32(g, t, i, "b", lin_rgba_b(c2)); sd_line_f32(g, t, i, "a", lin_rgba_a(c2));
                lin_rgba_free(c2);
            }
        } elif (streq(t, "Hsl") == 1) {
            var c3 = hsl_from_json(buf, nb, err);
            rc = load64(err); sd_line_code(g, t, i, 0, rc);
            if (rc == 0) {
                sd_line_f32(g, t, i, "h", hsl_h(c3)); sd_line_f32(g, t, i, "s", hsl_s(c3));
                sd_line_f32(g, t, i, "l", hsl_l(c3)); hsl_free(c3);
            }
        } elif (streq(t, "Cmyk") == 1) {
            var c4 = cmyk_from_json(buf, nb, err);
            rc = load64(err); sd_line_code(g, t, i, 0, rc);
            if (rc == 0) {
                sd_line_f32(g, t, i, "c", cmyk_c(c4)); sd_line_f32(g, t, i, "m", cmyk_m(c4));
                sd_line_f32(g, t, i, "y", cmyk_y(c4)); sd_line_f32(g, t, i, "k", cmyk_k(c4));
                cmyk_free(c4);
            }
        } elif (streq(t, "Oklab") == 1) {
            var c5 = oklab_from_json(buf, nb, err);
            rc = load64(err); sd_line_code(g, t, i, 0, rc);
            if (rc == 0) {
                sd_line_f32(g, t, i, "l", oklab_l(c5)); sd_line_f32(g, t, i, "a", oklab_a(c5));
                sd_line_f32(g, t, i, "b", oklab_b(c5)); oklab_free(c5);
            }
        } elif (streq(t, "Oklch") == 1) {
            var c6 = oklch_from_json(buf, nb, err);
            rc = load64(err); sd_line_code(g, t, i, 0, rc);
            if (rc == 0) {
                sd_line_f32(g, t, i, "l", oklch_l(c6)); sd_line_f32(g, t, i, "c", oklch_c(c6));
                sd_line_f32(g, t, i, "h", oklch_h(c6)); oklch_free(c6);
            }
        } elif (streq(t, "CieXyz") == 1) {
            var c7 = cie_xyz_from_json(buf, nb, err);
            rc = load64(err); sd_line_code(g, t, i, 0, rc);
            if (rc == 0) {
                sd_line_f64("serde_dec.f64", t, i, "x", cie_xyz_x(c7)); sd_line_f64("serde_dec.f64", t, i, "y", cie_xyz_y(c7));
                sd_line_f64("serde_dec.f64", t, i, "z", cie_xyz_z(c7)); cie_xyz_free(c7);
            }
        } elif (streq(t, "CieLab") == 1) {
            var c8 = cie_lab_from_json(buf, nb, err);
            rc = load64(err); sd_line_code(g, t, i, 0, rc);
            if (rc == 0) {
                sd_line_f64("serde_dec.f64", t, i, "l", cie_lab_l(c8)); sd_line_f64("serde_dec.f64", t, i, "a", cie_lab_a(c8));
                sd_line_f64("serde_dec.f64", t, i, "b", cie_lab_b(c8)); cie_lab_free(c8);
            }
        } elif (streq(t, "Affine") == 1) {
            var c9 = affine_from_json(buf, nb, err);
            rc = load64(err); sd_line_code(g, t, i, 0, rc);
            if (rc == 0) {
                sd_line_f64("serde_dec.f64", t, i, "a", affine_a(c9)); sd_line_f64("serde_dec.f64", t, i, "b", affine_b(c9));
                sd_line_f64("serde_dec.f64", t, i, "c", affine_c(c9)); sd_line_f64("serde_dec.f64", t, i, "d", affine_d(c9));
                sd_line_f64("serde_dec.f64", t, i, "tx", affine_tx(c9)); sd_line_f64("serde_dec.f64", t, i, "ty", affine_ty(c9));
                affine_free(c9);
            }
        } else { sd_dec_two(g, t, i, buf, nb, err, one); }
        return 0;
}

fn sd_dec_two(g, t, i, buf, nb, err, one) {
        var rc = 0;
        if (streq(t, "Perspective") == 1) {
            var c10 = perspective_from_json(buf, nb, err);
            rc = load64(err); sd_line_code(g, t, i, 0, rc);
            if (rc == 0) {
                var r = 0;
                while (r < 3) {
                    var cc = 0;
                    while (cc < 3) {
                        var fname = fl_alloc(4);
                        store8(fname, 109); store8(fname + 1, 48 + r); store8(fname + 2, 48 + cc); store8(fname + 3, 0);
                        sd_line_f64("serde_dec.f64", t, i, fname, perspective_m(c10, r, cc));
                        fl_free(fname);
                        cc = cc + 1;
                    }
                    r = r + 1;
                }
                perspective_free(c10);
            }
        } elif (streq(t, "ToneCurve") == 1) {
            var c11 = tone_curve_from_json(buf, nb, err);
            rc = load64(err); sd_line_code(g, t, i, 0, rc);
            if (rc == 0) {
                if (tone_curve_kind(c11) == TC_GAMMA) {
                    sd_line_code(g, t, i, "kind", 0);
                    sd_line_f64("serde_dec.f64", t, i, "g", tone_curve_gamma_value(c11));
                } else {
                    sd_line_code(g, t, i, "kind", 1);
                    var tn = tone_curve_len(c11);
                    sd_line_code(g, t, i, "n", tn);
                    var tj = 0;
                    while (tj < tn) {
                        o_g("serde_dec.f64"); o_key(t, i); o_str(".t"); o_dec(tj); o_t("f64");
                        o_hex(tone_curve_table_at(c11, tj), 16); o_nl();
                        tj = tj + 1;
                    }
                }
                tone_curve_free(c11);
            }
        } else {
            var ev = 0 - 1;
            if (streq(t, "PixelFormat") == 1) { ev = pixel_format_from_json(buf, nb, err); }
            elif (streq(t, "ColorSpace") == 1) { ev = color_space_from_json(buf, nb, err); }
            else { ev = blend_mode_from_json(buf, nb, err); }
            rc = load64(err);
            sd_line_code(g, t, i, 0, rc);
            if (rc == 0) { store8(one, ev); sd_line_u8s(g, t, i, "v", one, 1); }
        }
        return 0;
}

fn g_serde_dec() {
    var g = "serde_dec";
    var err = fl_alloc(8);
    var buf = fl_alloc(8192);
    var one = fl_alloc(8);
    var i = 0;
    while (i < SERDE_N) {
        var t = serde_input(i, 0);
        var h = serde_input(i, 1);
        var nb = strlen(h) / 2;
        var k = 0;
        while (k < nb) {
            store8(buf + k, (_sd_hexval(load8(h + 2 * k)) << 4) | _sd_hexval(load8(h + 2 * k + 1)));
            k = k + 1;
        }
        sd_dec_one(g, t, i, buf, nb, err, one);
        i = i + 1;
    }
    fl_free(one); fl_free(buf); fl_free(err);
    return 0;
}

# Long decimals (ADR 008: correctly rounded here, best effort in serde_json).
fn g_serde_long() {
    var err = fl_alloc(8);
    var i = 0;
    _RNG = 0x10E6D16175000003;
    var ds = fl_alloc(128);
    var js = fl_alloc(256);
    i = 0;
    while (i < 4000) {
        var nd = 17 + rng_byte() % 9;
        var p = 0;
        store8(ds, 49 + rng_byte() % 9);
        store8(ds + 1, 46);
        p = 2;
        var dk = 1;
        while (dk < nd) { store8(ds + p, 48 + rng_byte() % 10); p = p + 1; dk = dk + 1; }
        var ex = rng_byte() % 80 - 40;
        store8(ds + p, 101); p = p + 1;
        if (ex < 0) { store8(ds + p, 45); p = p + 1; ex = 0 - ex; }
        if (ex >= 10) { store8(ds + p, 48 + ex / 10); p = p + 1; }
        store8(ds + p, 48 + ex % 10); p = p + 1;
        # {"x":<s>,"y":0,"z":0} and {"r":<s>,"g":0,"b":0,"a":0}
        memcpy(js, "{\"x\":", 5);
        memcpy(js + 5, ds, p);
        memcpy(js + 5 + p, ",\"y\":0,\"z\":0}", 13);
        var cx = cie_xyz_from_json(js, 5 + p + 13, err);
        o_g("serde_long.f64"); o_dec(i); o_t("f64"); o_hex(cie_xyz_x(cx), 16); o_nl();
        cie_xyz_free(cx);
        memcpy(js, "{\"r\":", 5);
        memcpy(js + 5, ds, p);
        memcpy(js + 5 + p, ",\"g\":0,\"b\":0,\"a\":0}", 19);
        var cr = lin_rgba_from_json(js, 5 + p + 19, err);
        o_g("serde_long.f32"); o_dec(i); o_t("f32"); o_hex(lin_rgba_r(cr) & 0xFFFFFFFF, 8); o_nl();
        lin_rgba_free(cr);
        i = i + 1;
    }
    fl_free(js); fl_free(ds); fl_free(err);
    return 0;
}
