# blend.cyr -- Porter-Duff compositing and the 12 blend modes
# Ported from rust-old/src/blend.rs (839 lines). Private prefix: _bl_
#
# SIMD. Rust carries SSE2, AVX2 and NEON kernels for the Normal-mode row
# blenders, each behind a complete scalar fallback. This module ports the SCALAR
# fallbacks; the vector kernels need `asm { }` blocks (cyrius-port-plan.md §3
# items 3-5) and land separately. Behaviour is identical either way — that is
# why the fallbacks exist. `blend_row_normal` is the dispatch point, so the
# vector paths slot in there without touching any caller.
#
# PRECISION. The 12 blend modes are f32 in Rust and f32 here, using
# `: f32`-annotated locals and typed-parameter helpers. The Porter-Duff
# composite around them is INTEGER (div255), also matching Rust — the two
# domains coexist deliberately and must not be unified.
#
# ERROR MODEL. Everything here is infallible and either returns a value or
# mutates a caller-owned row, so there are no error codes and nothing allocates.

# Fast, accurate division by 255: `(v + 128 + ((v + 128) >> 8)) >> 8`.
#
# Deliberately duplicated from composite.cyr's `_div255` rather than shared.
# `cyrius distlib` concatenates every module into one file, so a shared private
# helper would need a single owning module and an include ordering to match;
# twelve lines of duplication buys module independence. The two MUST stay in
# step — 1.0.0 changed both from `x * a / 255`, which truncates where this
# rounds, leaving a channel one level too dark.
#must_use
fn _bl_div255(val) {
    var tmp = val + 128;
    return (tmp + (tmp >> 8)) >> 8;
}

# ── BlendMode ────────
var BM_NORMAL      = 0;
var BM_MULTIPLY    = 1;
var BM_SCREEN      = 2;
var BM_OVERLAY     = 3;
var BM_DARKEN      = 4;
var BM_LIGHTEN     = 5;
var BM_COLOR_DODGE = 6;
var BM_COLOR_BURN  = 7;
var BM_SOFT_LIGHT  = 8;
var BM_HARD_LIGHT  = 9;
var BM_DIFFERENCE  = 10;
var BM_EXCLUSION   = 11;

# Display impl. Note the two-word names carry a SPACE — "Color Dodge", not
# "ColorDodge" — matching Rust's Display, which is what consumers show in a UI.
#must_use
fn blend_mode_name(m) {
    if (m == BM_NORMAL) { return "Normal"; }
    if (m == BM_MULTIPLY) { return "Multiply"; }
    if (m == BM_SCREEN) { return "Screen"; }
    if (m == BM_OVERLAY) { return "Overlay"; }
    if (m == BM_DARKEN) { return "Darken"; }
    if (m == BM_LIGHTEN) { return "Lighten"; }
    if (m == BM_COLOR_DODGE) { return "Color Dodge"; }
    if (m == BM_COLOR_BURN) { return "Color Burn"; }
    if (m == BM_SOFT_LIGHT) { return "Soft Light"; }
    if (m == BM_HARD_LIGHT) { return "Hard Light"; }
    if (m == BM_DIFFERENCE) { return "Difference"; }
    if (m == BM_EXCLUSION) { return "Exclusion"; }
    return "unknown";
}

#must_use
fn blend_mode_is_valid(m) {
    if (m < 0) { return 0; }
    if (m > BM_EXCLUSION) { return 0; }
    return 1;
}

# ── f32 helpers ────────
# Typed parameters are what make these single-precision; an untyped operand
# turns the operator into an integer op with no diagnostic.
#must_use
fn _bl_mul(a: f32, b: f32) { return a * b; }
#must_use
fn _bl_sub(a: f32, b: f32) { return a - b; }
#must_use
fn _bl_add(a: f32, b: f32) { return a + b; }
#must_use
fn _bl_div(a: f32, b: f32) { return a / b; }

#must_use
fn _bl_u8_to_f32(n) { return f32_from(f64_div(f64_from(n & 255), 255.0)); }

# `(result * 255.0 + 0.5).clamp(0.0, 255.0) as u8` — round-half-up then
# truncate. NaN saturates to 0, matching Rust's `as u8`; ganita_f32_clamp would
# give the HIGH bound instead.
#must_use
fn _bl_f32_to_u8(v) {
    var d = f32_to(v);
    if (f64_eq(d, d) == 0) { return 0; }
    var scaled = f64_add(f64_mul(d, 255.0), 0.5);
    if (f64_lt(scaled, 0) == 1) { return 0; }
    if (f64_gt(scaled, 255.0) == 1) { return 255; }
    return f64_to(scaled);
}

# ── the 12 blend functions ────────
# Each takes normalised source and destination in [0,1] and returns the blended
# value, still normalised. Split out one per mode so each is separately
# testable and the dispatcher stays flat.
#must_use
fn _bl_blend_channel(s: f32, d: f32, mode) {
    var one: f32 = f32_from(F64_ONE);
    var two: f32 = f32_from(2.0);
    var half: f32 = f32_from(0.5);

    if (mode == BM_NORMAL) { return s; }
    if (mode == BM_MULTIPLY) { return s * d; }
    if (mode == BM_SCREEN) { return one - (one - s) * (one - d); }
    if (mode == BM_OVERLAY) {
        # Overlay tests the DESTINATION; HardLight tests the SOURCE. That is the
        # only difference between them, and swapping the operand is an easy and
        # invisible error.
        if (f64_lt(f32_to(d), 0.5) == 1) { return two * s * d; }
        return one - two * (one - s) * (one - d);
    }
    if (mode == BM_DARKEN) { return ganita_f32_min(s, d); }
    if (mode == BM_LIGHTEN) { return ganita_f32_max(s, d); }
    if (mode == BM_COLOR_DODGE) {
        # s == 1 would divide by zero; Rust returns 1.0 outright.
        if (f64_ge(f32_to(s), F64_ONE) == 1) { return one; }
        return ganita_f32_min(_bl_div(d, one - s), one);
    }
    if (mode == BM_COLOR_BURN) {
        # s == 0 would divide by zero; Rust returns 0.0 outright.
        if (f64_le(f32_to(s), 0) == 1) { return f32_from(0); }
        return one - ganita_f32_min(_bl_div(one - d, s), one);
    }
    if (mode == BM_SOFT_LIGHT) {
        if (f64_le(f32_to(s), 0.5) == 1) {
            return d - (one - two * s) * d * (one - d);
        }
        # The W3C soft-light D(d) function: a cubic below 0.25, sqrt above.
        # Using sqrt for the whole range makes dark values visibly wrong.
        var g: f32 = f32_from(0);
        if (f64_le(f32_to(d), 0.25) == 1) {
            var c16: f32 = f32_from(16.0);
            var c12: f32 = f32_from(12.0);
            var c4: f32 = f32_from(4.0);
            g = ((c16 * d - c12) * d + c4) * d;
        }
        if (f64_le(f32_to(d), 0.25) == 0) {
            g = ganita_f32_sqrt(d);
        }
        return d + (two * s - one) * (g - d);
    }
    if (mode == BM_HARD_LIGHT) {
        # Tests the SOURCE — see the Overlay note above.
        if (f64_lt(f32_to(s), 0.5) == 1) { return two * s * d; }
        return one - two * (one - s) * (one - d);
    }
    if (mode == BM_DIFFERENCE) { return ganita_f32_abs(s - d); }
    if (mode == BM_EXCLUSION) { return s + d - two * s * d; }
    return s;
}

# ── blend_pixel ────────
# Blend one RGBA8 source pixel over one RGBA8 destination pixel.
# `src`, `dst` and `out` are each 4 bytes; `out` may alias `dst`.
#
# The effective source alpha folds in the opacity FIRST, and a fully
# transparent result short-circuits to the destination untouched.
fn blend_pixel(src, dst, mode, opacity, out) {
    var sa = _bl_div255(load8(src + 3) * (opacity & 255));
    if (sa == 0) {
        store8(out, load8(dst));
        store8(out + 1, load8(dst + 1));
        store8(out + 2, load8(dst + 2));
        store8(out + 3, load8(dst + 3));
        return RG_ERR_NONE;
    }
    var br = _bl_f32_to_u8(_bl_blend_channel(_bl_u8_to_f32(load8(src)), _bl_u8_to_f32(load8(dst)), mode));
    var bg = _bl_f32_to_u8(_bl_blend_channel(_bl_u8_to_f32(load8(src + 1)), _bl_u8_to_f32(load8(dst + 1)), mode));
    var bb = _bl_f32_to_u8(_bl_blend_channel(_bl_u8_to_f32(load8(src + 2)), _bl_u8_to_f32(load8(dst + 2)), mode));

    # Porter-Duff source-over, in INTEGER arithmetic — the blend above is f32,
    # this is not, and Rust draws the same line.
    var inv = 255 - sa;
    var d3 = load8(dst + 3);
    store8(out, _bl_div255(br * sa + load8(dst) * inv));
    store8(out + 1, _bl_div255(bg * sa + load8(dst + 1) * inv));
    store8(out + 2, _bl_div255(bb * sa + load8(dst + 2) * inv));
    var na = _bl_div255(sa * 255 + d3 * inv);
    if (na > 255) { na = 255; }
    store8(out + 3, na);
    return RG_ERR_NONE;
}

# ── blend_pixel_argb ────────
# ARGB8 is [A, R, G, B]. Rather than duplicate the mode maths, Rust rotates the
# bytes into RGBA, blends, and rotates back — and so does this.
fn blend_pixel_argb(src, dst, mode, opacity, out) {
    var rs = fl_alloc(4);
    if (rs == 0) { return RG_ERR_ALLOCATION; }
    var rd = fl_alloc(4);
    if (rd == 0) { fl_free(rs); return RG_ERR_ALLOCATION; }
    var ro = fl_alloc(4);
    if (ro == 0) { fl_free(rs); fl_free(rd); return RG_ERR_ALLOCATION; }

    store8(rs, load8(src + 1)); store8(rs + 1, load8(src + 2));
    store8(rs + 2, load8(src + 3)); store8(rs + 3, load8(src));
    store8(rd, load8(dst + 1)); store8(rd + 1, load8(dst + 2));
    store8(rd + 2, load8(dst + 3)); store8(rd + 3, load8(dst));

    blend_pixel(rs, rd, mode, opacity, ro);

    store8(out, load8(ro + 3));
    store8(out + 1, load8(ro));
    store8(out + 2, load8(ro + 1));
    store8(out + 3, load8(ro + 2));
    fl_free(rs); fl_free(rd); fl_free(ro);
    return RG_ERR_NONE;
}

# ── blend_row_normal (RGBA8) ────────
# Normal mode only, in place over `dst`. `n` is the pixel count.
#
# This is the SCALAR fallback; the SSE2/AVX2/NEON kernels dispatch from
# blend_row_normal below.
#
# Note there is NO `sa >= 255` fast path here, unlike the ARGB variant — the
# asymmetry is Rust's and is preserved rather than tidied.
fn blend_row_normal_scalar(src, dst, n, opacity) {
    var i = 0;
    while (i < n) {
        var s = src + i * 4;
        var d = dst + i * 4;
        var sa = _bl_div255(load8(s + 3) * (opacity & 255));
        if (sa != 0) {
            var inv = 255 - sa;
            store8(d, _bl_div255(load8(s) * sa + load8(d) * inv));
            store8(d + 1, _bl_div255(load8(s + 1) * sa + load8(d + 1) * inv));
            store8(d + 2, _bl_div255(load8(s + 2) * sa + load8(d + 2) * inv));
            var na = _bl_div255(sa * 255 + load8(d + 3) * inv);
            if (na > 255) { na = 255; }
            store8(d + 3, na);
        }
        i = i + 1;
    }
    return RG_ERR_NONE;
}

# Dispatch point for the Normal-mode row blend.
#
# The length guard is a RUNTIME check, not a debug assertion: 1.0.0 upgraded it
# precisely because a mismatched row length in release silently read out of
# bounds. A bad call is a no-op, matching Rust's early return.
fn blend_row_normal(src, dst, n, opacity) {
    if (n < 0) { return RG_ERR_NONE; }

    var pairs = n / 2;
    if (pairs > 0) {
        # The constants block folds opacity in, so it is built once per row.
        # It must be 16-byte aligned for the kernel's SSE memory operands;
        # _sx_blend_consts over-allocates and returns the raw pointer through
        # `raw` for freeing — the aligned pointer is interior and must NOT be
        # passed to fl_free.
        var raw = fl_alloc(8);
        if (raw == 0) { return blend_row_normal_scalar(src, dst, n, opacity); }
        var c = _sx_blend_consts(opacity & 255, raw);
        if (c == 0) {
            fl_free(raw);
            return blend_row_normal_scalar(src, dst, n, opacity);
        }
        _sx_blend_row_sse2(src, dst, pairs, c);
        fl_free(load64(raw));
        fl_free(raw);
    }

    # Odd trailing pixel.
    var done = pairs * 2;
    if (done < n) {
        blend_row_normal_scalar(src + done * 4, dst + done * 4, n - done, opacity);
    }
    return RG_ERR_NONE;
}

# ── blend_row_normal_argb (ARGB8) ────────
# Alpha is byte 0, colour is bytes 1..3.
#
# Unlike the RGBA variant this DOES have a fully-opaque fast path: `sa >= 255`
# copies the source pixel wholesale.
fn blend_row_normal_argb_scalar(src, dst, n, opacity) {
    var i = 0;
    while (i < n) {
        var s = src + i * 4;
        var d = dst + i * 4;
        var sa = _bl_div255(load8(s) * (opacity & 255));
        if (sa != 0) {
            if (sa >= 255) {
                store8(d, load8(s));
                store8(d + 1, load8(s + 1));
                store8(d + 2, load8(s + 2));
                store8(d + 3, load8(s + 3));
            }
            if (sa < 255) {
                var inv = 255 - sa;
                var na = _bl_div255(sa * 255 + load8(d) * inv);
                if (na > 255) { na = 255; }
                store8(d, na);
                store8(d + 1, _bl_div255(load8(s + 1) * sa + load8(d + 1) * inv));
                store8(d + 2, _bl_div255(load8(s + 2) * sa + load8(d + 2) * inv));
                store8(d + 3, _bl_div255(load8(s + 3) * sa + load8(d + 3) * inv));
            }
        }
        i = i + 1;
    }
    return RG_ERR_NONE;
}

fn blend_row_normal_argb(src, dst, n, opacity) {
    if (n < 0) { return RG_ERR_NONE; }
    return blend_row_normal_argb_scalar(src, dst, n, opacity);
}

# ── blend_row ────────
# Any mode, RGBA8, in place. Normal routes to the optimised row path; every
# other mode goes per-pixel.
fn blend_row(src, dst, n, mode, opacity) {
    if (n < 0) { return RG_ERR_NONE; }
    if (blend_mode_is_valid(mode) == 0) { return RG_ERR_INVALID_PARAMETER; }
    if (mode == BM_NORMAL) {
        return blend_row_normal(src, dst, n, opacity);
    }
    var i = 0;
    while (i < n) {
        blend_pixel(src + i * 4, dst + i * 4, mode, opacity, dst + i * 4);
        i = i + 1;
    }
    return RG_ERR_NONE;
}
