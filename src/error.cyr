# error.cyr -- ranga error codes and Rust-semantics math shims
# Ported from rust-old/src/error.rs (RangaError).
#
# Replaces Rust's RangaError enum with integer error codes. Functions return
# RG_ERR_NONE (0) on success or a negative RG_ERR_* code on failure. Where a
# function also returns a value, it takes an `err_out` pointer and writes the
# code there. The detailed context Rust carried in the variant payloads
# (expected/actual sizes, format names) is not carried anywhere: an i64 code has
# no room for it, and nothing logs it. See ranga_error_message.
#
# Rust variant                          -> code
#   InvalidFormat(String)               -> RG_ERR_INVALID_FORMAT
#   DimensionMismatch{expected,actual}  -> RG_ERR_DIMENSION_MISMATCH
#   BufferTooSmall{need,have}           -> RG_ERR_BUFFER_TOO_SMALL
#   UnsupportedConversion{from,to}      -> RG_ERR_UNSUPPORTED_CONVERSION
#   Other(String)                       -> RG_ERR_OTHER
#
# Pairs with tagged.cyr for Result-like patterns when an Option is needed.

var RG_ERR_NONE                   = 0;

# The pixel format is invalid or unsupported for this operation.
var RG_ERR_INVALID_FORMAT         = (0 - 1);
# Buffer dimensions do not match the expected size.
var RG_ERR_DIMENSION_MISMATCH     = (0 - 2);
# The provided buffer is too small for the operation.
var RG_ERR_BUFFER_TOO_SMALL       = (0 - 3);
# The requested conversion between formats is not supported.
var RG_ERR_UNSUPPORTED_CONVERSION = (0 - 4);
# A parameter is outside the valid range, in a way Rust's types could not
# express: a negative radius or size (Rust takes u32/usize), or an unknown
# BlendMode/ScaleFilter value. Rust has no such variant. Where Rust returns
# Other for a bad value (bilateral sigma <= 0, levels gamma <= 0), the port
# returns RG_ERR_OTHER as well (since 2.2.0 for bilateral).
var RG_ERR_INVALID_PARAMETER      = (0 - 5);
# An allocation was refused — the request exceeds ALLOC_MAX, the size
# computation overflowed, or the heap is exhausted. Distinct from
# RG_ERR_INVALID_PARAMETER: the arguments were sane, the memory was not there.
# This is the code checked_buffer_size() guards against on the Rust side.
var RG_ERR_ALLOCATION             = (0 - 6);
# Malformed input bytes — an ICC profile that fails structural validation, or
# a .cube LUT that is not well-formed.
var RG_ERR_PARSE                  = (0 - 7);
# A generic failure with no more specific code (Rust's Other(String)).
var RG_ERR_OTHER                  = (0 - 8);

# 1 if `code` is an error (negative), else 0.
# Rust's `thiserror` Display strings for RangaError. Without this the eight
# RG_ERR_* codes are opaque negative integers at the API boundary: a consumer
# can tell that something failed and nothing about what.
#
# The payloads Rust interpolated — `need`/`have` on BufferTooSmall,
# `expected`/`actual` on DimensionMismatch, `from`/`to` on
# UnsupportedConversion — are NOT recoverable here, because an i64 code carries
# no payload. So these are the format strings with the placeholders removed
# rather than the full Rust messages, and that loss is real: Rust's own tests
# assert on the interpolated values. Recording it plainly beats a message that
# implies detail it does not have. Other(String) is "{0}" in Rust, all payload, so
# it renders as the bare "error". (Up to 2.1.2 InvalidFormat read "invalid format",
# not Rust's "invalid pixel format".)
#must_use
fn ranga_error_message(code) {
    if (code == RG_ERR_NONE) { return "no error"; }
    if (code == RG_ERR_INVALID_FORMAT) { return "invalid pixel format"; }
    if (code == RG_ERR_DIMENSION_MISMATCH) { return "dimension mismatch"; }
    if (code == RG_ERR_BUFFER_TOO_SMALL) { return "buffer too small"; }
    if (code == RG_ERR_UNSUPPORTED_CONVERSION) { return "unsupported conversion"; }
    if (code == RG_ERR_INVALID_PARAMETER) { return "invalid parameter"; }
    if (code == RG_ERR_ALLOCATION) { return "allocation failed"; }
    if (code == RG_ERR_PARSE) { return "parse error"; }
    if (code == RG_ERR_OTHER) { return "error"; }
    return "unknown error code";
}

#must_use
fn ranga_is_err(code) {
    if (code < 0) { return 1; }
    return 0;
}

# 1 if `code` is success (RG_ERR_NONE), else 0.
#must_use
fn ranga_is_ok(code) {
    if (code == 0) { return 1; }
    return 0;
}

# ── Rust-semantics math shims ────────
# When the port was written, the Cyrius math builtins diverged from Rust's f64
# methods at the zero and infinite boundaries: `ganita_f64_pow` was
# exp(n*ln(base)), and the x87 `exp` returned NaN for an infinite argument. Every
# ported call site that can reach those boundaries goes through these shims so
# the port keeps matching `rust-old/`. prakash hit the same divergence and shims
# it in its own error.cyr (`_prk_pow` / `_prk_exp`).
#
#   expression              builtin then   builtin at 6.7.18   Rust    shim
#   ganita_f64_pow(0.0, 2)  NaN            0.0                 0.0     0.0
#   f64_exp(-inf)           NaN            0.0                 0.0     0.0
#   f64_exp(+inf)           NaN            +inf                +inf    +inf
#
# At the 6.7.18 pin the builtins already give Rust's answer at these boundaries
# (probed for 2.1.2), so the shims are redundant there. They are kept because
# they state the Rust contract independently of the stdlib snapshot. Finite
# arguments are delegated unchanged, so no in-range result moves.

var _RG_INF     = 0x7FF0000000000000;
var _RG_NEG_INF = 0xFFF0000000000000;
var _RG_NAN     = 0x7FF8000000000000;

# Rust `f64::exp` semantics. Only the infinite arguments are special-cased;
# NaN in still gives NaN out, matching Rust.
#
# This is load-bearing for the filters, not theoretical: the Gaussian and
# bilateral kernels evaluate exp(-d^2 / 2*sigma^2), and a large spatial or
# range distance drives that argument to -inf. Rust yields a 0.0 weight — the
# sample simply does not contribute; the unshimmed builtin yields NaN, which
# then poisons the whole accumulator for that pixel.
#must_use
fn _rg_exp(x) {
    if (x == _RG_INF) { return _RG_INF; }
    if (x == _RG_NEG_INF) { return 0; }
    return f64_exp(x);
}

# Rust `f64::powf` semantics for a non-negative base. `ganita_f64_pow` computes
# exp(n*ln(base)), so a zero base gives exp(-inf) = NaN where Rust gives 0.0
# (positive exponent), 1.0 (zero exponent) or +inf (negative exponent).
#
# ranga reaches the zero base through the ICC tone curves and the sRGB transfer
# function, which raise a channel value to a gamma — and a fully black channel
# is exactly 0.0, so this is hit by ordinary image data, not an edge case.
#
# A negative base is delegated unchanged: Rust's powf is also NaN there for a
# non-integer exponent, and no ranga call site raises a negative base.
#must_use
fn _rg_pow(base, exp) { return ganita_f64_pow(base, exp); }

# Rust `f64::cbrt`. There is NO f64 cbrt anywhere in the Cyrius tree —
# `ganita_f32_cbrt` is the only one, and dropping to single precision would cost
# ~8 significant digits in the CIE Lab transfer, where ranga's Delta-E tests
# assert against tight tolerances.
#
# Built from pow, and the sign split is REQUIRED rather than decorative: pow
# goes through exp(y*ln x), and ln of a negative is undefined, so a bare
# _rg_pow returns garbage for every negative input while looking correct for
# the positives a naive test would use. Same reasoning ganita applies in
# ganita_f32_cbrt.
#must_use
# ── Rust-semantics math shims ────────
#
# ⚠ ALL THREE ARE NOW THIN DELEGATIONS. ganita 1.1.4 — folded into cyrius 6.5.30,
# which this project's 6.5.31 pin carries — fixed both defects these existed to
# work around: `ganita_f32_cbrt(0.0)` returned NaN (it is `exp(y·ln x)`
# underneath, and `ln 0` is -inf), and `ganita_f64_pow` had no zero-base or
# negative-base handling at all.
#
# 1.1.4 goes FURTHER than these shims did: it also returns a real value for a
# negative base with an integral exponent, where the old path gave NaN. That is
# Rust's `powf` behaviour, so the delegation moves ranga CLOSER to parity, not
# away from it.
#
# The wrappers are kept rather than inlined at their 16 call sites: the names
# document which calls are parity-sensitive, and a future ganita regression has
# one place to be re-patched instead of sixteen.
#
# Integral exponents are accurate to 2 ULP rather than exact — the general path
# is `exp(y·ln x)` where Rust's `powf` is exact. MEASURED, because the raw
# difference is easy to overstate: `pow(2,3)` differs from 8.0 by 1e-15, and
# sweeping all 256 inputs through a gamma-2.0 ICC tone curve gives ZERO bytes
# different from exact `x*x`. It cannot move a u8 or an f32 result. Pinned by a
# test in tests/ranga.tcyr so this does not get re-litigated from a truncated
# print.
#must_use
fn _rg_f32_cbrt(x) { return ganita_f32_cbrt(x); }

fn _rg_cbrt(x) {
    var third = f64_div(F64_ONE, f64_from(3));
    if (f64_lt(x, 0) == 1) {
        return f64_neg(_rg_pow(f64_abs(x), third));
    }
    return _rg_pow(x, third);
}

# NOTE the sign split above is still ranga's, not ganita's: 1.1.4's pow rejects
# a negative base with a NON-integral exponent (1/3 is non-integral), returning
# NaN exactly as Rust's powf does. Rust's `f64::cbrt` however is defined for
# negatives, so the split is what makes cbrt(-8) = -2 rather than NaN.

# Sine/cosine: NaN for a non-finite angle (as Rust's sin/cos), and every finite
# angle delegated unchanged.
#
# Up to 2.1.1 this guarded |x| >= 2^63, because x86 `fsin`/`fcos` return the
# ARGUMENT unchanged there (`f64_sin(1e300)` was 1e300). The toolchain has since
# replaced them: at the 6.7.18 pin `f64_sin`/`f64_cos` reduce every finite argument
# and match libm bit for bit (checked at 1e20, 3e23, 1.6e60 and f64::MAX), and libm
# is what Rust calls. The old guard therefore turned a correct answer into NaN:
# `affine_rotate(1e20)` was NaN where Rust is finite.
#must_use
fn _rg_sin(x) {
    if (f64_lt(f64_abs(x), _RG_INF) == 0) { return _RG_NAN; }
    return f64_sin(x);
}

#must_use
fn _rg_cos(x) {
    if (f64_lt(f64_abs(x), _RG_INF) == 0) { return _RG_NAN; }
    return f64_cos(x);
}

# ── f32 -> byte, the way Rust writes it ────────
# Rust's colour code ends every f32 -> byte conversion with
# `x.clamp(0.0, 255.0) as u8`, and the cast SATURATES: NaN gives 0, anything
# below 0 gives 0, anything at or above 255 gives 255. Cyrius's f64_to saturates
# to the i64 range (NaN gives 0, +/-inf give the i64 limits; probed at 6.6.9 and
# 6.7.18), not to a byte, so every such site clamps through here.
#must_use
fn _rg_f32_sat_u8(v) {
    var d = f32_to(v);
    if (f64_eq(d, d) == 0) { return 0; }
    if (f64_lt(d, 0) == 1) { return 0; }
    if (f64_ge(d, 255.0) == 1) { return 255; }
    return f64_to(d);
}

# `(v * 255.0 + 0.5).clamp(0.0, 255.0) as u8` in SINGLE precision, as Rust writes
# it. Widening v to f64 first is more accurate and therefore WRONG: where the f32
# product lands exactly on k + 0.5, Rust rounds up and an f64 product stays just
# below. f32 0x3f010101 (the f32 nearest 128.5/255) gives 129 in Rust and gave
# 128 through f64 up to 2.1.2: one input next to each of the 128 half-steps in
# [0, 1] (scripts/oracle).
#must_use
fn _rg_f32_round_u8(v: f32) {
    var x: f32 = v * f32_from(255.0) + f32_from(0.5);
    return _rg_f32_sat_u8(x);
}
