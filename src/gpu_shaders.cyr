# Rust's `build_shader`: every body needs unpack_rgba and pack_rgba in scope, so
# the helpers are prepended rather than repeated in each source.
#must_use
fn gpu_shader_build(body: Str): Str {
    return str_cat(_gs_pack_helpers(), body);
}
