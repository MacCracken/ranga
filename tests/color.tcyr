# color.tcyr — colour spaces and conversions
# Ported from rust-old/src/color.rs #[cfg(test)] and its doctests.

include "src/error.cyr"
include "src/color.cyr"

alloc_init();

# f64 approximate equality — every colour assertion below is a float compare,
# and exact equality would fail on the last mantissa bit for no useful reason.
fn absd8(a, b) { if (a > b) { return a - b; } return b - a; }
fn approx(a, b, eps) {
    if (f64_lt(f64_abs(f64_sub(a, b)), eps) == 1) { return 1; }
    return 0;
}

# ================================================================
# sRGB transfer function
# ================================================================
test_group("srgb transfer");

# ⚠ srgb_to_linear IS SINGLE PRECISION. Rust is `c as f32 / 255.0` with f32
# literals and f32::powf, so every intermediate rounds to f32. The port computed
# in f64 and narrowed once at the end — more accurate, and therefore wrong:
# measured against the real crate, 214 of the 256 possible inputs differed by
# one or two ULP. After the rewrite all 256 are bit-identical. These pin the
# three regions of the curve.
assert_eq(srgb_to_linear(0), f32_from(0), "0 maps to 0.0");
assert_eq(srgb_to_linear(255), f32_from(F64_ONE), "255 maps to exactly 1.0");
# 10 is on the linear segment (s <= 0.04045); 9 and 11 straddle it on the curve.
assert_eq(srgb_to_linear(9), 993199883, "the linear segment is bit-exact against Rust");
assert_eq(srgb_to_linear(11), 995840397, "and so is the power segment just above the knee");
assert_eq(srgb_to_linear(128), 1046284939, "and mid-grey");

# ⚠ NON-FINITE INPUT. Rust's float-to-int `as` cast SATURATES — NaN gives 0,
# +inf gives 255, -inf gives 0. Cyrius's f64_to returns i64::MIN instead, so
# linear_to_srgb was returning -9223372036854775808 from something whose
# contract is a byte. Measured against the real crate built with cargo.
assert_eq(linear_to_srgb(0x7FC00000), 0, "linear_to_srgb(NaN) is 0, not i64::MIN");
assert_eq(linear_to_srgb(0xFFC00000), 0, "and -NaN is 0");
assert_eq(linear_to_srgb(0x7F800000), 255, "+inf saturates to 255");
assert_eq(linear_to_srgb(0xFF800000), 0, "-inf saturates to 0");
# Finite behaviour is unchanged — this was verified over 14,013 inputs against
# the real Rust crate, byte-identical.
assert_eq(linear_to_srgb(f32_from(0)), 0, "0.0 is still 0");
assert_eq(linear_to_srgb(f32_from(F64_ONE)), 255, "1.0 is still 255");
assert_eq(linear_to_srgb(f32_from(0.5)), 188, "0.5 is still 188");

# Doctest anchors: the endpoints are exact.
assert_eq(f64_to(f32_to(srgb_to_linear(0))), 0, "srgb_to_linear(0) == 0.0");
assert_eq(approx(f32_to(srgb_to_linear(255)), F64_ONE, 0.0001), 1, "srgb_to_linear(255) == 1.0");

# Doctest: mid-grey lands between 0.2 and 0.3 — the whole point of the curve
# being non-linear. A linear ramp would put 128/255 at ~0.502.
var mid = f32_to(srgb_to_linear(128));
assert_eq(f64_gt(mid, 0.2), 1, "srgb_to_linear(128) > 0.2 (doctest)");
assert_eq(f64_lt(mid, 0.3), 1, "srgb_to_linear(128) < 0.3 (doctest)");

# Doctest: linear_to_srgb endpoints.
assert_eq(linear_to_srgb(f32_from(f64_from(0))), 0, "linear_to_srgb(0.0) == 0 (doctest)");
assert_eq(linear_to_srgb(f32_from(F64_ONE)), 255, "linear_to_srgb(1.0) == 255 (doctest)");

# Clamping, not wrapping: out-of-gamut input saturates.
assert_eq(linear_to_srgb(f32_from(2.0)), 255, "linear_to_srgb clamps above 1.0");
assert_eq(linear_to_srgb(f32_from(f64_neg(F64_ONE))), 0, "linear_to_srgb clamps below 0.0");

# Round-trip through both directions is stable for every byte value. This is
# the assertion that catches a missing +0.5 rounding term — without it the
# round trip drifts down by one level across most of the range.
var i = 0;
var roundtrip_ok = 1;
while (i < 256) {
    if (linear_to_srgb(srgb_to_linear(i)) != i) { roundtrip_ok = 0; }
    i = i + 1;
}
assert_eq(roundtrip_ok, 1, "srgb -> linear -> srgb round-trips exactly for all 256 values");

# ================================================================
# Srgba <-> LinRgba
# ================================================================
test_group("srgba <-> linrgba");

var white = srgba_new(255, 255, 255, 255);
assert_eq(srgba_r(white), 255, "srgba_r");
assert_eq(srgba_a(white), 255, "srgba_a");

var lin = srgba_to_lin_rgba(white);
assert_eq(approx(f32_to(lin_rgba_r(lin)), F64_ONE, 0.0001), 1, "white -> linear r == 1.0");
assert_eq(approx(f32_to(lin_rgba_a(lin)), F64_ONE, 0.0001), 1, "alpha scales linearly to 1.0");

var back = lin_rgba_to_srgba(lin);
assert_eq(srgba_r(back), 255, "white round-trips r");
assert_eq(srgba_a(back), 255, "white round-trips a");
srgba_free(back);
lin_rgba_free(lin);

# Alpha must NOT go through the gamma transfer — it is linear coverage, not a
# colour channel. Running it through srgb_to_linear would turn 128 into ~55.
var half_alpha = srgba_new(0, 0, 0, 128);
var la = srgba_to_lin_rgba(half_alpha);
assert_eq(approx(f32_to(lin_rgba_a(la)), 0.50196, 0.001), 1, "alpha 128 -> 0.502 linearly, not gamma-decoded");
var ba = lin_rgba_to_srgba(la);
assert_eq(srgba_a(ba), 128, "alpha 128 round-trips");
srgba_free(ba);
lin_rgba_free(la);
srgba_free(half_alpha);

# ================================================================
# CieXyz white points and the sRGB matrices
# ================================================================
test_group("cie xyz");

var d65 = cie_xyz_d65_white();
assert_eq(approx(cie_xyz_x(d65), 0.95047, 0.00001), 1, "D65 white X");
assert_eq(approx(cie_xyz_y(d65), F64_ONE, 0.00001), 1, "D65 white Y == 1.0");
assert_eq(approx(cie_xyz_z(d65), 1.08883, 0.00001), 1, "D65 white Z");

var d50 = cie_xyz_d50_white();
assert_eq(approx(cie_xyz_x(d50), 0.96422, 0.00001), 1, "D50 white X");
cie_xyz_free(d50);

# Linear white through the sRGB matrix must reproduce the D65 white point —
# that is what it means for the matrix to be D65-adapted. A transposed or
# mis-typed coefficient shows up here immediately.
var linwhite = lin_rgba_new(f32_from(F64_ONE), f32_from(F64_ONE), f32_from(F64_ONE), f32_from(F64_ONE));
var xyzwhite = lin_rgba_to_cie_xyz(linwhite);
assert_eq(approx(cie_xyz_x(xyzwhite), 0.95047, 0.001), 1, "linear white -> D65 X");
assert_eq(approx(cie_xyz_y(xyzwhite), F64_ONE, 0.001), 1, "linear white -> Y == 1.0");
assert_eq(approx(cie_xyz_z(xyzwhite), 1.08883, 0.001), 1, "linear white -> D65 Z");

# And back again — the two matrices are inverses.
var linback = cie_xyz_to_lin_rgba(xyzwhite);
assert_eq(approx(f32_to(lin_rgba_r(linback)), F64_ONE, 0.001), 1, "XYZ -> linear r round-trips");
assert_eq(approx(f32_to(lin_rgba_g(linback)), F64_ONE, 0.001), 1, "XYZ -> linear g round-trips");
assert_eq(approx(f32_to(lin_rgba_b(linback)), F64_ONE, 0.001), 1, "XYZ -> linear b round-trips");
assert_eq(approx(f32_to(lin_rgba_a(linback)), F64_ONE, 0.0001), 1, "XYZ -> linear sets alpha opaque");
lin_rgba_free(linback);
lin_rgba_free(linwhite);
cie_xyz_free(xyzwhite);

# ================================================================
# CieLab
# ================================================================
test_group("cie lab");

# D65 white is L*=100, a*=0, b*=0 by definition. This exercises _rg_cbrt on the
# t > epsilon branch; a broken cbrt moves L* off 100 immediately.
var labwhite = cie_xyz_to_cie_lab(d65);
assert_eq(approx(cie_lab_l(labwhite), 100.0, 0.01), 1, "D65 white is L* = 100");
assert_eq(approx(cie_lab_a(labwhite), 0, 0.01), 1, "D65 white is a* = 0");
assert_eq(approx(cie_lab_b(labwhite), 0, 0.01), 1, "D65 white is b* = 0");

# Round-trip back to XYZ.
var xyzback = cie_lab_to_cie_xyz(labwhite);
assert_eq(approx(cie_xyz_x(xyzback), 0.95047, 0.0001), 1, "Lab -> XYZ round-trips X");
assert_eq(approx(cie_xyz_y(xyzback), F64_ONE, 0.0001), 1, "Lab -> XYZ round-trips Y");
assert_eq(approx(cie_xyz_z(xyzback), 1.08883, 0.0001), 1, "Lab -> XYZ round-trips Z");
cie_xyz_free(xyzback);

# Black exercises the OTHER branch of _lab_f — the linear segment below
# epsilon, where cbrt is not used at all.
var xyzblack = cie_xyz_new(0, 0, 0);
var labblack = cie_xyz_to_cie_lab(xyzblack);
assert_eq(approx(cie_lab_l(labblack), 0, 0.01), 1, "black is L* = 0 (linear segment)");
cie_xyz_free(xyzblack);

# sRGB white all the way through to Lab in one call.
var labfromsrgb = srgba_to_cie_lab(white);
assert_eq(approx(cie_lab_l(labfromsrgb), 100.0, 0.05), 1, "sRGB white -> L* = 100");

# ================================================================
# Delta-E CIE76
# ================================================================
test_group("delta-e cie76");

assert_eq(approx(delta_e_cie76(labwhite, labwhite), 0, 0.00001), 1, "a colour is identical to itself");

# Pure Euclidean distance: a 25-unit shift on a* alone is a delta of 25.
var l1 = cie_lab_new(50.0, 25.0, 0);
var l2 = cie_lab_new(50.0, 0, 0);
assert_eq(approx(delta_e_cie76(l1, l2), 25.0, 0.0001), 1, "a* shift of 25 is delta 25");
assert_eq(f64_gt(delta_e_cie76(l1, l2), 0), 1, "distinct colours have a positive delta (doctest)");

# 3-4-5 triangle across the three axes: sqrt(9 + 16 + 0) = 5.
var l3 = cie_lab_new(3.0, 4.0, 0);
var l4 = cie_lab_new(0, 0, 0);
assert_eq(approx(delta_e_cie76(l3, l4), 5.0, 0.0001), 1, "3-4-5 across L* and a*");

# Symmetry.
assert_eq(approx(delta_e_cie76(l1, l2), delta_e_cie76(l2, l1), 0.00001), 1, "delta-e is symmetric");

cie_lab_free(l1); cie_lab_free(l2); cie_lab_free(l3); cie_lab_free(l4);
cie_lab_free(labfromsrgb); cie_lab_free(labblack); cie_lab_free(labwhite);
cie_xyz_free(d65);
srgba_free(white);

# ================================================================
# HSL
# ================================================================
test_group("hsl");

var red = srgba_new(255, 0, 0, 255);
var hsl_red = srgba_to_hsl(red);
assert_eq(approx(f32_to(hsl_h(hsl_red)), 0, 0.01), 1, "pure red is hue 0");
assert_eq(approx(f32_to(hsl_s(hsl_red)), F64_ONE, 0.01), 1, "pure red is fully saturated");
assert_eq(approx(f32_to(hsl_l(hsl_red)), 0.5, 0.01), 1, "pure red is lightness 0.5");

var green = srgba_new(0, 255, 0, 255);
var hsl_green = srgba_to_hsl(green);
assert_eq(approx(f32_to(hsl_h(hsl_green)), 120.0, 0.01), 1, "pure green is hue 120");

var blue = srgba_new(0, 0, 255, 255);
var hsl_blue = srgba_to_hsl(blue);
assert_eq(approx(f32_to(hsl_h(hsl_blue)), 240.0, 0.01), 1, "pure blue is hue 240");

# Grey is achromatic: saturation 0, and hue pinned to 0 rather than left to a
# division by a zero delta.
var grey = srgba_new(128, 128, 128, 255);
var hsl_grey = srgba_to_hsl(grey);
assert_eq(approx(f32_to(hsl_s(hsl_grey)), 0, 0.001), 1, "grey has zero saturation");
assert_eq(approx(f32_to(hsl_h(hsl_grey)), 0, 0.001), 1, "grey hue is pinned to 0");

# The g < b branch: magenta sits in the red sector but needs the +6 wrap, so a
# missing wrap shows up as a negative hue here.
var magenta = srgba_new(255, 0, 255, 255);
var hsl_mag = srgba_to_hsl(magenta);
assert_eq(approx(f32_to(hsl_h(hsl_mag)), 300.0, 0.01), 1, "magenta is hue 300 (the g < b wrap)");
assert_eq(f64_ge(f32_to(hsl_h(hsl_mag)), 0), 1, "hue is never negative");

# Round-trips.
var red_back = hsl_to_srgba(hsl_red);
assert_eq(srgba_r(red_back), 255, "red round-trips r");
assert_eq(srgba_g(red_back), 0, "red round-trips g");
assert_eq(srgba_b(red_back), 0, "red round-trips b");
var grey_back = hsl_to_srgba(hsl_grey);
assert_eq(srgba_r(grey_back), 128, "grey round-trips through the achromatic path");
var mag_back = hsl_to_srgba(hsl_mag);
assert_eq(srgba_r(mag_back), 255, "magenta round-trips r");
assert_eq(srgba_b(mag_back), 255, "magenta round-trips b");

srgba_free(red_back); srgba_free(grey_back); srgba_free(mag_back);
hsl_free(hsl_red); hsl_free(hsl_green); hsl_free(hsl_blue);
hsl_free(hsl_grey); hsl_free(hsl_mag);

# ================================================================
# CMYK
# ================================================================
test_group("cmyk");

# Doctest: pure cyan is (0, 255, 255).
var cyan = cmyk_new(f32_from(F64_ONE), f32_from(0), f32_from(0), f32_from(0));
var cyan_rgb = cmyk_to_srgba(cyan);
assert_eq(srgba_r(cyan_rgb), 0, "cyan r == 0 (doctest)");
assert_eq(srgba_g(cyan_rgb), 255, "cyan g == 255 (doctest)");
assert_eq(srgba_b(cyan_rgb), 255, "cyan b == 255 (doctest)");

# Doctest: white has k == 0.
var cmyk_white = srgba_to_cmyk(white);
assert_eq(approx(f32_to(cmyk_k(cmyk_white)), 0, 0.01), 1, "white has k == 0 (doctest)");
assert_eq(approx(f32_to(cmyk_c(cmyk_white)), 0, 0.01), 1, "white has c == 0");

# Pure black takes the guarded branch — inv_k would divide by zero.
var black_srgb = srgba_new(0, 0, 0, 255);
var cmyk_black = srgba_to_cmyk(black_srgb);
assert_eq(approx(f32_to(cmyk_k(cmyk_black)), F64_ONE, 0.001), 1, "black has k == 1");
assert_eq(approx(f32_to(cmyk_c(cmyk_black)), 0, 0.001), 1, "black has c == 0, not NaN");

var cmyk_red = srgba_to_cmyk(red);
var red_rt = cmyk_to_srgba(cmyk_red);
assert_eq(srgba_r(red_rt), 255, "red round-trips through cmyk r");
assert_eq(srgba_g(red_rt), 0, "red round-trips through cmyk g");

srgba_free(red_rt); cmyk_free(cmyk_red); cmyk_free(cmyk_black);
srgba_free(black_srgb); cmyk_free(cmyk_white); srgba_free(cyan_rgb); cmyk_free(cyan);

# ================================================================
# Display P3
# ================================================================
test_group("display p3");

var trip = fl_alloc(24);
# Doctest: sRGB red fits inside P3, so the P3 red coordinate is below 1.0.
linear_srgb_to_p3(F64_ONE, 0, 0, trip);
assert_eq(f64_lt(load64(trip), F64_ONE), 1, "sRGB red fits within P3 (doctest)");
assert_eq(f64_gt(load64(trip), 0.8), 1, "sRGB red is most of P3 red");

# The two matrices are inverses: round-tripping white returns white.
var trip2 = fl_alloc(24);
linear_srgb_to_p3(F64_ONE, F64_ONE, F64_ONE, trip);
p3_to_linear_srgb(load64(trip), load64(trip + 8), load64(trip + 16), trip2);
assert_eq(approx(load64(trip2), F64_ONE, 0.0001), 1, "P3 round-trip preserves white r");
assert_eq(approx(load64(trip2 + 8), F64_ONE, 0.0001), 1, "P3 round-trip preserves white g");
assert_eq(approx(load64(trip2 + 16), F64_ONE, 0.0001), 1, "P3 round-trip preserves white b");

# ================================================================
# Oklab / Oklch
# ================================================================
test_group("oklab");

# ⚠ BLACK. Rust pins this in its own `oklab_black` test, and the port did not
# port it — which is how `oklab(black) == (NaN, NaN, NaN)` shipped through eight
# milestones. `ganita_f32_cbrt(0.0)` returns NaN (it is exp(y·ln 0) underneath),
# where Rust's `f32::cbrt(0.0)` is 0.0, and the NaN then propagated through the
# whole M2 matrix. Black is the most common pixel value there is.
var _ok_zero = f32_from(0);
var _ok_one = f32_from(F64_ONE);
var _ok_black = lin_rgba_to_oklab(lin_rgba_new(_ok_zero, _ok_zero, _ok_zero, _ok_one));
assert_eq(oklab_l(_ok_black), 0, "Oklab L of linear black is exactly 0, not NaN");
assert_eq(oklab_a(_ok_black), 0, "Oklab a of black is 0");
assert_eq(oklab_b(_ok_black), 0, "Oklab b of black is 0");
# NaN is not equal to itself — the assertions above would pass on a wrong-but-
# finite value, so test the property directly too.
assert_eq(f64_eq(f32_to(oklab_l(_ok_black)), f32_to(oklab_l(_ok_black))), 1,
  "and it is a real number, not NaN");
# sRGB black takes the same path through srgba_to_oklab.
var _ok_sblack = srgba_to_oklab(srgba_new(0, 0, 0, 255));
assert_eq(oklab_l(_ok_sblack), 0, "sRGB black also gives L = 0");
# The shim itself: only zero is intercepted, every other input keeps the f32 tier.
assert_eq(_rg_f32_cbrt(f32_from(0)), 0, "_rg_f32_cbrt(0) is 0");
assert_eq(_rg_f32_cbrt(0x80000000), 0x80000000, "and -0.0 keeps its sign");
assert_eq(_rg_f32_cbrt(f32_from(f64_from(8))), ganita_f32_cbrt(f32_from(f64_from(8))),
  "while a nonzero input is unchanged from the stdlib routine");

# Doctest: linear red has 0 < l < 1.
var lin_red = lin_rgba_new(f32_from(F64_ONE), f32_from(0), f32_from(0), f32_from(F64_ONE));
var ok_red = lin_rgba_to_oklab(lin_red);
assert_eq(f64_gt(f32_to(oklab_l(ok_red)), 0), 1, "oklab red l > 0 (doctest)");
assert_eq(f64_lt(f32_to(oklab_l(ok_red)), F64_ONE), 1, "oklab red l < 1 (doctest)");

# Oklab is built so that neutral grey has a == b == 0. Linear white must land
# at l == 1 with no chroma — the tightest single check on both matrices.
var lin_white2 = lin_rgba_new(f32_from(F64_ONE), f32_from(F64_ONE), f32_from(F64_ONE), f32_from(F64_ONE));
var ok_white = lin_rgba_to_oklab(lin_white2);
assert_eq(approx(f32_to(oklab_l(ok_white)), F64_ONE, 0.001), 1, "linear white is Oklab l == 1");
assert_eq(approx(f32_to(oklab_a(ok_white)), 0, 0.001), 1, "linear white is achromatic in a");
assert_eq(approx(f32_to(oklab_b(ok_white)), 0, 0.001), 1, "linear white is achromatic in b");

# Round-trip through the inverse matrices.
var lin_back2 = oklab_to_lin_rgba(ok_red);
assert_eq(approx(f32_to(lin_rgba_r(lin_back2)), F64_ONE, 0.001), 1, "oklab -> linear round-trips r");
assert_eq(approx(f32_to(lin_rgba_g(lin_back2)), 0, 0.001), 1, "oklab -> linear round-trips g");
assert_eq(approx(f32_to(lin_rgba_b(lin_back2)), 0, 0.001), 1, "oklab -> linear round-trips b");

var ok_from_srgb = srgba_to_oklab(red);
assert_eq(f64_gt(f32_to(oklab_l(ok_from_srgb)), 0), 1, "sRGB red -> Oklab l > 0 (doctest)");

test_group("oklch");

# Doctest: grey is achromatic, so chroma < 1e-5.
var ok_grey = oklab_new(f32_from(0.5), f32_from(0), f32_from(0));
var lch_grey = oklab_to_oklch(ok_grey);
assert_eq(f64_lt(f32_to(oklch_c(lch_grey)), 0.00001), 1, "grey is achromatic (doctest)");
assert_eq(approx(f32_to(oklch_h(lch_grey)), 0, 0.001), 1, "achromatic hue is pinned to 0");

# Doctest: Oklch(0.7, 0.15, 180) is Oklab a == -0.15, b == 0.
var lch = oklch_new(f32_from(0.7), f32_from(0.15), f32_from(180.0));
var lab_from_lch = oklch_to_oklab(lch);
assert_eq(approx(f32_to(oklab_a(lab_from_lch)), f64_neg(0.15), 0.00001), 1, "hue 180 gives a == -0.15 (doctest)");
assert_eq(approx(f32_to(oklab_b(lab_from_lch)), 0, 0.00001), 1, "hue 180 gives b == 0 (doctest)");

# Hue wraps into [0, 360): a negative atan2 result must come back positive.
var ok_neg_b = oklab_new(f32_from(0.5), f32_from(0.1), f32_from(f64_neg(0.1)));
var lch_neg = oklab_to_oklch(ok_neg_b);
assert_eq(f64_ge(f32_to(oklch_h(lch_neg)), 0), 1, "negative-b hue wraps non-negative");
assert_eq(f64_lt(f32_to(oklch_h(lch_neg)), 360.0), 1, "hue stays below 360");

oklab_free(ok_neg_b); oklch_free(lch_neg); oklab_free(lab_from_lch); oklch_free(lch);
oklch_free(lch_grey); oklab_free(ok_grey); oklab_free(ok_from_srgb);
lin_rgba_free(lin_back2); oklab_free(ok_white); lin_rgba_free(lin_white2);
oklab_free(ok_red); lin_rgba_free(lin_red);

# ================================================================
# Colour temperature
# ================================================================
test_group("color temperature");

var rgb3 = fl_alloc(12);

# 6600K is the branch boundary and is near-neutral daylight.
color_temperature(f32_from(6600.0), rgb3);
assert_eq(approx(f32_to(load32(rgb3)), F64_ONE, 0.001), 1, "6600K red is 1.0");
assert_eq(f64_gt(f32_to(load32(rgb3 + 4)), 0.9), 1, "6600K green is near 1.0");

# Warm light is red-dominant; cool light is blue-dominant. Direction matters
# more than exact values here.
color_temperature(f32_from(2000.0), rgb3);
var warm_r = f32_to(load32(rgb3));
var warm_b = f32_to(load32(rgb3 + 8));
assert_eq(f64_gt(warm_r, warm_b), 1, "2000K is red-dominant");

# The blue cutoff is temp <= 19, i.e. 1900K — not 2000K, which is temp 20 and
# does carry a little blue. Getting this boundary wrong in the port would be
# invisible without pinning both sides of it.
color_temperature(f32_from(1900.0), rgb3);
assert_eq(approx(f32_to(load32(rgb3 + 8)), 0, 0.001), 1, "1900K has no blue (at the 19 cutoff)");
color_temperature(f32_from(2000.0), rgb3);
assert_eq(f64_gt(f32_to(load32(rgb3 + 8)), 0), 1, "2000K is just past the cutoff and has some blue");

color_temperature(f32_from(20000.0), rgb3);
assert_eq(approx(f32_to(load32(rgb3 + 8)), F64_ONE, 0.001), 1, "20000K blue saturates at 1.0");
assert_eq(f64_lt(f32_to(load32(rgb3)), F64_ONE), 1, "20000K red falls below 1.0");

# Clamping: out-of-range input saturates rather than extrapolating.
color_temperature(f32_from(500.0), rgb3);
var lo_r = f32_to(load32(rgb3));
color_temperature(f32_from(1000.0), rgb3);
assert_eq(approx(lo_r, f32_to(load32(rgb3)), 0.0001), 1, "below 1000K clamps to the 1000K value");

# NaN gives neutral white. 1.0.0 fixed this — a NaN kelvin previously survived
# the clamp and propagated into every channel.
color_temperature(f32_from(_RG_NAN), rgb3);
assert_eq(approx(f32_to(load32(rgb3)), F64_ONE, 0.0001), 1, "NaN kelvin gives neutral r");
assert_eq(approx(f32_to(load32(rgb3 + 4)), F64_ONE, 0.0001), 1, "NaN kelvin gives neutral g");
assert_eq(approx(f32_to(load32(rgb3 + 8)), F64_ONE, 0.0001), 1, "NaN kelvin gives neutral b");

# ================================================================
# Delta-E CIE94 and CIEDE2000
# ================================================================
test_group("delta-e cie94");

var c94a = cie_lab_new(50.0, 25.0, 0);
var c94b = cie_lab_new(50.0, 0, 0);
assert_eq(f64_gt(delta_e_cie94(c94a, c94b), 0), 1, "cie94 of distinct colours is positive (doctest)");
assert_eq(approx(delta_e_cie94(c94a, c94a), 0, 0.00001), 1, "cie94 of a colour with itself is 0");

# CIE94 down-weights chroma differences, so for the same pair it reads lower
# than the plain Euclidean CIE76. That relationship is the point of the formula.
assert_eq(f64_lt(delta_e_cie94(c94a, c94b), delta_e_cie76(c94a, c94b)), 1, "cie94 < cie76 for a chromatic difference");

test_group("delta-e ciede2000");

# The Sharma et al. reference pair. The doctest pins 2.0 < dE < 3.0; the
# published value for this pair is 2.0425. Getting this right exercises the
# G factor, the hue-difference wrap, the T weighting, and the RT rotation
# term all at once — it is the strongest single assertion in this file.
var sharma1 = cie_lab_new(50.0, 2.6772, f64_neg(79.7751));
var sharma2 = cie_lab_new(50.0, 0, f64_neg(82.7485));
var de2000 = delta_e_ciede2000(sharma1, sharma2);
assert_eq(f64_gt(de2000, 2.0), 1, "CIEDE2000 Sharma pair > 2.0 (doctest)");
assert_eq(f64_lt(de2000, 3.0), 1, "CIEDE2000 Sharma pair < 3.0 (doctest)");
assert_eq(approx(de2000, 2.0425, 0.01), 1, "CIEDE2000 Sharma pair == 2.0425 (published reference)");

assert_eq(approx(delta_e_ciede2000(sharma1, sharma1), 0, 0.00001), 1, "CIEDE2000 of a colour with itself is 0");

# Neutral greys drive c_bar to 0, which is the input that breaks a pow-based
# x^7 — hence _rg_pow7 by repeated multiplication.
var grey1 = cie_lab_new(50.0, 0, 0);
var grey2 = cie_lab_new(60.0, 0, 0);
var de_grey = delta_e_ciede2000(grey1, grey2);
assert_eq(f64_gt(de_grey, 0), 1, "CIEDE2000 handles zero-chroma pairs without NaN");
assert_eq(f64_lt(de_grey, 20.0), 1, "zero-chroma delta stays bounded");

cie_lab_free(grey1); cie_lab_free(grey2);
cie_lab_free(sharma1); cie_lab_free(sharma2);
cie_lab_free(c94a); cie_lab_free(c94b);
srgba_free(red); srgba_free(green); srgba_free(blue); srgba_free(grey); srgba_free(magenta);

# ================================================================
# ColorSpace display
# ================================================================
test_group("color space");

assert_streq(color_space_name(CS_SRGB), "sRGB", "Display for sRGB");
# ⚠ THE FIRST SEVEN DISCRIMINANTS ARE THE RUST WIRE FORM. An earlier version of
# this port dropped Bt601 and Bt709 and let CieLab and Oklab occupy 3-6, so a
# ColorSpace persisted by ranga 1.0.1 read back as a different space entirely.
# These pin the numbering, not just the names.
assert_eq(CS_SRGB, 0, "Srgb is 0, as in Rust");
assert_eq(CS_LINEAR_RGB, 1, "LinearRgb is 1");
assert_eq(CS_DISPLAY_P3, 2, "DisplayP3 is 2");
assert_eq(CS_BT601, 3, "Bt601 is 3 — it was missing entirely");
assert_eq(CS_BT709, 4, "Bt709 is 4 — likewise");
assert_eq(CS_BT2020, 5, "Bt2020 is 5, NOT 3");
assert_eq(CS_CIE_XYZ, 6, "CieXyz is 6, NOT 4");
# ranga's two additions sit past Rust's range so they cannot displace anything.
assert_eq(CS_CIE_LAB > CS_CIE_XYZ, 1, "CieLab is numbered above Rust's last variant");
assert_eq(CS_OKLAB > CS_CIE_XYZ, 1, "and so is Oklab");
assert_streq(color_space_name(CS_BT601), "BT.601", "Display for BT.601");
assert_streq(color_space_name(CS_BT709), "BT.709", "Display for BT.709");
assert_streq(color_space_name(CS_CIE_LAB), "CIE L*a*b*", "Display for CIE Lab");
assert_streq(color_space_name(CS_OKLAB), "Oklab", "Display for Oklab");

# ================================================================
# Round trips away from white (rust-old/src/color.rs tests). The groups above
# check white, black and the primaries, where several terms vanish.
# ================================================================
test_group("non-white round trips");

# xyz_roundtrip: LinRgba(0.5, 0.3, 0.8) -> XYZ -> LinRgba within 1e-3.
var xo = lin_rgba_new(f32_from(0.5), f32_from(0.3), f32_from(0.8), f32_from(F64_ONE));
var xx = lin_rgba_to_cie_xyz(xo);
var xb = cie_xyz_to_lin_rgba(xx);
assert_eq(approx(f32_to(lin_rgba_r(xb)), 0.5, 0.001), 1, "xyz_roundtrip r");
assert_eq(approx(f32_to(lin_rgba_g(xb)), 0.3, 0.001), 1, "xyz_roundtrip g");
assert_eq(approx(f32_to(lin_rgba_b(xb)), 0.8, 0.001), 1, "xyz_roundtrip b");
lin_rgba_free(xb); cie_xyz_free(xx); lin_rgba_free(xo);

# cmyk_roundtrip: (200, 100, 50) has k != 0 (k = 1 - 200/255), so every term of
# the inverse is exercised.
var co = srgba_new(200, 100, 50, 255);
var cc = srgba_to_cmyk(co);
assert_eq(f64_gt(f32_to(cmyk_k(cc)), 0.2), 1, "cmyk_roundtrip: k is not 0");
var cb = cmyk_to_srgba(cc);
assert_eq(absd8(srgba_r(cb), 200) <= 1 && absd8(srgba_g(cb), 100) <= 1 && absd8(srgba_b(cb), 50) <= 1, 1,
  "cmyk_roundtrip within 1");
srgba_free(cb); cmyk_free(cc); srgba_free(co);

# hsl_roundtrip over Rust's four colours; (128, 64, 200) has l > 0.5, the other
# branch of the saturation formula.
fn hsl_rt_ok(r, g, b) {
    var o = srgba_new(r, g, b, 255);
    var h = srgba_to_hsl(o);
    var back = hsl_to_srgba(h);
    var ok = absd8(srgba_r(back), r) <= 1 && absd8(srgba_g(back), g) <= 1 && absd8(srgba_b(back), b) <= 1;
    srgba_free(back); hsl_free(h); srgba_free(o);
    return ok;
}
var hp = srgba_new(128, 64, 200, 255);
var hph = srgba_to_hsl(hp);
assert_eq(f64_gt(f32_to(hsl_l(hph)), 0.5), 1, "(128, 64, 200) has lightness above 0.5");
hsl_free(hph); srgba_free(hp);
assert_eq(hsl_rt_ok(255, 0, 0) && hsl_rt_ok(0, 255, 0) && hsl_rt_ok(0, 0, 255) && hsl_rt_ok(128, 64, 200), 1,
  "hsl_roundtrip within 1 for red, green, blue and (128, 64, 200)");
var hg = srgba_new(128, 128, 128, 255);
var hgh = srgba_to_hsl(hg);
var hgb = hsl_to_srgba(hgh);
assert_eq(srgba_r(hgb) == srgba_g(hgb) && srgba_g(hgb) == srgba_b(hgb), 1, "hsl_gray_roundtrip stays grey");
srgba_free(hgb); hsl_free(hgh); srgba_free(hg);

# p3_srgb_roundtrip on an interior colour, within Rust's 1e-4.
var p3a = fl_alloc(24);
var p3b = fl_alloc(24);
linear_srgb_to_p3(0.25, 0.6, 0.9, p3a);
p3_to_linear_srgb(load64(p3a), load64(p3a + 8), load64(p3a + 16), p3b);
assert_eq(approx(load64(p3b), 0.25, 0.0001) && approx(load64(p3b + 8), 0.6, 0.0001)
  && approx(load64(p3b + 16), 0.9, 0.0001), 1, "p3 round trip of (0.25, 0.6, 0.9) within 1e-4");
fl_free(p3b); fl_free(p3a);

# ================================================================
# Record surface: setters, clone, equality (2.4.0)
# ================================================================
test_group("colour records");

# Rust's colour structs have pub fields and derive Clone, Copy and PartialEq
# (Srgba also Eq and Hash). The expectations below are derived PartialEq's: IEEE
# `==` per field, so a NaN field is unequal even to itself and -0.0 == +0.0. A
# byte compare would get both wrong, which is what the last checks per type pin.
var NAN32 = 0x7FC00000;
var NZ32  = 0x80000000;
var NAN64 = 0x7FF8000000000000;
var NZ64  = 0x8000000000000000;

# --- Srgba: u8 fields, Eq + Hash ---
var sa = srgba_new(10, 20, 30, 40);
srgba_set_r(sa, 11);
srgba_set_g(sa, 21);
srgba_set_b(sa, 31);
srgba_set_a(sa, 41);
assert_eq(srgba_r(sa), 11, "srgba_set_r writes r");
assert_eq(srgba_g(sa), 21, "srgba_set_g writes g");
assert_eq(srgba_b(sa), 31, "srgba_set_b writes b");
assert_eq(srgba_a(sa), 41, "srgba_set_a writes a");
srgba_set_r(sa, 256 + 7);
assert_eq(srgba_r(sa), 7, "a setter masks to a byte, as srgba_new does");
srgba_set_r(sa, 11);
var sb = srgba_clone(sa);
assert_eq(sb != sa, 1, "srgba_clone returns a new record");
assert_eq(srgba_eq(sa, sb), 1, "which equals its source");
assert_eq(srgba_hash(sa), srgba_hash(sb), "and hashes equally (Hash's one contract)");
srgba_set_a(sb, 42);
assert_eq(srgba_eq(sa, sb), 0, "changing a makes them unequal");
assert_eq(srgba_hash(sa) == srgba_hash(sb), 0, "and the hash tells them apart");
assert_eq(srgba_a(sa), 41, "and the source is untouched by the clone's setter");
srgba_set_a(sb, 41);
srgba_set_r(sb, 12);
assert_eq(srgba_eq(sa, sb), 0, "r takes part in equality");
srgba_set_r(sb, 11);
srgba_set_g(sb, 22);
assert_eq(srgba_eq(sa, sb), 0, "g takes part in equality");
srgba_set_g(sb, 21);
srgba_set_b(sb, 32);
assert_eq(srgba_eq(sa, sb), 0, "b takes part in equality");
srgba_set_b(sb, 31);
assert_eq(srgba_eq(sa, sb), 1, "and restoring every field makes them equal again");
# The hash is the four bytes, r lowest: injective, so distinct colours never share
# a key.
assert_eq(srgba_hash(sa), 11 | (21 << 8) | (31 << 16) | (41 << 24), "srgba_hash packs r|g<<8|b<<16|a<<24");
assert_eq(srgba_eq(sa, 0), 0, "a null record equals nothing");
assert_eq(srgba_clone(0), 0, "and cloning null gives null");
srgba_free(sb);
srgba_free(sa);

# --- lin_rgba: 4 x f32 ---
var ra_lin_rgba = lin_rgba_new(f32_from(0.125), f32_from(0.25), f32_from(0.375), f32_from(0.5));
lin_rgba_set_r(ra_lin_rgba, f32_from(0.625));
lin_rgba_set_g(ra_lin_rgba, f32_from(0.75));
lin_rgba_set_b(ra_lin_rgba, f32_from(0.875));
lin_rgba_set_a(ra_lin_rgba, f32_from(0.9375));
assert_eq(lin_rgba_r(ra_lin_rgba), f32_from(0.625), "lin_rgba_set_r writes r");
assert_eq(lin_rgba_g(ra_lin_rgba), f32_from(0.75), "lin_rgba_set_g writes g");
assert_eq(lin_rgba_b(ra_lin_rgba), f32_from(0.875), "lin_rgba_set_b writes b");
assert_eq(lin_rgba_a(ra_lin_rgba), f32_from(0.9375), "lin_rgba_set_a writes a");
var rb_lin_rgba = lin_rgba_clone(ra_lin_rgba);
assert_eq(rb_lin_rgba != ra_lin_rgba, 1, "lin_rgba_clone returns a new record");
assert_eq(lin_rgba_eq(ra_lin_rgba, rb_lin_rgba), 1, "which equals its source");
lin_rgba_set_r(rb_lin_rgba, f32_from(0.0625));
assert_eq(lin_rgba_eq(ra_lin_rgba, rb_lin_rgba), 0, "r takes part in lin_rgba_eq");
assert_eq(lin_rgba_r(ra_lin_rgba), f32_from(0.625), "and the source keeps its r");
lin_rgba_set_r(rb_lin_rgba, f32_from(0.625));
lin_rgba_set_g(rb_lin_rgba, f32_from(0.0625));
assert_eq(lin_rgba_eq(ra_lin_rgba, rb_lin_rgba), 0, "g takes part in lin_rgba_eq");
assert_eq(lin_rgba_g(ra_lin_rgba), f32_from(0.75), "and the source keeps its g");
lin_rgba_set_g(rb_lin_rgba, f32_from(0.75));
lin_rgba_set_b(rb_lin_rgba, f32_from(0.0625));
assert_eq(lin_rgba_eq(ra_lin_rgba, rb_lin_rgba), 0, "b takes part in lin_rgba_eq");
assert_eq(lin_rgba_b(ra_lin_rgba), f32_from(0.875), "and the source keeps its b");
lin_rgba_set_b(rb_lin_rgba, f32_from(0.875));
lin_rgba_set_a(rb_lin_rgba, f32_from(0.0625));
assert_eq(lin_rgba_eq(ra_lin_rgba, rb_lin_rgba), 0, "a takes part in lin_rgba_eq");
assert_eq(lin_rgba_a(ra_lin_rgba), f32_from(0.9375), "and the source keeps its a");
lin_rgba_set_a(rb_lin_rgba, f32_from(0.9375));
assert_eq(lin_rgba_eq(ra_lin_rgba, rb_lin_rgba), 1, "restoring every field makes them equal again");
lin_rgba_set_r(ra_lin_rgba, 0);
lin_rgba_set_r(rb_lin_rgba, NZ32);
assert_eq(lin_rgba_eq(ra_lin_rgba, rb_lin_rgba), 1, "-0.0 equals +0.0, as IEEE == says");
lin_rgba_set_r(ra_lin_rgba, NAN32);
assert_eq(lin_rgba_eq(ra_lin_rgba, ra_lin_rgba), 0, "a NaN field makes a record unequal to itself");
assert_eq(lin_rgba_eq(ra_lin_rgba, 0), 0, "a null record equals nothing");
assert_eq(lin_rgba_clone(0), 0, "and cloning null gives null");
lin_rgba_free(rb_lin_rgba);
lin_rgba_free(ra_lin_rgba);

# --- hsl: 3 x f32 ---
var ra_hsl = hsl_new(f32_from(0.125), f32_from(0.25), f32_from(0.375));
hsl_set_h(ra_hsl, f32_from(0.625));
hsl_set_s(ra_hsl, f32_from(0.75));
hsl_set_l(ra_hsl, f32_from(0.875));
assert_eq(hsl_h(ra_hsl), f32_from(0.625), "hsl_set_h writes h");
assert_eq(hsl_s(ra_hsl), f32_from(0.75), "hsl_set_s writes s");
assert_eq(hsl_l(ra_hsl), f32_from(0.875), "hsl_set_l writes l");
var rb_hsl = hsl_clone(ra_hsl);
assert_eq(rb_hsl != ra_hsl, 1, "hsl_clone returns a new record");
assert_eq(hsl_eq(ra_hsl, rb_hsl), 1, "which equals its source");
hsl_set_h(rb_hsl, f32_from(0.0625));
assert_eq(hsl_eq(ra_hsl, rb_hsl), 0, "h takes part in hsl_eq");
assert_eq(hsl_h(ra_hsl), f32_from(0.625), "and the source keeps its h");
hsl_set_h(rb_hsl, f32_from(0.625));
hsl_set_s(rb_hsl, f32_from(0.0625));
assert_eq(hsl_eq(ra_hsl, rb_hsl), 0, "s takes part in hsl_eq");
assert_eq(hsl_s(ra_hsl), f32_from(0.75), "and the source keeps its s");
hsl_set_s(rb_hsl, f32_from(0.75));
hsl_set_l(rb_hsl, f32_from(0.0625));
assert_eq(hsl_eq(ra_hsl, rb_hsl), 0, "l takes part in hsl_eq");
assert_eq(hsl_l(ra_hsl), f32_from(0.875), "and the source keeps its l");
hsl_set_l(rb_hsl, f32_from(0.875));
assert_eq(hsl_eq(ra_hsl, rb_hsl), 1, "restoring every field makes them equal again");
hsl_set_h(ra_hsl, 0);
hsl_set_h(rb_hsl, NZ32);
assert_eq(hsl_eq(ra_hsl, rb_hsl), 1, "-0.0 equals +0.0, as IEEE == says");
hsl_set_h(ra_hsl, NAN32);
assert_eq(hsl_eq(ra_hsl, ra_hsl), 0, "a NaN field makes a record unequal to itself");
assert_eq(hsl_eq(ra_hsl, 0), 0, "a null record equals nothing");
assert_eq(hsl_clone(0), 0, "and cloning null gives null");
hsl_free(rb_hsl);
hsl_free(ra_hsl);

# --- cmyk: 4 x f32 ---
var ra_cmyk = cmyk_new(f32_from(0.125), f32_from(0.25), f32_from(0.375), f32_from(0.5));
cmyk_set_c(ra_cmyk, f32_from(0.625));
cmyk_set_m(ra_cmyk, f32_from(0.75));
cmyk_set_y(ra_cmyk, f32_from(0.875));
cmyk_set_k(ra_cmyk, f32_from(0.9375));
assert_eq(cmyk_c(ra_cmyk), f32_from(0.625), "cmyk_set_c writes c");
assert_eq(cmyk_m(ra_cmyk), f32_from(0.75), "cmyk_set_m writes m");
assert_eq(cmyk_y(ra_cmyk), f32_from(0.875), "cmyk_set_y writes y");
assert_eq(cmyk_k(ra_cmyk), f32_from(0.9375), "cmyk_set_k writes k");
var rb_cmyk = cmyk_clone(ra_cmyk);
assert_eq(rb_cmyk != ra_cmyk, 1, "cmyk_clone returns a new record");
assert_eq(cmyk_eq(ra_cmyk, rb_cmyk), 1, "which equals its source");
cmyk_set_c(rb_cmyk, f32_from(0.0625));
assert_eq(cmyk_eq(ra_cmyk, rb_cmyk), 0, "c takes part in cmyk_eq");
assert_eq(cmyk_c(ra_cmyk), f32_from(0.625), "and the source keeps its c");
cmyk_set_c(rb_cmyk, f32_from(0.625));
cmyk_set_m(rb_cmyk, f32_from(0.0625));
assert_eq(cmyk_eq(ra_cmyk, rb_cmyk), 0, "m takes part in cmyk_eq");
assert_eq(cmyk_m(ra_cmyk), f32_from(0.75), "and the source keeps its m");
cmyk_set_m(rb_cmyk, f32_from(0.75));
cmyk_set_y(rb_cmyk, f32_from(0.0625));
assert_eq(cmyk_eq(ra_cmyk, rb_cmyk), 0, "y takes part in cmyk_eq");
assert_eq(cmyk_y(ra_cmyk), f32_from(0.875), "and the source keeps its y");
cmyk_set_y(rb_cmyk, f32_from(0.875));
cmyk_set_k(rb_cmyk, f32_from(0.0625));
assert_eq(cmyk_eq(ra_cmyk, rb_cmyk), 0, "k takes part in cmyk_eq");
assert_eq(cmyk_k(ra_cmyk), f32_from(0.9375), "and the source keeps its k");
cmyk_set_k(rb_cmyk, f32_from(0.9375));
assert_eq(cmyk_eq(ra_cmyk, rb_cmyk), 1, "restoring every field makes them equal again");
cmyk_set_c(ra_cmyk, 0);
cmyk_set_c(rb_cmyk, NZ32);
assert_eq(cmyk_eq(ra_cmyk, rb_cmyk), 1, "-0.0 equals +0.0, as IEEE == says");
cmyk_set_c(ra_cmyk, NAN32);
assert_eq(cmyk_eq(ra_cmyk, ra_cmyk), 0, "a NaN field makes a record unequal to itself");
assert_eq(cmyk_eq(ra_cmyk, 0), 0, "a null record equals nothing");
assert_eq(cmyk_clone(0), 0, "and cloning null gives null");
cmyk_free(rb_cmyk);
cmyk_free(ra_cmyk);

# --- oklab: 3 x f32 ---
var ra_oklab = oklab_new(f32_from(0.125), f32_from(0.25), f32_from(0.375));
oklab_set_l(ra_oklab, f32_from(0.625));
oklab_set_a(ra_oklab, f32_from(0.75));
oklab_set_b(ra_oklab, f32_from(0.875));
assert_eq(oklab_l(ra_oklab), f32_from(0.625), "oklab_set_l writes l");
assert_eq(oklab_a(ra_oklab), f32_from(0.75), "oklab_set_a writes a");
assert_eq(oklab_b(ra_oklab), f32_from(0.875), "oklab_set_b writes b");
var rb_oklab = oklab_clone(ra_oklab);
assert_eq(rb_oklab != ra_oklab, 1, "oklab_clone returns a new record");
assert_eq(oklab_eq(ra_oklab, rb_oklab), 1, "which equals its source");
oklab_set_l(rb_oklab, f32_from(0.0625));
assert_eq(oklab_eq(ra_oklab, rb_oklab), 0, "l takes part in oklab_eq");
assert_eq(oklab_l(ra_oklab), f32_from(0.625), "and the source keeps its l");
oklab_set_l(rb_oklab, f32_from(0.625));
oklab_set_a(rb_oklab, f32_from(0.0625));
assert_eq(oklab_eq(ra_oklab, rb_oklab), 0, "a takes part in oklab_eq");
assert_eq(oklab_a(ra_oklab), f32_from(0.75), "and the source keeps its a");
oklab_set_a(rb_oklab, f32_from(0.75));
oklab_set_b(rb_oklab, f32_from(0.0625));
assert_eq(oklab_eq(ra_oklab, rb_oklab), 0, "b takes part in oklab_eq");
assert_eq(oklab_b(ra_oklab), f32_from(0.875), "and the source keeps its b");
oklab_set_b(rb_oklab, f32_from(0.875));
assert_eq(oklab_eq(ra_oklab, rb_oklab), 1, "restoring every field makes them equal again");
oklab_set_l(ra_oklab, 0);
oklab_set_l(rb_oklab, NZ32);
assert_eq(oklab_eq(ra_oklab, rb_oklab), 1, "-0.0 equals +0.0, as IEEE == says");
oklab_set_l(ra_oklab, NAN32);
assert_eq(oklab_eq(ra_oklab, ra_oklab), 0, "a NaN field makes a record unequal to itself");
assert_eq(oklab_eq(ra_oklab, 0), 0, "a null record equals nothing");
assert_eq(oklab_clone(0), 0, "and cloning null gives null");
oklab_free(rb_oklab);
oklab_free(ra_oklab);

# --- oklch: 3 x f32 ---
var ra_oklch = oklch_new(f32_from(0.125), f32_from(0.25), f32_from(0.375));
oklch_set_l(ra_oklch, f32_from(0.625));
oklch_set_c(ra_oklch, f32_from(0.75));
oklch_set_h(ra_oklch, f32_from(0.875));
assert_eq(oklch_l(ra_oklch), f32_from(0.625), "oklch_set_l writes l");
assert_eq(oklch_c(ra_oklch), f32_from(0.75), "oklch_set_c writes c");
assert_eq(oklch_h(ra_oklch), f32_from(0.875), "oklch_set_h writes h");
var rb_oklch = oklch_clone(ra_oklch);
assert_eq(rb_oklch != ra_oklch, 1, "oklch_clone returns a new record");
assert_eq(oklch_eq(ra_oklch, rb_oklch), 1, "which equals its source");
oklch_set_l(rb_oklch, f32_from(0.0625));
assert_eq(oklch_eq(ra_oklch, rb_oklch), 0, "l takes part in oklch_eq");
assert_eq(oklch_l(ra_oklch), f32_from(0.625), "and the source keeps its l");
oklch_set_l(rb_oklch, f32_from(0.625));
oklch_set_c(rb_oklch, f32_from(0.0625));
assert_eq(oklch_eq(ra_oklch, rb_oklch), 0, "c takes part in oklch_eq");
assert_eq(oklch_c(ra_oklch), f32_from(0.75), "and the source keeps its c");
oklch_set_c(rb_oklch, f32_from(0.75));
oklch_set_h(rb_oklch, f32_from(0.0625));
assert_eq(oklch_eq(ra_oklch, rb_oklch), 0, "h takes part in oklch_eq");
assert_eq(oklch_h(ra_oklch), f32_from(0.875), "and the source keeps its h");
oklch_set_h(rb_oklch, f32_from(0.875));
assert_eq(oklch_eq(ra_oklch, rb_oklch), 1, "restoring every field makes them equal again");
oklch_set_l(ra_oklch, 0);
oklch_set_l(rb_oklch, NZ32);
assert_eq(oklch_eq(ra_oklch, rb_oklch), 1, "-0.0 equals +0.0, as IEEE == says");
oklch_set_l(ra_oklch, NAN32);
assert_eq(oklch_eq(ra_oklch, ra_oklch), 0, "a NaN field makes a record unequal to itself");
assert_eq(oklch_eq(ra_oklch, 0), 0, "a null record equals nothing");
assert_eq(oklch_clone(0), 0, "and cloning null gives null");
oklch_free(rb_oklch);
oklch_free(ra_oklch);

