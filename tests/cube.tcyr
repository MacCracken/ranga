f32_case("3.4028236e38", 0x7F800000, "just past FLT_MAX: inf");
f32_case("1e39", 0x7F800000, "overflow: inf");
f32_case("inf", 0x7F800000, "inf");
f32_case("-Infinity", 0xFF800000, "-Infinity");
f32_case("NaN", 0x7FC00000, "NaN");
f32_case("-nan", 0xFFC00000, "a signed NaN keeps its sign");
