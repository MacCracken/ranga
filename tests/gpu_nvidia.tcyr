# gpu_nvidia.tcyr — the native NVIDIA backend: context, buffers and the guard
#
# ⚠ GATED ON AN NVIDIA CONTEXT, NOT AN AMD ONE. The other GPU suites open
# `gpu_context_new_amd`; this one opens `gpu_context_new_nvidia` and runs only
# when that succeeds (mabda 4.2.0: nouveau DRM, SM75). Without an NVIDIA card it
# prints SKIPPED and passes, which is what it does on the AMD dev host and in CI.
#
# It runs on `chew` (GeForce GTX 1660 SUPER, TU116, nouveau + NVK) from a static
# binary built here, because chew has no toolchain:
#   cyrius build tests/gpu_nvidia.tcyr build/gpu_nvidia
#   scp build/gpu_nvidia chew: && ssh chew ./gpu_nvidia
#
# WHAT IT PINS. mabda 4.2.0's NVIDIA backend opens a context and moves buffers,
# but it cannot run ranga's kernels: it takes precompiled SASS, its SPIR-V→SASS
# compiler (mabda N9) is unshipped, and handed SPIR-V it uploads the words as
# machine code and nouveau kills the channel. So:
#   * the context and buffer round trip must WORK;
#   * every compute operation must return RG_GPU_ERR_UNSUPPORTED and leave its
#     buffers alone (ADR 005);
#   * and no shader module may have been created, which is the part that keeps
#     the card alive. The per-context shader cache is the observable for that.
#
# When mabda ships N9 and ranga lifts the guard, this suite is what fails first,
# by design: flip the UNSUPPORTED rows to the AMD suites' expected values.

include "src/error.cyr"
include "src/bytevec.cyr"
include "src/pixel.cyr"
include "src/transform.cyr"
include "src/gpu_spirv.cyr"
include "src/gpu_kernels.cyr"
include "src/gpu_context.cyr"
include "src/gpu_buffer.cyr"
include "src/gpu_pipeline.cyr"
include "tests/gpu_hw.cyr"

alloc_init();

var err = fl_alloc(8);
var perr = fl_alloc(8);

# The same four pixels as gpu_pipeline.tcyr: every channel differs, and two
# carry non-opaque alpha.
fn seed4(b) {
    var r = pixel_buffer_data(b);
    store32(r + 0,  0xFF204060);
    store32(r + 4,  0xFF808080);
    store32(r + 8,  0x40FFFFFF);
    store32(r + 12, 0xFF000000);
    return 0;
}

# 1 if `b` still holds seed4's pixels, else 0.
fn is_seed4(b) {
    var r = pixel_buffer_data(b);
    if (load32(r + 0)  != 0xFF204060) { return 0; }
    if (load32(r + 4)  != 0xFF808080) { return 0; }
    if (load32(r + 8)  != 0x40FFFFFF) { return 0; }
    if (load32(r + 12) != 0xFF000000) { return 0; }
    return 1;
}

# An in-place operation on NVIDIA: the RG_ERR_* return, the GPU code through
# err_out, and the buffer left exactly as seeded. Three assertions.
fn refused(rc, b, name) {
    assert_eq(rc, RG_ERR_UNSUPPORTED_CONVERSION, name);
    assert_eq(load64(err), RG_GPU_ERR_UNSUPPORTED, "  with RG_GPU_ERR_UNSUPPORTED through err_out");
    assert_eq(is_seed4(b), 1, "  and the buffer is untouched");
    return 0;
}

# A producing operation on NVIDIA: no buffer, and UNSUPPORTED. Two assertions.
fn refused_new(out, name) {
    assert_eq(out, 0, name);
    assert_eq(load64(err), RG_GPU_ERR_UNSUPPORTED, "  with RG_GPU_ERR_UNSUPPORTED through err_out");
    if (out != 0) { pixel_buffer_free(out); }
    return 0;
}

# ================================================================
test_group("nvidia context");

# HW_N: the assertions below that need an NVIDIA context (tests/gpu_hw.cyr).
var HW_N = 53;
var ctx = gpu_context_new_nvidia(err);
if (ctx == 0) {
    assert_eq(load64(err) < 0, 1, "with no NVIDIA GPU, context creation reports an error");
    gpu_hw_skipped_nvidia(HW_N);
}

if (ctx != 0) {
    var hw_from = _assert_total;

    assert_eq(streq(gpu_context_backend_name(ctx), "native-nvidia"), 1,
      "the native NVIDIA backend reports itself as native-nvidia");
    assert_eq(gpu_context_mabda(ctx) != 0, 1, "the unwrapped mabda context is non-null");
    # ADR 005. Everything below follows from this one value.
    assert_eq(gpu_context_supports_compute(ctx), 0,
      "the NVIDIA backend does not support ranga's compute (no SPIR-V→SASS in mabda 4.2.0)");

    # ================================================================
    test_group("nvidia buffers");

    # The half of the backend that works. Upload, download, compare every byte
    # and the metadata the download rebuilds the PixelBuffer from.
    var buf = pixel_buffer_zeroed(4, 1, PF_RGBA8, perr);
    assert_eq(load64(perr), RG_ERR_NONE, "the working buffer allocates");
    seed4(buf);
    var gb = gpu_buffer_upload(ctx, buf, err);
    assert_eq(gb != 0, 1, "a buffer uploads to the card");
    assert_eq(load64(err), RG_GPU_ERR_NONE, "with no error");
    if (gb != 0) {
        assert_eq(gpu_buffer_size(gb), 16, "of 16 bytes");
        var back = gpu_buffer_download(gb, ctx, err);
        assert_eq(back != 0, 1, "and downloads again");
        assert_eq(load64(err), RG_GPU_ERR_NONE, "with no error");
        if (back != 0) {
            assert_eq(is_seed4(back), 1, "byte for byte");
            assert_eq(pixel_buffer_width(back), 4, "at the same width");
            assert_eq(pixel_buffer_height(back), 1, "and height");
            assert_eq(pixel_buffer_format(back), PF_RGBA8, "and format");
            pixel_buffer_free(back);
        }
        if (back == 0) {
            # Keep the count whole if the download failed, so HW_N still holds.
            assert_eq(0, 1, "byte for byte");
            assert_eq(0, 1, "at the same width");
            assert_eq(0, 1, "and height");
            assert_eq(0, 1, "and format");
        }
        gpu_buffer_free(ctx, gb);
    }
    if (gb == 0) {
        assert_eq(0, 1, "of 16 bytes");
        assert_eq(0, 1, "and downloads again");
        assert_eq(0, 1, "with no error");
        assert_eq(0, 1, "byte for byte");
        assert_eq(0, 1, "at the same width");
        assert_eq(0, 1, "and height");
        assert_eq(0, 1, "and format");
    }

    # ================================================================
    test_group("nvidia compute guard");

    # The eleven operations that have a kernel. On AMD each of these runs; here
    # each must be refused before any SPIR-V reaches mabda.
    seed4(buf);
    refused(gpu_invert(ctx, buf, err), buf, "gpu_invert is refused");
    seed4(buf);
    refused(gpu_grayscale(ctx, buf, err), buf, "gpu_grayscale is refused");
    seed4(buf);
    refused(gpu_fade(ctx, buf, 0.5, err), buf, "gpu_fade is refused");
    seed4(buf);
    refused(gpu_brightness_contrast(ctx, buf, 0.1, 1.5, err), buf,
      "gpu_brightness_contrast is refused");
    seed4(buf);
    refused(gpu_saturation(ctx, buf, 2.0, err), buf, "gpu_saturation is refused");

    # Two-buffer: `dst` is the buffer that would have been written.
    var src = pixel_buffer_zeroed(4, 1, PF_RGBA8, perr);
    var sd = pixel_buffer_data(src);
    var si = 0;
    while (si < 4) { store32(sd + si * 4, 0xFF404040); si = si + 1; }
    seed4(buf);
    refused(gpu_dissolve(ctx, src, buf, 0.5, err), buf, "gpu_dissolve is refused");
    seed4(buf);
    refused(gpu_wipe(ctx, src, buf, 0.5, err), buf, "gpu_wipe is refused");
    pixel_buffer_free(src);

    # Producing: no output buffer comes back.
    seed4(buf);
    refused_new(gpu_flip_horizontal(ctx, buf, err), "gpu_flip_horizontal is refused");
    refused_new(gpu_flip_vertical(ctx, buf, err), "gpu_flip_vertical is refused");
    refused_new(gpu_crop(ctx, buf, 1, 0, 3, 1, err), "gpu_crop is refused");
    refused_new(gpu_resize(ctx, buf, 8, 2, SF_NEAREST, err), "gpu_resize (nearest) is refused");
    assert_eq(is_seed4(buf), 1, "and none of the four touched the source");

    # ⚠ A DEGENERATE CROP IS NOT REFUSED. It needs no GPU work (Rust returned an
    # empty buffer without dispatching, and so does ranga), so it never reaches
    # the guard and succeeds on every backend. Pinned so nobody "fixes" it into
    # an UNSUPPORTED that AMD would not give.
    var cempty = gpu_crop(ctx, buf, 2, 0, 1, 1, err);
    assert_eq(cempty != 0, 1, "a degenerate crop still returns a buffer");
    assert_eq(load64(err), RG_GPU_ERR_NONE, "and succeeds, because nothing is dispatched");
    if (cempty != 0) { pixel_buffer_free(cempty); }

    # The stubs were already UNSUPPORTED on every backend; the guard changes
    # nothing for them.
    # Mode 0 is BM_NORMAL; blend.cyr is not included, since the stub reads no mode.
    assert_eq(gpu_blend(ctx, buf, buf, 0, F64_ONE, err), RG_ERR_OTHER,
      "gpu_blend is a stub here as everywhere");
    assert_eq(load64(err), RG_GPU_ERR_UNSUPPORTED, "  reporting UNSUPPORTED");
    assert_eq(gpu_gaussian_blur(ctx, buf, 2, err), 0, "gpu_gaussian_blur likewise");
    assert_eq(load64(err), RG_GPU_ERR_UNSUPPORTED, "  reporting UNSUPPORTED");

    # The format guard still runs first, so a bad buffer gets the same answer
    # on every backend.
    var yuv = pixel_buffer_zeroed(4, 2, PF_YUV420P, perr);
    assert_eq(gpu_invert(ctx, yuv, err), RG_ERR_INVALID_FORMAT,
      "a non-RGBA8 buffer is refused for its format, before the backend guard");
    assert_eq(load64(err), RG_GPU_ERR_FORMAT, "  with RG_GPU_ERR_FORMAT");
    pixel_buffer_free(yuv);

    # ⚠ THE ASSERTION THAT KEEPS THE CARD ALIVE. Every compiled module lands in
    # this per-context cache. Empty after all of the above means no shader
    # module was ever created on this context, so no SPIR-V was uploaded as
    # SASS and nothing reached the dispatch. Up to 2.3.2, gpu_invert alone put
    # one here, and the dispatch that followed killed the channel.
    var cache = gpu_context_shader_cache(ctx);
    assert_eq(cache != 0, 1, "the context owns a shader cache");
    if (cache != 0) {
        assert_eq(vec_len(cache), 0, "and it is EMPTY: no SPIR-V reached the NVIDIA backend");
    }
    if (cache == 0) { assert_eq(0, 1, "and it is EMPTY: no SPIR-V reached the NVIDIA backend"); }

    pixel_buffer_free(buf);
    gpu_context_free(ctx);
    gpu_hw_check(hw_from, HW_N);
}

var exit_code = assert_summary();
if (exit_code > 0) { exit_code = 1; }
sys_exit_group(exit_code);
