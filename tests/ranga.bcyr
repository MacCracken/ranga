# composite.rs
# ================================================================
var CP_BUF = 0;
var CP_DST = 0;
var CP_SRC = 0;
var CP_A = 0;
var CP_B = 0;
var CP_MASK = 0;
var CP_ADST = 0;
var CP_ASRC = 0;
var C_RED = 0;
var C_BLUE = 0;
var C_LIGHT = 0;
var C_WHITE = 0;

fn w_premultiply() { premultiply_alpha(CP_BUF); return 0; }
fn w_composite_at() { composite_at(CP_SRC, CP_DST, 100, 100, f32_from(0.8)); return 0; }
fn w_dissolve() { pixel_buffer_free(dissolve(CP_A, CP_B, f32_from(0.5), err)); return 0; }
fn w_fade() { fade(CP_BUF, f32_from(0.5)); return 0; }
fn w_wipe() { pixel_buffer_free(wipe(CP_A, CP_B, f32_from(0.5), err)); return 0; }
fn w_gradient() { gradient_linear(CP_BUF, C_RED, C_BLUE); return 0; }
fn w_checkerboard() { fill_checkerboard(CP_BUF, 16, C_LIGHT, C_WHITE); return 0; }
fn w_unpremultiply() { unpremultiply_alpha(CP_BUF); return 0; }
fn w_apply_mask() { apply_mask(CP_BUF, CP_MASK); return 0; }
fn w_gradient_radial() {
    gradient_radial(CP_BUF, f32_from(960.0), f32_from(540.0), f32_from(540.0), C_RED, C_BLUE);
    return 0;
}
fn w_gradient_angled() { gradient_linear_angled(CP_BUF, C_RED, C_BLUE, f32_from(45.0)); return 0; }
fn w_fill_solid() { fill_solid(CP_BUF, C_RED); return 0; }
fn w_composite_at_argb() { composite_at_argb(CP_ASRC, CP_ADST, 100, 100, f32_from(0.8)); return 0; }

fn benches_composite() {
    C_RED = rgba(255, 0, 0, 255);
    C_BLUE = rgba(0, 0, 255, 255);
    C_LIGHT = rgba(200, 200, 200, 255);
    C_WHITE = rgba(255, 255, 255, 255);

    CP_BUF = mk_uniform(W, H, PF_RGBA8, 128);
    frame("premultiply_alpha_1080p", 50, &w_premultiply);
    CP_DST = mk_uniform(W, H, PF_RGBA8, 128);
    CP_SRC = mk_uniform(640, 480, PF_RGBA8, 200);
    frame("composite_at_640x480_on_1080p", 50, &w_composite_at);
    CP_A = mk_uniform(W, H, PF_RGBA8, 128);
    CP_B = mk_uniform(W, H, PF_RGBA8, 64);
    frame("dissolve_1080p", 10, &w_dissolve);
    bv_fill(pixel_buffer_bv(CP_BUF), 128);
    frame("fade_1080p", 20, &w_fade);
    frame("wipe_1080p", 50, &w_wipe);
    frame("gradient_linear_1080p", 10, &w_gradient);
    frame("checkerboard_1080p", 20, &w_checkerboard);
    bv_fill(pixel_buffer_bv(CP_BUF), 128);
    frame("unpremultiply_alpha_1080p", 20, &w_unpremultiply);
    bv_fill(pixel_buffer_bv(CP_BUF), 128);
    CP_MASK = mk_uniform(W, H, PF_RGBA8, 128);
    frame("apply_mask_1080p", 50, &w_apply_mask);
    frame("gradient_radial_1080p", 10, &w_gradient_radial);
    frame("gradient_linear_angled_1080p", 10, &w_gradient_angled);
    frame("fill_solid_1080p", 200, &w_fill_solid);
    CP_ADST = mk_uniform(W, H, PF_ARGB8, 128);
    CP_ASRC = mk_uniform(640, 480, PF_ARGB8, 200);
    frame("composite_at_argb_640x480_on_1080p", 50, &w_composite_at_argb);
    return 0;
}

# ================================================================
# filter.rs
# ================================================================
var FB = 0;       # make_buf, mutated in place
var FV = 0;       # make_varied_buf, mutated in place
var FV_RO = 0;    # make_varied_buf, read only
var F512 = 0;
var F256 = 0;
var F_LUT = 0;
var F_SH = 0;
var F_MID = 0;
var F_HI = 0;
var F_MIX = 0;
var F_L3D = 0;
var F_FILL = 0;

fn w_brightness() { brightness(FB, f32_from(0.1)); return 0; }
fn w_contrast() { contrast(FB, f32_from(1.2)); return 0; }
fn w_saturation() { saturation(FB, f32_from(1.5)); return 0; }
fn w_grayscale() { grayscale(FB); return 0; }
fn w_invert() { invert(FB); return 0; }
fn w_levels() { levels(FB, f32_from(0.1), f32_from(0.9), f32_from(1.2)); return 0; }
fn w_curves() { curves(FB, F_LUT); return 0; }
fn w_gaussian() { pixel_buffer_free(gaussian_blur(FV_RO, 3, err)); return 0; }
fn w_box() { pixel_buffer_free(box_blur(FV_RO, 3, err)); return 0; }
fn w_unsharp() { pixel_buffer_free(unsharp_mask(FV_RO, 2, f32_from(1.0), err)); return 0; }
fn w_hue_shift() { hue_shift(FV, f32_from(30.0)); return 0; }
fn w_color_balance() { color_balance(FV, F_SH, F_MID, F_HI); return 0; }
fn w_vignette() { vignette(FB, f32_from(0.5)); return 0; }
fn w_lut3d() { apply_lut3d(FV, F_L3D); return 0; }
fn w_noise_gaussian() { noise_gaussian(FB, f32_from(0.1), 42); return 0; }
fn w_salt_pepper() { noise_salt_pepper(FB, f32_from(0.05), 42); return 0; }
fn w_median1() { pixel_buffer_free(median(F512, 1, err)); return 0; }
fn w_median5() { pixel_buffer_free(median(F512, 5, err)); return 0; }
fn w_bilateral() { pixel_buffer_free(bilateral(F256, 2, f32_from(10.0), f32_from(30.0), err)); return 0; }
fn w_vibrance() { vibrance(FV, f32_from(0.5)); return 0; }
fn w_channel_mixer() { channel_mixer(FV, F_MIX); return 0; }
fn w_threshold() { threshold(FV, 128); return 0; }
fn w_flood_fill() {
    # Rust resets the frame inside the timed closure, so the reset is timed here too.
    bv_fill(pixel_buffer_bv(FB), 128);
    flood_fill(FB, 0, 0, F_FILL, 10);
    return 0;
}
fn w_awb() { auto_white_balance(FV); return 0; }

fn f32s(p, i, v) { store32(p + i * 4, f32_from(v)); return 0; }

fn benches_filter() {
    FB = mk_uniform(W, H, PF_RGBA8, 128);
    FV = mk_varied(W, H);
    FV_RO = mk_varied(W, H);
    F512 = mk_uniform(512, 512, PF_RGBA8, 128);
    F256 = mk_uniform(256, 256, PF_RGBA8, 128);

    # lut[i] = (255 * (i / 255)^0.8) as u8. Rust computes it in f32; the table only
    # has to be a plausible curve here, since curves() is a lookup either way.
    F_LUT = fl_alloc(256);
    var i = 0;
    while (i < 256) {
        store8(F_LUT + i, f64_to(f64_mul(255.0, f64_pow(f64_div(f64_from(i), 255.0), 0.8))));
        i = i + 1;
    }
    F_SH = fl_alloc(12); f32s(F_SH, 0, 0.0); f32s(F_SH, 1, 0.0); f32s(F_SH, 2, 0.05);
    F_MID = fl_alloc(12); f32s(F_MID, 0, 0.05); f32s(F_MID, 1, 0.0); f32s(F_MID, 2, f64_neg(0.05));
    F_HI = fl_alloc(12); f32s(F_HI, 0, 0.0); f32s(F_HI, 1, 0.0); f32s(F_HI, 2, 0.0);
    F_MIX = fl_alloc(36);
    f32s(F_MIX, 0, 0.8); f32s(F_MIX, 1, 0.1); f32s(F_MIX, 2, 0.1);
    f32s(F_MIX, 3, 0.1); f32s(F_MIX, 4, 0.8); f32s(F_MIX, 5, 0.1);
    f32s(F_MIX, 6, 0.1); f32s(F_MIX, 7, 0.1); f32s(F_MIX, 8, 0.8);
    F_FILL = rgba(255, 0, 0, 255);

    # The 17-point identity cube Rust parses from text: entry (r, g, b) is
    # (r / 16, g / 16, b / 16) in f32.
    F_L3D = lut3d_new(17);
    var lb = 0;
    while (lb < 17) {
        var lg = 0;
        while (lg < 17) {
            var lr = 0;
            while (lr < 17) {
                var rf: f32 = f32_from(lr) / f32_from(16.0);
                var gf: f32 = f32_from(lg) / f32_from(16.0);
                var bf: f32 = f32_from(lb) / f32_from(16.0);
                lut3d_set(F_L3D, lr, lg, lb, 0, rf);
                lut3d_set(F_L3D, lr, lg, lb, 1, gf);
                lut3d_set(F_L3D, lr, lg, lb, 2, bf);
                lr = lr + 1;
            }
            lg = lg + 1;
        }
        lb = lb + 1;
    }

    frame("brightness_1080p", 200, &w_brightness);
    frame("contrast_1080p", 20, &w_contrast);
    frame("saturation_1080p", 20, &w_saturation);
    frame("grayscale_1080p", 50, &w_grayscale);
    frame("invert_1080p", 100, &w_invert);
    frame("levels_1080p", 50, &w_levels);
    frame("curves_1080p", 50, &w_curves);
    frame("gaussian_blur_r3_1080p", 5, &w_gaussian);
    frame("box_blur_r3_1080p", 5, &w_box);
    frame("unsharp_mask_r2_1080p", 3, &w_unsharp);
    frame("hue_shift_1080p", 3, &w_hue_shift);
    frame("color_balance_1080p", 10, &w_color_balance);
    frame("vignette_1080p", 10, &w_vignette);
    frame("lut3d_17cube_1080p", 3, &w_lut3d);
    frame("noise_gaussian_1080p", 3, &w_noise_gaussian);
    frame("noise_salt_pepper_1080p", 20, &w_salt_pepper);
    frame("median_r1_512x512", 5, &w_median1);
    frame("median_r5_512x512", 5, &w_median5);
    frame("bilateral_r2_256x256", 10, &w_bilateral);
    frame("vibrance_1080p", 10, &w_vibrance);
    frame("channel_mixer_1080p", 20, &w_channel_mixer);
    frame("threshold_1080p", 50, &w_threshold);
    frame("flood_fill_1080p_uniform", 5, &w_flood_fill);
    frame("auto_white_balance_1080p", 20, &w_awb);
    return 0;
}

# ================================================================
# histogram.rs
# ================================================================
var HG_BUF = 0;
var HG_OUT = 0;

fn w_luminance_histogram() { hist_free(luminance_histogram(HG_BUF, 256, err)); return 0; }
fn w_rgb_histograms() {
    var rc = rgb_histograms(HG_BUF, HG_OUT);
    hist_free(load64(HG_OUT)); hist_free(load64(HG_OUT + 8)); hist_free(load64(HG_OUT + 16));
    return rc;
}
fn w_equalize() { equalize(HG_BUF); return 0; }
fn w_auto_levels() { auto_levels(HG_BUF); return 0; }

fn benches_histogram() {
    HG_BUF = mk_varied(W, H);
    HG_OUT = fl_alloc(24);
    frame("luminance_histogram_1080p", 50, &w_luminance_histogram);
    frame("rgb_histograms_1080p", 50, &w_rgb_histograms);
    frame("equalize_1080p", 10, &w_equalize);
    frame("auto_levels_1080p", 10, &w_auto_levels);

    # a[i] = (i / 255)^2, b[i] = (1 - i / 255)^2.
    var ha = hist_new(256);
    var hb = hist_new(256);
    var i = 0;
    while (i < 256) {
        var t = f64_div(f64_from(i), 255.0);
        var u = f64_sub(1.0, t);
        hist_set(ha, i, f64_mul(t, t));
        hist_set(hb, i, f64_mul(u, u));
        i = i + 1;
    }
    var acc = 0;
    var bn = bench_new("chi_squared_256bins");
    bench_batch_start(bn);
    i = 0;
    while (i < 100000) { acc = acc + chi_squared(ha, hb, err); i = i + 1; }
    bench_batch_stop(bn, 100000);
    bench_report(bn);
    hist_free(ha); hist_free(hb);
    return acc;
}

# ================================================================
# icc.rs
# ================================================================
fn bench_icc_apply(name, prof, r, g, b, out) {
    var bn = bench_new(name);
    bench_batch_start(bn);
    var i = 0;
    while (i < 1000000) { icc_profile_apply(prof, r, g, b, out); i = i + 1; }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);
    return 0;
}

fn benches_icc() {
    var lenp = fl_alloc(8);
    var bn = bench_new("srgb_v2_profile_generation");
    bench_batch_start(bn);
    var i = 0;
    while (i < 200000) { bv_free(srgb_v2_profile(lenp)); i = i + 1; }
    bench_batch_stop(bn, 200000);
    bench_report(bn);

    var bytes = srgb_v2_profile(lenp);
    var plen = load64(lenp);
    bn = bench_new("icc_from_bytes_srgb_v2");
    bench_batch_start(bn);
    i = 0;
    while (i < 200000) { icc_profile_free(icc_profile_from_bytes(bv_data(bytes), plen, err)); i = i + 1; }
    bench_batch_stop(bn, 200000);
    bench_report(bn);

    var prof = icc_profile_from_bytes(bv_data(bytes), plen, err);
    var xyz = fl_alloc(24);
    bench_icc_apply("icc_apply_mid_gray", prof, 0.5, 0.5, 0.5, xyz);
    bench_icc_apply("icc_apply_white", prof, 1.0, 1.0, 1.0, xyz);
    bench_icc_apply("icc_apply_black", prof, 0.0, 0.0, 0.0, xyz);
    bench_icc_apply("icc_apply_saturated_red", prof, 1.0, 0.0, 0.0, xyz);
    icc_profile_free(prof);
    bv_free(bytes);

    var acc = 0;
    var tg = tone_curve_gamma(2.2);
    bn = bench_new("tone_curve_gamma_2_2");
    bench_batch_start(bn);
    i = 0;
    while (i < 1000000) { acc = acc + tone_curve_apply(tg, 0.5); i = i + 1; }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);
    tone_curve_free(tg);

    # (i / 255)^2.2 for i in 0..256; tone_curve_table takes ownership.
    var tab = fl_alloc(256 * 8);
    i = 0;
    while (i < 256) { store64(tab + i * 8, f64_pow(f64_div(f64_from(i), 255.0), 2.2)); i = i + 1; }
    var tt = tone_curve_table(tab, 256);
    bn = bench_new("tone_curve_table_256");
    bench_batch_start(bn);
    i = 0;
    while (i < 1000000) { acc = acc + tone_curve_apply(tt, 0.5); i = i + 1; }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);
    tone_curve_free(tt);
    return acc;
}

# ================================================================
# transform.rs
# ================================================================
var TR_BUF = 0;
var TR_512 = 0;
var TR_ROT = 0;
var TR_PID = 0;

fn w_crop() { pixel_buffer_free(crop(TR_BUF, 240, 180, 1520, 900, err)); return 0; }
fn w_resize_nearest() { pixel_buffer_free(resize(TR_BUF, 1280, 720, SF_NEAREST, err)); return 0; }
fn w_resize_bilinear() { pixel_buffer_free(resize(TR_BUF, 1280, 720, SF_BILINEAR, err)); return 0; }
fn w_flip_h() { pixel_buffer_free(flip_horizontal(TR_BUF, err)); return 0; }
fn w_flip_v() { pixel_buffer_free(flip_vertical(TR_BUF, err)); return 0; }
fn w_affine_rotate() { pixel_buffer_free(affine_transform(TR_512, TR_ROT, 512, 512, SF_BILINEAR, err)); return 0; }
fn w_resize_bicubic() { pixel_buffer_free(resize(TR_BUF, 1280, 720, SF_BICUBIC, err)); return 0; }
fn w_perspective() {
    pixel_buffer_free(perspective_transform(TR_512, TR_PID, 512, 512, SF_BILINEAR, err));
    return 0;
}

fn benches_transform() {
    TR_BUF = mk_uniform(W, H, PF_RGBA8, 128);
    TR_512 = mk_uniform(512, 512, PF_RGBA8, 128);
    TR_ROT = affine_rotate(0.1);
    TR_PID = perspective_identity();
    frame("crop_1080p_to_720p", 200, &w_crop);
    frame("resize_nearest_1080p_to_720p", 50, &w_resize_nearest);
    frame("resize_bilinear_1080p_to_720p", 5, &w_resize_bilinear);
    frame("flip_horizontal_1080p", 50, &w_flip_h);
    frame("flip_vertical_1080p", 100, &w_flip_v);
    frame("affine_rotate_512x512", 10, &w_affine_rotate);
    frame("resize_bicubic_1080p_to_720p", 2, &w_resize_bicubic);
    frame("perspective_identity_512x512", 10, &w_perspective);
    return 0;
}

fn main(): i64 {
    alloc_init();
    err = fl_alloc(8);
    benches_blend();
    benches_convert();
    benches_color_science();
    benches_composite();
    benches_filter();
    benches_histogram();
    benches_icc();
    benches_transform();
    return 0;
}

var r = main();
sys_exit_group(r);
