# ranga benchmarks — the Cyrius side of docs/benchmarks-rust-v-cyrius.md
#
# One benchmark for each of Rust 1.0.1's 100 CPU benchmarks outside spectral, under
# the same name and on the same workload: rust-old/benches/{blend,color_convert,
# color_science,composite,filter,histogram,icc,transform}.rs, in that order. The
# 8 spectral benchmarks are tests/spectral.bcyr and the 26 GPU benchmarks are
# tests/gpu.bcyr, each feature-gated as in Rust.
#
# SAME WORKLOAD means the same inputs and parameters: uniform 128 frames where
# Rust uses make_buf, `i % 256` where it uses make_varied_buf, opacity 200 for
# blend, a 640x480 source at (100, 100) for composite_at, and so on. Up to 2.2.0
# several benchmarks here shared a Rust name but not its workload.
#
# Two differences the language forces:
#   - Rust's colour structs live on the stack, and `.into()` costs nothing to
#     allocate. Here the conversions return heap handles, so srgb_to_lab,
#     cmyk_roundtrip, hsl_roundtrip and pixel_view_create include an fl_alloc and
#     an fl_free each.
#   - criterion picks its own iteration counts. Here each benchmark has a fixed
#     batch, sized to take roughly 50-300 ms.
#
# BATCHING. bench_batch_start/stop pay one clock read per pair, so anything below
# a microsecond runs in a batch of 100k-1M and the cost is amortised. The
# frame-sized operations go through `frame`, one function pointer call each,
# which is noise against milliseconds.
#
# In-place operations run repeatedly on one buffer, as Rust's do: brightness
# keeps brightening the same frame, and so on.

include "src/error.cyr"
include "src/bytevec.cyr"
include "src/simd_u8.cyr"
include "src/pixel.cyr"
include "src/color.cyr"
include "src/composite.cyr"
include "src/histogram.cyr"
include "src/transform.cyr"
include "src/filter_point.cyr"
include "src/filter_kernel.cyr"
include "src/blend.cyr"
include "src/convert.cyr"
include "src/icc.cyr"

var W = 1920;
var H = 1080;
var err = 0;

# Rust's make_buf: every byte 128.
fn mk_uniform(w, h, fmt, v) {
    var b = pixel_buffer_zeroed(w, h, fmt, err);
    if (b == 0) { return 0; }
    bv_fill(pixel_buffer_bv(b), v);
    return b;
}

# Rust's make_varied_buf: byte i is i % 256.
fn mk_varied(w, h) {
    var b = pixel_buffer_zeroed(w, h, PF_RGBA8, err);
    if (b == 0) { return 0; }
    var p = pixel_buffer_data(b);
    var n = pixel_buffer_len(b);
    var i = 0;
    while (i < n) { store8(p + i, i & 255); i = i + 1; }
    return b;
}

fn rgba(r, g, b, a) {
    var p = fl_alloc(8);
    store8(p, r); store8(p + 1, g); store8(p + 2, b); store8(p + 3, a);
    return p;
}

# Run `fp` (no arguments) `iters` times as one batch and report the mean.
fn frame(name, iters, fp) {
    var bn = bench_new(name);
    bench_batch_start(bn);
    var i = 0;
    while (i < iters) { fncall0(fp); i = i + 1; }
    bench_batch_stop(bn, iters);
    bench_report(bn);
    return 0;
}

# ================================================================
# blend.rs
# ================================================================
var BL_SRC = 0;
var BL_DST = 0;
var BL_OUT = 0;
var ROW_SRC = 0;
var ROW_DST = 0;

fn bench_blend_mode(name, mode) {
    var bn = bench_new(name);
    bench_batch_start(bn);
    var i = 0;
    while (i < 1000000) { blend_pixel(BL_SRC, BL_DST, mode, 200, BL_OUT); i = i + 1; }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);
    return 0;
}
fn w_blend_row() { blend_row_normal(ROW_SRC, ROW_DST, W, 200); return 0; }
fn w_blend_row_argb() { blend_row_normal_argb(ROW_SRC, ROW_DST, W, 200); return 0; }

fn benches_blend() {
    BL_SRC = rgba(200, 100, 50, 200);
    BL_DST = rgba(50, 100, 200, 255);
    BL_OUT = fl_alloc(8);
    ROW_SRC = fl_alloc(W * 4);
    ROW_DST = fl_alloc(W * 4);
    memset(ROW_SRC, 128, W * 4);
    memset(ROW_DST, 64, W * 4);

    bench_blend_mode("blend_pixel_normal", BM_NORMAL);
    frame("blend_row_1920px", 20000, &w_blend_row);
    frame("blend_row_1080p_width", 20000, &w_blend_row);
    bench_blend_mode("blend_pixel_modes/Normal", BM_NORMAL);
    bench_blend_mode("blend_pixel_modes/Multiply", BM_MULTIPLY);
    bench_blend_mode("blend_pixel_modes/Screen", BM_SCREEN);
    bench_blend_mode("blend_pixel_modes/Overlay", BM_OVERLAY);
    bench_blend_mode("blend_pixel_modes/Darken", BM_DARKEN);
    bench_blend_mode("blend_pixel_modes/Lighten", BM_LIGHTEN);
    bench_blend_mode("blend_pixel_modes/ColorDodge", BM_COLOR_DODGE);
    bench_blend_mode("blend_pixel_modes/ColorBurn", BM_COLOR_BURN);
    bench_blend_mode("blend_pixel_modes/SoftLight", BM_SOFT_LIGHT);
    bench_blend_mode("blend_pixel_modes/HardLight", BM_HARD_LIGHT);
    bench_blend_mode("blend_pixel_modes/Difference", BM_DIFFERENCE);
    bench_blend_mode("blend_pixel_modes/Exclusion", BM_EXCLUSION);

    var asrc = rgba(200, 100, 50, 200);
    var adst = rgba(255, 50, 100, 200);
    var bn = bench_new("blend_pixel_argb_normal");
    bench_batch_start(bn);
    var i = 0;
    while (i < 1000000) { blend_pixel_argb(asrc, adst, BM_NORMAL, 200, BL_OUT); i = i + 1; }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);

    memset(ROW_SRC, 128, W * 4);
    memset(ROW_DST, 64, W * 4);
    frame("blend_row_argb_1920px", 20000, &w_blend_row_argb);
    return 0;
}

# ================================================================
# color_convert.rs
# ================================================================
var CV_RGBA = 0;
var CV_YUV601 = 0;
var CV_YUV709 = 0;
var CV_YUV2020 = 0;
var CV_NV12 = 0;
var CV_ARGB_NV = 0;
var CV_RGB = 0;
var CV_ARGB = 0;
var CV_F32 = 0;

fn w_to_yuv601() { pixel_buffer_free(rgba_to_yuv420p(CV_RGBA, err)); return 0; }
fn w_from_yuv601() { pixel_buffer_free(yuv420p_to_rgba(CV_YUV601, err)); return 0; }
fn w_to_yuv709() { pixel_buffer_free(rgba_to_yuv420p_bt709(CV_RGBA, err)); return 0; }
fn w_from_yuv709() { pixel_buffer_free(yuv420p_to_rgba_bt709(CV_YUV709, err)); return 0; }
fn w_nv12_to_rgba() { pixel_buffer_free(nv12_to_rgba(CV_NV12, err)); return 0; }
fn w_rgb8_to_rgba8() { pixel_buffer_free(rgb8_to_rgba8(CV_RGB, err)); return 0; }
fn w_argb8_to_rgba8() { pixel_buffer_free(argb8_to_rgba8(CV_ARGB, err)); return 0; }
fn w_rgbaf32_to_rgba8() { pixel_buffer_free(rgbaf32_to_rgba8(CV_F32, err)); return 0; }
fn w_to_yuv2020() { pixel_buffer_free(rgba_to_yuv420p_bt2020(CV_RGBA, err)); return 0; }
fn w_from_yuv2020() { pixel_buffer_free(yuv420p_to_rgba_bt2020(CV_YUV2020, err)); return 0; }
fn w_argb_to_nv12() { pixel_buffer_free(argb_to_nv12(CV_ARGB_NV, err)); return 0; }
fn w_rgba8_to_argb8() { pixel_buffer_free(rgba8_to_argb8(CV_RGBA, err)); return 0; }
fn w_rgba8_to_rgb8() { pixel_buffer_free(rgba8_to_rgb8(CV_RGBA, err)); return 0; }
fn w_rgba8_to_rgbaf32() { pixel_buffer_free(rgba8_to_rgbaf32(CV_RGBA, err)); return 0; }

fn benches_convert() {
    CV_RGBA = mk_uniform(W, H, PF_RGBA8, 128);
    CV_YUV601 = rgba_to_yuv420p(CV_RGBA, err);
    CV_YUV709 = rgba_to_yuv420p_bt709(CV_RGBA, err);
    CV_YUV2020 = rgba_to_yuv420p_bt2020(CV_RGBA, err);
    # [255, 128, 128, 128] repeated: opaque mid grey in ARGB.
    CV_ARGB_NV = pixel_buffer_zeroed(W, H, PF_ARGB8, err);
    var p = pixel_buffer_data(CV_ARGB_NV);
    var i = 0;
    while (i < W * H) { store32(p + i * 4, 0x808080FF); i = i + 1; }
    CV_NV12 = argb_to_nv12(CV_ARGB_NV, err);
    CV_RGB = mk_uniform(W, H, PF_RGB8, 128);
    CV_ARGB = mk_uniform(W, H, PF_ARGB8, 128);
    CV_F32 = rgba8_to_rgbaf32(CV_RGBA, err);

    frame("rgba_to_yuv420p_bt601_1080p", 50, &w_to_yuv601);
    frame("yuv420p_to_rgba_bt601_1080p", 50, &w_from_yuv601);
    frame("rgba_to_yuv420p_bt709_1080p", 50, &w_to_yuv709);
    frame("yuv420p_to_rgba_bt709_1080p", 50, &w_from_yuv709);
    frame("nv12_to_rgba_1080p", 50, &w_nv12_to_rgba);
    frame("rgb8_to_rgba8_1080p", 50, &w_rgb8_to_rgba8);
    frame("argb8_to_rgba8_1080p", 50, &w_argb8_to_rgba8);
    frame("rgbaf32_to_rgba8_1080p", 10, &w_rgbaf32_to_rgba8);
    frame("rgba_to_yuv420p_bt2020_1080p", 50, &w_to_yuv2020);
    frame("yuv420p_to_rgba_bt2020_1080p", 50, &w_from_yuv2020);
    frame("argb_to_nv12_1080p", 20, &w_argb_to_nv12);
    frame("rgba8_to_argb8_1080p", 50, &w_rgba8_to_argb8);
    frame("rgba8_to_rgb8_1080p", 50, &w_rgba8_to_rgb8);
    frame("rgba8_to_rgbaf32_1080p", 20, &w_rgba8_to_rgbaf32);
    return 0;
}

# ================================================================
# color_science.rs
# ================================================================
var CS_POOL = 0;
var CS_VIEW_BUF = 0;
fn w_buffer_pool() {
    buffer_pool_release(CS_POOL, buffer_pool_acquire(CS_POOL, 1920 * 1080 * 4));
    return 0;
}

fn benches_color_science() {
    var i = 0;
    var bn = 0;
    var acc = 0;

    var c = srgba_new(128, 64, 200, 255);
    bn = bench_new("srgb_to_lab");
    bench_batch_start(bn);
    i = 0;
    while (i < 200000) { cie_lab_free(srgba_to_cie_lab(c)); i = i + 1; }
    bench_batch_stop(bn, 200000);
    bench_report(bn);

    var la = cie_lab_new(50.0, 25.0, f64_neg(10.0));
    var lb = cie_lab_new(55.0, 20.0, f64_neg(15.0));
    bn = bench_new("delta_e_cie76");
    bench_batch_start(bn);
    i = 0;
    while (i < 1000000) { acc = acc + delta_e_cie76(la, lb); i = i + 1; }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);

    bn = bench_new("delta_e_cie94");
    bench_batch_start(bn);
    i = 0;
    while (i < 1000000) { acc = acc + delta_e_cie94(la, lb); i = i + 1; }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);

    var da = cie_lab_new(50.0, 2.6772, f64_neg(79.7751));
    var db = cie_lab_new(50.0, 0, f64_neg(82.7485));
    bn = bench_new("delta_e_ciede2000");
    bench_batch_start(bn);
    i = 0;
    while (i < 200000) { acc = acc + delta_e_ciede2000(da, db); i = i + 1; }
    bench_batch_stop(bn, 200000);
    bench_report(bn);

    var trip = fl_alloc(24);
    bn = bench_new("p3_to_linear_srgb");
    bench_batch_start(bn);
    i = 0;
    while (i < 1000000) { p3_to_linear_srgb(0.8, 0.3, 0.5, trip); i = i + 1; }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);

    var cm = srgba_new(200, 100, 50, 255);
    bn = bench_new("cmyk_roundtrip");
    bench_batch_start(bn);
    i = 0;
    while (i < 1000000) {
        var k = srgba_to_cmyk(cm);
        srgba_free(cmyk_to_srgba(k));
        cmyk_free(k);
        i = i + 1;
    }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);

    var rgb3 = fl_alloc(16);
    bn = bench_new("color_temperature_6600K");
    bench_batch_start(bn);
    i = 0;
    while (i < 1000000) { color_temperature(f32_from(6600.0), rgb3); i = i + 1; }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);

    bn = bench_new("hsl_roundtrip");
    bench_batch_start(bn);
    i = 0;
    while (i < 1000000) {
        var h = srgba_to_hsl(c);
        srgba_free(hsl_to_srgba(h));
        hsl_free(h);
        i = i + 1;
    }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);

    var tc = tone_curve_gamma(2.2);
    bn = bench_new("icc_tone_curve_apply");
    bench_batch_start(bn);
    i = 0;
    while (i < 1000000) { acc = acc + tone_curve_apply(tc, 0.5); i = i + 1; }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);
    tone_curve_free(tc);

    CS_POOL = buffer_pool_new(4);
    frame("buffer_pool_acquire_release", 200, &w_buffer_pool);
    buffer_pool_free(CS_POOL);

    CS_VIEW_BUF = pixel_buffer_zeroed(W, H, PF_RGBA8, err);
    var vd = pixel_buffer_data(CS_VIEW_BUF);
    var vl = pixel_buffer_len(CS_VIEW_BUF);
    bn = bench_new("pixel_view_create");
    bench_batch_start(bn);
    i = 0;
    while (i < 1000000) { pixel_view_free(pixel_view_new(vd, vl, W, H, PF_RGBA8, err)); i = i + 1; }
    bench_batch_stop(bn, 1000000);
    bench_report(bn);
    return acc;
}

